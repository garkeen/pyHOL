  ← apply_prev goal=64 facts=[42]
  ← rewrite member_collect sym=false goal=56
    #[66] ∀c. c < l ⟶ (∃x. eventually (λx1. x ≤ f x1) net ∧ c < x)
  ← intro c goal=66
    #[67] ∃x. eventually (λx1. x ≤ f x1) net ∧ c < x
  ← inst "(l+c)/2" goal=67
    #[68] eventually (λx. (l + c) / 2 ≤ f x) net ∧ c < (l + c) / 2
