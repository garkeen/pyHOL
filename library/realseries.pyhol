theorem has_liminf_sequentially_imp_reallim_inf
  fixes a :: nat => real, l :: real
  prop has_liminf a l sequentially --> tendsto_real (%n. inf (image a ({m. m >= n}))) l sequentially
  [hint_backward]

theorem has_liminf_sequentially_reallim_inf
  fixes a :: nat => real, l :: real
  prop has_liminf a l sequentially <--> (?b. !n. b <= a n) & tendsto_real (%n. inf (image a ({m. m >= n}))) l sequentially

theorem real_series_root_test
  fixes a :: nat => real, b :: real, k :: nat set
  prop (!n. n Mem k --> 0 <= a n) --> b < 1 --> has_limsup (%n. root n (a n)) b (within sequentially k) --> real_summable k a
  [hint_backward,hint_backward1]

theorem real_cauchy_hadamard_radius
  fixes a :: nat => real, b :: real, k :: nat set, x :: real
  prop has_limsup (%n. root n (abs (a n))) b (within sequentially k) --> b * abs x < 1 --> real_summable k (%n. a n * x ^ n)
  [hint_backward1]

theorem real_cauchy_hadamard_radius_absconv_derivative
  fixes a :: nat => real, b :: real, k :: nat set, x :: real
  prop has_limsup (%n. root n (abs (a n))) b (within sequentially k) --> b * abs x < 1 --> real_summable k (%n. abs (of_nat n * a n * x ^ (n - 1)))
  [hint_backward,hint_backward1]

theorem real_cauchy_hadamard_radius_derivative
  fixes a :: nat => real, b :: real, k :: nat set, x :: real
  prop has_limsup (%n. root n (abs (a n))) b (within sequentially k) --> b * abs x < 1 --> real_summable k (%n. of_nat n * a n * x ^ (n - 1))
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] has_limsup (λn. root n (abs (a n))) b (within sequentially k)
    #[2] b * abs x < 1
    #[3] real_summable k (λn. of_nat n * a n * x ^ (n - 1))
  ← rule real_series_absconv_imp_conv goal=3
    #[4] real_summable k (λn. abs (of_nat n * a n * x ^ (n - 1)))
  ← rule real_cauchy_hadamard_radius_absconv_derivative goal=4 facts=[1,2]
qed

theorem real_cauchy_hadamard_radius_uniform
  fixes a :: nat => real, b :: real, k :: nat set, s :: real set
  prop has_limsup (%n. root n (abs (a n))) b (within sequentially k) --> real_compact s --> (!x. x Mem s --> b * abs x < 1) --> (?l. !e. 0 < e --> (?N. !n. !x. N <= n & x Mem s --> abs (sum (k Int {0..n}) (%i. a i * x ^ i) - l x) < e))
  [hint_backward,hint_backward1]

theorem real_cauchy_hadamard_radius_uniform_derivative
  fixes a :: nat => real, b :: real, k :: nat set, s :: real set
  prop has_limsup (%n. root n (abs (a n))) b (within sequentially k) --> real_compact s --> (!x. x Mem s --> b * abs x < 1) --> (?l. !e. 0 < e --> (?N. !n. !x. N <= n & x Mem s --> abs (sum (k Int {0..n}) (%i. of_nat i * a i * x ^ (i - 1)) - l x) < e))
  [hint_backward,hint_backward1]

theorem has_real_derivative_sequence
  fixes f :: nat => real => real, f1 :: nat => real => real, g1 :: real => real, s :: real set
  prop is_realinterval s --> (!n. !x. x Mem s --> has_real_derivative (f n) (f1 n x) (within (atreal x) s)) --> (!e. 0 < e --> (?N. !n. !x. n >= N & x Mem s --> abs (f1 n x - g1 x) <= e)) --> (?x. ?l. x Mem s & tendsto_real (%n. f n x) l sequentially) --> (?g. !x. x Mem s --> tendsto_real (%n. f n x) (g x) sequentially & has_real_derivative g (g1 x) (within (atreal x) s))
  [hint_backward,hint_backward1]

theorem has_real_derivative_series
  fixes f :: nat => real => real, f1 :: nat => real => real, g1 :: real => real, k :: nat set, s :: real set
  prop is_realinterval s --> (!n. !x. x Mem s --> has_real_derivative (f n) (f1 n x) (within (atreal x) s)) --> (!e. 0 < e --> (?N. !n. !x. n >= N & x Mem s --> abs (sum (k Int {0..n}) (%i. f1 i x) - g1 x) <= e)) --> (?x. ?l. x Mem s & real_sums (%n. f n x) l k) --> (?g. !x. x Mem s --> real_sums (%n. f n x) (g x) k & has_real_derivative g (g1 x) (within (atreal x) s))
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] is_realinterval s
    #[2] ∀n. ∀x. x ∈ s ⟶ has_real_derivative (f n) (f1 n x) (within (atreal x) s)
    #[3] ∀e. 0 < e ⟶ (∃N. ∀n. ∀x. n ≥ N ∧ x ∈ s ⟶ abs (sum (k ∩ {0..n}) (λi. f1 i x) - g1 x) ≤ e)
    #[4] ∃x. ∃l. x ∈ s ∧ real_sums (λn. f n x) l k
    #[5] ∃g. ∀x. x ∈ s ⟶ real_sums (λn. f n x) (g x) k ∧ has_real_derivative g (g1 x) (within (atreal x) s)
  ← rewrite real_sums_def sym=false goal=5
    #[6] ∃g. ∀x. x ∈ s ⟶ tendsto_real (λn. sum (k ∩ {0..n}) (λn1. f n1 x)) (g x) sequentially ∧ has_real_derivative g (g1 x) (within (atreal x) s)
  → rewrite target=fact real_sums_def sym=false goal=6 facts=[4]
    #[7] ∃x. ∃l. x ∈ s ∧ tendsto_real (λn. sum (k ∩ {0..n}) (λn1. f n1 x)) l sequentially
  ← rule has_real_derivative_sequence param_f1="(%n::nat. %x::real. sum (inter k ({0..n})) (%n. f1 n x))" goal=6
    #[8] ∀n. ∀x. x ∈ s ⟶ has_real_derivative (λx1. sum (k ∩ {0..n}) (λn1. f n1 x1)) (sum (k ∩ {0..n}) (λn1. f1 n1 x)) (within (atreal x) s)
  ← intro n,x goal=8
    #[9] _VAR n
    #[10] _VAR x
    #[11] x ∈ s
    #[12] has_real_derivative (λx1. sum (k ∩ {0..n}) (λn1. f n1 x1)) (sum (k ∩ {0..n}) (λn1. f1 n1 x)) (within (atreal x) s)
  ← rule has_real_derivative_sum goal=12
    #[13] finite (k ∩ {0..n})
    #[14] ∀n1. n1 ∈ k ∩ {0..n} ⟶ has_real_derivative (f n1) (f1 n1 x) (within (atreal x) s)
  ← rule finite_inter_natseg goal=13
    #[15] finite (k ∩ {0..n})
  ← intro a goal=14
    #[16] _VAR a
    #[17] a ∈ k ∩ {0..n}
    #[18] has_real_derivative (f a) (f1 a x) (within (atreal x) s)
  ← apply_prev goal=18 facts=[2]
qed

theorem real_differentiable_bound
  fixes B :: real, f :: real => real, f1 :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> has_real_derivative f (f1 x) (within (atreal x) s) --> abs (f1 x) <= B) --> (!x. !y. x Mem s --> y Mem s --> abs (f x - f y) <= B * abs (x - y))
  [hint_backward,hint_backward1]

theorem real_taylor_mvt_pos
  fixes a :: real, f :: nat => real => real, n :: nat, x :: real
  prop a < x --> (!i. !t. t Mem real_closed_interval a x --> i <= n --> has_real_derivative (f i) (f (i + 1) t) (within (atreal t) (real_closed_interval a x))) --> (?t. t Mem real_closed_interval a x & f 0 x = sum ({0..n}) (%i. f i a * (x - a) ^ i / of_nat (fact i)) + f (n + 1) t * (x - a) ^ (n + 1) / of_nat (fact (n + 1)))
  [hint_backward,hint_backward1]

theorem real_taylor_mvt_neg
  fixes a :: real, f :: nat => real => real, n :: nat, x :: real
  prop x < a --> (!i. !t. t Mem real_closed_interval x a --> i <= n --> has_real_derivative (f i) (f (i + 1) t) (within (atreal t) (real_closed_interval x a))) --> (?t. t Mem real_closed_interval x a & f 0 x = sum ({0..n}) (%i. f i a * (x - a) ^ i / of_nat (fact i)) + f (n + 1) t * (x - a) ^ (n + 1) / of_nat (fact (n + 1)))
  [hint_backward,hint_backward1]

theorem real_taylor
  fixes B :: real, f :: nat => real => real, n :: nat, s :: real set
  prop is_realinterval s --> (!i. !x. x Mem s --> i <= n --> has_real_derivative (f i) (f (i + 1) x) (within (atreal x) s)) --> (!x. x Mem s --> abs (f (n + 1) x) <= B) --> (!w. !z. w Mem s --> z Mem s --> abs (f 0 z - sum ({0..n}) (%i. f i w * (z - w) ^ i / of_nat (fact i))) <= B * abs (z - w) ^ (n + 1) / of_nat (fact (n + 1)))
  [hint_backward,hint_backward1]

theorem real_sum_integral_ubound_increasing
  fixes f :: real => real, g :: real => real, m :: nat, n :: nat
  prop m <= n --> (!x. x Mem real_closed_interval (of_nat m) (of_nat n + 1) --> has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m) (of_nat n + 1)))) --> (!x. !y. of_nat m <= x --> x <= y --> y <= of_nat n + 1 --> f x <= f y) --> sum ({m..n}) (%k. f (of_nat k)) <= g (of_nat n + 1) - g (of_nat m)
  [hint_backward,hint_backward1]

theorem real_sum_integral_ubound_decreasing
  fixes f :: real => real, g :: real => real, m :: nat, n :: nat
  prop m <= n --> (!x. x Mem real_closed_interval (of_nat m - 1) (of_nat n) --> has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n)))) --> (!x. !y. of_nat m - 1 <= x --> x <= y --> y <= of_nat n --> f y <= f x) --> sum ({m..n}) (%k. f (of_nat k)) <= g (of_nat n) - g (of_nat m - 1)
  [hint_backward,hint_backward1]

theorem real_sum_integral_lbound_increasing
  fixes f :: real => real, g :: real => real, m :: nat, n :: nat
  prop m <= n --> (!x. x Mem real_closed_interval (of_nat m - 1) (of_nat n) --> has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n)))) --> (!x. !y. of_nat m - 1 <= x --> x <= y --> y <= of_nat n --> f x <= f y) --> g (of_nat n) - g (of_nat m - 1) <= sum ({m..n}) (%k. f (of_nat k))
  [hint_backward,hint_backward1]

theorem real_sum_integral_lbound_decreasing
  fixes f :: real => real, g :: real => real, m :: nat, n :: nat
  prop m <= n --> (!x. x Mem real_closed_interval (of_nat m) (of_nat n + 1) --> has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m) (of_nat n + 1)))) --> (!x. !y. of_nat m <= x --> x <= y --> y <= of_nat n + 1 --> f y <= f x) --> g (of_nat n + 1) - g (of_nat m) <= sum ({m..n}) (%k. f (of_nat k))
  [hint_backward,hint_backward1]

theorem real_sum_integral_bounds_increasing
  fixes f :: real => real, g :: real => real, m :: nat, n :: nat
  prop m <= n --> (!x. x Mem real_closed_interval (of_nat m - 1) (of_nat n + 1) --> has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n + 1)))) --> (!x. !y. of_nat m - 1 <= x --> x <= y --> y <= of_nat n + 1 --> f x <= f y) --> g (of_nat n) - g (of_nat m - 1) <= sum ({m..n}) (%k. f (of_nat k)) & sum ({m..n}) (%k. f (of_nat k)) <= g (of_nat n + 1) - g (of_nat m)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] ∀x. x ∈ real_closed_interval (of_nat m - 1) (of_nat n + 1) ⟶ has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n + 1)))
    #[3] ∀x. ∀y. of_nat m - 1 ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n + 1 ⟶ f x ≤ f y
    #[4] g (of_nat n) - g (of_nat m - 1) ≤ sum ({m..n}) (λk. f (of_nat k)) ∧ sum ({m..n}) (λk. f (of_nat k)) ≤ g (of_nat n + 1) - g (of_nat m)
  ← rule conjI goal=4
    #[5] g (of_nat n) - g (of_nat m - 1) ≤ sum ({m..n}) (λk. f (of_nat k))
    #[6] sum ({m..n}) (λk. f (of_nat k)) ≤ g (of_nat n + 1) - g (of_nat m)
  ← rule real_sum_integral_lbound_increasing goal=5 facts=[1]
    #[7] ∀x. x ∈ real_closed_interval (of_nat m - 1) (of_nat n) ⟶ has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n)))
    #[8] ∀x. ∀y. of_nat m - 1 ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n ⟶ f x ≤ f y
  ← intro x goal=7
    #[9] _VAR x
    #[10] x ∈ real_closed_interval (of_nat m - 1) (of_nat n)
    #[11] has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n)))
  ← rule has_real_derivative_within_subset param_s="(real_closed_interval (of_nat m - 1) (of_nat n + 1))" goal=11
    #[12] has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n + 1)))
    #[13] real_closed_interval (of_nat m - 1) (of_nat n) ⊆ real_closed_interval (of_nat m - 1) (of_nat n + 1)
  ← apply_prev goal=12 facts=[2]
    #[14] x ∈ real_closed_interval (of_nat m - 1) (of_nat n + 1)
  ← rewrite real_closed_interval_def sym=false goal=14
    #[15] x ∈ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  → rewrite target=fact real_closed_interval_def sym=false goal=15 facts=[10]
    #[16] x ∈ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n}
  ← z3 goal=15 facts=[16]
    #[17] x ∈ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← rewrite real_closed_interval_def sym=false goal=13
    #[18] {p::real. of_nat m - 1 ≤ p ∧ p ≤ of_nat n} ⊆ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← z3 goal=18
    #[19] {p::real. of_nat m - 1 ≤ p ∧ p ≤ of_nat n} ⊆ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← z3 goal=8 facts=[3]
    #[20] ∀x. ∀y. of_nat m - 1 ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n ⟶ f x ≤ f y
  ← rule real_sum_integral_ubound_increasing goal=6 facts=[1]
    #[21] ∀x. x ∈ real_closed_interval (of_nat m) (of_nat n + 1) ⟶ has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m) (of_nat n + 1)))
    #[22] ∀x. ∀y. of_nat m ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n + 1 ⟶ f x ≤ f y
  ← intro x goal=21
    #[23] x ∈ real_closed_interval (of_nat m) (of_nat n + 1)
    #[24] has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m) (of_nat n + 1)))
  ← rule has_real_derivative_within_subset param_s="real_closed_interval (of_nat m - 1) (of_nat n + 1)" goal=24
    #[25] has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n + 1)))
    #[26] real_closed_interval (of_nat m) (of_nat n + 1) ⊆ real_closed_interval (of_nat m - 1) (of_nat n + 1)
  ← apply_prev goal=25 facts=[2]
    #[27] x ∈ real_closed_interval (of_nat m - 1) (of_nat n + 1)
  cut "real_closed_interval (of_nat m) (of_nat n + 1) ⊆ real_closed_interval (of_nat m - 1) (of_nat n + 1)" goal=27
  ← rewrite real_closed_interval_def sym=false goal=26
    #[28] {p::real. of_nat m ≤ p ∧ p ≤ of_nat n + 1} ⊆ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← z3 goal=28
    #[29] {p::real. of_nat m ≤ p ∧ p ≤ of_nat n + 1} ⊆ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← rule subsetE goal=27 facts=[26]
  ← rewrite real_closed_interval_def sym=false goal=26
  ← z3 goal=22 facts=[3]
    #[30] ∀x. ∀y. of_nat m ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n + 1 ⟶ f x ≤ f y
qed

theorem real_sum_integral_bounds_decreasing
  fixes f :: real => real, g :: real => real, m :: nat, n :: nat
  prop m <= n --> (!x. x Mem real_closed_interval (of_nat m - 1) (of_nat n + 1) --> has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n + 1)))) --> (!x. !y. of_nat m - 1 <= x --> x <= y --> y <= of_nat n + 1 --> f y <= f x) --> g (of_nat n + 1) - g (of_nat m) <= sum ({m..n}) (%k. f (of_nat k)) & sum ({m..n}) (%k. f (of_nat k)) <= g (of_nat n) - g (of_nat m - 1)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] ∀x. x ∈ real_closed_interval (of_nat m - 1) (of_nat n + 1) ⟶ has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n + 1)))
    #[3] ∀x. ∀y. of_nat m - 1 ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n + 1 ⟶ f y ≤ f x
    #[4] g (of_nat n + 1) - g (of_nat m) ≤ sum ({m..n}) (λk. f (of_nat k)) ∧ sum ({m..n}) (λk. f (of_nat k)) ≤ g (of_nat n) - g (of_nat m - 1)
  ← rule conjI goal=4
    #[5] g (of_nat n + 1) - g (of_nat m) ≤ sum ({m..n}) (λk. f (of_nat k))
    #[6] sum ({m..n}) (λk. f (of_nat k)) ≤ g (of_nat n) - g (of_nat m - 1)
  ← rule real_sum_integral_lbound_decreasing goal=5 facts=[1]
    #[7] ∀x. x ∈ real_closed_interval (of_nat m) (of_nat n + 1) ⟶ has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m) (of_nat n + 1)))
    #[8] ∀x. ∀y. of_nat m ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n + 1 ⟶ f y ≤ f x
  ← intro x goal=7
    #[9] _VAR x
    #[10] x ∈ real_closed_interval (of_nat m) (of_nat n + 1)
    #[11] has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m) (of_nat n + 1)))
  ← rule has_real_derivative_within_subset param_s="real_closed_interval (of_nat m - 1) (of_nat n + 1)" goal=11
    #[12] has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n + 1)))
    #[13] real_closed_interval (of_nat m) (of_nat n + 1) ⊆ real_closed_interval (of_nat m - 1) (of_nat n + 1)
  ← apply_prev goal=12 facts=[2]
    #[14] x ∈ real_closed_interval (of_nat m - 1) (of_nat n + 1)
  ← rewrite real_closed_interval_def sym=false goal=14
    #[15] x ∈ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  → rewrite target=fact real_closed_interval_def sym=false goal=15 facts=[10]
    #[16] x ∈ {p. of_nat m ≤ p ∧ p ≤ of_nat n + 1}
  ← z3 goal=15 facts=[16]
    #[17] x ∈ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← rewrite real_closed_interval_def sym=false goal=13
    #[18] {p::real. of_nat m ≤ p ∧ p ≤ of_nat n + 1} ⊆ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← z3 goal=18
    #[19] {p::real. of_nat m ≤ p ∧ p ≤ of_nat n + 1} ⊆ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← z3 goal=8 facts=[3]
    #[20] ∀x. ∀y. of_nat m ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n + 1 ⟶ f y ≤ f x
  ← rule real_sum_integral_ubound_decreasing goal=6 facts=[1]
    #[21] ∀x. x ∈ real_closed_interval (of_nat m - 1) (of_nat n) ⟶ has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n)))
    #[22] ∀x. ∀y. of_nat m - 1 ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n ⟶ f y ≤ f x
  ← intro x goal=21
    #[23] x ∈ real_closed_interval (of_nat m - 1) (of_nat n)
    #[24] has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n)))
  ← rule has_real_derivative_within_subset param_s="real_closed_interval (of_nat m - 1) (of_nat n + 1)" goal=24
    #[25] has_real_derivative g (f x) (within (atreal x) (real_closed_interval (of_nat m - 1) (of_nat n + 1)))
    #[26] real_closed_interval (of_nat m - 1) (of_nat n) ⊆ real_closed_interval (of_nat m - 1) (of_nat n + 1)
  ← apply_prev goal=25 facts=[2]
    #[27] x ∈ real_closed_interval (of_nat m - 1) (of_nat n + 1)
  ← rewrite real_closed_interval_def sym=false goal=27
    #[28] x ∈ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  → rewrite target=fact real_closed_interval_def sym=false goal=28 facts=[23]
    #[29] x ∈ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n}
  ← z3 goal=28 facts=[29]
    #[30] x ∈ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← rewrite real_closed_interval_def sym=false goal=26
    #[31] {p::real. of_nat m - 1 ≤ p ∧ p ≤ of_nat n} ⊆ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← z3 goal=31
    #[32] {p::real. of_nat m - 1 ≤ p ∧ p ≤ of_nat n} ⊆ {p. of_nat m - 1 ≤ p ∧ p ≤ of_nat n + 1}
  ← z3 goal=22 facts=[3]
    #[33] ∀x. ∀y. of_nat m - 1 ≤ x ⟶ x ≤ y ⟶ y ≤ of_nat n ⟶ f y ≤ f x
qed

theorem reallim_posinfinity_sequentially
  fixes f :: real => real, l :: real
  prop tendsto_real f l at_posinfinity --> tendsto_real (%n. f (of_nat n)) l sequentially
  [hint_backward,hint_forward]

theorem reallim_zero_posinfinity
  fixes f :: real => real, l :: real
  prop tendsto_real (%x. f (1 / x)) l (atreal 0) --> tendsto_real f l at_posinfinity
  [hint_backward,hint_forward]

theorem reallim_zero_neginfinity
  fixes f :: real => real, l :: real
  prop tendsto_real (%x. f (1 / x)) l (atreal 0) --> tendsto_real f l at_neginfinity
  [hint_backward,hint_forward]

def closed_real_segment :: real ⇒ real ⇒ real set = closed_real_segment a b = {x. ∃u. x = (1 - u) * a + u * b ∧ 0 ≤ u ∧ u ≤ 1}

def open_real_segment :: real ⇒ real ⇒ real set = open_real_segment a b = diff (closed_real_segment a b) ({a, b})

theorem open_real_segment_interval
  fixes a :: real, b :: real
  prop open_real_segment a b = (if a <= b then real_open_interval a b else real_open_interval b a)
  [hint_rewrite]

theorem closed_real_segment_interval
  fixes a :: real, b :: real
  prop closed_real_segment a b = (if a <= b then real_closed_interval a b else real_closed_interval b a)
  [hint_rewrite]

theorem closed_real_interval_subset_real_segment
  fixes a :: real, b :: real
  prop real_closed_interval a b Sub closed_real_segment a b

theorem open_real_interval_subset_real_segment
  fixes a :: real, b :: real
  prop real_open_interval a b Sub open_real_segment a b

theorem real_continuous_injective_iff_monotonic
  fixes f :: real => real, s :: real set
  prop real_continuous_on f s --> is_realinterval s --> (!x. !y. x Mem s --> y Mem s --> f x = f y --> x = y) <--> (!x. !y. x Mem s --> y Mem s --> x < y --> f x < f y) | (!x. !y. x Mem s --> y Mem s --> x < y --> f y < f x)
  [hint_backward,hint_backward1]

theorem ends_in_real_segment1
  fixes a :: real, b :: real
  prop a Mem closed_real_segment a b
  [hint_resolve,hint_backward]

theorem ends_in_real_segment2
  fixes a :: real, b :: real
  prop b Mem closed_real_segment a b
  [hint_resolve,hint_backward]

theorem is_real_interval_contains_segment
  fixes s :: real set
  prop is_realinterval s <--> (!a. !b. a Mem s --> b Mem s --> closed_real_segment a b Sub s)
  [hint_rewrite]

theorem is_realinterval_contains_segment_eq
  fixes s :: real set
  prop is_realinterval s <--> (!a. !b. closed_real_segment a b Sub s <--> a Mem s & b Mem s)
  [hint_rewrite,hint_backward,hint_resolve]
proof
  ← rewrite is_real_interval_contains_segment goal=0
    #[1] (∀a. ∀b. a ∈ s ⟶ b ∈ s ⟶ closed_real_segment a b ⊆ s) ⟷ (∀a. ∀b. closed_real_segment a b ⊆ s ⟷ a ∈ s ∧ b ∈ s)
  ← rule iffI goal=1
    #[2] (∀a. ∀b. a ∈ s ⟶ b ∈ s ⟶ closed_real_segment a b ⊆ s) ⟶ (∀a. ∀b. closed_real_segment a b ⊆ s ⟷ a ∈ s ∧ b ∈ s)
    #[3] (∀a. ∀b. closed_real_segment a b ⊆ s ⟷ a ∈ s ∧ b ∈ s) ⟶ (∀a. ∀b. a ∈ s ⟶ b ∈ s ⟶ closed_real_segment a b ⊆ s)
  ← intro goal=2
    #[4] ∀a. ∀b. a ∈ s ⟶ b ∈ s ⟶ closed_real_segment a b ⊆ s
    #[5] ∀a. ∀b. closed_real_segment a b ⊆ s ⟷ a ∈ s ∧ b ∈ s
  ← intro "a, b" goal=5
    #[6] _VAR a
    #[7] _VAR b
    #[8] closed_real_segment a b ⊆ s ⟷ a ∈ s ∧ b ∈ s
  ← rule iffI goal=8
    #[9] closed_real_segment a b ⊆ s ⟶ a ∈ s ∧ b ∈ s
    #[10] a ∈ s ∧ b ∈ s ⟶ closed_real_segment a b ⊆ s
  ← intro goal=9
    #[11] closed_real_segment a b ⊆ s
    #[12] a ∈ s ∧ b ∈ s
  ← rule conjI goal=12
    #[13] a ∈ s
    #[14] b ∈ s
  ← rule subsetE goal=13 facts=[11]
    #[15] a ∈ closed_real_segment a b
  ← rule ends_in_real_segment1 goal=15
    #[16] a ∈ closed_real_segment a b
  ← rule subsetE goal=14 facts=[11]
    #[17] b ∈ closed_real_segment a b
  ← rule ends_in_real_segment2 goal=17
    #[18] b ∈ closed_real_segment a b
  ← intro goal=10
    #[19] a ∈ s ∧ b ∈ s
    #[20] closed_real_segment a b ⊆ s
  ← apply_prev goal=20 facts=[4]
    #[21] a ∈ s
    #[22] b ∈ s
  ← rule conjD1 goal=21 facts=[19]
    #[23] a ∈ s
  ← rule conjD2 goal=22 facts=[19]
    #[24] b ∈ s
  ← intro goal=3
    #[25] ∀a. ∀b. closed_real_segment a b ⊆ s ⟷ a ∈ s ∧ b ∈ s
    #[26] ∀a. ∀b. a ∈ s ⟶ b ∈ s ⟶ closed_real_segment a b ⊆ s
  ← intro a,b goal=26
    #[27] a ∈ s
    #[28] b ∈ s
    #[29] closed_real_segment a b ⊆ s
  → inst target=fact a goal=28 facts=[25]
    #[30] ∀b. closed_real_segment a b ⊆ s ⟷ a ∈ s ∧ b ∈ s
  → inst target=fact b goal=28 facts=[30]
    #[31] closed_real_segment a b ⊆ s ⟷ a ∈ s ∧ b ∈ s
  ← rewrite source=prev goal=29 facts=[31]
    #[32] a ∈ s ∧ b ∈ s
  ← rule conjI goal=32
qed

theorem is_realinterval_contains_segment_imp
  fixes s :: real set
  prop is_realinterval s --> (!a. !b. closed_real_segment a b Sub s <--> a Mem s & b Mem s)

theorem is_realinterval_closed_segment
  fixes a :: real, b :: real
  prop is_realinterval (closed_real_segment a b)

theorem is_realinterval_open_segment
  fixes a :: real, b :: real
  prop is_realinterval (open_real_segment a b)

theorem is_closed_real_segment
  fixes a :: real, b :: real, x :: real
  prop x Mem closed_real_segment a b <--> a <= x & x <= b | b <= x & x <= a
  [hint_rewrite]

theorem is_open_real_segment
  fixes a :: real, b :: real, x :: real
  prop x Mem open_real_segment a b <--> a < x & x < b | b < x & x < a
  [hint_rewrite]

theorem floor_continuous_monotone_floor
  fixes f :: real => real, s :: real set
  prop is_realinterval s --> real_continuous_on f s --> (!x. !y. x Mem s --> y Mem s --> x <= y --> f x <= f y) & (!x. x Mem s --> integer (f x) --> integer x) --> (!x. floor x Mem s --> x Mem s --> floor (f (floor x)) = floor (f x))
  [hint_backward,hint_backward1]

def real_convex_on :: (real ⇒ real) ⇒ real set ⇒ bool = real_convex_on f s ⟷ (∀x. ∀y. ∀u. ∀v. x ∈ s ⟶ y ∈ s ⟶ 0 ≤ u ⟶ 0 ≤ v ⟶ u + v = 1 ⟶ f (u * x + v * y) ≤ u * f x + v * f y) [hint_rewrite]

theorem real_convex_on_empty
  fixes f :: real => real
  prop real_convex_on f {}
  [hint_backward]

theorem real_convex_on_eq
  fixes f :: real => real, g :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> f x = g x) --> real_convex_on f s --> real_convex_on g s
  [hint_backward,hint_backward1]

theorem real_convex_on_sing
  fixes a :: real, f :: real => real
  prop real_convex_on f ({a})

theorem real_convex_on_subset
  fixes f :: real => real, s :: real set, t :: real set
  prop real_convex_on f t --> s Sub t --> real_convex_on f s
  [hint_backward,hint_backward1]

theorem real_convex_on_const
  fixes c :: real, s :: real set
  prop real_convex_on (%x. c) s

theorem real_convex_add
  fixes f :: real => real, g :: real => real, s :: real set
  prop real_convex_on f s --> real_convex_on g s --> real_convex_on (%x. f x + g x) s
  [hint_backward,hint_backward1]

theorem real_convex_lmul
  fixes c :: real, f :: real => real, s :: real set
  prop 0 <= c --> real_convex_on f s --> real_convex_on (%x. c * f x) s
  [hint_backward,hint_backward1]

theorem real_convex_rmul
  fixes c :: real, f :: real => real, s :: real set
  prop 0 <= c --> real_convex_on f s --> real_convex_on (%x. f x * c) s
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ c
    #[2] real_convex_on f s
    #[3] real_convex_on (λx. f x * c) s
  ← rewrite real_mult_comm sym=false goal=3
    #[4] real_convex_on (λx. c * f x) s
  ← rule real_convex_lmul goal=4 facts=[1,2]
qed

theorem real_convex_on_sum
  fixes f :: 'a => real => real, s :: 'a set, t :: real set
  prop finite s --> (!a. a Mem s --> real_convex_on (f a) t) --> real_convex_on (%x. sum s (%a. f a x)) t
  [hint_backward,hint_backward1]

theorem real_convex_compose
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set
  prop real_convex_on f s --> real_convex_on g t --> is_realinterval s --> is_realinterval t --> image f s Sub t --> (!x. !y. x Mem t --> y Mem t --> x <= y --> g x <= g y) --> real_convex_on (g O f) s
  [hint_backward,hint_backward1]

theorem real_convex_lower
  fixes f :: real => real, s :: real set, u :: real, v :: real, x :: real, y :: real
  prop real_convex_on f s --> x Mem s --> y Mem s --> 0 <= u --> 0 <= v --> u + v = 1 --> f (u * x + v * y) <= max (f x) (f y)
  [hint_backward,hint_backward1]

theorem real_convex_lower_real_segment
  fixes a :: real, b :: real, f :: real => real, s :: real set, x :: real
  prop real_convex_on f s --> a Mem s --> b Mem s --> x Mem closed_real_segment a b --> f x <= max (f a) (f b)
  [hint_backward,hint_backward1]

theorem real_convex_lower_real_interval
  fixes a :: real, b :: real, f :: real => real, x :: real
  prop real_convex_on f (real_closed_interval a b) --> x Mem closed_real_segment a b --> f x <= max (f a) (f b)
  [hint_backward,hint_backward1]

theorem real_convex_local_global_minimum
  fixes f :: real => real, s :: real set, t :: real set, x :: real
  prop real_convex_on f s --> x Mem t --> real_open t --> t Sub s --> (!y. y Mem t --> f x <= f y) --> (!y. y Mem s --> f x <= f y)
  [hint_backward,hint_backward1]

theorem real_convex_distance
  fixes a :: real, s :: real set
  prop real_convex_on (%x. abs (a - x)) s
  [hint_backward]

theorem real_convex_on_jensen
  fixes f :: real => real, s :: real set
  prop is_realinterval s --> real_convex_on f s <--> (!k. !u. !x. (!i. 1 <= i --> i <= k --> 0 < u i & x i Mem s) --> sum ({1..k}) u = 1 --> f (sum ({1..k}) (%i. u i * x i)) <= sum ({1..k}) (%i. u i * f (x i)))
  [hint_backward]

theorem real_convex_on_imp_jensen
  fixes f :: real => real, k :: 'a set, s :: real set, u :: 'a => real, x :: 'a => real
  prop real_convex_on f s --> is_realinterval s --> finite k --> (!i. i Mem k --> 0 <= u i & x i Mem s) --> sum k u = 1 --> f (sum k (%i. u i * x i)) <= sum k (%i. u i * f (x i))
  [hint_backward,hint_backward1]

theorem real_convex_on_continuous
  fixes f :: real => real, s :: real set
  prop real_open s --> real_convex_on f s --> real_continuous_on f s
  [hint_backward,hint_backward1]

theorem real_convex_on_left_secant_mul
  fixes f :: real => real, s :: real set
  prop real_convex_on f s <--> (!a. !b. !x. a Mem s --> b Mem s --> x Mem closed_real_segment a b --> (f x - f a) * abs (b - a) <= (f b - f a) * abs (x - a))
  [hint_rewrite]

theorem real_convex_on_right_secant_mul
  fixes f :: real => real, s :: real set
  prop real_convex_on f s <--> (!a. !b. !x. a Mem s --> b Mem s --> x Mem closed_real_segment a b --> (f b - f a) * abs (b - x) <= (f b - f x) * abs (b - a))
  [hint_rewrite]

theorem real_convex_on_left_secant
  fixes f :: real => real, s :: real set
  prop real_convex_on f s <--> (!a. !b. !x. a Mem s --> b Mem s --> x Mem closed_real_segment a b --> (f x - f a) / abs (x - a) <= (f b - f a) / abs (b - a))
  [hint_rewrite]

theorem real_convex_on_right_secant
  fixes f :: real => real, s :: real set
  prop real_convex_on f s <--> (!a. !b. !x. a Mem s --> b Mem s --> x Mem closed_real_segment a b --> (f b - f a) / abs (b - a) <= (f b - f x) * abs (b - x))
  [hint_rewrite]

theorem real_convex_on_derivative_secant_imp
  fixes f :: real => real, f1 :: real, s :: real set, x :: real, y :: real
  prop real_convex_on f s --> closed_real_segment x y Sub s --> has_real_derivative f f1 (within (atreal x) s) --> f1 * (y - x) <= f y - f x
  [hint_backward,hint_backward1]

theorem real_convex_on_secant_derivative_imp
  fixes f :: real => real, f1 :: real, s :: real set, x :: real, y :: real
  prop real_convex_on f s --> closed_real_segment x y Sub s --> has_real_derivative f f1 (within (atreal y) s) --> f y - f x <= f1 * (y - x)
  [hint_backward,hint_backward1]

theorem real_convex_on_derivative_imp
  fixes f :: real => real, f1x :: real, f1y :: real, s :: real set, x :: real, y :: real
  prop real_convex_on f s --> closed_real_segment x y Sub s --> has_real_derivative f f1x (within (atreal x) s) --> has_real_derivative f f1y (within (atreal y) s) --> f1x * (y - x) <= f1y * (y - x)
  [hint_backward,hint_backward1]

theorem real_convex_on_derivative_increasing_imp
  fixes f :: real => real, f1x :: real, f1y :: real, s :: real set, x :: real, y :: real
  prop real_convex_on f s --> real_closed_interval x y Sub s --> has_real_derivative f f1x (within (atreal x) s) --> has_real_derivative f f1y (within (atreal y) s) --> x < y --> f1x <= f1y
  [hint_backward,hint_backward1]

theorem real_convex_on_derivative_secant
  fixes f :: real => real, f1 :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> has_real_derivative f (f1 x) (within (atreal x) s)) --> real_convex_on f s <--> (!x. !y. x Mem s --> y Mem s --> f1 x * (y - x) <= f y - f x)
  [hint_backward,hint_backward1]

theorem real_convex_on_secant_derivative
  fixes f :: real => real, f1 :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> has_real_derivative f (f1 x) (within (atreal x) s)) --> real_convex_on f s <--> (!x. !y. x Mem s --> y Mem s --> f y - f x <= f1 y * (y - x))
  [hint_backward,hint_backward1]

theorem real_convex_on_derivatives
  fixes f :: real => real, f1 :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> has_real_derivative f (f1 x) (within (atreal x) s)) --> real_convex_on f s <--> (!x. !y. x Mem s --> y Mem s --> f1 x * (y - x) <= f1 y * (y - x))
  [hint_backward,hint_backward1]

theorem real_convex_on_derivatives_increasing
  fixes f :: real => real, f1 :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> has_real_derivative f (f1 x) (within (atreal x) s)) --> real_convex_on f s <--> (!x. !y. x Mem s --> y Mem s & x <= y --> f1 x <= f1 y)
  [hint_backward,hint_backward1]

theorem has_real_derivative_increasing_imp
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> has_real_derivative f (f1 x) (within (atreal x) s)) --> (!x. x Mem s --> 0 <= f1 x) --> a Mem s --> b Mem s --> a <= b --> f a <= f b
  [hint_backward,hint_backward1]

theorem has_real_derivative_increasing
  fixes f :: real => real, f1 :: real => real, s :: real set
  prop is_realinterval s & ~(?a. s = {a}) & (!x. x Mem s --> has_real_derivative f (f1 x) (within (atreal x) s)) --> (!x. x Mem s --> 0 <= f1 x) <--> (!x. !y. x Mem s & y Mem s & x <= y --> f x <= f y)

theorem has_real_derivative_strictly_increasing_imp
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real
  prop (!x. x Mem real_closed_interval a b --> has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) & (!x. x Mem real_closed_interval a b --> 0 <= f1 x) & a < b --> f a < f b

theorem real_convex_on_second_derivative
  fixes f :: real => real, f1 :: real => real, f2 :: real => real, s :: real set
  prop is_realinterval s --> ~(?a. s = {a}) --> (!x. x Mem s --> has_real_derivative f (f1 x) (within (atreal x) s)) --> (!x. x Mem s --> has_real_derivative f1 (f2 x) (within (atreal x) s)) --> real_convex_on f s <--> (!x. x Mem s --> 0 <= f2 x)
  [hint_backward,hint_backward1]

theorem real_convex_on_asym
  fixes f :: real => real, s :: real set
  prop real_convex_on f s <--> (!x. !y. !u. !v. x Mem s --> y Mem s --> x < y --> 0 <= u --> 0 <= v --> u + v = 1 --> f (u * x + v * y) <= u * f x + v * f y)
  [hint_rewrite]

theorem real_convex_on_exp
  fixes s :: real set
  prop real_convex_on exp s
  [hint_backward]

theorem real_convex_on_rpow
  fixes s :: real set, t :: real
  prop s Sub {x. 0 <= x} --> 1 <= t --> real_convex_on (%x. x ^ t) s
  [hint_backward,hint_backward1]

theorem real_convex_on_rpow_neg
  fixes s :: real set, t :: real
  prop s Sub {x. x < 0} --> t <= 0 --> real_convex_on (%x. x ^ t) s
  [hint_backward,hint_backward1]

theorem real_convex_on_rpow_integer
  fixes s :: real set, t :: real
  prop s Sub {x. 0 < x} --> integer t --> real_convex_on (%x. x ^ t) s
  [hint_backward,hint_backward1]

theorem real_convex_on_real_inv
  fixes s :: real set
  prop s Sub {x. 0 < x} --> real_convex_on real_inverse s
  [hint_backward]

theorem real_convex_on_real_
  fixes f :: real => real, n :: nat, s :: real set
  prop real_convex_on f s --> is_realinterval s --> (!x. x Mem s --> 0 <= f x) --> real_convex_on (%x. f x ^ n) s
  [hint_backward,hint_backward1]

theorem real_convex_on_log
  fixes s :: real set
  prop s Sub {x. 0 < x} --> real_convex_on (%x. -(log x)) s
  [hint_backward]

theorem real_continuous_midpoint_convex
  fixes f :: real => real, s :: real set
  prop real_continuous_on f s --> is_realinterval s --> (!x. !y. x Mem s --> y Mem s --> f ((x + y) / 2) <= (f x + f y) / 2) --> real_convex_on f s
  [hint_backward,hint_backward1]

theorem agm_gen
  fixes a :: 'a => real, k :: 'a set, x :: 'a => real
  prop finite k --> sum k a = 1 --> (!i. i Mem k --> 0 <= a i & 0 <= x i) --> product k (%i. x i ^ a i) <= sum k (%i. a i * x i)
  [hint_backward,hint_backward1]

theorem agm_rpow
  fixes k :: 'a set, n :: nat, x :: 'a => real
  prop has_size k n --> ~(n = 0) --> (!i. i Mem k --> 0 <= x i) --> product k (%i. x i ^ (1 / of_nat n)) <= sum k (%i. x i / of_nat n)
  [hint_backward,hint_backward1]

theorem agm_boot
  fixes k :: 'a set, n :: nat, x :: 'a => real
  prop has_size k n --> ~(n = 0) --> (!i. i Mem k --> 0 <= x i) --> root n (product k x) <= sum k x / of_nat n
  [hint_backward,hint_backward1]

theorem agm_sqrt
  fixes x :: real, y :: real
  prop 0 <= x --> 0 <= y --> sqrt (x + y) <= (x + y) / 2
  [hint_backward,hint_backward1]

theorem agm
  fixes k :: 'a set, n :: nat, x :: 'a => real
  prop has_size k n --> ~(n = 0) --> (!i. i Mem k --> 0 <= x i) --> product k x <= (sum k x / of_nat n) ^ n
  [hint_backward,hint_backward1]

theorem agm_2
  fixes u :: real, v :: real, x :: real, y :: real
  prop 0 <= x --> 0 <= y --> 0 <= u --> 0 <= v --> u + v = 1 --> x ^ u * y ^ v <= u * x + v * y
  [hint_backward,hint_backward1]

theorem young_inequality
  fixes u :: real, v :: real, x :: real, y :: real
  prop 0 <= x --> 0 <= y --> 0 < u --> 0 < v --> real_inverse u + real_inverse v = 1 --> x * y <= x ^ u / u + y ^ v / v
  [hint_backward,hint_backward1]

theorem hoelder
  fixes a :: 'a => real, k :: 'a set, x :: 'a => real, y :: 'a => real
  prop finite k --> sum k a = 1 --> (!i. i Mem k --> 0 <= a i & 0 <= x i & 0 <= y i) --> product k (%i. x i ^ a i) + product k (%i. y i ^ a i) <= product k (%i. (x i + y i) ^ a i)
  [hint_backward,hint_backward1]

theorem rpow_minus1_quotient_lt
  fixes a :: real, x :: real, y :: real
  prop 0 < a --> ~(a = 1) --> 0 < x --> x < y --> (a ^ x - 1) / x < (a ^ y - 1) / y
  [hint_backward,hint_backward1]

theorem rpow_minus1_quotient_le
  fixes a :: real, x :: real, y :: real
  prop 0 < a --> ~(a = 1) --> 0 < x --> x <= y --> (a ^ x - 1) / x <= (a ^ y - 1) / y
  [hint_backward,hint_backward1]

theorem real_exp_limit_rpow_lt
  fixes r :: real, s :: real, x :: real
  prop 0 < r --> r < s --> ~(x = 0) --> x < r --> (1 - x / r) ^ r < (1 - x / s) ^ s
  [hint_backward,hint_backward1]

theorem real_exp_limit_rpow_le
  fixes r :: real, s :: real, x :: real
  prop 0 <= r --> r <= s --> ~(x = 0) --> x <= r --> (1 - x / r) ^ r <= (1 - x / s) ^ s
  [hint_backward,hint_backward1]

theorem real_le_x_sinh
  fixes x :: real
  prop 0 <= x --> x <= (exp x - real_inverse (exp x)) / 2
  [hint_backward]

theorem real_le_abs_sinh
  fixes x :: real
  prop abs x <= abs ((exp x - real_inverse (exp x)) / 2)
  [hint_backward]

def real_log_convex_on :: (real ⇒ real) ⇒ real set ⇒ bool = real_log_convex_on f s ⟷ (∀x. ∀y. ∀u. ∀v. x ∈ s ⟶ y ∈ s ⟶ 0 ≤ u ⟶ 0 ≤ v ⟶ u + v = 1 ⟶ 0 ≤ f (u * x + v * y) ∧ f (u * x + v * y) ≤ f x ^ u * f y ^ v) [hint_rewrite]

theorem real_log_convex_on_empty
  fixes f :: real => real
  prop real_log_convex_on f {}
  [hint_backward]

theorem real_log_convex_on_subset
  fixes f :: real => real, s :: real set, t :: real set
  prop real_log_convex_on f t --> s Sub t --> real_log_convex_on f s
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] real_log_convex_on f t
    #[2] s ⊆ t
    #[3] real_log_convex_on f s
  ← rewrite real_log_convex_on_def sym=false goal=3
    #[4] ∀x. ∀y. ∀u. ∀v. x ∈ s ⟶ y ∈ s ⟶ 0 ≤ u ⟶ 0 ≤ v ⟶ u + v = 1 ⟶ 0 ≤ f (u * x + v * y) ∧ f (u * x + v * y) ≤ f x ^ u * f y ^ v
  → rewrite target=fact real_log_convex_on_def sym=false goal=4 facts=[1]
    #[5] ∀x. ∀y. ∀u. ∀v. x ∈ t ⟶ y ∈ t ⟶ 0 ≤ u ⟶ 0 ≤ v ⟶ u + v = 1 ⟶ 0 ≤ f (u * x + v * y) ∧ f (u * x + v * y) ≤ f x ^ u * f y ^ v
  ← intro x,y,u,v goal=4
    #[6] _VAR x
    #[7] _VAR y
    #[8] _VAR u
    #[9] _VAR v
    #[10] x ∈ s
    #[11] y ∈ s
    #[12] 0 ≤ u
    #[13] 0 ≤ v
    #[14] u + v = 1
    #[15] 0 ≤ f (u * x + v * y) ∧ f (u * x + v * y) ≤ f x ^ u * f y ^ v
  ← apply_prev goal=15 facts=[5]
    #[16] x ∈ t
    #[17] y ∈ t
  ← rule subsetE goal=16 facts=[2]
  ← rule subsetE goal=17 facts=[2]
qed

theorem real_log_convex_on_eq
  fixes f :: real => real, g :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> f x = g x) --> real_log_convex_on f s --> real_log_convex_on g s
  [hint_backward,hint_backward1]

theorem real_log_convex_on_sing
  fixes a :: real, f :: real => real
  prop real_log_convex_on f ({a}) <--> 0 <= f a
  [hint_rewrite]

theorem real_log_convex_imp_pos
  fixes f :: real => real, s :: real set, x :: real
  prop real_log_convex_on f s --> x Mem s --> 0 <= f x
  [hint_backward1]

theorem real_log_convex_on_convex
  fixes f :: real => real, s :: real set
  prop is_realinterval s --> real_log_convex_on f s <--> (!x. x Mem s --> 0 <= f x) & (!x. !y. !u. !v. x Mem s --> y Mem s --> 0 <= u --> 0 <= v --> u + v = 1 --> f (u * x + v * y) <= f x ^ u * f y ^ v)
  [hint_backward]

theorem real_log_convex_on
  fixes f :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> 0 < f x) --> real_log_convex_on f s <--> real_log_convex_on (log O f) s
  [hint_backward,hint_backward1]

theorem real_log_convex_imp_convex
  fixes f :: real => real, s :: real set
  prop real_log_convex_on f s --> real_convex_on f s
  [hint_backward,hint_forward]

theorem real_log_convex_add
  fixes f :: real => real, g :: real => real, s :: real set
  prop real_log_convex_on f s --> real_log_convex_on g s --> real_log_convex_on (%x. f x + g x) s
  [hint_backward,hint_backward1]

theorem real_log_convex_mul
  fixes f :: real => real, g :: real => real, s :: real set
  prop real_log_convex_on f s --> real_log_convex_on g s --> real_log_convex_on (%x. f x * g x) s
  [hint_backward,hint_backward1]

theorem midpoint_real_log_convex
  fixes f :: real => real, s :: real set
  prop real_continuous_on f s --> is_realinterval s --> (!x. x Mem s --> 0 < f x) --> (!x. !y. x Mem s --> y Mem s --> f ((x + y) / 2) ^ (2::nat) <= f x * f y) --> real_log_convex_on f s
  [hint_backward,hint_backward1]

theorem real_log_convex_const
  fixes a :: real, s :: real set
  prop 0 <= a --> real_log_convex_on (%x. a) s
  [hint_backward]

theorem real_log_convex_product
  fixes f :: real => 'a => real, k :: 'a set, s :: real set
  prop finite k --> (!i. i Mem k --> real_log_convex_on (%x. f x i) s) --> real_log_convex_on (%x. product k (f x)) s
  [hint_backward,hint_backward1]

theorem real_log_convex_rpow_right
  fixes a :: real, s :: real set
  prop 0 < a --> real_log_convex_on (%x. a ^ x) s
  [hint_backward]

theorem real_log_convex_lim
  fixes f :: 'a => real => real, g :: real => real, net :: 'a net, s :: real set
  prop ~(trivial_limit net) --> (!x. !y. !u. !v. x Mem s --> y Mem s --> 0 <= u --> 0 <= v --> u + v = 1 --> tendsto_real (%i. f i (u * x + v * y)) (g (u * x + v * y)) net) & eventually (%i. real_log_convex_on (f i) s) net --> real_log_convex_on g s
  [hint_backward,hint_backward1]

