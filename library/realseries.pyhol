theorem has_limsup_mul_reallim_left
  fixes a :: real, b :: real, f :: 'a => real, g :: 'a => real, net :: 'a net
  prop tendsto_real f a net --> has_limsup g b net --> eventually (%x. 0 <= f x) net --> eventually (%x. 0 <= g x) net --> has_limsup (%x. f x * g x) (a * b) net
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] tendsto_real f a net
    #[2] has_limsup g b net
    #[3] eventually (λx. 0 ≤ f x) net
    #[4] eventually (λx. 0 ≤ g x) net
    #[5] has_limsup (λx. f x * g x) (a * b) net
  ← rewrite real_mult_comm sym=false goal=5
    #[6] has_limsup (λx. g x * f x) (b * a) net
  ← rule has_limsup_mul_reallim_right goal=6
qed

theorem has_limsup_sequentially_within_lbound_zero
  fixes b :: real, f :: nat => real, k :: nat set
  prop has_limsup f b (within sequentially k) --> (!x. 0 <= f x) --> ~(finite k) --> 0 <= b
  [hint_backward1]
proof
  ← intro goal=0
    #[1] has_limsup f b (within sequentially k)
    #[2] ∀x. 0 ≤ f x
    #[3] ¬(finite k)
    #[4] 0 ≤ b
  ← rule has_limsup_le param_f="(%n::nat. (0::real))" param_g=f param_net="(within sequentially k)" goal=4
    #[5] has_limsup (λn. 0) 0 (within sequentially k)
    #[6] ¬(trivial_limit (within sequentially k))
    #[7] eventually (λx. 0 ≤ f x) (within sequentially k)
  ← rule reallim_imp_has_limsup goal=5
    #[8] tendsto_real (λn. 0) 0 (within sequentially k)
  ← rule reallim_const goal=8
    #[9] tendsto_real (λn. 0) 0 (within sequentially k)
  ← rewrite trivial_limit_sequentially_within sym=false goal=6
  ← rule always_eventually goal=7
qed

theorem has_liminf_transform
  fixes f :: 'a => real, g :: 'a => real, l :: real, net :: 'a net
  prop eventually (%x. f x = g x) net --> has_liminf f l net --> has_liminf g l net
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] eventually (λx. f x = g x) net
    #[2] has_liminf f l net
    #[3] has_liminf g l net
  ← rewrite has_liminf_def sym=false goal=3
    #[4] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ g x) net}) l
  → rewrite target=fact has_liminf_def sym=false goal=4 facts=[2]
    #[5] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rule disjE goal=4 facts=[5]
    #[6] trivial_limit net ⟶ trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ g x) net}) l
    #[7] has_sup ({b. eventually (λx. b ≤ f x) net}) l ⟶ trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ g x) net}) l
  ← intro goal=6
    #[8] trivial_limit net
    #[9] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ g x) net}) l
  ← rule disjI1 goal=9
  ← intro goal=7
    #[10] has_sup ({b. eventually (λx. b ≤ f x) net}) l
    #[11] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ g x) net}) l
  ← rule disjI2 goal=11
    #[12] has_sup ({b. eventually (λx. b ≤ g x) net}) l
  cut "!b. eventually (λx. b ≤ f x) net <--> eventually (λx. b ≤ g x) net" goal=12
    #[13] ∀b. eventually (λx. b ≤ f x) net ⟷ eventually (λx. b ≤ g x) net
  ← intro b goal=13
    #[14] _VAR b
    #[15] eventually (λx. b ≤ f x) net ⟷ eventually (λx. b ≤ g x) net
  ← rule eventually_iff goal=15
    #[16] eventually (λx. b ≤ f x ⟷ b ≤ g x) net
  ← rule eventually_mp param_P="(λx. f x = g x)" goal=16
    #[17] eventually (λx. f x = g x ⟶ b ≤ f x ⟷ b ≤ g x) net
  ← rule always_eventually goal=17
    #[18] ∀x. f x = g x ⟶ b ≤ f x ⟷ b ≤ g x
  ← z3 goal=18
    #[19] ∀x. f x = g x ⟶ b ≤ f x ⟷ b ≤ g x
  → rewrite target=fact source=prev goal=12 facts=[13,10]
qed

theorem has_liminf_eventually_lbound
  fixes b :: real, f :: 'a => real, l :: real, net :: 'a net
  prop ~(trivial_limit net) --> has_liminf f l net --> b < l --> eventually (%x. b < f x) net
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(trivial_limit net)
    #[2] has_liminf f l net
    #[3] b < l
    #[4] eventually (λx. b < f x) net
  → rewrite target=fact has_liminf_def sym=false goal=4 facts=[2]
    #[5] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rule disjE goal=4 facts=[5]
    #[6] trivial_limit net ⟶ eventually (λx. b < f x) net
    #[7] has_sup ({b1. eventually (λx. b1 ≤ f x) net}) l ⟶ eventually (λx. b < f x) net
  ← intro goal=6
    #[8] trivial_limit net
    #[9] eventually (λx. b < f x) net
  ← rule negE_gen goal=9 facts=[1,8]
    #[10] eventually (λx. b < f x) net
  ← intro goal=7
    #[11] has_sup ({b. eventually (λx. b ≤ f x) net}) l
    #[12] eventually (λx. b < f x) net
  → forward has_sup_approach param_c=b param_l=l param_s="{b. eventually (λx. b ≤ f x) net}" goal=12
    #[13] has_sup ({b1. eventually (λx. b1 ≤ f x) net}) l ⟶ b < l ⟶ (∃x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ∧ b < x)
  → forward goal=12 facts=[13,11,3]
    #[14] ∃x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ∧ b < x
  → rewrite target=fact member_collect sym=false goal=12 facts=[14]
    #[15] ∃x. eventually (λx1. x ≤ f x1) net ∧ b < x
  elim c goal=12 facts=[15]
    #[16] _VAR c
    #[17] eventually (λx. c ≤ f x) net ∧ b < c
    #[18] eventually (λx. b < f x) net
  → forward conjD1 goal=18 facts=[17]
    #[19] eventually (λx. c ≤ f x) net
  ← rule eventually_mp param_P="(λx. c ≤ f x)" goal=18
    #[20] eventually (λx. c ≤ f x ⟶ b < f x) net
  ← rule always_eventually goal=20
    #[21] ∀x. c ≤ f x ⟶ b < f x
  → forward conjD2 goal=21 facts=[17]
    #[22] b < c
  ← z3 goal=21 facts=[22]
    #[23] ∀x. c ≤ f x ⟶ b < f x
qed

theorem reallim_imp_has_liminf
  fixes f :: 'a => real, l :: real, net :: 'a net
  prop tendsto_real f l net --> has_liminf f l net
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] tendsto_real f l net
    #[2] has_liminf f l net
  ← rewrite has_liminf_def sym=false goal=2
    #[3] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← cases "trivial_limit net" goal=3
    #[4] trivial_limit net ⟶ trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
    #[5] ¬(trivial_limit net) ⟶ trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← intro goal=4
    #[6] trivial_limit net
    #[7] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rule disjI1 goal=7
  ← intro goal=5
    #[8] ¬(trivial_limit net)
    #[9] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rule disjI2 goal=9
    #[10] has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rewrite has_sup sym=false goal=10
    #[11] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟶ x ≤ l) ∧ (∀c. c < l ⟶ (∃x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ∧ c < x))
  ← rule conjI goal=11
    #[12] ¬({b. eventually (λx. b ≤ f x) net} = ∅)
    #[13] (∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟶ x ≤ l) ∧ (∀c. c < l ⟶ (∃x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ∧ c < x))
  ← rule negI goal=12
    #[14] {b. eventually (λx. b ≤ f x) net} = ∅ ⟶ false
  ← rewrite set_equal_iff sym=false goal=14
    #[15] (∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ x ∈ ∅) ⟶ false
  ← rewrite member_empty_simp sym=false goal=15
    #[16] (∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ false) ⟶ false
  ← intro goal=16
    #[17] ∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ false
    #[18] false
  ← rule contrapositive goal=18 facts=[17]
    #[19] ¬false ⟶ ¬(∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ false)
  ← intro goal=19
    #[20] ¬false
    #[21] ¬(∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ false)
  ← rewrite not_all sym=false goal=21
    #[22] ∃x. ¬(x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ false)
  ← inst l-1 goal=22
    #[23] ¬(l - 1 ∈ {b. eventually (λx. b ≤ f x) net} ⟷ false)
  ← rewrite member_collect sym=false goal=23
    #[24] ¬(eventually (λx. l - 1 ≤ f x) net ⟷ false)
  ← rule negI goal=24
    #[25] eventually (λx. l - 1 ≤ f x) net ⟷ false ⟶ false
  ← intro goal=25
    #[26] eventually (λx. l - 1 ≤ f x) net ⟷ false
    #[27] false
  → rewrite target=fact eq_sym_eq sym=false goal=27 facts=[26]
    #[28] false ⟷ eventually (λx. l - 1 ≤ f x) net
  ← rewrite source=prev goal=27 facts=[28]
    #[29] eventually (λx. l - 1 ≤ f x) net
  → rewrite target=fact tendsto_real_def sym=false goal=29 facts=[1]
    #[30] ∀e. 0 < e ⟶ eventually (λx. abs (f x - l) < e) net
  → inst target=fact "(1::real)" goal=29 facts=[30]
    #[31] (0::real) < 1 ⟶ eventually (λx. abs (f x - l) < 1) net
  cut "(0::real) < 1" goal=29
    #[32] (0::real) < 1
  ← z3 goal=32
    #[33] (0::real) < 1
  → forward goal=29 facts=[31,33]
    #[34] eventually (λx. abs (f x - l) < 1) net
  ← rule eventually_mono param_P="(λx. abs (f x - l) < 1)" goal=29
    #[35] ∀x. abs (f x - l) < 1 ⟶ l - 1 ≤ f x
  ← z3 goal=35
    #[36] ∀x. abs (f x - l) < 1 ⟶ l - 1 ≤ f x
  ← rule conjI goal=13
    #[37] ∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟶ x ≤ l
    #[38] ∀c. c < l ⟶ (∃x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ∧ c < x)
  ← rewrite member_collect sym=false goal=37
    #[39] ∀x. eventually (λx1. x ≤ f x1) net ⟶ x ≤ l
  ← intro x goal=39
    #[40] _VAR x
    #[41] eventually (λx1. x ≤ f x1) net
    #[42] x ≤ l
  ← rule reallim_lbound param_f=f param_net=net goal=42
  ← intro c goal=38
    #[43] _VAR c
    #[44] c < l
    #[45] ∃x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ∧ c < x
  ← inst "(l+c)/2" goal=45
    #[46] (l + c) / 2 ∈ {b. eventually (λx. b ≤ f x) net} ∧ c < (l + c) / 2
  ← rewrite member_collect sym=false goal=46
    #[47] eventually (λx. (l + c) / 2 ≤ f x) net ∧ c < (l + c) / 2
  ← rule conjI goal=47
    #[48] eventually (λx. (l + c) / 2 ≤ f x) net
    #[49] c < (l + c) / 2
  → rewrite target=fact tendsto_real_def sym=false goal=48 facts=[1]
  → inst target=fact "(l-c)/2" goal=48 facts=[30]
    #[50] 0 < (l - c) / 2 ⟶ eventually (λx. abs (f x - l) < (l - c) / 2) net
  cut "0 < (l - c) / 2 " goal=48
    #[51] 0 < (l - c) / 2
  ← z3 goal=51 facts=[44]
    #[52] 0 < (l - c) / 2
  → forward goal=48 facts=[50,52]
    #[53] eventually (λx. abs (f x - l) < (l - c) / 2) net
  ← rule eventually_mono param_P="(λx. abs (f x - l) < (l - c) / 2)" goal=48
    #[54] ∀x. abs (f x - l) < (l - c) / 2 ⟶ (l + c) / 2 ≤ f x
  ← z3 goal=54 facts=[44]
    #[55] ∀x. abs (f x - l) < (l - c) / 2 ⟶ (l + c) / 2 ≤ f x
  ← z3 goal=49 facts=[44]
    #[56] c < (l + c) / 2
qed

theorem has_liminf_imp_lbound_le
  fixes f :: 'a => real, l :: real, net :: 'a net
  prop has_liminf f l net --> (?b. eventually (%x. b <= f x) net)
  [hint_forward,hint_backward]
proof
  ← intro goal=0
    #[1] has_liminf f l net
    #[2] ∃b. eventually (λx. b ≤ f x) net
  → rewrite target=fact has_liminf_def sym=false goal=2 facts=[1]
    #[3] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rule disjE goal=2 facts=[3]
    #[4] trivial_limit net ⟶ (∃b. eventually (λx. b ≤ f x) net)
    #[5] has_sup ({b. eventually (λx. b ≤ f x) net}) l ⟶ (∃b. eventually (λx. b ≤ f x) net)
  ← intro goal=4
    #[6] trivial_limit net
    #[7] ∃b. eventually (λx. b ≤ f x) net
  ← inst l goal=7
    #[8] eventually (λx. l ≤ f x) net
  ← rule eventually_trivial goal=8
  ← rewrite has_sup sym=false goal=5
    #[9] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟶ x ≤ l) ∧ (∀c. c < l ⟶ (∃x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ∧ c < x)) ⟶ (∃b. eventually (λx. b ≤ f x) net)
  ← rewrite member_collect sym=false goal=9
    #[10] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∀x. eventually (λx1. x ≤ f x1) net ⟶ x ≤ l) ∧ (∀c. c < l ⟶ (∃x. eventually (λx1. x ≤ f x1) net ∧ c < x)) ⟶ (∃b. eventually (λx. b ≤ f x) net)
  ← intro goal=10
    #[11] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∀x. eventually (λx1. x ≤ f x1) net ⟶ x ≤ l) ∧ (∀c. c < l ⟶ (∃x. eventually (λx1. x ≤ f x1) net ∧ c < x))
    #[12] ∃b. eventually (λx. b ≤ f x) net
  → forward conjD2 goal=12 facts=[11]
    #[13] (∀x. eventually (λx1. x ≤ f x1) net ⟶ x ≤ l) ∧ (∀c. c < l ⟶ (∃x. eventually (λx1. x ≤ f x1) net ∧ c < x))
  → forward conjD2 goal=12 facts=[13]
    #[14] ∀c. c < l ⟶ (∃x. eventually (λx1. x ≤ f x1) net ∧ c < x)
  → inst target=fact l-1 goal=12 facts=[14]
    #[15] l - 1 < l ⟶ (∃x. eventually (λx1. x ≤ f x1) net ∧ l - 1 < x)
  cut "l - 1 < l " goal=12
    #[16] l - 1 < l
  ← z3 goal=16
    #[17] l - 1 < l
  → forward goal=12 facts=[15,17]
    #[18] ∃x. eventually (λx1. x ≤ f x1) net ∧ l - 1 < x
  elim x goal=12 facts=[18]
    #[19] _VAR x
    #[20] eventually (λx1. x ≤ f x1) net ∧ l - 1 < x
    #[21] ∃b. eventually (λx. b ≤ f x) net
  ← inst x goal=21
    #[22] eventually (λx1. x ≤ f x1) net
  ← rule conjD1 goal=22 facts=[20]
    #[23] eventually (λx1. x ≤ f x1) net
qed

theorem has_liminf_not_lbound
  fixes c :: real, f :: 'a => real, l :: real, net :: 'a net
  prop ~(trivial_limit net) --> has_liminf f l net --> l < c --> ~(eventually (%x. c <= f x) net)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(trivial_limit net)
    #[2] has_liminf f l net
    #[3] l < c
    #[4] ¬(eventually (λx. c ≤ f x) net)
  → rewrite target=fact has_liminf_def sym=false goal=4 facts=[2]
    #[5] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rule disjE goal=4 facts=[5]
    #[6] trivial_limit net ⟶ ¬(eventually (λx. c ≤ f x) net)
    #[7] has_sup ({b. eventually (λx. b ≤ f x) net}) l ⟶ ¬(eventually (λx. c ≤ f x) net)
  ← intro goal=6
    #[8] trivial_limit net
    #[9] ¬(eventually (λx. c ≤ f x) net)
  ← rule negE_gen goal=9 facts=[1,8]
    #[10] ¬(eventually (λx. c ≤ f x) net)
  ← intro goal=7
    #[11] has_sup ({b. eventually (λx. b ≤ f x) net}) l
    #[12] ¬(eventually (λx. c ≤ f x) net)
  ← rule contrapositive goal=12 facts=[3]
    #[13] ¬¬(eventually (λx. c ≤ f x) net) ⟶ ¬(l < c)
  ← rewrite real_not_lt sym=false goal=13
    #[14] ¬¬(eventually (λx. c ≤ f x) net) ⟶ c ≤ l
  ← rewrite double_neg sym=false goal=14
    #[15] eventually (λx. c ≤ f x) net ⟶ c ≤ l
  ← intro goal=15
    #[16] eventually (λx. c ≤ f x) net
    #[17] c ≤ l
  ← rule has_sup_ubound goal=17 facts=[11]
    #[18] c ∈ {b. eventually (λx. b ≤ f x) net}
  ← rewrite member_collect sym=false goal=18
qed

theorem has_liminf
  fixes f :: 'a => real, l :: real, net :: 'a net
  prop has_liminf f l net <--> trivial_limit net | (!c. c < l --> eventually (%x. c <= f x) net) & (!c. l < c --> ~(eventually (%x. c <= f x) net))
  [hint_rewrite]
proof
  ← cases "trivial_limit net" goal=0
    #[1] trivial_limit net ⟶ has_liminf f l net ⟷ trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
    #[2] ¬(trivial_limit net) ⟶ has_liminf f l net ⟷ trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
  ← rewrite has_liminf_def sym=false goal=1
    #[3] trivial_limit net ⟶ trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l ⟷ trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
  ← intro goal=3
    #[4] trivial_limit net
    #[5] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l ⟷ trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
  ← rule iffI goal=5
    #[6] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l ⟶ trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
    #[7] trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net)) ⟶ trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← intro goal=6
    #[8] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
    #[9] trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
  ← rule disjI1 goal=9
  ← intro goal=7
    #[10] trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
    #[11] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rule disjI1 goal=11
  ← intro goal=2
    #[12] ¬(trivial_limit net)
    #[13] has_liminf f l net ⟷ trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
  ← rule iffI goal=13
    #[14] has_liminf f l net ⟶ trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
    #[15] trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net)) ⟶ has_liminf f l net
  ← intro goal=14
    #[16] has_liminf f l net
    #[17] trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
  ← rule disjI2 goal=17
    #[18] (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
  ← rule conjI goal=18
    #[19] ∀c. c < l ⟶ eventually (λx. c ≤ f x) net
    #[20] ∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net)
  ← intro c goal=19
    #[21] _VAR c
    #[22] c < l
    #[23] eventually (λx. c ≤ f x) net
  ← rule eventually_mono param_P="(λx. c < f x)" goal=23
    #[24] ∀x. c < f x ⟶ c ≤ f x
    #[25] eventually (λx. c < f x) net
  ← z3 goal=24
    #[26] ∀x. c < f x ⟶ c ≤ f x
  ← rule has_liminf_eventually_lbound goal=25 facts=[12,16,22]
  ← intro c goal=20
    #[27] l < c
    #[28] ¬(eventually (λx. c ≤ f x) net)
  ← rule has_liminf_not_lbound goal=28 facts=[12,16,27]
  ← intro goal=15
    #[29] has_liminf f l net
  ← rule disjE goal=29 facts=[10]
    #[30] trivial_limit net ⟶ has_liminf f l net
    #[31] (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net)) ⟶ has_liminf f l net
  ← intro goal=30
    #[32] has_liminf f l net
  ← rule negE_gen goal=32 facts=[12,4]
    #[33] has_liminf f l net
  ← intro goal=31
    #[34] (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
    #[35] has_liminf f l net
  ← rewrite has_liminf_def sym=false goal=35
    #[36] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rule disjI2 goal=36
    #[37] has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rewrite has_sup sym=false goal=37
    #[38] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟶ x ≤ l) ∧ (∀c. c < l ⟶ (∃x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ∧ c < x))
  ← rule conjI goal=38
    #[39] ¬({b. eventually (λx. b ≤ f x) net} = ∅)
    #[40] (∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟶ x ≤ l) ∧ (∀c. c < l ⟶ (∃x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ∧ c < x))
  → forward conjD1 goal=39 facts=[34]
    #[41] ∀c. c < l ⟶ eventually (λx. c ≤ f x) net
  → forward conjD2 goal=39 facts=[34]
    #[42] ∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net)
  ← rewrite set_equal_iff sym=false goal=39
    #[43] ¬(∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ x ∈ ∅)
  ← rewrite member_empty_simp sym=false goal=43
    #[44] ¬(∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ false)
  ← rewrite not_all sym=false goal=44
    #[45] ∃x. ¬(x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟷ false)
  ← rewrite member_collect sym=false goal=45
    #[46] ∃x. ¬(eventually (λx1. x ≤ f x1) net ⟷ false)
  ← inst l-1 goal=46
    #[47] ¬(eventually (λx. l - 1 ≤ f x) net ⟷ false)
  ← rule negI goal=47
    #[48] eventually (λx. l - 1 ≤ f x) net ⟷ false ⟶ false
  ← intro goal=48
    #[49] eventually (λx. l - 1 ≤ f x) net ⟷ false
    #[50] false
  → rewrite target=fact eq_sym_eq sym=false goal=50 facts=[49]
    #[51] false ⟷ eventually (λx. l - 1 ≤ f x) net
  ← rewrite source=prev goal=50 facts=[51]
    #[52] eventually (λx. l - 1 ≤ f x) net
  ← apply_prev goal=52 facts=[41]
    #[53] l - 1 < l
  ← z3 goal=53
    #[54] l - 1 < l
  ← rule conjI goal=40
    #[55] ∀x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ⟶ x ≤ l
    #[56] ∀c. c < l ⟶ (∃x. x ∈ {b. eventually (λx1. b ≤ f x1) net} ∧ c < x)
