theory realseries
imports realderivative
description "Some analytic concepts for real."

def has_limsup :: ('a ⇒ real) ⇒ real ⇒ 'a net ⇒ bool = has_limsup f l net ⟷ trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l [hint_rewrite]

def has_liminf :: ('a ⇒ real) ⇒ real ⇒ 'a net ⇒ bool = has_liminf f l net ⟷ trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l [hint_rewrite]

theorem has_limsup_transform
  fixes f :: 'a => real, g :: 'a => real, l :: real, net :: 'a net
  prop eventually (%x. f x = g x) net --> has_limsup f l net --> has_limsup g l net
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] eventually (λx. f x = g x) net
    #[2] has_limsup f l net
    #[3] has_limsup g l net
  → rewrite target=fact has_limsup_def sym=false goal=3 facts=[2]
    #[4] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rewrite has_limsup_def sym=false goal=3
    #[5] trivial_limit net ∨ has_inf ({b. eventually (λx. g x ≤ b) net}) l
  ← rule disjE goal=5 facts=[4]
    #[6] trivial_limit net ⟶ trivial_limit net ∨ has_inf ({b. eventually (λx. g x ≤ b) net}) l
    #[7] has_inf ({b. eventually (λx. f x ≤ b) net}) l ⟶ trivial_limit net ∨ has_inf ({b. eventually (λx. g x ≤ b) net}) l
  ← intro goal=6
    #[8] trivial_limit net
    #[9] trivial_limit net ∨ has_inf ({b. eventually (λx. g x ≤ b) net}) l
  ← rule disjI1 goal=9
  ← intro goal=7
    #[10] has_inf ({b. eventually (λx. f x ≤ b) net}) l
    #[11] trivial_limit net ∨ has_inf ({b. eventually (λx. g x ≤ b) net}) l
  ← rule disjI2 goal=11
    #[12] has_inf ({b. eventually (λx. g x ≤ b) net}) l
  cut "!b. eventually (λx. f x ≤ b) net <--> eventually (λx. g x ≤ b) net" goal=12
    #[13] ∀b. eventually (λx. f x ≤ b) net ⟷ eventually (λx. g x ≤ b) net
  ← intro b goal=13
    #[14] _VAR b
    #[15] eventually (λx. f x ≤ b) net ⟷ eventually (λx. g x ≤ b) net
  ← rule eventually_iff goal=15
    #[16] eventually (λx. f x ≤ b ⟷ g x ≤ b) net
  ← rule eventually_mp param_P="(λx. f x = g x)" goal=16
    #[17] eventually (λx. f x = g x ⟶ f x ≤ b ⟷ g x ≤ b) net
  ← rule always_eventually goal=17
    #[18] ∀x. f x = g x ⟶ f x ≤ b ⟷ g x ≤ b
  ← z3 goal=18
    #[19] ∀x. f x = g x ⟶ f x ≤ b ⟷ g x ≤ b
  → rewrite target=fact source=prev goal=12 facts=[13,10]
qed

theorem has_limsup_eventually_ubound
  fixes b :: real, f :: 'a => real, l :: real, net :: 'a net
  prop ~(trivial_limit net) --> has_limsup f l net --> l < b --> eventually (%x. f x < b) net
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(trivial_limit net)
    #[2] has_limsup f l net
    #[3] l < b
    #[4] eventually (λx. f x < b) net
  → rewrite target=fact has_limsup_def sym=false goal=4 facts=[2]
    #[5] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjE goal=4 facts=[5]
    #[6] trivial_limit net ⟶ eventually (λx. f x < b) net
    #[7] has_inf ({b1. eventually (λx. f x ≤ b1) net}) l ⟶ eventually (λx. f x < b) net
  ← intro goal=6
    #[8] trivial_limit net
    #[9] eventually (λx. f x < b) net
  ← rule negE_gen goal=9 facts=[1,8]
    #[10] eventually (λx. f x < b) net
  ← intro goal=7
    #[11] has_inf ({b. eventually (λx. f x ≤ b) net}) l
    #[12] eventually (λx. f x < b) net
  → forward has_inf_approach goal=12 facts=[11,3]
    #[13] ∃x. x ∈ {b1. eventually (λx1. f x1 ≤ b1) net} ∧ x < b
  → rewrite target=fact member_collect sym=false goal=12 facts=[13]
    #[14] ∃x. eventually (λx1. f x1 ≤ x) net ∧ x < b
  elim c goal=12 facts=[14]
    #[15] _VAR c
    #[16] eventually (λx. f x ≤ c) net ∧ c < b
    #[17] eventually (λx. f x < b) net
  → forward conjD1 goal=17 facts=[16]
    #[18] eventually (λx. f x ≤ c) net
  ← rule eventually_mp param_P="(λx. f x ≤ c)" goal=17
    #[19] eventually (λx. f x ≤ c ⟶ f x < b) net
  ← rule always_eventually goal=19
    #[20] ∀x. f x ≤ c ⟶ f x < b
  → forward conjD2 goal=20 facts=[16]
    #[21] c < b
  ← z3 goal=20 facts=[21]
    #[22] ∀x. f x ≤ c ⟶ f x < b
qed

theorem reallim_imp_has_limsup
  fixes f :: 'a => real, l :: real, net :: 'a net
  prop tendsto_real f l net --> has_limsup f l net
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] tendsto_real f l net
    #[2] has_limsup f l net
  ← cases "trivial_limit net" goal=2
    #[3] trivial_limit net ⟶ has_limsup f l net
    #[4] ¬(trivial_limit net) ⟶ has_limsup f l net
  ← rewrite has_limsup_def sym=false goal=3
    #[5] trivial_limit net ⟶ trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← intro goal=5
    #[6] trivial_limit net
    #[7] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjI1 goal=7
  ← rewrite has_limsup_def sym=false goal=4
    #[8] ¬(trivial_limit net) ⟶ trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← intro goal=8
    #[9] ¬(trivial_limit net)
    #[10] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjI2 goal=10
    #[11] has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rewrite has_inf sym=false goal=11
    #[12] ¬({b. eventually (λx. f x ≤ b) net} = ∅) ∧ (∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ l ≤ x) ∧ (∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c))
  ← rule conjI goal=12
    #[13] ¬({b. eventually (λx. f x ≤ b) net} = ∅)
    #[14] (∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ l ≤ x) ∧ (∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c))
  ← rewrite set_equal_iff sym=false goal=13
    #[15] ¬(∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟷ x ∈ ∅)
  ← rewrite member_empty_simp sym=false goal=15
    #[16] ¬(∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟷ false)
  ← rewrite not_all sym=false goal=16
    #[17] ∃x. ¬(x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟷ false)
  ← rewrite member_collect sym=false goal=17
    #[18] ∃x. ¬(eventually (λx1. f x1 ≤ x) net ⟷ false)
  ← inst "l +1" goal=18
    #[19] ¬(eventually (λx. f x ≤ l + 1) net ⟷ false)
  ← rule negI goal=19
    #[20] eventually (λx. f x ≤ l + 1) net ⟷ false ⟶ false
  ← intro goal=20
    #[21] eventually (λx. f x ≤ l + 1) net ⟷ false
    #[22] false
  → rewrite target=fact eq_sym_eq sym=false goal=22 facts=[21]
    #[23] false ⟷ eventually (λx. f x ≤ l + 1) net
  ← rewrite source=prev goal=22 facts=[23]
    #[24] eventually (λx. f x ≤ l + 1) net
  → rewrite target=fact tendsto_real_def sym=false goal=24 facts=[1]
    #[25] ∀e. 0 < e ⟶ eventually (λx. abs (f x - l) < e) net
  → inst target=fact "(1::real)" goal=24 facts=[25]
    #[26] (0::real) < 1 ⟶ eventually (λx. abs (f x - l) < 1) net
  cut "(0::real) < 1" goal=24
    #[27] (0::real) < 1
  ← z3 goal=27
    #[28] (0::real) < 1
  → forward goal=24 facts=[26,28]
    #[29] eventually (λx. abs (f x - l) < 1) net
  ← rule eventually_mono param_P="(λx. abs (f x - l) < 1)" goal=24
    #[30] ∀x. abs (f x - l) < 1 ⟶ f x ≤ l + 1
  ← z3 goal=30
    #[31] ∀x. abs (f x - l) < 1 ⟶ f x ≤ l + 1
  ← rule conjI goal=14
    #[32] ∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ l ≤ x
    #[33] ∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c)
  ← rewrite member_collect sym=false goal=32
    #[34] ∀x. eventually (λx1. f x1 ≤ x) net ⟶ l ≤ x
  ← intro x goal=34
    #[35] _VAR x
    #[36] eventually (λx1. f x1 ≤ x) net
    #[37] l ≤ x
  ← rule reallim_ubound goal=37 facts=[1,9,36]
  ← intro c goal=33
    #[38] _VAR c
    #[39] l < c
    #[40] ∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c
  ← rewrite member_collect sym=false goal=40
    #[41] ∃x. eventually (λx1. f x1 ≤ x) net ∧ x < c
  ← inst "(l + c) / 2" goal=41
    #[42] eventually (λx. f x ≤ (l + c) / 2) net ∧ (l + c) / 2 < c
  ← rule conjI goal=42
    #[43] eventually (λx. f x ≤ (l + c) / 2) net
    #[44] (l + c) / 2 < c
  → rewrite target=fact tendsto_real_def sym=false goal=43 facts=[1]
  → inst target=fact "(c - l) / 2" goal=43 facts=[25]
    #[45] 0 < (c - l) / 2 ⟶ eventually (λx. abs (f x - l) < (c - l) / 2) net
  cut "0 < (c - l) / 2" goal=43
    #[46] 0 < (c - l) / 2
  ← z3 goal=46 facts=[39]
    #[47] 0 < (c - l) / 2
  → forward goal=43 facts=[45,47]
    #[48] eventually (λx. abs (f x - l) < (c - l) / 2) net
  ← rule eventually_mono param_P="(λx. abs (f x - l) < (c - l) / 2)" goal=43
    #[49] ∀x. abs (f x - l) < (c - l) / 2 ⟶ f x ≤ (l + c) / 2
  ← z3 goal=49 facts=[39]
    #[50] ∀x. abs (f x - l) < (c - l) / 2 ⟶ f x ≤ (l + c) / 2
  ← z3 goal=44 facts=[39]
    #[51] (l + c) / 2 < c
qed

theorem has_limsup_imp_ubound_le
  fixes f :: 'a => real, l :: real, net :: 'a net
  prop has_limsup f l net --> (?b. eventually (%x. f x <= b) net)
  [hint_backward]
proof
  ← intro goal=0
    #[1] has_limsup f l net
    #[2] ∃b. eventually (λx. f x ≤ b) net
  → rewrite target=fact has_limsup_def sym=false goal=2 facts=[1]
    #[3] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjE goal=2 facts=[3]
    #[4] trivial_limit net ⟶ (∃b. eventually (λx. f x ≤ b) net)
    #[5] has_inf ({b. eventually (λx. f x ≤ b) net}) l ⟶ (∃b. eventually (λx. f x ≤ b) net)
  ← intro goal=4
    #[6] trivial_limit net
    #[7] ∃b. eventually (λx. f x ≤ b) net
  ← inst l goal=7
    #[8] eventually (λx. f x ≤ l) net
  ← rule eventually_trivial goal=8
  ← intro goal=5
    #[9] has_inf ({b. eventually (λx. f x ≤ b) net}) l
    #[10] ∃b. eventually (λx. f x ≤ b) net
  → rewrite target=fact has_inf sym=false goal=10 facts=[9]
    #[11] ¬({b. eventually (λx. f x ≤ b) net} = ∅) ∧ (∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ l ≤ x) ∧ (∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c))
  → forward conjD2 goal=10 facts=[11]
    #[12] (∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ l ≤ x) ∧ (∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c))
  → forward conjD2 goal=10 facts=[12]
    #[13] ∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c)
  → inst target=fact l+1 goal=10 facts=[13]
    #[14] l < l + 1 ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < l + 1)
  cut "l < l + 1" goal=10 facts=[14]
    #[15] l < l + 1
  ← z3 goal=15
    #[16] l < l + 1
  → forward goal=10 facts=[14,16]
    #[17] ∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < l + 1
  → rewrite target=fact member_collect sym=false goal=10 facts=[17]
    #[18] ∃x. eventually (λx1. f x1 ≤ x) net ∧ x < l + 1
  elim x goal=10 facts=[18]
    #[19] _VAR x
    #[20] eventually (λx1. f x1 ≤ x) net ∧ x < l + 1
    #[21] ∃b. eventually (λx. f x ≤ b) net
  → forward conjD1 goal=21 facts=[20]
    #[22] eventually (λx1. f x1 ≤ x) net
  ← rule exI goal=21 facts=[22]
    #[23] ∃b. eventually (λx. f x ≤ b) net
qed

theorem has_limsup_not_ubound
  fixes c :: real, f :: 'a => real, l :: real, net :: 'a net
  prop ~(trivial_limit net) --> has_limsup f l net --> c < l --> ~(eventually (%x. f x <= c) net)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(trivial_limit net)
    #[2] has_limsup f l net
    #[3] c < l
    #[4] ¬(eventually (λx. f x ≤ c) net)
  → rewrite target=fact has_limsup_def sym=false goal=4 facts=[2]
    #[5] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjE goal=4 facts=[5]
    #[6] trivial_limit net ⟶ ¬(eventually (λx. f x ≤ c) net)
    #[7] has_inf ({b. eventually (λx. f x ≤ b) net}) l ⟶ ¬(eventually (λx. f x ≤ c) net)
  ← intro goal=6
    #[8] trivial_limit net
    #[9] ¬(eventually (λx. f x ≤ c) net)
  ← rule negE_gen goal=9 facts=[1,8]
    #[10] ¬(eventually (λx. f x ≤ c) net)
  ← intro goal=7
    #[11] has_inf ({b. eventually (λx. f x ≤ b) net}) l
    #[12] ¬(eventually (λx. f x ≤ c) net)
  ← rule contrapositive goal=12 facts=[3]
    #[13] ¬¬(eventually (λx. f x ≤ c) net) ⟶ ¬(c < l)
  ← intro goal=13
    #[14] ¬¬(eventually (λx. f x ≤ c) net)
    #[15] ¬(c < l)
  → rewrite target=fact double_neg sym=false goal=15 facts=[14]
    #[16] eventually (λx. f x ≤ c) net
  ← rewrite real_not_lt sym=false goal=15
    #[17] l ≤ c
  ← rule has_inf_lbound goal=17 facts=[11]
    #[18] c ∈ {b. eventually (λx. f x ≤ b) net}
  ← rewrite member_collect sym=false goal=18
qed

theorem has_limsup
  fixes f :: 'a => real, l :: real, net :: 'a net
  prop has_limsup f l net <--> trivial_limit net | (!c. l < c --> eventually (%x. f x <= c) net) & (!c. c < l --> ~(eventually (%x. f x <= c) net))
  [hint_rewrite]
proof
  ← cases "trivial_limit net" goal=0
    #[1] trivial_limit net ⟶ has_limsup f l net ⟷ trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
    #[2] ¬(trivial_limit net) ⟶ has_limsup f l net ⟷ trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  ← intro goal=1
    #[3] trivial_limit net
    #[4] has_limsup f l net ⟷ trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  ← rewrite has_limsup_def sym=false goal=4
    #[5] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l ⟷ trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  ← rule iffI goal=5
    #[6] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l ⟶ trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
    #[7] trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net)) ⟶ trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← intro goal=6
    #[8] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
    #[9] trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  ← rule disjI1 goal=9
  ← intro goal=7
    #[10] trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
    #[11] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjI1 goal=11
  ← intro goal=2
    #[12] ¬(trivial_limit net)
    #[13] has_limsup f l net ⟷ trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  ← rule iffI goal=13
    #[14] has_limsup f l net ⟶ trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
    #[15] trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net)) ⟶ has_limsup f l net
  ← intro goal=14
    #[16] has_limsup f l net
    #[17] trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  ← rule disjI2 goal=17
    #[18] (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  ← rule conjI goal=18
    #[19] ∀c. l < c ⟶ eventually (λx. f x ≤ c) net
    #[20] ∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net)
  ← intro c goal=19
    #[21] _VAR c
    #[22] l < c
    #[23] eventually (λx. f x ≤ c) net
  ← rule eventually_mono param_P="(λx. f x < c)" goal=23
    #[24] ∀x. f x < c ⟶ f x ≤ c
    #[25] eventually (λx. f x < c) net
  ← z3 goal=24
    #[26] ∀x. f x < c ⟶ f x ≤ c
  ← rule has_limsup_eventually_ubound param_l=l goal=25
  ← intro c goal=20
    #[27] c < l
    #[28] ¬(eventually (λx. f x ≤ c) net)
  ← rule has_limsup_not_ubound param_l=l goal=28
  ← intro goal=15
    #[29] has_limsup f l net
  ← rewrite has_limsup_def sym=false goal=29
    #[30] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjI2 goal=30
    #[31] has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjE goal=31 facts=[10]
    #[32] trivial_limit net ⟶ has_inf ({b. eventually (λx. f x ≤ b) net}) l
    #[33] (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net)) ⟶ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← intro goal=32
    #[34] has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule negE_gen goal=34 facts=[12,3]
    #[35] has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← intro goal=33
    #[36] (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
    #[37] has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rewrite has_inf sym=false goal=37
    #[38] ¬({b. eventually (λx. f x ≤ b) net} = ∅) ∧ (∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ l ≤ x) ∧ (∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c))
  ← rule conjI goal=38
    #[39] ¬({b. eventually (λx. f x ≤ b) net} = ∅)
    #[40] (∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ l ≤ x) ∧ (∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c))
  ← rewrite set_equal_iff sym=false goal=39
    #[41] ¬(∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟷ x ∈ ∅)
  ← rewrite member_collect sym=false goal=41
    #[42] ¬(∀x. eventually (λx1. f x1 ≤ x) net ⟷ x ∈ ∅)
  ← rewrite member_empty_simp sym=false goal=42
    #[43] ¬(∀x. eventually (λx1. f x1 ≤ x) net ⟷ false)
  ← rewrite not_all sym=false goal=43
    #[44] ∃x. ¬(eventually (λx1. f x1 ≤ x) net ⟷ false)
  ← inst "l + 1" goal=44
    #[45] ¬(eventually (λx. f x ≤ l + 1) net ⟷ false)
  → forward conjD1 goal=45 facts=[36]
    #[46] ∀c. l < c ⟶ eventually (λx. f x ≤ c) net
  → forward conjD2 goal=46 facts=[36]
    #[47] ∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net)
  ← rule negI goal=45
    #[48] eventually (λx. f x ≤ l + 1) net ⟷ false ⟶ false
  ← intro goal=48
    #[49] eventually (λx. f x ≤ l + 1) net ⟷ false
    #[50] false
  → rewrite target=fact eq_sym_eq sym=false goal=50 facts=[49]
    #[51] false ⟷ eventually (λx. f x ≤ l + 1) net
  ← rewrite source=prev goal=50 facts=[51]
    #[52] eventually (λx. f x ≤ l + 1) net
  ← apply_prev goal=52 facts=[46]
    #[53] l < l + 1
  ← z3 goal=53
    #[54] l < l + 1
  ← rule conjI goal=40
    #[55] ∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ l ≤ x
    #[56] ∀c. l < c ⟶ (∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c)
  ← rewrite member_collect sym=false goal=55
    #[57] ∀x. eventually (λx1. f x1 ≤ x) net ⟶ l ≤ x
  ← rule contrapositive goal=57 facts=[47]
    #[58] ¬(∀x. eventually (λx1. f x1 ≤ x) net ⟶ l ≤ x) ⟶ ¬(∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  ← rewrite not_all sym=false goal=58
    #[59] (∃x. ¬(eventually (λx1. f x1 ≤ x) net ⟶ l ≤ x)) ⟶ (∃c. ¬(c < l ⟶ ¬(eventually (λx. f x ≤ c) net)))
  ← rewrite not_imp sym=false goal=59
    #[60] (∃x. eventually (λx1. f x1 ≤ x) net ∧ ¬(l ≤ x)) ⟶ (∃c. c < l ∧ ¬¬(eventually (λx. f x ≤ c) net))
  ← rewrite double_neg sym=false goal=60
    #[61] (∃x. eventually (λx1. f x1 ≤ x) net ∧ ¬(l ≤ x)) ⟶ (∃c. c < l ∧ eventually (λx. f x ≤ c) net)
  ← rewrite real_less_def sym=false goal=61
    #[62] (∃x. eventually (λx1. f x1 ≤ x) net ∧ ¬(l ≤ x)) ⟶ (∃c. ¬(l ≤ c) ∧ eventually (λx. f x ≤ c) net)
  ← intro goal=62
    #[63] ∃x. eventually (λx1. f x1 ≤ x) net ∧ ¬(l ≤ x)
    #[64] ∃c. ¬(l ≤ c) ∧ eventually (λx. f x ≤ c) net
  ← rewrite conj_comm sym=false goal=64
  ← intro c goal=56
    #[65] ∃x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ∧ x < c
  ← inst "(l+c)/2" goal=65
    #[66] (l + c) / 2 ∈ {b. eventually (λx. f x ≤ b) net} ∧ (l + c) / 2 < c
  ← rule conjI goal=66
    #[67] (l + c) / 2 ∈ {b. eventually (λx. f x ≤ b) net}
    #[68] (l + c) / 2 < c
  ← rewrite member_collect sym=false goal=67
    #[69] eventually (λx. f x ≤ (l + c) / 2) net
  ← apply_prev goal=69 facts=[46]
    #[70] l < (l + c) / 2
  ← z3 goal=70 facts=[22]
    #[71] l < (l + c) / 2
  ← z3 goal=68 facts=[22]
    #[72] (l + c) / 2 < c
qed

theorem limsup_exists
  fixes f :: 'a => real, net :: 'a net
  prop (?l. has_limsup f l net) <--> trivial_limit net | (?b. eventually (%x. f x <= b) net) & (?c. ~(eventually (%x. f x <= c) net))
proof
  ← rule iffI goal=0
    #[1] (∃l. has_limsup f l net) ⟶ trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
    #[2] trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net)) ⟶ (∃l. has_limsup f l net)
  ← rewrite has_limsup sym=false goal=1
    #[3] (∃l. trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))) ⟶ trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
  ← intro goal=3
    #[4] ∃l. trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
    #[5] trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
  elim l goal=5 facts=[4]
    #[6] _VAR l
    #[7] trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
    #[8] trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
  ← rule disjE goal=8 facts=[7]
    #[9] trivial_limit net ⟶ trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
    #[10] (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net)) ⟶ trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
  ← intro goal=9
    #[11] trivial_limit net
    #[12] trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
  ← rule disjI1 goal=12
  ← intro goal=10
    #[13] (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
    #[14] trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
  ← rule disjI2 goal=14
    #[15] (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
  → forward conjD1 goal=15 facts=[13]
    #[16] ∀c. l < c ⟶ eventually (λx. f x ≤ c) net
  → forward conjD2 goal=15 facts=[13]
    #[17] ∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net)
  ← rule conjI goal=15
    #[18] ∃b. eventually (λx. f x ≤ b) net
    #[19] ∃c. ¬(eventually (λx. f x ≤ c) net)
  ← inst l+1 goal=18
    #[20] eventually (λx. f x ≤ l + 1) net
  ← apply_prev goal=20 facts=[16]
    #[21] l < l + 1
  ← z3 goal=21
    #[22] l < l + 1
  ← inst l-1 goal=19
    #[23] ¬(eventually (λx. f x ≤ l - 1) net)
  ← apply_prev goal=23 facts=[17]
    #[24] l - 1 < l
  ← z3 goal=24
    #[25] l - 1 < l
  ← rewrite has_limsup_def sym=false goal=2
    #[26] trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net)) ⟶ (∃l. trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l)
  ← intro goal=26
    #[27] trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
    #[28] ∃l. trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rule disjE goal=28 facts=[27]
    #[29] trivial_limit net ⟶ (∃l. trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l)
    #[30] (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net)) ⟶ (∃l. trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l)
  ← intro goal=29
    #[31] ∃l. trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← inst "(0::real)" goal=31
    #[32] trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) 0
  ← rule disjI1 goal=32
  ← intro goal=30
    #[33] (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
    #[34] ∃l. trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rewrite right_or_exists_thm sym=true goal=34
    #[35] trivial_limit net ∨ (∃l. has_inf ({b. eventually (λx. f x ≤ b) net}) l)
  ← rule disjI2 goal=35
    #[36] ∃l. has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← rewrite inf_exists sym=false goal=36
    #[37] ¬({b. eventually (λx. f x ≤ b) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. f x1 ≤ b1) net} ⟶ b ≤ x)
  ← rule conjI goal=37
    #[38] ¬({b. eventually (λx. f x ≤ b) net} = ∅)
    #[39] ∃b. ∀x. x ∈ {b1. eventually (λx1. f x1 ≤ b1) net} ⟶ b ≤ x
  → forward conjD1 goal=38 facts=[33]
    #[40] ∃b. eventually (λx. f x ≤ b) net
  → forward conjD2 goal=38 facts=[33]
    #[41] ∃c. ¬(eventually (λx. f x ≤ c) net)
  ← rewrite set_equal_iff sym=false goal=38
    #[42] ¬(∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟷ x ∈ ∅)
  ← rewrite member_empty_simp sym=false goal=42
    #[43] ¬(∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟷ false)
  ← rewrite member_collect sym=false goal=43
    #[44] ¬(∀x. eventually (λx1. f x1 ≤ x) net ⟷ false)
  ← rule negI goal=44
    #[45] (∀x. eventually (λx1. f x1 ≤ x) net ⟷ false) ⟶ false
  ← intro goal=45
    #[46] ∀x. eventually (λx1. f x1 ≤ x) net ⟷ false
    #[47] false
  → rewrite target=fact eq_sym_eq sym=false goal=47 facts=[46]
    #[48] ∀x. false ⟷ eventually (λx1. f x1 ≤ x) net
  elim b goal=47 facts=[40]
    #[49] _VAR b
    #[50] eventually (λx. f x ≤ b) net
    #[51] false
  → inst target=fact b goal=51 facts=[48]
    #[52] false ⟷ eventually (λx. f x ≤ b) net
  ← rewrite source=prev goal=51 facts=[52]
  elim c goal=39 facts=[41]
    #[53] _VAR c
    #[54] ¬(eventually (λx. f x ≤ c) net)
    #[55] ∃b. ∀x. x ∈ {b1. eventually (λx1. f x1 ≤ b1) net} ⟶ b ≤ x
    #[56] ¬({b. eventually (λx. f x ≤ b) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. f x1 ≤ b1) net} ⟶ b ≤ x)
    #[57] ∃l. has_inf ({b. eventually (λx. f x ≤ b) net}) l
    #[58] trivial_limit net ∨ (∃l. has_inf ({b. eventually (λx. f x ≤ b) net}) l)
    #[59] ∃l. trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l
  ← inst c goal=55
    #[60] ∀x. x ∈ {b. eventually (λx1. f x1 ≤ b) net} ⟶ c ≤ x
  ← rewrite member_collect sym=false goal=60
    #[61] ∀x. eventually (λx1. f x1 ≤ x) net ⟶ c ≤ x
  ← intro x goal=61
    #[62] _VAR x
    #[63] eventually (λx1. f x1 ≤ x) net
    #[64] c ≤ x
  ← rule contrapositive goal=64 facts=[54]
    #[65] ¬(c ≤ x) ⟶ ¬¬(eventually (λx1. f x1 ≤ c) net)
  ← rewrite double_neg sym=false goal=65
    #[66] ¬(c ≤ x) ⟶ eventually (λx1. f x1 ≤ c) net
  ← intro goal=66
    #[67] ¬(c ≤ x)
    #[68] eventually (λx. f x ≤ c) net
  ← rule eventually_mp param_P="(λx1. f x1 ≤ x)" goal=68
    #[69] eventually (λx1. f x1 ≤ x ⟶ f x1 ≤ c) net
  ← rule always_eventually goal=69
    #[70] ∀x1. f x1 ≤ x ⟶ f x1 ≤ c
  ← z3 goal=70 facts=[67]
    #[71] ∀x1. f x1 ≤ x ⟶ f x1 ≤ c
qed

theorem has_limsup_le
  fixes f :: 'a => real, g :: 'a => real, l :: real, m :: real, net :: 'a net
  prop has_limsup f l net --> has_limsup g m net --> ~(trivial_limit net) --> eventually (%x. f x <= g x) net --> l <= m
  [hint_backward1]
proof
  ← intro goal=0
    #[1] has_limsup f l net
    #[2] has_limsup g m net
    #[3] ¬(trivial_limit net)
    #[4] eventually (λx. f x ≤ g x) net
    #[5] l ≤ m
  ← rewrite real_not_lt sym=true goal=5
    #[6] ¬(m < l)
  ← rewrite real_lt_between sym=false goal=6
    #[7] ¬(∃x. m < x ∧ x < l)
  ← rule negI goal=7
    #[8] (∃x. m < x ∧ x < l) ⟶ false
  ← intro goal=8
    #[9] ∃x. m < x ∧ x < l
    #[10] false
  elim c goal=10 facts=[9]
    #[11] _VAR c
    #[12] m < c ∧ c < l
    #[13] false
  ← rule negE param_A="eventually (λx. g x < c) net" goal=13
    #[14] ¬(eventually (λx. g x < c) net)
    #[15] eventually (λx. g x < c) net
  ← rule negI goal=14
    #[16] eventually (λx. g x < c) net ⟶ false
  ← intro goal=16
    #[17] eventually (λx. g x < c) net
    #[18] false
  ← rule negE param_A="eventually (λx. f x ≤ c) net" goal=18
    #[19] ¬(eventually (λx. f x ≤ c) net)
    #[20] eventually (λx. f x ≤ c) net
  ← rule has_limsup_not_ubound param_l=l goal=19
    #[21] c < l
  ← rule conjD2 goal=21 facts=[12]
    #[22] c < l
  ← rule eventually_mp param_P="(λx. f x ≤ g x &  g x < c)" goal=20
    #[23] eventually (λx. f x ≤ g x ∧ g x < c ⟶ f x ≤ c) net
    #[24] eventually (λx. f x ≤ g x ∧ g x < c) net
  ← rule always_eventually goal=23
    #[25] ∀x. f x ≤ g x ∧ g x < c ⟶ f x ≤ c
  ← z3 goal=25
    #[26] ∀x. f x ≤ g x ∧ g x < c ⟶ f x ≤ c
  ← rewrite eventually_and sym=false goal=24
    #[27] eventually (λx. f x ≤ g x) net ∧ eventually (λx. g x < c) net
  ← rule conjI goal=27
  ← rule has_limsup_eventually_ubound param_l=m goal=15
    #[28] m < c
  ← rule conjD1 goal=28 facts=[12]
    #[29] m < c
qed

theorem has_limsup_ubound
  fixes b :: real, f :: 'a => real, l :: real, net :: 'a net
  prop eventually (%x. f x <= b) net --> has_limsup f l net --> ~(trivial_limit net) --> l <= b
  [hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] eventually (λx. f x ≤ b) net
    #[2] has_limsup f l net
    #[3] ¬(trivial_limit net)
    #[4] l ≤ b
  ← rule has_limsup_le param_g="(%x:: 'a. b)" goal=4 facts=[2]
    #[5] has_limsup (λx. b) b net
  ← rule reallim_imp_has_limsup goal=5
    #[6] tendsto_real (λx. b) b net
  ← rule reallim_const goal=6
    #[7] tendsto_real (λx. b) b net
qed

theorem has_limsup_sequentially
  fixes a :: nat => real, l :: real
  prop has_limsup a l sequentially <--> (!c. l < c --> (?N. !n. N <= n --> a n <= c)) & (!c. c < l --> (!N. ?n. N <= n & c < a n))
  [hint_rewrite]
proof
  ← rewrite has_limsup sym=false goal=0
    #[1] trivial_limit sequentially ∨ (∀c. l < c ⟶ eventually (λx. a x ≤ c) sequentially) ∧ (∀c. c < l ⟶ ¬(eventually (λx. a x ≤ c) sequentially)) ⟷ (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
  ← rule iffI goal=1
    #[2] trivial_limit sequentially ∨ (∀c. l < c ⟶ eventually (λx. a x ≤ c) sequentially) ∧ (∀c. c < l ⟶ ¬(eventually (λx. a x ≤ c) sequentially)) ⟶ (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
    #[3] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n)) ⟶ trivial_limit sequentially ∨ (∀c. l < c ⟶ eventually (λx. a x ≤ c) sequentially) ∧ (∀c. c < l ⟶ ¬(eventually (λx. a x ≤ c) sequentially))
  ← intro goal=2
    #[4] trivial_limit sequentially ∨ (∀c. l < c ⟶ eventually (λx. a x ≤ c) sequentially) ∧ (∀c. c < l ⟶ ¬(eventually (λx. a x ≤ c) sequentially))
    #[5] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
  ← rule disjE goal=5 facts=[4]
    #[6] trivial_limit sequentially ⟶ (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
    #[7] (∀c. l < c ⟶ eventually (λx. a x ≤ c) sequentially) ∧ (∀c. c < l ⟶ ¬(eventually (λx. a x ≤ c) sequentially)) ⟶ (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
  ← intro goal=6
    #[8] trivial_limit sequentially
    #[9] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
  ← rule contrapositive goal=9 facts=[8]
    #[10] ¬((∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))) ⟶ ¬(trivial_limit sequentially)
  ← intro goal=10
    #[11] ¬((∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n)))
    #[12] ¬(trivial_limit sequentially)
  ← rule trivial_limit_sequentially goal=12
    #[13] ¬(trivial_limit sequentially)
  ← intro goal=7
    #[14] (∀c. l < c ⟶ eventually (λx. a x ≤ c) sequentially) ∧ (∀c. c < l ⟶ ¬(eventually (λx. a x ≤ c) sequentially))
    #[15] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
  → rewrite target=fact eventually_sequentially sym=false goal=15 facts=[14]
    #[16] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ ¬(∃N. ∀n. N ≤ n ⟶ a n ≤ c))
  → rewrite target=fact not_exists sym=false goal=15 facts=[16]
    #[17] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ¬(∀n. N ≤ n ⟶ a n ≤ c)))
  → rewrite target=fact not_all sym=false goal=15 facts=[17]
    #[18] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. ¬(N ≤ n ⟶ a n ≤ c)))
  → rewrite target=fact not_imp sym=false goal=15 facts=[18]
    #[19] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ ¬(a n ≤ c)))
  → rewrite target=fact real_less_def sym=true goal=15 facts=[19]
    #[20] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
  ← intro goal=3
    #[21] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
    #[22] trivial_limit sequentially ∨ (∀c. l < c ⟶ eventually (λx. a x ≤ c) sequentially) ∧ (∀c. c < l ⟶ ¬(eventually (λx. a x ≤ c) sequentially))
  ← rule disjI2 goal=22
    #[23] (∀c. l < c ⟶ eventually (λx. a x ≤ c) sequentially) ∧ (∀c. c < l ⟶ ¬(eventually (λx. a x ≤ c) sequentially))
  ← rewrite eventually_sequentially sym=false goal=23
    #[24] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ ¬(∃N. ∀n. N ≤ n ⟶ a n ≤ c))
  ← rewrite not_exists sym=false goal=24
    #[25] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ¬(∀n. N ≤ n ⟶ a n ≤ c)))
  ← rewrite not_all sym=false goal=25
    #[26] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. ¬(N ≤ n ⟶ a n ≤ c)))
  ← rewrite not_imp sym=false goal=26
    #[27] (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ ¬(a n ≤ c)))
  ← rewrite real_less_def sym=true goal=27
qed

