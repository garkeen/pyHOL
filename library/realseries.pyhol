theory realseries
imports realderivative
description "Some analytic concepts for real."

def has_limsup :: ('a ⇒ real) ⇒ real ⇒ 'a net ⇒ bool = has_limsup f l net ⟷ trivial_limit net ∨ has_inf ({b. eventually (λx. f x ≤ b) net}) l [hint_rewrite]

def has_liminf :: ('a ⇒ real) ⇒ real ⇒ 'a net ⇒ bool = has_liminf f l net ⟷ trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l [hint_rewrite]

theorem has_limsup_transform
  fixes f :: 'a ⇒ real, g :: 'a ⇒ real, l :: real, net :: 'a net
  prop eventually (λx. f x = g x) net ⟶ has_limsup f l net ⟶ has_limsup g l net
  [hint_backward,hint_backward1]
  proof
    2: rewrite_fact has_limsup_def @1 sym=false
    3: rewrite_goal has_limsup_def sym=false
    3: apply_backward_step disjE @2
    3: introduction
    3.1: apply_backward_step disjI1
    4: introduction
    4.1: apply_backward_step disjI2
    4.1: cut "!b. eventually (λx. f x ≤ b) net <--> eventually (λx. g x ≤ b) net"
    4.1: introduction b
    4.1.1: apply_backward_step eventually_iff
    4.1.1: apply_backward_step eventually_mp param_P="(λx. f x = g x)"
    4.1.1: apply_backward_step always_eventually
    4.1.1: z3
    4.2: rewrite_fact_with_prev @4.1,4.0
  qed

theorem has_limsup_eventually_ubound
  fixes b :: real, f :: 'a ⇒ real, l :: real, net :: 'a net
  prop ¬(trivial_limit net) ⟶ has_limsup f l net ⟶ l < b ⟶ eventually (λx. f x < b) net
  [hint_backward,hint_backward1,hint_forward]
  proof
    3: rewrite_fact has_limsup_def @1 sym=false
    4: apply_backward_step disjE @3
    4: introduction
    4.1: apply_backward_step negE_gen @0,4.0
    5: introduction
    5.1: apply_forward_step has_inf_approach @5.0,2
    5.2: rewrite_fact member_collect @5.1 sym=false
    5.3: exists_elim c @5.2
    5.5: apply_forward_step conjD1 @5.4
    5.6: apply_backward_step eventually_mp param_P="(λx. f x ≤ c)"
    5.6: apply_backward_step always_eventually
    5.6: apply_forward_step conjD2 @5.4
    5.7: z3 @5.6
  qed

theorem reallim_imp_has_limsup
  fixes f :: 'a ⇒ real, l :: real, net :: 'a net
  prop tendsto_real f l net ⟶ has_limsup f l net
  [hint_backward,hint_forward]
  proof
    1: cases "trivial_limit net"
    1: rewrite_goal has_limsup_def sym=false
    1: introduction
    1.1: apply_backward_step disjI1
    3: rewrite_goal has_limsup_def sym=false
    3: introduction
    3.1: apply_backward_step disjI2
    3.1: rewrite_goal has_inf sym=false
    3.1: apply_backward_step conjI
    3.1: rewrite_goal set_equal_iff sym=false
    3.1: rewrite_goal member_empty_simp sym=false
    3.1: rewrite_goal not_all sym=false
    3.1: rewrite_goal member_collect sym=false
    3.1: inst_exists_goal "l +1"
    3.1: apply_backward_step negI
    3.1: introduction
    3.1.1: rewrite_fact eq_sym_eq @3.1.0 sym=false
    3.1.2: rewrite_goal_with_prev @3.1.1
    3.1.2: rewrite_fact tendsto_real_def @0 sym=false
    3.1.3: forall_elim "(1::real)" @3.1.2
    3.1.4: cut "(0::real) < 1"
    3.1.4: z3
    3.1.5: apply_fact @3.1.3,3.1.4
    3.1.6: apply_backward_step eventually_mono param_P="(λx. abs (f x - l) < 1)"
    3.1.6: z3
    3.8: apply_backward_step conjI
    3.8: rewrite_goal member_collect sym=false
    3.8: introduction x
    3.8.2: apply_backward_step reallim_ubound @0,3.0,3.8.1
    3.10: introduction c
    3.10.2: rewrite_goal member_collect sym=false
    3.10.2: inst_exists_goal "(l + c) / 2"
    3.10.2: apply_backward_step conjI
    3.10.2: rewrite_fact tendsto_real_def @0 sym=false
    3.10.3: forall_elim "(c - l) / 2" @3.10.2
    3.10.4: cut "0 < (c - l) / 2"
    3.10.4: z3 @3.10.1
    3.10.5: apply_fact @3.10.3,3.10.4
    3.10.6: apply_backward_step eventually_mono param_P="(λx. abs (f x - l) < (c - l) / 2)"
    3.10.6: z3 @3.10.1
    3.10.8: z3 @3.10.1
  qed

theorem has_limsup_imp_ubound_le
  fixes f :: 'a ⇒ real, l :: real, net :: 'a net
  prop has_limsup f l net ⟶ (∃b. eventually (λx. f x ≤ b) net)
  [hint_backward]
  proof
    1: rewrite_fact has_limsup_def @0 sym=false
    2: apply_backward_step disjE @1
    2: introduction
    2.1: inst_exists_goal l
    2.1: apply_backward_step eventually_trivial
    3: introduction
    3.1: rewrite_fact has_inf @3.0 sym=false
    3.2: apply_forward_step conjD2 @3.1
    3.3: apply_forward_step conjD2 @3.2
    3.4: forall_elim l+1 @3.3
    3.5: cut "l < l + 1" @3.4
    3.5: z3
    3.6: apply_fact @3.4,3.5
    3.7: rewrite_fact member_collect @3.6 sym=false
    3.8: exists_elim x @3.7
    3.10: apply_forward_step conjD1 @3.9
    3.11: apply_backward_step exI @3.10
  qed

theorem has_limsup_not_ubound
  fixes c :: real, f :: 'a ⇒ real, l :: real, net :: 'a net
  prop ¬(trivial_limit net) ⟶ has_limsup f l net ⟶ c < l ⟶ ¬(eventually (λx. f x ≤ c) net)
  [hint_backward,hint_backward1]
  proof
    3: rewrite_fact has_limsup_def @1 sym=false
    4: apply_backward_step disjE @3
    4: introduction
    4.1: apply_backward_step negE_gen @0,4.0
    5: introduction
    5.1: apply_backward_step contrapositive @2
    5.1: introduction
    5.1.1: rewrite_fact double_neg @5.1.0 sym=false
    5.1.2: rewrite_goal real_not_lt sym=false
    5.1.2: apply_backward_step has_inf_lbound @5.0
    5.1.2: rewrite_goal member_collect sym=false
  qed

theorem has_limsup
  fixes f :: 'a ⇒ real, l :: real, net :: 'a net
  prop has_limsup f l net ⟷ trivial_limit net ∨ (∀c. l < c ⟶ eventually (λx. f x ≤ c) net) ∧ (∀c. c < l ⟶ ¬(eventually (λx. f x ≤ c) net))
  [hint_rewrite]
  proof
    0: cases "trivial_limit net"
    0: introduction
    0.1: rewrite_goal has_limsup_def sym=false
    0.1: apply_backward_step iffI
    0.1: introduction
    0.1.1: apply_backward_step disjI1
    0.2: introduction
    0.2.1: apply_backward_step disjI1
    1: introduction
    1.1: apply_backward_step iffI
    1.1: introduction
    1.1.1: apply_backward_step disjI2
    1.1.1: apply_backward_step conjI
    1.1.1: introduction c
    1.1.1.2: apply_backward_step eventually_mono param_P="(λx. f x < c)"
    1.1.1.2: z3
    1.1.1.3: apply_backward_step has_limsup_eventually_ubound param_l=l
    1.1.2: introduction c
    1.1.2.2: apply_backward_step has_limsup_not_ubound param_l=l
    1.2: introduction
    1.2.1: rewrite_goal has_limsup_def sym=false
    1.2.1: apply_backward_step disjI2
    1.2.1: apply_backward_step disjE @1.2.0
    1.2.1: introduction
    1.2.1.1: apply_backward_step negE_gen @1.0,1.2.1.0
    1.2.2: introduction
    1.2.2.1: rewrite_goal has_inf sym=false
    1.2.2.1: apply_backward_step conjI
    1.2.2.1: rewrite_goal set_equal_iff sym=false
    1.2.2.1: rewrite_goal member_collect sym=false
    1.2.2.1: rewrite_goal member_empty_simp sym=false
    1.2.2.1: rewrite_goal not_all sym=false
    1.2.2.1: inst_exists_goal "l + 1"
    1.2.2.1: apply_forward_step conjD1 @1.2.2.0
    1.2.2.1: apply_forward_step conjD2 @1.2.2.0
    1.2.2.3: apply_backward_step negI
    1.2.2.3: introduction
    1.2.2.3.1: rewrite_fact eq_sym_eq @1.2.2.3.0 sym=false
    1.2.2.3.2: rewrite_goal_with_prev @1.2.2.3.1
    1.2.2.3.2: apply_prev @1.2.2.2
    1.2.2.3.2: z3
    1.2.2.10: apply_backward_step conjI
    1.2.2.10: rewrite_goal member_collect sym=false
    1.2.2.10: apply_backward_step contrapositive @1.2.2.1
    1.2.2.10: rewrite_goal not_all sym=false
    1.2.2.10: rewrite_goal not_imp sym=false
    1.2.2.10: rewrite_goal double_neg sym=false
    1.2.2.10: rewrite_goal real_less_def sym=false
    1.2.2.10: introduction
    1.2.2.10.1: rewrite_goal conj_comm sym=false
    1.2.2.17: introduction c
    1.2.2.17.2: inst_exists_goal "(l+c)/2"
    1.2.2.17.2: apply_backward_step conjI
    1.2.2.17.2: rewrite_goal member_collect sym=false
    1.2.2.17.2: apply_prev @1.2.2.2
    1.2.2.17.2: z3 @1.2.2.17.1
    1.2.2.17.5: z3 @1.2.2.17.1
  qed

theorem limsup_exists
  fixes f :: 'a ⇒ real, net :: 'a net
  prop (∃l. has_limsup f l net) ⟷ trivial_limit net ∨ (∃b. eventually (λx. f x ≤ b) net) ∧ (∃c. ¬(eventually (λx. f x ≤ c) net))
  proof
    0: apply_backward_step iffI
    0: rewrite_goal has_limsup sym=false
    0: introduction
    0.1: exists_elim l @0.0
    0.3: apply_backward_step disjE @0.2
    0.3: introduction
    0.3.1: apply_backward_step disjI1
    0.4: introduction
    0.4.1: apply_backward_step disjI2
    0.4.1: apply_forward_step conjD1 @0.4.0
    0.4.2: apply_forward_step conjD2 @0.4.0
    0.4.3: apply_backward_step conjI
    0.4.3: inst_exists_goal l+1
    0.4.3: apply_prev @0.4.1
    0.4.3: z3
    0.4.6: inst_exists_goal l-1
    0.4.6: apply_prev @0.4.2
    0.4.6: z3
    2: rewrite_goal has_limsup_def sym=false
    2: introduction
    2.1: apply_backward_step disjE @2.0
    2.1: introduction
    2.1.1: inst_exists_goal "(0::real)"
    2.1.1: apply_backward_step disjI1
    2.2: introduction
    2.2.1: rewrite_goal right_or_exists_thm sym=true
    2.2.1: apply_backward_step disjI2
    2.2.1: rewrite_goal inf_exists sym=false
    2.2.1: apply_backward_step conjI
    2.2.1: apply_forward_step conjD1 @2.2.0
    2.2.2: apply_forward_step conjD2 @2.2.0
    2.2.3: rewrite_goal set_equal_iff sym=false
    2.2.3: rewrite_goal member_empty_simp sym=false
    2.2.3: rewrite_goal member_collect sym=false
    2.2.3: apply_backward_step negI
    2.2.3: introduction
    2.2.3.1: rewrite_fact eq_sym_eq @2.2.3.0 sym=false
    2.2.3.2: exists_elim b @2.2.1
    2.2.3.4: forall_elim b @2.2.3.1
    2.2.3.5: rewrite_goal_with_prev @2.2.3.4
    2.2.8: exists_elim c @2.2.2
    2.2.10: inst_exists_goal c
    2.2.10: rewrite_goal member_collect sym=false
    2.2.10: introduction x
    2.2.10.2: apply_backward_step contrapositive @2.2.9
    2.2.10.2: rewrite_goal double_neg sym=false
    2.2.10.2: introduction
    2.2.10.2.1: apply_backward_step eventually_mp param_P="(λx1. f x1 ≤ x)"
    2.2.10.2.1: apply_backward_step always_eventually
    2.2.10.2.1: z3 @2.2.10.2.0
  qed

theorem has_limsup_le
  fixes f :: 'a ⇒ real, g :: 'a ⇒ real, l :: real, m :: real, net :: 'a net
  prop has_limsup f l net ⟶ has_limsup g m net ⟶ ¬(trivial_limit net) ⟶ eventually (λx. f x ≤ g x) net ⟶ l ≤ m
  [hint_backward1]
  proof
    4: rewrite_goal real_not_lt sym=true
    4: rewrite_goal real_lt_between sym=false
    4: apply_backward_step negI
    4: introduction
    4.1: exists_elim c @4.0
    4.3: apply_backward_step negE param_A="eventually (λx. g x < c) net"
    4.3: apply_backward_step negI
    4.3: introduction
    4.3.1: apply_backward_step negE param_A="eventually (λx. f x ≤ c) net"
    4.3.1: apply_backward_step has_limsup_not_ubound param_l=l
    4.3.1: apply_backward_step conjD2 @4.2
    4.3.3: apply_backward_step eventually_mp param_P="(λx. f x ≤ g x &  g x < c)"
    4.3.3: apply_backward_step always_eventually
    4.3.3: z3
    4.3.5: rewrite_goal eventually_and sym=false
    4.3.5: apply_backward_step conjI
    4.5: apply_backward_step has_limsup_eventually_ubound param_l=m
    4.5: apply_backward_step conjD1 @4.2
  qed

theorem has_limsup_ubound
  fixes b :: real, f :: 'a ⇒ real, l :: real, net :: 'a net
  prop eventually (λx. f x ≤ b) net ⟶ has_limsup f l net ⟶ ¬(trivial_limit net) ⟶ l ≤ b
  [hint_backward1,hint_forward]
  proof
    3: apply_backward_step has_limsup_le @1 param_g="(%x:: 'a. b)"
    3: apply_backward_step reallim_imp_has_limsup
    3: apply_backward_step reallim_const
  qed

theorem has_limsup_sequentially
  fixes a :: nat ⇒ real, l :: real
  prop has_limsup a l sequentially ⟷ (∀c. l < c ⟶ (∃N. ∀n. N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. N ≤ n ∧ c < a n))
  [hint_rewrite]
  proof
    0: rewrite_goal has_limsup sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step disjE @0.0
    0.1: introduction
    0.1.1: apply_backward_step contrapositive @0.1.0
    0.1.1: introduction
    0.1.1.1: apply_backward_step trivial_limit_sequentially
    0.2: introduction
    0.2.1: rewrite_fact eventually_sequentially @0.2.0 sym=false
    0.2.2: rewrite_fact not_exists @0.2.1 sym=false
    0.2.3: rewrite_fact not_all @0.2.2 sym=false
    0.2.4: rewrite_fact not_imp @0.2.3 sym=false
    0.2.5: rewrite_fact real_less_def @0.2.4 sym=true
    1: introduction
    1.1: apply_backward_step disjI2
    1.1: rewrite_goal eventually_sequentially sym=false
    1.1: rewrite_goal not_exists sym=false
    1.1: rewrite_goal not_all sym=false
    1.1: rewrite_goal not_imp sym=false
    1.1: rewrite_goal real_less_def sym=true
  qed

theorem has_limsup_sequentially_within
  fixes a :: nat ⇒ real, k :: nat set, l :: real
  prop has_limsup a l (within sequentially k) ⟷ finite k ∨ (∀c. l < c ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ a n ≤ c)) ∧ (∀c. c < l ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ c < a n))
  [hint_rewrite]
  proof
    0: rewrite_goal has_limsup sym=false
    0: rewrite_goal trivial_limit_sequentially_within sym=false
    0: cases "finite k"
    0: introduction
    0.1: apply_backward_step iffI
    0.1: introduction
    0.1.1: apply_backward_step disjI1
    0.2: introduction
    0.2.1: apply_backward_step disjI1
    1: introduction
    1.1: apply_backward_step iffI
    1.1: introduction
    1.1.1: apply_backward_step disjI2
    1.1.1: apply_backward_step disjE @1.1.0
    1.1.1: introduction
    1.1.1.1: apply_backward_step negE_gen @1.0,1.1.1.0
    1.1.2: introduction
    1.1.2.1: apply_backward_step conjI
    1.1.2.1: rewrite_fact eventually_sequentially_within @1.1.2.0 sym=false
    1.1.2.2: apply_forward_step conjD1 @1.1.2.1
    1.1.2.3: apply_forward_step conjD2 @1.1.2.1
    1.1.2.4: introduction c
    1.1.2.4.2: apply_fact @1.1.2.2,1.1.2.4.1
    1.1.2.4.3: apply_backward_step disjE @1.1.2.4.2
    1.1.2.4.3: introduction
    1.1.2.4.3.1: apply_backward_step negE_gen @1.0,1.1.2.4.3.0
    1.1.2.5: introduction c
    1.1.2.5.2: apply_fact @1.1.2.3,1.1.2.5.1
    1.1.2.5.3: rewrite_fact de_morgan_thm2 @1.1.2.5.2 sym=false
    1.1.2.5.4: apply_forward_step conjD2 @1.1.2.5.3
    1.1.2.5.5: rewrite_fact not_exists @1.1.2.5.4 sym=false
    1.1.2.5.6: rewrite_fact not_all @1.1.2.5.5 sym=false
    1.1.2.5.7: rewrite_fact not_imp @1.1.2.5.6 sym=false
    1.1.2.5.8: rewrite_fact not_imp @1.1.2.5.7 sym=false
    1.1.2.5.9: rewrite_goal real_less_def sym=false
    1.2: introduction
    1.2.1: apply_backward_step disjI2
    1.2.1: apply_backward_step disjE @1.2.0
    1.2.1: introduction
    1.2.1.1: apply_backward_step negE_gen @1.0,1.2.1.0
    1.2.2: introduction
    1.2.2.1: rewrite_goal eventually_sequentially_within sym=false
    1.2.2.1: apply_backward_step conjI
    1.2.2.1: apply_forward_step conjD1 @1.2.2.0
    1.2.2.2: apply_forward_step conjD2 @1.2.2.0
    1.2.2.3: introduction c
    1.2.2.3.2: apply_backward_step disjI2
    1.2.2.3.2: apply_prev @1.2.2.1
    1.2.2.4: introduction c
    1.2.2.4.2: rewrite_goal de_morgan_thm2 sym=false
    1.2.2.4.2: apply_backward_step conjI
    1.2.2.4.2: rewrite_goal not_exists sym=false
    1.2.2.4.2: rewrite_goal not_all sym=false
    1.2.2.4.2: rewrite_goal not_imp sym=false
    1.2.2.4.2: rewrite_goal not_imp sym=false
    1.2.2.4.2: rewrite_goal real_not_lt sym=true
    1.2.2.4.2: rewrite_goal double_neg sym=false
    1.2.2.4.2: apply_prev @1.2.2.2,1.2.2.4.1
  qed

theorem has_limsup_sequentially_imp_reallim_sup
  fixes a :: nat ⇒ real, l :: real
  prop has_limsup a l sequentially ⟶ tendsto_real (λn. sup (image a ({m. m ≥ n}))) l sequentially
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal reallim_sequentially sym=false
    1: rewrite_fact has_limsup_sequentially @0 sym=false
    2: introduction e
    2.2: apply_forward_step conjD1 @1
    2.3: apply_forward_step conjD2 @1
    2.4: forall_elim "l + e/2" @2.2
    2.5: cut "l < l + e / 2"
    2.5: z3 @2.1
    2.6: apply_fact @2.4,2.5
    2.7: forall_elim l-e @2.3
    2.8: cut "l - e < l"
    2.8: z3 @2.1
    2.9: apply_fact @2.7,2.8
    2.10: exists_elim N @2.6
    2.12: inst_exists_goal N
    2.12: introduction n
    2.12.2: rewrite_goal real_abs_between sym=true
    2.12.2: apply_backward_step conjI
    2.12.2: forall_elim n @2.9
    2.12.3: exists_elim M @2.12.2
    2.12.5: apply_backward_step conjI
    2.12.5: apply_backward_step real_lte_trans param_y="a M"
    2.12.5: apply_backward_step conjD2 @2.12.4
    2.12.6: apply_backward_step element_le_sup
    2.12.6: rewrite_goal image_def sym=false
    2.12.6: rewrite_goal conj_comm sym=false
    2.12.6: rewrite_goal forall_in_gspec1 sym=false
    2.12.6: inst_exists_goal l+e/2
    2.12.6: introduction m
    2.12.6.2: apply_prev @2.11
    2.12.6.2: rewrite_fact member_collect @2.12.6.1 sym=false
    2.12.6.3: z3 @2.12.6.2,2.12.1
    2.12.11: rewrite_goal in_image sym=false
    2.12.11: inst_exists_goal M
    2.12.11: apply_backward_step conjI
    2.12.11: apply_backward_step eq_refl
    2.12.12: rewrite_goal member_collect sym=false
    2.12.12: apply_forward_step conjD1 @2.12.4
    2.12.13: z3 @2.12.12
    2.12.20: apply_backward_step real_let_trans param_y="l + e / 2"
    2.12.20: apply_backward_step real_sup_le
    2.12.20: rewrite_goal set_equal_iff sym=false
    2.12.20: rewrite_goal member_empty_simp sym=false
    2.12.20: apply_backward_step negI
    2.12.20: introduction
    2.12.20.1: rewrite_fact eq_sym_eq @2.12.20.0 sym=false
    2.12.20.2: forall_elim "a M" @2.12.20.1
    2.12.20.3: rewrite_goal_with_prev @2.12.20.2
    2.12.24: rewrite_goal image_def sym=false
    2.12.24: rewrite_goal conj_comm sym=false
    2.12.24: rewrite_goal forall_in_gspec1 sym=false
    2.12.28: z3 @2.1
  qed

theorem has_limsup_sequentially_reallim_sup
  fixes a :: nat ⇒ real, l :: real
  prop has_limsup a l sequentially ⟷ (∃b. ∀n. a n ≤ b) ∧ tendsto_real (λn. sup (image a ({m. m ≥ n}))) l sequentially
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_forward_step has_limsup_sequentially_imp_reallim_sup @0.0
    0.2: apply_backward_step conjI
    0.2: rewrite_goal eventually_ubound_le_sequentially sym=true
    0.2: apply_backward_step has_limsup_imp_ubound_le @0.0
    1: introduction
    1.1: rewrite_fact reallim_sequentially @1.0 sym=false
    1.2: apply_forward_step conjD1 @1.1
    1.2: apply_forward_step conjD2 @1.1
    1.4: exists_elim b @1.3
    1.6: rewrite_goal has_limsup_sequentially sym=false
    1.6: apply_backward_step conjI
    1.6: introduction c
    1.6.2: forall_elim c-l @1.2
    1.6.3: cut "0 < c - l"
    1.6.3: z3 @1.6.1
    1.6.4: apply_fact @1.6.2,1.6.3
    1.6.5: exists_elim N @1.6.4
    1.6.7: inst_exists_goal N
    1.6.7: introduction n
    1.6.7.2: apply_fact @1.6.6,1.6.7.1
    1.6.7.3: rewrite_fact real_abs_between @1.6.7.2 sym=true
    1.6.7.4: apply_forward_step conjD2 @1.6.7.3
    1.6.7.5: apply_forward_step conjD2 @1.6.7.4
    1.6.7.6: apply_backward_step real_le_trans param_y="sup (image a ({m. m ≥ n}))"
    1.6.7.6: apply_backward_step element_le_sup
    1.6.7.6: rewrite_goal image_def sym=false
    1.6.7.6: rewrite_goal conj_comm sym=false
    1.6.7.6: rewrite_goal forall_in_gspec1 sym=false
    1.6.7.6: inst_exists_goal b
    1.6.7.6: z3 @1.5
    1.6.7.11: rewrite_goal in_image sym=false
    1.6.7.11: inst_exists_goal n
    1.6.7.11: apply_backward_step conjI
    1.6.7.11: apply_backward_step eq_refl
    1.6.7.12: z3
    1.6.7.17: apply_backward_step real_le_trans param_y="l + (c - l)"
    1.6.7.17: apply_backward_step real_lt_imp_le
    1.6.7.18: z3
    1.7: introduction c
    1.7.2: introduction N
    1.7.2.1: forall_elim l-c @1.2
    1.7.2.2: rewrite_fact real_sub_lt @1.7.1 sym=true
    1.7.2.3: apply_fact @1.7.2.1,1.7.2.2
    1.7.2.4: exists_elim M @1.7.2.3
    1.7.2.6: apply_forward_step sup_approach param_c=c param_s="{y. ?k. y = a k & k >= max N M}"
    1.7.2.7: cut "(∃x. x ∈ {y. ∃k. y = a k ∧ k ≥ max N M} ∧ c < x)"
    1.7.2.7: apply_prev @1.7.2.6
    1.7.2.7: z3
    1.7.2.8: inst_exists_goal b
    1.7.2.8: rewrite_goal forall_in_gspec1 sym=false
    1.7.2.8: z3 @1.5
    1.7.2.11: forall_elim "max N M" @1.7.2.5
    1.7.2.12: cut "M ≤ max N M"
    1.7.2.12: z3
    1.7.2.13: apply_fact @1.7.2.11,1.7.2.12
    1.7.2.14: rewrite_fact real_abs_between @1.7.2.13 sym=true
    1.7.2.15: apply_forward_step conjD2 @1.7.2.14
    1.7.2.16: apply_forward_step conjD1 @1.7.2.15
    1.7.2.17: rewrite_fact image_def @1.7.2.16 sym=false
    1.7.2.18: rewrite_fact member_collect @1.7.2.17 sym=false
    1.7.2.19: rewrite_goal conj_comm sym=false
    1.7.2.19: apply_backward_step real_let_trans param_y="l - (l - c)"
    1.7.2.19: z3
    1.7.2.23: rewrite_fact exists_in_gspec1 @1.7.2.22 sym=false
    1.7.2.24: z3 @1.7.2.23
  qed

theorem has_limsup_mul_reallim_right
  fixes a :: real, b :: real, f :: 'a ⇒ real, g :: 'a ⇒ real, net :: 'a net
  prop has_limsup f a net ⟶ tendsto_real g b net ⟶ eventually (λx. 0 ≤ f x) net ⟶ eventually (λx. 0 ≤ g x) net ⟶ has_limsup (λx. f x * g x) (a * b) net
  [hint_backward,hint_backward1]
  proof
    4: rewrite_goal has_limsup sym=false
    4: cases "trivial_limit net"
    4: introduction
    4.1: apply_backward_step disjI1
    5: introduction
    5.1: apply_backward_step disjI2
    5.1: apply_backward_step conjI
    5.1: introduction c
    5.1.2: cut "?d. 0 < d & !x. abs x < d --> (a + x) * (b + x) < c"
    5.1.2: cut "real_continuous (λx. (a + x) * (b + x)) (atreal 0)"
    5.1.2: apply_backward_step real_continuous_mul
    5.1.2: apply_backward_step real_continuous_add
    5.1.2: apply_backward_step real_continuous_const
    5.1.3: apply_backward_step real_continuous_at_id
    5.1.5: apply_backward_step real_continuous_add
    5.1.5: apply_backward_step real_continuous_const
    5.1.8: rewrite_fact real_continuous_atreal1 @5.1.7 sym=false
    5.1.9: forall_elim "c- a * b" @5.1.8
    5.1.10: cut "0 < c - a * b"
    5.1.10: z3 @5.1.1
    5.1.11: apply_fact @5.1.9,5.1.10
    5.1.12: exists_elim d @5.1.11
    5.1.14: inst_exists_goal d
    5.1.14: apply_backward_step conjI
    5.1.14: apply_backward_step conjD1 @5.1.13
    5.1.15: apply_forward_step conjD2 @5.1.13
    5.1.16: introduction x
    5.1.16.2: rewrite_fact real_sub_rzero @5.1.15 sym=false
    5.1.16.3: apply_fact @5.1.16.2,5.1.16.1
    5.1.16.4: z3 @5.1.16.3
    5.1.19: apply_forward_step conjD2 @5.1.17
    5.1.20: rewrite_fact tendsto_real_def @1 sym=false
    5.1.21: forall_elim d/2 @5.1.20
    5.1.22: cut "0 < d / 2 " @5.1.21
    5.1.22: z3 @5.1.14
    5.1.23: apply_fact @5.1.21,5.1.22
    5.1.24: apply_backward_step eventually_mp param_P="(λx. abs (g x - b) < d / 2)"
    5.1.24: rewrite_fact has_limsup @0 sym=false
    5.1.25: apply_backward_step disjE @5.1.24
    5.1.25: introduction
    5.1.25.1: apply_backward_step eventually_trivial @5.1.25.0
    5.1.26: introduction
    5.1.26.1: apply_forward_step conjD1 @5.1.26.0
    5.1.26.2: forall_elim "a + d/2" @5.1.26.1
    5.1.26.3: cut "a < a + d / 2"
    5.1.26.3: z3 @5.1.14
    5.1.26.4: apply_fact @5.1.26.2,5.1.26.3
    5.1.26.5: apply_backward_step eventually_mp param_P="(λx. f x ≤ a + d / 2)"
    5.1.26.5: apply_forward_step conjI @2,3
    5.1.26.6: rewrite_fact eventually_and @5.1.26.5 sym=true
    5.1.26.7: apply_backward_step eventually_mono param_P="(λx. 0 ≤ f x ∧ 0 ≤ g x)"
    5.1.26.7: introduction x
    5.1.26.7.4: apply_backward_step real_le_trans param_y="(a + d / 2) * (b + d / 2)"
    5.1.26.7.4: apply_backward_step real_le_mul2
    5.1.26.7.4: apply_backward_step conjD1 @5.1.26.7.1
    5.1.26.7.5: apply_backward_step conjD2 @5.1.26.7.1
    5.1.26.7.6: z3 @5.1.26.7.3
    5.1.26.7.8: forall_elim d/2 @5.1.19
    5.1.26.7.9: apply_backward_step real_lt_imp_le
    5.1.26.7.9: apply_prev @5.1.26.7.8
    5.1.26.7.9: z3 @5.1.14
    5.2: introduction c
    5.2.2: cases "b=0"
    5.2.2: introduction
    5.2.2.1: rewrite_fact_with_prev @5.2.2.0,5.2.1
    5.2.2.2: rewrite_fact real_mul_rzero @5.2.2.1 sym=false
    5.2.2.3: apply_backward_step negI
    5.2.2.3: introduction
    5.2.2.3.1: apply_backward_step negE param_A="0<=c"
    5.2.2.3.1: rewrite_goal real_not_lt sym=true
    5.2.2.3.1: rewrite_goal double_neg sym=false
    5.2.2.3.3: cut "eventually (λx. 0 ≤ c) net"
    5.2.2.3.3: apply_forward_step conjI @2,3
    5.2.2.3.4: rewrite_fact eventually_and @5.2.2.3.3 sym=true
    5.2.2.3.5: apply_forward_step conjI @5.2.2.3.4,5.2.2.3.0
    5.2.2.3.6: rewrite_fact eventually_and @5.2.2.3.5 sym=true
    5.2.2.3.7: apply_backward_step eventually_mono param_P="(λx. (0 ≤ f x ∧ 0 ≤ g x) ∧ f x * g x ≤ c)"
    5.2.2.3.7: z3
    5.2.2.3.9: apply_forward_step eventually_happens @5.2.2.3.8
    5.2.2.3.10: apply_backward_step disjE @5.2.2.3.9
    5.2.2.3.10: introduction
    5.2.2.3.10.1: apply_backward_step negE_gen @5.0,5.2.2.3.10.0
    5.2.2.3.11: z3
    5.2.3: introduction
    5.2.3.1: apply_backward_step negI
    5.2.3.1: introduction
    5.2.3.1.1: apply_backward_step negE param_A="0 < b"
    5.2.3.1.1: apply_backward_step negI
    5.2.3.1.1: introduction
    5.2.3.1.1.1: cut "∃d. 0 < d ∧ (∀x. abs x < d ⟶ c < (a + x) * (b + x))"
    5.2.3.1.1.1: cut "real_continuous (λx. (a + x) * (b + x)) (atreal 0)"
    5.2.3.1.1.1: apply_backward_step real_continuous_mul
    5.2.3.1.1.1: apply_backward_step real_continuous_add
    5.2.3.1.1.1: apply_backward_step real_continuous_const
    5.2.3.1.1.2: apply_backward_step real_continuous_at_id
    5.2.3.1.1.4: apply_backward_step real_continuous_add
    5.2.3.1.1.4: apply_backward_step real_continuous_const
    5.2.3.1.1.7: rewrite_fact real_continuous_atreal1 @5.2.3.1.1.6 sym=false
    5.2.3.1.1.8: forall_elim "a * b -c" @5.2.3.1.1.7
    5.2.3.1.1.9: cut "0 < a * b - c"
    5.2.3.1.1.9: z3 @5.2.1
    5.2.3.1.1.10: apply_fact @5.2.3.1.1.8,5.2.3.1.1.9
    5.2.3.1.1.11: exists_elim d @5.2.3.1.1.10
    5.2.3.1.1.13: inst_exists_goal d
    5.2.3.1.1.13: apply_backward_step conjI
    5.2.3.1.1.13: apply_backward_step conjD1 @5.2.3.1.1.12
    5.2.3.1.1.14: apply_forward_step conjD2 @5.2.3.1.1.12
    5.2.3.1.1.15: rewrite_fact real_sub_rzero @5.2.3.1.1.14 sym=false
    5.2.3.1.1.16: introduction x
    5.2.3.1.1.16.2: apply_fact @5.2.3.1.1.15,5.2.3.1.1.16.1
    5.2.3.1.1.16.3: z3 @5.2.3.1.1.16.2
    5.2.3.1.1.19: exists_elim d1 @5.2.3.1.1.18
    5.2.3.1.1.21: rewrite_fact has_limsup @0 sym=false
    5.2.3.1.1.22: apply_backward_step contrapositive @5.2.3.1.1.21
    5.2.3.1.1.22: introduction
    5.2.3.1.1.22.1: rewrite_goal de_morgan_thm2 sym=false
    5.2.3.1.1.22.1: apply_backward_step conjI
    5.2.3.1.1.22.1: rewrite_goal de_morgan_thm1 sym=false
    5.2.3.1.1.22.1: apply_backward_step disjI2
    5.2.3.1.1.22.1: rewrite_goal not_all sym=false
    5.2.3.1.1.22.1: rewrite_goal not_imp sym=false
    5.2.3.1.1.22.1: inst_exists_goal "a - min b (d1 / 2) / 2"
    5.2.3.1.1.22.1: apply_backward_step conjI
    5.2.3.1.1.22.1: z3 @5.2.3.1.1.13,5.2.3.1.1.0,5.2.3.1.1.20
    5.2.3.1.1.22.2: rewrite_goal double_neg sym=false
    5.2.3.1.1.22.2: rewrite_fact tendsto_real_def @1 sym=false
    5.2.3.1.1.22.3: forall_elim "min b (d1 / 2) / 2" @5.2.3.1.1.22.2
    5.2.3.1.1.22.4: cut "0 < min b (d1 / 2) / 2"
    5.2.3.1.1.22.4: z3 @5.2.3.1.1.0,5.2.3.1.1.20
    5.2.3.1.1.22.5: apply_fact @5.2.3.1.1.22.3,5.2.3.1.1.22.4
    5.2.3.1.1.22.6: apply_forward_step conjI @2,3
    5.2.3.1.1.22.7: rewrite_fact eventually_and @5.2.3.1.1.22.6 sym=true
    5.2.3.1.1.22.8: apply_forward_step conjI @5.2.3.1.1.22.7,5.2.3.1.1.22.5
    5.2.3.1.1.22.9: rewrite_fact eventually_and @5.2.3.1.1.22.8 sym=true
    5.2.3.1.1.22.10: apply_forward_step conjI @5.2.3.1.0,5.2.3.1.1.22.9
    5.2.3.1.1.22.11: rewrite_fact eventually_and @5.2.3.1.1.22.10 sym=true
    5.2.3.1.1.22.12: apply_backward_step eventually_mono param_P="(λx. f x * g x ≤ c ∧ (0 ≤ f x ∧ 0 ≤ g x) ∧ abs (g x - b) < min b (d1 / 2) / 2)"
    5.2.3.1.1.22.12: introduction x
    5.2.3.1.1.22.12.2: apply_forward_step conjD1 @5.2.3.1.1.22.12.1
    5.2.3.1.1.22.12.3: apply_forward_step conjD2 @5.2.3.1.1.22.12.1
    5.2.3.1.1.22.12.4: apply_forward_step conjD1 @5.2.3.1.1.22.12.3
    5.2.3.1.1.22.12.5: apply_forward_step conjD2 @5.2.3.1.1.22.12.3
    5.2.3.1.1.22.12.6: apply_forward_step conjD1 @5.2.3.1.1.20
    5.2.3.1.1.22.12.7: apply_forward_step conjD2 @5.2.3.1.1.20
    5.2.3.1.1.22.12.8: apply_backward_step real_le_rcancel_imp param_z="b-min b (d1 / 2) / 2"
    5.2.3.1.1.22.12.8: z3 @5.2.3.1.1.0
    5.2.3.1.1.22.12.9: apply_backward_step real_le_trans param_y="f x * g x"
    5.2.3.1.1.22.12.9: apply_backward_step real_le_lmul
    5.2.3.1.1.22.12.9: apply_backward_step conjD1 @5.2.3.1.1.22.12.4
    5.2.3.1.1.22.12.10: z3 @5.2.3.1.1.22.12.5
    5.2.3.1.1.22.12.12: apply_backward_step real_le_trans param_y=c
    5.2.3.1.1.22.12.12: forall_elim "- (min b (d1 / 2) / 2)" @5.2.3.1.1.22.12.7
    5.2.3.1.1.22.12.13: rewrite_goal real_minus_def sym=false
    5.2.3.1.1.22.12.13: apply_backward_step real_lt_imp_le
    5.2.3.1.1.22.12.13: apply_prev @5.2.3.1.1.22.12.12
    5.2.3.1.1.22.12.13: z3 @5.2.3.1.1.22.12.6,5.2.3.1.1.0
    5.2.3.1.3: cut "0 <= b"
    5.2.3.1.3: apply_backward_step reallim_lbound param_f=g param_net=net
    5.2.3.1.4: z3 @5.2.3.1.3,5.2.3.0
  qed

theorem has_limsup_mul_reallim_left
  fixes a :: real, b :: real, f :: 'a ⇒ real, g :: 'a ⇒ real, net :: 'a net
  prop tendsto_real f a net ⟶ has_limsup g b net ⟶ eventually (λx. 0 ≤ f x) net ⟶ eventually (λx. 0 ≤ g x) net ⟶ has_limsup (λx. f x * g x) (a * b) net
  [hint_backward,hint_backward1]
  proof
    4: rewrite_goal real_mult_comm sym=false
    4: apply_backward_step has_limsup_mul_reallim_right
  qed

theorem has_limsup_sequentially_within_lbound_zero
  fixes b :: real, f :: nat ⇒ real, k :: nat set
  prop has_limsup f b (within sequentially k) ⟶ (∀x. 0 ≤ f x) ⟶ ¬(finite k) ⟶ 0 ≤ b
  [hint_backward1]
  proof
    3: apply_backward_step has_limsup_le param_f="(%n::nat. (0::real))" param_g=f param_net="(within sequentially k)"
    3: apply_backward_step reallim_imp_has_limsup
    3: apply_backward_step reallim_const
    5: rewrite_goal trivial_limit_sequentially_within sym=false
    6: apply_backward_step always_eventually
  qed

theorem has_liminf_transform
  fixes f :: 'a ⇒ real, g :: 'a ⇒ real, l :: real, net :: 'a net
  prop eventually (λx. f x = g x) net ⟶ has_liminf f l net ⟶ has_liminf g l net
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal has_liminf_def sym=false
    2: rewrite_fact has_liminf_def @1 sym=false
    3: apply_backward_step disjE @2
    3: introduction
    3.1: apply_backward_step disjI1
    4: introduction
    4.1: apply_backward_step disjI2
    4.1: cut "!b. eventually (λx. b ≤ f x) net <--> eventually (λx. b ≤ g x) net"
    4.1: introduction b
    4.1.1: apply_backward_step eventually_iff
    4.1.1: apply_backward_step eventually_mp param_P="(λx. f x = g x)"
    4.1.1: apply_backward_step always_eventually
    4.1.1: z3
    4.2: rewrite_fact_with_prev @4.1,4.0
  qed

theorem has_liminf_eventually_lbound
  fixes b :: real, f :: 'a ⇒ real, l :: real, net :: 'a net
  prop ¬(trivial_limit net) ⟶ has_liminf f l net ⟶ b < l ⟶ eventually (λx. b < f x) net
  [hint_backward,hint_backward1]
  proof
    3: rewrite_fact has_liminf_def @1 sym=false
    4: apply_backward_step disjE @3
    4: introduction
    4.1: apply_backward_step negE_gen @0,4.0
    5: introduction
    5.1: apply_forward_step has_sup_approach param_c=b param_l=l param_s="{b. eventually (λx. b ≤ f x) net}"
    5.2: apply_fact @5.1,5.0,2
    5.3: rewrite_fact member_collect @5.2 sym=false
    5.4: exists_elim c @5.3
    5.6: apply_forward_step conjD1 @5.5
    5.7: apply_backward_step eventually_mp param_P="(λx. c ≤ f x)"
    5.7: apply_backward_step always_eventually
    5.7: apply_forward_step conjD2 @5.5
    5.8: z3 @5.7
  qed

theorem reallim_imp_has_liminf
  fixes f :: 'a ⇒ real, l :: real, net :: 'a net
  prop tendsto_real f l net ⟶ has_liminf f l net
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal has_liminf_def sym=false
    1: cases "trivial_limit net"
    1: introduction
    1.1: apply_backward_step disjI1
    2: introduction
    2.1: apply_backward_step disjI2
    2.1: rewrite_goal has_sup sym=false
    2.1: apply_backward_step conjI
    2.1: apply_backward_step negI
    2.1: rewrite_goal set_equal_iff sym=false
    2.1: rewrite_goal member_empty_simp sym=false
    2.1: introduction
    2.1.1: apply_backward_step contrapositive @2.1.0
    2.1.1: introduction
    2.1.1.1: rewrite_goal not_all sym=false
    2.1.1.1: inst_exists_goal l-1
    2.1.1.1: rewrite_goal member_collect sym=false
    2.1.1.1: apply_backward_step negI
    2.1.1.1: introduction
    2.1.1.1.1: rewrite_fact eq_sym_eq @2.1.1.1.0 sym=false
    2.1.1.1.2: rewrite_goal_with_prev @2.1.1.1.1
    2.1.1.1.2: rewrite_fact tendsto_real_def @0 sym=false
    2.1.1.1.3: forall_elim "(1::real)" @2.1.1.1.2
    2.1.1.1.4: cut "(0::real) < 1"
    2.1.1.1.4: z3
    2.1.1.1.5: apply_fact @2.1.1.1.3,2.1.1.1.4
    2.1.1.1.6: apply_backward_step eventually_mono param_P="(λx. abs (f x - l) < 1)"
    2.1.1.1.6: z3
    2.5: apply_backward_step conjI
    2.5: rewrite_goal member_collect sym=false
    2.5: introduction x
    2.5.2: apply_backward_step reallim_lbound param_f=f param_net=net
    2.7: introduction c
    2.7.2: inst_exists_goal "(l+c)/2"
    2.7.2: rewrite_goal member_collect sym=false
    2.7.2: apply_backward_step conjI
    2.7.2: rewrite_fact tendsto_real_def @0 sym=false
    2.7.3: forall_elim "(l-c)/2" @2.7.2
    2.7.4: cut "0 < (l - c) / 2 "
