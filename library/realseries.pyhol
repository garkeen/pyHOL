    #[12] _VAR l
    #[13] trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
    #[14] (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
    #[15] trivial_limit net ∨ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
  ← rule disjE goal=14 facts=[13]
    #[16] trivial_limit net ⟶ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
    #[17] (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net)) ⟶ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
  ← intro goal=16
    #[18] (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
  ← rule negE_gen goal=18 facts=[9,6]
    #[19] (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
  ← intro goal=17
    #[20] (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
    #[21] (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
  → forward conjD1 goal=21 facts=[20]
    #[22] ∀c. c < l ⟶ eventually (λx. c ≤ f x) net
  → forward conjD2 goal=21 facts=[20]
    #[23] ∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net)
  ← rule conjI goal=21
    #[24] ∃b. eventually (λx. b ≤ f x) net
