theorem liminf_exists
  fixes f :: 'a => real, net :: 'a net
  prop (?l. has_liminf f l net) <--> trivial_limit net | (?b. eventually (%x. b <= f x) net) & (?c. ~(eventually (%x. c <= f x) net))
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] (∃l. has_liminf f l net) ⟶ trivial_limit net ∨ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
    #[2] trivial_limit net ∨ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net)) ⟶ (∃l. has_liminf f l net)
  ← rewrite has_liminf sym=false goal=1
    #[3] (∃l. trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))) ⟶ trivial_limit net ∨ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
  ← cases "trivial_limit net" goal=3
    #[4] trivial_limit net ⟶ (∃l. trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))) ⟶ trivial_limit net ∨ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
    #[5] ¬(trivial_limit net) ⟶ (∃l. trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))) ⟶ trivial_limit net ∨ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
  ← intro goal=4
    #[6] trivial_limit net
    #[7] ∃l. trivial_limit net ∨ (∀c. c < l ⟶ eventually (λx. c ≤ f x) net) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ f x) net))
    #[8] trivial_limit net ∨ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
  ← rule disjI1 goal=8
  ← intro goal=5
    #[9] ¬(trivial_limit net)
