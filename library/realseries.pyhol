  → rewrite target=fact not_imp sym=false goal=42 facts=[48]
    #[49] ∀N. ∃n. n ∈ k ∧ N ≤ n ∧ ¬(c ≤ a n)
  ← rewrite real_less_def sym=false goal=42
  ← intro goal=19
    #[50] finite k ∨ (∀c. c < l ⟶ finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)))
  ← rule disjI2 goal=50
    #[51] (∀c. c < l ⟶ finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)))
  ← rule disjE goal=51 facts=[9]
    #[52] finite k ⟶ (∀c. c < l ⟶ finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)))
    #[53] (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c)) ⟶ (∀c. c < l ⟶ finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)))
  ← intro goal=52
    #[54] (∀c. c < l ⟶ finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)))
