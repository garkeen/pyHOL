theorem has_limsup_sequentially_imp_reallim_sup
  fixes a :: nat => real, l :: real
  prop has_limsup a l sequentially --> tendsto_real (%n. sup (image a ({m. m >= n}))) l sequentially
  [hint_backward,hint_forward]

theorem has_limsup_sequentially_reallim_sup
  fixes a :: nat => real, l :: real
  prop has_limsup a l sequentially <--> (?b. !n. a n <= b) & tendsto_real (%n. sup (image a ({m. m >= n}))) l sequentially

theorem has_limsup_mul_reallim_right
  fixes a :: real, b :: real, f :: 'a => real, g :: 'a => real, net :: 'a net
  prop has_limsup f a net --> tendsto_real g b net --> eventually (%x. 0 <= f x) net --> eventually (%x. 0 <= g x) net --> has_limsup (%x. f x * g x) (a * b) net
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] has_limsup f a net
    #[2] tendsto_real g b net
    #[3] eventually (λx. 0 ≤ f x) net
    #[4] eventually (λx. 0 ≤ g x) net
    #[5] has_limsup (λx. f x * g x) (a * b) net
  ← rewrite has_limsup sym=false goal=5
    #[6] trivial_limit net ∨ (∀c. a * b < c ⟶ eventually (λx. f x * g x ≤ c) net) ∧ (∀c. c < a * b ⟶ ¬(eventually (λx. f x * g x ≤ c) net))
  ← cases "trivial_limit net" goal=6
    #[7] trivial_limit net ⟶ trivial_limit net ∨ (∀c. a * b < c ⟶ eventually (λx. f x * g x ≤ c) net) ∧ (∀c. c < a * b ⟶ ¬(eventually (λx. f x * g x ≤ c) net))
    #[8] ¬(trivial_limit net) ⟶ trivial_limit net ∨ (∀c. a * b < c ⟶ eventually (λx. f x * g x ≤ c) net) ∧ (∀c. c < a * b ⟶ ¬(eventually (λx. f x * g x ≤ c) net))
  ← intro goal=7
    #[9] trivial_limit net
    #[10] trivial_limit net ∨ (∀c. a * b < c ⟶ eventually (λx. f x * g x ≤ c) net) ∧ (∀c. c < a * b ⟶ ¬(eventually (λx. f x * g x ≤ c) net))
  ← rule disjI1 goal=10
  ← intro goal=8
    #[11] ¬(trivial_limit net)
    #[12] trivial_limit net ∨ (∀c. a * b < c ⟶ eventually (λx. f x * g x ≤ c) net) ∧ (∀c. c < a * b ⟶ ¬(eventually (λx. f x * g x ≤ c) net))
  ← rule disjI2 goal=12
    #[13] (∀c. a * b < c ⟶ eventually (λx. f x * g x ≤ c) net) ∧ (∀c. c < a * b ⟶ ¬(eventually (λx. f x * g x ≤ c) net))
  ← rule conjI goal=13
    #[14] ∀c. a * b < c ⟶ eventually (λx. f x * g x ≤ c) net
    #[15] ∀c. c < a * b ⟶ ¬(eventually (λx. f x * g x ≤ c) net)
  ← intro c goal=14
    #[16] _VAR c
    #[17] a * b < c
    #[18] eventually (λx. f x * g x ≤ c) net
  cut "?d. 0 < d & !x. abs x < d --> (a + x) * (b + x) < c" goal=18
    #[19] ∃d. 0 < d ∧ (∀x. abs x < d ⟶ (a + x) * (b + x) < c)
  cut "real_continuous (λx. (a + x) * (b + x)) (atreal 0)" goal=19
    #[20] real_continuous (λx. (a + x) * (b + x)) (atreal 0)
  ← rule real_continuous_mul goal=20
    #[21] real_continuous (λx. a + x) (atreal 0)
    #[22] real_continuous (λx. b + x) (atreal 0)
  ← rule real_continuous_add goal=21
    #[23] real_continuous (λx. a) (atreal 0)
    #[24] real_continuous (λx. x) (atreal 0)
  ← rule real_continuous_const goal=23
    #[25] real_continuous (λx. a) (atreal 0)
  ← rule real_continuous_at_id goal=24
    #[26] real_continuous (λx. x) (atreal 0)
  ← rule real_continuous_add goal=22
    #[27] real_continuous (λx. b) (atreal 0)
  ← rule real_continuous_const goal=27
    #[28] real_continuous (λx. b) (atreal 0)
  → rewrite target=fact real_continuous_atreal1 sym=false goal=19 facts=[20]
    #[29] ∀e. 0 < e ⟶ (∃d. 0 < d ∧ (∀x1. abs (x1 - 0) < d ⟶ abs ((a + x1) * (b + x1) - (a + 0) * (b + 0)) < e))
  → inst target=fact "c- a * b" goal=19 facts=[29]
    #[30] 0 < c - a * b ⟶ (∃d. 0 < d ∧ (∀x1. abs (x1 - 0) < d ⟶ abs ((a + x1) * (b + x1) - (a + 0) * (b + 0)) < c - a * b))
