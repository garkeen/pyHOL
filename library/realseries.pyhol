  fixes a :: nat => real, k :: nat set, l :: real
  prop has_limsup a l (within sequentially k) <--> finite k | (!c. l < c --> (?N. !n. n Mem k --> N <= n --> a n <= c)) & (!c. c < l --> (!N. ?n. n Mem k & N <= n & c < a n))
