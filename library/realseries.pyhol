theorem has_liminf_le
  fixes f :: 'a => real, g :: 'a => real, l :: real, m :: real, net :: 'a net
  prop has_liminf f l net --> has_liminf g m net --> ~(trivial_limit net) --> eventually (%x. f x <= g x) net --> l <= m
  [hint_backward1]
proof
  ← intro goal=0
    #[1] has_liminf f l net
    #[2] has_liminf g m net
    #[3] ¬(trivial_limit net)
    #[4] eventually (λx. f x ≤ g x) net
    #[5] l ≤ m
  ← rewrite real_not_lt sym=true goal=5
    #[6] ¬(m < l)
  ← rewrite real_lt_between sym=false goal=6
    #[7] ¬(∃x. m < x ∧ x < l)
  ← rewrite not_exists sym=false goal=7
    #[8] ∀x. ¬(m < x ∧ x < l)
  ← intro c goal=8
    #[9] _VAR c
    #[10] ¬(m < c ∧ c < l)
  ← rule negI goal=10
    #[11] m < c ∧ c < l ⟶ false
  ← intro goal=11
    #[12] m < c ∧ c < l
    #[13] false
  ← rule negE param_A="eventually (λx. c < f x) net" goal=13
    #[14] ¬(eventually (λx. c < f x) net)
    #[15] eventually (λx. c < f x) net
  → forward conjD1 goal=14 facts=[12]
    #[16] m < c
  → forward conjD2 goal=14 facts=[12]
    #[17] c < l
  ← rule negI goal=14
    #[18] eventually (λx. c < f x) net ⟶ false
  ← intro goal=18
    #[19] eventually (λx. c < f x) net
    #[20] false
  ← rule negE param_A="eventually (λx. c ≤ g x) net" goal=20
    #[21] ¬(eventually (λx. c ≤ g x) net)
    #[22] eventually (λx. c ≤ g x) net
  ← rule has_liminf_not_lbound goal=21 facts=[3,2,16]
    #[23] ¬(eventually (λx. c ≤ g x) net)
  ← rule eventually_mp param_P="(λx. c < f x & f x ≤ g x) " goal=22
    #[24] eventually (λx. c < f x ∧ f x ≤ g x ⟶ c ≤ g x) net
    #[25] eventually (λx. c < f x ∧ f x ≤ g x) net
  ← rule always_eventually goal=24
    #[26] ∀x. c < f x ∧ f x ≤ g x ⟶ c ≤ g x
  ← z3 goal=26
    #[27] ∀x. c < f x ∧ f x ≤ g x ⟶ c ≤ g x
  ← rewrite eventually_and sym=false goal=25
    #[28] eventually (λx. c < f x) net ∧ eventually (λx. f x ≤ g x) net
  ← rule conjI goal=28
  ← rule has_liminf_eventually_lbound goal=15 facts=[3,1,17]
    #[29] eventually (λx. c < f x) net
qed

theorem has_liminf_lbound
  fixes b :: real, f :: 'a => real, l :: real, net :: 'a net
  prop eventually (%x. b <= f x) net --> has_liminf f l net --> ~(trivial_limit net) --> b <= l
  [hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] eventually (λx. b ≤ f x) net
    #[2] has_liminf f l net
    #[3] ¬(trivial_limit net)
    #[4] b ≤ l
  ← rule has_liminf_le param_f="(%x::'a. b)" param_g=f param_net=net goal=4
    #[5] has_liminf (λx. b) b net
  ← rule reallim_imp_has_liminf goal=5
    #[6] tendsto_real (λx. b) b net
  ← rule reallim_const goal=6
    #[7] tendsto_real (λx. b) b net
qed

theorem has_liminf_sequentially
  fixes a :: nat => real, l :: real
  prop has_liminf a l sequentially <--> (!c. c < l --> (?N. !n. N <= n --> c <= a n)) & (!c. l < c --> (!N. ?n. N <= n & a n < c))
  [hint_rewrite]
proof
  ← rewrite has_liminf sym=false goal=0
    #[1] trivial_limit sequentially ∨ (∀c. c < l ⟶ eventually (λx. c ≤ a x) sequentially) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ a x) sequentially)) ⟷ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
  ← rewrite eventually_sequentially sym=false goal=1
    #[2] trivial_limit sequentially ∨ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ⟷ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
  ← rule iffI goal=2
    #[3] trivial_limit sequentially ∨ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ⟶ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
    #[4] (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c)) ⟶ trivial_limit sequentially ∨ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n))
  ← intro goal=3
    #[5] trivial_limit sequentially ∨ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n))
    #[6] (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
  ← rule disjE goal=6 facts=[5]
    #[7] trivial_limit sequentially ⟶ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
    #[8] (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ⟶ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
  ← intro goal=7
    #[9] trivial_limit sequentially
    #[10] (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
  ← rule contrapositive goal=10 facts=[9]
    #[11] ¬((∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))) ⟶ ¬(trivial_limit sequentially)
  ← intro goal=11
    #[12] ¬((∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c)))
    #[13] ¬(trivial_limit sequentially)
  ← rule trivial_limit_sequentially goal=13
    #[14] ¬(trivial_limit sequentially)
  ← intro goal=8
    #[15] (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n))
    #[16] (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
  ← rule conjI goal=16
    #[17] ∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)
    #[18] ∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c)
  ← rule conjD1 goal=17 facts=[15]
    #[19] ∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)
  → forward conjD2 goal=18 facts=[15]
    #[20] ∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n)
  → rewrite target=fact not_exists sym=false goal=18 facts=[20]
    #[21] ∀c. l < c ⟶ (∀N. ¬(∀n. N ≤ n ⟶ c ≤ a n))
  → rewrite target=fact not_all sym=false goal=18 facts=[21]
    #[22] ∀c. l < c ⟶ (∀N. ∃n. ¬(N ≤ n ⟶ c ≤ a n))
  → rewrite target=fact not_imp sym=false goal=18 facts=[22]
    #[23] ∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ ¬(c ≤ a n))
  → rewrite target=fact real_not_lt sym=true goal=18 facts=[23]
    #[24] ∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ ¬¬(a n < c))
  → rewrite target=fact double_neg sym=false goal=18 facts=[24]
    #[25] ∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c)
  ← intro goal=4
    #[26] (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c))
    #[27] trivial_limit sequentially ∨ (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n))
  ← rule disjI2 goal=27
    #[28] (∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n))
  ← rule conjI goal=28
    #[29] ∀c. c < l ⟶ (∃N. ∀n. N ≤ n ⟶ c ≤ a n)
    #[30] ∀c. l < c ⟶ ¬(∃N. ∀n. N ≤ n ⟶ c ≤ a n)
  ← rule conjD1 goal=29 facts=[26]
  ← rewrite not_exists sym=false goal=30
    #[31] ∀c. l < c ⟶ (∀N. ¬(∀n. N ≤ n ⟶ c ≤ a n))
  ← rewrite not_all sym=false goal=31
    #[32] ∀c. l < c ⟶ (∀N. ∃n. ¬(N ≤ n ⟶ c ≤ a n))
  ← rewrite not_imp sym=false goal=32
    #[33] ∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ ¬(c ≤ a n))
  ← rewrite real_not_lt sym=true goal=33
    #[34] ∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ ¬¬(a n < c))
  ← rewrite double_neg sym=false goal=34
    #[35] ∀c. l < c ⟶ (∀N. ∃n. N ≤ n ∧ a n < c)
  ← rule conjD2 goal=35 facts=[26]
qed

theorem has_liminf_sequentially_within
  fixes a :: nat => real, k :: nat set, l :: real
  prop has_liminf a l (within sequentially k) <--> finite k | (!c. c < l --> (?N. !n. n Mem k --> N <= n --> c <= a n)) & (!c. l < c --> (!N. ?n. n Mem k & N <= n & a n < c))
  [hint_rewrite]
proof
  ← cases "finite k" goal=0
    #[1] finite k ⟶ has_liminf a l (within sequentially k) ⟷ finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
    #[2] ¬(finite k) ⟶ has_liminf a l (within sequentially k) ⟷ finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
  ← intro goal=1
    #[3] finite k
    #[4] has_liminf a l (within sequentially k) ⟷ finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
  ← rule iffI goal=4
    #[5] has_liminf a l (within sequentially k) ⟶ finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
    #[6] finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c)) ⟶ has_liminf a l (within sequentially k)
  ← intro goal=5
    #[7] has_liminf a l (within sequentially k)
    #[8] finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
  ← rule disjI1 goal=8
  ← intro goal=6
    #[9] finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
    #[10] has_liminf a l (within sequentially k)
  ← rewrite has_liminf sym=false goal=10
    #[11] trivial_limit (within sequentially k) ∨ (∀c. c < l ⟶ eventually (λx. c ≤ a x) (within sequentially k)) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ a x) (within sequentially k)))
  ← rule disjI1 goal=11
    #[12] trivial_limit (within sequentially k)
  ← rewrite trivial_limit_sequentially_within sym=false goal=12
  ← rewrite has_liminf sym=false goal=2
    #[13] ¬(finite k) ⟶ trivial_limit (within sequentially k) ∨ (∀c. c < l ⟶ eventually (λx. c ≤ a x) (within sequentially k)) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ a x) (within sequentially k))) ⟷ finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
  ← rewrite trivial_limit_sequentially_within sym=false goal=13
    #[14] ¬(finite k) ⟶ finite k ∨ (∀c. c < l ⟶ eventually (λx. c ≤ a x) (within sequentially k)) ∧ (∀c. l < c ⟶ ¬(eventually (λx. c ≤ a x) (within sequentially k))) ⟷ finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
  ← rewrite eventually_sequentially_within sym=false goal=14
    #[15] ¬(finite k) ⟶ finite k ∨ (∀c. c < l ⟶ finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ ¬(finite k ∨ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n))) ⟷ finite k ∨ (∀c. c < l ⟶ (∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)) ∧ (∀c. l < c ⟶ (∀N. ∃n. n ∈ k ∧ N ≤ n ∧ a n < c))
  ← intro goal=15
