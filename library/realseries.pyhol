  ← inst l-1 goal=24
    #[26] eventually (λx. l - 1 ≤ f x) net
  ← apply_prev goal=26 facts=[22]
    #[27] l - 1 < l
  ← z3 goal=27
    #[28] l - 1 < l
  ← inst l+1 goal=25
    #[29] ¬(eventually (λx. l + 1 ≤ f x) net)
  ← apply_prev goal=29 facts=[23]
    #[30] l < l + 1
  ← z3 goal=30
    #[31] l < l + 1
  ← intro goal=2
    #[32] trivial_limit net ∨ (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
    #[33] ∃l. has_liminf f l net
  ← rewrite has_liminf_def sym=false goal=33
    #[34] ∃l. trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← cases "trivial_limit net" goal=34
    #[35] trivial_limit net ⟶ (∃l. trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l)
    #[36] ¬(trivial_limit net) ⟶ (∃l. trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l)
  ← intro goal=35
    #[37] ∃l. trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← inst "(0::real)" goal=37
    #[38] trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) 0
  ← rule disjI1 goal=38
  ← intro goal=36
    #[39] ∃l. trivial_limit net ∨ has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rewrite right_or_exists_thm sym=true goal=39
    #[40] trivial_limit net ∨ (∃l. has_sup ({b. eventually (λx. b ≤ f x) net}) l)
  ← rule disjI2 goal=40
    #[41] ∃l. has_sup ({b. eventually (λx. b ≤ f x) net}) l
  ← rewrite sup_exists sym=false goal=41
    #[42] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b)
  ← rule disjE goal=42 facts=[32]
    #[43] trivial_limit net ⟶ ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b)
    #[44] (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net)) ⟶ ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b)
  ← intro goal=43
    #[45] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b)
  ← rule negE_gen goal=45 facts=[9,6]
    #[46] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b)
  ← intro goal=44
    #[47] (∃b. eventually (λx. b ≤ f x) net) ∧ (∃c. ¬(eventually (λx. c ≤ f x) net))
    #[48] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b)
  → forward conjD1 goal=48 facts=[47]
    #[49] ∃b. eventually (λx. b ≤ f x) net
  → forward conjD2 goal=48 facts=[47]
    #[50] ∃c. ¬(eventually (λx. c ≤ f x) net)
  elim b goal=48 facts=[49]
    #[51] _VAR b
    #[52] eventually (λx. b ≤ f x) net
    #[53] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b)
  elim c goal=53 facts=[50]
    #[54] _VAR c
    #[55] ¬(eventually (λx. c ≤ f x) net)
    #[56] ¬({b. eventually (λx. b ≤ f x) net} = ∅) ∧ (∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b)
  ← rule conjI goal=56
    #[57] ¬({b. eventually (λx. b ≤ f x) net} = ∅)
    #[58] ∃b. ∀x. x ∈ {b1. eventually (λx1. b1 ≤ f x1) net} ⟶ x ≤ b
  ← rewrite set_equal_iff sym=false goal=57
