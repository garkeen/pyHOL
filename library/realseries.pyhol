  → forward conjD2 goal=42 facts=[44]
    #[45] ¬(∃N. ∀n. n ∈ k ⟶ N ≤ n ⟶ c ≤ a n)
  → rewrite target=fact not_exists sym=false goal=42 facts=[45]
