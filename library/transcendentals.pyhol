theorem sin_eq_minus1
  fixes x :: real
  prop sin x = -1 <--> (?n. integer n & x = (2 * n + 3 / 2) * pi)
  [hint_rewrite]
proof
  cut "∀a::real. !b. a = -b ⟷ -a = b" goal=0
    #[1] ∀a::real. ∀b. a = -b ⟷ -a = b
  ← z3 goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] -(sin x) = 1 ⟷ (∃n. integer n ∧ x = (2 * n + 3 / 2) * pi)
  ← rewrite sin_neg sym=true goal=2
    #[3] sin (-x) = 1 ⟷ (∃n. integer n ∧ x = (2 * n + 3 / 2) * pi)
  ← rewrite sin_eq_1 sym=false goal=3
    #[4] (∃n. integer n ∧ -x = (2 * n + 1 / 2) * pi) ⟷ (∃n. integer n ∧ x = (2 * n + 3 / 2) * pi)
  ← rule iffI goal=4
    #[5] (∃n. integer n ∧ -x = (2 * n + 1 / 2) * pi) ⟶ (∃n. integer n ∧ x = (2 * n + 3 / 2) * pi)
    #[6] (∃n. integer n ∧ x = (2 * n + 3 / 2) * pi) ⟶ (∃n. integer n ∧ -x = (2 * n + 1 / 2) * pi)
  ← intro goal=5
    #[7] ∃n. integer n ∧ -x = (2 * n + 1 / 2) * pi
    #[8] ∃n. integer n ∧ x = (2 * n + 3 / 2) * pi
  elim n goal=8 facts=[7]
    #[9] _VAR n
    #[10] integer n ∧ -x = (2 * n + 1 / 2) * pi
    #[11] ∃n. integer n ∧ x = (2 * n + 3 / 2) * pi
  → forward conjD1 goal=11 facts=[10]
    #[12] integer n
  → forward conjD2 goal=11 facts=[10]
    #[13] -x = (2 * n + 1 / 2) * pi
  ← inst "-(n+1)" goal=11
    #[14] integer (-(n + 1)) ∧ x = (2 * -(n + 1) + 3 / 2) * pi
  ← rule conjI goal=14
    #[15] integer (-(n + 1))
    #[16] x = (2 * -(n + 1) + 3 / 2) * pi
  ← rewrite integer_neg sym=false goal=15
    #[17] integer (n + 1)
  ← rule integer_add goal=17
    #[18] integer 1
  ← rewrite real_one_def sym=false goal=18
    #[19] integer of_nat 1
  ← rewrite integer_def sym=false goal=19
    #[20] ∃n. (abs::real ⇒ real) of_nat 1 = of_nat n
  ← rewrite real_abs_nat sym=false goal=20
    #[21] ∃n. (of_nat::nat ⇒ real) 1 = of_nat n
  ← inst "(1::nat)" goal=21
    #[22] (of_nat::nat ⇒ real) 1 = of_nat 1
  ← rule eq_refl goal=22
    #[23] (of_nat::nat ⇒ real) 1 = of_nat 1
  → rewrite target=fact eq_sym_eq sym=false goal=16 facts=[1]
    #[24] ∀a::real. ∀b. -a = b ⟷ a = -b
  → rewrite target=fact source=prev goal=16 facts=[24,13]
    #[25] x = -((2 * n + 1 / 2) * pi)
  ← rewrite source=prev goal=16 facts=[25]
    #[26] -((2 * n + 1 / 2) * pi) = (2 * -(n + 1) + 3 / 2) * pi
  real_norm goal=26
    #[27] -((2 * n + 1 / 2) * pi) = (2 * -(n + 1) + 3 / 2) * pi
  ← intro goal=6
    #[28] ∃n. integer n ∧ x = (2 * n + 3 / 2) * pi
    #[29] ∃n. integer n ∧ -x = (2 * n + 1 / 2) * pi
  elim n goal=29 facts=[28]
    #[30] integer n ∧ x = (2 * n + 3 / 2) * pi
    #[31] ∃n. integer n ∧ -x = (2 * n + 1 / 2) * pi
  → forward conjD1 goal=31 facts=[30]
    #[32] integer n
  → forward conjD2 goal=31 facts=[30]
    #[33] x = (2 * n + 3 / 2) * pi
  ← inst "-(n+1)" goal=31
    #[34] integer (-(n + 1)) ∧ -x = (2 * -(n + 1) + 1 / 2) * pi
  ← rule conjI goal=34
    #[35] integer (-(n + 1))
    #[36] -x = (2 * -(n + 1) + 1 / 2) * pi
  ← rewrite integer_neg sym=false goal=35
    #[37] integer (n + 1)
  ← rule integer_add goal=37
    #[38] integer 1
  ← rewrite real_one_def sym=false goal=38
    #[39] integer of_nat 1
  ← rewrite integer_def sym=false goal=39
    #[40] ∃n. (abs::real ⇒ real) of_nat 1 = of_nat n
  ← rewrite real_abs_nat sym=false goal=40
    #[41] ∃n. (of_nat::nat ⇒ real) 1 = of_nat n
  ← inst "(1::nat)" goal=41
    #[42] (of_nat::nat ⇒ real) 1 = of_nat 1
  ← rule eq_refl goal=42
  ← rewrite source=prev goal=36 facts=[33]
    #[43] -((2 * n + 3 / 2) * pi) = (2 * -(n + 1) + 1 / 2) * pi
  real_norm goal=43
