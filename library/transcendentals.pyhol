    #[59] (∃n. x = (of_nat n + 1 / 2) * pi) ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = (n + 1 / 2) * pi)
    #[60] (∃n. x = -((of_nat n + 1 / 2) * pi)) ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = (n + 1 / 2) * pi)
