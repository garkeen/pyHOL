    6: real_norm
    7: rewrite_goal_with_prev @6
    7: rewrite_goal real_pow_2 sym=false
    7: cut "!x::real. (2 * (x * x) - 1) * x - 2 * (1 - x * x) * x = 4 * (x * x * x) - 3 * x"
    7: z3
    8: apply_prev @7
  qed

