theorem rpow_mul
  fixes x :: real, y :: real, z :: real
  prop (x * y) ^ z = x ^ z * y ^ z
  [hint_rewrite]
proof
  cut "∀z::real. ∀y. ∀x::real. 0 ≤ x ⟶ 0 ≤ y ⟶ (x * y) ^ z = x ^ z * y ^ z" goal=0
    #[1] ∀z::real. ∀y::real. ∀x. 0 ≤ x ⟶ 0 ≤ y ⟶ (x * y) ^ z = x ^ z * y ^ z
  ← intro "c, b,a" goal=1
    #[2] _VAR c
    #[3] _VAR b
    #[4] _VAR a
    #[5] 0 ≤ a
    #[6] 0 ≤ b
    #[7] (a * b) ^ c = a ^ c * b ^ c
  ← cases "c = 0" goal=7
    #[8] c = 0 ⟶ (a * b) ^ c = a ^ c * b ^ c
    #[9] ¬(c = 0) ⟶ (a * b) ^ c = a ^ c * b ^ c
  ← intro goal=8
    #[10] c = 0
    #[11] (a * b) ^ c = a ^ c * b ^ c
  ← rewrite source=prev goal=11 facts=[10]
    #[12] (a * b) ^ (0::real) = a ^ (0::real) * b ^ (0::real)
  ← rewrite rpow_0 sym=false goal=12
    #[13] (1::real) = 1 * 1
  ← rewrite real_mul_lid sym=false goal=13
    #[14] (1::real) = 1 * 1
  ← intro goal=9
    #[15] ¬(c = 0)
    #[16] (a * b) ^ c = a ^ c * b ^ c
  ← cases "a=0" goal=16
    #[17] a = 0 ⟶ (a * b) ^ c = a ^ c * b ^ c
    #[18] ¬(a = 0) ⟶ (a * b) ^ c = a ^ c * b ^ c
  ← intro goal=17
    #[19] a = 0
    #[20] (a * b) ^ c = a ^ c * b ^ c
  ← rewrite source=prev goal=20 facts=[19]
    #[21] (0 * b) ^ c = 0 ^ c * b ^ c
  ← rewrite real_mul_lzero sym=false goal=21
    #[22] 0 ^ c = 0 ^ c * b ^ c
  ← rewrite rpow_zero sym=false goal=22
    #[23] (if c = 0 then 1 else 0) = (if c = 0 then 1 else 0) * b ^ c
  ← rewrite if_not_P sym=false goal=23 facts=[15]
    #[24] 0 = 0 * b ^ c
  ← rewrite real_mul_lzero sym=false goal=24
    #[25] 0 = 0 * b ^ c
  ← intro goal=18
    #[26] ¬(a = 0)
    #[27] (a * b) ^ c = a ^ c * b ^ c
  ← cases "b=0" goal=27
    #[28] b = 0 ⟶ (a * b) ^ c = a ^ c * b ^ c
    #[29] ¬(b = 0) ⟶ (a * b) ^ c = a ^ c * b ^ c
  ← intro goal=28
    #[30] b = 0
    #[31] (a * b) ^ c = a ^ c * b ^ c
  ← rewrite source=prev goal=31 facts=[30]
    #[32] (a * 0) ^ c = a ^ c * 0 ^ c
  ← rewrite real_mul_rzero sym=false goal=32
    #[33] 0 ^ c = a ^ c * 0 ^ c
  ← rewrite rpow_zero sym=false goal=33
    #[34] (if c = 0 then 1 else 0) = a ^ c * (if c = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=34 facts=[15]
    #[35] 0 = a ^ c * 0
  ← rewrite real_mul_rzero sym=false goal=35
    #[36] 0 = a ^ c * 0
  ← intro goal=29
    #[37] ¬(b = 0)
    #[38] (a * b) ^ c = a ^ c * b ^ c
  ← rewrite real_real_power_def sym=false goal=38
    #[39] (if 0 < a * b then exp (c * log (a * b)) else if a * b = 0 then if c = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-(a * b)))) else exp (c * log (-(a * b)))) = (if 0 < a then exp (c * log a) else if a = 0 then if c = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-a))) else exp (c * log (-a))) * (if 0 < b then exp (c * log b) else if b = 0 then if c = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-b))) else exp (c * log (-b)))
  ← rewrite if_not_P sym=false goal=39 facts=[15]
    #[40] (if 0 < a * b then exp (c * log (a * b)) else if a * b = 0 then 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-(a * b)))) else exp (c * log (-(a * b)))) = (if 0 < a then exp (c * log a) else if a = 0 then 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-a))) else exp (c * log (-a))) * (if 0 < b then exp (c * log b) else if b = 0 then 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-b))) else exp (c * log (-b)))
  cut "~(a * b = 0)" goal=40
    #[41] ¬(a * b = 0)
  ← z3 goal=41 facts=[37,26]
    #[42] ¬(a * b = 0)
  ← rewrite if_not_P sym=false goal=40 facts=[42]
    #[43] (if 0 < a * b then exp (c * log (a * b)) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-(a * b)))) else exp (c * log (-(a * b)))) = (if 0 < a then exp (c * log a) else if a = 0 then 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-a))) else exp (c * log (-a))) * (if 0 < b then exp (c * log b) else if b = 0 then 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-b))) else exp (c * log (-b)))
  ← rewrite if_not_P sym=false goal=43 facts=[26]
    #[44] (if 0 < a * b then exp (c * log (a * b)) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-(a * b)))) else exp (c * log (-(a * b)))) = (if 0 < a then exp (c * log a) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-a))) else exp (c * log (-a))) * (if 0 < b then exp (c * log b) else if b = 0 then 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-b))) else exp (c * log (-b)))
  ← rewrite if_not_P sym=false goal=44 facts=[37]
    #[45] (if 0 < a * b then exp (c * log (a * b)) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-(a * b)))) else exp (c * log (-(a * b)))) = (if 0 < a then exp (c * log a) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-a))) else exp (c * log (-a))) * (if 0 < b then exp (c * log b) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-b))) else exp (c * log (-b)))
  cut "0 < a" goal=45
    #[46] 0 < a
  ← z3 goal=46 facts=[26,5]
    #[47] 0 < a
  cut "0 < b" goal=45
    #[48] 0 < b
  ← z3 goal=48 facts=[37,6]
    #[49] 0 < b
  cut "0 < a * b" goal=45
    #[50] 0 < a * b
  ← rule real_lt_mul goal=50 facts=[47,49]
    #[51] 0 < a * b
  ← rewrite if_P sym=false goal=45 facts=[47]
    #[52] (if 0 < a * b then exp (c * log (a * b)) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-(a * b)))) else exp (c * log (-(a * b)))) = exp (c * log a) * (if 0 < b then exp (c * log b) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-b))) else exp (c * log (-b)))
  ← rewrite if_P sym=false goal=52 facts=[49]
    #[53] (if 0 < a * b then exp (c * log (a * b)) else if ∃m. ∃n. odd m ∧ odd n ∧ abs c = of_nat m / of_nat n then -(exp (c * log (-(a * b)))) else exp (c * log (-(a * b)))) = exp (c * log a) * exp (c * log b)
  ← rewrite if_P sym=false goal=53 facts=[51]
    #[54] exp (c * log (a * b)) = exp (c * log a) * exp (c * log b)
  ← rewrite real_exp_add sym=true goal=54
    #[55] exp (c * log (a * b)) = exp (c * log a + c * log b)
  ← rewrite real_exp_inj sym=false goal=55
    #[56] c * log (a * b) = c * log a + c * log b
  ← rewrite real_mult_comm sym=false goal=56
    #[57] log (a * b) * c = log a * c + log b * c
  ← rewrite real_add_rdistrib sym=true goal=57
    #[58] log (a * b) * c = (log a + log b) * c
  → forward log_mul goal=58 facts=[47,49]
    #[59] log (a * b) = log a + log b
  ← rewrite source=prev goal=58 facts=[59]
    #[60] log (a * b) * c = (log a + log b) * c
  → inst target=fact z goal=0 facts=[1]
    #[61] ∀y::real. ∀x. 0 ≤ x ⟶ 0 ≤ y ⟶ (x * y) ^ z = x ^ z * y ^ z
  → forward real_le_total param_x=x param_y="(0::real)" goal=0
    #[62] x ≤ 0 ∨ 0 ≤ x
  ← rule disjE goal=0 facts=[62]
    #[63] x ≤ 0 ⟶ (x * y) ^ z = x ^ z * y ^ z
    #[64] 0 ≤ x ⟶ (x * y) ^ z = x ^ z * y ^ z
  ← intro goal=63
    #[65] x ≤ 0
    #[66] (x * y) ^ z = x ^ z * y ^ z
  cut "0 <= -x" goal=66
    #[67] 0 ≤ -x
  ← z3 goal=67 facts=[65]
  → forward real_le_total param_x=y param_y="(0::real)" goal=66
    #[68] y ≤ 0 ∨ 0 ≤ y
  ← rule disjE goal=66 facts=[68]
    #[69] y ≤ 0 ⟶ (x * y) ^ z = x ^ z * y ^ z
    #[70] 0 ≤ y ⟶ (x * y) ^ z = x ^ z * y ^ z
  ← intro goal=69
    #[71] y ≤ 0
    #[72] (x * y) ^ z = x ^ z * y ^ z
  cut "0 <= -y" goal=72
    #[73] 0 ≤ -y
  ← z3 goal=73 facts=[71]
    #[74] 0 ≤ -y
  → forward goal=72 facts=[61,67,74]
    #[75] (-x * -y) ^ z = -x ^ z * -y ^ z
  → rewrite target=fact rpow_lneg sym=false goal=72 facts=[75]
    #[76] (-x * -y) ^ z = (if ∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n then -(x ^ z) else x ^ z) * (if ∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n then -(y ^ z) else y ^ z)
  ← cases "∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n" goal=72
    #[77] (∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n) ⟶ (x * y) ^ z = x ^ z * y ^ z
    #[78] ¬(∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n) ⟶ (x * y) ^ z = x ^ z * y ^ z
  ← intro goal=77
    #[79] ∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n
    #[80] (x * y) ^ z = x ^ z * y ^ z
  → rewrite target=fact if_P sym=false goal=80 facts=[76,79]
    #[81] (-x * -y) ^ z = -(x ^ z) * -(y ^ z)
  → rewrite target=fact real_mul_lneg sym=false goal=80 facts=[81]
    #[82] -(x * -y) ^ z = -(x ^ z * -(y ^ z))
  → rewrite target=fact real_mul_rneg sym=false goal=80 facts=[82]
    #[83] --(x * y) ^ z = --(x ^ z * y ^ z)
  → rewrite target=fact real_neg_neg sym=false goal=80 facts=[83]
  ← intro goal=78
    #[84] ¬(∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n)
    #[85] (x * y) ^ z = x ^ z * y ^ z
  → rewrite target=fact if_not_P sym=false goal=85 facts=[76,84]
    #[86] (-x * -y) ^ z = x ^ z * y ^ z
  → rewrite target=fact real_mul_lneg sym=false goal=85 facts=[86]
    #[87] -(x * -y) ^ z = x ^ z * y ^ z
  → rewrite target=fact real_mul_rneg sym=false goal=85 facts=[87]
    #[88] --(x * y) ^ z = x ^ z * y ^ z
  → rewrite target=fact real_neg_neg sym=false goal=85 facts=[88]
  ← intro goal=70
    #[89] 0 ≤ y
    #[90] (x * y) ^ z = x ^ z * y ^ z
  → forward goal=90 facts=[61,67,89]
    #[91] (-x * y) ^ z = -x ^ z * y ^ z
  → rewrite target=fact real_mul_lneg sym=false goal=90 facts=[91]
    #[92] -(x * y) ^ z = -x ^ z * y ^ z
  → rewrite target=fact rpow_lneg sym=false goal=90 facts=[92]
    #[93] (if ∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n then -((x * y) ^ z) else (x * y) ^ z) = (if ∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n then -(x ^ z) else x ^ z) * y ^ z
  ← cases "∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n" goal=90
    #[94] (∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n) ⟶ (x * y) ^ z = x ^ z * y ^ z
    #[95] ¬(∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n) ⟶ (x * y) ^ z = x ^ z * y ^ z
  ← intro goal=94
    #[96] (x * y) ^ z = x ^ z * y ^ z
  → rewrite target=fact if_P sym=false goal=96 facts=[93,79]
    #[97] -((x * y) ^ z) = -(x ^ z) * y ^ z
  → rewrite target=fact real_mul_lneg sym=false goal=96 facts=[97]
    #[98] -((x * y) ^ z) = -(x ^ z * y ^ z)
  → rewrite target=fact real_eq_neg2 sym=false goal=96 facts=[98]
  ← intro goal=95
    #[99] (x * y) ^ z = x ^ z * y ^ z
  → rewrite target=fact if_not_P sym=false goal=99 facts=[93,84]
  ← intro goal=64
