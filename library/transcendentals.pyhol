theorem cos_eq_minus1
  fixes x :: real
  prop cos x = -1 <--> (?n. integer n & x = (2 * n + 1) * pi)
  [hint_rewrite]
proof
  cut "∀a::real. ∀b. a = -b ⟷ -a = b" goal=0
    #[1] ∀a::real. ∀b. a = -b ⟷ -a = b
  ← z3 goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] -(cos x) = 1 ⟷ (∃n. integer n ∧ x = (2 * n + 1) * pi)
  ← rewrite cos_periodic_pi sym=true goal=2
    #[3] cos (x + pi) = 1 ⟷ (∃n. integer n ∧ x = (2 * n + 1) * pi)
  ← rewrite cos_eq_1 sym=false goal=3
    #[4] (∃n. integer n ∧ x + pi = 2 * n * pi) ⟷ (∃n. integer n ∧ x = (2 * n + 1) * pi)
  ← rule iffI goal=4
    #[5] (∃n. integer n ∧ x + pi = 2 * n * pi) ⟶ (∃n. integer n ∧ x = (2 * n + 1) * pi)
    #[6] (∃n. integer n ∧ x = (2 * n + 1) * pi) ⟶ (∃n. integer n ∧ x + pi = 2 * n * pi)
  ← intro goal=5
    #[7] ∃n. integer n ∧ x + pi = 2 * n * pi
    #[8] ∃n. integer n ∧ x = (2 * n + 1) * pi
  elim n goal=8 facts=[7]
    #[9] _VAR n
    #[10] integer n ∧ x + pi = 2 * n * pi
    #[11] ∃n. integer n ∧ x = (2 * n + 1) * pi
  → forward conjD1 goal=11 facts=[10]
    #[12] integer n
  → forward conjD2 goal=11 facts=[10]
    #[13] x + pi = 2 * n * pi
  ← inst n-1 goal=11
    #[14] integer (n - 1) ∧ x = (2 * (n - 1) + 1) * pi
  ← rule conjI goal=14
    #[15] integer (n - 1)
    #[16] x = (2 * (n - 1) + 1) * pi
  ← rule integer_sub goal=15
    #[17] integer 1
  ← rewrite real_one_def sym=false goal=17
    #[18] integer of_nat 1
  ← rewrite integer_def sym=false goal=18
    #[19] ∃n. (abs::real ⇒ real) of_nat 1 = of_nat n
  ← rewrite real_abs_nat sym=false goal=19
    #[20] ∃n. (of_nat::nat ⇒ real) 1 = of_nat n
  ← inst "(1::nat)" goal=20
    #[21] (of_nat::nat ⇒ real) 1 = of_nat 1
  ← rule eq_refl goal=21
    #[22] (of_nat::nat ⇒ real) 1 = of_nat 1
  cut "!p. x + p = 2 * n *p --> x = (2 * (n - 1) + 1) * p" goal=16
    #[23] ∀p. x + p = 2 * n * p ⟶ x = (2 * (n - 1) + 1) * p
  ← z3 goal=23
    #[24] ∀p. x + p = 2 * n * p ⟶ x = (2 * (n - 1) + 1) * p
  ← apply_prev goal=16 facts=[24]
  ← intro goal=6
    #[25] ∃n. integer n ∧ x = (2 * n + 1) * pi
    #[26] ∃n. integer n ∧ x + pi = 2 * n * pi
  elim n goal=26 facts=[25]
    #[27] integer n ∧ x = (2 * n + 1) * pi
    #[28] ∃n. integer n ∧ x + pi = 2 * n * pi
  → forward conjD1 goal=28 facts=[27]
    #[29] integer n
  → forward conjD2 goal=28 facts=[27]
    #[30] x = (2 * n + 1) * pi
  ← inst n+1 goal=28
    #[31] integer (n + 1) ∧ x + pi = 2 * (n + 1) * pi
  ← rule conjI goal=31
    #[32] integer (n + 1)
    #[33] x + pi = 2 * (n + 1) * pi
  ← rule integer_add goal=32
    #[34] integer 1
  ← rewrite real_one_def sym=false goal=34
    #[35] integer of_nat 1
  ← rewrite integer_def sym=false goal=35
    #[36] ∃n. (abs::real ⇒ real) of_nat 1 = of_nat n
  ← rewrite real_abs_nat sym=false goal=36
    #[37] ∃n. (of_nat::nat ⇒ real) 1 = of_nat n
  ← inst "(1::nat)" goal=37
    #[38] (of_nat::nat ⇒ real) 1 = of_nat 1
  ← rule eq_refl goal=38
  ← rewrite source=prev goal=33 facts=[30]
    #[39] (2 * n + 1) * pi + pi = 2 * (n + 1) * pi
  real_norm goal=39
    #[40] (2 * n + 1) * pi + pi = 2 * (n + 1) * pi
qed

theorem sin_eq
  fixes x :: real, y :: real
  prop sin x = sin y <--> (?n. integer n & (x = y + 2 * n * pi | x = -y + (2 * n + 1) * pi))
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] sin x = sin y ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + (2 * n + 1) * pi))
    #[2] (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + (2 * n + 1) * pi)) ⟶ sin x = sin y
  ← intro goal=1
    #[3] sin x = sin y
    #[4] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + (2 * n + 1) * pi)
  → rewrite target=fact real_sub_0 sym=true goal=4 facts=[3]
    #[5] sin x - sin y = 0
  → rewrite target=fact real_sub_sin sym=false goal=4 facts=[5]
    #[6] 2 * sin ((x - y) / 2) * cos ((x + y) / 2) = 0
  → rewrite target=fact real_entire sym=false goal=4 facts=[6]
    #[7] 2 * sin ((x - y) / 2) = 0 ∨ cos ((x + y) / 2) = 0
  ← rule disjE goal=4 facts=[7]
    #[8] 2 * sin ((x - y) / 2) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + (2 * n + 1) * pi))
    #[9] cos ((x + y) / 2) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + (2 * n + 1) * pi))
  ← intro goal=8
    #[10] 2 * sin ((x - y) / 2) = 0
    #[11] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + (2 * n + 1) * pi)
  → rewrite target=fact real_entire sym=false goal=11 facts=[10]
    #[12] (2::real) = 0 ∨ sin ((x - y) / 2) = 0
  ← rule disjE goal=11 facts=[12]
    #[13] (2::real) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + (2 * n + 1) * pi))
    #[14] sin ((x - y) / 2) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + (2 * n + 1) * pi))
  ← intro goal=13
    #[15] (2::real) = 0
