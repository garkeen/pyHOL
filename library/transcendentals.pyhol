    #[13] ¬(x = 0) ⟶ (if x = 0 then if of_nat n = (0::real) then 1 else 0 else if ∃m. ∃n1. odd m ∧ odd n1 ∧ abs (of_nat n) = of_nat m / of_nat n1 then -(exp (of_nat n * log (-x))) else exp (of_nat n * log (-x))) = x ^ n
  ← intro goal=12
