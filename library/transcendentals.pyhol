theorem sin_eq_1
  fixes x :: real
  prop sin x = 1 <--> (?n. integer n & x = (2 * n + 1 / 2) * pi)
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] sin x = 1 ⟶ (∃n. integer n ∧ x = (2 * n + 1 / 2) * pi)
    #[2] (∃n. integer n ∧ x = (2 * n + 1 / 2) * pi) ⟶ sin x = 1
  ← intro goal=1
    #[3] sin x = 1
    #[4] ∃n. integer n ∧ x = (2 * n + 1 / 2) * pi
  → forward sin_circle param_x=x goal=4
    #[5] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact source=prev goal=4 facts=[3,5]
    #[6] 1 ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact real_pow_one sym=false goal=4 facts=[6]
    #[7] 1 + cos x ^ (2::nat) = 1
  → rewrite target=fact real_pow_2 sym=false goal=4 facts=[7]
    #[8] 1 + cos x * cos x = 1
  cut "!a::real. 1+ a* a =1 --> a=0" goal=4
    #[9] ∀a::real. 1 + a * a = 1 ⟶ a = 0
  ← z3 goal=9
    #[10] ∀a::real. 1 + a * a = 1 ⟶ a = 0
  → forward goal=4 facts=[10,8]
    #[11] cos x = 0
  → rewrite target=fact cos_zero_pi sym=false goal=4 facts=[11]
    #[12] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← rule disjE goal=4 facts=[12]
    #[13] (∃n. x = (of_nat n + 1 / 2) * pi) ⟶ (∃n. integer n ∧ x = (2 * n + 1 / 2) * pi)
    #[14] (∃n. x = -((of_nat n + 1 / 2) * pi)) ⟶ (∃n. integer n ∧ x = (2 * n + 1 / 2) * pi)
  ← intro goal=13
    #[15] ∃n. x = (of_nat n + 1 / 2) * pi
    #[16] ∃n. integer n ∧ x = (2 * n + 1 / 2) * pi
  elim n goal=16 facts=[15]
    #[17] _VAR n
    #[18] x = (of_nat n + 1 / 2) * pi
    #[19] ∃n. integer n ∧ x = (2 * n + 1 / 2) * pi
  → forward even_or_odd param_n=n goal=19
    #[20] even n ∨ odd n
  ← rule disjE goal=19 facts=[20]
    #[21] even n ⟶ (∃n1. integer n1 ∧ x = (2 * n1 + 1 / 2) * pi)
    #[22] odd n ⟶ (∃n1. integer n1 ∧ x = (2 * n1 + 1 / 2) * pi)
  ← intro goal=21
