  ← rewrite real_real_power_def sym=false goal=0
    #[1] (if 0 < x then exp (-y * log x) else if x = 0 then if -y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs (-y) = of_nat m / of_nat n then -(exp (-y * log (-x))) else exp (-y * log (-x))) = real_inverse (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← cases "0 < x" goal=1
    #[2] 0 < x ⟶ (if 0 < x then exp (-y * log x) else if x = 0 then if -y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs (-y) = of_nat m / of_nat n then -(exp (-y * log (-x))) else exp (-y * log (-x))) = real_inverse (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
    #[3] ¬(0 < x) ⟶ (if 0 < x then exp (-y * log x) else if x = 0 then if -y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs (-y) = of_nat m / of_nat n then -(exp (-y * log (-x))) else exp (-y * log (-x))) = real_inverse (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← intro goal=2
    #[4] 0 < x
    #[5] (if 0 < x then exp (-y * log x) else if x = 0 then if -y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs (-y) = of_nat m / of_nat n then -(exp (-y * log (-x))) else exp (-y * log (-x))) = real_inverse (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← rewrite if_P sym=false goal=5 facts=[4]
    #[6] exp (-y * log x) = real_inverse (exp (y * log x))
  ← rewrite real_mul_lneg sym=false goal=6
    #[7] exp (-(y * log x)) = real_inverse (exp (y * log x))
  ← rewrite real_exp_neg sym=false goal=7
    #[8] exp (-(y * log x)) = real_inverse (exp (y * log x))
  ← intro goal=3
    #[9] ¬(0 < x)
    #[10] (if 0 < x then exp (-y * log x) else if x = 0 then if -y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs (-y) = of_nat m / of_nat n then -(exp (-y * log (-x))) else exp (-y * log (-x))) = real_inverse (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← rewrite if_not_P sym=false goal=10 facts=[9]
    #[11] (if x = 0 then if -y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs (-y) = of_nat m / of_nat n then -(exp (-y * log (-x))) else exp (-y * log (-x))) = real_inverse (if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← cases "x = 0" goal=11
