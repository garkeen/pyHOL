    #[67] ∃n. (of_nat::nat ⇒ real) n1 = of_nat n
  ← inst n1 goal=67
    #[68] (of_nat::nat ⇒ real) n1 = of_nat n1
  ← rule eq_refl goal=68
    #[69] (of_nat::nat ⇒ real) n1 = of_nat n1
  ← intro goal=60
    #[70] ∃n. x = -((of_nat n + 1 / 2) * pi)
