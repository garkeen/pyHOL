    #[11] x = (n + 1 / 2) * pi
  ← rule disjE goal=9 facts=[10]
    #[12] (∃n1. n = of_nat n1) ⟶ (∃n1. x = (of_nat n1 + 1 / 2) * pi) ∨ (∃n1. x = -((of_nat n1 + 1 / 2) * pi))
    #[13] (∃n1. n = -(of_nat n1)) ⟶ (∃n1. x = (of_nat n1 + 1 / 2) * pi) ∨ (∃n1. x = -((of_nat n1 + 1 / 2) * pi))
  ← intro goal=12
    #[14] ∃n1. n = of_nat n1
