  ← rule disjI2 goal=76
    #[77] ∃n. x = -((of_nat n + 1 / 2) * pi)
  elim n goal=77 facts=[75]
    #[78] (∃m. n = Suc (2 * m)) ∧ x = -(of_nat n * (pi / 2))
    #[79] ∃n. x = -((of_nat n + 1 / 2) * pi)
    #[80] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  → forward conjD1 goal=79 facts=[78]
    #[81] ∃m. n = Suc (2 * m)
  → forward conjD2 goal=79 facts=[78]
    #[82] x = -(of_nat n * (pi / 2))
  elim m goal=79 facts=[81]
    #[83] ∃n. x = -((of_nat n + 1 / 2) * pi)
    #[84] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← inst m goal=83
    #[85] x = -((of_nat m + 1 / 2) * pi)
  ← rewrite source=prev goal=85 facts=[82]
    #[86] -(of_nat n * (pi / 2)) = -((of_nat m + 1 / 2) * pi)
  ← rewrite source=prev goal=86 facts=[66]
    #[87] -(of_nat (Suc (2 * m)) * (pi / 2)) = -((of_nat m + 1 / 2) * pi)
  ← rewrite add_1_right sym=true goal=87
    #[88] -(of_nat (2 * m + 1) * (pi / 2)) = -((of_nat m + 1 / 2) * pi)
  real_norm goal=88
    #[89] -(of_nat (2 * m + 1) * (pi / 2)) = -((of_nat m + 1 / 2) * pi)
qed

theorem cos_one_2pi
  fixes x :: real
  prop cos x = 1 <--> (?n. x = of_nat n * 2 * pi) | (?n. x = -(of_nat n * 2 * pi))
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] cos x = 1 ⟶ (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
    #[2] (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi)) ⟶ cos x = 1
  ← intro goal=1
    #[3] cos x = 1
    #[4] (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
  cut "∀c::real. ∀s. c = 1 ⟶ c * c + s * s = 1 ⟶ s = 0" goal=4
    #[5] ∀c::real. ∀s. c = 1 ⟶ c * c + s * s = 1 ⟶ s = 0
  ← z3 goal=5
    #[6] ∀c::real. ∀s. c = 1 ⟶ c * c + s * s = 1 ⟶ s = 0
  → forward goal=4 facts=[6,3]
    #[7] ∀s. cos x * cos x + s * s = 1 ⟶ s = 0
  → forward sin_circle param_x=x goal=4
    #[8] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact real_add_comm sym=false goal=4 facts=[8]
    #[9] cos x ^ (2::nat) + sin x ^ (2::nat) = 1
  → rewrite target=fact real_pow_2 sym=false goal=4 facts=[9]
    #[10] cos x * cos x + sin x * sin x = 1
  → forward goal=4 facts=[7,10]
    #[11] sin x = 0
  → rewrite target=fact sin_zero_pi sym=false goal=4 facts=[11]
    #[12] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← rule disjE goal=4 facts=[12]
    #[13] (∃n. x = of_nat n * pi) ⟶ (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
    #[14] (∃n. x = -(of_nat n * pi)) ⟶ (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
  ← intro goal=13
    #[15] ∃n. x = of_nat n * pi
    #[16] (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
  ← rule disjI1 goal=16
    #[17] ∃n. x = of_nat n * 2 * pi
  elim n goal=17 facts=[15]
    #[18] _VAR n
    #[19] x = of_nat n * pi
    #[20] ∃n. x = of_nat n * 2 * pi
    #[21] (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
  → rewrite target=fact source=prev goal=20 facts=[19,3]
    #[22] cos (of_nat n * pi) = 1
  → rewrite target=fact cos_npi sym=false goal=20 facts=[22]
    #[23] -(1::real) ^ n = 1
  → rewrite target=fact real_pow_neg sym=false goal=20 facts=[23]
    #[24] (if even n then (1::real) ^ n else -(1 ^ n)) = 1
  ← cases "even n" goal=20
    #[25] even n ⟶ (∃n1. x = of_nat n1 * 2 * pi)
    #[26] ¬(even n) ⟶ (∃n1. x = of_nat n1 * 2 * pi)
  ← intro goal=25
    #[27] even n
    #[28] ∃n. x = of_nat n * 2 * pi
  → rewrite target=fact even_exists sym=false goal=28 facts=[27]
    #[29] ∃m. n = 2 * m
  elim m goal=28 facts=[29]
    #[30] _VAR m
    #[31] n = 2 * m
    #[32] ∃n. x = of_nat n * 2 * pi
  ← inst m goal=32
    #[33] x = of_nat m * 2 * pi
  ← rewrite source=prev goal=33 facts=[19]
    #[34] of_nat n * pi = of_nat m * 2 * pi
  ← rewrite source=prev goal=34 facts=[31]
    #[35] of_nat (2 * m) * pi = of_nat m * 2 * pi
  real_norm goal=35
    #[36] of_nat (2 * m) * pi = of_nat m * 2 * pi
  ← intro goal=26
    #[37] ¬(even n)
    #[38] ∃n. x = of_nat n * 2 * pi
  → rewrite target=fact if_not_P sym=false goal=38 facts=[24,37]
    #[39] -((1::real) ^ n) = 1
  → rewrite target=fact real_pow_one sym=false goal=38 facts=[39]
    #[40] -(1::real) = 1
  ← z3 goal=38 facts=[40]
    #[41] ∃n. x = of_nat n * 2 * pi
  ← intro goal=14
    #[42] ∃n. x = -(of_nat n * pi)
    #[43] (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
  ← rule disjI2 goal=43
    #[44] ∃n. x = -(of_nat n * 2 * pi)
  elim n goal=44 facts=[42]
    #[45] x = -(of_nat n * pi)
    #[46] ∃n. x = -(of_nat n * 2 * pi)
    #[47] (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
  → rewrite target=fact source=prev goal=46 facts=[45,3]
    #[48] cos (-(of_nat n * pi)) = 1
  → rewrite target=fact cos_neg sym=false goal=46 facts=[48]
    #[49] cos (of_nat n * pi) = 1
  → rewrite target=fact cos_npi sym=false goal=46 facts=[49]
    #[50] -(1::real) ^ n = 1
  → rewrite target=fact real_pow_neg sym=false goal=46 facts=[50]
    #[51] (if even n then (1::real) ^ n else -(1 ^ n)) = 1
  ← cases "even n" goal=46
    #[52] even n ⟶ (∃n1. x = -(of_nat n1 * 2 * pi))
    #[53] ¬(even n) ⟶ (∃n1. x = -(of_nat n1 * 2 * pi))
  ← intro goal=52
    #[54] ∃n. x = -(of_nat n * 2 * pi)
  → rewrite target=fact even_exists sym=false goal=54 facts=[27]
  elim m goal=54 facts=[29]
    #[55] ∃n. x = -(of_nat n * 2 * pi)
  ← inst m goal=55
    #[56] x = -(of_nat m * 2 * pi)
  ← rewrite source=prev goal=56 facts=[45]
    #[57] -(of_nat n * pi) = -(of_nat m * 2 * pi)
  ← rewrite source=prev goal=57 facts=[31]
    #[58] -(of_nat (2 * m) * pi) = -(of_nat m * 2 * pi)
  real_norm goal=58
    #[59] -(of_nat (2 * m) * pi) = -(of_nat m * 2 * pi)
  ← intro goal=53
    #[60] ∃n. x = -(of_nat n * 2 * pi)
  → rewrite target=fact if_not_P sym=false goal=60 facts=[51,37]
    #[61] -((1::real) ^ n) = 1
  → rewrite target=fact real_pow_one sym=false goal=60 facts=[61]
    #[62] -(1::real) = 1
  ← z3 goal=60 facts=[62]
    #[63] ∃n. x = -(of_nat n * 2 * pi)
  ← intro goal=2
    #[64] (∃n. x = of_nat n * 2 * pi) ∨ (∃n. x = -(of_nat n * 2 * pi))
    #[65] cos x = 1
  cut "!n. cos (of_nat n * 2 * pi) = 1" goal=65
    #[66] ∀n. cos (of_nat n * 2 * pi) = 1
  ← intro n goal=66
    #[67] cos (of_nat n * 2 * pi) = 1
  ← rewrite real_of_nat_id sym=true goal=67
    #[68] cos (of_nat (of_nat n) * of_nat 2 * pi) = 1
  ← rewrite real_of_nat_mul sym=false goal=68
    #[69] cos (of_nat (of_nat n * 2) * pi) = 1
  ← rewrite cos_npi sym=false goal=69
    #[70] -(1::real) ^ (of_nat n * (2::nat)) = 1
  ← rewrite mult_comm sym=false goal=70
    #[71] -(1::real) ^ ((2::nat) * of_nat n) = 1
  ← rewrite real_pow_pow sym=true goal=71
    #[72] -(1::real) ^ (2::nat) ^ (of_nat::nat ⇒ nat) n = 1
  ← rewrite real_pow2_abs sym=true goal=72
    #[73] abs (-(1::real)) ^ (2::nat) ^ (of_nat::nat ⇒ nat) n = 1
  ← rewrite real_abs_neg sym=false goal=73
    #[74] abs (1::real) ^ (2::nat) ^ (of_nat::nat ⇒ nat) n = 1
  ← rewrite real_pow2_abs sym=false goal=74
    #[75] (1::real) ^ (2::nat) ^ (of_nat::nat ⇒ nat) n = 1
  ← rewrite real_pow_one sym=false goal=75
    #[76] (1::real) ^ (of_nat::nat ⇒ nat) n = 1
  ← rewrite real_pow_one sym=false goal=76
    #[77] (1::real) ^ (of_nat::nat ⇒ nat) n = 1
  ← rule disjE goal=65 facts=[64]
    #[78] (∃n. x = of_nat n * 2 * pi) ⟶ cos x = 1
    #[79] (∃n. x = -(of_nat n * 2 * pi)) ⟶ cos x = 1
  ← intro goal=78
    #[80] ∃n. x = of_nat n * 2 * pi
    #[81] cos x = 1
  elim n goal=81 facts=[80]
    #[82] x = of_nat n * 2 * pi
    #[83] cos x = 1
  ← rewrite source=prev goal=83 facts=[82]
    #[84] cos (of_nat n * 2 * pi) = 1
  ← apply_prev goal=84 facts=[66]
  ← intro goal=79
    #[85] ∃n. x = -(of_nat n * 2 * pi)
    #[86] cos x = 1
  elim n goal=86 facts=[85]
    #[87] x = -(of_nat n * 2 * pi)
    #[88] cos x = 1
  ← rewrite source=prev goal=88 facts=[87]
    #[89] cos (-(of_nat n * 2 * pi)) = 1
  ← rewrite cos_neg sym=false goal=89
    #[90] cos (of_nat n * 2 * pi) = 1
  ← apply_prev goal=90 facts=[66]
qed

theorem sin_cos_sqrt
  fixes x :: real
  prop 0 <= sin x --> sin x = sqrt (1 - cos x ^ (2::nat))
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 ≤ sin x
    #[2] sin x = sqrt (1 - cos x ^ (2::nat))
  ← rewrite eq_sym_eq sym=false goal=2
    #[3] sqrt (1 - cos x ^ (2::nat)) = sin x
  ← rule sqrt_unique goal=3
    #[4] sin x ^ (2::nat) = 1 - cos x ^ (2::nat)
  → forward sin_circle param_x=x goal=4
    #[5] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=4 facts=[5]
    #[6] 1 = sin x ^ (2::nat) + cos x ^ (2::nat)
  ← rewrite source=prev goal=4 facts=[6]
    #[7] sin x ^ (2::nat) = sin x ^ (2::nat) + cos x ^ (2::nat) - cos x ^ (2::nat)
  real_norm goal=7
    #[8] sin x ^ (2::nat) = sin x ^ (2::nat) + cos x ^ (2::nat) - cos x ^ (2::nat)
qed

theorem sin_eq_0_pi
  fixes x :: real
  prop -pi < x --> x < pi --> sin x = 0 --> x = 0
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -pi < x
    #[2] x < pi
    #[3] sin x = 0
    #[4] x = 0
  → rewrite target=fact sin_eq_0 sym=false goal=4 facts=[3]
    #[5] ∃n. integer n ∧ x = n * pi
  → rewrite target=fact real_poly_neg1 sym=false goal=4 facts=[1]
    #[6] -1 * pi < x
  elim n goal=4 facts=[5]
    #[7] _VAR n
    #[8] integer n ∧ x = n * pi
    #[9] x = 0
  → forward conjD1 goal=9 facts=[8]
    #[10] integer n
  → forward conjD2 goal=9 facts=[8]
    #[11] x = n * pi
  ← rewrite source=prev goal=9 facts=[11]
    #[12] n * pi = 0
  ← rewrite real_entire sym=false goal=12
    #[13] n = 0 ∨ pi = 0
  ← rule disjI1 goal=13
    #[14] n = 0
  → forward real_abs_integer_lemma goal=14 facts=[10]
    #[15] ¬(n = 0) ⟶ 1 ≤ abs n
  → rewrite target=fact source=prev goal=14 facts=[11,6]
    #[16] -1 * pi < n * pi
  → rewrite target=fact source=prev goal=14 facts=[11,2]
    #[17] n * pi < pi
  → rewrite target=fact real_mul_lid sym=true goal=14 facts=[17]
    #[18] 1 * (n * pi) < 1 * pi
  → rewrite target=fact real_mult_assoc sym=false goal=14 facts=[18]
    #[19] 1 * n * pi < 1 * pi
  → forward conjI goal=14 facts=[19,16]
    #[20] 1 * n * pi < 1 * pi ∧ -1 * pi < n * pi
  ← rule contrapositive goal=14 facts=[20]
    #[21] ¬(n = 0) ⟶ ¬(1 * n * pi < 1 * pi ∧ -1 * pi < n * pi)
  ← intro goal=21
    #[22] ¬(n = 0)
    #[23] ¬(1 * n * pi < 1 * pi ∧ -1 * pi < n * pi)
  → forward goal=23 facts=[15,22]
    #[24] 1 ≤ abs n
  ← rule contrapositive goal=23 facts=[24]
    #[25] ¬¬(1 * n * pi < 1 * pi ∧ -1 * pi < n * pi) ⟶ ¬(1 ≤ abs n)
  ← rewrite double_neg sym=false goal=25
    #[26] 1 * n * pi < 1 * pi ∧ -1 * pi < n * pi ⟶ ¬(1 ≤ abs n)
  ← intro goal=26
    #[27] 1 * n * pi < 1 * pi ∧ -1 * pi < n * pi
    #[28] ¬(1 ≤ abs n)
  ← rewrite real_not_lt sym=true goal=28
    #[29] ¬¬(abs n < 1)
  ← rewrite double_neg sym=false goal=29
    #[30] abs n < 1
  ← rewrite real_abs_lt sym=false goal=30
    #[31] -1 < n ∧ n < 1
  ← rule conjI goal=31
    #[32] -1 < n
    #[33] n < 1
  → forward conjD1 goal=32 facts=[27]
    #[34] 1 * n * pi < 1 * pi
  → forward conjD2 goal=32 facts=[27]
    #[35] -1 * pi < n * pi
  cut "!p::real. !a. !b. a*p < b * p --> 0 < p --> a < b" goal=32
    #[36] ∀p::real. ∀a. ∀b. a * p < b * p ⟶ 0 < p ⟶ a < b
  ← z3 goal=36
    #[37] ∀p::real. ∀a. ∀b. a * p < b * p ⟶ 0 < p ⟶ a < b
  → forward goal=32 facts=[37,35]
    #[38] 0 < pi ⟶ -1 < n
  ← apply_prev goal=32 facts=[38]
    #[39] 0 < pi
  ← rule pi_pos goal=39
    #[40] 0 < pi
  → forward goal=33 facts=[37,34]
    #[41] 0 < pi ⟶ 1 * n < 1
  → rewrite target=fact real_mul_lid sym=false goal=33 facts=[41]
    #[42] 0 < pi ⟶ n < 1
  ← apply_prev goal=33 facts=[42]
qed

theorem cos_treble_cos
  fixes x :: real
  prop cos (3 * x) = 4 * cos x ^ (3::nat) - 3 * cos x
  [hint_rewrite]
proof
  cut "3 * x = 2 * x + x" goal=0
    #[1] 3 * x = 2 * x + x
  real_norm goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] cos (2 * x + x) = 4 * cos x ^ (3::nat) - 3 * cos x
  ← rewrite cos_add sym=false goal=2
    #[3] cos (2 * x) * cos x - sin (2 * x) * sin x = 4 * cos x ^ (3::nat) - 3 * cos x
  ← rewrite cos_double_cos sym=false goal=3
    #[4] (2 * cos x ^ (2::nat) - 1) * cos x - sin (2 * x) * sin x = 4 * cos x ^ (3::nat) - 3 * cos x
  ← rewrite sin_double sym=false goal=4
    #[5] (2 * cos x ^ (2::nat) - 1) * cos x - 2 * sin x * cos x * sin x = 4 * cos x ^ (3::nat) - 3 * cos x
  cut "2 * sin x * cos x * sin x = 2 * sin x ^ (2::nat) * cos x" goal=5
    #[6] 2 * sin x * cos x * sin x = 2 * sin x ^ (2::nat) * cos x
  real_norm goal=6
  ← rewrite source=prev goal=5 facts=[6]
    #[7] (2 * cos x ^ (2::nat) - 1) * cos x - 2 * sin x ^ (2::nat) * cos x = 4 * cos x ^ (3::nat) - 3 * cos x
  cut "sin x ^ (2::nat) = 1 - cos x ^ (2::nat)" goal=7
    #[8] sin x ^ (2::nat) = 1 - cos x ^ (2::nat)
  → forward sin_circle param_x=x goal=8
    #[9] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=8 facts=[9]
    #[10] 1 = sin x ^ (2::nat) + cos x ^ (2::nat)
  ← rewrite source=prev goal=8 facts=[10]
    #[11] sin x ^ (2::nat) = sin x ^ (2::nat) + cos x ^ (2::nat) - cos x ^ (2::nat)
  real_norm goal=11
  ← rewrite source=prev goal=7 facts=[8]
    #[12] (2 * cos x ^ (2::nat) - 1) * cos x - 2 * (1 - cos x ^ (2::nat)) * cos x = 4 * cos x ^ (3::nat) - 3 * cos x
  cut "cos x ^ (3::nat) = cos x ^ (2::nat) * cos x" goal=12
    #[13] cos x ^ (3::nat) = cos x ^ (2::nat) * cos x
  real_norm goal=13
  ← rewrite source=prev goal=12 facts=[13]
    #[14] (2 * cos x ^ (2::nat) - 1) * cos x - 2 * (1 - cos x ^ (2::nat)) * cos x = 4 * (cos x ^ (2::nat) * cos x) - 3 * cos x
  ← rewrite real_pow_2 sym=false goal=14
    #[15] (2 * (cos x * cos x) - 1) * cos x - 2 * (1 - cos x * cos x) * cos x = 4 * (cos x * cos x * cos x) - 3 * cos x
  cut "!x::real. (2 * (x * x) - 1) * x - 2 * (1 - x * x) * x = 4 * (x * x * x) - 3 * x" goal=15
    #[16] ∀x::real. (2 * (x * x) - 1) * x - 2 * (1 - x * x) * x = 4 * (x * x * x) - 3 * x
  ← z3 goal=16
  ← apply_prev goal=15 facts=[16]
qed

theorem real_cos_pi6
  prop cos (1 / 6 * pi) = sqrt 3 / 2
  [hint_rewrite]
proof
  → forward cos_treble_cos param_x="1 / 6 * pi" goal=0
    #[1] cos (3 * (1 / 6 * pi)) = 4 * cos (1 / 6 * pi) ^ (3::nat) - 3 * cos (1 / 6 * pi)
  cut "3 * (1 / 6 * pi) = pi / 2" goal=0
    #[2] 3 * (1 / 6 * pi) = pi / 2
  real_norm goal=2
  → rewrite target=fact source=prev goal=0 facts=[2,1]
    #[3] cos (pi / 2) = 4 * cos (1 / 6 * pi) ^ (3::nat) - 3 * cos (1 / 6 * pi)
  → rewrite target=fact real_cos_pi2 sym=false goal=0 facts=[3]
    #[4] 0 = 4 * cos (1 / 6 * pi) ^ (3::nat) - 3 * cos (1 / 6 * pi)
  cut "!c::real. 0 = 4 * c ^ (3::nat) - 3 * c <-->\n                         c = 0 | (2 * c) ^ (2::nat) = 3" goal=0
    #[5] ∀c::real. 0 = 4 * c ^ (3::nat) - 3 * c ⟷ c = 0 ∨ (2 * c) ^ (2::nat) = 3
  ← intro c goal=5
    #[6] _VAR c
    #[7] 0 = 4 * c ^ (3::nat) - 3 * c ⟷ c = 0 ∨ (2 * c) ^ (2::nat) = 3
  cut "c ^ (3::nat) = c ^ (2::nat) * c" goal=7
    #[8] c ^ (3::nat) = c ^ (2::nat) * c
  real_norm goal=8
  ← rewrite source=prev goal=7 facts=[8]
    #[9] 0 = 4 * (c ^ (2::nat) * c) - 3 * c ⟷ c = 0 ∨ (2 * c) ^ (2::nat) = 3
  ← rewrite real_pow_2 sym=false goal=9
    #[10] 0 = 4 * (c * c * c) - 3 * c ⟷ c = 0 ∨ 2 * c * (2 * c) = 3
  ← z3 goal=10
  → rewrite target=fact source=prev goal=0 facts=[5,4]
    #[11] cos (1 / 6 * pi) = 0 ∨ (2 * cos (1 / 6 * pi)) ^ (2::nat) = 3
  cut "0 < cos (1 / 6 * pi)" goal=0
    #[12] 0 < cos (1 / 6 * pi)
  ← rule cos_pos_pi2 goal=12
    #[13] 0 < 1 / 6 * pi
    #[14] 1 / 6 * pi < pi / 2
  ← rule real_lt_mul goal=13
    #[15] 0 < 1 / 6
    #[16] 0 < pi
  ← z3 goal=15
  ← rule pi_pos goal=16
  cut "pi / 2 = 1/2 * pi" goal=14
    #[17] pi / 2 = 1 / 2 * pi
  real_norm goal=17
  ← rewrite source=prev goal=14 facts=[17]
    #[18] 1 / 6 * pi < 1 / 2 * pi
  ← rewrite real_mult_comm sym=false goal=18
    #[19] pi * (1 / 6) < pi * (1 / 2)
  ← rule real_lt_lmul: goal=19
    #[20] 1 / 6 < 1 / 2
  ← z3 goal=20
  ← rule disjE goal=0 facts=[11]
    #[21] cos (1 / 6 * pi) = 0 ⟶ cos (1 / 6 * pi) = sqrt 3 / 2
    #[22] (2 * cos (1 / 6 * pi)) ^ (2::nat) = 3 ⟶ cos (1 / 6 * pi) = sqrt 3 / 2
  ← intro goal=21
    #[23] cos (1 / 6 * pi) = 0
    #[24] cos (1 / 6 * pi) = sqrt 3 / 2
  → rewrite target=fact source=prev goal=24 facts=[23,12]
    #[25] (0::real) < 0
  ← z3 goal=24 facts=[25]
  ← intro goal=22
    #[26] (2 * cos (1 / 6 * pi)) ^ (2::nat) = 3
    #[27] cos (1 / 6 * pi) = sqrt 3 / 2
  → rewrite target=fact sqrt_inj sym=true goal=27 facts=[26]
    #[28] sqrt ((2 * cos (1 / 6 * pi)) ^ (2::nat)) = sqrt 3
  → rewrite target=fact pow_2_sqrt_abs sym=false goal=27 facts=[28]
    #[29] abs (2 * cos (1 / 6 * pi)) = sqrt 3
  → rewrite target=fact real_abs_mul sym=false goal=27 facts=[29]
    #[30] abs 2 * abs (cos (1 / 6 * pi)) = sqrt 3
  → rewrite target=fact real_abs_nat sym=false goal=27 facts=[30]
    #[31] 2 * abs (cos (1 / 6 * pi)) = sqrt 3
  → rewrite target=fact abs_def sym=false goal=27 facts=[31]
    #[32] 2 * (if 0 ≤ cos (1 / 6 * pi) then cos (1 / 6 * pi) else -(cos (1 / 6 * pi))) = sqrt 3
  cut "0 ≤ cos (1 / 6 * pi)" goal=27 facts=[32]
    #[33] 0 ≤ cos (1 / 6 * pi)
  ← rule real_lt_imp_le goal=33
  → rewrite target=fact if_P sym=false goal=27 facts=[32,33]
    #[34] 2 * cos (1 / 6 * pi) = sqrt 3
  → rewrite target=fact eq_sym_eq sym=false goal=27 facts=[34]
    #[35] sqrt 3 = 2 * cos (1 / 6 * pi)
  ← rewrite source=prev goal=27 facts=[35]
    #[36] cos (1 / 6 * pi) = 2 * cos (1 / 6 * pi) / 2
  real_norm goal=36
    #[37] cos (1 / 6 * pi) = 2 * cos (1 / 6 * pi) / 2
qed

theorem real_sin_pi6
  prop sin (1 / 6 * pi) = 1 / 2
  [hint_rewrite]
proof
  → forward sin_circle param_x="1 / 6 * pi" goal=0
    #[1] sin (1 / 6 * pi) ^ (2::nat) + cos (1 / 6 * pi) ^ (2::nat) = 1
  → rewrite target=fact real_cos_pi6 sym=false goal=0 facts=[1]
    #[2] sin (1 / 6 * pi) ^ (2::nat) + (sqrt 3 / 2) ^ (2::nat) = 1
  → rewrite target=fact real_pow_div sym=false goal=0 facts=[2]
    #[3] sin (1 / 6 * pi) ^ (2::nat) + sqrt 3 ^ (2::nat) / 2 ^ (2::nat) = 1
  → rewrite target=fact sqrt_works_gen_2 sym=false goal=0 facts=[3]
    #[4] sin (1 / 6 * pi) ^ (2::nat) + abs 3 / 2 ^ (2::nat) = 1
  → rewrite target=fact real_abs_nat sym=false goal=0 facts=[4]
    #[5] sin (1 / 6 * pi) ^ (2::nat) + 3 / 2 ^ (2::nat) = 1
  cut "∀s. 0 < s ⟶ s ^ (2::nat) + 3 / 2 ^ (2::nat) = 1 ⟶ s = 1 / 2" goal=0
    #[6] ∀s. 0 < s ⟶ s ^ (2::nat) + 3 / 2 ^ (2::nat) = 1 ⟶ s = 1 / 2
  ← intro s goal=6
    #[7] _VAR s
    #[8] 0 < s
    #[9] s ^ (2::nat) + 3 / 2 ^ (2::nat) = 1
    #[10] s = 1 / 2
  → rewrite target=fact real_pow_2 sym=false goal=10 facts=[9]
    #[11] s * s + 3 / (2 * 2) = 1
  ← z3 goal=10 facts=[8,11]
  ← apply_prev goal=0 facts=[6]
    #[12] 0 < sin (1 / 6 * pi)
  ← rule sin_pos_pi goal=12
    #[13] 0 < 1 / 6 * pi
    #[14] 1 / 6 * pi < pi
  ← rule real_lt_mul goal=13
    #[15] 0 < 1 / 6
    #[16] 0 < pi
  ← z3 goal=15
  ← rule pi_pos goal=16
  ← rewrite real_mul_lid sym=true goal=14
    #[17] 1 * (1 / 6 * pi) < 1 * pi
  ← rewrite real_mult_assoc sym=false goal=17
    #[18] 1 * (1 / 6) * pi < 1 * pi
  ← rewrite real_mult_comm sym=false goal=18
    #[19] pi * (1 * (1 / 6)) < pi * 1
  ← rule real_lt_lmul: goal=19
    #[20] 1 * (1 / 6) < 1
  ← z3 goal=20
qed

theorem sin_pos_pi_rev
  fixes x :: real
  prop 0 <= x --> x <= 2 * pi --> 0 < sin x --> 0 < x & x < pi
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ 2 * pi
    #[3] 0 < sin x
    #[4] 0 < x ∧ x < pi
  ← cases "x = 0" goal=4
    #[5] x = 0 ⟶ 0 < x ∧ x < pi
    #[6] ¬(x = 0) ⟶ 0 < x ∧ x < pi
  ← intro goal=5
    #[7] x = 0
    #[8] 0 < x ∧ x < pi
  → rewrite target=fact source=prev goal=8 facts=[7,3]
    #[9] 0 < sin 0
  → rewrite target=fact real_sin_0 sym=false goal=8 facts=[9]
    #[10] (0::real) < 0
  ← z3 goal=8 facts=[10]
    #[11] 0 < x ∧ x < pi
  ← intro goal=6
    #[12] ¬(x = 0)
    #[13] 0 < x ∧ x < pi
  ← cases "x = pi" goal=13
    #[14] x = pi ⟶ 0 < x ∧ x < pi
    #[15] ¬(x = pi) ⟶ 0 < x ∧ x < pi
  ← intro goal=14
    #[16] x = pi
    #[17] 0 < x ∧ x < pi
  → rewrite target=fact source=prev goal=17 facts=[16,3]
    #[18] 0 < sin pi
  → rewrite target=fact real_sin_pi sym=false goal=17 facts=[18]
    #[19] (0::real) < 0
  ← z3 goal=17 facts=[19]
    #[20] 0 < x ∧ x < pi
  ← intro goal=15
    #[21] ¬(x = pi)
    #[22] 0 < x ∧ x < pi
  ← cases "x = 2 * pi" goal=22
    #[23] x = 2 * pi ⟶ 0 < x ∧ x < pi
    #[24] ¬(x = 2 * pi) ⟶ 0 < x ∧ x < pi
  ← intro goal=23
    #[25] x = 2 * pi
    #[26] 0 < x ∧ x < pi
  → rewrite target=fact source=prev goal=26 facts=[25,3]
    #[27] 0 < sin (2 * pi)
  → rewrite target=fact sin_npi sym=false goal=26 facts=[27]
    #[28] (0::real) < 0
  ← z3 goal=26 facts=[28]
    #[29] 0 < x ∧ x < pi
  ← intro goal=24
    #[30] ¬(x = 2 * pi)
    #[31] 0 < x ∧ x < pi
  ← rewrite real_less_def sym=false goal=31
    #[32] ¬(x ≤ 0) ∧ ¬(pi ≤ x)
  ← rule contrapositive goal=32 facts=[3]
    #[33] ¬(¬(x ≤ 0) ∧ ¬(pi ≤ x)) ⟶ ¬(0 < sin x)
  ← intro goal=33
    #[34] ¬(¬(x ≤ 0) ∧ ¬(pi ≤ x))
    #[35] ¬(0 < sin x)
  → rewrite target=fact de_morgan_thm1 sym=false goal=35 facts=[34]
    #[36] ¬¬(x ≤ 0) ∨ ¬¬(pi ≤ x)
  → rewrite target=fact double_neg sym=false goal=35 facts=[36]
    #[37] x ≤ 0 ∨ pi ≤ x
  ← rule disjE goal=35 facts=[37]
    #[38] x ≤ 0 ⟶ ¬(0 < sin x)
    #[39] pi ≤ x ⟶ ¬(0 < sin x)
  ← intro goal=38
    #[40] x ≤ 0
    #[41] ¬(0 < sin x)
  ← z3 goal=41 facts=[1,12,40]
    #[42] ¬(0 < sin x)
  ← intro goal=39
    #[43] pi ≤ x
    #[44] ¬(0 < sin x)
  cut "0 < sin(2 * pi - x)" goal=44
    #[45] 0 < sin (2 * pi - x)
  ← rule sin_pos_pi goal=45
    #[46] 0 < 2 * pi - x
    #[47] 2 * pi - x < pi
  cut "!p::real. 0 < p --> ~(x = p) --> p <= x --> ~(x = 2 * p) --> x <= 2 * p --> 0 < 2 * p - x" goal=46
    #[48] ∀p. 0 < p ⟶ ¬(x = p) ⟶ p ≤ x ⟶ ¬(x = 2 * p) ⟶ x ≤ 2 * p ⟶ 0 < 2 * p - x
  ← z3 goal=48
    #[49] ∀p. 0 < p ⟶ ¬(x = p) ⟶ p ≤ x ⟶ ¬(x = 2 * p) ⟶ x ≤ 2 * p ⟶ 0 < 2 * p - x
  ← apply_prev goal=46 facts=[49]
    #[50] 0 < pi
  ← rule pi_pos goal=50
    #[51] 0 < pi
  cut "!p::real. 0 < p --> ~(x = p) --> p <= x --> ~(x = 2 * p) --> x <= 2 * p --> 2 * p - x < p" goal=47
    #[52] ∀p. 0 < p ⟶ ¬(x = p) ⟶ p ≤ x ⟶ ¬(x = 2 * p) ⟶ x ≤ 2 * p ⟶ 2 * p - x < p
  ← z3 goal=52
    #[53] ∀p. 0 < p ⟶ ¬(x = p) ⟶ p ≤ x ⟶ ¬(x = 2 * p) ⟶ x ≤ 2 * p ⟶ 2 * p - x < p
  ← apply_prev goal=47 facts=[53]
  ← rule contrapositive goal=44 facts=[45]
    #[54] ¬¬(0 < sin x) ⟶ ¬(0 < sin (2 * pi - x))
  ← rewrite double_neg sym=false goal=54
    #[55] 0 < sin x ⟶ ¬(0 < sin (2 * pi - x))
  ← rewrite real_not_lt sym=false goal=55
    #[56] 0 < sin x ⟶ sin (2 * pi - x) ≤ 0
  ← rewrite sin_sub sym=false goal=56
    #[57] 0 < sin x ⟶ sin (2 * pi) * cos x - cos (2 * pi) * sin x ≤ 0
  ← intro goal=57
    #[58] sin (2 * pi) * cos x - cos (2 * pi) * sin x ≤ 0
  ← rewrite sin_npi sym=false goal=58
    #[59] 0 * cos x - cos (2 * pi) * sin x ≤ 0
  ← rewrite real_mul_lzero sym=false goal=59
    #[60] 0 - cos (2 * pi) * sin x ≤ 0
  ← rewrite cos_npi sym=false goal=60
    #[61] 0 - -1 ^ bit0 1 * sin x ≤ 0
  ← rewrite real_pow_neg sym=false goal=61
    #[62] 0 - (if even (bit0 1) then 1 ^ bit0 1 else -(1 ^ bit0 1)) * sin x ≤ 0
  cut "even (bit0 1)" goal=62
    #[63] even (bit0 1)
  ← rewrite even_exists sym=false goal=63
    #[64] ∃m. bit0 1 = 2 * m
  ← inst "(1::nat)" goal=64
    #[65] bit0 1 = 2 * 1
  ← rewrite mult_2 sym=false goal=65
    #[66] bit0 1 = 1 + 1
  ← rewrite bit0_def sym="" goal=66
    #[67] bit0 1 = 1 + 1
  ← rewrite if_P sym=false goal=62 facts=[63]
    #[68] 0 - 1 ^ bit0 1 * sin x ≤ 0
  ← rewrite real_pow_one sym=false goal=68
    #[69] 0 - 1 * sin x ≤ 0
  ← rewrite real_mul_lid sym=false goal=69
    #[70] 0 - sin x ≤ 0
  cut "!a::real. 0 < a --> 0 - a <= 0" goal=70
    #[71] ∀a::real. 0 < a ⟶ 0 - a ≤ 0
  ← z3 goal=71
    #[72] ∀a::real. 0 < a ⟶ 0 - a ≤ 0
  ← apply_prev goal=70 facts=[72]
qed

theorem real_sin_pi3
  prop sin (1 / 3 * pi) = sqrt 3 / 2
  [hint_rewrite]
proof
  cut "1 / 3 * pi = 2 * (1 / 6 * pi)" goal=0
    #[1] 1 / 3 * pi = 2 * (1 / 6 * pi)
  real_norm goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] sin (2 * (1 / 6 * pi)) = sqrt 3 / 2
  ← rewrite sin_double sym=false goal=2
    #[3] 2 * sin (1 / 6 * pi) * cos (1 / 6 * pi) = sqrt 3 / 2
  ← rewrite real_cos_pi6 sym=false goal=3
    #[4] 2 * sin (1 / 6 * pi) * (sqrt 3 / 2) = sqrt 3 / 2
  ← rewrite real_sin_pi6 sym=false goal=4
    #[5] 2 * (1 / 2) * (sqrt 3 / 2) = sqrt 3 / 2
  real_norm goal=5
qed

theorem real_cos_pi3
  prop cos (1 / 3 * pi) = 1 / 2
  [hint_rewrite]
proof
  cut "1 / 3 * pi = 2 * (1 / 6 * pi)" goal=0
    #[1] 1 / 3 * pi = 2 * (1 / 6 * pi)
  real_norm goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] cos (2 * (1 / 6 * pi)) = 1 / 2
  ← rewrite cos_double_cos sym=false goal=2
    #[3] 2 * cos (1 / 6 * pi) ^ (2::nat) - 1 = 1 / 2
  ← rewrite real_cos_pi6 sym=false goal=3
    #[4] 2 * (sqrt 3 / 2) ^ (2::nat) - 1 = 1 / 2
  ← rewrite real_pow_div sym=false goal=4
    #[5] 2 * (sqrt 3 ^ (2::nat) / 2 ^ (2::nat)) - 1 = 1 / 2
  ← rewrite sqrt_works_gen_2 sym=false goal=5
    #[6] 2 * (abs 3 / 2 ^ (2::nat)) - 1 = 1 / 2
  ← rewrite real_abs_nat sym=false goal=6
    #[7] 2 * (3 / 2 ^ (2::nat)) - 1 = 1 / 2
  real_norm goal=7
qed

theorem sin_total_pos
  fixes y :: real
  prop 0 <= y --> y <= 1 --> (?x. 0 <= x & x <= pi / 2 & sin x = y)
  [hint_backward,hint_backward1]

theorem sincos_total_pi2
  fixes x :: real, y :: real
  prop 0 <= x --> 0 <= y --> x ^ (2::nat) + y ^ (2::nat) = 1 --> (?t. 0 <= t & t <= pi / 2 & x = cos t & y = sin t)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ y
    #[3] x ^ (2::nat) + y ^ (2::nat) = 1
    #[4] ∃t. 0 ≤ t ∧ t ≤ pi / 2 ∧ x = cos t ∧ y = sin t
  → forward sin_total_pos param_y=y goal=4
    #[5] 0 ≤ y ⟶ y ≤ 1 ⟶ (∃x. 0 ≤ x ∧ x ≤ pi / 2 ∧ sin x = y)
  → forward goal=4 facts=[5,2]
    #[6] y ≤ 1 ⟶ (∃x. 0 ≤ x ∧ x ≤ pi / 2 ∧ sin x = y)
  cut "y ≤ 1" goal=4
    #[7] y ≤ 1
  ← rule contrapositive goal=7 facts=[3]
    #[8] ¬(y ≤ 1) ⟶ ¬(x ^ (2::nat) + y ^ (2::nat) = 1)
  ← rewrite real_not_lt sym=true goal=8
    #[9] ¬¬(1 < y) ⟶ ¬(x ^ (2::nat) + y ^ (2::nat) = 1)
  ← rewrite double_neg sym=false goal=9
    #[10] 1 < y ⟶ ¬(x ^ (2::nat) + y ^ (2::nat) = 1)
  ← intro goal=10
    #[11] 1 < y
    #[12] ¬(x ^ (2::nat) + y ^ (2::nat) = 1)
  ← rewrite real_pow_2 sym=false goal=12
    #[13] ¬(x * x + y * y = 1)
  ← z3 goal=13 facts=[11]
    #[14] ¬(x * x + y * y = 1)
  → forward goal=4 facts=[6,7]
    #[15] ∃x. 0 ≤ x ∧ x ≤ pi / 2 ∧ sin x = y
  elim t goal=4 facts=[15]
    #[16] _VAR t
    #[17] 0 ≤ t ∧ t ≤ pi / 2 ∧ sin t = y
    #[18] ∃t. 0 ≤ t ∧ t ≤ pi / 2 ∧ x = cos t ∧ y = sin t
  → forward conjD1 goal=18 facts=[17]
    #[19] 0 ≤ t
  → forward conjD2 goal=18 facts=[17]
    #[20] t ≤ pi / 2 ∧ sin t = y
  → forward conjD1 goal=18 facts=[20]
    #[21] t ≤ pi / 2
  → forward conjD2 goal=18 facts=[20]
    #[22] sin t = y
  ← inst t goal=18
    #[23] 0 ≤ t ∧ t ≤ pi / 2 ∧ x = cos t ∧ y = sin t
  ← rule conjI goal=23
    #[24] t ≤ pi / 2 ∧ x = cos t ∧ y = sin t
  ← rule conjI goal=24
    #[25] x = cos t ∧ y = sin t
  ← rule conjI goal=25
    #[26] x = cos t
    #[27] y = sin t
  cut "x = cos t | x = -cos t" goal=26
    #[28] x = cos t ∨ x = -(cos t)
  → forward sin_circle param_x=t goal=28
    #[29] sin t ^ (2::nat) + cos t ^ (2::nat) = 1
  → rewrite target=fact source=prev goal=28 facts=[22,29]
    #[30] y ^ (2::nat) + cos t ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=28 facts=[3]
    #[31] 1 = x ^ (2::nat) + y ^ (2::nat)
  → rewrite target=fact source=prev goal=28 facts=[31,30]
    #[32] y ^ (2::nat) + cos t ^ (2::nat) = x ^ (2::nat) + y ^ (2::nat)
  cut "∀a::real. ∀b. ∀c. a + b ^ (2::nat) = c ^ (2::nat) + a ⟷ (c = b | c = -b)" goal=28
    #[33] ∀a::real. ∀b. ∀c. a + b ^ (2::nat) = c ^ (2::nat) + a ⟷ c = b ∨ c = -b
  ← intro a,b,c goal=33
    #[34] _VAR a
    #[35] _VAR b
    #[36] _VAR c
    #[37] a + b ^ (2::nat) = c ^ (2::nat) + a ⟷ c = b ∨ c = -b
  ← rewrite real_pow_2 sym=false goal=37
    #[38] a + b * b = c * c + a ⟷ c = b ∨ c = -b
  ← z3 goal=38
    #[39] a + b * b = c * c + a ⟷ c = b ∨ c = -b
  → rewrite target=fact source=prev goal=28 facts=[33,32]
  ← rule disjE goal=26 facts=[28]
    #[40] x = cos t ⟶ x = cos t
    #[41] x = -(cos t) ⟶ x = cos t
  ← intro goal=41
    #[42] x = -(cos t)
    #[43] x = cos t
  → rewrite target=fact source=prev goal=43 facts=[42,1]
    #[44] 0 ≤ -(cos t)
  → rewrite target=fact real_le_lt sym=false goal=43 facts=[44]
    #[45] 0 < -(cos t) ∨ 0 = -(cos t)
  ← rule disjE goal=43 facts=[45]
    #[46] 0 < -(cos t) ⟶ x = cos t
    #[47] 0 = -(cos t) ⟶ x = cos t
  ← intro goal=46
    #[48] 0 < -(cos t)
    #[49] x = cos t
  ← rule contrapositive goal=49 facts=[48]
    #[50] ¬(x = cos t) ⟶ ¬(0 < -(cos t))
  ← intro goal=50
    #[51] ¬(x = cos t)
    #[52] ¬(0 < -(cos t))
  ← rewrite real_not_lt sym=false goal=52
    #[53] -(cos t) ≤ 0
  ← rewrite real_le_lneg sym=false goal=53
    #[54] 0 ≤ cos t + 0
  ← rewrite real_add_rid sym=false goal=54
    #[55] 0 ≤ cos t
  ← rule cos_pos_pi_le goal=55
    #[56] -(pi / 2) ≤ t
  ← rule real_le_trans param_y="(0::real)" goal=56
    #[57] -(pi / 2) ≤ 0
  ← rewrite real_le_lneg sym=false goal=57
    #[58] 0 ≤ pi / 2 + 0
  ← rewrite real_add_rid sym=false goal=58
    #[59] 0 ≤ pi / 2
  ← rule real_lt_imp_le goal=59
    #[60] 0 < pi / 2
  ← rewrite real_divide_def sym=false goal=60
    #[61] 0 < pi * real_inverse 2
  ← rule real_lt_mul goal=61
    #[62] 0 < pi
    #[63] 0 < real_inverse 2
  ← rule pi_pos goal=62
    #[64] 0 < pi
  ← z3 goal=63
    #[65] 0 < real_inverse 2
  ← intro goal=47
    #[66] 0 = -(cos t)
    #[67] x = cos t
  ← rewrite source=prev goal=67 facts=[42]
    #[68] -(cos t) = cos t
  cut "!a::real. 0 = -a --> -a = a" goal=68
    #[69] ∀a::real. 0 = -a ⟶ -a = a
  ← z3 goal=69
    #[70] ∀a::real. 0 = -a ⟶ -a = a
  ← apply_prev goal=68 facts=[70]
  ← rewrite eq_sym_eq sym=false goal=27
qed

theorem sincos_total_pi
  fixes x :: real, y :: real
  prop 0 <= y --> x ^ (2::nat) + y ^ (2::nat) = 1 --> (?t. 0 <= t & t <= pi & x = cos t & y = sin t)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ y
    #[2] x ^ (2::nat) + y ^ (2::nat) = 1
    #[3] ∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t
  cut "0 <= x | 0 <= -x" goal=3
    #[4] 0 ≤ x ∨ 0 ≤ -x
  ← rule real_le_negtotal goal=4
    #[5] 0 ≤ x ∨ 0 ≤ -x
  ← rule disjE goal=3 facts=[5]
    #[6] 0 ≤ x ⟶ (∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t)
    #[7] 0 ≤ -x ⟶ (∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t)
  ← intro goal=6
    #[8] 0 ≤ x
    #[9] ∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t
  → forward sincos_total_pi2 goal=9 facts=[8,1,2]
    #[10] ∃t. 0 ≤ t ∧ t ≤ pi / 2 ∧ x = cos t ∧ y = sin t
  elim t goal=9 facts=[10]
    #[11] _VAR t
    #[12] 0 ≤ t ∧ t ≤ pi / 2 ∧ x = cos t ∧ y = sin t
    #[13] ∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t
  → forward conjD1 goal=13 facts=[12]
    #[14] 0 ≤ t
  → forward conjD2 goal=13 facts=[12]
    #[15] t ≤ pi / 2 ∧ x = cos t ∧ y = sin t
  → forward conjD1 goal=13 facts=[15]
    #[16] t ≤ pi / 2
  → forward conjD2 goal=13 facts=[15]
    #[17] x = cos t ∧ y = sin t
  → forward conjD2 goal=17 facts=[15]
  ← inst t goal=13
    #[18] 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t
  ← rule conjI goal=18
    #[19] t ≤ pi ∧ x = cos t ∧ y = sin t
  ← rule conjI goal=19
    #[20] t ≤ pi
  cut "!p. 0 < p --> t <= p / 2 --> t <= p " goal=20
    #[21] ∀p. 0 < p ⟶ t ≤ p / 2 ⟶ t ≤ p
  ← z3 goal=21
    #[22] ∀p. 0 < p ⟶ t ≤ p / 2 ⟶ t ≤ p
  ← apply_prev goal=20 facts=[22]
    #[23] 0 < pi
  ← rule pi_pos goal=23
    #[24] 0 < pi
  ← intro goal=7
    #[25] 0 ≤ -x
    #[26] ∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t
  → forward sincos_total_pi2 goal=26 facts=[25,1]
    #[27] -x ^ (2::nat) + y ^ (2::nat) = 1 ⟶ (∃t. 0 ≤ t ∧ t ≤ pi / 2 ∧ -x = cos t ∧ y = sin t)
  → rewrite target=fact real_pow_neg sym=false goal=26 facts=[27]
    #[28] (if even 2 then x ^ (2::nat) else -(x ^ (2::nat))) + y ^ (2::nat) = 1 ⟶ (∃t. 0 ≤ t ∧ t ≤ pi / 2 ∧ -x = cos t ∧ y = sin t)
  cut "even 2" goal=26
    #[29] even 2
  ← rewrite even_exists sym=false goal=29
    #[30] ∃m::nat. 2 = 2 * m
  ← inst "(1::nat)" goal=30
    #[31] (2::nat) = 2 * 1
  ← rewrite mult_1_right sym=false goal=31
    #[32] (2::nat) = 2 * 1
  → rewrite target=fact if_P sym=false goal=26 facts=[28,29]
    #[33] x ^ (2::nat) + y ^ (2::nat) = 1 ⟶ (∃t. 0 ≤ t ∧ t ≤ pi / 2 ∧ -x = cos t ∧ y = sin t)
  → forward goal=26 facts=[33,2]
    #[34] ∃t. 0 ≤ t ∧ t ≤ pi / 2 ∧ -x = cos t ∧ y = sin t
  elim t goal=26 facts=[34]
    #[35] 0 ≤ t ∧ t ≤ pi / 2 ∧ -x = cos t ∧ y = sin t
    #[36] ∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t
  → forward conjD1 goal=36 facts=[35]
    #[37] 0 ≤ t
  → forward conjD2 goal=36 facts=[35]
    #[38] t ≤ pi / 2 ∧ -x = cos t ∧ y = sin t
  → forward conjD1 goal=36 facts=[38]
    #[39] t ≤ pi / 2
  → forward conjD2 goal=36 facts=[38]
    #[40] -x = cos t ∧ y = sin t
  → forward conjD1 goal=36 facts=[40]
    #[41] -x = cos t
  → forward conjD1 goal=41 facts=[40]
  → forward conjD2 goal=36 facts=[40]
    #[42] y = sin t
  ← inst "pi - t" goal=36
    #[43] 0 ≤ pi - t ∧ pi - t ≤ pi ∧ x = cos (pi - t) ∧ y = sin (pi - t)
  ← rule conjI goal=43
    #[44] 0 ≤ pi - t
    #[45] pi - t ≤ pi ∧ x = cos (pi - t) ∧ y = sin (pi - t)
  cut "!p. 0 < p --> t <= p/2 --> 0 <= p - t" goal=44
    #[46] ∀p. 0 < p ⟶ t ≤ p / 2 ⟶ 0 ≤ p - t
  ← z3 goal=46
    #[47] ∀p. 0 < p ⟶ t ≤ p / 2 ⟶ 0 ≤ p - t
  ← apply_prev goal=44 facts=[47]
    #[48] 0 < pi
  ← rule pi_pos goal=48
  ← rule conjI goal=45
    #[49] pi - t ≤ pi
    #[50] x = cos (pi - t) ∧ y = sin (pi - t)
  cut "∀p. 0 < p ⟶ 0 ≤ t ⟶ p - t ≤ p" goal=49
    #[51] ∀p. 0 < p ⟶ 0 ≤ t ⟶ p - t ≤ p
  ← z3 goal=51
    #[52] ∀p. 0 < p ⟶ 0 ≤ t ⟶ p - t ≤ p
  ← apply_prev goal=49 facts=[52]
  ← rewrite cos_sub sym=false goal=50
    #[53] x = cos pi * cos t + sin pi * sin t ∧ y = sin (pi - t)
  ← rewrite sin_sub sym=false goal=53
    #[54] x = cos pi * cos t + sin pi * sin t ∧ y = sin pi * cos t - cos pi * sin t
  ← rewrite real_sin_pi sym=false goal=54
    #[55] x = cos pi * cos t + 0 * sin t ∧ y = 0 * cos t - cos pi * sin t
  ← rewrite real_cos_pi sym=false goal=55
    #[56] x = -1 * cos t + 0 * sin t ∧ y = 0 * cos t - -1 * sin t
  ← rewrite real_mul_lzero sym=false goal=56
    #[57] x = -1 * cos t + 0 ∧ y = 0 - -1 * sin t
  ← rewrite real_add_rid sym=false goal=57
    #[58] x = -1 * cos t ∧ y = 0 - -1 * sin t
  ← rewrite real_minus_def sym=false goal=58
    #[59] x = -1 * cos t ∧ y = 0 + -(-1 * sin t)
  ← rewrite real_add_lid sym=false goal=59
    #[60] x = -1 * cos t ∧ y = -(-1 * sin t)
  ← rewrite real_mul_lneg sym=false goal=60
    #[61] x = -(1 * cos t) ∧ y = --(1 * sin t)
  ← rewrite real_mul_lid sym=false goal=61
    #[62] x = -(cos t) ∧ y = --(sin t)
  ← rewrite real_neg_neg sym=false goal=62
    #[63] x = -(cos t) ∧ y = sin t
  ← rule conjI goal=63
    #[64] x = -(cos t)
  → rewrite target=fact eq_sym_eq sym=false goal=64 facts=[41]
    #[65] cos t = -x
  ← rewrite source=prev goal=64 facts=[65]
    #[66] x = --x
  ← rewrite real_neg_neg sym=false goal=66
    #[67] x = --x
qed

theorem sincos_total_2pi
  fixes x :: real, y :: real
  prop x ^ (2::nat) + y ^ (2::nat) = 1 --> (?t. 0 <= t & t < 2 * pi & x = cos t & y = sin t)
  [hint_backward]
proof
  ← intro goal=0
    #[1] x ^ (2::nat) + y ^ (2::nat) = 1
    #[2] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  → rewrite target=fact real_pow_2 sym=false goal=2 facts=[1]
    #[3] x * x + y * y = 1
  ← cases "x=1" goal=2
    #[4] x = 1 ⟶ (∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t)
    #[5] ¬(x = 1) ⟶ (∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t)
  ← intro goal=4
    #[6] x = 1
    #[7] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  ← cases "y=0" goal=7
    #[8] y = 0 ⟶ (∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t)
    #[9] ¬(y = 0) ⟶ (∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t)
  ← intro goal=8
    #[10] y = 0
    #[11] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  ← inst "(0::real)" goal=11
    #[12] (0::real) ≤ 0 ∧ 0 < 2 * pi ∧ x = cos 0 ∧ y = sin 0
  ← rule conjI goal=12
    #[13] (0::real) ≤ 0
    #[14] 0 < 2 * pi ∧ x = cos 0 ∧ y = sin 0
  ← rule real_le_refl goal=13
    #[15] (0::real) ≤ 0
  ← rule conjI goal=14
    #[16] 0 < 2 * pi
    #[17] x = cos 0 ∧ y = sin 0
  ← rule real_lt_mul goal=16
    #[18] (0::real) < 2
    #[19] 0 < pi
  ← z3 goal=18
    #[20] (0::real) < 2
  ← rule pi_pos goal=19
    #[21] 0 < pi
  ← rule conjI goal=17
    #[22] x = cos 0
    #[23] y = sin 0
  ← rewrite real_cos_0 sym=false goal=22
  ← rewrite real_sin_0 sym=false goal=23
  ← intro goal=9
    #[24] ¬(y = 0)
    #[25] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  ← z3 goal=25 facts=[24,6,3]
  ← intro goal=5
    #[26] ¬(x = 1)
    #[27] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  ← cases "y=0" goal=27
    #[28] y = 0 ⟶ (∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t)
    #[29] ¬(y = 0) ⟶ (∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t)
  ← intro goal=28
    #[30] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  cut "x=-1" goal=30 facts=[3]
    #[31] x = -1
  ← z3 goal=31 facts=[26,10,3]
  ← inst pi goal=30
    #[32] 0 ≤ pi ∧ pi < 2 * pi ∧ x = cos pi ∧ y = sin pi
  ← rule conjI goal=32
    #[33] 0 ≤ pi
    #[34] pi < 2 * pi ∧ x = cos pi ∧ y = sin pi
  ← rule real_lt_imp_le goal=33
    #[35] 0 < pi
  ← rule pi_pos goal=35
  ← rule conjI goal=34
    #[36] pi < 2 * pi
    #[37] x = cos pi ∧ y = sin pi
  ← rewrite real_mul_lid sym=true goal=36
    #[38] 1 * pi < 1 * (2 * pi)
  ← rewrite real_mult_assoc sym=false goal=38
    #[39] 1 * pi < 1 * 2 * pi
  ← rewrite real_mult_comm sym=false goal=39
    #[40] pi * 1 < pi * (1 * 2)
  ← rule real_lt_lmul: goal=40
    #[41] (1::real) < 1 * 2
  ← z3 goal=41
    #[42] (1::real) < 1 * 2
  ← rule conjI goal=37
    #[43] x = cos pi
    #[44] y = sin pi
  ← rewrite real_cos_pi sym=false goal=43
  ← rewrite real_sin_pi sym=false goal=44
  ← intro goal=29
    #[45] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  cut "0 <= y | 0 <= -y" goal=45
    #[46] 0 ≤ y ∨ 0 ≤ -y
  ← rule real_le_negtotal goal=46
    #[47] 0 ≤ y ∨ 0 ≤ -y
  ← rule disjE goal=45 facts=[47]
    #[48] 0 ≤ y ⟶ (∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t)
    #[49] 0 ≤ -y ⟶ (∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t)
  ← intro goal=48
    #[50] 0 ≤ y
    #[51] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  → forward sincos_total_pi goal=51 facts=[50,1]
    #[52] ∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t
  elim t goal=51 facts=[52]
    #[53] _VAR t
    #[54] 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ y = sin t
    #[55] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  ← inst t goal=55
    #[56] 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  → forward conjD1 goal=56 facts=[54]
    #[57] 0 ≤ t
  → forward conjD2 goal=56 facts=[54]
    #[58] t ≤ pi ∧ x = cos t ∧ y = sin t
  → forward conjD1 goal=56 facts=[58]
    #[59] t ≤ pi
  → forward conjD2 goal=56 facts=[58]
    #[60] x = cos t ∧ y = sin t
  ← rule conjI goal=56
    #[61] t < 2 * pi ∧ x = cos t ∧ y = sin t
  ← rule conjI goal=61
    #[62] t < 2 * pi
  cut "∀p. 0 < p ⟶ t ≤ p ⟶ t < 2 * p" goal=62
    #[63] ∀p. 0 < p ⟶ t ≤ p ⟶ t < 2 * p
  ← z3 goal=63
    #[64] ∀p. 0 < p ⟶ t ≤ p ⟶ t < 2 * p
  ← apply_prev goal=62 facts=[64]
    #[65] 0 < pi
  ← rule pi_pos goal=65
  ← intro goal=49
    #[66] 0 ≤ -y
    #[67] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  → forward sincos_total_pi param_x=x goal=67 facts=[66]
    #[68] x ^ (2::nat) + -y ^ (2::nat) = 1 ⟶ (∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ -y = sin t)
  → rewrite target=fact real_pow_neg sym=false goal=67 facts=[68]
    #[69] x ^ (2::nat) + (if even 2 then y ^ (2::nat) else -(y ^ (2::nat))) = 1 ⟶ (∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ -y = sin t)
  cut "even 2" goal=67
    #[70] even 2
  ← rewrite even_exists sym=false goal=70
    #[71] ∃m::nat. 2 = 2 * m
  ← inst "(1::nat)" goal=71
    #[72] (2::nat) = 2 * 1
  ← rewrite mult_1_right sym=false goal=72
    #[73] (2::nat) = 2 * 1
  → rewrite target=fact if_P sym=false goal=67 facts=[69,70]
    #[74] x ^ (2::nat) + y ^ (2::nat) = 1 ⟶ (∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ -y = sin t)
  → forward goal=67 facts=[74,1]
    #[75] ∃t. 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ -y = sin t
  elim t goal=67 facts=[75]
    #[76] 0 ≤ t ∧ t ≤ pi ∧ x = cos t ∧ -y = sin t
    #[77] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  ← inst "2 * pi - t" goal=77
    #[78] 0 ≤ 2 * pi - t ∧ 2 * pi - t < 2 * pi ∧ x = cos (2 * pi - t) ∧ y = sin (2 * pi - t)
  → forward conjD1 goal=78 facts=[76]
    #[79] 0 ≤ t
  → forward conjD2 goal=78 facts=[76]
    #[80] t ≤ pi ∧ x = cos t ∧ -y = sin t
  → forward conjD1 goal=78 facts=[80]
    #[81] t ≤ pi
  → forward conjD2 goal=78 facts=[80]
    #[82] x = cos t ∧ -y = sin t
  → forward conjD1 goal=78 facts=[82]
    #[83] x = cos t
  → forward conjD2 goal=78 facts=[82]
    #[84] -y = sin t
  ← rule conjI goal=78
    #[85] 0 ≤ 2 * pi - t
    #[86] 2 * pi - t < 2 * pi ∧ x = cos (2 * pi - t) ∧ y = sin (2 * pi - t)
  cut "!p. 0 < p --> t <= p --> 0 <= 2 * p - t" goal=85
    #[87] ∀p. 0 < p ⟶ t ≤ p ⟶ 0 ≤ 2 * p - t
  ← z3 goal=87
    #[88] ∀p. 0 < p ⟶ t ≤ p ⟶ 0 ≤ 2 * p - t
  ← apply_prev goal=85 facts=[88]
    #[89] 0 < pi
  ← rule pi_pos goal=89
  ← rule conjI goal=86
    #[90] 2 * pi - t < 2 * pi
    #[91] x = cos (2 * pi - t) ∧ y = sin (2 * pi - t)
  cut "!p. 0 < t --> p -t <p" goal=90
    #[92] ∀p. 0 < t ⟶ p - t < p
  ← z3 goal=92
    #[93] ∀p. 0 < t ⟶ p - t < p
  ← apply_prev goal=90 facts=[93]
    #[94] 0 < t
  ← rewrite real_lt_le sym=false goal=94
    #[95] 0 ≤ t ∧ ¬(0 = t)
  ← rule conjI goal=95
    #[96] ¬(0 = t)
  ← rule contrapositive goal=96 facts=[24]
    #[97] ¬¬(0 = t) ⟶ ¬¬(y = 0)
  ← rewrite double_neg sym=false goal=97
    #[98] 0 = t ⟶ y = 0
  ← intro goal=98
    #[99] 0 = t
    #[100] y = 0
  → rewrite target=fact eq_sym_eq sym=false goal=100 facts=[99]
    #[101] t = 0
  → rewrite target=fact source=prev goal=100 facts=[101,84]
    #[102] -y = sin 0
  → rewrite target=fact real_sin_0 sym=false goal=100 facts=[102]
    #[103] -y = 0
  ← z3 goal=100 facts=[103]
    #[104] y = 0
  ← rewrite sin_sub sym=false goal=91
    #[105] x = cos (2 * pi - t) ∧ y = sin (2 * pi) * cos t - cos (2 * pi) * sin t
  ← rewrite cos_sub sym=false goal=105
    #[106] x = cos (2 * pi) * cos t + sin (2 * pi) * sin t ∧ y = sin (2 * pi) * cos t - cos (2 * pi) * sin t
  ← rewrite cos_npi sym=false goal=106
    #[107] x = -1 ^ bit0 1 * cos t + sin (2 * pi) * sin t ∧ y = sin (2 * pi) * cos t - -1 ^ bit0 1 * sin t
  ← rewrite sin_npi sym=false goal=107
    #[108] x = -1 ^ bit0 1 * cos t + 0 * sin t ∧ y = 0 * cos t - -1 ^ bit0 1 * sin t
  ← rewrite real_mul_lzero sym=false goal=108
    #[109] x = -1 ^ bit0 1 * cos t + 0 ∧ y = 0 - -1 ^ bit0 1 * sin t
  ← rewrite real_add_rid sym=false goal=109
    #[110] x = -1 ^ bit0 1 * cos t ∧ y = 0 - -1 ^ bit0 1 * sin t
  ← rewrite real_minus_def sym=false goal=110
    #[111] x = -1 ^ bit0 1 * cos t ∧ y = 0 + -(-1 ^ bit0 1 * sin t)
  ← rewrite real_add_lid sym=false goal=111
    #[112] x = -1 ^ bit0 1 * cos t ∧ y = -(-1 ^ bit0 1 * sin t)
  ← rewrite real_pow_neg sym=false goal=112
    #[113] x = (if even (bit0 1) then 1 ^ bit0 1 else -(1 ^ bit0 1)) * cos t ∧ y = -((if even (bit0 1) then 1 ^ bit0 1 else -(1 ^ bit0 1)) * sin t)
  cut "even (bit0 1)" goal=113
    #[114] even (bit0 1)
  ← rewrite even_exists sym=false goal=114
    #[115] ∃m. bit0 1 = 2 * m
  ← inst "(1::nat)" goal=115
    #[116] bit0 1 = 2 * 1
  ← rewrite mult_2 sym=false goal=116
    #[117] bit0 1 = 1 + 1
  ← rewrite bit0_def sym="" goal=117
    #[118] bit0 1 = 1 + 1
  ← rewrite if_P sym=false goal=113 facts=[114]
    #[119] x = 1 ^ bit0 1 * cos t ∧ y = -(1 ^ bit0 1 * sin t)
  ← rewrite real_pow_one sym=false goal=119
    #[120] x = 1 * cos t ∧ y = -(1 * sin t)
  ← rewrite real_mul_lid sym=false goal=120
    #[121] x = cos t ∧ y = -(sin t)
  ← rule conjI goal=121
    #[122] y = -(sin t)
  → rewrite target=fact eq_sym_eq sym=false goal=122 facts=[84]
    #[123] sin t = -y
  ← rewrite source=prev goal=122 facts=[123]
    #[124] y = --y
  ← rewrite real_neg_neg sym=false goal=124
    #[125] y = --y
qed

theorem circle_sincos
  fixes x :: real, y :: real
  prop x ^ (2::nat) + y ^ (2::nat) = 1 --> (?t. x = cos t & y = sin t)
  [hint_backward]
proof
  ← intro goal=0
    #[1] x ^ (2::nat) + y ^ (2::nat) = 1
    #[2] ∃t. x = cos t ∧ y = sin t
  → forward sincos_total_2pi goal=2 facts=[1]
    #[3] ∃t. 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
  elim t goal=2 facts=[3]
    #[4] _VAR t
    #[5] 0 ≤ t ∧ t < 2 * pi ∧ x = cos t ∧ y = sin t
    #[6] ∃t. x = cos t ∧ y = sin t
  ← inst t goal=6
    #[7] x = cos t ∧ y = sin t
  → forward conjD2 goal=7 facts=[5]
    #[8] t < 2 * pi ∧ x = cos t ∧ y = sin t
  ← rule conjD2 goal=7 facts=[8]
    #[9] x = cos t ∧ y = sin t
qed

theorem sin_integer_2pi
  fixes n :: real
  prop integer n --> sin (2 * pi * n) = 0
  [hint_backward]
proof
  ← intro goal=0
    #[1] integer n
    #[2] sin (2 * pi * n) = 0
  cut "2 * pi * n = 2 * n * pi" goal=2
    #[3] 2 * pi * n = 2 * n * pi
  real_norm goal=3
    #[4] 2 * pi * n = 2 * n * pi
  ← rewrite source=prev goal=2 facts=[4]
    #[5] sin (2 * n * pi) = 0
  ← rewrite sin_pimul_eq_0 sym=false goal=5
    #[6] integer (2 * n)
  ← rewrite real_mul_2 sym=false goal=6
    #[7] integer (n + n)
  ← rule integer_add goal=7
qed

theorem sin_integer_pi
  fixes n :: real
  prop integer n --> sin (n * pi) = 0
  [hint_backward]
proof
  ← intro goal=0
    #[1] integer n
    #[2] sin (n * pi) = 0
  ← rewrite sin_pimul_eq_0 sym=false goal=2
qed

theorem cos_integer_2pi
  fixes n :: real
  prop integer n --> cos (2 * pi * n) = 1
  [hint_backward]
proof
  ← intro goal=0
    #[1] integer n
    #[2] cos (2 * pi * n) = 1
  ← rewrite cos_one_2pi sym=false goal=2
    #[3] (∃n1. 2 * pi * n = of_nat n1 * 2 * pi) ∨ (∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi))
  → rewrite target=fact integer_cases sym=false goal=3 facts=[1]
    #[4] (∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))
  ← rule disjE goal=3 facts=[4]
    #[5] (∃n1. n = of_nat n1) ⟶ (∃n1. 2 * pi * n = of_nat n1 * 2 * pi) ∨ (∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi))
    #[6] (∃n1. n = -(of_nat n1)) ⟶ (∃n1. 2 * pi * n = of_nat n1 * 2 * pi) ∨ (∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi))
  ← intro goal=5
    #[7] ∃n1. n = of_nat n1
    #[8] (∃n1. 2 * pi * n = of_nat n1 * 2 * pi) ∨ (∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi))
  ← rule disjI1 goal=8
    #[9] ∃n1. 2 * pi * n = of_nat n1 * 2 * pi
  elim m goal=9 facts=[7]
    #[10] _VAR m
    #[11] n = of_nat m
    #[12] ∃n1. 2 * pi * n = of_nat n1 * 2 * pi
    #[13] (∃n1. 2 * pi * n = of_nat n1 * 2 * pi) ∨ (∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi))
  ← inst m goal=12
    #[14] 2 * pi * n = of_nat m * 2 * pi
  ← rewrite source=prev goal=14 facts=[11]
    #[15] 2 * pi * of_nat m = of_nat m * 2 * pi
  real_norm goal=15
    #[16] 2 * pi * of_nat m = of_nat m * 2 * pi
  ← intro goal=6
    #[17] ∃n1. n = -(of_nat n1)
    #[18] (∃n1. 2 * pi * n = of_nat n1 * 2 * pi) ∨ (∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi))
  ← rule disjI2 goal=18
    #[19] ∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi)
  elim m goal=19 facts=[17]
    #[20] n = -(of_nat m)
    #[21] ∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi)
    #[22] (∃n1. 2 * pi * n = of_nat n1 * 2 * pi) ∨ (∃n1. 2 * pi * n = -(of_nat n1 * 2 * pi))
  ← inst m goal=21
    #[23] 2 * pi * n = -(of_nat m * 2 * pi)
  ← rewrite source=prev goal=23 facts=[20]
    #[24] 2 * pi * -(of_nat m) = -(of_nat m * 2 * pi)
  real_norm goal=24
    #[25] 2 * pi * -(of_nat m) = -(of_nat m * 2 * pi)
qed

theorem sincos_principal_value
  fixes x :: real
  prop ?y. (-pi < y & y <= pi) & sin y = sin x & cos y = cos x
  [hint_backward]

theorem sin_cos_eq
  fixes x :: real, y :: real
  prop sin y = sin x & cos y = cos x <--> (?n. integer n & y = x + 2 * n * pi)
  [hint_rewrite]

theorem sin_cos_inj
  fixes x :: real, y :: real
  prop sin x = sin y --> cos x = cos y --> abs (x - y) < 2 * pi --> x = y
  [hint_backward,hint_backward1]

theorem cos_eq_1
  fixes x :: real
  prop cos x = 1 <--> (?n. integer n & x = 2 * n * pi)
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] cos x = 1 ⟶ (∃n. integer n ∧ x = 2 * n * pi)
    #[2] (∃n. integer n ∧ x = 2 * n * pi) ⟶ cos x = 1
  ← intro goal=1
    #[3] cos x = 1
    #[4] ∃n. integer n ∧ x = 2 * n * pi
  → forward sin_circle param_x=x goal=4
    #[5] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact source=prev goal=4 facts=[3,5]
    #[6] sin x ^ (2::nat) + 1 ^ (2::nat) = 1
  → rewrite target=fact real_pow_one sym=false goal=4 facts=[6]
    #[7] sin x ^ (2::nat) + 1 = 1
  → rewrite target=fact real_pow_2 sym=false goal=4 facts=[7]
    #[8] sin x * sin x + 1 = 1
  cut "!a::real. a * a +1 =1 --> a = 0" goal=4
    #[9] ∀a::real. a * a + 1 = 1 ⟶ a = 0
  ← z3 goal=9
    #[10] ∀a::real. a * a + 1 = 1 ⟶ a = 0
  → forward goal=4 facts=[10,8]
    #[11] sin x = 0
  → rewrite target=fact sin_eq_0 sym=false goal=4 facts=[11]
    #[12] ∃n. integer n ∧ x = n * pi
  elim n goal=4 facts=[12]
    #[13] _VAR n
    #[14] integer n ∧ x = n * pi
    #[15] ∃n. integer n ∧ x = 2 * n * pi
  → forward conjD1 goal=15 facts=[14]
    #[16] integer n
  → forward conjD2 goal=15 facts=[14]
    #[17] x = n * pi
  → rewrite target=fact integer_cases sym=false goal=15 facts=[16]
    #[18] (∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))
  ← rewrite integer_cases sym=false goal=15
    #[19] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  ← rule disjE goal=19 facts=[18]
    #[20] (∃n1. n = of_nat n1) ⟶ (∃n1. ((∃n2. n1 = of_nat n2) ∨ (∃n2. n1 = -(of_nat n2))) ∧ x = 2 * n1 * pi)
    #[21] (∃n1. n = -(of_nat n1)) ⟶ (∃n1. ((∃n2. n1 = of_nat n2) ∨ (∃n2. n1 = -(of_nat n2))) ∧ x = 2 * n1 * pi)
  ← intro goal=20
    #[22] ∃n1. n = of_nat n1
    #[23] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  elim m goal=23 facts=[22]
    #[24] _VAR m
    #[25] n = of_nat m
    #[26] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  → forward even_or_odd param_n=m goal=26
    #[27] even m ∨ odd m
  ← rule disjE goal=26 facts=[27]
    #[28] even m ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi)
    #[29] odd m ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi)
  ← intro goal=28
    #[30] even m
    #[31] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  → rewrite target=fact even_exists sym=false goal=31 facts=[30]
    #[32] ∃m1. m = 2 * m1
  elim m1 goal=31 facts=[32]
    #[33] _VAR m1
    #[34] m = 2 * m1
    #[35] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  ← inst "(of_nat::nat⇒real) m1" goal=35
    #[36] ((∃n. (of_nat::nat ⇒ real) m1 = of_nat n) ∨ (∃n. (of_nat::nat ⇒ real) m1 = -(of_nat n))) ∧ x = 2 * of_nat m1 * pi
  ← rule conjI goal=36
    #[37] (∃n. (of_nat::nat ⇒ real) m1 = of_nat n) ∨ (∃n. (of_nat::nat ⇒ real) m1 = -(of_nat n))
    #[38] x = 2 * of_nat m1 * pi
  ← rule disjI1 goal=37
    #[39] ∃n. (of_nat::nat ⇒ real) m1 = of_nat n
  ← inst m1 goal=39
    #[40] (of_nat::nat ⇒ real) m1 = of_nat m1
  ← rule eq_refl goal=40
    #[41] (of_nat::nat ⇒ real) m1 = of_nat m1
  ← rewrite source=prev goal=38 facts=[17]
    #[42] n * pi = 2 * of_nat m1 * pi
  ← rewrite source=prev goal=42 facts=[25]
    #[43] of_nat m * pi = 2 * of_nat m1 * pi
  ← rewrite source=prev goal=43 facts=[34]
    #[44] of_nat (2 * m1) * pi = 2 * of_nat m1 * pi
  real_norm goal=44
    #[45] of_nat (2 * m1) * pi = 2 * of_nat m1 * pi
  ← intro goal=29
    #[46] odd m
    #[47] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  ← rule contrapositive goal=47 facts=[3]
    #[48] ¬(∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi) ⟶ ¬(cos x = 1)
  ← intro goal=48
    #[49] ¬(∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi)
    #[50] ¬(cos x = 1)
  ← rewrite source=prev goal=50 facts=[17]
    #[51] ¬(cos (n * pi) = 1)
  ← rewrite source=prev goal=51 facts=[25]
    #[52] ¬(cos (of_nat m * pi) = 1)
  ← rewrite cos_npi sym=false goal=52
    #[53] ¬(-(1::real) ^ m = 1)
  ← rewrite real_pow_neg sym=false goal=53
    #[54] ¬((if even m then (1::real) ^ m else -(1 ^ m)) = 1)
  → rewrite target=fact not_even sym=true goal=54 facts=[46]
    #[55] ¬(even m)
  ← rewrite if_not_P sym=false goal=54 facts=[55]
    #[56] ¬(-((1::real) ^ m) = 1)
  ← rewrite real_pow_one sym=false goal=56
    #[57] ¬(-(1::real) = 1)
  nat_const_ineq goal=57
    #[58] ¬(-(1::real) = 1)
  ← intro goal=21
    #[59] ∃n1. n = -(of_nat n1)
    #[60] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  elim m goal=60 facts=[59]
    #[61] n = -(of_nat m)
    #[62] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  → forward even_or_odd param_n=m goal=62
  ← rule disjE goal=62 facts=[27]
    #[63] even m ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi)
    #[64] odd m ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi)
  ← intro goal=63
    #[65] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  → rewrite target=fact even_exists sym=false goal=65 facts=[30]
  elim m1 goal=65 facts=[32]
    #[66] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  ← inst "-(of_nat::nat⇒real) m1" goal=66
    #[67] ((∃n. -(of_nat m1) = of_nat n) ∨ (∃n. -(of_nat m1) = -(of_nat n))) ∧ x = 2 * -(of_nat m1) * pi
  ← rule conjI goal=67
    #[68] (∃n. -(of_nat m1) = of_nat n) ∨ (∃n. -(of_nat m1) = -(of_nat n))
    #[69] x = 2 * -(of_nat m1) * pi
  ← rule disjI2 goal=68
    #[70] ∃n. -(of_nat m1) = -(of_nat n)
  ← inst m1 goal=70
    #[71] -(of_nat m1) = -(of_nat m1)
  ← rule eq_refl goal=71
    #[72] -(of_nat m1) = -(of_nat m1)
  ← rewrite source=prev goal=69 facts=[17]
    #[73] n * pi = 2 * -(of_nat m1) * pi
  ← rewrite source=prev goal=73 facts=[61]
    #[74] -(of_nat m) * pi = 2 * -(of_nat m1) * pi
  ← rewrite source=prev goal=74 facts=[34]
    #[75] -(of_nat (2 * m1)) * pi = 2 * -(of_nat m1) * pi
  real_norm goal=75
    #[76] -(of_nat (2 * m1)) * pi = 2 * -(of_nat m1) * pi
  ← intro goal=64
    #[77] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi
  ← rule contrapositive goal=77 facts=[3]
    #[78] ¬(∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = 2 * n * pi) ⟶ ¬(cos x = 1)
  ← intro goal=78
    #[79] ¬(cos x = 1)
  ← rewrite source=prev goal=79 facts=[17]
    #[80] ¬(cos (n * pi) = 1)
  ← rewrite source=prev goal=80 facts=[61]
    #[81] ¬(cos (-(of_nat m) * pi) = 1)
  ← rewrite real_mul_lneg sym=false goal=81
    #[82] ¬(cos (-(of_nat m * pi)) = 1)
  ← rewrite cos_neg sym=false goal=82
    #[83] ¬(cos (of_nat m * pi) = 1)
  ← rewrite cos_npi sym=false goal=83
    #[84] ¬(-(1::real) ^ m = 1)
  ← rewrite real_pow_neg sym=false goal=84
    #[85] ¬((if even m then (1::real) ^ m else -(1 ^ m)) = 1)
  → rewrite target=fact not_even sym=true goal=85 facts=[46]
  ← rewrite if_not_P sym=false goal=85 facts=[55]
    #[86] ¬(-((1::real) ^ m) = 1)
  ← rewrite real_pow_one sym=false goal=86
    #[87] ¬(-(1::real) = 1)
  nat_const_ineq goal=87
  ← intro goal=2
    #[88] ∃n. integer n ∧ x = 2 * n * pi
    #[89] cos x = 1
  elim n goal=89 facts=[88]
    #[90] integer n ∧ x = 2 * n * pi
    #[91] cos x = 1
  → forward conjD2 goal=91 facts=[90]
    #[92] x = 2 * n * pi
  ← rewrite source=prev goal=91 facts=[92]
    #[93] cos (2 * n * pi) = 1
  → forward conjD1 goal=93 facts=[90]
    #[94] integer n
  → rewrite target=fact integer_cases sym=false goal=93 facts=[94]
    #[95] (∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))
  ← rule disjE goal=93 facts=[95]
    #[96] (∃n1. n = of_nat n1) ⟶ cos (2 * n * pi) = 1
    #[97] (∃n1. n = -(of_nat n1)) ⟶ cos (2 * n * pi) = 1
  ← intro goal=96
    #[98] cos (2 * n * pi) = 1
  elim m goal=98 facts=[22]
    #[99] cos (2 * n * pi) = 1
  ← rewrite source=prev goal=99 facts=[25]
    #[100] cos (2 * of_nat m * pi) = 1
  ← rewrite cos_one_2pi sym=false goal=100
    #[101] (∃n. 2 * of_nat m * pi = of_nat n * 2 * pi) ∨ (∃n. 2 * of_nat m * pi = -(of_nat n * 2 * pi))
  ← rule disjI1 goal=101
