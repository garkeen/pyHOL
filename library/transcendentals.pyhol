def root :: nat ⇒ real ⇒ real = root n x = real_sgn x * exp (log (abs x) / of_nat n) [hint_rewrite]

theorem root_0
  fixes n :: nat
  prop root n 0 = 0
  [hint_rewrite]
proof
  ← rewrite root_def sym=false goal=0
    #[1] real_sgn 0 * exp (log (abs 0) / of_nat n) = 0
  ← rewrite real_sgn_0 sym=false goal=1
    #[2] 0 * exp (log (abs 0) / of_nat n) = 0
  ← rewrite real_mul_lzero sym=false goal=2
qed

theorem root_1
  fixes n :: nat
  prop root n 1 = 1
  [hint_rewrite]
proof
  ← rewrite root_def sym=false goal=0
    #[1] real_sgn 1 * exp (log (abs 1) / of_nat n) = 1
  ← rewrite real_one_def sym=false goal=1
    #[2] real_sgn of_nat 1 * exp (log (abs of_nat 1) / of_nat n) = of_nat 1
  ← rewrite real_abs_nat sym=false goal=2
    #[3] real_sgn of_nat 1 * exp (log of_nat 1 / of_nat n) = of_nat 1
  ← rewrite real_one_def sym=true goal=3
    #[4] real_sgn 1 * exp (log 1 / of_nat n) = 1
  ← rewrite log_1 sym=false goal=4
    #[5] real_sgn 1 * exp (0 / of_nat n) = 1
  ← rewrite real_divide_def sym=false goal=5
    #[6] real_sgn 1 * exp (0 * real_inverse (of_nat n)) = 1
  ← rewrite real_mul_lzero sym=false goal=6
    #[7] real_sgn 1 * exp 0 = 1
  ← rewrite real_sgn_def sym=false goal=7
    #[8] (if (0::real) < 1 then 1 else if (1::real) < 0 then -1 else 0) * exp 0 = 1
  ← rewrite real_exp_0 sym=false goal=8
    #[9] (if (0::real) < 1 then (1::real) else if (1::real) < 0 then -1 else 0) * 1 = 1
  ← z3 goal=9
qed

theorem root_2
  fixes x :: real
  prop root 2 x = sqrt x
  [hint_rewrite]
proof
  ← rewrite eq_sym_eq sym=false goal=0
    #[1] sqrt x = root 2 x
  ← rule sqrt_unique_gen goal=1
    #[2] real_sgn (root 2 x) = real_sgn x
    #[3] root 2 x ^ (2::nat) = abs x
  ← rewrite root_def sym=false goal=2
    #[4] real_sgn (real_sgn x * exp (log (abs x) / of_nat 2)) = real_sgn x
  ← rewrite real_sgn_mul sym=false goal=4
    #[5] real_sgn (real_sgn x) * real_sgn (exp (log (abs x) / of_nat 2)) = real_sgn x
  ← rewrite real_sgn_real_sgn sym=false goal=5
    #[6] real_sgn x * real_sgn (exp (log (abs x) / of_nat 2)) = real_sgn x
  cut "real_sgn (exp (log (abs x) / of_nat 2)) = 1" goal=6
    #[7] real_sgn (exp (log (abs x) / of_nat 2)) = 1
  ← rewrite real_sgn_eq_1 sym=false goal=7
    #[8] 0 < exp (log (abs x) / of_nat 2)
  ← rule real_exp_pos_lt goal=8
  ← rewrite source=prev goal=6 facts=[7]
    #[9] real_sgn x * 1 = real_sgn x
  ← rewrite real_mul_rid sym=false goal=9
  ← rewrite root_def sym=false goal=3
    #[10] (real_sgn x * exp (log (abs x) / of_nat 2)) ^ (2::nat) = abs x
  ← rewrite real_pow_mul sym=false goal=10
    #[11] real_sgn x ^ (2::nat) * exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
  ← rewrite real_sgn_pow sym=true goal=11
    #[12] real_sgn (x ^ (2::nat)) * exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
  ← rewrite real_sgn_pow_2 sym=false goal=12
    #[13] real_sgn (abs x) * exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
  → forward real_abs_pos param_x=x goal=13
    #[14] 0 ≤ abs x
  → rewrite target=fact real_le_lt sym=false goal=13 facts=[14]
    #[15] 0 < abs x ∨ 0 = abs x
  ← rule disjE goal=13 facts=[15]
    #[16] 0 < abs x ⟶ real_sgn (abs x) * exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
    #[17] 0 = abs x ⟶ real_sgn (abs x) * exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
  ← intro goal=16
    #[18] 0 < abs x
    #[19] real_sgn (abs x) * exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
  cut "real_sgn (abs x) = 1" goal=19
    #[20] real_sgn (abs x) = 1
  ← rewrite real_sgn_eq_1 sym=false goal=20
  ← rewrite source=prev goal=19 facts=[20]
    #[21] 1 * exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
  ← rewrite real_mul_lid sym=false goal=21
    #[22] exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
  ← rewrite real_exp_n sym=true goal=22
    #[23] exp (of_nat 2 * (log (abs x) / of_nat 2)) = abs x
  cut "∀x. 2 * (x / 2) = x" goal=23
    #[24] ∀x. 2 * (x / 2) = x
  ← z3 goal=24
    #[25] ∀x. 2 * (x / 2) = x
  ← rewrite real_of_nat_id sym=false goal=23
    #[26] exp (2 * (log (abs x) / 2)) = abs x
  ← rewrite source=prev goal=26 facts=[25]
    #[27] exp (log (abs x)) = abs x
  ← rule exp_log goal=27
  ← intro goal=17
    #[28] 0 = abs x
    #[29] real_sgn (abs x) * exp (log (abs x) / of_nat 2) ^ (2::nat) = abs x
  → rewrite target=fact eq_sym_eq sym=false goal=29 facts=[28]
    #[30] abs x = 0
  ← rewrite source=prev goal=29 facts=[30]
    #[31] real_sgn 0 * exp (log 0 / of_nat 2) ^ (2::nat) = 0
  ← rewrite real_sgn_0 sym=false goal=31
    #[32] 0 * exp (log 0 / of_nat 2) ^ (2::nat) = 0
  ← rewrite real_mul_lzero sym=false goal=32
    #[33] 0 * exp (log 0 / of_nat 2) ^ (2::nat) = 0
qed

theorem root_neg
  fixes n :: nat, x :: real
  prop root n (-x) = -(root n x)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite root_def sym=false goal=0
    #[1] real_sgn (-x) * exp (log (abs (-x)) / of_nat n) = -(real_sgn x * exp (log (abs x) / of_nat n))
  ← rewrite real_sgn_neg sym=false goal=1
    #[2] -(real_sgn x) * exp (log (abs (-x)) / of_nat n) = -(real_sgn x * exp (log (abs x) / of_nat n))
  ← rewrite real_abs_neg sym=false goal=2
    #[3] -(real_sgn x) * exp (log (abs x) / of_nat n) = -(real_sgn x * exp (log (abs x) / of_nat n))
  ← rewrite real_mul_lneg sym=false goal=3
qed

theorem root_works_1
  fixes n :: nat, x :: real
  prop real_sgn (root n x) = real_sgn x
  [hint_rewrite]
proof
  ← rewrite root_def sym=false goal=0
    #[1] real_sgn (real_sgn x * exp (log (abs x) / of_nat n)) = real_sgn x
  ← rewrite real_sgn_mul sym=false goal=1
    #[2] real_sgn (real_sgn x) * real_sgn (exp (log (abs x) / of_nat n)) = real_sgn x
  ← rewrite real_sgn_real_sgn sym=false goal=2
    #[3] real_sgn x * real_sgn (exp (log (abs x) / of_nat n)) = real_sgn x
  cut "real_sgn (exp (log (abs x) / of_nat n)) = 1" goal=3
    #[4] real_sgn (exp (log (abs x) / of_nat n)) = 1
  ← rewrite real_sgn_eq_1 sym=false goal=4
    #[5] 0 < exp (log (abs x) / of_nat n)
  ← rule real_exp_pos_lt goal=5
  ← rewrite source=prev goal=3 facts=[4]
    #[6] real_sgn x * 1 = real_sgn x
  ← rewrite real_mul_rid sym=false goal=6
qed

theorem root_works_2
  fixes n :: nat, x :: real
  prop root n x ^ n = (if n = 0 then 1 else real_sgn x ^ n * abs x)
  [hint_rewrite]
proof
  ← rewrite root_def sym=false goal=0
    #[1] (real_sgn x * exp (log (abs x) / of_nat n)) ^ n = (if n = 0 then 1 else real_sgn x ^ n * abs x)
  ← cases "n = 0" goal=1
    #[2] n = 0 ⟶ (real_sgn x * exp (log (abs x) / of_nat n)) ^ n = (if n = 0 then 1 else real_sgn x ^ n * abs x)
    #[3] ¬(n = 0) ⟶ (real_sgn x * exp (log (abs x) / of_nat n)) ^ n = (if n = 0 then 1 else real_sgn x ^ n * abs x)
  ← intro goal=2
    #[4] n = 0
    #[5] (real_sgn x * exp (log (abs x) / of_nat n)) ^ n = (if n = 0 then 1 else real_sgn x ^ n * abs x)
  ← rewrite if_P sym=false goal=5 facts=[4]
    #[6] (real_sgn x * exp (log (abs x) / of_nat n)) ^ n = 1
  ← rewrite source=prev goal=6 facts=[4]
    #[7] (real_sgn x * exp (log (abs x) / of_nat 0)) ^ (0::nat) = 1
  ← rewrite real_nat_power_def_1 sym=false goal=7
    #[8] (real_sgn x * exp (log (abs x) / of_nat 0)) ^ (0::nat) = 1
  ← intro goal=3
    #[9] ¬(n = 0)
    #[10] (real_sgn x * exp (log (abs x) / of_nat n)) ^ n = (if n = 0 then 1 else real_sgn x ^ n * abs x)
  ← rewrite if_not_P sym=false goal=10 facts=[9]
    #[11] (real_sgn x * exp (log (abs x) / of_nat n)) ^ n = real_sgn x ^ n * abs x
  ← rewrite real_pow_mul sym=false goal=11
    #[12] real_sgn x ^ n * exp (log (abs x) / of_nat n) ^ n = real_sgn x ^ n * abs x
  ← rewrite real_exp_n sym=true goal=12
    #[13] real_sgn x ^ n * exp (of_nat n * (log (abs x) / of_nat n)) = real_sgn x ^ n * abs x
  cut "!x::real. !y. ~(x =0) --> x *(y/x) = y" goal=13
    #[14] ∀x. ∀y. ¬(x = 0) ⟶ x * (y / x) = y
  ← z3 goal=14
    #[15] ∀x. ∀y. ¬(x = 0) ⟶ x * (y / x) = y
  → rewrite target=fact real_of_nat_eq sym=true goal=13 facts=[9]
    #[16] ¬((of_nat::nat ⇒ real) n = of_nat 0)
  → rewrite target=fact real_zero_def sym=true goal=13 facts=[16]
    #[17] ¬(of_nat n = (0::real))
  → inst target=fact "(of_nat::nat ⇒ real) n" goal=13 facts=[15]
    #[18] ∀y. ¬(of_nat n = (0::real)) ⟶ of_nat n * (y / of_nat n) = y
  → inst target=fact "log (abs x)" goal=13 facts=[18]
    #[19] ¬(of_nat n = (0::real)) ⟶ of_nat n * (log (abs x) / of_nat n) = log (abs x)
  → forward goal=13 facts=[19,17]
    #[20] of_nat n * (log (abs x) / of_nat n) = log (abs x)
  ← rewrite source=prev goal=13 facts=[20]
    #[21] real_sgn x ^ n * exp (log (abs x)) = real_sgn x ^ n * abs x
  ← cases "x = 0" goal=21
    #[22] x = 0 ⟶ real_sgn x ^ n * exp (log (abs x)) = real_sgn x ^ n * abs x
    #[23] ¬(x = 0) ⟶ real_sgn x ^ n * exp (log (abs x)) = real_sgn x ^ n * abs x
  ← intro goal=22
    #[24] x = 0
    #[25] real_sgn x ^ n * exp (log (abs x)) = real_sgn x ^ n * abs x
  ← rewrite source=prev goal=25 facts=[24]
    #[26] real_sgn 0 ^ n * exp (log (abs 0)) = real_sgn 0 ^ n * abs 0
  ← rewrite real_sgn_0 sym=false goal=26
    #[27] 0 ^ n * exp (log (abs 0)) = 0 ^ n * abs 0
  ← rewrite real_pow_zero sym=false goal=27
    #[28] (if n = 0 then 1 else 0) * exp (log (abs 0)) = (if n = 0 then 1 else 0) * abs 0
  ← rewrite if_not_P sym=false goal=28 facts=[9]
    #[29] 0 * exp (log (abs 0)) = 0 * abs 0
  ← rewrite real_mul_lzero sym=false goal=29
    #[30] 0 * exp (log (abs 0)) = 0 * abs 0
  ← intro goal=23
    #[31] ¬(x = 0)
    #[32] real_sgn x ^ n * exp (log (abs x)) = real_sgn x ^ n * abs x
  cut "exp (log (abs x)) = abs x" goal=32
    #[33] exp (log (abs x)) = abs x
  ← rule exp_log goal=33
    #[34] 0 < abs x
  ← z3 goal=34 facts=[31]
    #[35] 0 < abs x
  ← rewrite source=prev goal=32 facts=[33]
qed

theorem real_pow_root_1
  fixes n :: nat, x :: real
  prop odd n --> root n x ^ n = x
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] odd n
    #[2] root n x ^ n = x
  ← rewrite root_works_2 sym=false goal=2
    #[3] (if n = 0 then 1 else real_sgn x ^ n * abs x) = x
  → rewrite target=fact odd_exists sym=false goal=3 facts=[1]
    #[4] ∃m. n = Suc (2 * m)
  elim m goal=3 facts=[4]
    #[5] _VAR m
    #[6] n = Suc (2 * m)
    #[7] (if n = 0 then 1 else real_sgn x ^ n * abs x) = x
    #[8] root n x ^ n = x
  cut "~(n = 0)" goal=7
    #[9] ¬(n = 0)
  ← rewrite source=prev goal=9 facts=[6]
    #[10] ¬(Suc (2 * m) = 0)
  ← rewrite eq_sym_eq sym=false goal=10
    #[11] ¬(0 = Suc (2 * m))
  ← rule nat_zero_Suc_neq goal=11
    #[12] ¬(0 = Suc (2 * m))
  ← rewrite if_not_P sym=false goal=7 facts=[9]
    #[13] real_sgn x ^ n * abs x = x
  ← rewrite source=prev goal=13 facts=[6]
    #[14] real_sgn x ^ Suc (2 * m) * abs x = x
  ← rewrite real_nat_power_def_2 sym=false goal=14
    #[15] real_sgn x * real_sgn x ^ (2 * m) * abs x = x
  ← rewrite real_pow_pow sym=true goal=15
    #[16] real_sgn x * real_sgn x ^ (2::nat) ^ m * abs x = x
  ← rewrite real_sgn_pow sym=true goal=16
    #[17] real_sgn x * real_sgn (x ^ (2::nat)) ^ m * abs x = x
  ← rewrite real_sgn_pow_2 sym=false goal=17
    #[18] real_sgn x * real_sgn (abs x) ^ m * abs x = x
  ← cases "x = 0" goal=18
    #[19] x = 0 ⟶ real_sgn x * real_sgn (abs x) ^ m * abs x = x
    #[20] ¬(x = 0) ⟶ real_sgn x * real_sgn (abs x) ^ m * abs x = x
  ← intro goal=19
    #[21] x = 0
    #[22] real_sgn x * real_sgn (abs x) ^ m * abs x = x
  ← rewrite source=prev goal=22 facts=[21]
    #[23] real_sgn 0 * real_sgn (abs 0) ^ m * abs 0 = 0
  ← rewrite real_sgn_0 sym=false goal=23
    #[24] 0 * real_sgn (abs 0) ^ m * abs 0 = 0
  ← rewrite real_mul_lzero sym=false goal=24
    #[25] (0::real) * abs 0 = 0
  ← rewrite real_mul_lzero sym=false goal=25
    #[26] (0::real) * abs 0 = 0
  ← intro goal=20
    #[27] ¬(x = 0)
    #[28] real_sgn x * real_sgn (abs x) ^ m * abs x = x
  cut "real_sgn (abs x) = 1" goal=28
    #[29] real_sgn (abs x) = 1
  ← rewrite real_sgn_eq_1 sym=false goal=29
    #[30] 0 < abs x
  ← z3 goal=30 facts=[27]
    #[31] 0 < abs x
  ← rewrite source=prev goal=28 facts=[29]
    #[32] real_sgn x * 1 ^ m * abs x = x
  ← rewrite real_pow_one sym=false goal=32
    #[33] real_sgn x * 1 * abs x = x
  ← rewrite real_mul_rid sym=false goal=33
    #[34] real_sgn x * abs x = x
  ← rewrite real_sgn_abs sym=false goal=34
    #[35] real_sgn x * abs x = x
qed

theorem real_pow_root_2
  fixes n :: nat, x :: real
  prop ~(n = 0) --> 0 <= x --> root n x ^ n = x
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 ≤ x
    #[3] root n x ^ n = x
  ← rewrite root_works_2 sym=false goal=3
    #[4] (if n = 0 then 1 else real_sgn x ^ n * abs x) = x
  ← rewrite if_not_P sym=false goal=4 facts=[1]
    #[5] real_sgn x ^ n * abs x = x
  ← cases "x = 0" goal=5
    #[6] x = 0 ⟶ real_sgn x ^ n * abs x = x
    #[7] ¬(x = 0) ⟶ real_sgn x ^ n * abs x = x
  ← intro goal=6
    #[8] x = 0
    #[9] real_sgn x ^ n * abs x = x
  ← rewrite source=prev goal=9 facts=[8]
    #[10] real_sgn 0 ^ n * abs 0 = 0
  ← rewrite real_sgn_0 sym=false goal=10
    #[11] (0::real) ^ n * abs 0 = 0
  ← rewrite real_abs_0 sym=false goal=11
    #[12] (0::real) ^ n * 0 = 0
  ← rewrite real_mul_rzero sym=false goal=12
    #[13] (0::real) ^ n * 0 = 0
  ← intro goal=7
    #[14] ¬(x = 0)
    #[15] real_sgn x ^ n * abs x = x
  cut "real_sgn x = 1" goal=15
    #[16] real_sgn x = 1
  ← rewrite real_sgn_eq_1 sym=false goal=16
    #[17] 0 < x
  ← z3 goal=17 facts=[2,14]
    #[18] 0 < x
  ← rewrite source=prev goal=15 facts=[16]
    #[19] 1 ^ n * abs x = x
  ← rewrite real_pow_one sym=false goal=19
    #[20] 1 * abs x = x
  ← rewrite real_mul_lid sym=false goal=20
    #[21] abs x = x
  ← z3 goal=21 facts=[2]
    #[22] abs x = x
qed

theorem root_pos_lt
  fixes n :: nat, x :: real
  prop 0 < x --> 0 < root n x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < root n x
  ← rewrite root_def sym=false goal=2
    #[3] 0 < real_sgn x * exp (log (abs x) / of_nat n)
  ← rule real_lt_mul goal=3
    #[4] 0 < real_sgn x
    #[5] 0 < exp (log (abs x) / of_nat n)
  ← rewrite real_sgn_def sym=false goal=4
    #[6] (0::real) < (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← z3 goal=6 facts=[1]
  ← rule real_exp_pos_lt goal=5
    #[7] 0 < exp (log (abs x) / of_nat n)
qed

theorem root_pos_le
  fixes n :: nat, x :: real
  prop 0 <= x --> 0 <= root n x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ root n x
  ← rewrite real_le_lt sym=false goal=2
    #[3] 0 < root n x ∨ 0 = root n x
  → rewrite target=fact real_le_lt sym=false goal=3 facts=[1]
    #[4] 0 < x ∨ 0 = x
  ← rule disjE goal=3 facts=[4]
    #[5] 0 < x ⟶ 0 < root n x ∨ 0 = root n x
    #[6] 0 = x ⟶ 0 < root n x ∨ 0 = root n x
  ← intro goal=5
    #[7] 0 < x
    #[8] 0 < root n x ∨ 0 = root n x
  ← rule disjI1 goal=8
    #[9] 0 < root n x
  ← rule root_pos_lt goal=9 facts=[7]
    #[10] 0 < root n x
  ← intro goal=6
    #[11] 0 = x
    #[12] 0 < root n x ∨ 0 = root n x
  ← rule disjI2 goal=12
    #[13] 0 = root n x
  → rewrite target=fact eq_sym_eq sym=false goal=13 facts=[11]
    #[14] x = 0
  ← rewrite source=prev goal=13 facts=[14]
    #[15] 0 = root n 0
  ← rewrite root_0 sym=false goal=15
    #[16] 0 = root n 0
qed

theorem root_lt_0
  fixes n :: nat, x :: real
  prop 0 < root n x <--> 0 < x
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] 0 < root n x ⟶ 0 < x
    #[2] 0 < x ⟶ 0 < root n x
  ← intro goal=1
    #[3] 0 < root n x
    #[4] 0 < x
  ← rewrite real_less_def sym=false goal=4
    #[5] ¬(x ≤ 0)
  → rewrite target=fact real_less_def sym=false goal=5 facts=[3]
    #[6] ¬(root n x ≤ 0)
  ← rule contrapositive goal=5 facts=[6]
    #[7] ¬¬(x ≤ 0) ⟶ ¬¬(root n x ≤ 0)
  ← intro goal=7
    #[8] ¬¬(x ≤ 0)
    #[9] ¬¬(root n x ≤ 0)
  ← rewrite double_neg sym=false goal=9
    #[10] root n x ≤ 0
  → rewrite target=fact double_neg sym=false goal=10 facts=[8]
    #[11] x ≤ 0
  cut "!x::real. x ≤ 0 ⟷ 0 ≤ -x" goal=10
    #[12] ∀x::real. x ≤ 0 ⟷ 0 ≤ -x
  ← z3 goal=12
    #[13] ∀x::real. x ≤ 0 ⟷ 0 ≤ -x
  → rewrite target=fact source=prev goal=10 facts=[13,11]
    #[14] 0 ≤ -x
  ← rewrite source=prev goal=10 facts=[13]
    #[15] 0 ≤ -(root n x)
  → forward root_pos_le param_n=n goal=15 facts=[14]
    #[16] 0 ≤ root n (-x)
  → rewrite target=fact root_neg sym=false goal=15 facts=[16]
    #[17] 0 ≤ -(root n x)
  ← intro goal=2
    #[18] 0 < x
    #[19] 0 < root n x
  ← rule root_pos_lt goal=19 facts=[18]
qed

theorem root_le_0
  fixes n :: nat, x :: real
  prop 0 <= root n x <--> 0 <= x
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] 0 ≤ root n x ⟶ 0 ≤ x
    #[2] 0 ≤ x ⟶ 0 ≤ root n x
  ← intro goal=1
    #[3] 0 ≤ root n x
    #[4] 0 ≤ x
  ← rewrite real_not_lt sym=true goal=4
    #[5] ¬(x < 0)
  → rewrite target=fact real_not_lt sym=true goal=5 facts=[3]
    #[6] ¬(root n x < 0)
  ← rule contrapositive goal=5 facts=[6]
    #[7] ¬¬(x < 0) ⟶ ¬¬(root n x < 0)
  ← intro goal=7
    #[8] ¬¬(x < 0)
    #[9] ¬¬(root n x < 0)
  ← rewrite double_neg sym=false goal=9
    #[10] root n x < 0
  → rewrite target=fact double_neg sym=false goal=10 facts=[8]
    #[11] x < 0
  cut "∀x::real. x < 0 ⟷ 0 < -x" goal=10
    #[12] ∀x::real. x < 0 ⟷ 0 < -x
  ← z3 goal=12
    #[13] ∀x::real. x < 0 ⟷ 0 < -x
  ← rewrite source=prev goal=10 facts=[13]
    #[14] 0 < -(root n x)
  → rewrite target=fact source=prev goal=14 facts=[13,11]
    #[15] 0 < -x
  ← rewrite root_neg sym=true goal=14
    #[16] 0 < root n (-x)
  ← rule root_pos_lt goal=16 facts=[15]
    #[17] 0 < root n (-x)
  ← intro goal=2
    #[18] 0 ≤ x
    #[19] 0 ≤ root n x
  ← rule root_pos_le goal=19 facts=[18]
qed

theorem root_eq_0
  fixes n :: nat, x :: real
  prop root n x = 0 <--> x = 0
  [hint_rewrite]
proof
  ← rewrite root_def sym=false goal=0
    #[1] real_sgn x * exp (log (abs x) / of_nat n) = 0 ⟷ x = 0
  ← rewrite real_entire sym=false goal=1
    #[2] real_sgn x = 0 ∨ exp (log (abs x) / of_nat n) = 0 ⟷ x = 0
  ← rule iffI goal=2
    #[3] real_sgn x = 0 ∨ exp (log (abs x) / of_nat n) = 0 ⟶ x = 0
    #[4] x = 0 ⟶ real_sgn x = 0 ∨ exp (log (abs x) / of_nat n) = 0
  ← intro goal=3
    #[5] real_sgn x = 0 ∨ exp (log (abs x) / of_nat n) = 0
    #[6] x = 0
  ← rule disjE goal=6 facts=[5]
    #[7] real_sgn x = 0 ⟶ x = 0
    #[8] exp (log (abs x) / of_nat n) = 0 ⟶ x = 0
  ← intro goal=7
    #[9] real_sgn x = 0
    #[10] x = 0
  → rewrite target=fact real_sgn_eq_0 sym=false goal=10 facts=[9]
    #[11] x = 0
  ← intro goal=8
    #[12] exp (log (abs x) / of_nat n) = 0
    #[13] x = 0
  → rewrite target=fact double_neg sym=true goal=13 facts=[12]
    #[14] ¬¬(exp (log (abs x) / of_nat n) = 0)
  ← rule negE_gen goal=13 facts=[14]
    #[15] ¬(exp (log (abs x) / of_nat n) = 0)
  ← rule real_exp_nz goal=15
    #[16] ¬(exp (log (abs x) / of_nat n) = 0)
  ← intro goal=4
    #[17] x = 0
    #[18] real_sgn x = 0 ∨ exp (log (abs x) / of_nat n) = 0
  ← rule disjI1 goal=18
    #[19] real_sgn x = 0
  ← rewrite real_sgn_eq_0 sym=false goal=19
qed

theorem real_root_mul
  fixes n :: nat, x :: real, y :: real
  prop root n (x * y) = root n x * root n y
  [hint_rewrite,hint_rewrite_sym]
proof
  ← cases "x = 0" goal=0
    #[1] x = 0 ⟶ root n (x * y) = root n x * root n y
    #[2] ¬(x = 0) ⟶ root n (x * y) = root n x * root n y
  ← intro goal=1
    #[3] x = 0
    #[4] root n (x * y) = root n x * root n y
  ← rewrite source=prev goal=4 facts=[3]
    #[5] root n (0 * y) = root n 0 * root n y
  ← rewrite real_mul_lzero sym=false goal=5
    #[6] root n 0 = root n 0 * root n y
  ← rewrite root_0 sym=false goal=6
    #[7] 0 = 0 * root n y
  ← rewrite real_mul_lzero sym=false goal=7
    #[8] 0 = 0 * root n y
  ← intro goal=2
    #[9] ¬(x = 0)
    #[10] root n (x * y) = root n x * root n y
  ← cases "y = 0" goal=10
    #[11] y = 0 ⟶ root n (x * y) = root n x * root n y
    #[12] ¬(y = 0) ⟶ root n (x * y) = root n x * root n y
  ← intro goal=11
    #[13] y = 0
    #[14] root n (x * y) = root n x * root n y
  ← rewrite source=prev goal=14 facts=[13]
    #[15] root n (x * 0) = root n x * root n 0
  ← rewrite real_mul_rzero sym=false goal=15
    #[16] root n 0 = root n x * root n 0
  ← rewrite root_0 sym=false goal=16
    #[17] 0 = root n x * 0
  ← rewrite real_mul_rzero sym=false goal=17
    #[18] 0 = root n x * 0
  ← intro goal=12
    #[19] ¬(y = 0)
    #[20] root n (x * y) = root n x * root n y
  ← rewrite root_def sym=false goal=20
    #[21] real_sgn (x * y) * exp (log (abs (x * y)) / of_nat n) = real_sgn x * exp (log (abs x) / of_nat n) * (real_sgn y * exp (log (abs y) / of_nat n))
  ← rewrite real_sgn_mul sym=false goal=21
    #[22] real_sgn x * real_sgn y * exp (log (abs (x * y)) / of_nat n) = real_sgn x * exp (log (abs x) / of_nat n) * (real_sgn y * exp (log (abs y) / of_nat n))
  ← rewrite real_abs_mul sym=false goal=22
    #[23] real_sgn x * real_sgn y * exp (log (abs x * abs y) / of_nat n) = real_sgn x * exp (log (abs x) / of_nat n) * (real_sgn y * exp (log (abs y) / of_nat n))
  cut "!x::real. ~(x = 0) <--> 0 < abs x" goal=23
    #[24] ∀x::real. ¬(x = 0) ⟷ 0 < abs x
  ← z3 goal=24
    #[25] ∀x::real. ¬(x = 0) ⟷ 0 < abs x
  → rewrite target=fact source=prev goal=23 facts=[25,9]
    #[26] 0 < abs x
  → rewrite target=fact source=prev goal=23 facts=[25,19]
    #[27] 0 < abs y
  → forward log_mul goal=23 facts=[26,27]
    #[28] log (abs x * abs y) = log (abs x) + log (abs y)
  ← rewrite source=prev goal=23 facts=[28]
    #[29] real_sgn x * real_sgn y * exp ((log (abs x) + log (abs y)) / of_nat n) = real_sgn x * exp (log (abs x) / of_nat n) * (real_sgn y * exp (log (abs y) / of_nat n))
  ← rewrite real_divide_def sym=false goal=29
    #[30] real_sgn x * real_sgn y * exp ((log (abs x) + log (abs y)) * real_inverse (of_nat n)) = real_sgn x * exp (log (abs x) * real_inverse (of_nat n)) * (real_sgn y * exp (log (abs y) * real_inverse (of_nat n)))
  ← rewrite real_add_rdistrib sym=false goal=30
    #[31] real_sgn x * real_sgn y * exp (log (abs x) * real_inverse (of_nat n) + log (abs y) * real_inverse (of_nat n)) = real_sgn x * exp (log (abs x) * real_inverse (of_nat n)) * (real_sgn y * exp (log (abs y) * real_inverse (of_nat n)))
  ← rewrite real_exp_add sym=false goal=31
    #[32] real_sgn x * real_sgn y * (exp (log (abs x) * real_inverse (of_nat n)) * exp (log (abs y) * real_inverse (of_nat n))) = real_sgn x * exp (log (abs x) * real_inverse (of_nat n)) * (real_sgn y * exp (log (abs y) * real_inverse (of_nat n)))
  real_norm goal=32
    #[33] real_sgn x * real_sgn y * (exp (log (abs x) * real_inverse (of_nat n)) * exp (log (abs y) * real_inverse (of_nat n))) = real_sgn x * exp (log (abs x) * real_inverse (of_nat n)) * (real_sgn y * exp (log (abs y) * real_inverse (of_nat n)))
qed

theorem real_root_pow_gen
  fixes m :: nat, n :: nat, x :: real
  prop root n (x ^ m) = root n x ^ m
  [hint_rewrite]
proof
  ← induct m nat_induct goal=0
    #[1] root n (x ^ (0::nat)) = root n x ^ (0::nat)
    #[2] ∀n1. root n (x ^ n1) = root n x ^ n1 ⟶ root n (x ^ Suc n1) = root n x ^ Suc n1
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] root n 1 = 1
  ← rewrite root_1 sym=false goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] root n (x ^ n) = root n x ^ n
    #[6] root n (x ^ Suc n) = root n x ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=6
    #[7] root n (x * x ^ n) = root n x * root n x ^ n
  ← rewrite real_root_mul sym=false goal=7
    #[8] root n x * root n (x ^ n) = root n x * root n x ^ n
  ← rewrite source=prev goal=8 facts=[5]
qed

theorem real_root_pow1
  fixes n :: nat, x :: real
  prop odd n --> root n (x ^ n) = x
  [hint_backward]
proof
  ← intro goal=0
    #[1] odd n
    #[2] root n (x ^ n) = x
  ← rewrite real_root_pow_gen sym=false goal=2
    #[3] root n x ^ n = x
  ← rule real_pow_root_1 goal=3
qed

theorem real_root_pow2
  fixes n :: nat, x :: real
  prop ~(n = 0) --> 0 <= x --> root n (x ^ n) = x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 ≤ x
    #[3] root n (x ^ n) = x
  ← rewrite real_root_pow_gen sym=false goal=3
    #[4] root n x ^ n = x
  ← rule real_pow_root_2 goal=4
qed

theorem root_unique
  fixes n :: nat, x :: real, y :: real
  prop y ^ n = x --> odd n | ~(n = 0) & 0 <= y --> root n x = y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] y ^ n = x
    #[2] odd n ∨ ¬(n = 0) ∧ 0 ≤ y
    #[3] root n x = y
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[1]
    #[4] x = y ^ n
  ← rewrite source=prev goal=3 facts=[4]
    #[5] root n (y ^ n) = y
  ← rule disjE goal=5 facts=[2]
    #[6] odd n ⟶ root n (y ^ n) = y
    #[7] ¬(n = 0) ∧ 0 ≤ y ⟶ root n (y ^ n) = y
  ← intro goal=6
    #[8] odd n
    #[9] root n (y ^ n) = y
  ← rule real_root_pow1 goal=9
  ← intro goal=7
    #[10] ¬(n = 0) ∧ 0 ≤ y
    #[11] root n (y ^ n) = y
  ← rule real_root_pow2 goal=11
    #[12] ¬(n = 0)
    #[13] 0 ≤ y
  ← rule conjD1 goal=12 facts=[10]
    #[14] ¬(n = 0)
  ← rule conjD2 goal=13 facts=[10]
    #[15] 0 ≤ y
qed

theorem real_root_inv
  fixes n :: nat, x :: real
  prop root n (real_inverse x) = real_inverse (root n x)
  [hint_rewrite]
proof
  ← rewrite root_def sym=false goal=0
    #[1] real_sgn (real_inverse x) * exp (log (abs (real_inverse x)) / of_nat n) = real_inverse (real_sgn x * exp (log (abs x) / of_nat n))
  ← rewrite real_sgn_inv sym=false goal=1
    #[2] real_sgn x * exp (log (abs (real_inverse x)) / of_nat n) = real_inverse (real_sgn x * exp (log (abs x) / of_nat n))
  ← rewrite real_inv_mul sym=false goal=2
    #[3] real_sgn x * exp (log (abs (real_inverse x)) / of_nat n) = real_inverse (real_sgn x) * real_inverse (exp (log (abs x) / of_nat n))
  ← rewrite real_inv_sgn sym=false goal=3
    #[4] real_sgn x * exp (log (abs (real_inverse x)) / of_nat n) = real_sgn x * real_inverse (exp (log (abs x) / of_nat n))
  ← cases "x = 0" goal=4
    #[5] x = 0 ⟶ real_sgn x * exp (log (abs (real_inverse x)) / of_nat n) = real_sgn x * real_inverse (exp (log (abs x) / of_nat n))
    #[6] ¬(x = 0) ⟶ real_sgn x * exp (log (abs (real_inverse x)) / of_nat n) = real_sgn x * real_inverse (exp (log (abs x) / of_nat n))
  ← intro goal=5
    #[7] x = 0
    #[8] real_sgn x * exp (log (abs (real_inverse x)) / of_nat n) = real_sgn x * real_inverse (exp (log (abs x) / of_nat n))
  ← rewrite source=prev goal=8 facts=[7]
    #[9] real_sgn 0 * exp (log (abs (real_inverse 0)) / of_nat n) = real_sgn 0 * real_inverse (exp (log (abs 0) / of_nat n))
  ← rewrite real_sgn_0 sym=false goal=9
    #[10] 0 * exp (log (abs (real_inverse 0)) / of_nat n) = 0 * real_inverse (exp (log (abs 0) / of_nat n))
  ← rewrite real_mul_lzero sym=false goal=10
    #[11] 0 * exp (log (abs (real_inverse 0)) / of_nat n) = 0 * real_inverse (exp (log (abs 0) / of_nat n))
  ← intro goal=6
    #[12] ¬(x = 0)
    #[13] real_sgn x * exp (log (abs (real_inverse x)) / of_nat n) = real_sgn x * real_inverse (exp (log (abs x) / of_nat n))
  ← rewrite real_abs_inv sym=false goal=13
    #[14] real_sgn x * exp (log (real_inverse (abs x)) / of_nat n) = real_sgn x * real_inverse (exp (log (abs x) / of_nat n))
  → forward real_abs_nz goal=14 facts=[12]
    #[15] 0 < abs x
  → forward log_inv goal=14 facts=[15]
    #[16] log (real_inverse (abs x)) = -(log (abs x))
  ← rewrite source=prev goal=14 facts=[16]
    #[17] real_sgn x * exp (-(log (abs x)) / of_nat n) = real_sgn x * real_inverse (exp (log (abs x) / of_nat n))
  ← rewrite real_exp_neg sym=true goal=17
    #[18] real_sgn x * exp (-(log (abs x)) / of_nat n) = real_sgn x * exp (-(log (abs x) / of_nat n))
  ← rewrite real_divide_def sym=false goal=18
    #[19] real_sgn x * exp (-(log (abs x)) * real_inverse (of_nat n)) = real_sgn x * exp (-(log (abs x) * real_inverse (of_nat n)))
  ← rewrite real_mul_lneg sym=false goal=19
    #[20] real_sgn x * exp (-(log (abs x)) * real_inverse (of_nat n)) = real_sgn x * exp (-(log (abs x) * real_inverse (of_nat n)))
qed

theorem real_root_div
  fixes n :: nat, x :: real, y :: real
  prop root n (x / y) = root n x / root n y
  [hint_rewrite]
proof
  ← rewrite real_divide_def sym=false goal=0
    #[1] root n (x * real_inverse y) = root n x * real_inverse (root n y)
  ← rewrite real_root_mul sym=false goal=1
    #[2] root n x * root n (real_inverse y) = root n x * real_inverse (root n y)
  ← rewrite real_root_inv sym=false goal=2
qed

theorem root_mono_lt
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> x < y --> root n x < root n y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] x < y
    #[3] root n x < root n y
  cut "!x. !y. 0 <= x --> x < y --> root n x < root n y" goal=3
    #[4] ∀x. ∀y. 0 ≤ x ⟶ x < y ⟶ root n x < root n y
  ← intro "a, b" goal=4
    #[5] _VAR a
    #[6] _VAR b
    #[7] 0 ≤ a
    #[8] a < b
    #[9] root n a < root n b
  ← rule real_pow_lt2_rev param_n=n goal=9
    #[10] 0 ≤ root n b
    #[11] root n a ^ n < root n b ^ n
  ← rule root_pos_le goal=10
    #[12] 0 ≤ b
  ← z3 goal=12 facts=[7,8]
    #[13] 0 ≤ b
  ← rewrite root_works_2 sym=false goal=11
    #[14] (if n = 0 then 1 else real_sgn a ^ n * abs a) < (if n = 0 then 1 else real_sgn b ^ n * abs b)
  ← rewrite if_not_P sym=false goal=14 facts=[1]
    #[15] real_sgn a ^ n * abs a < real_sgn b ^ n * abs b
  ← rewrite real_sgn_def sym=false goal=15
    #[16] (if 0 < a then 1 else if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← cases "0 < a" goal=16
    #[17] 0 < a ⟶ (if 0 < a then 1 else if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
    #[18] ¬(0 < a) ⟶ (if 0 < a then 1 else if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← intro goal=17
    #[19] 0 < a
    #[20] (if 0 < a then 1 else if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← rewrite if_P sym=false goal=20 facts=[19]
    #[21] 1 ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  → forward real_lt_trans goal=21 facts=[19,8]
    #[22] 0 < b
  ← rewrite if_P sym=false goal=21 facts=[22]
    #[23] 1 ^ n * abs a < 1 ^ n * abs b
  ← rewrite real_pow_one sym=false goal=23
    #[24] 1 * abs a < 1 * abs b
  ← rewrite real_mul_lid sym=false goal=24
    #[25] abs a < abs b
  ← z3 goal=25 facts=[19,8]
    #[26] abs a < abs b
  ← intro goal=18
    #[27] ¬(0 < a)
    #[28] (if 0 < a then 1 else if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← rewrite if_not_P sym=false goal=28 facts=[27]
    #[29] (if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← cases "a < 0" goal=29
    #[30] a < 0 ⟶ (if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
    #[31] ¬(a < 0) ⟶ (if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← intro goal=30
    #[32] a < 0
    #[33] (if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← z3 goal=33 facts=[32,7]
    #[34] (if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← intro goal=31
    #[35] ¬(a < 0)
    #[36] (if a < 0 then -1 else 0) ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  ← rewrite if_not_P sym=false goal=36 facts=[35]
    #[37] 0 ^ n * abs a < (if 0 < b then 1 else if b < 0 then -1 else 0) ^ n * abs b
  → forward real_let_trans goal=37 facts=[7,8]
    #[38] 0 < b
  ← rewrite if_P sym=false goal=37 facts=[38]
    #[39] 0 ^ n * abs a < 1 ^ n * abs b
  ← rewrite real_pow_zero sym=false goal=39
    #[40] (if n = 0 then 1 else 0) * abs a < 1 ^ n * abs b
  ← rewrite if_not_P sym=false goal=40 facts=[1]
    #[41] 0 * abs a < 1 ^ n * abs b
  ← rewrite real_mul_lzero sym=false goal=41
    #[42] 0 < 1 ^ n * abs b
  ← rewrite real_pow_one sym=false goal=42
    #[43] 0 < 1 * abs b
  ← rewrite real_mul_lid sym=false goal=43
    #[44] 0 < abs b
  ← z3 goal=44 facts=[38]
    #[45] 0 < abs b
  ← cases "0 <= x" goal=3
    #[46] 0 ≤ x ⟶ root n x < root n y
    #[47] ¬(0 ≤ x) ⟶ root n x < root n y
  ← intro goal=46
    #[48] 0 ≤ x
    #[49] root n x < root n y
  ← apply_prev goal=49 facts=[4]
  ← intro goal=47
    #[50] ¬(0 ≤ x)
    #[51] root n x < root n y
  ← cases "0 <= y" goal=51
    #[52] 0 ≤ y ⟶ root n x < root n y
    #[53] ¬(0 ≤ y) ⟶ root n x < root n y
  ← intro goal=52
    #[54] 0 ≤ y
    #[55] root n x < root n y
  ← rule real_lte_trans param_y="(0::real)" goal=55
    #[56] root n x < 0
    #[57] 0 ≤ root n y
  ← rewrite real_less_def sym=false goal=56
    #[58] ¬(0 ≤ root n x)
  ← rewrite root_le_0 sym=false goal=58
  ← rewrite root_le_0 sym=false goal=57
  ← intro goal=53
    #[59] ¬(0 ≤ y)
    #[60] root n x < root n y
  ← rewrite real_lt_neg2 sym=true goal=60
    #[61] -(root n y) < -(root n x)
  ← rewrite root_neg sym=true goal=61
    #[62] root n (-y) < root n (-x)
  ← apply_prev goal=62 facts=[4]
    #[63] 0 ≤ -y
    #[64] -y < -x
  ← z3 goal=63 facts=[59]
    #[65] 0 ≤ -y
  ← rewrite real_lt_neg2 sym=false goal=64
qed

theorem root_mono_le
  fixes n :: nat, x :: real, y :: real
  prop x <= y --> root n x <= root n y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x ≤ y
    #[2] root n x ≤ root n y
  ← cases "n = 0" goal=2
    #[3] n = 0 ⟶ root n x ≤ root n y
    #[4] ¬(n = 0) ⟶ root n x ≤ root n y
  ← intro goal=3
    #[5] n = 0
    #[6] root n x ≤ root n y
  ← rewrite source=prev goal=6 facts=[5]
    #[7] root 0 x ≤ root 0 y
  ← rewrite root_def sym=false goal=7
    #[8] real_sgn x * exp (log (abs x) / of_nat 0) ≤ real_sgn y * exp (log (abs y) / of_nat 0)
  ← rewrite real_zero_def sym=true goal=8
    #[9] real_sgn x * exp (log (abs x) / 0) ≤ real_sgn y * exp (log (abs y) / 0)
  ← rewrite real_divide_def sym=false goal=9
    #[10] real_sgn x * exp (log (abs x) * real_inverse 0) ≤ real_sgn y * exp (log (abs y) * real_inverse 0)
  ← rewrite real_inv_0 sym=false goal=10
    #[11] real_sgn x * exp (log (abs x) * 0) ≤ real_sgn y * exp (log (abs y) * 0)
  ← rewrite real_mul_rzero sym=false goal=11
    #[12] real_sgn x * exp 0 ≤ real_sgn y * exp 0
  ← rewrite real_exp_0 sym=false goal=12
    #[13] real_sgn x * 1 ≤ real_sgn y * 1
  ← rewrite real_mul_rid sym=false goal=13
    #[14] real_sgn x ≤ real_sgn y
  ← rewrite real_sgn_def sym=false goal=14
    #[15] (if 0 < x then (1::real) else if x < 0 then -1 else 0) ≤ (if 0 < y then 1 else if y < 0 then -1 else 0)
  ← z3 goal=15 facts=[1]
    #[16] (if 0 < x then (1::real) else if x < 0 then -1 else 0) ≤ (if 0 < y then 1 else if y < 0 then -1 else 0)
  ← intro goal=4
    #[17] ¬(n = 0)
    #[18] root n x ≤ root n y
  ← rewrite real_le_lt sym=false goal=18
    #[19] root n x < root n y ∨ root n x = root n y
  → rewrite target=fact real_le_lt sym=false goal=19 facts=[1]
    #[20] x < y ∨ x = y
  ← rule disjE goal=19 facts=[20]
    #[21] x < y ⟶ root n x < root n y ∨ root n x = root n y
    #[22] x = y ⟶ root n x < root n y ∨ root n x = root n y
  ← intro goal=21
    #[23] x < y
    #[24] root n x < root n y ∨ root n x = root n y
  ← rule disjI1 goal=24
    #[25] root n x < root n y
  ← rule root_mono_lt goal=25
  ← intro goal=22
    #[26] x = y
    #[27] root n x < root n y ∨ root n x = root n y
  ← rule disjI2 goal=27
    #[28] root n x = root n y
  ← rewrite source=prev goal=28 facts=[26]
    #[29] root n x = root n y
qed

theorem root_mono_lt_eq
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> root n x < root n y <--> x < y
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] root n x < root n y ⟷ x < y
  ← rule iffI goal=2
    #[3] root n x < root n y ⟶ x < y
    #[4] x < y ⟶ root n x < root n y
  ← intro goal=3
    #[5] root n x < root n y
    #[6] x < y
  ← rule contrapositive goal=6 facts=[5]
    #[7] ¬(x < y) ⟶ ¬(root n x < root n y)
  ← rewrite real_not_lt sym=false goal=7
    #[8] y ≤ x ⟶ root n y ≤ root n x
  ← intro goal=8
    #[9] y ≤ x
    #[10] root n y ≤ root n x
  ← rule root_mono_le goal=10
  ← intro goal=4
    #[11] x < y
    #[12] root n x < root n y
  ← rule root_mono_lt goal=12
qed

theorem root_mono_le_eq
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> root n x <= root n y <--> x <= y
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] root n x ≤ root n y ⟷ x ≤ y
  ← rule iffI goal=2
    #[3] root n x ≤ root n y ⟶ x ≤ y
    #[4] x ≤ y ⟶ root n x ≤ root n y
  ← intro goal=3
    #[5] root n x ≤ root n y
    #[6] x ≤ y
  ← rule contrapositive goal=6 facts=[5]
    #[7] ¬(x ≤ y) ⟶ ¬(root n x ≤ root n y)
  ← rewrite real_not_lt sym=true goal=7
    #[8] ¬¬(y < x) ⟶ ¬¬(root n y < root n x)
  ← rewrite double_neg sym=false goal=8
    #[9] y < x ⟶ root n y < root n x
  ← intro goal=9
    #[10] y < x
    #[11] root n y < root n x
  ← rule root_mono_lt goal=11
  ← intro goal=4
    #[12] x ≤ y
    #[13] root n x ≤ root n y
  ← rule root_mono_le goal=13
qed

theorem root_inj
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> root n x = root n y <--> x = y
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] root n x = root n y ⟷ x = y
  ← rewrite real_le_antisym sym=true goal=2
    #[3] root n x ≤ root n y ∧ root n y ≤ root n x ⟷ x ≤ y ∧ y ≤ x
  → forward root_mono_le_eq param_x=x param_y=y goal=3 facts=[1]
    #[4] root n x ≤ root n y ⟷ x ≤ y
  → forward root_mono_le_eq param_x=y param_y=x goal=3 facts=[1]
    #[5] root n y ≤ root n x ⟷ y ≤ x
  ← rewrite source=prev goal=3 facts=[4]
    #[6] x ≤ y ∧ root n y ≤ root n x ⟷ x ≤ y ∧ y ≤ x
  ← rewrite source=prev goal=6 facts=[5]
qed

theorem real_root_le
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> 0 <= y --> root n x <= y <--> x <= y ^ n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 ≤ y
    #[3] root n x ≤ y ⟷ x ≤ y ^ n
  → forward real_root_pow2 goal=3 facts=[1,2]
    #[4] root n (y ^ n) = y
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] y = root n (y ^ n)
  ← rule iffI goal=3
    #[6] root n x ≤ y ⟶ x ≤ y ^ n
    #[7] x ≤ y ^ n ⟶ root n x ≤ y
  ← intro goal=6
    #[8] root n x ≤ y
    #[9] x ≤ y ^ n
  → rewrite target=fact source=prev goal=9 facts=[5,8]
    #[10] root n x ≤ root n (y ^ n)
  → forward root_mono_le_eq param_x=x param_y="y ^ n" goal=9 facts=[1]
    #[11] root n x ≤ root n (y ^ n) ⟷ x ≤ y ^ n
  → rewrite target=fact source=prev goal=9 facts=[11,10]
  ← intro goal=7
    #[12] x ≤ y ^ n
    #[13] root n x ≤ y
  ← rewrite source=prev goal=13 facts=[5]
    #[14] root n x ≤ root n (y ^ n)
  ← rule root_mono_le goal=14
qed

theorem real_le_root
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> 0 <= x --> x <= root n y <--> x ^ n <= y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 ≤ x
    #[3] x ≤ root n y ⟷ x ^ n ≤ y
  → forward real_root_pow2 goal=3 facts=[1,2]
    #[4] root n (x ^ n) = x
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] x = root n (x ^ n)
  ← rule iffI goal=3
    #[6] x ≤ root n y ⟶ x ^ n ≤ y
    #[7] x ^ n ≤ y ⟶ x ≤ root n y
  ← intro goal=6
    #[8] x ≤ root n y
    #[9] x ^ n ≤ y
  → rewrite target=fact source=prev goal=9 facts=[5,8]
    #[10] root n (x ^ n) ≤ root n y
  → forward root_mono_le_eq param_x="x ^ n" param_y=y goal=9 facts=[1]
    #[11] root n (x ^ n) ≤ root n y ⟷ x ^ n ≤ y
  → rewrite target=fact source=prev goal=9 facts=[11,10]
  ← intro goal=7
    #[12] x ^ n ≤ y
    #[13] x ≤ root n y
  ← rewrite source=prev goal=13 facts=[5]
    #[14] root n (x ^ n) ≤ root n y
  ← rule root_mono_le goal=14
qed

theorem log_root
  fixes n :: nat, x :: real
  prop ~(n = 0) --> 0 < x --> log (root n x) = log x / of_nat n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 < x
    #[3] log (root n x) = log x / of_nat n
  → forward le_1_1 goal=3 facts=[1]
    #[4] 0 < n
  → rewrite target=fact real_of_nat_lt sym=true goal=3 facts=[4]
    #[5] (of_nat::nat ⇒ real) 0 < of_nat n
  → rewrite target=fact real_zero_def sym=true goal=3 facts=[5]
    #[6] (0::real) < of_nat n
  → forward real_eq_rdiv_eq param_x="log (root n x)" param_y="log x" goal=3 facts=[6]
    #[7] log (root n x) = log x / of_nat n ⟷ log (root n x) * of_nat n = log x
  ← rewrite source=prev goal=3 facts=[7]
    #[8] log (root n x) * of_nat n = log x
  ← rewrite real_mult_comm sym=false goal=8
    #[9] of_nat n * log (root n x) = log x
  → forward root_pos_lt param_n=n goal=9 facts=[2]
    #[10] 0 < root n x
  → forward log_pow param_n=n goal=9 facts=[10]
    #[11] log (root n x ^ n) = of_nat n * log (root n x)
  → rewrite target=fact eq_sym_eq sym=false goal=9 facts=[11]
    #[12] of_nat n * log (root n x) = log (root n x ^ n)
  ← rewrite source=prev goal=9 facts=[12]
    #[13] log (root n x ^ n) = log x
  cut "root n x ^ n = x" goal=13
    #[14] root n x ^ n = x
  ← rule real_pow_root_2 goal=14
    #[15] 0 ≤ x
  ← rule real_lt_imp_le goal=15
  ← rewrite source=prev goal=13 facts=[14]
qed

theorem root_exp_log
  fixes n :: nat, x :: real
  prop ~(n = 0) --> 0 < x --> root n x = exp (log x / of_nat n)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 < x
    #[3] root n x = exp (log x / of_nat n)
  ← rewrite root_def sym=false goal=3
    #[4] real_sgn x * exp (log (abs x) / of_nat n) = exp (log x / of_nat n)
  ← rewrite real_sgn_def sym=false goal=4
    #[5] (if 0 < x then 1 else if x < 0 then -1 else 0) * exp (log (abs x) / of_nat n) = exp (log x / of_nat n)
  ← rewrite abs_def sym=false goal=5
    #[6] (if 0 < x then 1 else if x < 0 then -1 else 0) * exp (log (if 0 ≤ x then x else -x) / of_nat n) = exp (log x / of_nat n)
  ← rewrite if_P sym=false goal=6 facts=[2]
    #[7] 1 * exp (log (if 0 ≤ x then x else -x) / of_nat n) = exp (log x / of_nat n)
  → forward real_lt_imp_le goal=7 facts=[2]
    #[8] 0 ≤ x
  ← rewrite if_P sym=false goal=7 facts=[8]
    #[9] 1 * exp (log x / of_nat n) = exp (log x / of_nat n)
  ← rewrite real_mul_lid sym=false goal=9
    #[10] 1 * exp (log x / of_nat n) = exp (log x / of_nat n)
qed

theorem root_product
  fixes f :: 'a => real, n :: nat, s :: 'a set
  prop finite s --> root n (product s f) = product s (%i. root n (f i))
  [hint_backward]

theorem sqrt_product
  fixes f :: 'a => real, s :: 'a set
  prop finite s --> sqrt (product s f) = product s (%i. sqrt (f i))
  [hint_backward]

def power :: real ⇒ real ⇒ real = x ^ y = (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) [hint_rewrite]

theorem rpow_pow
  fixes n :: nat, x :: real
