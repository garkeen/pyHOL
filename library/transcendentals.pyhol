theorem rpow_eq_0
  fixes x :: real, y :: real
  prop x ^ y = 0 <--> x = 0 & ~(y = 0)
  [hint_rewrite]
proof
  ← rewrite real_real_power_def sym=false goal=0
    #[1] (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = 0 ⟷ x = 0 ∧ ¬(y = 0)
  ← cases "x = 0" goal=1
    #[2] x = 0 ⟶ (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = 0 ⟷ x = 0 ∧ ¬(y = 0)
    #[3] ¬(x = 0) ⟶ (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = 0 ⟷ x = 0 ∧ ¬(y = 0)
  ← intro goal=2
    #[4] x = 0
    #[5] (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = 0 ⟷ x = 0 ∧ ¬(y = 0)
  ← rewrite if_P sym=false goal=5 facts=[4]
    #[6] (if 0 < x then exp (y * log x) else if y = 0 then 1 else 0) = 0 ⟷ x = 0 ∧ ¬(y = 0)
  cut "~(0<x)" goal=6
    #[7] ¬(0 < x)
  ← z3 goal=7 facts=[4]
  ← rewrite if_not_P sym=false goal=6 facts=[7]
    #[8] (if y = 0 then (1::real) else 0) = 0 ⟷ x = 0 ∧ ¬(y = 0)
