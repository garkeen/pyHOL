  ← rewrite real_real_power_def sym=false goal=0
    #[1] (if 0 < -x then exp (y * log (-x)) else if -x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (--x))) else exp (y * log (--x))) = (if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) else if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← cases "x = 0" goal=1
    #[2] x = 0 ⟶ (if 0 < -x then exp (y * log (-x)) else if -x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (--x))) else exp (y * log (--x))) = (if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) else if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
    #[3] ¬(x = 0) ⟶ (if 0 < -x then exp (y * log (-x)) else if -x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (--x))) else exp (y * log (--x))) = (if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) else if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← intro goal=2
    #[4] x = 0
    #[5] (if 0 < -x then exp (y * log (-x)) else if -x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (--x))) else exp (y * log (--x))) = (if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) else if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← rewrite if_P sym=false goal=5 facts=[4]
    #[6] (if 0 < -x then exp (y * log (-x)) else if -x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (--x))) else exp (y * log (--x))) = (if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(if 0 < x then exp (y * log x) else if y = 0 then 1 else 0) else if 0 < x then exp (y * log x) else if y = 0 then 1 else 0)
  cut "-x = 0" goal=6
