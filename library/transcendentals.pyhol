    #[65] ((∃n. (of_nat::nat ⇒ real) n1 = of_nat n) ∨ (∃n. (of_nat::nat ⇒ real) n1 = -(of_nat n))) ∧ x = (of_nat n1 + 1 / 2) * pi
  ← rule conjI goal=65
    #[66] (∃n. (of_nat::nat ⇒ real) n1 = of_nat n) ∨ (∃n. (of_nat::nat ⇒ real) n1 = -(of_nat n))
