theorem rpow_pos_lt
  fixes x :: real, y :: real
  prop 0 < x --> 0 < x ^ y
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < x ^ y
  ← rewrite real_real_power_def sym=false goal=2
    #[3] 0 < (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x)))
  ← rewrite if_P sym=false goal=3 facts=[1]
    #[4] 0 < exp (y * log x)
  ← rule real_exp_pos_lt goal=4
    #[5] 0 < exp (y * log x)
qed

theorem rpow_pos_le
  fixes x :: real, y :: real
  prop 0 <= x --> 0 <= x ^ y
  [hint_backward]

theorem rpow_lt2
  fixes x :: real, y :: real, z :: real
  prop 0 <= x --> x < y --> 0 < z --> x ^ z < y ^ z
  [hint_backward,hint_backward1]

theorem rpow_le2
  fixes x :: real, y :: real, z :: real
  prop 0 <= x --> x <= y --> 0 <= z --> x ^ z <= y ^ z
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ y
    #[3] 0 ≤ z
    #[4] x ^ z ≤ y ^ z
  ← cases "z=0" goal=4
    #[5] z = 0 ⟶ x ^ z ≤ y ^ z
    #[6] ¬(z = 0) ⟶ x ^ z ≤ y ^ z
  ← intro goal=5
    #[7] z = 0
    #[8] x ^ z ≤ y ^ z
  ← rewrite source=prev goal=8 facts=[7]
    #[9] x ^ (0::real) ≤ y ^ (0::real)
  ← rewrite rpow_0 sym=false goal=9
    #[10] (1::real) ≤ 1
  ← rule real_le_refl goal=10
    #[11] (1::real) ≤ 1
  ← intro goal=6
    #[12] ¬(z = 0)
    #[13] x ^ z ≤ y ^ z
  ← cases "x = y" goal=13
    #[14] x = y ⟶ x ^ z ≤ y ^ z
    #[15] ¬(x = y) ⟶ x ^ z ≤ y ^ z
  ← intro goal=14
    #[16] x = y
    #[17] x ^ z ≤ y ^ z
  ← rewrite source=prev goal=17 facts=[16]
    #[18] y ^ z ≤ y ^ z
  ← rule real_le_refl goal=18
    #[19] y ^ z ≤ y ^ z
  ← intro goal=15
    #[20] ¬(x = y)
    #[21] x ^ z ≤ y ^ z
  ← rule real_lt_imp_le goal=21
    #[22] x ^ z < y ^ z
  ← rule rpow_lt2 goal=22
    #[23] x < y
    #[24] 0 < z
  ← z3 goal=23 facts=[20,2]
    #[25] x < y
  ← z3 goal=24 facts=[3,12]
    #[26] 0 < z
qed

theorem rpow_zero
  fixes y :: real
  prop (0::real) ^ y = (if y = 0 then 1 else 0)
  [hint_rewrite]
proof
  ← rewrite real_real_power_def sym=false goal=0
    #[1] (if (0::real) < 0 then exp (y * log 0) else if (0::real) = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-0))) else exp (y * log (-0))) = (if y = 0 then 1 else 0)
  cut "(0::real) = 0 " goal=1
    #[2] (0::real) = 0
  ← rule eq_refl goal=2
  ← rewrite if_P sym=false goal=1 facts=[2]
    #[3] (if (0::real) < 0 then exp (y * log 0) else if y = 0 then 1 else 0) = (if y = 0 then 1 else 0)
  cut "~((0::real) < 0)" goal=3
    #[4] ¬((0::real) < 0)
  ← z3 goal=4
  ← rewrite if_not_P sym=false goal=3 facts=[4]
qed

theorem rpow_1
  fixes x :: real
  prop x ^ (1::real) = x
  [hint_rewrite]
proof
  ← rewrite real_one_def sym=false goal=0
    #[1] x ^ (of_nat::nat ⇒ real) 1 = x
  ← rewrite rpow_pow sym=false goal=1
    #[2] x ^ (1::nat) = x
  ← rewrite real_pow_1 sym=false goal=2
qed

theorem rpow_one
  fixes z :: real
  prop (1::real) ^ z = 1
  [hint_rewrite]
proof
  ← rewrite real_real_power_def sym=false goal=0
    #[1] (if (0::real) < 1 then exp (z * log 1) else if (1::real) = 0 then if z = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs z = of_nat m / of_nat n then -(exp (z * log (-1))) else exp (z * log (-1))) = 1
  cut "(0::real) < 1" goal=1
    #[2] (0::real) < 1
  ← z3 goal=2
  ← rewrite if_P sym=false goal=1 facts=[2]
    #[3] exp (z * log 1) = 1
  ← rewrite log_1 sym=false goal=3
    #[4] exp (z * 0) = 1
  ← rewrite real_mul_rzero sym=false goal=4
    #[5] exp 0 = 1
  ← rewrite real_exp_0 sym=false goal=5
qed

theorem rpow_rpow
  fixes m :: real, n :: real, x :: real
  prop 0 <= x --> x ^ m ^ n = x ^ (m * n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ^ m ^ n = x ^ (m * n)
  ← cases "x = 0" goal=2
    #[3] x = 0 ⟶ x ^ m ^ n = x ^ (m * n)
    #[4] ¬(x = 0) ⟶ x ^ m ^ n = x ^ (m * n)
  ← intro goal=3
    #[5] x = 0
    #[6] x ^ m ^ n = x ^ (m * n)
  ← rewrite source=prev goal=6 facts=[5]
    #[7] (0::real) ^ m ^ n = 0 ^ (m * n)
  ← rewrite rpow_zero sym=false goal=7
    #[8] (if m = 0 then (1::real) else 0) ^ n = (if m * n = 0 then 1 else 0)
  ← cases "m = 0" goal=8
    #[9] m = 0 ⟶ (if m = 0 then (1::real) else 0) ^ n = (if m * n = 0 then 1 else 0)
    #[10] ¬(m = 0) ⟶ (if m = 0 then (1::real) else 0) ^ n = (if m * n = 0 then 1 else 0)
  ← intro goal=9
    #[11] m = 0
    #[12] (if m = 0 then (1::real) else 0) ^ n = (if m * n = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=12 facts=[11]
    #[13] (1::real) ^ n = (if m * n = 0 then 1 else 0)
  cut "m * n = 0" goal=13
    #[14] m * n = 0
  ← rewrite source=prev goal=14 facts=[11]
    #[15] 0 * n = 0
  ← rewrite real_mul_lzero sym=false goal=15
    #[16] 0 * n = 0
  ← rewrite if_P sym=false goal=13 facts=[14]
    #[17] (1::real) ^ n = 1
  ← rewrite rpow_one sym=false goal=17
    #[18] (1::real) ^ n = 1
  ← intro goal=10
    #[19] ¬(m = 0)
    #[20] (if m = 0 then (1::real) else 0) ^ n = (if m * n = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=20 facts=[19]
    #[21] (0::real) ^ n = (if m * n = 0 then 1 else 0)
  ← cases "n = 0" goal=21
    #[22] n = 0 ⟶ (0::real) ^ n = (if m * n = 0 then 1 else 0)
    #[23] ¬(n = 0) ⟶ (0::real) ^ n = (if m * n = 0 then 1 else 0)
  ← intro goal=22
    #[24] n = 0
    #[25] (0::real) ^ n = (if m * n = 0 then 1 else 0)
  cut "m * n = 0" goal=25
    #[26] m * n = 0
  ← rewrite source=prev goal=26 facts=[24]
    #[27] m * 0 = 0
  ← rewrite real_mul_rzero sym=false goal=27
    #[28] m * 0 = 0
  ← rewrite if_P sym=false goal=25 facts=[26]
    #[29] (0::real) ^ n = 1
  ← rewrite source=prev goal=29 facts=[24]
    #[30] (0::real) ^ (0::real) = 1
  ← rewrite rpow_0 sym=false goal=30
    #[31] (0::real) ^ (0::real) = 1
  ← intro goal=23
    #[32] ¬(n = 0)
    #[33] (0::real) ^ n = (if m * n = 0 then 1 else 0)
  cut "~(m * n = 0)" goal=33
    #[34] ¬(m * n = 0)
  ← rewrite real_entire sym=false goal=34
    #[35] ¬(m = 0 ∨ n = 0)
  ← rewrite de_morgan_thm2 sym=false goal=35
    #[36] ¬(m = 0) ∧ ¬(n = 0)
  ← rule conjI goal=36
  ← rewrite if_not_P sym=false goal=33 facts=[34]
    #[37] (0::real) ^ n = 0
  ← rewrite rpow_zero sym=false goal=37
    #[38] (if n = 0 then (1::real) else 0) = 0
  ← rewrite if_not_P sym=false goal=38 facts=[32]
    #[39] (if n = 0 then (1::real) else 0) = 0
  ← intro goal=4
    #[40] ¬(x = 0)
    #[41] x ^ m ^ n = x ^ (m * n)
  ← rewrite real_real_power_def sym=false goal=41
    #[42] (if 0 < x ^ m then exp (n * log (x ^ m)) else if x ^ m = 0 then if n = 0 then 1 else 0 else if ∃m1. ∃n1. odd m1 ∧ odd n1 ∧ abs n = of_nat m1 / of_nat n1 then -(exp (n * log (-(x ^ m)))) else exp (n * log (-(x ^ m)))) = (if 0 < x then exp (m * n * log x) else if x = 0 then if m * n = 0 then 1 else 0 else if ∃m1. ∃n1. odd m1 ∧ odd n1 ∧ abs (m * n) = of_nat m1 / of_nat n1 then -(exp (m * n * log (-x))) else exp (m * n * log (-x)))
  cut "0 < x ^ m" goal=42
    #[43] 0 < x ^ m
  ← rule rpow_pos_lt goal=43
    #[44] 0 < x
  ← z3 goal=44 facts=[40,1]
  ← rewrite if_P sym=false goal=42 facts=[43]
    #[45] exp (n * log (x ^ m)) = (if 0 < x then exp (m * n * log x) else if x = 0 then if m * n = 0 then 1 else 0 else if ∃m1. ∃n1. odd m1 ∧ odd n1 ∧ abs (m * n) = of_nat m1 / of_nat n1 then -(exp (m * n * log (-x))) else exp (m * n * log (-x)))
  ← rewrite if_P sym=false goal=45 facts=[44]
    #[46] exp (n * log (x ^ m)) = exp (m * n * log x)
  ← rewrite real_real_power_def sym=false goal=46
    #[47] exp (n * log (if 0 < x then exp (m * log x) else if x = 0 then if m = 0 then 1 else 0 else if ∃m1. ∃n1. odd m1 ∧ odd n1 ∧ abs m = of_nat m1 / of_nat n1 then -(exp (m * log (-x))) else exp (m * log (-x)))) = exp (m * n * log x)
  ← rewrite if_P sym=false goal=47 facts=[44]
    #[48] exp (n * log (exp (m * log x))) = exp (m * n * log x)
  ← rewrite log_exp sym=false goal=48
    #[49] exp (n * (m * log x)) = exp (m * n * log x)
  ← rewrite real_exp_inj sym=false goal=49
    #[50] n * (m * log x) = m * n * log x
  real_norm goal=50
    #[51] n * (m * log x) = m * n * log x
qed

theorem rpow_lneg
  fixes x :: real, y :: real
  prop -x ^ y = (if ?m. ?n. odd m & odd n & abs y = of_nat m / of_nat n then -(x ^ y) else x ^ y)
  [hint_rewrite]
