theorem rpow_div
  fixes x :: real, y :: real, z :: real
  prop (x / y) ^ z = x ^ z / y ^ z
  [hint_rewrite]
proof
  ← rewrite real_divide_def sym=false goal=0
    #[1] (x * real_inverse y) ^ z = x ^ z * real_inverse (y ^ z)
  ← rewrite rpow_mul sym=false goal=1
    #[2] x ^ z * real_inverse y ^ z = x ^ z * real_inverse (y ^ z)
  ← rewrite rpow_inv sym=false goal=2
qed

theorem rpow_product
  fixes s :: 'a set, x :: 'a => real, y :: real
  prop finite s --> product s x ^ y = product s (%i. x i ^ y)
  [hint_backward]

theorem rpow_add
  fixes m :: real, n :: real, x :: real
  prop x > 0 --> x ^ (m + n) = x ^ m * x ^ n
  [hint_backward]
proof
  ← intro goal=0
    #[1] x > 0
    #[2] x ^ (m + n) = x ^ m * x ^ n
  ← rewrite real_real_power_def sym=false goal=2
    #[3] (if 0 < x then exp ((m + n) * log x) else if x = 0 then if m + n = 0 then 1 else 0 else if ∃m1. ∃n1. odd m1 ∧ odd n1 ∧ abs (m + n) = of_nat m1 / of_nat n1 then -(exp ((m + n) * log (-x))) else exp ((m + n) * log (-x))) = (if 0 < x then exp (m * log x) else if x = 0 then if m = 0 then 1 else 0 else if ∃m1. ∃n1. odd m1 ∧ odd n1 ∧ abs m = of_nat m1 / of_nat n1 then -(exp (m * log (-x))) else exp (m * log (-x))) * (if 0 < x then exp (n * log x) else if x = 0 then if n = 0 then 1 else 0 else if ∃m1. ∃n1. odd m1 ∧ odd n1 ∧ abs n = of_nat m1 / of_nat n1 then -(exp (n * log (-x))) else exp (n * log (-x)))
  cut "0 < x" goal=3
    #[4] 0 < x
  ← z3 goal=4 facts=[1]
  ← rewrite if_P sym=false goal=3 facts=[4]
    #[5] exp ((m + n) * log x) = exp (m * log x) * exp (n * log x)
  ← rewrite real_add_rdistrib sym=false goal=5
    #[6] exp (m * log x + n * log x) = exp (m * log x) * exp (n * log x)
  ← rewrite real_exp_add sym=false goal=6
    #[7] exp (m * log x + n * log x) = exp (m * log x) * exp (n * log x)
qed

theorem rpow_sub
  fixes m :: real, n :: real, x :: real
  prop x > 0 --> x ^ (m - n) = x ^ m / x ^ n
  [hint_backward]
proof
  ← intro goal=0
    #[1] x > 0
    #[2] x ^ (m - n) = x ^ m / x ^ n
  ← rewrite real_minus_def sym=false goal=2
    #[3] x ^ (m + -n) = x ^ m / x ^ n
  → forward rpow_add param_m=m param_n=-n goal=3 facts=[1]
    #[4] x ^ (m + -n) = x ^ m * x ^ -n
  ← rewrite source=prev goal=3 facts=[4]
    #[5] x ^ m * x ^ -n = x ^ m / x ^ n
  ← rewrite rpow_neg sym=false goal=5
    #[6] x ^ m * real_inverse (x ^ n) = x ^ m / x ^ n
  ← rewrite real_divide_def sym=false goal=6
    #[7] x ^ m * real_inverse (x ^ n) = x ^ m / x ^ n
qed

theorem rpow_add_alt
  fixes x :: real, y :: real, z :: real
  prop 0 <= x --> (x = 0 --> y + z = 0 --> y = 0 | z = 0) --> x ^ (y + z) = x ^ y * x ^ z
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x = 0 ⟶ y + z = 0 ⟶ y = 0 ∨ z = 0
    #[3] x ^ (y + z) = x ^ y * x ^ z
  ← cases "x=0" goal=3
    #[4] x = 0 ⟶ x ^ (y + z) = x ^ y * x ^ z
    #[5] ¬(x = 0) ⟶ x ^ (y + z) = x ^ y * x ^ z
  ← intro goal=4
    #[6] x = 0
    #[7] x ^ (y + z) = x ^ y * x ^ z
  → forward goal=7 facts=[2,6]
    #[8] y + z = 0 ⟶ y = 0 ∨ z = 0
  ← rewrite source=prev goal=7 facts=[6]
    #[9] (0::real) ^ (y + z) = 0 ^ y * 0 ^ z
  ← rewrite rpow_zero sym=false goal=9
    #[10] (if y + z = 0 then (1::real) else 0) = (if y = 0 then 1 else 0) * (if z = 0 then 1 else 0)
  ← cases "y = 0" goal=10
    #[11] y = 0 ⟶ (if y + z = 0 then (1::real) else 0) = (if y = 0 then 1 else 0) * (if z = 0 then 1 else 0)
    #[12] ¬(y = 0) ⟶ (if y + z = 0 then (1::real) else 0) = (if y = 0 then 1 else 0) * (if z = 0 then 1 else 0)
  ← z3 goal=11
    #[13] y = 0 ⟶ (if y + z = 0 then (1::real) else 0) = (if y = 0 then 1 else 0) * (if z = 0 then 1 else 0)
  ← intro goal=12
    #[14] ¬(y = 0)
    #[15] (if y + z = 0 then (1::real) else 0) = (if y = 0 then 1 else 0) * (if z = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=15 facts=[14]
    #[16] (if y + z = 0 then (1::real) else 0) = 0 * (if z = 0 then 1 else 0)
  ← cases "y + z = 0" goal=16
    #[17] y + z = 0 ⟶ (if y + z = 0 then (1::real) else 0) = 0 * (if z = 0 then 1 else 0)
    #[18] ¬(y + z = 0) ⟶ (if y + z = 0 then (1::real) else 0) = 0 * (if z = 0 then 1 else 0)
  ← intro goal=17
    #[19] y + z = 0
    #[20] (if y + z = 0 then (1::real) else 0) = 0 * (if z = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=20 facts=[19]
    #[21] (1::real) = 0 * (if z = 0 then 1 else 0)
  → forward goal=21 facts=[8,19]
    #[22] y = 0 ∨ z = 0
  ← z3 goal=21 facts=[14,19,22]
    #[23] (1::real) = 0 * (if z = 0 then 1 else 0)
  ← intro goal=18
    #[24] ¬(y + z = 0)
    #[25] (if y + z = 0 then (1::real) else 0) = 0 * (if z = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=25 facts=[24]
    #[26] (0::real) = 0 * (if z = 0 then 1 else 0)
  ← rewrite real_mul_lzero sym=false goal=26
    #[27] (0::real) = 0 * (if z = 0 then 1 else 0)
  ← intro goal=5
    #[28] ¬(x = 0)
    #[29] x ^ (y + z) = x ^ y * x ^ z
  ← rule rpow_add goal=29
    #[30] x > 0
  ← z3 goal=30 facts=[28,1]
    #[31] x > 0
qed

theorem rpow_sub_alt
  fixes x :: real, y :: real, z :: real
  prop 0 <= x --> (x = 0 --> y = z --> y = 0 | z = 0) --> x ^ (y - z) = x ^ y / x ^ z
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x = 0 ⟶ y = z ⟶ y = 0 ∨ z = 0
    #[3] x ^ (y - z) = x ^ y / x ^ z
  ← rewrite real_minus_def sym=false goal=3
    #[4] x ^ (y + -z) = x ^ y / x ^ z
  ← rewrite real_divide_def sym=false goal=4
    #[5] x ^ (y + -z) = x ^ y * real_inverse (x ^ z)
  ← rewrite rpow_neg sym=true goal=5
    #[6] x ^ (y + -z) = x ^ y * x ^ -z
  ← rule rpow_add_alt goal=6
    #[7] x = 0 ⟶ y + -z = 0 ⟶ y = 0 ∨ -z = 0
  ← z3 goal=7 facts=[2]
    #[8] x = 0 ⟶ y + -z = 0 ⟶ y = 0 ∨ -z = 0
qed

theorem rpow_neg_one
  fixes x :: real
  prop real_inverse x = x ^ -(1::real)
proof
  ← rewrite rpow_neg sym=false goal=0
    #[1] real_inverse x = real_inverse (x ^ (1::real))
  ← rewrite rpow_1 sym=false goal=1
qed

theorem rpow_sqrt
  fixes x :: real
  prop x >= 0 --> sqrt x = x ^ (1 / 2)
proof
  ← intro goal=0
    #[1] x ≥ 0
    #[2] sqrt x = x ^ (1 / 2)
  cut "!x::real. !y. x ^ (2::nat) = y ^ (2::nat) --> (x + y = 0 --> x = 0 & y = 0)\n    --> x = y" goal=2
    #[3] ∀x::real. ∀y. x ^ (2::nat) = y ^ (2::nat) ⟶ (x + y = 0 ⟶ x = 0 ∧ y = 0) ⟶ x = y
  ← intro a,b goal=3
    #[4] _VAR a
    #[5] _VAR b
    #[6] a ^ (2::nat) = b ^ (2::nat)
    #[7] a + b = 0 ⟶ a = 0 ∧ b = 0
    #[8] a = b
  → rewrite target=fact real_pow_2 sym=false goal=8 facts=[6]
    #[9] a * a = b * b
  ← z3 goal=8 facts=[7,9]
    #[10] a = b
  ← apply_prev goal=2 facts=[3]
    #[11] sqrt x ^ (2::nat) = x ^ (1 / 2) ^ (2::nat)
    #[12] sqrt x + x ^ (1 / 2) = 0 ⟶ sqrt x = 0 ∧ x ^ (1 / 2) = 0
  cut "0 <= x" goal=11
    #[13] 0 ≤ x
  ← z3 goal=13 facts=[1]
  → forward sqrt_pow_2 goal=11 facts=[13]
    #[14] sqrt x ^ (2::nat) = x
  ← rewrite source=prev goal=11 facts=[14]
    #[15] x = x ^ (1 / 2) ^ (2::nat)
  ← rewrite rpow_pow sym=true goal=15
    #[16] x = x ^ (1 / 2) ^ (of_nat::nat ⇒ real) 2
  ← rewrite real_of_nat_id sym=false goal=16
    #[17] x = x ^ (1 / 2) ^ (2::real)
  → forward rpow_rpow param_m=1/2 param_n="(2::real)" goal=17 facts=[13]
    #[18] x ^ (1 / 2) ^ (2::real) = x ^ (1 / 2 * 2)
  ← rewrite source=prev goal=17 facts=[18]
    #[19] x = x ^ (1 / 2 * 2)
  cut "(1 / 2 * 2) = 1" goal=19
    #[20] 1 / 2 * 2 = 1
  real_norm goal=20
    #[21] 1 / 2 * 2 = 1
  ← rewrite source=prev goal=19 facts=[21]
    #[22] x = x ^ (1::real)
  ← rewrite rpow_1 sym=false goal=22
    #[23] x = x ^ (1::real)
  ← intro goal=12
    #[24] sqrt x + x ^ (1 / 2) = 0
    #[25] sqrt x = 0 ∧ x ^ (1 / 2) = 0
  cut "!x::real. !y. 0 <= x --> 0 <= y --> x + y = 0 --> x = 0 & y = 0" goal=25
    #[26] ∀x::real. ∀y. 0 ≤ x ⟶ 0 ≤ y ⟶ x + y = 0 ⟶ x = 0 ∧ y = 0
  ← z3 goal=26
    #[27] ∀x::real. ∀y. 0 ≤ x ⟶ 0 ≤ y ⟶ x + y = 0 ⟶ x = 0 ∧ y = 0
  ← apply_prev goal=25 facts=[27]
    #[28] 0 ≤ sqrt x
    #[29] 0 ≤ x ^ (1 / 2)
  ← rewrite sqrt_le_0 sym=false goal=28
  ← rule rpow_pos_le goal=29
qed

theorem rpow_mono_le
  fixes a :: real, b :: real, x :: real
  prop 1 <= x --> a <= b --> x ^ a <= x ^ b
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 1 ≤ x
    #[2] a ≤ b
    #[3] x ^ a ≤ x ^ b
  ← rewrite real_real_power_def sym=false goal=3
    #[4] (if 0 < x then exp (a * log x) else if x = 0 then if a = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs a = of_nat m / of_nat n then -(exp (a * log (-x))) else exp (a * log (-x))) ≤ (if 0 < x then exp (b * log x) else if x = 0 then if b = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs b = of_nat m / of_nat n then -(exp (b * log (-x))) else exp (b * log (-x)))
  cut "0 < x" goal=4
    #[5] 0 < x
  ← z3 goal=5 facts=[1]
    #[6] 0 < x
  ← rewrite if_P sym=false goal=4 facts=[6]
    #[7] exp (a * log x) ≤ exp (b * log x)
  ← rewrite real_exp_mono_le sym=false goal=7
    #[8] a * log x ≤ b * log x
  ← rewrite real_mult_comm sym=false goal=8
    #[9] log x * a ≤ log x * b
  ← rule real_le_lmul goal=9
    #[10] 0 ≤ log x
  ← rule log_pos goal=10
qed

theorem rpow_mono_lt
  fixes a :: real, b :: real, x :: real
  prop 1 < x --> a < b --> x ^ a < x ^ b
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] a < b
    #[3] x ^ a < x ^ b
  ← rewrite real_real_power_def sym=false goal=3
    #[4] (if 0 < x then exp (a * log x) else if x = 0 then if a = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs a = of_nat m / of_nat n then -(exp (a * log (-x))) else exp (a * log (-x))) < (if 0 < x then exp (b * log x) else if x = 0 then if b = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs b = of_nat m / of_nat n then -(exp (b * log (-x))) else exp (b * log (-x)))
  cut "0 < x" goal=4
    #[5] 0 < x
  ← z3 goal=5 facts=[1]
    #[6] 0 < x
  ← rewrite if_P sym=false goal=4 facts=[6]
    #[7] exp (a * log x) < exp (b * log x)
  ← rewrite real_exp_mono_lt sym=false goal=7
    #[8] a * log x < b * log x
  ← rewrite real_mult_comm sym=false goal=8
    #[9] log x * a < log x * b
  ← rule real_lt_lmul: goal=9
    #[10] 0 < log x
  ← rule log_pos_lt goal=10
qed

theorem rpow_mono_le_eq
  fixes a :: real, b :: real, x :: real
  prop 1 < x --> x ^ a <= x ^ b <--> a <= b
  [hint_backward]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] x ^ a ≤ x ^ b ⟷ a ≤ b
  ← rule iffI goal=2
    #[3] x ^ a ≤ x ^ b ⟶ a ≤ b
    #[4] a ≤ b ⟶ x ^ a ≤ x ^ b
  ← intro goal=3
    #[5] x ^ a ≤ x ^ b
    #[6] a ≤ b
  ← rewrite real_not_lt sym=true goal=6
    #[7] ¬(b < a)
  → rewrite target=fact real_not_lt sym=true goal=7 facts=[5]
    #[8] ¬(x ^ b < x ^ a)
  ← rule contrapositive goal=7 facts=[8]
    #[9] ¬¬(b < a) ⟶ ¬¬(x ^ b < x ^ a)
  ← rewrite double_neg sym=false goal=9
    #[10] b < a ⟶ x ^ b < x ^ a
  ← intro goal=10
    #[11] b < a
    #[12] x ^ b < x ^ a
  ← rule rpow_mono_lt goal=12
  ← intro goal=4
    #[13] a ≤ b
    #[14] x ^ a ≤ x ^ b
  ← rule rpow_mono_le goal=14
    #[15] 1 ≤ x
  ← rule real_lt_imp_le goal=15
qed

theorem rpow_mono_lt_eq
  fixes a :: real, b :: real, x :: real
  prop 1 < x --> x ^ a < x ^ b <--> a < b
  [hint_backward]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] x ^ a < x ^ b ⟷ a < b
  ← rewrite real_less_def sym=false goal=2
    #[3] ¬(x ^ b ≤ x ^ a) ⟷ ¬(b ≤ a)
  → forward rpow_mono_le_eq param_a=b param_b=a goal=3 facts=[1]
    #[4] x ^ b ≤ x ^ a ⟷ b ≤ a
  ← rewrite source=prev goal=3 facts=[4]
qed

theorem rpow_inj
  fixes x :: real, y :: real, z :: real
  prop 0 < x --> x ^ y = x ^ z <--> x = 1 | y = z
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x ^ y = x ^ z ⟷ x = 1 ∨ y = z
  ← rule iffI goal=2
    #[3] x ^ y = x ^ z ⟶ x = 1 ∨ y = z
    #[4] x = 1 ∨ y = z ⟶ x ^ y = x ^ z
  ← intro goal=3
    #[5] x ^ y = x ^ z
    #[6] x = 1 ∨ y = z
  ← cases "x=1" goal=6
    #[7] x = 1 ⟶ x = 1 ∨ y = z
    #[8] ¬(x = 1) ⟶ x = 1 ∨ y = z
  ← intro goal=7
    #[9] x = 1
    #[10] x = 1 ∨ y = z
  ← rule disjI1 goal=10
  ← intro goal=8
    #[11] ¬(x = 1)
    #[12] x = 1 ∨ y = z
  ← rule disjI2 goal=12
    #[13] y = z
  ← cases "1 < x" goal=13
    #[14] 1 < x ⟶ y = z
    #[15] ¬(1 < x) ⟶ y = z
  ← intro goal=14
    #[16] 1 < x
    #[17] y = z
  ← rewrite real_le_antisym sym=true goal=17
    #[18] y ≤ z ∧ z ≤ y
  → rewrite target=fact real_le_antisym sym=true goal=18 facts=[5]
    #[19] x ^ y ≤ x ^ z ∧ x ^ z ≤ x ^ y
  ← rule conjI goal=18
    #[20] y ≤ z
    #[21] z ≤ y
  → forward conjD1 goal=20 facts=[19]
    #[22] x ^ y ≤ x ^ z
  → forward conjD2 goal=20 facts=[19]
    #[23] x ^ z ≤ x ^ y
  → forward rpow_mono_le_eq param_a=y param_b=z goal=20 facts=[16]
    #[24] x ^ y ≤ x ^ z ⟷ y ≤ z
  → rewrite target=fact source=prev goal=20 facts=[24,22]
    #[25] y ≤ z
  → forward rpow_mono_le_eq param_a=z param_b=y goal=21 facts=[16]
    #[26] x ^ z ≤ x ^ y ⟷ z ≤ y
  → rewrite target=fact source=prev goal=21 facts=[26,23]
    #[27] z ≤ y
  ← intro goal=15
    #[28] ¬(1 < x)
    #[29] y = z
  cut "1 < real_inverse x" goal=29
    #[30] 1 < real_inverse x
  ← z3 goal=30 facts=[28,11,1]
    #[31] 1 < real_inverse x
  → rewrite target=fact real_eq_inv2 sym=true goal=29 facts=[5]
    #[32] real_inverse (x ^ y) = real_inverse (x ^ z)
  → rewrite target=fact rpow_inv sym=true goal=29 facts=[32]
    #[33] real_inverse x ^ y = real_inverse x ^ z
  → rewrite target=fact real_le_antisym sym=true goal=29 facts=[33]
    #[34] real_inverse x ^ y ≤ real_inverse x ^ z ∧ real_inverse x ^ z ≤ real_inverse x ^ y
  ← rewrite real_le_antisym sym=true goal=29
    #[35] y ≤ z ∧ z ≤ y
  ← rule conjI goal=35
    #[36] y ≤ z
    #[37] z ≤ y
  → forward conjD1 goal=36 facts=[34]
    #[38] real_inverse x ^ y ≤ real_inverse x ^ z
  → forward conjD2 goal=36 facts=[34]
    #[39] real_inverse x ^ z ≤ real_inverse x ^ y
  → forward rpow_mono_le_eq param_a=y param_b=z goal=36 facts=[31]
    #[40] real_inverse x ^ y ≤ real_inverse x ^ z ⟷ y ≤ z
  → rewrite target=fact source=prev goal=36 facts=[40,38]
  → forward rpow_mono_le_eq param_a=z param_b=y goal=37 facts=[31]
    #[41] real_inverse x ^ z ≤ real_inverse x ^ y ⟷ z ≤ y
  → rewrite target=fact source=prev goal=37 facts=[41,39]
  ← intro goal=4
    #[42] x = 1 ∨ y = z
    #[43] x ^ y = x ^ z
  ← rule disjE goal=43 facts=[42]
    #[44] x = 1 ⟶ x ^ y = x ^ z
    #[45] y = z ⟶ x ^ y = x ^ z
  ← intro goal=44
    #[46] x ^ y = x ^ z
  ← rewrite source=prev goal=46 facts=[9]
    #[47] (1::real) ^ y = 1 ^ z
  ← rewrite rpow_one sym=false goal=47
    #[48] (1::real) ^ y = 1 ^ z
  ← intro goal=45
    #[49] y = z
    #[50] x ^ y = x ^ z
  ← rewrite source=prev goal=50 facts=[49]
    #[51] x ^ y = x ^ z
qed

theorem rpow_le_1
  fixes x :: real, y :: real
  prop 1 <= x --> 0 <= y --> 1 <= x ^ y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 1 ≤ x
    #[2] 0 ≤ y
    #[3] 1 ≤ x ^ y
  → forward rpow_0 param_x=x goal=3
    #[4] x ^ (0::real) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] 1 = x ^ (0::real)
  ← rewrite source=prev goal=3 facts=[5]
    #[6] x ^ (0::real) ≤ x ^ y
  ← rule rpow_mono_le goal=6
qed

theorem rpow_lt_1
  fixes x :: real, y :: real
  prop 1 < x --> 0 < y --> 1 < x ^ y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] 0 < y
    #[3] 1 < x ^ y
  → forward rpow_0 param_x=x goal=3
    #[4] x ^ (0::real) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] 1 = x ^ (0::real)
  ← rewrite source=prev goal=3 facts=[5]
    #[6] x ^ (0::real) < x ^ y
  ← rule rpow_mono_lt goal=6 facts=[1,2]
qed

theorem rpow_mono_inv
  fixes a :: real, b :: real, x :: real
  prop 0 < x --> x <= 1 --> b <= a --> x ^ a <= x ^ b
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x ≤ 1
    #[3] b ≤ a
    #[4] x ^ a ≤ x ^ b
  → forward real_inv_inv param_x=x goal=4
    #[5] real_inverse (real_inverse x) = x
  → rewrite target=fact eq_sym_eq sym=false goal=4 facts=[5]
    #[6] x = real_inverse (real_inverse x)
  ← rewrite source=prev goal=4 facts=[6]
    #[7] real_inverse (real_inverse x) ^ a ≤ real_inverse (real_inverse x) ^ b
  ← rewrite rpow_inv sym=false goal=7
    #[8] real_inverse (real_inverse x ^ a) ≤ real_inverse (real_inverse x ^ b)
  ← rule real_le_inv2 goal=8
    #[9] 0 < real_inverse x ^ b
    #[10] real_inverse x ^ b ≤ real_inverse x ^ a
  ← rule rpow_pos_lt goal=9
    #[11] 0 < real_inverse x
  ← rule real_lt_inv goal=11
  ← rule rpow_mono_le goal=10
    #[12] 1 ≤ real_inverse x
  ← rule real_inv_1_le goal=12 facts=[1,2]
    #[13] 1 ≤ real_inverse x
qed

theorem rpow_1_le
  fixes a :: real, x :: real
  prop 0 <= x --> x <= 1 --> 0 <= a --> x ^ a <= 1
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ 1
    #[3] 0 ≤ a
    #[4] x ^ a ≤ 1
  ← rule real_le_trans param_y="(1::real)^a" goal=4
    #[5] x ^ a ≤ 1 ^ a
    #[6] (1::real) ^ a ≤ 1
  ← rule rpow_le2 goal=5
  ← rewrite rpow_one sym=false goal=6
    #[7] (1::real) ≤ 1
  ← rule real_le_refl goal=7
    #[8] (1::real) ≤ 1
qed

theorem real_root_rpow
  fixes n :: nat, x :: real
  prop ~(n = 0) --> 0 <= x | odd n --> root n x = x ^ real_inverse (of_nat n)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 ≤ x ∨ odd n
    #[3] root n x = x ^ real_inverse (of_nat n)
  ← cases "x = 0" goal=3
    #[4] x = 0 ⟶ root n x = x ^ real_inverse (of_nat n)
    #[5] ¬(x = 0) ⟶ root n x = x ^ real_inverse (of_nat n)
  ← intro goal=4
    #[6] x = 0
    #[7] root n x = x ^ real_inverse (of_nat n)
  ← rewrite source=prev goal=7 facts=[6]
    #[8] root n 0 = 0 ^ real_inverse (of_nat n)
  ← rewrite root_0 sym=false goal=8
    #[9] (0::real) = 0 ^ real_inverse (of_nat n)
  ← rewrite rpow_zero sym=false goal=9
    #[10] (0::real) = (if real_inverse (of_nat n) = 0 then 1 else 0)
  cut "~(real_inverse (of_nat n) = 0)" goal=10
    #[11] ¬(real_inverse (of_nat n) = 0)
  ← rewrite real_inv_eq_0 sym=false goal=11
    #[12] ¬(of_nat n = (0::real))
  ← rewrite real_zero_def sym=false goal=12
    #[13] ¬((of_nat::nat ⇒ real) n = of_nat 0)
  ← rewrite real_of_nat_eq sym=false goal=13
  ← rewrite if_not_P sym=false goal=10 facts=[11]
  ← intro goal=5
    #[14] ¬(x = 0)
    #[15] root n x = x ^ real_inverse (of_nat n)
  ← cases "0 <= x" goal=15
    #[16] 0 ≤ x ⟶ root n x = x ^ real_inverse (of_nat n)
    #[17] ¬(0 ≤ x) ⟶ root n x = x ^ real_inverse (of_nat n)
  ← intro goal=16
    #[18] 0 ≤ x
    #[19] root n x = x ^ real_inverse (of_nat n)
  cut "0 < x" goal=19 facts=[18]
    #[20] 0 < x
  ← z3 goal=20 facts=[18,14]
    #[21] 0 < x
  → forward root_exp_log goal=19 facts=[1,21]
    #[22] root n x = exp (log x / of_nat n)
  ← rewrite source=prev goal=19 facts=[22]
    #[23] exp (log x / of_nat n) = x ^ real_inverse (of_nat n)
  ← rewrite real_real_power_def sym=false goal=23
    #[24] exp (log x / of_nat n) = (if 0 < x then exp (real_inverse (of_nat n) * log x) else if x = 0 then if real_inverse (of_nat n) = 0 then 1 else 0 else if ∃m. ∃n1. odd m ∧ odd n1 ∧ abs (real_inverse (of_nat n)) = of_nat m / of_nat n1 then -(exp (real_inverse (of_nat n) * log (-x))) else exp (real_inverse (of_nat n) * log (-x)))
  ← rewrite if_P sym=false goal=24 facts=[21]
    #[25] exp (log x / of_nat n) = exp (real_inverse (of_nat n) * log x)
  ← rewrite real_exp_inj sym=false goal=25
    #[26] log x / of_nat n = real_inverse (of_nat n) * log x
  ← rewrite real_divide_def sym=false goal=26
    #[27] log x * real_inverse (of_nat n) = real_inverse (of_nat n) * log x
  ← rule real_mult_comm goal=27
    #[28] log x * real_inverse (of_nat n) = real_inverse (of_nat n) * log x
  ← intro goal=17
    #[29] ¬(0 ≤ x)
    #[30] root n x = x ^ real_inverse (of_nat n)
  ← rule disjE goal=30 facts=[2]
    #[31] odd n ⟶ root n x = x ^ real_inverse (of_nat n)
  ← intro goal=31
    #[32] odd n
    #[33] root n x = x ^ real_inverse (of_nat n)
  cut "0 < -x" goal=33
    #[34] 0 < -x
  ← z3 goal=34 facts=[29]
    #[35] 0 < -x
  ← rewrite real_real_power_def sym=false goal=33
    #[36] root n x = (if 0 < x then exp (real_inverse (of_nat n) * log x) else if x = 0 then if real_inverse (of_nat n) = 0 then 1 else 0 else if ∃m. ∃n1. odd m ∧ odd n1 ∧ abs (real_inverse (of_nat n)) = of_nat m / of_nat n1 then -(exp (real_inverse (of_nat n) * log (-x))) else exp (real_inverse (of_nat n) * log (-x)))
  cut "~(0 <x)" goal=36
    #[37] ¬(0 < x)
  ← z3 goal=37 facts=[29]
    #[38] ¬(0 < x)
  ← rewrite if_not_P sym=false goal=36 facts=[38]
    #[39] root n x = (if x = 0 then if real_inverse (of_nat n) = 0 then 1 else 0 else if ∃m. ∃n1. odd m ∧ odd n1 ∧ abs (real_inverse (of_nat n)) = of_nat m / of_nat n1 then -(exp (real_inverse (of_nat n) * log (-x))) else exp (real_inverse (of_nat n) * log (-x)))
  ← rewrite if_not_P sym=false goal=39 facts=[14]
    #[40] root n x = (if ∃m. ∃n1. odd m ∧ odd n1 ∧ abs (real_inverse (of_nat n)) = of_nat m / of_nat n1 then -(exp (real_inverse (of_nat n) * log (-x))) else exp (real_inverse (of_nat n) * log (-x)))
  cut "∃m. ∃n1. odd m ∧ odd n1 ∧ abs (real_inverse (of_nat n)) = of_nat m / of_nat n1" goal=40
    #[41] ∃m. ∃n1. odd m ∧ odd n1 ∧ abs (real_inverse (of_nat n)) = of_nat m / of_nat n1
  ← inst "(1::nat)" goal=41
    #[42] ∃n1. odd 1 ∧ odd n1 ∧ abs (real_inverse (of_nat n)) = of_nat 1 / of_nat n1
  ← inst n goal=42
    #[43] odd 1 ∧ odd n ∧ abs (real_inverse (of_nat n)) = of_nat 1 / of_nat n
  ← rule conjI goal=43
    #[44] odd 1
    #[45] odd n ∧ abs (real_inverse (of_nat n)) = of_nat 1 / of_nat n
  ← rewrite nat_one_def sym=false goal=44
    #[46] odd (Suc 0)
  ← rewrite odd_def_2 sym=false goal=46
    #[47] ¬(odd 0)
  ← rewrite not_odd sym=false goal=47
    #[48] even 0
  ← rewrite even_def_1 sym=false goal=48
    #[49] true
  ← rule trueI goal=49
    #[50] true
  ← rule conjI goal=45
    #[51] abs (real_inverse (of_nat n)) = of_nat 1 / of_nat n
  ← rewrite real_divide_def sym=false goal=51
    #[52] abs (real_inverse (of_nat n)) = of_nat 1 * real_inverse (of_nat n)
  ← rewrite real_abs_inv sym=false goal=52
    #[53] real_inverse (abs (of_nat n)) = of_nat 1 * real_inverse (of_nat n)
  ← rewrite real_abs_nat sym=false goal=53
    #[54] real_inverse (of_nat n) = of_nat 1 * real_inverse (of_nat n)
  real_norm goal=54
    #[55] real_inverse (of_nat n) = of_nat 1 * real_inverse (of_nat n)
  ← rewrite if_P sym=false goal=40 facts=[41]
    #[56] root n x = -(exp (real_inverse (of_nat n) * log (-x)))
  ← rule root_unique goal=56
    #[57] -(exp (real_inverse (of_nat n) * log (-x))) ^ n = x
    #[58] odd n ∨ ¬(n = 0) ∧ 0 ≤ -(exp (real_inverse (of_nat n) * log (-x)))
  ← rewrite real_pow_neg sym=false goal=57
    #[59] (if even n then exp (real_inverse (of_nat n) * log (-x)) ^ n else -(exp (real_inverse (of_nat n) * log (-x)) ^ n)) = x
  ← rewrite not_odd sym=true goal=59
    #[60] (if ¬(odd n) then exp (real_inverse (of_nat n) * log (-x)) ^ n else -(exp (real_inverse (of_nat n) * log (-x)) ^ n)) = x
  ← rewrite if_not_P2 sym=false goal=60 facts=[32]
    #[61] -(exp (real_inverse (of_nat n) * log (-x)) ^ n) = x
  ← rewrite real_exp_n sym=true goal=61
    #[62] -(exp (of_nat n * (real_inverse (of_nat n) * log (-x)))) = x
  ← rewrite real_mult_assoc sym=false goal=62
    #[63] -(exp (of_nat n * real_inverse (of_nat n) * log (-x))) = x
  cut "of_nat n * real_inverse (of_nat n) = 1" goal=63
    #[64] of_nat n * real_inverse (of_nat n) = 1
  ← rewrite real_mult_comm sym=false goal=64
    #[65] real_inverse (of_nat n) * of_nat n = 1
  ← rule real_mul_linv goal=65
    #[66] ¬(of_nat n = (0::real))
  ← rewrite real_zero_def sym=false goal=66
    #[67] ¬((of_nat::nat ⇒ real) n = of_nat 0)
  ← rewrite real_of_nat_eq sym=false goal=67
  ← rewrite source=prev goal=63 facts=[64]
    #[68] -(exp (1 * log (-x))) = x
  ← rewrite real_mul_lid sym=false goal=68
