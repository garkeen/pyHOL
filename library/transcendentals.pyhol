  ← z3 goal=7 facts=[4]
  ← rewrite if_P sym=false goal=6 facts=[7]
    #[8] (if 0 < -x then exp (y * log (-x)) else if y = 0 then 1 else 0) = (if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(if 0 < x then exp (y * log x) else if y = 0 then 1 else 0) else if 0 < x then exp (y * log x) else if y = 0 then 1 else 0)
  cut "~(0 < -x)" goal=8
    #[9] ¬(0 < -x)
