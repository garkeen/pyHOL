  ← rewrite if_P sym=false goal=5 facts=[4]
    #[6] exp (of_nat n * log x) = x ^ n
  ← rewrite real_exp_n sym=false goal=6
    #[7] exp (log x) ^ n = x ^ n
  → forward exp_log goal=7 facts=[4]
    #[8] exp (log x) = x
  ← rewrite source=prev goal=7 facts=[8]
  ← intro goal=3
    #[9] ¬(0 < x)
