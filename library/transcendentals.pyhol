  ← rewrite source=prev goal=69 facts=[70]
    #[71] --x = x
  ← rewrite real_neg_neg sym=false goal=71
    #[72] --x = x
  ← rule disjI1 goal=58
qed

theorem log_rpow
  fixes x :: real, y :: real
  prop 0 < x --> log (x ^ y) = y * log x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] log (x ^ y) = y * log x
  ← rewrite real_real_power_def sym=false goal=2
    #[3] log (if 0 < x then exp (y * log x) else if x = 0 then if y = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = y * log x
  ← rewrite if_P sym=false goal=3 facts=[1]
    #[4] log (exp (y * log x)) = y * log x
  ← rewrite log_exp sym=false goal=4
    #[5] log (exp (y * log x)) = y * log x
qed

theorem log_sqrt
  fixes x :: real
  prop 0 < x --> log (sqrt x) = log x / 2
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] log (sqrt x) = log x / 2
  cut "x >=0" goal=2
    #[3] x ≥ 0
  ← z3 goal=3 facts=[1]
  → forward rpow_sqrt goal=2 facts=[3]
    #[4] sqrt x = x ^ (1 / 2)
  ← rewrite source=prev goal=2 facts=[4]
    #[5] log (x ^ (1 / 2)) = log x / 2
  → forward log_rpow param_y=1/2 goal=5 facts=[1]
    #[6] log (x ^ (1 / 2)) = 1 / 2 * log x
  ← rewrite source=prev goal=5 facts=[6]
    #[7] 1 / 2 * log x = log x / 2
  real_norm goal=7
    #[8] 1 / 2 * log x = log x / 2
qed

theorem rpow_add_integer
  fixes m :: real, n :: real, x :: real
  prop integer m --> integer n --> ~(x = 0 & m + n = 0 & ~(n = 0)) --> x ^ (m + n) = x ^ m * x ^ n
  [hint_backward,hint_backward1]

theorem real_max_rpow
  fixes x :: real, y :: real, z :: real
  prop 0 <= x --> 0 <= y --> 0 <= z --> max (x ^ z) (y ^ z) = max x y ^ z
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ y
    #[3] 0 ≤ z
    #[4] max (x ^ z) (y ^ z) = max x y ^ z
  ← rewrite max_def sym=false goal=4
    #[5] (if x ^ z ≤ y ^ z then y ^ z else x ^ z) = (if x ≤ y then y else x) ^ z
  → forward real_le_total param_x=x param_y=y goal=5
    #[6] x ≤ y ∨ y ≤ x
  ← rule disjE goal=5 facts=[6]
    #[7] x ≤ y ⟶ (if x ^ z ≤ y ^ z then y ^ z else x ^ z) = (if x ≤ y then y else x) ^ z
    #[8] y ≤ x ⟶ (if x ^ z ≤ y ^ z then y ^ z else x ^ z) = (if x ≤ y then y else x) ^ z
  ← intro goal=7
    #[9] x ≤ y
    #[10] (if x ^ z ≤ y ^ z then y ^ z else x ^ z) = (if x ≤ y then y else x) ^ z
  ← rewrite if_P sym=false goal=10 facts=[9]
    #[11] (if x ^ z ≤ y ^ z then y ^ z else x ^ z) = y ^ z
  cut "x ^ z ≤ y ^ z" goal=11
    #[12] x ^ z ≤ y ^ z
  ← rule rpow_le2 goal=12
  ← rewrite if_P sym=false goal=11 facts=[12]
  ← intro goal=8
    #[13] y ≤ x
    #[14] (if x ^ z ≤ y ^ z then y ^ z else x ^ z) = (if x ≤ y then y else x) ^ z
  cut "∀x::real. ∀y. (if x ≤ y then y else x) = (if y ≤ x then x else y)" goal=14
    #[15] ∀x::real. ∀y. (if x ≤ y then y else x) = (if y ≤ x then x else y)
  ← z3 goal=15
    #[16] ∀x::real. ∀y. (if x ≤ y then y else x) = (if y ≤ x then x else y)
  ← rewrite source=prev goal=14 facts=[16]
    #[17] (if y ^ z ≤ x ^ z then x ^ z else y ^ z) = (if y ≤ x then x else y) ^ z
  ← rewrite if_P sym=false goal=17 facts=[13]
    #[18] (if y ^ z ≤ x ^ z then x ^ z else y ^ z) = x ^ z
  cut "y ^ z ≤ x ^ z" goal=18
    #[19] y ^ z ≤ x ^ z
  ← rule rpow_le2 goal=19
  ← rewrite if_P sym=false goal=18 facts=[19]
qed

theorem real_min_rpow
  fixes x :: real, y :: real, z :: real
  prop 0 <= x --> 0 <= y --> 0 <= z --> min (x ^ z) (y ^ z) = min x y ^ z
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ y
    #[3] 0 ≤ z
    #[4] min (x ^ z) (y ^ z) = min x y ^ z
  → forward real_le_total param_x=x param_y=y goal=4
    #[5] x ≤ y ∨ y ≤ x
  ← rule disjE goal=4 facts=[5]
    #[6] x ≤ y ⟶ min (x ^ z) (y ^ z) = min x y ^ z
    #[7] y ≤ x ⟶ min (x ^ z) (y ^ z) = min x y ^ z
  ← intro goal=6
    #[8] x ≤ y
    #[9] min (x ^ z) (y ^ z) = min x y ^ z
  ← rewrite min_def sym=false goal=9
    #[10] (if x ^ z ≤ y ^ z then x ^ z else y ^ z) = (if x ≤ y then x else y) ^ z
  ← rewrite if_P sym=false goal=10 facts=[8]
    #[11] (if x ^ z ≤ y ^ z then x ^ z else y ^ z) = x ^ z
  cut "x ^ z ≤ y ^ z" goal=11
    #[12] x ^ z ≤ y ^ z
  ← rule rpow_le2 goal=12
  ← rewrite if_P sym=false goal=11 facts=[12]
  ← intro goal=7
    #[13] y ≤ x
    #[14] min (x ^ z) (y ^ z) = min x y ^ z
  cut "!x::real. !y. min x y = min y x" goal=14
    #[15] ∀x::real. ∀y. min x y = min y x
  ← z3 goal=15
    #[16] ∀x::real. ∀y. min x y = min y x
  ← rewrite source=prev goal=14 facts=[16]
    #[17] min (y ^ z) (x ^ z) = min y x ^ z
  ← rewrite min_def sym=false goal=17
    #[18] (if y ^ z ≤ x ^ z then y ^ z else x ^ z) = (if y ≤ x then y else x) ^ z
  ← rewrite if_P sym=false goal=18 facts=[13]
    #[19] (if y ^ z ≤ x ^ z then y ^ z else x ^ z) = y ^ z
  cut "y ^ z ≤ x ^ z" goal=19
    #[20] y ^ z ≤ x ^ z
  ← rule rpow_le2 goal=20
  ← rewrite if_P sym=false goal=19 facts=[20]
qed

theorem rpow_rpow_nat1
  fixes m :: nat, n :: real, x :: real
  prop x >= 0 --> x ^ m ^ n = x ^ (of_nat m * n)
proof
  ← intro goal=0
    #[1] x ≥ 0
    #[2] x ^ m ^ n = x ^ (of_nat m * n)
  ← rewrite rpow_pow sym=true goal=2
    #[3] x ^ (of_nat::nat ⇒ real) m ^ n = x ^ (of_nat m * n)
  ← rule rpow_rpow goal=3
    #[4] 0 ≤ x
  ← z3 goal=4 facts=[1]
qed

theorem rpow_rpow_nat2
  fixes m :: real, n :: nat, x :: real
  prop x >= 0 --> x ^ m ^ n = x ^ (m * of_nat n)
proof
  ← intro goal=0
    #[1] x ≥ 0
    #[2] x ^ m ^ n = x ^ (m * of_nat n)
  ← rewrite rpow_pow sym=true goal=2
    #[3] x ^ m ^ (of_nat::nat ⇒ real) n = x ^ (m * of_nat n)
  ← rule rpow_rpow goal=3
    #[4] 0 ≤ x
  ← z3 goal=4 facts=[1]
qed

theorem rpow_base_divide
  fixes x :: real, y :: real, z :: real
  prop x > 0 --> y > 0 --> (x / y) ^ z = x ^ z / y ^ z
proof
  ← intro goal=0
    #[1] x > 0
    #[2] y > 0
    #[3] (x / y) ^ z = x ^ z / y ^ z
  ← rewrite rpow_div sym=false goal=3
    #[4] (x / y) ^ z = x ^ z / y ^ z
qed

