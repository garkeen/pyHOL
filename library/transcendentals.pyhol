theorem circle_sincos
  fixes x :: real, y :: real
  prop x ^ (2::nat) + y ^ (2::nat) = 1 ⟶ (∃t. x = cos t ∧ y = sin t)
  [hint_backward]
  proof
    1: apply_forward_step sincos_total_2pi @0
    2: exists_elim t @1
    4: inst_exists_goal t
    4: apply_forward_step conjD2 @3
    5: apply_backward_step conjD2 @4
  qed

theorem sin_integer_2pi
  fixes n :: real
  prop integer n ⟶ sin (2 * pi * n) = 0
  [hint_backward]
  proof
    1: cut "2 * pi * n = 2 * n * pi"
    1: real_norm
    2: rewrite_goal_with_prev @1
    2: rewrite_goal sin_pimul_eq_0 sym=false
    2: rewrite_goal real_mul_2 sym=false
    2: apply_backward_step integer_add
  qed

theorem sin_integer_pi
  fixes n :: real
  prop integer n ⟶ sin (n * pi) = 0
  [hint_backward]
  proof
    1: rewrite_goal sin_pimul_eq_0 sym=false
  qed

theorem cos_integer_2pi
  fixes n :: real
  prop integer n ⟶ cos (2 * pi * n) = 1
  [hint_backward]
  proof
    1: rewrite_goal cos_one_2pi sym=false
    1: rewrite_fact integer_cases @0 sym=false
    2: apply_backward_step disjE @1
    2: introduction
    2.1: apply_backward_step disjI1
    2.1: exists_elim m @2.0
    2.3: inst_exists_goal m
