theory transcendentals
imports real, metric
description "Real transcendentals."

const infsum :: nat set ⇒ (nat ⇒ 'a) ⇒ 'a

def exp :: real ⇒ real = exp x = infsum (from 0) (λn. x ^ n / of_nat (fact n)) [hint_rewrite]

theorem real_exp_add
  fixes x :: real, y :: real
  prop exp (x + y) = exp x * exp y
  [hint_rewrite,hint_rewrite_sym]

theorem real_exp_0
  prop exp 0 = 1
  [hint_rewrite]

theorem real_exp_nz
  fixes x :: real
  prop ~(exp x = 0)
  [hint_backward]

theorem real_exp_add_mul
  fixes x :: real, y :: real
  prop exp (x + y) * exp (-x) = exp y
  [hint_rewrite]
proof
  ← rewrite real_exp_add sym=true goal=0
    #[1] exp (x + y + -x) = exp y
  cut "x + y + -x = y" goal=1
    #[2] x + y + -x = y
  real_norm goal=2
  ← rewrite source=prev goal=1 facts=[2]
qed

theorem real_exp_neg_mul
  fixes x :: real
  prop exp x * exp (-x) = 1
  [hint_rewrite]
proof
  ← rewrite real_exp_add sym=true goal=0
    #[1] exp (x + -x) = 1
  ← rewrite real_add_rinv sym=false goal=1
    #[2] exp 0 = 1
  ← rewrite real_exp_0 sym=false goal=2
qed

theorem real_exp_neg
  fixes x :: real
  prop exp (-x) = real_inverse (exp x)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_mul_lid sym=true goal=0
    #[1] 1 * exp (-x) = 1 * real_inverse (exp x)
  ← rewrite real_mult_comm sym=false goal=1
    #[2] exp (-x) * 1 = real_inverse (exp x) * 1
  → forward real_exp_neg_mul param_x=x goal=2
    #[3] exp x * exp (-x) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=2 facts=[3]
    #[4] 1 = exp x * exp (-x)
  ← rewrite source=prev goal=2 facts=[4]
    #[5] exp (-x) * (exp x * exp (-x)) = real_inverse (exp x) * (exp x * exp (-x))
  ← rewrite real_mult_assoc sym=false goal=5
    #[6] exp (-x) * exp x * exp (-x) = real_inverse (exp x) * exp x * exp (-x)
  → forward real_exp_nz param_x=x goal=6
    #[7] ¬(exp x = 0)
  → forward real_mul_linv goal=6 facts=[7]
    #[8] real_inverse (exp x) * exp x = 1
  ← rewrite source=prev goal=6 facts=[8]
    #[9] exp (-x) * exp x * exp (-x) = 1 * exp (-x)
  ← rewrite real_mult_assoc sym=true goal=9
    #[10] exp (-x) * (exp x * exp (-x)) = 1 * exp (-x)
  ← rewrite real_exp_neg_mul sym=false goal=10
    #[11] exp (-x) * 1 = 1 * exp (-x)
  ← rule real_mult_comm goal=11
qed

theorem real_exp_n
  fixes n :: nat, x :: real
  prop exp (of_nat n * x) = exp x ^ n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct n nat_induct goal=0
    #[1] exp (of_nat 0 * x) = exp x ^ (0::nat)
    #[2] ∀n. exp (of_nat n * x) = exp x ^ n ⟶ exp (of_nat (Suc n) * x) = exp x ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] exp (of_nat 0 * x) = 1
  ← rewrite real_zero_def sym=true goal=3
    #[4] exp (0 * x) = 1
  ← rewrite real_mul_lzero sym=false goal=4
    #[5] exp 0 = 1
  ← rewrite real_exp_0 sym=false goal=5
  ← intro n goal=2
    #[6] _VAR n
    #[7] exp (of_nat n * x) = exp x ^ n
    #[8] exp (of_nat (Suc n) * x) = exp x ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=8
    #[9] exp (of_nat (Suc n) * x) = exp x * exp x ^ n
  ← rewrite add_1_right sym=true goal=9
    #[10] exp (of_nat (n + 1) * x) = exp x * exp x ^ n
  ← rewrite real_of_nat_add sym=true goal=10
    #[11] exp ((of_nat n + of_nat 1) * x) = exp x * exp x ^ n
  ← rewrite real_one_def sym=true goal=11
    #[12] exp ((of_nat n + 1) * x) = exp x * exp x ^ n
  ← rewrite real_add_comm sym=false goal=12
    #[13] exp ((1 + of_nat n) * x) = exp x * exp x ^ n
  ← rewrite real_add_rdistrib sym=false goal=13
    #[14] exp (1 * x + of_nat n * x) = exp x * exp x ^ n
  ← rewrite real_mul_lid sym=false goal=14
    #[15] exp (x + of_nat n * x) = exp x * exp x ^ n
  ← rewrite real_exp_add sym=false goal=15
    #[16] exp x * exp (of_nat n * x) = exp x * exp x ^ n
  ← rewrite source=prev goal=16 facts=[7]
qed

theorem real_exp_n_sym
  fixes n :: nat, x :: real
  prop exp x ^ n = exp (of_nat n * x)
proof
  ← rewrite real_exp_n sym=true goal=0
qed

theorem real_exp_sub
  fixes x :: real, y :: real
  prop exp (x - y) = exp x / exp y
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_minus_def sym=false goal=0
    #[1] exp (x + -y) = exp x / exp y
  ← rewrite real_exp_add sym=false goal=1
    #[2] exp x * exp (-y) = exp x / exp y
  ← rewrite real_exp_neg sym=false goal=2
    #[3] exp x * real_inverse (exp y) = exp x / exp y
  ← rewrite real_divide_def sym=false goal=3
qed

theorem real_exp_pos_le
  fixes x :: real
  prop 0 <= exp x
  [hint_backward]
proof
  cut "x = x/2 + x/2" goal=0
    #[1] x = x / 2 + x / 2
  ← z3 goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] 0 ≤ exp (x / 2 + x / 2)
  ← rewrite real_exp_add sym=false goal=2
    #[3] 0 ≤ exp (x / 2) * exp (x / 2)
  ← rule real_le_square goal=3
qed

theorem real_exp_pos_lt
  fixes x :: real
  prop 0 < exp x
  [hint_backward]
proof
  ← rewrite real_lt_le sym=false goal=0
    #[1] 0 ≤ exp x ∧ ¬(0 = exp x)
  ← rule conjI goal=1
    #[2] 0 ≤ exp x
    #[3] ¬(0 = exp x)
  ← rule real_exp_pos_le goal=2
  ← rewrite eq_sym_eq sym=false goal=3
    #[4] ¬(exp x = 0)
  ← rule real_exp_nz goal=4
qed

theorem real_exp_le_x
  fixes x :: real
  prop 1 + x <= exp x
  [hint_backward]
proof
  ← cases "1 + x < 0" goal=0
    #[1] 1 + x < 0 ⟶ 1 + x ≤ exp x
    #[2] ¬(1 + x < 0) ⟶ 1 + x ≤ exp x
  ← intro goal=1
    #[3] 1 + x < 0
    #[4] 1 + x ≤ exp x
  ← rule real_le_trans param_y="(0::real)" goal=4
    #[5] 1 + x ≤ 0
    #[6] 0 ≤ exp x
  ← rule real_lt_imp_le goal=5
  ← rule real_exp_pos_le goal=6
    #[7] 0 ≤ exp x
  ← intro goal=2
    #[8] ¬(1 + x < 0)
    #[9] 1 + x ≤ exp x
  ← rewrite exp_def sym=false goal=9
    #[10] 1 + x ≤ infsum (from 0) (λn. x ^ n / of_nat (fact n))
qed

theorem real_exp_lt_1
  fixes x :: real
  prop 0 < x --> 1 < exp x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 1 < exp x
  → forward real_exp_le_x param_x=x goal=2
    #[3] 1 + x ≤ exp x
  ← rule real_lte_trans param_y=1+x goal=2
    #[4] 1 < 1 + x
  ← z3 goal=4 facts=[1]
qed

theorem real_exp_mono_imp
  fixes x :: real, y :: real
  prop x < y --> exp x < exp y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x < y
    #[2] exp x < exp y
  → rewrite target=fact real_sub_lt sym=true goal=2 facts=[1]
    #[3] 0 < y - x
  → forward real_exp_lt_1 goal=2 facts=[3]
    #[4] 1 < exp (y - x)
  → rewrite target=fact real_exp_sub sym=false goal=2 facts=[4]
    #[5] 1 < exp y / exp x
  cut "!a::real. !b. 0 < a --> 1 < b / a --> a < b" goal=2
    #[6] ∀a. ∀b. 0 < a ⟶ 1 < b / a ⟶ a < b
  ← z3 goal=6
    #[7] ∀a. ∀b. 0 < a ⟶ 1 < b / a ⟶ a < b
  ← apply_prev goal=2 facts=[7]
    #[8] 0 < exp x
  ← rule real_exp_pos_lt goal=8
    #[9] 0 < exp x
qed

theorem real_exp_mono_lt
  fixes x :: real, y :: real
  prop exp x < exp y <--> x < y
  [hint_rewrite]
proof
  cut "!a::real. !b. !c::real. !d. (a < b --> c < d) --> (a = b --> c = d) --> (b < a --> d < c) --> (c < d <--> a < b)" goal=0
    #[1] ∀a::real. ∀b. ∀c::real. ∀d. (a < b ⟶ c < d) ⟶ (a = b ⟶ c = d) ⟶ (b < a ⟶ d < c) ⟶ c < d ⟷ a < b
  ← z3 goal=1
  ← apply_prev goal=0 facts=[1]
    #[2] x < y ⟶ exp x < exp y
    #[3] x = y ⟶ exp x = exp y
    #[4] y < x ⟶ exp y < exp x
  ← intro goal=2
    #[5] x < y
    #[6] exp x < exp y
  ← rule real_exp_mono_imp goal=6 facts=[5]
  ← intro goal=3
    #[7] x = y
    #[8] exp x = exp y
  ← rewrite source=prev goal=8 facts=[7]
  ← intro goal=4
    #[9] y < x
    #[10] exp y < exp x
  ← rule real_exp_mono_imp goal=10 facts=[9]
qed

theorem real_exp_mono_le
  fixes x :: real, y :: real
  prop exp x <= exp y <--> x <= y
  [hint_rewrite]
proof
  ← rewrite real_not_lt sym=true goal=0
    #[1] ¬(exp y < exp x) ⟷ ¬(y < x)
  ← rewrite real_exp_mono_lt sym=false goal=1
qed

theorem real_exp_inj
  fixes x :: real, y :: real
  prop exp x = exp y <--> x = y
  [hint_rewrite]
proof
  ← rewrite real_le_antisym sym=true goal=0
    #[1] exp x ≤ exp y ∧ exp y ≤ exp x ⟷ x ≤ y ∧ y ≤ x
  ← rewrite real_exp_mono_le sym=false goal=1
qed

theorem real_exp_eq_1
  fixes x :: real
  prop exp x = 1 <--> x = 0
  [hint_rewrite]
proof
  ← rewrite real_exp_0 sym=true goal=0
    #[1] exp x = exp 0 ⟷ x = 0
  ← rewrite real_exp_inj sym=false goal=1
qed

theorem real_abs_exp
  fixes x :: real
  prop abs (exp x) = exp x
  [hint_rewrite]
proof
  ← rewrite abs_def sym=false goal=0
    #[1] (if 0 ≤ exp x then exp x else -(exp x)) = exp x
  cut "0 ≤ exp x" goal=1
    #[2] 0 ≤ exp x
  ← rule real_exp_pos_le goal=2
  ← rewrite if_P sym=false goal=1 facts=[2]
qed

theorem real_exp_sum
  fixes f :: 'a => real, s :: 'a set
  prop finite s --> exp (sum s f) = product s (%x. exp (f x))
  [hint_backward]

theorem real_exp_bound_lemma
  fixes x :: real
  prop 0 <= x --> x <= real_inverse 2 --> exp x <= 1 + 2 * x
  [hint_backward,hint_backward1]

def cos :: real ⇒ real = cos x = infsum (from 0) (λn. if even n then -1 ^ (n DIV 2) * x ^ n / of_nat (fact n) else 0)

def sin :: real ⇒ real = sin x = infsum (from 0) (λn. if even n then 0 else -1 ^ ((n - 1) DIV 2) * x ^ n / of_nat (fact n))

theorem sin_circle
  fixes x :: real
  prop sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  [hint_rewrite]

theorem sin_circle2
  fixes x :: real
  prop sin x ^ (2::nat) = 1 - cos x ^ (2::nat)
proof
  → forward sin_circle param_x=x goal=0
    #[1] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=0 facts=[1]
    #[2] 1 = sin x ^ (2::nat) + cos x ^ (2::nat)
  ← rewrite source=prev goal=0 facts=[2]
    #[3] sin x ^ (2::nat) = sin x ^ (2::nat) + cos x ^ (2::nat) - cos x ^ (2::nat)
  real_norm goal=3
qed

theorem sin_circle3
  fixes x :: real
  prop cos x ^ (2::nat) = 1 - sin x ^ (2::nat)
proof
  → forward sin_circle param_x=x goal=0
    #[1] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=0 facts=[1]
    #[2] 1 = sin x ^ (2::nat) + cos x ^ (2::nat)
  ← rewrite source=prev goal=0 facts=[2]
    #[3] cos x ^ (2::nat) = sin x ^ (2::nat) + cos x ^ (2::nat) - sin x ^ (2::nat)
  real_norm goal=3
qed

theorem sin_add
  fixes x :: real, y :: real
  prop sin (x + y) = sin x * cos y + cos x * sin y
  [hint_rewrite]

theorem cos_add
  fixes x :: real, y :: real
  prop cos (x + y) = cos x * cos y - sin x * sin y
  [hint_rewrite]

theorem sin_neg
  fixes x :: real
  prop sin (-x) = -(sin x)
  [hint_rewrite]

theorem sin_neg_alt
  fixes c :: real, x :: real
  prop sin (-c * x) = -(sin (c * x))
proof
  ← rewrite real_mul_lneg sym=false goal=0
    #[1] sin (-(c * x)) = -(sin (c * x))
  ← rewrite sin_neg sym=false goal=1
qed

theorem cos_neg
  fixes x :: real
  prop cos (-x) = cos x
  [hint_rewrite]

theorem cos_neg_alt
  fixes c :: real, x :: real
  prop cos (-c * x) = cos (c * x)
proof
  ← rewrite real_mul_lneg sym=false goal=0
    #[1] cos (-(c * x)) = cos (c * x)
  ← rewrite cos_neg sym=false goal=1
qed

theorem sin_double
  fixes x :: real
  prop sin (2 * x) = 2 * sin x * cos x
  [hint_rewrite]
proof
  ← rewrite real_mul_2 sym=false goal=0
    #[1] sin (x + x) = (sin x + sin x) * cos x
  ← rewrite sin_add sym=false goal=1
    #[2] sin x * cos x + cos x * sin x = (sin x + sin x) * cos x
  real_norm goal=2
qed

theorem cos_double
  fixes x :: real
  prop cos (2 * x) = cos x ^ (2::nat) - sin x ^ (2::nat)
  [hint_rewrite]
proof
  ← rewrite real_mul_2 sym=false goal=0
    #[1] cos (x + x) = cos x ^ (2::nat) - sin x ^ (2::nat)
  ← rewrite cos_add sym=false goal=1
    #[2] cos x * cos x - sin x * sin x = cos x ^ (2::nat) - sin x ^ (2::nat)
  ← rewrite real_pow_2 sym=false goal=2
qed

theorem cos_double_cos
  fixes x :: real
  prop cos (2 * x) = 2 * cos x ^ (2::nat) - 1
  [hint_rewrite]
proof
  ← rewrite cos_double sym=false goal=0
    #[1] cos x ^ (2::nat) - sin x ^ (2::nat) = 2 * cos x ^ (2::nat) - 1
  → forward sin_circle param_x=x goal=1
    #[2] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=1 facts=[2]
    #[3] 1 = sin x ^ (2::nat) + cos x ^ (2::nat)
  ← rewrite source=prev goal=1 facts=[3]
    #[4] cos x ^ (2::nat) - sin x ^ (2::nat) = 2 * cos x ^ (2::nat) - (sin x ^ (2::nat) + cos x ^ (2::nat))
  real_norm goal=4
qed

theorem cos_lower_degree
  fixes x :: real
  prop cos x ^ (2::nat) = 1 / 2 * cos (2 * x) + 1 / 2
proof
  ← rewrite cos_double_cos sym=false goal=0
    #[1] cos x ^ (2::nat) = 1 / 2 * (2 * cos x ^ (2::nat) - 1) + 1 / 2
  real_norm goal=1
qed

theorem sin_bound
  fixes x :: real
  prop abs (sin x) <= 1
  [hint_backward]
proof
  → forward real_abs_nat param_n="(1::nat)" goal=0
    #[1] (abs::real ⇒ real) of_nat 1 = of_nat 1
  → rewrite target=fact real_one_def sym=true goal=0 facts=[1]
    #[2] abs (1::real) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=0 facts=[2]
    #[3] (1::real) = abs 1
  ← rewrite source=prev goal=0 facts=[3]
    #[4] abs (sin x) ≤ abs 1
  ← rewrite real_le_square_abs sym=false goal=4
    #[5] sin x ^ (2::nat) ≤ 1 ^ (2::nat)
  → forward sin_circle param_x=x goal=5
    #[6] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → forward real_le_square param_x="cos x" goal=5
    #[7] 0 ≤ cos x * cos x
  ← rewrite real_pow_2 sym=false goal=5
    #[8] sin x * sin x ≤ 1 * 1
  ← rewrite real_mul_lid sym=false goal=8
    #[9] sin x * sin x ≤ 1
  → rewrite target=fact real_pow_2 sym=false goal=9 facts=[6]
    #[10] sin x * sin x + cos x * cos x = 1
  → rewrite target=fact eq_sym_eq sym=false goal=9 facts=[10]
    #[11] 1 = sin x * sin x + cos x * cos x
  ← rewrite source=prev goal=9 facts=[11]
    #[12] sin x * sin x ≤ sin x * sin x + cos x * cos x
  cut "!a::real. !b. 0 <= b --> a <= a + b " goal=12
    #[13] ∀a::real. ∀b. 0 ≤ b ⟶ a ≤ a + b
  ← z3 goal=13
  ← apply_prev goal=12 facts=[13]
qed

theorem cos_bound
  fixes x :: real
  prop abs (cos x) <= 1
  [hint_backward]
proof
  ← rewrite real_one_def sym=false goal=0
    #[1] abs (cos x) ≤ of_nat 1
  ← rewrite real_abs_nat sym=true goal=1
    #[2] abs (cos x) ≤ abs of_nat 1
  ← rewrite real_le_square_abs sym=false goal=2
    #[3] cos x ^ (2::nat) ≤ of_nat 1 ^ (2::nat)
  ← rewrite real_one_def sym=true goal=3
    #[4] cos x ^ (2::nat) ≤ 1 ^ (2::nat)
  ← rewrite real_pow_one sym=false goal=4
    #[5] cos x ^ (2::nat) ≤ 1
  → forward sin_circle param_x=x goal=5
    #[6] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=5 facts=[6]
    #[7] 1 = sin x ^ (2::nat) + cos x ^ (2::nat)
  ← rewrite source=prev goal=5 facts=[7]
    #[8] cos x ^ (2::nat) ≤ sin x ^ (2::nat) + cos x ^ (2::nat)
  cut "!a::real. !b. 0 <= b --> a <= b + a" goal=8
    #[9] ∀a::real. ∀b. 0 ≤ b ⟶ a ≤ b + a
  ← z3 goal=9
  ← apply_prev goal=8 facts=[9]
    #[10] 0 ≤ sin x ^ (2::nat)
  ← rule real_le_pow_2 goal=10
qed

theorem sin_lbound
  fixes x :: real
  prop -1 <= sin x
  [hint_backward]
proof
  → forward sin_bound param_x=x goal=0
    #[1] abs (sin x) ≤ 1
  → rewrite target=fact real_abs_bounds sym=false goal=0 facts=[1]
    #[2] -1 ≤ sin x ∧ sin x ≤ 1
  ← rule conjD1 goal=0 facts=[2]
qed

theorem sin_ubound
  fixes x :: real
  prop sin x <= 1
  [hint_backward]
proof
  → forward sin_bound param_x=x goal=0
    #[1] abs (sin x) ≤ 1
  → rewrite target=fact real_abs_bounds sym=false goal=0 facts=[1]
    #[2] -1 ≤ sin x ∧ sin x ≤ 1
  ← rule conjD2 goal=0 facts=[2]
qed

theorem cos_lbound
  fixes x :: real
  prop -1 <= cos x
  [hint_backward]
proof
  → forward cos_bound param_x=x goal=0
    #[1] abs (cos x) ≤ 1
  → rewrite target=fact real_abs_bounds sym=false goal=0 facts=[1]
    #[2] -1 ≤ cos x ∧ cos x ≤ 1
  ← rule conjD1 goal=0 facts=[2]
qed

theorem cos_ubound
  fixes x :: real
  prop cos x <= 1
  [hint_backward]
proof
  → forward cos_bound param_x=x goal=0
    #[1] abs (cos x) ≤ 1
  → rewrite target=fact real_abs_bounds sym=false goal=0 facts=[1]
    #[2] -1 ≤ cos x ∧ cos x ≤ 1
  ← rule conjD2 goal=0 facts=[2]
qed

theorem cos_abs
  fixes x :: real
  prop cos (abs x) = cos x
  [hint_rewrite]
proof
  ← rewrite abs_def sym=false goal=0
    #[1] cos (if 0 ≤ x then x else -x) = cos x
  ← cases "0 ≤ x" goal=1
    #[2] 0 ≤ x ⟶ cos (if 0 ≤ x then x else -x) = cos x
    #[3] ¬(0 ≤ x) ⟶ cos (if 0 ≤ x then x else -x) = cos x
  ← intro goal=2
    #[4] 0 ≤ x
    #[5] cos (if 0 ≤ x then x else -x) = cos x
  ← rewrite if_P sym=false goal=5 facts=[4]
  ← intro goal=3
    #[6] ¬(0 ≤ x)
    #[7] cos (if 0 ≤ x then x else -x) = cos x
  ← rewrite if_not_P sym=false goal=7 facts=[6]
    #[8] cos (-x) = cos x
  ← rewrite cos_neg sym=false goal=8
    #[9] cos (-x) = cos x
qed

theorem sin_sub
  fixes x :: real, y :: real
  prop sin (x - y) = sin x * cos y - cos x * sin y
  [hint_rewrite]
proof
  ← rewrite real_minus_def sym=false goal=0
    #[1] sin (x + -y) = sin x * cos y + -(cos x * sin y)
  ← rewrite sin_add sym=false goal=1
    #[2] sin x * cos (-y) + cos x * sin (-y) = sin x * cos y + -(cos x * sin y)
  ← rewrite cos_neg sym=false goal=2
    #[3] sin x * cos y + cos x * sin (-y) = sin x * cos y + -(cos x * sin y)
  ← rewrite sin_neg sym=false goal=3
    #[4] sin x * cos y + cos x * -(sin y) = sin x * cos y + -(cos x * sin y)
  ← rewrite real_mul_rneg sym=false goal=4
qed

theorem cos_sub
  fixes x :: real, y :: real
  prop cos (x - y) = cos x * cos y + sin x * sin y
  [hint_rewrite]
proof
  ← rewrite real_minus_def sym=false goal=0
    #[1] cos (x + -y) = cos x * cos y + sin x * sin y
  ← rewrite cos_add sym=false goal=1
    #[2] cos x * cos (-y) - sin x * sin (-y) = cos x * cos y + sin x * sin y
  ← rewrite cos_neg sym=false goal=2
    #[3] cos x * cos y - sin x * sin (-y) = cos x * cos y + sin x * sin y
  ← rewrite sin_neg sym=false goal=3
    #[4] cos x * cos y - sin x * -(sin y) = cos x * cos y + sin x * sin y
  real_norm goal=4
qed

theorem real_mul_sin_sin
  fixes x :: real, y :: real
  prop sin x * sin y = (cos (x - y) - cos (x + y)) / 2
  [hint_rewrite]
proof
  ← rewrite cos_add sym=false goal=0
    #[1] sin x * sin y = (cos (x - y) - (cos x * cos y - sin x * sin y)) / 2
  ← rewrite cos_sub sym=false goal=1
    #[2] sin x * sin y = (cos x * cos y + sin x * sin y - (cos x * cos y - sin x * sin y)) / 2
  real_norm goal=2
qed

theorem real_mul_sin_cos
  fixes x :: real, y :: real
  prop sin x * cos y = (sin (x + y) + sin (x - y)) / 2
  [hint_rewrite]
proof
  ← rewrite sin_add sym=false goal=0
    #[1] sin x * cos y = (sin x * cos y + cos x * sin y + sin (x - y)) / 2
  ← rewrite sin_sub sym=false goal=1
    #[2] sin x * cos y = (sin x * cos y + cos x * sin y + (sin x * cos y - cos x * sin y)) / 2
  real_norm goal=2
qed

theorem real_mul_cos_sin
  fixes x :: real, y :: real
  prop cos x * sin y = (sin (x + y) - sin (x - y)) / 2
  [hint_rewrite]
proof
  ← rewrite sin_add sym=false goal=0
    #[1] cos x * sin y = (sin x * cos y + cos x * sin y - sin (x - y)) / 2
  ← rewrite sin_sub sym=false goal=1
    #[2] cos x * sin y = (sin x * cos y + cos x * sin y - (sin x * cos y - cos x * sin y)) / 2
  real_norm goal=2
qed

theorem real_mul_cos_cos
  fixes x :: real, y :: real
  prop cos x * cos y = (cos (x - y) + cos (x + y)) / 2
  [hint_rewrite]
proof
  ← rewrite cos_add sym=false goal=0
    #[1] cos x * cos y = (cos (x - y) + (cos x * cos y - sin x * sin y)) / 2
  ← rewrite cos_sub sym=false goal=1
    #[2] cos x * cos y = (cos x * cos y + sin x * sin y + (cos x * cos y - sin x * sin y)) / 2
  real_norm goal=2
qed

theorem real_add_sin
  fixes x :: real, y :: real
  prop sin x + sin y = 2 * sin ((x + y) / 2) * cos ((x - y) / 2)
  [hint_rewrite]
proof
  ← rewrite real_mult_assoc sym=true goal=0
    #[1] sin x + sin y = 2 * (sin ((x + y) / 2) * cos ((x - y) / 2))
  ← rewrite real_mul_sin_cos sym=false goal=1
    #[2] sin x + sin y = 2 * ((sin ((x + y) / 2 + (x - y) / 2) + sin ((x + y) / 2 - (x - y) / 2)) / 2)
  cut "((x + y) / 2 + (x - y) / 2) = x" goal=2
    #[3] (x + y) / 2 + (x - y) / 2 = x
  real_norm goal=3
  cut "(x + y) / 2 - (x - y) / 2 = y" goal=2
    #[4] (x + y) / 2 - (x - y) / 2 = y
  real_norm goal=4
  ← rewrite source=prev goal=2 facts=[3]
    #[5] sin x + sin y = 2 * ((sin x + sin ((x + y) / 2 - (x - y) / 2)) / 2)
  ← rewrite source=prev goal=5 facts=[4]
    #[6] sin x + sin y = 2 * ((sin x + sin y) / 2)
  real_norm goal=6
qed

theorem real_sub_sin
  fixes x :: real, y :: real
  prop sin x - sin y = 2 * sin ((x - y) / 2) * cos ((x + y) / 2)
  [hint_rewrite]
proof
  ← rewrite real_mult_assoc sym=true goal=0
    #[1] sin x - sin y = 2 * (sin ((x - y) / 2) * cos ((x + y) / 2))
  ← rewrite real_mul_sin_cos sym=false goal=1
    #[2] sin x - sin y = 2 * ((sin ((x - y) / 2 + (x + y) / 2) + sin ((x - y) / 2 - (x + y) / 2)) / 2)
  cut "(x - y) / 2 + (x + y) / 2 = x" goal=2
    #[3] (x - y) / 2 + (x + y) / 2 = x
  real_norm goal=3
  cut "(x - y) / 2 - (x + y) / 2 = -y" goal=2
    #[4] (x - y) / 2 - (x + y) / 2 = -y
  real_norm goal=4
  ← rewrite source=prev goal=2 facts=[3]
    #[5] sin x - sin y = 2 * ((sin x + sin ((x - y) / 2 - (x + y) / 2)) / 2)
  ← rewrite source=prev goal=5 facts=[4]
    #[6] sin x - sin y = 2 * ((sin x + sin (-y)) / 2)
  ← rewrite sin_neg sym=false goal=6
    #[7] sin x - sin y = 2 * ((sin x + -(sin y)) / 2)
  real_norm goal=7
qed

theorem real_add_cos
  fixes x :: real, y :: real
  prop cos x + cos y = 2 * cos ((x + y) / 2) * cos ((x - y) / 2)
  [hint_rewrite]
proof
  ← rewrite real_mult_assoc sym=true goal=0
    #[1] cos x + cos y = 2 * (cos ((x + y) / 2) * cos ((x - y) / 2))
  ← rewrite real_mul_cos_cos sym=false goal=1
    #[2] cos x + cos y = 2 * ((cos ((x + y) / 2 - (x - y) / 2) + cos ((x + y) / 2 + (x - y) / 2)) / 2)
  cut "(x + y) / 2 - (x - y) / 2 = y" goal=2
    #[3] (x + y) / 2 - (x - y) / 2 = y
  real_norm goal=3
  cut "(x + y) / 2 + (x - y) / 2 = x" goal=2
    #[4] (x + y) / 2 + (x - y) / 2 = x
  real_norm goal=4
  ← rewrite source=prev goal=2 facts=[3]
    #[5] cos x + cos y = 2 * ((cos y + cos ((x + y) / 2 + (x - y) / 2)) / 2)
  ← rewrite source=prev goal=5 facts=[4]
    #[6] cos x + cos y = 2 * ((cos y + cos x) / 2)
  real_norm goal=6
qed

theorem real_sub_cos
  fixes x :: real, y :: real
  prop cos x - cos y = 2 * sin ((x + y) / 2) * sin ((y - x) / 2)
  [hint_rewrite]
proof
  ← rewrite real_mult_assoc sym=true goal=0
    #[1] cos x - cos y = 2 * (sin ((x + y) / 2) * sin ((y - x) / 2))
  ← rewrite real_mul_sin_sin sym=false goal=1
    #[2] cos x - cos y = 2 * ((cos ((x + y) / 2 - (y - x) / 2) - cos ((x + y) / 2 + (y - x) / 2)) / 2)
  cut "(x + y) / 2 - (y - x) / 2 = x" goal=2
    #[3] (x + y) / 2 - (y - x) / 2 = x
  real_norm goal=3
  cut "(x + y) / 2 + (y - x) / 2 = y" goal=2
    #[4] (x + y) / 2 + (y - x) / 2 = y
  real_norm goal=4
  ← rewrite source=prev goal=2 facts=[3]
    #[5] cos x - cos y = 2 * ((cos x - cos ((x + y) / 2 + (y - x) / 2)) / 2)
  ← rewrite source=prev goal=5 facts=[4]
    #[6] cos x - cos y = 2 * ((cos x - cos y) / 2)
  real_norm goal=6
qed

theorem cos_double_sin
  fixes x :: real
  prop cos (2 * x) = 1 - 2 * sin x ^ (2::nat)
  [hint_rewrite]
proof
  ← rewrite real_mul_2 sym=false goal=0
    #[1] cos (x + x) = 1 - (sin x ^ (2::nat) + sin x ^ (2::nat))
  ← rewrite cos_add sym=false goal=1
    #[2] cos x * cos x - sin x * sin x = 1 - (sin x ^ (2::nat) + sin x ^ (2::nat))
  → forward sin_circle param_x=x goal=2
    #[3] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=2 facts=[3]
    #[4] 1 = sin x ^ (2::nat) + cos x ^ (2::nat)
  ← rewrite source=prev goal=2 facts=[4]
    #[5] cos x * cos x - sin x * sin x = sin x ^ (2::nat) + cos x ^ (2::nat) - (sin x ^ (2::nat) + sin x ^ (2::nat))
  ← rewrite real_pow_2 sym=false goal=5
    #[6] cos x * cos x - sin x * sin x = sin x * sin x + cos x * cos x - (sin x * sin x + sin x * sin x)
  real_norm goal=6
qed

theorem sin_lower_degree
  fixes x :: real
  prop sin x ^ (2::nat) = 1 / 2 - 1 / 2 * cos (2 * x)
proof
  ← rewrite cos_double_sin sym=false goal=0
    #[1] sin x ^ (2::nat) = 1 / 2 - 1 / 2 * (1 - 2 * sin x ^ (2::nat))
  real_norm goal=1
qed

def log :: real ⇒ real = log y = (THE x. exp x = y) [hint_rewrite]

theorem exp_log
  fixes x :: real
  prop 0 < x --> exp (log x) = x
  [hint_backward,hint_forward]

theorem exp_log_inv
  fixes c :: nat, x :: real
  prop 0 < x --> exp (-(of_nat c) * log x) = 1 / x ^ (of_nat::nat => nat) c

theorem exp_log_inv2
  fixes x :: real
  prop 0 < x --> exp (-1 * log x) = 1 / x

theorem exp_log_pow
  fixes n :: nat, x :: real
  prop 0 < x --> exp (of_nat n * log x) = x ^ (of_nat::nat => nat) n

theorem log_exp
  fixes x :: real
  prop log (exp x) = x
  [hint_rewrite]
proof
  ← rewrite real_exp_inj sym=true goal=0
    #[1] exp (log (exp x)) = exp x
  ← rule exp_log goal=1
    #[2] 0 < exp x
  ← rule real_exp_pos_lt goal=2
qed

theorem real_exp_log
  fixes x :: real
  prop exp (log x) = x <--> 0 < x
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] exp (log x) = x ⟶ 0 < x
    #[2] 0 < x ⟶ exp (log x) = x
  ← intro goal=1
    #[3] exp (log x) = x
    #[4] 0 < x
  → rewrite target=fact eq_sym_eq sym=false goal=4 facts=[3]
    #[5] x = exp (log x)
  ← rewrite source=prev goal=4 facts=[5]
    #[6] 0 < exp (log x)
  ← rule real_exp_pos_lt goal=6
    #[7] 0 < exp (log x)
  ← intro goal=2
    #[8] 0 < x
    #[9] exp (log x) = x
  ← rule exp_log goal=9 facts=[8]
qed

theorem log_mul
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> log (x * y) = log x + log y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] log (x * y) = log x + log y
  ← rewrite real_exp_inj sym=true goal=3
    #[4] exp (log (x * y)) = exp (log x + log y)
  ← rewrite real_exp_add sym=false goal=4
    #[5] exp (log (x * y)) = exp (log x) * exp (log y)
  → forward exp_log goal=5 facts=[1]
    #[6] exp (log x) = x
  → forward exp_log goal=5 facts=[2]
    #[7] exp (log y) = y
  ← rewrite source=prev goal=5 facts=[6]
    #[8] exp (log (x * y)) = x * exp (log y)
  ← rewrite source=prev goal=8 facts=[7]
    #[9] exp (log (x * y)) = x * y
  ← rewrite real_exp_log sym=false goal=9
    #[10] 0 < x * y
  ← rule real_lt_mul goal=10
qed

theorem log_inj
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> log x = log y <--> x = y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] log x = log y ⟷ x = y
  ← rule iffI goal=3
    #[4] log x = log y ⟶ x = y
    #[5] x = y ⟶ log x = log y
  ← intro goal=4
    #[6] log x = log y
    #[7] x = y
  → rewrite target=fact real_exp_inj sym=true goal=7 facts=[6]
    #[8] exp (log x) = exp (log y)
  → forward exp_log goal=7 facts=[1]
    #[9] exp (log x) = x
  → forward exp_log goal=7 facts=[2]
    #[10] exp (log y) = y
  → rewrite target=fact source=prev goal=7 facts=[9,8]
    #[11] x = exp (log y)
  → rewrite target=fact source=prev goal=7 facts=[10,11]
  ← intro goal=5
    #[12] x = y
    #[13] log x = log y
  ← rewrite source=prev goal=13 facts=[12]
    #[14] log x = log y
qed

theorem log_1
  prop log 1 = 0
  [hint_rewrite]
proof
  ← rewrite real_exp_inj sym=true goal=0
    #[1] exp (log 1) = exp 0
  ← rewrite real_exp_0 sym=false goal=1
    #[2] exp (log 1) = 1
  ← rule exp_log goal=2
    #[3] (0::real) < 1
  ← z3 goal=3
qed

theorem log_inv
  fixes x :: real
  prop 0 < x --> log (real_inverse x) = -(log x)
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] log (real_inverse x) = -(log x)
  ← rewrite real_exp_inj sym=true goal=2
    #[3] exp (log (real_inverse x)) = exp (-(log x))
  ← rewrite real_exp_neg sym=false goal=3
    #[4] exp (log (real_inverse x)) = real_inverse (exp (log x))
  → forward exp_log goal=4 facts=[1]
    #[5] exp (log x) = x
  ← rewrite source=prev goal=4 facts=[5]
    #[6] exp (log (real_inverse x)) = real_inverse x
  ← rewrite real_exp_log sym=false goal=6
    #[7] 0 < real_inverse x
  ← rule real_lt_inv goal=7 facts=[1]
qed

theorem log_div
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> log (x / y) = log x - log y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] log (x / y) = log x - log y
  ← rewrite real_divide_def sym=false goal=3
    #[4] log (x * real_inverse y) = log x - log y
  ← rewrite real_minus_def sym=false goal=4
    #[5] log (x * real_inverse y) = log x + -(log y)
  → forward log_inv goal=5 facts=[2]
    #[6] log (real_inverse y) = -(log y)
  → rewrite target=fact eq_sym_eq sym=false goal=5 facts=[6]
    #[7] -(log y) = log (real_inverse y)
  ← rewrite source=prev goal=5 facts=[7]
    #[8] log (x * real_inverse y) = log x + log (real_inverse y)
  ← rule log_mul goal=8
    #[9] 0 < real_inverse y
  ← rule real_lt_inv goal=9 facts=[2]
    #[10] 0 < real_inverse y
qed

theorem log_mono_lt
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> log x < log y <--> x < y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] log x < log y ⟷ x < y
  → forward exp_log goal=3 facts=[1]
    #[4] exp (log x) = x
  → forward exp_log goal=3 facts=[2]
    #[5] exp (log y) = y
  ← rule iffI goal=3
    #[6] log x < log y ⟶ x < y
    #[7] x < y ⟶ log x < log y
  ← intro goal=6
    #[8] log x < log y
    #[9] x < y
  → rewrite target=fact real_exp_mono_lt sym=true goal=9 facts=[8]
    #[10] exp (log x) < exp (log y)
  → rewrite target=fact source=prev goal=9 facts=[4,10]
    #[11] x < exp (log y)
  → rewrite target=fact source=prev goal=9 facts=[5,11]
  ← intro goal=7
    #[12] x < y
    #[13] log x < log y
  ← rewrite real_exp_mono_lt sym=true goal=13
    #[14] exp (log x) < exp (log y)
  ← rewrite source=prev goal=14 facts=[4]
    #[15] x < exp (log y)
  ← rewrite source=prev goal=15 facts=[5]
qed

theorem log_mono_lt_imp
  fixes x :: real, y :: real
  prop 0 < x --> x < y --> log x < log y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x < y
    #[3] log x < log y
  → forward real_lt_trans goal=3 facts=[1,2]
    #[4] 0 < y
  → forward log_mono_lt goal=3 facts=[1,4]
    #[5] log x < log y ⟷ x < y
  ← rewrite source=prev goal=3 facts=[5]
qed

theorem log_mono_lt_rev
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> log x < log y --> x < y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] log x < log y
    #[4] x < y
  → forward log_mono_lt goal=4 facts=[1,2]
    #[5] log x < log y ⟷ x < y
  → rewrite target=fact source=prev goal=4 facts=[5,3]
qed

theorem log_mono_le
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> log x <= log y <--> x <= y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] log x ≤ log y ⟷ x ≤ y
  → forward exp_log goal=3 facts=[1]
    #[4] exp (log x) = x
  → forward exp_log goal=3 facts=[2]
    #[5] exp (log y) = y
  ← rule iffI goal=3
    #[6] log x ≤ log y ⟶ x ≤ y
    #[7] x ≤ y ⟶ log x ≤ log y
  ← intro goal=6
    #[8] log x ≤ log y
    #[9] x ≤ y
  → rewrite target=fact real_exp_mono_le sym=true goal=9 facts=[8]
    #[10] exp (log x) ≤ exp (log y)
  → rewrite target=fact source=prev goal=9 facts=[4,10]
    #[11] x ≤ exp (log y)
  → rewrite target=fact source=prev goal=9 facts=[5,11]
  ← intro goal=7
    #[12] x ≤ y
    #[13] log x ≤ log y
  ← rewrite real_exp_mono_le sym=true goal=13
    #[14] exp (log x) ≤ exp (log y)
  ← rewrite source=prev goal=14 facts=[4]
    #[15] x ≤ exp (log y)
  ← rewrite source=prev goal=15 facts=[5]
qed

theorem log_mono_le_imp
  fixes x :: real, y :: real
  prop 0 < x --> x <= y --> log x <= log y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x ≤ y
    #[3] log x ≤ log y
  cut "0 < y" goal=3
    #[4] 0 < y
  ← rule real_lte_trans goal=4 facts=[1,2]
  → forward log_mono_le goal=3 facts=[1,4]
    #[5] log x ≤ log y ⟷ x ≤ y
  ← rewrite source=prev goal=3 facts=[5]
qed

theorem log_mono_le_rev
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> log x <= log y --> x <= y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] log x ≤ log y
    #[4] x ≤ y
  → forward log_mono_le goal=4 facts=[1,2]
    #[5] log x ≤ log y ⟷ x ≤ y
  → rewrite target=fact source=prev goal=4 facts=[5,3]
qed

theorem log_pow
  fixes n :: nat, x :: real
  prop 0 < x --> log (x ^ n) = of_nat n * log x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] log (x ^ n) = of_nat n * log x
  ← rewrite real_exp_inj sym=true goal=2
    #[3] exp (log (x ^ n)) = exp (of_nat n * log x)
  ← rewrite real_exp_n sym=false goal=3
    #[4] exp (log (x ^ n)) = exp (log x) ^ n
  → forward real_pow_lt param_n=n goal=4 facts=[1]
    #[5] 0 < x ^ n
  → forward exp_log goal=4 facts=[5]
    #[6] exp (log (x ^ n)) = x ^ n
  ← rewrite source=prev goal=4 facts=[6]
    #[7] x ^ n = exp (log x) ^ n
  → forward exp_log goal=7 facts=[1]
    #[8] exp (log x) = x
  ← rewrite source=prev goal=7 facts=[8]
qed

theorem log_pow_real
  fixes p :: real, x :: real
  prop 0 < x --> 0 < p --> log (x ^ p) = p * log x

theorem log_le_strong
  fixes x :: real
  prop 0 < 1 + x --> log (1 + x) <= x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < 1 + x
    #[2] log (1 + x) ≤ x
  ← rewrite real_exp_mono_le sym=true goal=2
    #[3] exp (log (1 + x)) ≤ exp x
  → forward exp_log goal=3 facts=[1]
    #[4] exp (log (1 + x)) = 1 + x
  ← rewrite source=prev goal=3 facts=[4]
    #[5] 1 + x ≤ exp x
  ← rule real_exp_le_x goal=5
    #[6] 1 + x ≤ exp x
qed

theorem log_le
  fixes x :: real
  prop 0 <= x --> log (1 + x) <= x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] log (1 + x) ≤ x
  ← rule log_le_strong goal=2
    #[3] 0 < 1 + x
  ← z3 goal=3 facts=[1]
qed

theorem log_lt_x
  fixes x :: real
  prop 0 < x --> log x < x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] log x < x
  ← rewrite real_exp_mono_lt sym=true goal=2
    #[3] exp (log x) < exp x
  → forward exp_log goal=3 facts=[1]
    #[4] exp (log x) = x
  ← rewrite source=prev goal=3 facts=[4]
    #[5] x < exp x
  → forward real_exp_le_x param_x=x goal=5
    #[6] 1 + x ≤ exp x
  ← rule real_lte_trans param_y=1+x goal=5
    #[7] x < 1 + x
  ← z3 goal=7
    #[8] x < 1 + x
qed

theorem log_pos
  fixes x :: real
  prop 1 <= x --> 0 <= log x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 1 ≤ x
    #[2] 0 ≤ log x
  ← rewrite log_1 sym=true goal=2
    #[3] log 1 ≤ log x
  ← rule log_mono_le_imp goal=3
    #[4] (0::real) < 1
  ← z3 goal=4
    #[5] (0::real) < 1
qed

theorem log_pos_lt
  fixes x :: real
  prop 1 < x --> 0 < log x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] 0 < log x
  ← rewrite log_1 sym=true goal=2
    #[3] log 1 < log x
  ← rule log_mono_lt_imp goal=3
    #[4] (0::real) < 1
  ← z3 goal=4
    #[5] (0::real) < 1
qed

theorem log_ge_zero
  fixes x :: real
  prop log x >= 0 <--> x >= 1
proof
  ← rewrite greater_eq_def sym=false goal=0
    #[1] 0 ≤ log x ⟷ 1 ≤ x
  ← rule iffI goal=1
    #[2] 0 ≤ log x ⟶ 1 ≤ x
    #[3] 1 ≤ x ⟶ 0 ≤ log x
  ← intro goal=2
    #[4] 0 ≤ log x
    #[5] 1 ≤ x
  ← rule log_mono_le_rev goal=5
    #[6] (0::real) < 1
    #[7] 0 < x
    #[8] log 1 ≤ log x
  ← z3 goal=6
    #[9] (0::real) < 1
  ← rule contrapositive goal=7 facts=[4]
    #[10] ¬(0 < x) ⟶ ¬(0 ≤ log x)
  ← intro goal=10
    #[11] ¬(0 < x)
    #[12] ¬(0 ≤ log x)
  ← rewrite real_not_lt sym=true goal=12
    #[13] ¬¬(log x < 0)
  ← rewrite double_neg sym=false goal=13
    #[14] log x < 0
  → rewrite target=fact real_less_def sym=false goal=14 facts=[11]
    #[15] ¬¬(x ≤ 0)
  → rewrite target=fact double_neg sym=false goal=14 facts=[15]
    #[16] x ≤ 0
qed

theorem log_gt_zero
  fixes x :: real
  prop log x > 0 <--> x > 1

theorem log_le_zero
  fixes x :: real
  prop log x <= 0 <--> x > 0 & x <= 1

theorem log_lt_zero
  fixes x :: real
  prop log x < 0 <--> x > 0 & x < 1

theorem log_product
  fixes f :: 'a => real, s :: 'a set
  prop finite s --> (!x. x Mem s --> 0 < f x) --> log (product s f) = sum s (%x. log (f x))
  [hint_backward,hint_backward1]

theorem sin_nearzero
  prop ?x. 0 < x & (!y. 0 < y --> y <= x --> 0 < sin y)
  [hint_backward]

theorem sin_nontrivial
  prop ?x. 0 < x & ~(sin x = 0)
  [hint_backward]
proof
  → forward sin_nearzero goal=0
    #[1] ∃x. 0 < x ∧ (∀y. 0 < y ⟶ y ≤ x ⟶ 0 < sin y)
  elim x goal=0 facts=[1]
    #[2] _VAR x
    #[3] 0 < x ∧ (∀y. 0 < y ⟶ y ≤ x ⟶ 0 < sin y)
    #[4] ∃x. 0 < x ∧ ¬(sin x = 0)
  → forward conjD1 goal=4 facts=[3]
    #[5] 0 < x
  → forward conjD2 goal=4 facts=[3]
    #[6] ∀y. 0 < y ⟶ y ≤ x ⟶ 0 < sin y
  → inst target=fact x goal=4 facts=[6]
    #[7] 0 < x ⟶ x ≤ x ⟶ 0 < sin x
  ← inst x goal=4
    #[8] 0 < x ∧ ¬(sin x = 0)
  ← rule conjI goal=8
    #[9] ¬(sin x = 0)
  cut "!a::real. 0 < a --> ~(a = 0)" goal=9
    #[10] ∀a::real. 0 < a ⟶ ¬(a = 0)
  ← z3 goal=10
    #[11] ∀a::real. 0 < a ⟶ ¬(a = 0)
  ← apply_prev goal=9 facts=[11]
    #[12] 0 < sin x
  ← apply_prev goal=12 facts=[7]
    #[13] x ≤ x
  ← rule real_le_refl goal=13
    #[14] x ≤ x
qed

theorem cos_nontrivial
  prop ?x. 0 < x & ~(cos x = 1)
  [hint_backward]
proof
  → forward sin_nontrivial goal=0
    #[1] ∃x. 0 < x ∧ ¬(sin x = 0)
  elim x goal=0 facts=[1]
    #[2] _VAR x
    #[3] 0 < x ∧ ¬(sin x = 0)
    #[4] ∃x. 0 < x ∧ ¬(cos x = 1)
  → forward conjD1 goal=4 facts=[3]
    #[5] 0 < x
  → forward conjD2 goal=4 facts=[3]
    #[6] ¬(sin x = 0)
  ← inst x goal=4
    #[7] 0 < x ∧ ¬(cos x = 1)
  ← rule conjI goal=7
    #[8] ¬(cos x = 1)
  ← rule contrapositive goal=8 facts=[6]
    #[9] ¬¬(cos x = 1) ⟶ ¬¬(sin x = 0)
  ← rewrite double_neg sym=false goal=9
    #[10] cos x = 1 ⟶ sin x = 0
  ← intro goal=10
    #[11] cos x = 1
    #[12] sin x = 0
  → forward sin_circle param_x=x goal=12
    #[13] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  → rewrite target=fact source=prev goal=12 facts=[11,13]
    #[14] sin x ^ (2::nat) + 1 ^ (2::nat) = 1
  → rewrite target=fact real_pow_one sym=false goal=12 facts=[14]
    #[15] sin x ^ (2::nat) + 1 = 1
  cut "∀a::real. a + 1 = 1 ⟶ a = 0" goal=12
    #[16] ∀a::real. a + 1 = 1 ⟶ a = 0
  ← z3 goal=16
    #[17] ∀a::real. a + 1 = 1 ⟶ a = 0
  → forward goal=12 facts=[17,15]
    #[18] sin x ^ (2::nat) = 0
  → rewrite target=fact real_pow_2 sym=false goal=12 facts=[18]
    #[19] sin x * sin x = 0
  → rewrite target=fact real_entire sym=false goal=12 facts=[19]
    #[20] sin x = 0 ∨ sin x = 0
  ← rule disjE goal=12 facts=[20]
    #[21] sin x = 0 ⟶ sin x = 0
qed

theorem cos_double_bound
  fixes x :: real
  prop 0 <= cos x --> 2 * (1 - cos x) <= 1 - cos (2 * x)
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 ≤ cos x
    #[2] 2 * (1 - cos x) ≤ 1 - cos (2 * x)
  ← rewrite cos_double_cos sym=false goal=2
    #[3] 2 * (1 - cos x) ≤ 1 - (2 * cos x ^ (2::nat) - 1)
  cut "∀a::real. ∀b. 2 * (1 - a) ≤ 1 - (2 * b - 1) ⟷ b ≤ a * 1" goal=3
    #[4] ∀a::real. ∀b. 2 * (1 - a) ≤ 1 - (2 * b - 1) ⟷ b ≤ a * 1
  ← z3 goal=4
    #[5] ∀a::real. ∀b. 2 * (1 - a) ≤ 1 - (2 * b - 1) ⟷ b ≤ a * 1
  ← rewrite source=prev goal=3 facts=[5]
    #[6] cos x ^ (2::nat) ≤ cos x * 1
  ← rewrite real_pow_2 sym=false goal=6
    #[7] cos x * cos x ≤ cos x * 1
  ← rule real_le_lmul goal=7
    #[8] cos x ≤ 1
  ← rule cos_ubound goal=8
    #[9] cos x ≤ 1
qed

theorem cos_goesnegative_lemma
  fixes x :: real
  prop cos x < 1 --> (?n::nat. cos (2 ^ n * x) < 0)
  [hint_backward]
proof
  ← intro goal=0
    #[1] cos x < 1
    #[2] ∃n::nat. cos (2 ^ n * x) < 0
  ← rewrite double_neg sym=true goal=2
    #[3] ¬¬(∃n::nat. cos (2 ^ n * x) < 0)
  ← rule negI goal=3
    #[4] ¬(∃n::nat. cos (2 ^ n * x) < 0) ⟶ false
  ← intro goal=4
    #[5] ¬(∃n::nat. cos (2 ^ n * x) < 0)
    #[6] false
  → rewrite target=fact not_exists sym=false goal=6 facts=[5]
    #[7] ∀n::nat. ¬(cos (2 ^ n * x) < 0)
  → rewrite target=fact real_not_lt sym=false goal=6 facts=[7]
    #[8] ∀n::nat. 0 ≤ cos (2 ^ n * x)
  cut "!n::nat. 2 ^ n * (1-cos x) <= 1-cos (2 ^ n * x)" goal=6
    #[9] ∀n::nat. 2 ^ n * (1 - cos x) ≤ 1 - cos (2 ^ n * x)
  ← intro n goal=9
    #[10] _VAR n
    #[11] 2 ^ n * (1 - cos x) ≤ 1 - cos (2 ^ n * x)
  ← induct n nat_induct goal=11
    #[12] 2 ^ (0::nat) * (1 - cos x) ≤ 1 - cos (2 ^ (0::nat) * x)
    #[13] ∀n. 2 ^ n * (1 - cos x) ≤ 1 - cos (2 ^ n * x) ⟶ 2 ^ Suc n * (1 - cos x) ≤ 1 - cos (2 ^ Suc n * x)
  ← rewrite real_nat_power_def_1 sym=false goal=12
    #[14] 1 * (1 - cos x) ≤ 1 - cos (1 * x)
  ← rewrite real_mul_lid sym=false goal=14
    #[15] 1 - cos x ≤ 1 - cos x
  ← rule real_le_refl goal=15
    #[16] 1 - cos x ≤ 1 - cos x
  ← intro n goal=13
    #[17] 2 ^ n * (1 - cos x) ≤ 1 - cos (2 ^ n * x)
    #[18] 2 ^ Suc n * (1 - cos x) ≤ 1 - cos (2 ^ Suc n * x)
  ← rewrite real_nat_power_def_2 sym=false goal=18
    #[19] 2 * 2 ^ n * (1 - cos x) ≤ 1 - cos (2 * 2 ^ n * x)
  ← rule real_le_trans param_y="2 * (1 - cos (2 ^ n * x))" goal=19
    #[20] 2 * 2 ^ n * (1 - cos x) ≤ 2 * (1 - cos (2 ^ n * x))
    #[21] 2 * (1 - cos (2 ^ n * x)) ≤ 1 - cos (2 * 2 ^ n * x)
  ← rewrite real_mult_assoc sym=true goal=20
    #[22] 2 * (2 ^ n * (1 - cos x)) ≤ 2 * (1 - cos (2 ^ n * x))
  ← rule real_le_lmul goal=22
    #[23] (0::real) ≤ 2
  ← rule real_pos goal=23
    #[24] (0::real) ≤ 2
  ← rewrite real_mult_assoc sym=true goal=21
    #[25] 2 * (1 - cos (2 ^ n * x)) ≤ 1 - cos (2 * (2 ^ n * x))
  ← rule cos_double_bound goal=25
    #[26] 0 ≤ cos (2 ^ n * x)
  ← apply_prev goal=26 facts=[8]
    #[27] 0 ≤ cos (2 ^ n * x)
  → forward real_arch_pow2 param_x="1/(1-cos x)" goal=6
    #[28] ∃n::nat. 1 / (1 - cos x) < 2 ^ n
  elim n goal=6 facts=[28]
    #[29] 1 / (1 - cos x) < 2 ^ n
    #[30] false
  cut "∀x::real. x < 1 ⟶ 0 < 1 - x" goal=30
    #[31] ∀x::real. x < 1 ⟶ 0 < 1 - x
  ← z3 goal=31
    #[32] ∀x::real. x < 1 ⟶ 0 < 1 - x
  → forward goal=30 facts=[32,1]
    #[33] 0 < 1 - cos x
  → forward real_lt_ldiv_eq param_x="(1::real)" param_y="(2::real) ^ n" goal=30 facts=[33]
    #[34] 1 / (1 - cos x) < 2 ^ n ⟷ 1 < 2 ^ n * (1 - cos x)
  → rewrite target=fact source=prev goal=30 facts=[34,29]
    #[35] 1 < 2 ^ n * (1 - cos x)
  → inst target=fact n goal=30 facts=[9]
  → forward real_lte_trans goal=30 facts=[35,11]
    #[36] 1 < 1 - cos (2 ^ n * x)
  ← rule contrapositive goal=30 facts=[36]
    #[37] ¬false ⟶ ¬(1 < 1 - cos (2 ^ n * x))
  ← intro goal=37
    #[38] ¬false
    #[39] ¬(1 < 1 - cos (2 ^ n * x))
  ← rewrite real_not_lt sym=false goal=39
    #[40] 1 - cos (2 ^ n * x) ≤ 1
  cut "!x::real. 0 <= x --> 1-x <= 1" goal=40
    #[41] ∀x::real. 0 ≤ x ⟶ 1 - x ≤ 1
  ← z3 goal=41
    #[42] ∀x::real. 0 ≤ x ⟶ 1 - x ≤ 1
  ← apply_prev goal=40 facts=[42]
    #[43] 0 ≤ cos (2 ^ n * x)
  ← apply_prev goal=43 facts=[8]
qed

theorem cos_goesnegative
  prop ?x. 0 < x & cos x < 0
  [hint_backward]
proof
  → forward cos_nontrivial goal=0
    #[1] ∃x. 0 < x ∧ ¬(cos x = 1)
  elim x goal=0 facts=[1]
    #[2] _VAR x
    #[3] 0 < x ∧ ¬(cos x = 1)
    #[4] ∃x. 0 < x ∧ cos x < 0
  → forward conjD1 goal=4 facts=[3]
    #[5] 0 < x
  → forward conjD2 goal=4 facts=[3]
    #[6] ¬(cos x = 1)
  → forward cos_ubound param_x=x goal=4
    #[7] cos x ≤ 1
  → rewrite target=fact real_le_lt sym=false goal=4 facts=[7]
    #[8] cos x < 1 ∨ cos x = 1
  ← rule disjE goal=4 facts=[8]
    #[9] cos x < 1 ⟶ (∃x1. 0 < x1 ∧ cos x1 < 0)
    #[10] cos x = 1 ⟶ (∃x1. 0 < x1 ∧ cos x1 < 0)
  ← intro goal=9
    #[11] cos x < 1
    #[12] ∃x. 0 < x ∧ cos x < 0
  → forward cos_goesnegative_lemma goal=12 facts=[11]
    #[13] ∃n::nat. cos (2 ^ n * x) < 0
  elim n goal=12 facts=[13]
    #[14] _VAR n
    #[15] cos (2 ^ n * x) < 0
    #[16] ∃x. 0 < x ∧ cos x < 0
  ← inst "2 ^ n * x" goal=16
    #[17] 0 < 2 ^ n * x ∧ cos (2 ^ n * x) < 0
  ← rule conjI goal=17
    #[18] 0 < 2 ^ n * x
  ← rule real_lt_mul goal=18
    #[19] (0::real) < 2 ^ n
  ← rule real_lt_pow2 goal=19
    #[20] (0::real) < 2 ^ n
  ← intro goal=10
    #[21] cos x = 1
    #[22] ∃x. 0 < x ∧ cos x < 0
  ← rule negE_gen goal=22 facts=[6,21]
qed

theorem cos_haszero
  prop ?x. 0 < x & cos x = 0
  [hint_backward]

theorem sin_haszero
  prop ?x. 0 < x & sin x = 0
  [hint_backward]
proof
  → forward cos_haszero goal=0
    #[1] ∃x. 0 < x ∧ cos x = 0
  elim x goal=0 facts=[1]
    #[2] _VAR x
    #[3] 0 < x ∧ cos x = 0
    #[4] ∃x. 0 < x ∧ sin x = 0
  ← inst "2 * x" goal=4
    #[5] 0 < 2 * x ∧ sin (2 * x) = 0
  → forward conjD1 goal=5 facts=[3]
    #[6] 0 < x
  → forward conjD2 goal=5 facts=[3]
    #[7] cos x = 0
  ← rule conjI goal=5
    #[8] 0 < 2 * x
    #[9] sin (2 * x) = 0
  ← rule real_lt_mul goal=8
    #[10] (0::real) < 2
  ← z3 goal=10
    #[11] (0::real) < 2
  ← rewrite sin_double sym=false goal=9
    #[12] 2 * sin x * cos x = 0
  ← rewrite real_mult_comm sym=false goal=12
    #[13] cos x * (2 * sin x) = 0
  ← rewrite real_entire sym=false goal=13
    #[14] cos x = 0 ∨ 2 * sin x = 0
  ← rule disjI1 goal=14
qed

theorem sin_haszero_minimal
  prop ?p. 0 < p & sin p = 0 & (!x. 0 < x --> x < p --> ~(sin x = 0))
  [hint_backward]

def pi :: real = pi = (THE p. 0 < p ∧ sin p = 0 ∧ (∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0))) [hint_rewrite]

theorem pi_works
  prop 0 < pi & sin pi = 0 & (!x. 0 < x --> x < pi --> ~(sin x = 0))
  [hint_backward]
proof
  → forward sin_haszero_minimal goal=0
    #[1] ∃p. 0 < p ∧ sin p = 0 ∧ (∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0))
  elim p goal=0 facts=[1]
    #[2] _VAR p
    #[3] 0 < p ∧ sin p = 0 ∧ (∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0))
    #[4] 0 < pi ∧ sin pi = 0 ∧ (∀x. 0 < x ⟶ x < pi ⟶ ¬(sin x = 0))
  → rewrite target=fact conj_assoc sym=false goal=4 facts=[3]
    #[5] (0 < p ∧ sin p = 0) ∧ (∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0))
  → forward conjD1 goal=4 facts=[5]
    #[6] 0 < p ∧ sin p = 0
  → forward conjD2 goal=4 facts=[5]
    #[7] ∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0)
  → forward conjD1 goal=4 facts=[6]
    #[8] 0 < p
  → forward conjD2 goal=4 facts=[6]
    #[9] sin p = 0
  ← rewrite pi_def sym=false goal=4
    #[10] 0 < (THE p. 0 < p ∧ sin p = 0 ∧ (∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0))) ∧ sin (THE p. 0 < p ∧ sin p = 0 ∧ (∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0))) = 0 ∧ (∀x. 0 < x ⟶ x < (THE p. 0 < p ∧ sin p = 0 ∧ (∀x1. 0 < x1 ⟶ x1 < p ⟶ ¬(sin x1 = 0))) ⟶ ¬(sin x = 0))
  → forward theI param_P="(%p. 0 < p ∧ sin p = 0 ∧ (∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0)))" param_a=p goal=10
    #[11] 0 < p ∧ sin p = 0 ∧ (∀x. 0 < x ⟶ x < p ⟶ ¬(sin x = 0)) ⟶ (∀x. 0 < x ∧ sin x = 0 ∧ (∀x1. 0 < x1 ⟶ x1 < x ⟶ ¬(sin x1 = 0)) ⟶ x = p) ⟶ 0 < (THE x. 0 < x ∧ sin x = 0 ∧ (∀x1. 0 < x1 ⟶ x1 < x ⟶ ¬(sin x1 = 0))) ∧ sin (THE x. 0 < x ∧ sin x = 0 ∧ (∀x1. 0 < x1 ⟶ x1 < x ⟶ ¬(sin x1 = 0))) = 0 ∧ (∀x. 0 < x ⟶ x < (THE x1. 0 < x1 ∧ sin x1 = 0 ∧ (∀x2. 0 < x2 ⟶ x2 < x1 ⟶ ¬(sin x2 = 0))) ⟶ ¬(sin x = 0))
  ← apply_prev goal=10 facts=[11]
    #[12] ∀x. 0 < x ∧ sin x = 0 ∧ (∀x1. 0 < x1 ⟶ x1 < x ⟶ ¬(sin x1 = 0)) ⟶ x = p
  ← intro x goal=12
    #[13] _VAR x
    #[14] 0 < x ∧ sin x = 0 ∧ (∀x1. 0 < x1 ⟶ x1 < x ⟶ ¬(sin x1 = 0))
    #[15] x = p
  → forward conjD1 goal=15 facts=[14]
    #[16] 0 < x
  → forward conjD2 goal=15 facts=[14]
    #[17] sin x = 0 ∧ (∀x1. 0 < x1 ⟶ x1 < x ⟶ ¬(sin x1 = 0))
  → forward conjD1 goal=15 facts=[17]
    #[18] sin x = 0
  → forward conjD2 goal=15 facts=[17]
    #[19] ∀x1. 0 < x1 ⟶ x1 < x ⟶ ¬(sin x1 = 0)
  ← rewrite double_neg sym=true goal=15
    #[20] ¬¬(x = p)
  ← rule negI goal=20
    #[21] ¬(x = p) ⟶ false
  ← intro goal=21
    #[22] ¬(x = p)
    #[23] false
  → rewrite target=fact real_le_antisym sym=true goal=23 facts=[22]
    #[24] ¬(x ≤ p ∧ p ≤ x)
  → rewrite target=fact de_morgan_thm1 sym=false goal=23 facts=[24]
    #[25] ¬(x ≤ p) ∨ ¬(p ≤ x)
  → rewrite target=fact real_not_lt sym=true goal=23 facts=[25]
    #[26] ¬¬(p < x) ∨ ¬¬(x < p)
  → rewrite target=fact double_neg sym=false goal=23 facts=[26]
    #[27] p < x ∨ x < p
  ← rule disjE goal=23 facts=[27]
    #[28] p < x ⟶ false
    #[29] x < p ⟶ false
  ← intro goal=28
    #[30] p < x
    #[31] false
  → forward goal=31 facts=[19,8,30]
    #[32] ¬(sin p = 0)
  ← rule negE_gen goal=31 facts=[32,9]
    #[33] false
  ← intro goal=29
    #[34] x < p
    #[35] false
  → forward goal=35 facts=[7,16,34]
    #[36] ¬(sin x = 0)
  ← rule negE_gen goal=35 facts=[36,18]
    #[37] false
qed

theorem pi_pos
  prop 0 < pi
  [hint_backward]
proof
  → forward pi_works goal=0
    #[1] 0 < pi ∧ sin pi = 0 ∧ (∀x. 0 < x ⟶ x < pi ⟶ ¬(sin x = 0))
  ← rule conjD1 goal=0 facts=[1]
qed

theorem real_sin_pi
  prop sin pi = 0
  [hint_rewrite]
proof
  → forward pi_works goal=0
    #[1] 0 < pi ∧ sin pi = 0 ∧ (∀x. 0 < x ⟶ x < pi ⟶ ¬(sin x = 0))
  → forward conjD2 goal=0 facts=[1]
    #[2] sin pi = 0 ∧ (∀x. 0 < x ⟶ x < pi ⟶ ¬(sin x = 0))
  ← rule conjD1 goal=0 facts=[2]
qed

theorem sin_pos_pi
  fixes x :: real
  prop 0 < x --> x < pi --> 0 < sin x
  [hint_backward,hint_backward1]

theorem real_cos_pi2
  prop cos (pi / 2) = 0
  [hint_rewrite]
proof
  → forward sin_double param_x=pi/2 goal=0
    #[1] sin (2 * (pi / 2)) = 2 * sin (pi / 2) * cos (pi / 2)
  cut "2 * (pi/2) = pi" goal=0
    #[2] 2 * (pi / 2) = pi
  real_norm goal=2
  → rewrite target=fact source=prev goal=0 facts=[2,1]
    #[3] sin pi = 2 * sin (pi / 2) * cos (pi / 2)
  → rewrite target=fact real_sin_pi sym=false goal=0 facts=[3]
    #[4] 0 = 2 * sin (pi / 2) * cos (pi / 2)
  → rewrite target=fact eq_sym_eq sym=false goal=0 facts=[4]
    #[5] 2 * sin (pi / 2) * cos (pi / 2) = 0
  → rewrite target=fact real_entire sym=false goal=0 facts=[5]
    #[6] 2 * sin (pi / 2) = 0 ∨ cos (pi / 2) = 0
  ← rule disjE goal=0 facts=[6]
    #[7] 2 * sin (pi / 2) = 0 ⟶ cos (pi / 2) = 0
    #[8] cos (pi / 2) = 0 ⟶ cos (pi / 2) = 0
  ← intro goal=7
    #[9] 2 * sin (pi / 2) = 0
    #[10] cos (pi / 2) = 0
  → rewrite target=fact real_entire sym=false goal=10 facts=[9]
    #[11] (2::real) = 0 ∨ sin (pi / 2) = 0
  ← rule disjE goal=10 facts=[11]
    #[12] (2::real) = 0 ⟶ cos (pi / 2) = 0
    #[13] sin (pi / 2) = 0 ⟶ cos (pi / 2) = 0
  ← intro goal=12
    #[14] (2::real) = 0
    #[15] cos (pi / 2) = 0
  ← rule contrapositive goal=15 facts=[14]
    #[16] ¬(cos (pi / 2) = 0) ⟶ ¬((2::real) = 0)
  ← intro goal=16
    #[17] ¬(cos (pi / 2) = 0)
    #[18] ¬((2::real) = 0)
  ← z3 goal=18
    #[19] ¬((2::real) = 0)
  ← intro goal=13
    #[20] sin (pi / 2) = 0
    #[21] cos (pi / 2) = 0
  ← rule contrapositive goal=21 facts=[20]
    #[22] ¬(cos (pi / 2) = 0) ⟶ ¬(sin (pi / 2) = 0)
  ← intro goal=22
    #[23] ¬(sin (pi / 2) = 0)
  ← rewrite real_le_antisym sym=true goal=23
    #[24] ¬(sin (pi / 2) ≤ 0 ∧ 0 ≤ sin (pi / 2))
  ← rewrite de_morgan_thm1 sym=false goal=24
    #[25] ¬(sin (pi / 2) ≤ 0) ∨ ¬(0 ≤ sin (pi / 2))
  ← rule disjI1 goal=25
    #[26] ¬(sin (pi / 2) ≤ 0)
  ← rewrite real_not_lt sym=true goal=26
    #[27] ¬¬(0 < sin (pi / 2))
  ← rewrite double_neg sym=false goal=27
    #[28] 0 < sin (pi / 2)
  ← rule sin_pos_pi goal=28
    #[29] 0 < pi / 2
    #[30] pi / 2 < pi
  → forward pi_pos goal=29
    #[31] 0 < pi
  ← rewrite real_divide_def sym=false goal=29
    #[32] 0 < pi * real_inverse 2
  ← rule real_lt_mul goal=32
    #[33] 0 < real_inverse 2
  ← z3 goal=33
    #[34] 0 < real_inverse 2
  ← rewrite real_divide_def sym=false goal=30
    #[35] pi * real_inverse 2 < pi
  ← rewrite real_mul_rid sym=true goal=35
    #[36] pi * real_inverse 2 * 1 < pi * 1
  ← rewrite real_mult_assoc sym=true goal=36
    #[37] pi * (real_inverse 2 * 1) < pi * 1
  ← rule real_lt_lmul: goal=37
    #[38] real_inverse 2 * 1 < 1
  ← z3 goal=38
    #[39] real_inverse 2 * 1 < 1
qed

theorem real_cos_pi
  prop cos pi = -1
  [hint_rewrite]
proof
  cut "pi = 2 * (pi / 2)" goal=0
    #[1] pi = 2 * (pi / 2)
  real_norm goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] cos (2 * (pi / 2)) = -1
  ← rewrite cos_double_cos sym=false goal=2
    #[3] 2 * cos (pi / 2) ^ (2::nat) - 1 = -1
  ← rewrite real_cos_pi2 sym="" goal=3
    #[4] (2::real) * 0 ^ (2::nat) - 1 = -1
  real_norm goal=4
qed

theorem real_sin_pi2
  prop sin (pi / 2) = 1
  [hint_rewrite]
proof
  → forward sin_circle param_x="pi / 2" goal=0
    #[1] sin (pi / 2) ^ (2::nat) + cos (pi / 2) ^ (2::nat) = 1
  → rewrite target=fact real_cos_pi2 sym=false goal=0 facts=[1]
    #[2] sin (pi / 2) ^ (2::nat) + 0 ^ (2::nat) = 1
  → rewrite target=fact real_pow_2 sym=false goal=0 facts=[2]
    #[3] sin (pi / 2) * sin (pi / 2) + 0 * 0 = 1
  → rewrite target=fact real_mul_lzero sym=false goal=0 facts=[3]
    #[4] sin (pi / 2) * sin (pi / 2) + 0 = 1
  → rewrite target=fact real_add_rid sym=false goal=0 facts=[4]
    #[5] sin (pi / 2) * sin (pi / 2) = 1
  cut "!x::real. x * x = 1 <--> x = 1 | x = -1" goal=0
    #[6] ∀x::real. x * x = 1 ⟷ x = 1 ∨ x = -1
  ← z3 goal=6
  → rewrite target=fact source=prev goal=0 facts=[6,5]
    #[7] sin (pi / 2) = 1 ∨ sin (pi / 2) = -1
  ← rule disjE goal=0 facts=[7]
    #[8] sin (pi / 2) = 1 ⟶ sin (pi / 2) = 1
    #[9] sin (pi / 2) = -1 ⟶ sin (pi / 2) = 1
  ← intro goal=9
    #[10] sin (pi / 2) = -1
    #[11] sin (pi / 2) = 1
  ← rule contrapositive goal=11 facts=[10]
    #[12] ¬(sin (pi / 2) = 1) ⟶ ¬(sin (pi / 2) = -1)
  ← intro goal=12
    #[13] ¬(sin (pi / 2) = 1)
    #[14] ¬(sin (pi / 2) = -1)
  cut "∀x::real. 0 < x ⟶ ¬(x = -1)" goal=14
    #[15] ∀x::real. 0 < x ⟶ ¬(x = -1)
  ← z3 goal=15
    #[16] ∀x::real. 0 < x ⟶ ¬(x = -1)
  ← apply_prev goal=14 facts=[16]
    #[17] 0 < sin (pi / 2)
  ← rule sin_pos_pi goal=17
    #[18] 0 < pi / 2
    #[19] pi / 2 < pi
  ← rewrite real_divide_def sym=false goal=18
    #[20] 0 < pi * real_inverse 2
  ← rule real_lt_mul goal=20
    #[21] 0 < pi
    #[22] 0 < real_inverse 2
  ← rule pi_pos goal=21
    #[23] 0 < pi
  ← z3 goal=22
    #[24] 0 < real_inverse 2
  ← rewrite real_divide_def sym=false goal=19
    #[25] pi * real_inverse 2 < pi
  ← rewrite real_mul_rid sym=true goal=25
    #[26] pi * real_inverse 2 * 1 < pi * 1
  ← rewrite real_mult_assoc sym=true goal=26
    #[27] pi * (real_inverse 2 * 1) < pi * 1
  ← rule real_lt_lmul: goal=27
    #[28] real_inverse 2 * 1 < 1
  ← z3 goal=28
    #[29] real_inverse 2 * 1 < 1
qed

theorem sin_cos
  fixes x :: real
  prop cos (pi / 2 - x) = sin x
  [hint_rewrite]
proof
  ← rewrite cos_sub sym=false goal=0
    #[1] cos (pi / 2) * cos x + sin (pi / 2) * sin x = sin x
  ← rewrite real_cos_pi2 sym=false goal=1
    #[2] 0 * cos x + sin (pi / 2) * sin x = sin x
  ← rewrite real_sin_pi2 sym=false goal=2
    #[3] 0 * cos x + 1 * sin x = sin x
  real_norm goal=3
qed

theorem cos_sin
  fixes x :: real
  prop sin (pi / 2 - x) = cos x
  [hint_rewrite]
proof
  ← rewrite sin_sub sym=false goal=0
    #[1] sin (pi / 2) * cos x - cos (pi / 2) * sin x = cos x
  ← rewrite real_sin_pi2 sym=false goal=1
    #[2] 1 * cos x - cos (pi / 2) * sin x = cos x
  ← rewrite real_cos_pi2 sym=false goal=2
    #[3] 1 * cos x - 0 * sin x = cos x
  real_norm goal=3
qed

theorem sin_periodic_pi_div2
  fixes x :: real
  prop sin (1 / 2 * pi + x) = cos x
proof
  ← rewrite sin_add sym=false goal=0
    #[1] sin (1 / 2 * pi) * cos x + cos (1 / 2 * pi) * sin x = cos x
  cut "1 / 2 * pi = pi / 2" goal=1
    #[2] 1 / 2 * pi = pi / 2
  real_norm goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] sin (pi / 2) * cos x + cos (pi / 2) * sin x = cos x
  ← rewrite real_sin_pi2 sym=false goal=3
    #[4] 1 * cos x + cos (pi / 2) * sin x = cos x
  ← rewrite real_cos_pi2 sym=false goal=4
    #[5] 1 * cos x + 0 * sin x = cos x
  real_norm goal=5
qed

theorem cos_periodic_pi_div2
  fixes x :: real
  prop cos (1 / 2 * pi + x) = -(sin x)
proof
  cut "1 / 2 * pi=pi / 2" goal=0
    #[1] 1 / 2 * pi = pi / 2
  real_norm goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] cos (pi / 2 + x) = -(sin x)
  ← rewrite cos_add sym=false goal=2
    #[3] cos (pi / 2) * cos x - sin (pi / 2) * sin x = -(sin x)
  ← rewrite real_cos_pi2 sym=false goal=3
    #[4] 0 * cos x - sin (pi / 2) * sin x = -(sin x)
  ← rewrite real_sin_pi2 sym=false goal=4
    #[5] 0 * cos x - 1 * sin x = -(sin x)
  real_norm goal=5
qed

theorem sin_periodic_pi
  fixes x :: real
  prop sin (x + pi) = -(sin x)
  [hint_rewrite]
proof
  ← rewrite sin_add sym=false goal=0
    #[1] sin x * cos pi + cos x * sin pi = -(sin x)
  ← rewrite real_cos_pi sym=false goal=1
    #[2] sin x * -1 + cos x * sin pi = -(sin x)
  ← rewrite real_sin_pi sym=false goal=2
    #[3] sin x * -1 + cos x * 0 = -(sin x)
  real_norm goal=3
qed

theorem cos_periodic_pi
  fixes x :: real
  prop cos (x + pi) = -(cos x)
  [hint_rewrite]
proof
  ← rewrite cos_add sym=false goal=0
    #[1] cos x * cos pi - sin x * sin pi = -(cos x)
  ← rewrite real_cos_pi sym=false goal=1
    #[2] cos x * -1 - sin x * sin pi = -(cos x)
  ← rewrite real_sin_pi sym=false goal=2
    #[3] cos x * -1 - sin x * 0 = -(cos x)
  real_norm goal=3
qed

theorem sin_periodic
  fixes x :: real
  prop sin (x + 2 * pi) = sin x
  [hint_rewrite_sym]
proof
  ← rewrite real_mul_2 sym=false goal=0
    #[1] sin (x + (pi + pi)) = sin x
  ← rewrite real_add_assoc sym=false goal=1
    #[2] sin (x + pi + pi) = sin x
  ← rewrite sin_periodic_pi sym=false goal=2
    #[3] -(sin (x + pi)) = sin x
  ← rewrite sin_periodic_pi sym=false goal=3
    #[4] --(sin x) = sin x
  ← rewrite real_neg_neg sym=false goal=4
qed

theorem cos_periodic
  fixes x :: real
  prop cos (x + 2 * pi) = cos x
  [hint_rewrite]
proof
  ← rewrite real_mul_2 sym=false goal=0
    #[1] cos (x + (pi + pi)) = cos x
  ← rewrite real_add_assoc sym=false goal=1
    #[2] cos (x + pi + pi) = cos x
  ← rewrite cos_periodic_pi sym=false goal=2
    #[3] -(cos (x + pi)) = cos x
  ← rewrite cos_periodic_pi sym=false goal=3
    #[4] --(cos x) = cos x
  ← rewrite real_neg_neg sym=false goal=4
qed

theorem real_sin_0
  prop sin 0 = 0
  [hint_rewrite]
proof
  ← rewrite real_eq_neg2 sym=true goal=0
    #[1] -(sin 0) = -0
  ← rewrite sin_periodic_pi sym=true goal=1
    #[2] sin (0 + pi) = -0
  ← rewrite real_add_lid sym=false goal=2
    #[3] sin pi = -0
  ← rewrite real_neg_0 sym=false goal=3
    #[4] sin pi = 0
  ← rewrite real_sin_pi sym=false goal=4
qed

theorem real_cos_0
  prop cos 0 = 1
  [hint_rewrite]
proof
  ← rewrite real_eq_neg2 sym=true goal=0
    #[1] -(cos 0) = -1
  ← rewrite cos_periodic_pi sym=true goal=1
    #[2] cos (0 + pi) = -1
  ← rewrite real_add_lid sym=false goal=2
    #[3] cos pi = -1
  ← rewrite real_cos_pi sym=false goal=3
qed

theorem sin_npi
  fixes n :: nat
  prop sin (of_nat n * pi) = 0
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] sin (of_nat 0 * pi) = 0
    #[2] ∀n. sin (of_nat n * pi) = 0 ⟶ sin (of_nat (Suc n) * pi) = 0
  ← rewrite real_zero_def sym=true goal=1
    #[3] sin (0 * pi) = 0
  ← rewrite real_mul_lzero sym=false goal=3
    #[4] sin 0 = 0
  ← rewrite real_eq_neg2 sym=true goal=4
    #[5] -(sin 0) = -0
  ← rewrite sin_periodic_pi sym=true goal=5
    #[6] sin (0 + pi) = -0
  ← rewrite real_add_lid sym=false goal=6
    #[7] sin pi = -0
  ← rewrite real_neg_0 sym=false goal=7
    #[8] sin pi = 0
  ← rewrite real_sin_pi sym=false goal=8
  ← intro n goal=2
    #[9] _VAR n
    #[10] sin (of_nat n * pi) = 0
    #[11] sin (of_nat (Suc n) * pi) = 0
  ← rewrite add_1_right sym=true goal=11
    #[12] sin (of_nat (n + 1) * pi) = 0
  ← rewrite real_of_nat_add sym=true goal=12
    #[13] sin ((of_nat n + of_nat 1) * pi) = 0
  ← rewrite real_add_rdistrib sym=false goal=13
    #[14] sin (of_nat n * pi + of_nat 1 * pi) = 0
  ← rewrite real_one_def sym=true goal=14
    #[15] sin (of_nat n * pi + 1 * pi) = 0
  ← rewrite real_mul_lid sym=false goal=15
    #[16] sin (of_nat n * pi + pi) = 0
  ← rewrite sin_periodic_pi sym=false goal=16
    #[17] -(sin (of_nat n * pi)) = 0
  ← rewrite source=prev goal=17 facts=[10]
    #[18] -(0::real) = 0
  ← rewrite real_neg_0 sym=false goal=18
    #[19] -(0::real) = 0
qed

theorem cos_npi
  fixes n :: nat
  prop cos (of_nat n * pi) = -1 ^ n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] cos (of_nat 0 * pi) = -1 ^ (0::nat)
    #[2] ∀n. cos (of_nat n * pi) = -1 ^ n ⟶ cos (of_nat (Suc n) * pi) = -1 ^ Suc n
  ← rewrite real_zero_def sym=true goal=1
    #[3] cos (0 * pi) = -1 ^ (0::nat)
  ← rewrite real_mul_lzero sym=false goal=3
    #[4] cos 0 = -1 ^ (0::nat)
  ← rewrite real_nat_power_def_1 sym=false goal=4
    #[5] cos 0 = 1
  ← rewrite real_eq_neg2 sym=true goal=5
    #[6] -(cos 0) = -1
  ← rewrite cos_periodic_pi sym=true goal=6
    #[7] cos (0 + pi) = -1
  ← rewrite real_add_lid sym=false goal=7
    #[8] cos pi = -1
  ← rewrite real_cos_pi sym=false goal=8
  ← intro n goal=2
    #[9] _VAR n
    #[10] cos (of_nat n * pi) = -1 ^ n
    #[11] cos (of_nat (Suc n) * pi) = -1 ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=11
    #[12] cos (of_nat (Suc n) * pi) = -1 * -1 ^ n
  ← rewrite add_1_right sym=true goal=12
    #[13] cos (of_nat (n + 1) * pi) = -1 * -1 ^ n
  ← rewrite real_of_nat_add sym=true goal=13
    #[14] cos ((of_nat n + of_nat 1) * pi) = -1 * -1 ^ n
  ← rewrite real_add_rdistrib sym=false goal=14
    #[15] cos (of_nat n * pi + of_nat 1 * pi) = -1 * -1 ^ n
  ← rewrite real_one_def sym=true goal=15
    #[16] cos (of_nat n * pi + 1 * pi) = -1 * -1 ^ n
  ← rewrite real_mul_lid sym=false goal=16
    #[17] cos (of_nat n * pi + pi) = -1 * -1 ^ n
  ← rewrite cos_periodic_pi sym=false goal=17
    #[18] -(cos (of_nat n * pi)) = -1 * -1 ^ n
  ← rewrite real_mul_lneg sym=false goal=18
    #[19] -(cos (of_nat n * pi)) = -(1 * -1 ^ n)
  ← rewrite real_mul_lid sym=false goal=19
    #[20] -(cos (of_nat n * pi)) = -(-1 ^ n)
  ← rewrite source=prev goal=20 facts=[10]
qed

theorem real_sin_pi4
  prop sin (1 / 4 * pi) = sqrt 2 / 2
  [hint_rewrite]
proof
  → forward cos_double_sin param_x="1 / 4 * pi" goal=0
    #[1] cos (2 * (1 / 4 * pi)) = 1 - 2 * sin (1 / 4 * pi) ^ (2::nat)
  cut "2 * (1 / 4 * pi) = pi / 2" goal=0 facts=[1]
    #[2] 2 * (1 / 4 * pi) = pi / 2
  real_norm goal=2
  → rewrite target=fact source=prev goal=0 facts=[2,1]
    #[3] cos (pi / 2) = 1 - 2 * sin (1 / 4 * pi) ^ (2::nat)
  → rewrite target=fact real_cos_pi2 sym=false goal=0 facts=[3]
    #[4] 0 = 1 - 2 * sin (1 / 4 * pi) ^ (2::nat)
  cut "!a::real. 0 = 1- 2 * a --> a=1/2" goal=0
    #[5] ∀a. 0 = 1 - 2 * a ⟶ a = 1 / 2
  ← z3 goal=5
  → forward goal=0 facts=[5,4]
    #[6] sin (1 / 4 * pi) ^ (2::nat) = 1 / 2
  cut "1/2 = (sqrt 2 / 2) ^ (2::nat)" goal=0
    #[7] 1 / 2 = (sqrt 2 / 2) ^ (2::nat)
  ← rewrite real_pow_2 sym=false goal=7
    #[8] 1 / 2 = sqrt 2 / 2 * (sqrt 2 / 2)
  ← rewrite real_divide_def sym=false goal=8
    #[9] 1 * real_inverse 2 = sqrt 2 * real_inverse 2 * (sqrt 2 * real_inverse 2)
  cut "sqrt 2 * real_inverse 2 * (sqrt 2 * real_inverse 2) = sqrt 2 * sqrt 2 * (real_inverse 2 * real_inverse 2)" goal=9
    #[10] sqrt 2 * real_inverse 2 * (sqrt 2 * real_inverse 2) = sqrt 2 * sqrt 2 * (real_inverse 2 * real_inverse 2)
  real_norm goal=10
  ← rewrite source=prev goal=9 facts=[10]
    #[11] 1 * real_inverse 2 = sqrt 2 * sqrt 2 * (real_inverse 2 * real_inverse 2)
  cut "sqrt 2 * sqrt 2 = 2" goal=11
    #[12] sqrt 2 * sqrt 2 = 2
  ← rewrite real_pow_2 sym=true goal=12
    #[13] sqrt 2 ^ (2::nat) = 2
  ← rewrite sqrt_pow2 sym=false goal=13
    #[14] (0::real) ≤ 2
  ← rule real_pos goal=14
  ← rewrite source=prev goal=11 facts=[12]
    #[15] 1 * real_inverse 2 = 2 * (real_inverse 2 * real_inverse 2)
  ← z3 goal=15
  → rewrite target=fact source=prev goal=0 facts=[7,6]
    #[16] sin (1 / 4 * pi) ^ (2::nat) = (sqrt 2 / 2) ^ (2::nat)
  → rewrite target=fact real_eq_square_abs sym=true goal=0 facts=[16]
    #[17] abs (sin (1 / 4 * pi)) = abs (sqrt 2 / 2)
  → rewrite target=fact abs_def sym=false goal=0 facts=[17]
    #[18] (if 0 ≤ sin (1 / 4 * pi) then sin (1 / 4 * pi) else -(sin (1 / 4 * pi))) = (if 0 ≤ sqrt 2 / 2 then sqrt 2 / 2 else -(sqrt 2 / 2))
  cut "0 ≤ sin (1 / 4 * pi)" goal=0
    #[19] 0 ≤ sin (1 / 4 * pi)
  ← rule real_lt_imp_le goal=19
    #[20] 0 < sin (1 / 4 * pi)
  ← rule sin_pos_pi goal=20
    #[21] 0 < 1 / 4 * pi
    #[22] 1 / 4 * pi < pi
  ← rule real_lt_mul goal=21
    #[23] 0 < 1 / 4
    #[24] 0 < pi
  ← z3 goal=23
  ← rule pi_pos goal=24
  ← rewrite real_mul_lid sym=true goal=22
    #[25] 1 * (1 / 4 * pi) < 1 * pi
  ← rewrite real_mult_assoc sym=false goal=25
    #[26] 1 * (1 / 4) * pi < 1 * pi
  ← rewrite real_mult_comm sym=false goal=26
    #[27] pi * (1 * (1 / 4)) < pi * 1
  ← rule real_lt_lmul: goal=27
    #[28] 1 * (1 / 4) < 1
  ← z3 goal=28
  → rewrite target=fact if_P sym=false goal=0 facts=[18,19]
    #[29] sin (1 / 4 * pi) = (if 0 ≤ sqrt 2 / 2 then sqrt 2 / 2 else -(sqrt 2 / 2))
  cut "0 ≤ sqrt 2 / 2" goal=0
    #[30] 0 ≤ sqrt 2 / 2
  ← rewrite real_divide_def sym=false goal=30
    #[31] 0 ≤ sqrt 2 * real_inverse 2
  ← rule real_le_mul goal=31
    #[32] 0 ≤ sqrt 2
    #[33] 0 ≤ real_inverse 2
  ← rule sqrt_pos_le goal=32
  ← z3 goal=33
  → rewrite target=fact if_P sym=false goal=0 facts=[29,30]
qed

theorem real_cos_pi4
  prop cos (1 / 4 * pi) = sqrt 2 / 2
  [hint_rewrite]
proof
  → forward sin_double param_x="1 / 4 * pi" goal=0
    #[1] sin (2 * (1 / 4 * pi)) = 2 * sin (1 / 4 * pi) * cos (1 / 4 * pi)
  cut "2 * (1 / 4 * pi) = pi / 2" goal=0
    #[2] 2 * (1 / 4 * pi) = pi / 2
  real_norm goal=2
  → rewrite target=fact source=prev goal=0 facts=[2,1]
    #[3] sin (pi / 2) = 2 * sin (1 / 4 * pi) * cos (1 / 4 * pi)
  → rewrite target=fact real_sin_pi2 sym=false goal=0 facts=[3]
    #[4] 1 = 2 * sin (1 / 4 * pi) * cos (1 / 4 * pi)
  → rewrite target=fact real_sin_pi4 sym=false goal=0 facts=[4]
    #[5] 1 = 2 * (sqrt 2 / 2) * cos (1 / 4 * pi)
  cut "2 * (sqrt 2 / 2) = sqrt 2" goal=0
    #[6] 2 * (sqrt 2 / 2) = sqrt 2
  real_norm goal=6
  → rewrite target=fact source=prev goal=0 facts=[6,5]
    #[7] 1 = sqrt 2 * cos (1 / 4 * pi)
  → rewrite target=fact eq_sym_eq sym=false goal=0 facts=[7]
    #[8] sqrt 2 * cos (1 / 4 * pi) = 1
  → rewrite target=fact real_mult_comm sym=false goal=0 facts=[8]
    #[9] cos (1 / 4 * pi) * sqrt 2 = 1
  → forward real_mul_linv_uniq goal=0 facts=[9]
    #[10] real_inverse (sqrt 2) = cos (1 / 4 * pi)
  → rewrite target=fact eq_sym_eq sym=false goal=0 facts=[10]
    #[11] cos (1 / 4 * pi) = real_inverse (sqrt 2)
  ← rewrite source=prev goal=0 facts=[11]
    #[12] real_inverse (sqrt 2) = sqrt 2 / 2
  ← rewrite real_divide_def sym=false goal=12
    #[13] real_inverse (sqrt 2) = sqrt 2 * real_inverse 2
  ← rule real_mul_linv_uniq goal=13
    #[14] sqrt 2 * real_inverse 2 * sqrt 2 = 1
  ← rewrite real_mult_comm sym=false goal=14
    #[15] sqrt 2 * (sqrt 2 * real_inverse 2) = 1
  ← rewrite real_mult_assoc sym=false goal=15
    #[16] sqrt 2 * sqrt 2 * real_inverse 2 = 1
  ← rewrite real_pow_2 sym=true goal=16
    #[17] sqrt 2 ^ (2::nat) * real_inverse 2 = 1
  ← rewrite sqrt_works_gen_2 sym=false goal=17
    #[18] abs 2 * real_inverse 2 = 1
  ← rewrite real_abs_nat sym=false goal=18
    #[19] 2 * real_inverse 2 = 1
  ← z3 goal=19
qed

theorem sin_cos_combine
  fixes x :: real
  prop sin x + cos x = sqrt 2 * sin (x + pi / 4)
proof
  ← rewrite sin_add sym=false goal=0
    #[1] sin x + cos x = sqrt 2 * (sin x * cos (pi / 4) + cos x * sin (pi / 4))
  cut "pi / 4 = 1 / 4 * pi" goal=1
    #[2] pi / 4 = 1 / 4 * pi
  real_norm goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] sin x + cos x = sqrt 2 * (sin x * cos (1 / 4 * pi) + cos x * sin (1 / 4 * pi))
  ← rewrite real_sin_pi4 sym=false goal=3
    #[4] sin x + cos x = sqrt 2 * (sin x * cos (1 / 4 * pi) + cos x * (sqrt 2 / 2))
  ← rewrite real_cos_pi4 sym=false goal=4
    #[5] sin x + cos x = sqrt 2 * (sin x * (sqrt 2 / 2) + cos x * (sqrt 2 / 2))
  ← rewrite real_mult_comm sym=false goal=5
    #[6] sin x + cos x = (sin x * (sqrt 2 / 2) + cos x * (sqrt 2 / 2)) * sqrt 2
  ← rewrite real_add_rdistrib sym=true goal=6
    #[7] sin x + cos x = (sin x + cos x) * (sqrt 2 / 2) * sqrt 2
  cut "(sqrt 2 / 2) * sqrt 2 = 1" goal=7
    #[8] sqrt 2 / 2 * sqrt 2 = 1
  ← rewrite real_divide_def sym=false goal=8
    #[9] sqrt 2 * real_inverse 2 * sqrt 2 = 1
  ← rewrite real_mult_comm sym=false goal=9
    #[10] sqrt 2 * (sqrt 2 * real_inverse 2) = 1
  ← rewrite real_mult_assoc sym=false goal=10
    #[11] sqrt 2 * sqrt 2 * real_inverse 2 = 1
  ← rewrite sqrt_mul sym=true goal=11
    #[12] sqrt (2 * 2) * real_inverse 2 = 1
  ← rewrite real_pow_2 sym=true goal=12
    #[13] sqrt (2 ^ (2::nat)) * real_inverse 2 = 1
  ← rewrite pow_2_sqrt_abs sym=false goal=13
    #[14] abs 2 * real_inverse 2 = 1
  ← rewrite real_abs_nat sym=false goal=14
    #[15] 2 * real_inverse 2 = 1
  ← z3 goal=15
  ← rewrite real_mult_assoc sym=true goal=7
    #[16] sin x + cos x = (sin x + cos x) * (sqrt 2 / 2 * sqrt 2)
  ← rewrite source=prev goal=16 facts=[8]
    #[17] sin x + cos x = (sin x + cos x) * 1
  ← rewrite real_mul_rid sym=false goal=17
qed

theorem sin_cos_combine2
  fixes x :: real
  prop sin x - cos x = -(sqrt 2) * cos (x + pi / 4)
  [hint_rewrite]
proof
  ← rewrite cos_add sym=false goal=0
    #[1] sin x - cos x = -(sqrt 2) * (cos x * cos (pi / 4) - sin x * sin (pi / 4))
  cut "pi / 4 = 1 / 4 * pi" goal=1
    #[2] pi / 4 = 1 / 4 * pi
  real_norm goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] sin x - cos x = -(sqrt 2) * (cos x * cos (1 / 4 * pi) - sin x * sin (1 / 4 * pi))
  ← rewrite real_cos_pi4 sym=false goal=3
    #[4] sin x - cos x = -(sqrt 2) * (cos x * (sqrt 2 / 2) - sin x * sin (1 / 4 * pi))
  ← rewrite real_sin_pi4 sym=false goal=4
    #[5] sin x - cos x = -(sqrt 2) * (cos x * (sqrt 2 / 2) - sin x * (sqrt 2 / 2))
  ← rewrite real_mult_comm sym=false goal=5
    #[6] sin x - cos x = (cos x * (sqrt 2 / 2) - sin x * (sqrt 2 / 2)) * -(sqrt 2)
  ← rewrite real_minus_def sym=false goal=6
    #[7] sin x + -(cos x) = (cos x * (sqrt 2 / 2) + -(sin x * (sqrt 2 / 2))) * -(sqrt 2)
  ← rewrite real_mul_lneg sym=true goal=7
    #[8] sin x + -(cos x) = (cos x * (sqrt 2 / 2) + -(sin x) * (sqrt 2 / 2)) * -(sqrt 2)
  ← rewrite real_add_rdistrib sym=true goal=8
    #[9] sin x + -(cos x) = (cos x + -(sin x)) * (sqrt 2 / 2) * -(sqrt 2)
  ← rewrite real_mul_rneg sym=false goal=9
    #[10] sin x + -(cos x) = -((cos x + -(sin x)) * (sqrt 2 / 2) * sqrt 2)
  ← rewrite real_mult_assoc sym=true goal=10
    #[11] sin x + -(cos x) = -((cos x + -(sin x)) * (sqrt 2 / 2 * sqrt 2))
  cut "sqrt 2 / 2 * sqrt 2 = 1" goal=11
    #[12] sqrt 2 / 2 * sqrt 2 = 1
  ← rewrite real_divide_def sym=false goal=12
    #[13] sqrt 2 * real_inverse 2 * sqrt 2 = 1
  ← rewrite real_mult_comm sym=false goal=13
    #[14] sqrt 2 * (sqrt 2 * real_inverse 2) = 1
  ← rewrite real_mult_assoc sym=false goal=14
    #[15] sqrt 2 * sqrt 2 * real_inverse 2 = 1
  ← rewrite sqrt_mul sym=true goal=15
    #[16] sqrt (2 * 2) * real_inverse 2 = 1
  ← rewrite real_pow_2 sym=true goal=16
    #[17] sqrt (2 ^ (2::nat)) * real_inverse 2 = 1
  ← rewrite pow_2_sqrt_abs sym=false goal=17
    #[18] abs 2 * real_inverse 2 = 1
  ← rewrite real_abs_nat sym=false goal=18
    #[19] 2 * real_inverse 2 = 1
  ← z3 goal=19
  ← rewrite source=prev goal=11 facts=[12]
    #[20] sin x + -(cos x) = -((cos x + -(sin x)) * 1)
  real_norm goal=20
qed

theorem cos_pos_pi2
  fixes x :: real
  prop 0 < x --> x < pi / 2 --> 0 < cos x
  [hint_backward,hint_backward1]

theorem sin_pos_pi2
  fixes x :: real
  prop 0 < x --> x < pi / 2 --> 0 < sin x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x < pi / 2
    #[3] 0 < sin x
  ← rule sin_pos_pi goal=3
    #[4] x < pi
  ← rule real_lt_trans goal=4 facts=[2]
    #[5] pi / 2 < pi
  ← rewrite real_divide_def sym=false goal=5
    #[6] pi * real_inverse 2 < pi
  ← rewrite real_mul_rid sym=true goal=6
    #[7] pi * real_inverse 2 * 1 < pi * 1
  ← rewrite real_mult_assoc sym=true goal=7
    #[8] pi * (real_inverse 2 * 1) < pi * 1
  ← rule real_lt_lmul: goal=8
    #[9] 0 < pi
    #[10] real_inverse 2 * 1 < 1
  ← rule pi_pos goal=9
    #[11] 0 < pi
  ← z3 goal=10
    #[12] real_inverse 2 * 1 < 1
qed

theorem cos_pos_pi
  fixes x :: real
  prop -(pi / 2) < x --> x < pi / 2 --> 0 < cos x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) < x
    #[2] x < pi / 2
    #[3] 0 < cos x
  → forward cos_pos_pi2 param_x="abs x" goal=3
    #[4] 0 < abs x ⟶ abs x < pi / 2 ⟶ 0 < cos (abs x)
  → rewrite target=fact cos_abs sym=false goal=3 facts=[4]
    #[5] 0 < abs x ⟶ abs x < pi / 2 ⟶ 0 < cos x
  ← cases "x = 0" goal=3
    #[6] x = 0 ⟶ 0 < cos x
    #[7] ¬(x = 0) ⟶ 0 < cos x
  ← intro goal=6
    #[8] x = 0
    #[9] 0 < cos x
  ← rewrite source=prev goal=9 facts=[8]
    #[10] 0 < cos 0
  ← rewrite real_cos_0 sym=false goal=10
    #[11] (0::real) < 1
  ← z3 goal=11
    #[12] (0::real) < 1
  ← intro goal=7
    #[13] ¬(x = 0)
    #[14] 0 < cos x
  ← apply_prev goal=14 facts=[5]
    #[15] 0 < abs x
    #[16] abs x < pi / 2
  ← rule real_abs_nz goal=15
  ← rewrite real_abs_lt sym=false goal=16
    #[17] -(pi / 2) < x ∧ x < pi / 2
  ← rule conjI goal=17
qed

theorem cos_pos_pi_le
  fixes x :: real
  prop -(pi / 2) <= x --> x <= pi / 2 --> 0 <= cos x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) ≤ x
    #[2] x ≤ pi / 2
    #[3] 0 ≤ cos x
  → rewrite target=fact real_le_lt sym=false goal=3 facts=[2]
    #[4] x < pi / 2 ∨ x = pi / 2
  → rewrite target=fact real_le_lt sym=false goal=3 facts=[1]
    #[5] -(pi / 2) < x ∨ -(pi / 2) = x
  ← rule disjE goal=3 facts=[5]
    #[6] -(pi / 2) < x ⟶ 0 ≤ cos x
    #[7] -(pi / 2) = x ⟶ 0 ≤ cos x
  ← intro goal=6
    #[8] -(pi / 2) < x
    #[9] 0 ≤ cos x
  ← rule disjE goal=9 facts=[4]
    #[10] x < pi / 2 ⟶ 0 ≤ cos x
    #[11] x = pi / 2 ⟶ 0 ≤ cos x
  ← intro goal=10
    #[12] x < pi / 2
    #[13] 0 ≤ cos x
  ← rule real_lt_imp_le goal=13
    #[14] 0 < cos x
  ← rule cos_pos_pi goal=14
  ← intro goal=11
    #[15] x = pi / 2
    #[16] 0 ≤ cos x
  ← rewrite source=prev goal=16 facts=[15]
    #[17] 0 ≤ cos (pi / 2)
  ← rewrite real_cos_pi2 sym=false goal=17
    #[18] (0::real) ≤ 0
  ← rule real_le_refl goal=18
    #[19] (0::real) ≤ 0
  ← intro goal=7
    #[20] -(pi / 2) = x
    #[21] 0 ≤ cos x
  → rewrite target=fact eq_sym_eq sym=false goal=21 facts=[20]
    #[22] x = -(pi / 2)
  ← rewrite source=prev goal=21 facts=[22]
    #[23] 0 ≤ cos (-(pi / 2))
  ← rewrite cos_neg sym=false goal=23
    #[24] 0 ≤ cos (pi / 2)
  ← rewrite real_cos_pi2 sym=false goal=24
    #[25] (0::real) ≤ 0
  ← rule real_le_refl goal=25
qed

theorem sin_pos_pi_le
  fixes x :: real
  prop 0 <= x --> x <= pi --> 0 <= sin x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ pi
    #[3] 0 ≤ sin x
  → rewrite target=fact real_le_lt sym=false goal=3 facts=[1]
    #[4] 0 < x ∨ 0 = x
  → rewrite target=fact real_le_lt sym=false goal=3 facts=[2]
    #[5] x < pi ∨ x = pi
  ← rule disjE goal=3 facts=[5]
    #[6] x < pi ⟶ 0 ≤ sin x
    #[7] x = pi ⟶ 0 ≤ sin x
  ← rule disjE goal=6 facts=[4]
    #[8] 0 < x ⟶ x < pi ⟶ 0 ≤ sin x
    #[9] 0 = x ⟶ x < pi ⟶ 0 ≤ sin x
  ← intro goal=8
    #[10] 0 < x
    #[11] x < pi
    #[12] 0 ≤ sin x
  ← rule real_lt_imp_le goal=12
    #[13] 0 < sin x
  ← rule sin_pos_pi goal=13
  ← intro goal=9
    #[14] 0 = x
    #[15] 0 ≤ sin x
  → rewrite target=fact eq_sym_eq sym=false goal=15 facts=[14]
    #[16] x = 0
  ← rewrite source=prev goal=15 facts=[16]
    #[17] 0 ≤ sin 0
  ← rewrite real_sin_0 sym=false goal=17
    #[18] (0::real) ≤ 0
  ← rule real_le_refl goal=18
    #[19] (0::real) ≤ 0
  ← intro goal=7
    #[20] x = pi
    #[21] 0 ≤ sin x
  ← rewrite source=prev goal=21 facts=[20]
    #[22] 0 ≤ sin pi
  ← rewrite real_sin_pi sym=false goal=22
    #[23] (0::real) ≤ 0
  ← rule real_le_refl goal=23
qed

theorem sin_pimul_eq_0
  fixes n :: real
  prop sin (n * pi) = 0 <--> integer n
  [hint_rewrite]

theorem sin_eq_0
  fixes x :: real
  prop sin x = 0 <--> (?n. integer n & x = n * pi)
  [hint_rewrite]
proof
  → forward sin_pimul_eq_0 param_n=x/pi goal=0
    #[1] sin (x / pi * pi) = 0 ⟷ integer (x / pi)
  cut "x / pi * pi = x" goal=0
    #[2] x / pi * pi = x
  ← rewrite real_divide_def sym=false goal=2
    #[3] x * real_inverse pi * pi = x
  cut "real_inverse pi * pi = 1" goal=3
    #[4] real_inverse pi * pi = 1
  ← rule real_mul_linv goal=4
    #[5] ¬(pi = 0)
  cut "!a::real. 0 < a --> ~(a = 0)" goal=5
    #[6] ∀a::real. 0 < a ⟶ ¬(a = 0)
  ← z3 goal=6
  ← apply_prev goal=5 facts=[6]
    #[7] 0 < pi
  ← rule pi_pos goal=7
  ← rewrite real_mult_assoc sym=true goal=3
    #[8] x * (real_inverse pi * pi) = x
  ← rewrite source=prev goal=8 facts=[4]
    #[9] x * 1 = x
  ← rewrite real_mul_rid sym=false goal=9
  → rewrite target=fact source=prev goal=0 facts=[2,1]
    #[10] sin x = 0 ⟷ integer (x / pi)
  ← rewrite source=prev goal=0 facts=[10]
    #[11] integer (x / pi) ⟷ (∃n. integer n ∧ x = n * pi)
  ← rule iffI goal=11
    #[12] integer (x / pi) ⟶ (∃n. integer n ∧ x = n * pi)
    #[13] (∃n. integer n ∧ x = n * pi) ⟶ integer (x / pi)
qed

theorem cos_eq_0
  fixes x :: real
  prop cos x = 0 <--> (?n. integer n & x = (n + 1 / 2) * pi)
  [hint_rewrite]
proof
  ← rewrite cos_sin sym=true goal=0
    #[1] sin (pi / 2 - x) = 0 ⟷ (∃n. integer n ∧ x = (n + 1 / 2) * pi)
  ← rewrite sin_eq_0 sym=false goal=1
    #[2] (∃n. integer n ∧ pi / 2 - x = n * pi) ⟷ (∃n. integer n ∧ x = (n + 1 / 2) * pi)
  cut "∀p. !n. p / 2 - x = n * p <--> x = (-n + 1 / 2) * p" goal=2
    #[3] ∀p. ∀n. p / 2 - x = n * p ⟷ x = (-n + 1 / 2) * p
  ← z3 goal=3
  ← rule iffI goal=2
    #[4] (∃n. integer n ∧ pi / 2 - x = n * pi) ⟶ (∃n. integer n ∧ x = (n + 1 / 2) * pi)
    #[5] (∃n. integer n ∧ x = (n + 1 / 2) * pi) ⟶ (∃n. integer n ∧ pi / 2 - x = n * pi)
  ← intro goal=4
    #[6] ∃n. integer n ∧ pi / 2 - x = n * pi
    #[7] ∃n. integer n ∧ x = (n + 1 / 2) * pi
  elim n goal=7 facts=[6]
    #[8] _VAR n
    #[9] integer n ∧ pi / 2 - x = n * pi
    #[10] ∃n. integer n ∧ x = (n + 1 / 2) * pi
  → forward conjD1 goal=10 facts=[9]
    #[11] integer n
  → forward conjD2 goal=10 facts=[9]
    #[12] pi / 2 - x = n * pi
  ← inst -n goal=10
    #[13] integer (-n) ∧ x = (-n + 1 / 2) * pi
  ← rule conjI goal=13
    #[14] integer (-n)
    #[15] x = (-n + 1 / 2) * pi
  ← rewrite integer_neg sym=false goal=14
  → rewrite target=fact source=prev goal=15 facts=[3,12]
    #[16] x = (-n + 1 / 2) * pi
  ← intro goal=5
    #[17] ∃n. integer n ∧ x = (n + 1 / 2) * pi
    #[18] ∃n. integer n ∧ pi / 2 - x = n * pi
  elim n goal=18 facts=[17]
    #[19] integer n ∧ x = (n + 1 / 2) * pi
    #[20] ∃n. integer n ∧ pi / 2 - x = n * pi
  → forward conjD1 goal=20 facts=[19]
    #[21] integer n
  → forward conjD2 goal=20 facts=[19]
    #[22] x = (n + 1 / 2) * pi
  ← inst -n goal=20
    #[23] integer (-n) ∧ pi / 2 - x = -n * pi
  ← rule conjI goal=23
    #[24] integer (-n)
    #[25] pi / 2 - x = -n * pi
  ← rewrite integer_neg sym=false goal=24
  ← rewrite source=prev goal=25 facts=[3]
    #[26] x = (--n + 1 / 2) * pi
  ← rewrite real_neg_neg sym=false goal=26
qed

theorem sin_zero_pi
  fixes x :: real
  prop sin x = 0 <--> (?n. x = of_nat n * pi) | (?n. x = -(of_nat n * pi))
  [hint_rewrite]
proof
  ← rewrite sin_eq_0 sym=false goal=0
    #[1] (∃n. integer n ∧ x = n * pi) ⟷ (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← rewrite integer_cases sym=false goal=1
    #[2] (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi) ⟷ (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← rule iffI goal=2
    #[3] (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi) ⟶ (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
    #[4] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi)) ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi)
  ← intro goal=3
    #[5] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi
    #[6] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  elim n goal=6 facts=[5]
    #[7] _VAR n
    #[8] ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi
    #[9] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  → forward conjD1 goal=9 facts=[8]
    #[10] (∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))
  → forward conjD2 goal=9 facts=[8]
    #[11] x = n * pi
  ← rule disjE goal=9 facts=[10]
    #[12] (∃n1. n = of_nat n1) ⟶ (∃n1. x = of_nat n1 * pi) ∨ (∃n1. x = -(of_nat n1 * pi))
    #[13] (∃n1. n = -(of_nat n1)) ⟶ (∃n1. x = of_nat n1 * pi) ∨ (∃n1. x = -(of_nat n1 * pi))
  ← intro goal=12
    #[14] ∃n1. n = of_nat n1
    #[15] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← rule disjI1 goal=15
    #[16] ∃n. x = of_nat n * pi
  elim n1 goal=16 facts=[14]
    #[17] _VAR n1
    #[18] n = of_nat n1
    #[19] ∃n. x = of_nat n * pi
    #[20] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← inst n1 goal=19
    #[21] x = of_nat n1 * pi
  → rewrite target=fact source=prev goal=21 facts=[18,11]
    #[22] x = of_nat n1 * pi
  ← intro goal=13
    #[23] ∃n1. n = -(of_nat n1)
    #[24] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← rule disjI2 goal=24
    #[25] ∃n. x = -(of_nat n * pi)
  elim n1 goal=25 facts=[23]
    #[26] n = -(of_nat n1)
    #[27] ∃n. x = -(of_nat n * pi)
    #[28] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← inst n1 goal=27
    #[29] x = -(of_nat n1 * pi)
  → rewrite target=fact source=prev goal=29 facts=[26,11]
    #[30] x = -(of_nat n1) * pi
  ← rewrite real_mul_lneg sym=true goal=29
  ← intro goal=4
    #[31] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
    #[32] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi
  ← rule disjE goal=32 facts=[31]
    #[33] (∃n. x = of_nat n * pi) ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi)
    #[34] (∃n. x = -(of_nat n * pi)) ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi)
  ← intro goal=33
    #[35] ∃n. x = of_nat n * pi
    #[36] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi
  elim n1 goal=36 facts=[35]
    #[37] x = of_nat n1 * pi
    #[38] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi
  ← inst "(of_nat::nat ⇒ real) n1" goal=38
    #[39] ((∃n. (of_nat::nat ⇒ real) n1 = of_nat n) ∨ (∃n. (of_nat::nat ⇒ real) n1 = -(of_nat n))) ∧ x = of_nat n1 * pi
  ← rule conjI goal=39
    #[40] (∃n. (of_nat::nat ⇒ real) n1 = of_nat n) ∨ (∃n. (of_nat::nat ⇒ real) n1 = -(of_nat n))
  ← rule disjI1 goal=40
    #[41] ∃n. (of_nat::nat ⇒ real) n1 = of_nat n
  ← inst n1 goal=41
    #[42] (of_nat::nat ⇒ real) n1 = of_nat n1
  ← rule eq_refl goal=42
    #[43] (of_nat::nat ⇒ real) n1 = of_nat n1
  ← intro goal=34
    #[44] ∃n. x = -(of_nat n * pi)
    #[45] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi
  elim n1 goal=45 facts=[44]
    #[46] x = -(of_nat n1 * pi)
    #[47] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = n * pi
  ← inst "-(of_nat::nat ⇒ real) n1" goal=47
    #[48] ((∃n. -(of_nat n1) = of_nat n) ∨ (∃n. -(of_nat n1) = -(of_nat n))) ∧ x = -(of_nat n1) * pi
  ← rule conjI goal=48
    #[49] (∃n. -(of_nat n1) = of_nat n) ∨ (∃n. -(of_nat n1) = -(of_nat n))
    #[50] x = -(of_nat n1) * pi
  ← rule disjI2 goal=49
    #[51] ∃n. -(of_nat n1) = -(of_nat n)
  ← inst n1 goal=51
    #[52] -(of_nat n1) = -(of_nat n1)
  ← rule eq_refl goal=52
    #[53] -(of_nat n1) = -(of_nat n1)
  ← rewrite real_mul_lneg sym=false goal=50
qed

theorem cos_zero_pi
  fixes x :: real
  prop cos x = 0 <--> (?n. x = (of_nat n + 1 / 2) * pi) | (?n. x = -((of_nat n + 1 / 2) * pi))
  [hint_rewrite]
proof
  ← rewrite cos_eq_0 sym=false goal=0
    #[1] (∃n. integer n ∧ x = (n + 1 / 2) * pi) ⟷ (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← rewrite integer_cases sym=false goal=1
    #[2] (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = (n + 1 / 2) * pi) ⟷ (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← rule iffI goal=2
    #[3] (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = (n + 1 / 2) * pi) ⟶ (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
    #[4] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi)) ⟶ (∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = (n + 1 / 2) * pi)
  ← intro goal=3
    #[5] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = (n + 1 / 2) * pi
    #[6] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  elim n goal=6 facts=[5]
    #[7] _VAR n
    #[8] ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = (n + 1 / 2) * pi
    #[9] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  → forward conjD1 goal=9 facts=[8]
    #[10] (∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))
