def acs :: real ⇒ real = acs y = (THE x. 0 ≤ x ∧ x ≤ pi ∧ cos x = y)

theorem cos_acs
  fixes y :: real
  prop -1 <= y --> y <= 1 --> cos (acs y) = y
  [hint_backward,hint_backward1]

