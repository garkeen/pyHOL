theorem rpow_exp
  fixes p :: real, x :: real
  prop exp x ^ p = exp (x * p)
proof
  ← rewrite real_real_power_def sym=false goal=0
    #[1] (if 0 < exp x then exp (p * log (exp x)) else if exp x = 0 then if p = 0 then 1 else 0 else if ∃m. ∃n. odd m ∧ odd n ∧ abs p = of_nat m / of_nat n then -(exp (p * log (-(exp x)))) else exp (p * log (-(exp x)))) = exp (x * p)
  cut "0 < exp x" goal=1
    #[2] 0 < exp x
  ← rule real_exp_pos_lt goal=2
  ← rewrite if_P sym=false goal=1 facts=[2]
    #[3] exp (p * log (exp x)) = exp (x * p)
  ← rewrite log_exp sym=false goal=3
    #[4] exp (p * x) = exp (x * p)
  ← rewrite real_exp_inj sym=false goal=4
    #[5] p * x = x * p
  ← rule real_mult_comm goal=5
qed

theorem rpow_abs
  fixes x :: real
  prop x ^ (2::nat) ^ (1 / 2) = abs x
proof
  ← rewrite real_pow2_abs sym=true goal=0
    #[1] abs x ^ (2::nat) ^ (1 / 2) = abs x
  cut "0<= abs x" goal=1
    #[2] 0 ≤ abs x
  ← rule real_abs_pos goal=2
  → forward rpow_rpow param_m="(2::real)" param_n=1/2 goal=1 facts=[2]
    #[3] abs x ^ (2::real) ^ (1 / 2) = abs x ^ (2 * (1 / 2))
  ← rewrite rpow_pow sym=true goal=1
    #[4] abs x ^ (of_nat::nat ⇒ real) 2 ^ (1 / 2) = abs x
  ← rewrite real_of_nat_id sym=false goal=4
    #[5] abs x ^ (2::real) ^ (1 / 2) = abs x
  ← rewrite source=prev goal=5 facts=[3]
    #[6] abs x ^ (2 * (1 / 2)) = abs x
  cut "2 * (1 / 2)=1" goal=6
    #[7] 2 * (1 / 2) = 1
  real_norm goal=7
  ← rewrite source=prev goal=6 facts=[7]
    #[8] abs x ^ (1::real) = abs x
  ← rewrite rpow_1 sym=false goal=8
qed

theorem test1
  fixes x :: real
  prop 0 < x --> x < pi / 4 --> -(sin x) + cos x >= 0
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x < pi / 4
    #[3] -(sin x) + cos x ≥ 0
  ← rewrite greater_eq_def sym=false goal=3
    #[4] 0 ≤ -(sin x) + cos x
  cut "-(sin x) + cos x = -(sin x - cos x)" goal=4
    #[5] -(sin x) + cos x = -(sin x - cos x)
  real_norm goal=5
    #[6] -(sin x) + cos x = -(sin x - cos x)
  ← rewrite source=prev goal=4 facts=[6]
    #[7] 0 ≤ -(sin x - cos x)
  ← rewrite sin_cos_combine2 sym=false goal=7
    #[8] 0 ≤ -(-(sqrt 2) * cos (x + pi / 4))
  ← rewrite real_mul_lneg sym=false goal=8
    #[9] 0 ≤ --(sqrt 2 * cos (x + pi / 4))
  ← rewrite real_neg_neg sym=false goal=9
    #[10] 0 ≤ sqrt 2 * cos (x + pi / 4)
  ← rule real_le_mul goal=10
    #[11] 0 ≤ sqrt 2
    #[12] 0 ≤ cos (x + pi / 4)
  ← rule sqrt_pos_le goal=11
    #[13] (0::real) ≤ 2
  ← rule real_pos goal=13
    #[14] (0::real) ≤ 2
  ← rule cos_pos_pi_le goal=12
    #[15] -(pi / 2) ≤ x + pi / 4
    #[16] x + pi / 4 ≤ pi / 2
  cut "0 < pi" goal=15
    #[17] 0 < pi
  ← rule pi_pos goal=17
    #[18] 0 < pi
  cut "!p::real. 0 < x --> x < p /4 --> 0 < p --> -(p/2) <= x + p/4" goal=15
    #[19] ∀p. 0 < x ⟶ x < p / 4 ⟶ 0 < p ⟶ -(p / 2) ≤ x + p / 4
  ← z3 goal=19
    #[20] ∀p. 0 < x ⟶ x < p / 4 ⟶ 0 < p ⟶ -(p / 2) ≤ x + p / 4
  ← apply_prev goal=15 facts=[20]
  cut "∀p. 0 < x ⟶ x < p / 4 ⟶ 0 < p ⟶ x + p / 4 ≤ (p / 2)" goal=16
    #[21] ∀p. 0 < x ⟶ x < p / 4 ⟶ 0 < p ⟶ x + p / 4 ≤ p / 2
  ← z3 goal=21
    #[22] ∀p. 0 < x ⟶ x < p / 4 ⟶ 0 < p ⟶ x + p / 4 ≤ p / 2
  ← apply_prev goal=16 facts=[22]
qed

theorem test2
  fixes x :: real
  prop -3 * pi / 4 <= x --> x <= pi / 4 --> -(sin x) + cos x >= 0
proof
  ← intro goal=0
    #[1] -3 * pi / 4 ≤ x
    #[2] x ≤ pi / 4
    #[3] -(sin x) + cos x ≥ 0
  ← rewrite greater_eq_def sym=false goal=3
    #[4] 0 ≤ -(sin x) + cos x
  cut "-(sin x) + cos x = -(sin x - cos x)" goal=4
    #[5] -(sin x) + cos x = -(sin x - cos x)
  real_norm goal=5
    #[6] -(sin x) + cos x = -(sin x - cos x)
  ← rewrite source=prev goal=4 facts=[6]
    #[7] 0 ≤ -(sin x - cos x)
  ← rewrite sin_cos_combine2 sym=false goal=7
    #[8] 0 ≤ -(-(sqrt 2) * cos (x + pi / 4))
  ← rewrite real_mul_lneg sym=true goal=8
    #[9] 0 ≤ --(sqrt 2) * cos (x + pi / 4)
  ← rewrite real_neg_neg sym=false goal=9
    #[10] 0 ≤ sqrt 2 * cos (x + pi / 4)
  ← rule real_le_mul goal=10
    #[11] 0 ≤ sqrt 2
    #[12] 0 ≤ cos (x + pi / 4)
  ← rule sqrt_pos_le goal=11
    #[13] (0::real) ≤ 2
  ← rule real_pos goal=13
    #[14] (0::real) ≤ 2
  ← rule cos_pos_pi_le goal=12
    #[15] -(pi / 2) ≤ x + pi / 4
    #[16] x + pi / 4 ≤ pi / 2
  → forward pi_pos goal=15
    #[17] 0 < pi
  cut "!p::real. -3 * p / 4 ≤ x --> x ≤ p / 4 --> 0 < p --> -(p / 2) ≤ x + p / 4" goal=15
    #[18] ∀p. -3 * p / 4 ≤ x ⟶ x ≤ p / 4 ⟶ 0 < p ⟶ -(p / 2) ≤ x + p / 4
  ← z3 goal=18
    #[19] ∀p. -3 * p / 4 ≤ x ⟶ x ≤ p / 4 ⟶ 0 < p ⟶ -(p / 2) ≤ x + p / 4
  ← apply_prev goal=15 facts=[19]
  cut "∀p. -3 * p / 4 ≤ x ⟶ x ≤ p / 4 ⟶ 0 < p ⟶ x + p / 4 ≤ (p / 2)" goal=16
    #[20] ∀p. -3 * p / 4 ≤ x ⟶ x ≤ p / 4 ⟶ 0 < p ⟶ x + p / 4 ≤ p / 2
  ← z3 goal=20
    #[21] ∀p. -3 * p / 4 ≤ x ⟶ x ≤ p / 4 ⟶ 0 < p ⟶ x + p / 4 ≤ p / 2
  ← apply_prev goal=16 facts=[21]
qed

theorem test3
  fixes x :: real
  prop 1 < x --> x < 2 --> x ^ (4::nat) > 0
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] x < 2
    #[3] x ^ (4::nat) > 0
  cut "(4::nat) = ((2::nat) * 2)" goal=3
    #[4] (4::nat) = 2 * 2
  nat_norm goal=4
    #[5] (4::nat) = 2 * 2
  ← rewrite source=prev goal=3 facts=[5]
    #[6] x ^ ((2::nat) * 2) > 0
  ← rewrite mult_2 sym=false goal=6
    #[7] x ^ ((2::nat) + 2) > 0
  ← rewrite real_pow_add sym=false goal=7
    #[8] x ^ (2::nat) * x ^ (2::nat) > 0
  ← rewrite real_pow_2 sym=false goal=8
    #[9] x * x * (x * x) > 0
  ← z3 goal=9 facts=[1,2]
qed

