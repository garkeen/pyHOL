theorem cos_eq
  fixes x :: real, y :: real
  prop cos x = cos y <--> (?n. integer n & (x = y + 2 * n * pi | x = -y + 2 * n * pi))
proof
  cut "cos x = cos y <--> cos x - cos y = 0" goal=0
    #[1] cos x = cos y ⟷ cos x - cos y = 0
  ← rewrite real_sub_0 sym=false goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] cos x - cos y = 0 ⟷ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
  ← rewrite real_sub_cos sym=false goal=2
    #[3] 2 * sin ((x + y) / 2) * sin ((y - x) / 2) = 0 ⟷ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
  ← rewrite real_entire sym=false goal=3
    #[4] 2 * sin ((x + y) / 2) = 0 ∨ sin ((y - x) / 2) = 0 ⟷ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
  ← rewrite real_entire sym=false goal=4
    #[5] ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0 ⟷ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
  ← rule iffI goal=5
    #[6] ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
    #[7] (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)) ⟶ ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0
  ← intro goal=6
    #[8] ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0
    #[9] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  ← rule disjE goal=9 facts=[8]
    #[10] (2::real) = 0 ∨ sin ((x + y) / 2) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
    #[11] sin ((y - x) / 2) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
  ← intro goal=10
    #[12] (2::real) = 0 ∨ sin ((x + y) / 2) = 0
    #[13] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  ← rule disjE goal=13 facts=[12]
    #[14] (2::real) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
    #[15] sin ((x + y) / 2) = 0 ⟶ (∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi))
  ← intro goal=14
    #[16] (2::real) = 0
    #[17] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  ← z3 goal=17 facts=[16]
    #[18] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  ← intro goal=15
    #[19] sin ((x + y) / 2) = 0
    #[20] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  → rewrite target=fact sin_eq_0 sym=false goal=20 facts=[19]
    #[21] ∃n. integer n ∧ (x + y) / 2 = n * pi
  elim n goal=20 facts=[21]
    #[22] _VAR n
    #[23] integer n ∧ (x + y) / 2 = n * pi
    #[24] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  → forward conjD1 goal=24 facts=[23]
    #[25] integer n
  → forward conjD2 goal=24 facts=[23]
    #[26] (x + y) / 2 = n * pi
  ← inst n goal=24
    #[27] integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  ← rule conjI goal=27
    #[28] x = y + 2 * n * pi ∨ x = -y + 2 * n * pi
  ← rule disjI2 goal=28
    #[29] x = -y + 2 * n * pi
  → rewrite target=fact eq_sym_eq sym=false goal=29 facts=[26]
    #[30] n * pi = (x + y) / 2
  ← rewrite real_mult_assoc sym=true goal=29
    #[31] x = -y + 2 * (n * pi)
  ← rewrite source=prev goal=31 facts=[30]
    #[32] x = -y + 2 * ((x + y) / 2)
  real_norm goal=32
    #[33] x = -y + 2 * ((x + y) / 2)
  ← intro goal=11
    #[34] sin ((y - x) / 2) = 0
    #[35] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  → rewrite target=fact sin_eq_0 sym=false goal=35 facts=[34]
    #[36] ∃n. integer n ∧ (y - x) / 2 = n * pi
  elim n goal=35 facts=[36]
    #[37] integer n ∧ (y - x) / 2 = n * pi
    #[38] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
  → forward conjD1 goal=38 facts=[37]
    #[39] integer n
  → forward conjD2 goal=38 facts=[37]
    #[40] (y - x) / 2 = n * pi
  ← inst -n goal=38
    #[41] integer (-n) ∧ (x = y + 2 * -n * pi ∨ x = -y + 2 * -n * pi)
  ← rule conjI goal=41
    #[42] integer (-n)
    #[43] x = y + 2 * -n * pi ∨ x = -y + 2 * -n * pi
  ← rewrite integer_neg sym=false goal=42
  ← rule disjI1 goal=43
    #[44] x = y + 2 * -n * pi
  ← rewrite real_mult_assoc sym=true goal=44
    #[45] x = y + 2 * (-n * pi)
  ← rewrite real_mul_lneg sym=false goal=45
    #[46] x = y + 2 * -(n * pi)
  → rewrite target=fact eq_sym_eq sym=false goal=46 facts=[40]
    #[47] n * pi = (y - x) / 2
  ← rewrite source=prev goal=46 facts=[47]
    #[48] x = y + 2 * -((y - x) / 2)
  real_norm goal=48
    #[49] x = y + 2 * -((y - x) / 2)
  ← intro goal=7
    #[50] ∃n. integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
    #[51] ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0
  elim n goal=51 facts=[50]
    #[52] integer n ∧ (x = y + 2 * n * pi ∨ x = -y + 2 * n * pi)
    #[53] ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0
  → forward conjD1 goal=53 facts=[52]
    #[54] integer n
  → forward conjD2 goal=53 facts=[52]
    #[55] x = y + 2 * n * pi ∨ x = -y + 2 * n * pi
  ← rule disjE goal=53 facts=[55]
    #[56] x = y + 2 * n * pi ⟶ ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0
    #[57] x = -y + 2 * n * pi ⟶ ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0
  ← intro goal=56
    #[58] x = y + 2 * n * pi
    #[59] ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0
  ← rule disjI2 goal=59
    #[60] sin ((y - x) / 2) = 0
  ← rewrite source=prev goal=60 facts=[58]
    #[61] sin ((y - (y + 2 * n * pi)) / 2) = 0
  cut "(y - (y + 2 * n * pi)) / 2 = (-n) * pi" goal=61
    #[62] (y - (y + 2 * n * pi)) / 2 = -n * pi
  real_norm goal=62
    #[63] (y - (y + 2 * n * pi)) / 2 = -n * pi
  ← rewrite source=prev goal=61 facts=[63]
    #[64] sin (-n * pi) = 0
  ← rewrite sin_pimul_eq_0 sym=false goal=64
    #[65] integer (-n)
  ← rewrite integer_neg sym=false goal=65
  ← intro goal=57
    #[66] x = -y + 2 * n * pi
    #[67] ((2::real) = 0 ∨ sin ((x + y) / 2) = 0) ∨ sin ((y - x) / 2) = 0
  ← rule disjI1 goal=67
    #[68] (2::real) = 0 ∨ sin ((x + y) / 2) = 0
  ← rule disjI2 goal=68
    #[69] sin ((x + y) / 2) = 0
  ← rewrite source=prev goal=69 facts=[66]
    #[70] sin ((-y + 2 * n * pi + y) / 2) = 0
  cut "(-y + 2 * n * pi + y) / 2 = n * pi" goal=70
    #[71] (-y + 2 * n * pi + y) / 2 = n * pi
  real_norm goal=71
    #[72] (-y + 2 * n * pi + y) / 2 = n * pi
  ← rewrite source=prev goal=70 facts=[72]
    #[73] sin (n * pi) = 0
  ← rewrite sin_pimul_eq_0 sym=false goal=73
qed

def tan :: real ⇒ real = tan x = sin x / cos x [hint_rewrite]

theorem tan_0
  prop tan 0 = 0
  [hint_rewrite]
proof
  ← rewrite tan_def sym="" goal=0
    #[1] sin 0 / cos 0 = 0
  ← rewrite real_div_eq_0 sym=false goal=1
    #[2] sin 0 = 0 ∨ cos 0 = 0
  ← rule disjI1 goal=2
    #[3] sin 0 = 0
  ← rewrite real_sin_0 sym=false goal=3
qed

theorem tan_pi
  prop tan pi = 0
  [hint_rewrite]
proof
  ← rewrite tan_def sym=false goal=0
    #[1] sin pi / cos pi = 0
  ← rewrite real_div_eq_0 sym=false goal=1
    #[2] sin pi = 0 ∨ cos pi = 0
  ← rule disjI1 goal=2
    #[3] sin pi = 0
  ← rewrite real_sin_pi sym=false goal=3
qed

theorem tan_npi
  fixes n :: nat
  prop tan (of_nat n * pi) = 0
  [hint_rewrite]
proof
  ← rewrite tan_def sym=false goal=0
    #[1] sin (of_nat n * pi) / cos (of_nat n * pi) = 0
  ← rewrite sin_npi sym=false goal=1
    #[2] 0 / cos (of_nat n * pi) = 0
  ← rewrite real_div_eq_0 sym=false goal=2
    #[3] (0::real) = 0 ∨ cos (of_nat n * pi) = 0
  ← rule disjI1 goal=3
    #[4] (0::real) = 0
  ← rule eq_refl goal=4
qed

theorem tan_neg
  fixes x :: real
  prop tan (-x) = -(tan x)
  [hint_rewrite]
proof
  ← rewrite tan_def sym=false goal=0
    #[1] sin (-x) / cos (-x) = -(sin x / cos x)
  ← rewrite sin_neg sym=false goal=1
    #[2] -(sin x) / cos (-x) = -(sin x / cos x)
  ← rewrite cos_neg sym=false goal=2
    #[3] -(sin x) / cos x = -(sin x / cos x)
  ← rewrite real_divide_def sym=false goal=3
    #[4] -(sin x) * real_inverse (cos x) = -(sin x * real_inverse (cos x))
  ← rewrite real_mul_lneg sym=false goal=4
qed

theorem tan_periodic_pi
  fixes x :: real
  prop tan (x + pi) = tan x
  [hint_rewrite]
proof
  ← rewrite tan_def sym=false goal=0
    #[1] sin (x + pi) / cos (x + pi) = sin x / cos x
  ← rewrite sin_periodic_pi sym=false goal=1
    #[2] -(sin x) / cos (x + pi) = sin x / cos x
  ← rewrite cos_periodic_pi sym=false goal=2
    #[3] -(sin x) / -(cos x) = sin x / cos x
  ← rewrite real_divide_def sym=false goal=3
    #[4] -(sin x) * real_inverse (-(cos x)) = sin x * real_inverse (cos x)
  ← rewrite real_inv_neg sym=false goal=4
    #[5] -(sin x) * -(real_inverse (cos x)) = sin x * real_inverse (cos x)
  real_norm goal=5
qed

theorem tan_periodic_npi
  fixes n :: nat, x :: real
  prop tan (x + of_nat n * pi) = tan x
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] tan (x + of_nat 0 * pi) = tan x
    #[2] ∀n. tan (x + of_nat n * pi) = tan x ⟶ tan (x + of_nat (Suc n) * pi) = tan x
  ← rewrite real_zero_def sym=true goal=1
    #[3] tan (x + 0 * pi) = tan x
  ← rewrite real_mul_lzero sym=false goal=3
    #[4] tan (x + 0) = tan x
  ← rewrite real_add_rid sym=false goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] tan (x + of_nat n * pi) = tan x
    #[7] tan (x + of_nat (Suc n) * pi) = tan x
  ← rewrite add_1_right sym=true goal=7
    #[8] tan (x + of_nat (n + 1) * pi) = tan x
  ← rewrite real_of_nat_add sym=true goal=8
    #[9] tan (x + (of_nat n + of_nat 1) * pi) = tan x
  ← rewrite real_one_def sym=true goal=9
    #[10] tan (x + (of_nat n + 1) * pi) = tan x
  ← rewrite real_add_rdistrib sym=false goal=10
    #[11] tan (x + (of_nat n * pi + 1 * pi)) = tan x
  ← rewrite real_mul_lid sym=false goal=11
    #[12] tan (x + (of_nat n * pi + pi)) = tan x
  ← rewrite real_add_assoc sym=false goal=12
    #[13] tan (x + of_nat n * pi + pi) = tan x
  ← rewrite tan_periodic_pi sym=false goal=13
qed

theorem tan_add
  fixes x :: real, y :: real
  prop ~(cos x = 0) --> ~(cos y = 0) --> ~(cos (x + y) = 0) --> tan (x + y) = (tan x + tan y) / (1 - tan x * tan y)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(cos x = 0)
    #[2] ¬(cos y = 0)
    #[3] ¬(cos (x + y) = 0)
    #[4] tan (x + y) = (tan x + tan y) / (1 - tan x * tan y)
  ← rewrite tan_def sym=false goal=4
    #[5] sin (x + y) / cos (x + y) = (sin x / cos x + sin y / cos y) / (1 - sin x / cos x * (sin y / cos y))
  ← rewrite cos_add sym=false goal=5
    #[6] sin (x + y) / (cos x * cos y - sin x * sin y) = (sin x / cos x + sin y / cos y) / (1 - sin x / cos x * (sin y / cos y))
  ← rewrite sin_add sym=false goal=6
    #[7] (sin x * cos y + cos x * sin y) / (cos x * cos y - sin x * sin y) = (sin x / cos x + sin y / cos y) / (1 - sin x / cos x * (sin y / cos y))
  → rewrite target=fact cos_add sym=false goal=7 facts=[3]
    #[8] ¬(cos x * cos y - sin x * sin y = 0)
  cut "!cx::real. !cy. !sx. !sy. ~(cx = 0) --> ~(cy = 0) --> ~(cx *cy - sx * sy = 0) --> (sx * cy + cx * sy) / (cx * cy - sx * sy) = (sx / cx + sy / cy) / (1 - sx / cx * (sy / cy))" goal=7
    #[9] ∀cx. ∀cy. ∀sx. ∀sy. ¬(cx = 0) ⟶ ¬(cy = 0) ⟶ ¬(cx * cy - sx * sy = 0) ⟶ (sx * cy + cx * sy) / (cx * cy - sx * sy) = (sx / cx + sy / cy) / (1 - sx / cx * (sy / cy))
  ← z3 goal=9
    #[10] ∀cx. ∀cy. ∀sx. ∀sy. ¬(cx = 0) ⟶ ¬(cy = 0) ⟶ ¬(cx * cy - sx * sy = 0) ⟶ (sx * cy + cx * sy) / (cx * cy - sx * sy) = (sx / cx + sy / cy) / (1 - sx / cx * (sy / cy))
  ← apply_prev goal=7 facts=[10]
qed

theorem tan_sub
  fixes x :: real, y :: real
  prop ~(cos x = 0) --> ~(cos y = 0) --> ~(cos (x - y) = 0) --> tan (x - y) = (tan x - tan y) / (1 + tan x * tan y)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(cos x = 0)
    #[2] ¬(cos y = 0)
    #[3] ¬(cos (x - y) = 0)
    #[4] tan (x - y) = (tan x - tan y) / (1 + tan x * tan y)
  ← rewrite real_minus_def sym=false goal=4
    #[5] tan (x + -y) = (tan x + -(tan y)) / (1 + tan x * tan y)
  cut "(1 + tan x * tan y) = (1 - tan x * (-tan y))" goal=5
    #[6] 1 + tan x * tan y = 1 - tan x * -(tan y)
  ← rewrite real_mul_rneg sym=false goal=6
    #[7] 1 + tan x * tan y = 1 - -(tan x * tan y)
  real_norm goal=7
    #[8] 1 + tan x * tan y = 1 - -(tan x * tan y)
  ← rewrite source=prev goal=5 facts=[6]
    #[9] tan (x + -y) = (tan x + -(tan y)) / (1 - tan x * -(tan y))
  ← rewrite tan_neg sym=true goal=9
    #[10] tan (x + -y) = (tan x + tan (-y)) / (1 - tan x * tan (-y))
  ← rule tan_add goal=10
    #[11] ¬(cos (-y) = 0)
    #[12] ¬(cos (x + -y) = 0)
  ← rewrite cos_neg sym=false goal=11
  → rewrite target=fact real_minus_def sym=false goal=12 facts=[3]
    #[13] ¬(cos (x + -y) = 0)
qed

theorem tan_double
  fixes x :: real
  prop tan (2 * x) = 2 * tan x / (1 - tan x ^ (2::nat))
  [hint_rewrite]
proof
  ← cases "cos x = 0" goal=0
    #[1] cos x = 0 ⟶ tan (2 * x) = 2 * tan x / (1 - tan x ^ (2::nat))
    #[2] ¬(cos x = 0) ⟶ tan (2 * x) = 2 * tan x / (1 - tan x ^ (2::nat))
  ← intro goal=1
    #[3] cos x = 0
    #[4] tan (2 * x) = 2 * tan x / (1 - tan x ^ (2::nat))
  ← rewrite tan_def sym=false goal=4
    #[5] sin (2 * x) / cos (2 * x) = 2 * (sin x / cos x) / (1 - (sin x / cos x) ^ (2::nat))
  ← rewrite sin_double sym=false goal=5
    #[6] 2 * sin x * cos x / cos (2 * x) = 2 * (sin x / cos x) / (1 - (sin x / cos x) ^ (2::nat))
  ← rewrite source=prev goal=6 facts=[3]
    #[7] 2 * sin x * 0 / cos (2 * x) = 2 * (sin x / 0) / (1 - (sin x / 0) ^ (2::nat))
  ← rewrite real_divide_def sym=false goal=7
    #[8] 2 * sin x * 0 * real_inverse (cos (2 * x)) = 2 * (sin x / 0) * real_inverse (1 - (sin x / 0) ^ (2::nat))
  ← rewrite real_divide_def sym=false goal=8
    #[9] 2 * sin x * 0 * real_inverse (cos (2 * x)) = 2 * (sin x * real_inverse 0) * real_inverse (1 - (sin x * real_inverse 0) ^ (2::nat))
  ← rewrite real_inv_0 sym=false goal=9
    #[10] 2 * sin x * 0 * real_inverse (cos (2 * x)) = 2 * (sin x * 0) * real_inverse (1 - (sin x * 0) ^ (2::nat))
  real_norm goal=10
    #[11] 2 * sin x * 0 * real_inverse (cos (2 * x)) = 2 * (sin x * 0) * real_inverse (1 - (sin x * 0) ^ (2::nat))
  ← intro goal=2
    #[12] ¬(cos x = 0)
    #[13] tan (2 * x) = 2 * tan x / (1 - tan x ^ (2::nat))
  ← cases "cos (2* x) = 0" goal=13
    #[14] cos (2 * x) = 0 ⟶ tan (2 * x) = 2 * tan x / (1 - tan x ^ (2::nat))
    #[15] ¬(cos (2 * x) = 0) ⟶ tan (2 * x) = 2 * tan x / (1 - tan x ^ (2::nat))
  ← intro goal=14
    #[16] cos (2 * x) = 0
    #[17] tan (2 * x) = 2 * tan x / (1 - tan x ^ (2::nat))
  ← rewrite tan_def sym=false goal=17
    #[18] sin (2 * x) / cos (2 * x) = 2 * (sin x / cos x) / (1 - (sin x / cos x) ^ (2::nat))
  ← rewrite source=prev goal=18 facts=[16]
    #[19] sin (2 * x) / 0 = 2 * (sin x / cos x) / (1 - (sin x / cos x) ^ (2::nat))
  → rewrite target=fact cos_double sym=false goal=19 facts=[16]
    #[20] cos x ^ (2::nat) - sin x ^ (2::nat) = 0
  → rewrite target=fact real_sub_0 sym=false goal=19 facts=[20]
    #[21] cos x ^ (2::nat) = sin x ^ (2::nat)
  ← rewrite real_pow_div sym=false goal=19
    #[22] sin (2 * x) / 0 = 2 * (sin x / cos x) / (1 - sin x ^ (2::nat) / cos x ^ (2::nat))
  → rewrite target=fact eq_sym_eq sym=false goal=22 facts=[21]
    #[23] sin x ^ (2::nat) = cos x ^ (2::nat)
  ← rewrite source=prev goal=22 facts=[23]
    #[24] sin (2 * x) / 0 = 2 * (sin x / cos x) / (1 - cos x ^ (2::nat) / cos x ^ (2::nat))
  ← rewrite real_divide_def sym=false goal=24
    #[25] sin (2 * x) * real_inverse 0 = 2 * (sin x / cos x) * real_inverse (1 - cos x ^ (2::nat) / cos x ^ (2::nat))
  → forward real_pow_nz param_n="(2::nat)" goal=25 facts=[12]
    #[26] ¬(cos x ^ (2::nat) = 0)
  ← rewrite real_divide_def sym=false goal=25
    #[27] sin (2 * x) * real_inverse 0 = 2 * (sin x * real_inverse (cos x)) * real_inverse (1 - cos x ^ (2::nat) * real_inverse (cos x ^ (2::nat)))
  → forward real_mul_linv goal=27 facts=[26]
    #[28] real_inverse (cos x ^ (2::nat)) * cos x ^ (2::nat) = 1
  → rewrite target=fact real_mult_comm sym=false goal=27 facts=[28]
    #[29] cos x ^ (2::nat) * real_inverse (cos x ^ (2::nat)) = 1
  ← rewrite source=prev goal=27 facts=[29]
    #[30] sin (2 * x) * real_inverse 0 = 2 * (sin x * real_inverse (cos x)) * real_inverse (1 - 1)
  ← rewrite real_sub_refl sym=false goal=30
    #[31] sin (2 * x) * real_inverse 0 = 2 * (sin x * real_inverse (cos x)) * real_inverse 0
  ← rewrite real_inv_0 sym=false goal=31
    #[32] sin (2 * x) * 0 = 2 * (sin x * real_inverse (cos x)) * 0
  ← rewrite real_mul_rzero sym=false goal=32
    #[33] sin (2 * x) * 0 = 2 * (sin x * real_inverse (cos x)) * 0
  ← rewrite real_mul_2 sym=false goal=15
    #[34] ¬(cos (x + x) = 0) ⟶ tan (x + x) = (tan x + tan x) / (1 - tan x ^ (2::nat))
  ← intro goal=34
    #[35] ¬(cos (x + x) = 0)
    #[36] tan (x + x) = (tan x + tan x) / (1 - tan x ^ (2::nat))
  ← rewrite real_pow_2 sym=false goal=36
    #[37] tan (x + x) = (tan x + tan x) / (1 - tan x * tan x)
  ← rule tan_add goal=37
qed

def cot :: real ⇒ real = cot x = cos x / sin x [hint_rewrite]

theorem cot_double
  fixes x :: real
  prop cot (2 * x) = (cot x - tan x) / 2
  [hint_rewrite]
proof
  ← rewrite cot_def sym=false goal=0
    #[1] cos (2 * x) / sin (2 * x) = (cos x / sin x - tan x) / 2
  ← rewrite sin_double sym=false goal=1
    #[2] cos (2 * x) / (2 * sin x * cos x) = (cos x / sin x - tan x) / 2
  ← rewrite cos_double sym=false goal=2
    #[3] (cos x ^ (2::nat) - sin x ^ (2::nat)) / (2 * sin x * cos x) = (cos x / sin x - tan x) / 2
  ← rewrite tan_def sym=false goal=3
    #[4] (cos x ^ (2::nat) - sin x ^ (2::nat)) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
  ← rewrite real_pow_2 sym=false goal=4
    #[5] (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
  ← cases "sin x = 0" goal=5
    #[6] sin x = 0 ⟶ (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
    #[7] ¬(sin x = 0) ⟶ (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
  ← intro goal=6
    #[8] sin x = 0
    #[9] (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
  ← rewrite source=prev goal=9 facts=[8]
    #[10] (cos x * cos x - 0 * 0) / (2 * 0 * cos x) = (cos x / 0 - 0 / cos x) / 2
  ← rewrite real_divide_def sym=false goal=10
    #[11] (cos x * cos x - 0 * 0) * real_inverse (2 * 0 * cos x) = (cos x / 0 - 0 / cos x) * real_inverse 2
  ← rewrite real_divide_def sym=false goal=11
    #[12] (cos x * cos x - 0 * 0) * real_inverse (2 * 0 * cos x) = (cos x * real_inverse 0 - 0 * real_inverse (cos x)) * real_inverse 2
  ← rewrite real_inv_0 sym=false goal=12
    #[13] (cos x * cos x - 0 * 0) * real_inverse (2 * 0 * cos x) = (cos x * 0 - 0 * real_inverse (cos x)) * real_inverse 2
  ← rewrite real_mul_lzero sym=false goal=13
    #[14] (cos x * cos x - 0) * real_inverse (2 * 0 * cos x) = (cos x * 0 - 0) * real_inverse 2
  ← rewrite real_mul_rzero sym=false goal=14
    #[15] (cos x * cos x - 0) * real_inverse (0 * cos x) = (0 - 0) * real_inverse 2
  ← rewrite real_mul_lzero sym=false goal=15
    #[16] (cos x * cos x - 0) * real_inverse 0 = (0 - 0) * real_inverse 2
  ← rewrite real_sub_rzero sym=false goal=16
    #[17] cos x * cos x * real_inverse 0 = 0 * real_inverse 2
  ← rewrite real_inv_0 sym=false goal=17
    #[18] cos x * cos x * 0 = 0 * real_inverse 2
  real_norm goal=18
    #[19] cos x * cos x * 0 = 0 * real_inverse 2
  ← intro goal=7
    #[20] ¬(sin x = 0)
    #[21] (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
  ← cases "cos x = 0" goal=21
    #[22] cos x = 0 ⟶ (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
    #[23] ¬(cos x = 0) ⟶ (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
  ← intro goal=22
    #[24] cos x = 0
    #[25] (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
  ← rewrite source=prev goal=25 facts=[24]
    #[26] (0 * 0 - sin x * sin x) / (2 * sin x * 0) = (0 / sin x - sin x / 0) / 2
  ← rewrite real_divide_def sym=false goal=26
    #[27] (0 * 0 - sin x * sin x) * real_inverse (2 * sin x * 0) = (0 / sin x - sin x / 0) * real_inverse 2
  ← rewrite real_divide_def sym=false goal=27
    #[28] (0 * 0 - sin x * sin x) * real_inverse (2 * sin x * 0) = (0 * real_inverse (sin x) - sin x * real_inverse 0) * real_inverse 2
  ← rewrite real_mul_lzero sym=false goal=28
    #[29] (0 - sin x * sin x) * real_inverse (2 * sin x * 0) = (0 - sin x * real_inverse 0) * real_inverse 2
  ← rewrite real_mul_rzero sym=false goal=29
    #[30] (0 - sin x * sin x) * real_inverse 0 = (0 - sin x * real_inverse 0) * real_inverse 2
  ← rewrite real_inv_0 sym=false goal=30
    #[31] (0 - sin x * sin x) * 0 = (0 - sin x * 0) * real_inverse 2
  real_norm goal=31
    #[32] (0 - sin x * sin x) * 0 = (0 - sin x * 0) * real_inverse 2
  ← intro goal=23
    #[33] ¬(cos x = 0)
    #[34] (cos x * cos x - sin x * sin x) / (2 * sin x * cos x) = (cos x / sin x - sin x / cos x) / 2
  cut "!sx. !cx. ~(sx=0)-->~(cx=0)-->(cx * cx - sx * sx) / (2 * sx * cx) = (cx / sx - sx / cx) / 2" goal=34
    #[35] ∀sx. ∀cx. ¬(sx = 0) ⟶ ¬(cx = 0) ⟶ (cx * cx - sx * sx) / (2 * sx * cx) = (cx / sx - sx / cx) / 2
  ← z3 goal=35
    #[36] ∀sx. ∀cx. ¬(sx = 0) ⟶ ¬(cx = 0) ⟶ (cx * cx - sx * sx) / (2 * sx * cx) = (cx / sx - sx / cx) / 2
  ← apply_prev goal=34 facts=[36]
qed

theorem tan_cot_double
  fixes x :: real
  prop tan x = cot x - 2 * cot (2 * x)
  [hint_rewrite]
proof
  ← rewrite cot_double sym=false goal=0
    #[1] tan x = cot x - 2 * ((cot x - tan x) / 2)
  real_norm goal=1
qed

theorem real_add_tan
  fixes x :: real, y :: real
  prop ~(cos x = 0) --> ~(cos y = 0) --> tan x + tan y = sin (x + y) / (cos x * cos y)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(cos x = 0)
    #[2] ¬(cos y = 0)
    #[3] tan x + tan y = sin (x + y) / (cos x * cos y)
  ← rewrite sin_add sym=false goal=3
    #[4] tan x + tan y = (sin x * cos y + cos x * sin y) / (cos x * cos y)
  ← rewrite tan_def sym=false goal=4
    #[5] sin x / cos x + sin y / cos y = (sin x * cos y + cos x * sin y) / (cos x * cos y)
  cut "!sx. !cx. !sy. !cy. ~(cx=0) --> ~(cy = 0) --> sx / cx + sy / cy = (sx * cy + cx * sy) / (cx * cy)" goal=5
    #[6] ∀sx. ∀cx. ∀sy. ∀cy. ¬(cx = 0) ⟶ ¬(cy = 0) ⟶ sx / cx + sy / cy = (sx * cy + cx * sy) / (cx * cy)
  ← z3 goal=6
    #[7] ∀sx. ∀cx. ∀sy. ∀cy. ¬(cx = 0) ⟶ ¬(cy = 0) ⟶ sx / cx + sy / cy = (sx * cy + cx * sy) / (cx * cy)
  ← apply_prev goal=5 facts=[7]
qed

theorem real_sub_tan
  fixes x :: real, y :: real
  prop ~(cos x = 0) --> ~(cos y = 0) --> tan x - tan y = sin (x - y) / (cos x * cos y)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(cos x = 0)
    #[2] ¬(cos y = 0)
    #[3] tan x - tan y = sin (x - y) / (cos x * cos y)
  ← rewrite real_minus_def sym=false goal=3
    #[4] tan x + -(tan y) = sin (x + -y) / (cos x * cos y)
  ← rewrite tan_neg sym=true goal=4
    #[5] tan x + tan (-y) = sin (x + -y) / (cos x * cos y)
  cut "cos y = cos (-y)" goal=5
    #[6] cos y = cos (-y)
  ← rewrite cos_neg sym=false goal=6
    #[7] cos y = cos (-y)
  ← rewrite source=prev goal=5 facts=[7]
    #[8] tan x + tan (-y) = sin (x + -y) / (cos x * cos (-y))
  ← rule real_add_tan goal=8
    #[9] ¬(cos (-y) = 0)
  ← rewrite cos_neg sym=false goal=9
qed

theorem tan_pi4
  prop tan (pi / 4) = 1
  [hint_rewrite]
proof
  ← rewrite tan_def sym=false goal=0
    #[1] sin (pi / 4) / cos (pi / 4) = 1
  cut "pi / 4 = 1 / 4 * pi" goal=1
    #[2] pi / 4 = 1 / 4 * pi
  real_norm goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] sin (1 / 4 * pi) / cos (1 / 4 * pi) = 1
  ← rewrite real_sin_pi4 sym=false goal=3
    #[4] sqrt 2 / 2 / cos (1 / 4 * pi) = 1
  ← rewrite real_cos_pi4 sym=false goal=4
    #[5] sqrt 2 / 2 / (sqrt 2 / 2) = 1
  ← rewrite real_divide_def sym=false goal=5
    #[6] sqrt 2 / 2 * real_inverse (sqrt 2 / 2) = 1
  ← rewrite real_mult_comm sym=false goal=6
    #[7] real_inverse (sqrt 2 / 2) * (sqrt 2 / 2) = 1
  ← rule real_mul_linv goal=7
    #[8] ¬(sqrt 2 / 2 = 0)
  ← rewrite real_div_eq_0 sym=false goal=8
    #[9] ¬(sqrt 2 = 0 ∨ (2::real) = 0)
  ← rewrite de_morgan_thm2 sym=false goal=9
    #[10] ¬(sqrt 2 = 0) ∧ ¬((2::real) = 0)
  ← rule conjI goal=10
    #[11] ¬(sqrt 2 = 0)
    #[12] ¬((2::real) = 0)
  ← rewrite sqrt_eq_0 sym=false goal=11
  nat_const_ineq goal=12
  nat_const_ineq goal=12
qed

theorem tan_pos_pi2
  fixes x :: real
  prop 0 < x --> x < pi / 2 --> 0 < tan x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x < pi / 2
    #[3] 0 < tan x
  ← rewrite tan_def sym=false goal=3
    #[4] 0 < sin x / cos x
  ← rewrite real_divide_def sym=false goal=4
    #[5] 0 < sin x * real_inverse (cos x)
  ← rule real_lt_mul goal=5
    #[6] 0 < sin x
    #[7] 0 < real_inverse (cos x)
  ← rule sin_pos_pi2 goal=6
  ← rule real_lt_inv goal=7
    #[8] 0 < cos x
  ← rule cos_pos_pi2 goal=8
qed

theorem tan_pos_pi2_le
  fixes x :: real
  prop 0 <= x --> x < pi / 2 --> 0 <= tan x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x < pi / 2
    #[3] 0 ≤ tan x
  → rewrite target=fact real_le_lt sym=false goal=3 facts=[1]
    #[4] 0 < x ∨ 0 = x
  ← rule disjE goal=3 facts=[4]
    #[5] 0 < x ⟶ 0 ≤ tan x
    #[6] 0 = x ⟶ 0 ≤ tan x
  ← intro goal=5
    #[7] 0 < x
    #[8] 0 ≤ tan x
  ← rule real_lt_imp_le goal=8
    #[9] 0 < tan x
  ← rule tan_pos_pi2 goal=9
  ← intro goal=6
    #[10] 0 = x
    #[11] 0 ≤ tan x
  → rewrite target=fact eq_sym_eq sym=false goal=11 facts=[10]
    #[12] x = 0
  ← rewrite source=prev goal=11 facts=[12]
    #[13] 0 ≤ tan 0
  ← rewrite tan_0 sym=false goal=13
    #[14] (0::real) ≤ 0
  ← rule real_le_refl goal=14
    #[15] (0::real) ≤ 0
qed

theorem cos_tan
  fixes x :: real
  prop abs x < pi / 2 --> cos x = 1 / sqrt (1 + tan x ^ (2::nat))
  [hint_backward]
proof
  ← intro goal=0
    #[1] abs x < pi / 2
    #[2] cos x = 1 / sqrt (1 + tan x ^ (2::nat))
  cut "!a. !c. !s. a * a = s --> c * c * s = 1 --> ~(1 + c * a = 0)\n    --> c = 1 / a" goal=2
    #[3] ∀a. ∀c. ∀s. a * a = s ⟶ c * c * s = 1 ⟶ ¬(1 + c * a = 0) ⟶ c = 1 / a
  ← z3 goal=3
    #[4] ∀a. ∀c. ∀s. a * a = s ⟶ c * c * s = 1 ⟶ ¬(1 + c * a = 0) ⟶ c = 1 / a
  ← apply_prev param_s="1 + tan x ^ (2::nat)" goal=2 facts=[4]
    #[5] sqrt (1 + tan x ^ (2::nat)) * sqrt (1 + tan x ^ (2::nat)) = 1 + tan x ^ (2::nat)
    #[6] cos x * cos x * (1 + tan x ^ (2::nat)) = 1
    #[7] ¬(1 + cos x * sqrt (1 + tan x ^ (2::nat)) = 0)
  ← rewrite sqrt_mul sym=true goal=5
    #[8] sqrt ((1 + tan x ^ (2::nat)) * (1 + tan x ^ (2::nat))) = 1 + tan x ^ (2::nat)
  ← rewrite real_pow_2 sym=true goal=8
    #[9] sqrt ((1 + tan x ^ (2::nat)) ^ (2::nat)) = 1 + tan x ^ (2::nat)
  ← rule pow_2_sqrt goal=9
    #[10] 0 ≤ 1 + tan x ^ (2::nat)
  ← rule real_le_add goal=10
    #[11] (0::real) ≤ 1
    #[12] 0 ≤ tan x ^ (2::nat)
  ← z3 goal=11
    #[13] (0::real) ≤ 1
  ← rule real_le_pow_2 goal=12
    #[14] 0 ≤ tan x ^ (2::nat)
  ← rewrite real_pow_2 sym=true goal=6
    #[15] cos x ^ (2::nat) * (1 + tan x ^ (2::nat)) = 1
  ← rewrite real_add_ldistrib sym=false goal=15
    #[16] cos x ^ (2::nat) * 1 + cos x ^ (2::nat) * tan x ^ (2::nat) = 1
  ← rewrite tan_def sym=false goal=16
    #[17] cos x ^ (2::nat) * 1 + cos x ^ (2::nat) * (sin x / cos x) ^ (2::nat) = 1
  ← rewrite real_pow_div sym=false goal=17
    #[18] cos x ^ (2::nat) * 1 + cos x ^ (2::nat) * (sin x ^ (2::nat) / cos x ^ (2::nat)) = 1
  cut "!a. !b. ~(b=0) --> b * (a / b) = a" goal=18
    #[19] ∀a. ∀b. ¬(b = 0) ⟶ b * (a / b) = a
  ← z3 goal=19
    #[20] ∀a. ∀b. ¬(b = 0) ⟶ b * (a / b) = a
  cut "cos x ^ (2::nat) * (sin x ^ (2::nat) / cos x ^ (2::nat)) = sin x ^ (2::nat)" goal=18
    #[21] cos x ^ (2::nat) * (sin x ^ (2::nat) / cos x ^ (2::nat)) = sin x ^ (2::nat)
  ← apply_prev goal=21 facts=[20]
    #[22] ¬(cos x ^ (2::nat) = 0)
  ← rule real_pow_nz goal=22
    #[23] ¬(cos x = 0)
  cut "!a::real. 0 < a --> ~(a = 0)" goal=23
    #[24] ∀a::real. 0 < a ⟶ ¬(a = 0)
  ← z3 goal=24
    #[25] ∀a::real. 0 < a ⟶ ¬(a = 0)
  ← apply_prev goal=23 facts=[25]
    #[26] 0 < cos x
  ← rule cos_pos_pi goal=26
    #[27] -(pi / 2) < x
    #[28] x < pi / 2
  → rewrite target=fact real_abs_lt sym=false goal=27 facts=[1]
    #[29] -(pi / 2) < x ∧ x < pi / 2
  ← rule conjD1 goal=27 facts=[29]
  ← rule conjD2 goal=28 facts=[29]
  ← rewrite source=prev goal=18 facts=[21]
    #[30] cos x ^ (2::nat) * 1 + sin x ^ (2::nat) = 1
  ← rewrite real_mul_rid sym=false goal=30
    #[31] cos x ^ (2::nat) + sin x ^ (2::nat) = 1
  ← rewrite real_add_comm sym=false goal=31
    #[32] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  ← rewrite sin_circle sym=false goal=32
    #[33] sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  ← apply_prev goal=7 facts=[25]
    #[34] 0 < 1 + cos x * sqrt (1 + tan x ^ (2::nat))
  ← rule real_lt_trans param_y="cos x * sqrt (1 + tan x ^ (2::nat))" goal=34
    #[35] 0 < cos x * sqrt (1 + tan x ^ (2::nat))
    #[36] cos x * sqrt (1 + tan x ^ (2::nat)) < 1 + cos x * sqrt (1 + tan x ^ (2::nat))
  ← rule real_lt_mul goal=35
    #[37] 0 < sqrt (1 + tan x ^ (2::nat))
  ← rewrite sqrt_lt_0 sym=false goal=37
    #[38] 0 < 1 + tan x ^ (2::nat)
  ← rule real_let_trans param_y="tan x ^ (2::nat)" goal=38
    #[39] tan x ^ (2::nat) < 1 + tan x ^ (2::nat)
  cut "∀a::real. a < 1 + a" goal=39
    #[40] ∀a::real. a < 1 + a
  ← z3 goal=40
    #[41] ∀a::real. a < 1 + a
  ← apply_prev goal=39 facts=[41]
    #[42] tan x ^ (2::nat) < 1 + tan x ^ (2::nat)
  ← apply_prev goal=36 facts=[41]
    #[43] cos x * sqrt (1 + tan x ^ (2::nat)) < 1 + cos x * sqrt (1 + tan x ^ (2::nat))
qed

theorem sin_tan
  fixes x :: real
  prop abs x < pi / 2 --> sin x = tan x / sqrt (1 + tan x ^ (2::nat))
  [hint_backward]
proof
  ← intro goal=0
    #[1] abs x < pi / 2
    #[2] sin x = tan x / sqrt (1 + tan x ^ (2::nat))
  cut "∀a. ∀b. a / b = a * (1 / b)" goal=2
    #[3] ∀a. ∀b. a / b = a * (1 / b)
  ← intro "a, b" goal=3
    #[4] _VAR a
    #[5] _VAR b
    #[6] a / b = a * (1 / b)
  ← rewrite real_divide_def sym=false goal=6
    #[7] a * real_inverse b = a * (1 * real_inverse b)
  ← rewrite real_mul_lid sym=false goal=7
    #[8] a * real_inverse b = a * (1 * real_inverse b)
  → forward cos_tan goal=2 facts=[1]
    #[9] cos x = 1 / sqrt (1 + tan x ^ (2::nat))
  → rewrite target=fact eq_sym_eq sym=false goal=2 facts=[9]
    #[10] 1 / sqrt (1 + tan x ^ (2::nat)) = cos x
  ← rewrite source=prev goal=2 facts=[3]
    #[11] sin x = tan x * (1 / sqrt (1 + tan x ^ (2::nat)))
  ← rewrite source=prev goal=11 facts=[10]
    #[12] sin x = tan x * cos x
  ← rewrite tan_def sym=false goal=12
    #[13] sin x = sin x / cos x * cos x
  ← rewrite real_divide_def sym=false goal=13
    #[14] sin x = sin x * real_inverse (cos x) * cos x
  ← rewrite real_mult_assoc sym=true goal=14
    #[15] sin x = sin x * (real_inverse (cos x) * cos x)
  cut "real_inverse (cos x) * cos x = 1" goal=15
    #[16] real_inverse (cos x) * cos x = 1
  ← rule real_mul_linv goal=16
    #[17] ¬(cos x = 0)
  → rewrite target=fact real_abs_lt sym=false goal=17 facts=[1]
    #[18] -(pi / 2) < x ∧ x < pi / 2
  cut "!a::real. 0 < a --> ~(a = 0)" goal=17
    #[19] ∀a::real. 0 < a ⟶ ¬(a = 0)
  ← z3 goal=19
    #[20] ∀a::real. 0 < a ⟶ ¬(a = 0)
  ← apply_prev goal=17 facts=[20]
    #[21] 0 < cos x
  ← rule cos_pos_pi goal=21
    #[22] -(pi / 2) < x
    #[23] x < pi / 2
  ← rule conjD1 goal=22 facts=[18]
  ← rule conjD2 goal=23 facts=[18]
  ← rewrite source=prev goal=15 facts=[16]
    #[24] sin x = sin x * 1
  ← rewrite real_mul_rid sym=false goal=24
    #[25] sin x = sin x * 1
qed

theorem sin_mono_lt
  fixes x :: real, y :: real
  prop -(pi / 2) <= x --> x < y --> y <= pi / 2 --> sin x < sin y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) ≤ x
    #[2] x < y
    #[3] y ≤ pi / 2
    #[4] sin x < sin y
  ← rewrite real_sub_lt sym=true goal=4
    #[5] 0 < sin y - sin x
  ← rewrite real_sub_sin sym=false goal=5
    #[6] 0 < 2 * sin ((y - x) / 2) * cos ((y + x) / 2)
  ← rule real_lt_mul goal=6
    #[7] 0 < 2 * sin ((y - x) / 2)
    #[8] 0 < cos ((y + x) / 2)
  ← rule real_lt_mul goal=7
    #[9] (0::real) < 2
    #[10] 0 < sin ((y - x) / 2)
  ← z3 goal=9
    #[11] (0::real) < 2
  ← rule sin_pos_pi goal=10
    #[12] 0 < (y - x) / 2
    #[13] (y - x) / 2 < pi
  ← rewrite real_divide_def sym=false goal=12
    #[14] 0 < (y - x) * real_inverse 2
  ← rule real_lt_mul goal=14
    #[15] 0 < y - x
    #[16] 0 < real_inverse 2
  ← rewrite real_sub_lt sym=false goal=15
  ← rule real_lt_inv goal=16
  cut "∀p. 0 < p --> -(p / 2) ≤ x ⟶ y ≤ p / 2 ⟶ (y - x) / 2 < p" goal=13
    #[17] ∀p. 0 < p ⟶ -(p / 2) ≤ x ⟶ y ≤ p / 2 ⟶ (y - x) / 2 < p
  ← z3 goal=17
    #[18] ∀p. 0 < p ⟶ -(p / 2) ≤ x ⟶ y ≤ p / 2 ⟶ (y - x) / 2 < p
  ← apply_prev goal=13 facts=[18]
    #[19] 0 < pi
  ← rule pi_pos goal=19
    #[20] 0 < pi
  ← rule cos_pos_pi goal=8
    #[21] -(pi / 2) < (y + x) / 2
    #[22] (y + x) / 2 < pi / 2
  cut "∀p. 0 < p ⟶ -(p / 2) ≤ x ⟶ x < y ⟶ -(p/2) < (y + x) / 2" goal=21
    #[23] ∀p. 0 < p ⟶ -(p / 2) ≤ x ⟶ x < y ⟶ -(p / 2) < (y + x) / 2
  ← z3 goal=23
    #[24] ∀p. 0 < p ⟶ -(p / 2) ≤ x ⟶ x < y ⟶ -(p / 2) < (y + x) / 2
  ← apply_prev goal=21 facts=[24]
  cut "∀p. 0 < p ⟶ x < y ⟶ y ≤ p / 2 ⟶ (y + x) / 2 < p / 2" goal=22
    #[25] ∀p. 0 < p ⟶ x < y ⟶ y ≤ p / 2 ⟶ (y + x) / 2 < p / 2
  ← z3 goal=25
    #[26] ∀p. 0 < p ⟶ x < y ⟶ y ≤ p / 2 ⟶ (y + x) / 2 < p / 2
  ← apply_prev goal=22 facts=[26]
qed

theorem sin_mono_le
  fixes x :: real, y :: real
  prop -(pi / 2) <= x --> x <= y --> y <= pi / 2 --> sin x <= sin y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) ≤ x
    #[2] x ≤ y
    #[3] y ≤ pi / 2
    #[4] sin x ≤ sin y
  → rewrite target=fact real_le_lt sym=false goal=4 facts=[2]
    #[5] x < y ∨ x = y
  ← rule disjE goal=4 facts=[5]
    #[6] x < y ⟶ sin x ≤ sin y
    #[7] x = y ⟶ sin x ≤ sin y
  ← intro goal=6
    #[8] x < y
    #[9] sin x ≤ sin y
  ← rule real_lt_imp_le goal=9
    #[10] sin x < sin y
  ← rule sin_mono_lt goal=10
  ← intro goal=7
    #[11] x = y
    #[12] sin x ≤ sin y
  ← rewrite source=prev goal=12 facts=[11]
    #[13] sin y ≤ sin y
  ← rule real_le_refl goal=13
    #[14] sin y ≤ sin y
qed

theorem sin_mono_lt_eq
  fixes x :: real, y :: real
  prop -(pi / 2) <= x --> x <= pi / 2 --> -(pi / 2) <= y --> y <= pi / 2 --> sin x < sin y <--> x < y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) ≤ x
    #[2] x ≤ pi / 2
    #[3] -(pi / 2) ≤ y
    #[4] y ≤ pi / 2
    #[5] sin x < sin y ⟷ x < y
  ← rule iffI goal=5
    #[6] sin x < sin y ⟶ x < y
    #[7] x < y ⟶ sin x < sin y
  ← intro goal=6
    #[8] sin x < sin y
    #[9] x < y
  ← rewrite real_less_def sym=false goal=9
    #[10] ¬(y ≤ x)
  → rewrite target=fact real_less_def sym=false goal=10 facts=[8]
    #[11] ¬(sin y ≤ sin x)
  ← rule contrapositive goal=10 facts=[11]
    #[12] ¬¬(y ≤ x) ⟶ ¬¬(sin y ≤ sin x)
  ← rewrite double_neg sym=false goal=12
    #[13] y ≤ x ⟶ sin y ≤ sin x
  ← intro goal=13
    #[14] y ≤ x
    #[15] sin y ≤ sin x
  ← rule sin_mono_le goal=15
  ← intro goal=7
    #[16] x < y
    #[17] sin x < sin y
  ← rule sin_mono_lt goal=17
qed

theorem sin_mono_le_eq
  fixes x :: real, y :: real
  prop -(pi / 2) <= x --> x <= pi / 2 --> -(pi / 2) <= y --> y <= pi / 2 --> sin x <= sin y <--> x <= y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) ≤ x
    #[2] x ≤ pi / 2
    #[3] -(pi / 2) ≤ y
    #[4] y ≤ pi / 2
    #[5] sin x ≤ sin y ⟷ x ≤ y
  ← rule iffI goal=5
    #[6] sin x ≤ sin y ⟶ x ≤ y
    #[7] x ≤ y ⟶ sin x ≤ sin y
  ← intro goal=6
    #[8] sin x ≤ sin y
    #[9] x ≤ y
  ← rewrite real_not_lt sym=true goal=9
    #[10] ¬(y < x)
  → rewrite target=fact real_not_lt sym=true goal=10 facts=[8]
    #[11] ¬(sin y < sin x)
  ← rule contrapositive goal=10 facts=[11]
    #[12] ¬¬(y < x) ⟶ ¬¬(sin y < sin x)
  ← rewrite double_neg sym=false goal=12
    #[13] y < x ⟶ sin y < sin x
  ← intro goal=13
    #[14] y < x
    #[15] sin y < sin x
  ← rule sin_mono_lt goal=15
  ← intro goal=7
    #[16] x ≤ y
    #[17] sin x ≤ sin y
  ← rule sin_mono_le goal=17
qed

theorem sin_inj_pi
  fixes x :: real, y :: real
  prop -(pi / 2) <= x --> x <= pi / 2 --> -(pi / 2) <= y --> y <= pi / 2 --> sin x = sin y --> x = y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) ≤ x
    #[2] x ≤ pi / 2
    #[3] -(pi / 2) ≤ y
    #[4] y ≤ pi / 2
    #[5] sin x = sin y
    #[6] x = y
  ← rewrite real_le_antisym sym=true goal=6
    #[7] x ≤ y ∧ y ≤ x
  → rewrite target=fact real_le_antisym sym=true goal=7 facts=[5]
    #[8] sin x ≤ sin y ∧ sin y ≤ sin x
  → forward conjD1 goal=7 facts=[8]
    #[9] sin x ≤ sin y
  → forward conjD2 goal=7 facts=[8]
    #[10] sin y ≤ sin x
  ← rule conjI goal=7
    #[11] x ≤ y
    #[12] y ≤ x
  → forward sin_mono_le_eq goal=11 facts=[1,2,3,4]
    #[13] sin x ≤ sin y ⟷ x ≤ y
  → rewrite target=fact source=prev goal=11 facts=[13,9]
  → forward sin_mono_le_eq goal=12 facts=[3,4,1,2]
    #[14] sin y ≤ sin x ⟷ y ≤ x
  → rewrite target=fact source=prev goal=12 facts=[14,10]
qed

theorem cos_mono_lt
  fixes x :: real, y :: real
  prop 0 <= x --> x < y --> y <= pi --> cos y < cos x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x < y
    #[3] y ≤ pi
    #[4] cos y < cos x
  ← rewrite real_sub_lt sym=true goal=4
    #[5] 0 < cos x - cos y
  ← rewrite real_sub_cos sym=false goal=5
    #[6] 0 < 2 * sin ((x + y) / 2) * sin ((y - x) / 2)
  ← rule real_lt_mul goal=6
    #[7] 0 < 2 * sin ((x + y) / 2)
    #[8] 0 < sin ((y - x) / 2)
  ← rule real_lt_mul goal=7
    #[9] (0::real) < 2
    #[10] 0 < sin ((x + y) / 2)
  ← z3 goal=9
    #[11] (0::real) < 2
  ← rule sin_pos_pi goal=10
    #[12] 0 < (x + y) / 2
    #[13] (x + y) / 2 < pi
  ← z3 goal=12 facts=[1,2]
    #[14] 0 < (x + y) / 2
  cut "!p. x < y --> y ≤ p --> (x + y) / 2 < p" goal=13
    #[15] ∀p. x < y ⟶ y ≤ p ⟶ (x + y) / 2 < p
  ← z3 goal=15
    #[16] ∀p. x < y ⟶ y ≤ p ⟶ (x + y) / 2 < p
  ← apply_prev goal=13 facts=[16]
  ← rule sin_pos_pi goal=8
    #[17] 0 < (y - x) / 2
    #[18] (y - x) / 2 < pi
  ← z3 goal=17 facts=[2]
    #[19] 0 < (y - x) / 2
  cut "∀p. 0 < p --> 0 <= x ⟶ y ≤ p ⟶ (y - x) / 2 < p" goal=18
    #[20] ∀p. 0 < p ⟶ 0 ≤ x ⟶ y ≤ p ⟶ (y - x) / 2 < p
  ← z3 goal=20
    #[21] ∀p. 0 < p ⟶ 0 ≤ x ⟶ y ≤ p ⟶ (y - x) / 2 < p
  ← apply_prev goal=18 facts=[21]
    #[22] 0 < pi
  ← rule pi_pos goal=22
    #[23] 0 < pi
qed

theorem cos_mono_le
  fixes x :: real, y :: real
  prop 0 <= x --> x <= y --> y <= pi --> cos y <= cos x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ y
    #[3] y ≤ pi
    #[4] cos y ≤ cos x
  → rewrite target=fact real_le_lt sym=false goal=4 facts=[2]
    #[5] x < y ∨ x = y
  ← rule disjE goal=4 facts=[5]
    #[6] x < y ⟶ cos y ≤ cos x
    #[7] x = y ⟶ cos y ≤ cos x
  ← intro goal=6
    #[8] x < y
    #[9] cos y ≤ cos x
  ← rule real_lt_imp_le goal=9
    #[10] cos y < cos x
  ← rule cos_mono_lt goal=10
  ← intro goal=7
    #[11] x = y
    #[12] cos y ≤ cos x
  ← rewrite source=prev goal=12 facts=[11]
    #[13] cos y ≤ cos y
  ← rule real_le_refl goal=13
    #[14] cos y ≤ cos y
qed

theorem cos_mono_lt_eq
  fixes x :: real, y :: real
  prop 0 <= x --> x <= pi --> 0 <= y --> y <= pi --> cos x < cos y <--> y < x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ pi
    #[3] 0 ≤ y
    #[4] y ≤ pi
    #[5] cos x < cos y ⟷ y < x
  ← rule iffI goal=5
    #[6] cos x < cos y ⟶ y < x
    #[7] y < x ⟶ cos x < cos y
  ← rewrite real_less_def sym=false goal=6
    #[8] ¬(cos y ≤ cos x) ⟶ ¬(x ≤ y)
  ← intro goal=8
    #[9] ¬(cos y ≤ cos x)
    #[10] ¬(x ≤ y)
  ← rule contrapositive goal=10 facts=[9]
    #[11] ¬¬(x ≤ y) ⟶ ¬¬(cos y ≤ cos x)
  ← rewrite double_neg sym=false goal=11
    #[12] x ≤ y ⟶ cos y ≤ cos x
  ← intro goal=12
    #[13] x ≤ y
    #[14] cos y ≤ cos x
  ← rule cos_mono_le goal=14
  ← intro goal=7
    #[15] y < x
    #[16] cos x < cos y
  ← rule cos_mono_lt goal=16
qed

theorem cos_mono_le_eq
  fixes x :: real, y :: real
  prop 0 <= x --> x <= pi --> 0 <= y --> y <= pi --> cos x <= cos y <--> y <= x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ pi
    #[3] 0 ≤ y
    #[4] y ≤ pi
    #[5] cos x ≤ cos y ⟷ y ≤ x
  ← rule iffI goal=5
    #[6] cos x ≤ cos y ⟶ y ≤ x
    #[7] y ≤ x ⟶ cos x ≤ cos y
  ← rewrite real_not_lt sym=true goal=6
    #[8] ¬(cos y < cos x) ⟶ ¬(x < y)
  ← intro goal=8
    #[9] ¬(cos y < cos x)
    #[10] ¬(x < y)
  ← rule contrapositive goal=10 facts=[9]
    #[11] ¬¬(x < y) ⟶ ¬¬(cos y < cos x)
  ← rewrite double_neg sym=false goal=11
    #[12] x < y ⟶ cos y < cos x
  ← intro goal=12
    #[13] x < y
    #[14] cos y < cos x
  ← rule cos_mono_lt goal=14
  ← intro goal=7
    #[15] y ≤ x
    #[16] cos x ≤ cos y
  ← rule cos_mono_le goal=16
qed

theorem cos_inj_pi
  fixes x :: real, y :: real
  prop 0 <= x --> x <= pi --> 0 <= y --> y <= pi --> cos x = cos y --> x = y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ pi
    #[3] 0 ≤ y
    #[4] y ≤ pi
    #[5] cos x = cos y
    #[6] x = y
  ← rewrite real_le_antisym sym=true goal=6
    #[7] x ≤ y ∧ y ≤ x
  → rewrite target=fact real_le_antisym sym=true goal=7 facts=[5]
    #[8] cos x ≤ cos y ∧ cos y ≤ cos x
  → forward conjD1 goal=7 facts=[8]
    #[9] cos x ≤ cos y
  → forward conjD2 goal=7 facts=[8]
    #[10] cos y ≤ cos x
  ← rule conjI goal=7
    #[11] x ≤ y
    #[12] y ≤ x
  → forward cos_mono_le_eq goal=11 facts=[1,2,3,4]
    #[13] cos x ≤ cos y ⟷ y ≤ x
  → forward cos_mono_le_eq goal=11 facts=[3,4,1,2]
    #[14] cos y ≤ cos x ⟷ x ≤ y
  → rewrite target=fact source=prev goal=11 facts=[14,10]
  → rewrite target=fact source=prev goal=12 facts=[13,9]
qed

theorem real_abs_cos_mono_le_eq
  fixes x :: real, y :: real
  prop abs x <= pi / 2 --> abs y <= pi / 2 --> abs (cos x) <= abs (cos y) <--> abs y <= abs x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] abs x ≤ pi / 2
    #[2] abs y ≤ pi / 2
    #[3] abs (cos x) ≤ abs (cos y) ⟷ abs y ≤ abs x
  cut "∀a. ∀p. abs a ≤ p / 2 ⟶ 0 ≤ a ⟶ a ≤ p" goal=3
    #[4] ∀a. ∀p. abs a ≤ p / 2 ⟶ 0 ≤ a ⟶ a ≤ p
  ← z3 goal=4
    #[5] ∀a. ∀p. abs a ≤ p / 2 ⟶ 0 ≤ a ⟶ a ≤ p
  cut "cos x = cos (-x)" goal=3
    #[6] cos x = cos (-x)
  ← rewrite cos_neg sym=false goal=6
    #[7] cos x = cos (-x)
  cut "cos y = cos (-y)" goal=3
    #[8] cos y = cos (-y)
  ← rewrite cos_neg sym=false goal=8
    #[9] cos y = cos (-y)
  ← rewrite abs_def sym=false goal=3
    #[10] (if 0 ≤ cos x then cos x else -(cos x)) ≤ (if 0 ≤ cos y then cos y else -(cos y)) ⟷ (if 0 ≤ y then y else -y) ≤ (if 0 ≤ x then x else -x)
  cut "0 ≤ cos x" goal=10
    #[11] 0 ≤ cos x
  ← rule cos_pos_pi_le goal=11
    #[12] -(pi / 2) ≤ x
    #[13] x ≤ pi / 2
  → rewrite target=fact real_abs_bounds sym=false goal=12 facts=[1]
    #[14] -(pi / 2) ≤ x ∧ x ≤ pi / 2
  ← rule conjD1 goal=12 facts=[14]
    #[15] -(pi / 2) ≤ x
  ← rule conjD2 goal=13 facts=[14]
    #[16] x ≤ pi / 2
  ← rewrite if_P sym=false goal=10 facts=[11]
    #[17] cos x ≤ (if 0 ≤ cos y then cos y else -(cos y)) ⟷ (if 0 ≤ y then y else -y) ≤ (if 0 ≤ x then x else -x)
  cut "0 ≤ cos y" goal=17
    #[18] 0 ≤ cos y
  ← rule cos_pos_pi_le goal=18
    #[19] -(pi / 2) ≤ y
    #[20] y ≤ pi / 2
  → rewrite target=fact real_abs_bounds sym=false goal=19 facts=[2]
    #[21] -(pi / 2) ≤ y ∧ y ≤ pi / 2
  ← rule conjD1 goal=19 facts=[21]
    #[22] -(pi / 2) ≤ y
  ← rule conjD2 goal=20 facts=[21]
    #[23] y ≤ pi / 2
  ← rewrite if_P sym=false goal=17 facts=[18]
    #[24] cos x ≤ cos y ⟷ (if 0 ≤ y then y else -y) ≤ (if 0 ≤ x then x else -x)
  ← cases "0 ≤ y" goal=24
    #[25] 0 ≤ y ⟶ cos x ≤ cos y ⟷ (if 0 ≤ y then y else -y) ≤ (if 0 ≤ x then x else -x)
    #[26] ¬(0 ≤ y) ⟶ cos x ≤ cos y ⟷ (if 0 ≤ y then y else -y) ≤ (if 0 ≤ x then x else -x)
  ← intro goal=25
    #[27] 0 ≤ y
    #[28] cos x ≤ cos y ⟷ (if 0 ≤ y then y else -y) ≤ (if 0 ≤ x then x else -x)
  ← rewrite if_P sym=false goal=28 facts=[27]
    #[29] cos x ≤ cos y ⟷ y ≤ (if 0 ≤ x then x else -x)
  ← cases "0 ≤ x" goal=29
    #[30] 0 ≤ x ⟶ cos x ≤ cos y ⟷ y ≤ (if 0 ≤ x then x else -x)
    #[31] ¬(0 ≤ x) ⟶ cos x ≤ cos y ⟷ y ≤ (if 0 ≤ x then x else -x)
  ← intro goal=30
    #[32] 0 ≤ x
    #[33] cos x ≤ cos y ⟷ y ≤ (if 0 ≤ x then x else -x)
  ← rewrite if_P sym=false goal=33 facts=[32]
    #[34] cos x ≤ cos y ⟷ y ≤ x
  ← rule cos_mono_le_eq goal=34
    #[35] x ≤ pi
    #[36] y ≤ pi
  ← apply_prev goal=35 facts=[5]
  ← apply_prev goal=36 facts=[5]
  ← intro goal=31
    #[37] ¬(0 ≤ x)
    #[38] cos x ≤ cos y ⟷ y ≤ (if 0 ≤ x then x else -x)
  ← rewrite if_not_P sym=false goal=38 facts=[37]
    #[39] cos x ≤ cos y ⟷ y ≤ -x
  ← rewrite source=prev goal=39 facts=[7]
    #[40] cos (-x) ≤ cos y ⟷ y ≤ -x
  ← rule cos_mono_le_eq goal=40
    #[41] 0 ≤ -x
    #[42] -x ≤ pi
    #[43] y ≤ pi
  ← z3 goal=41 facts=[37]
    #[44] 0 ≤ -x
  ← apply_prev goal=42 facts=[5]
    #[45] abs (-x) ≤ pi / 2
  ← rewrite real_abs_neg sym=false goal=45
  ← apply_prev goal=43 facts=[5]
  ← intro goal=26
    #[46] ¬(0 ≤ y)
    #[47] cos x ≤ cos y ⟷ (if 0 ≤ y then y else -y) ≤ (if 0 ≤ x then x else -x)
  ← rewrite if_not_P sym=false goal=47 facts=[46]
    #[48] cos x ≤ cos y ⟷ -y ≤ (if 0 ≤ x then x else -x)
  ← cases "0 ≤ x" goal=48
    #[49] 0 ≤ x ⟶ cos x ≤ cos y ⟷ -y ≤ (if 0 ≤ x then x else -x)
    #[50] ¬(0 ≤ x) ⟶ cos x ≤ cos y ⟷ -y ≤ (if 0 ≤ x then x else -x)
  ← intro goal=49
    #[51] cos x ≤ cos y ⟷ -y ≤ (if 0 ≤ x then x else -x)
  ← rewrite if_P sym=false goal=51 facts=[32]
    #[52] cos x ≤ cos y ⟷ -y ≤ x
  ← rewrite source=prev goal=52 facts=[9]
    #[53] cos x ≤ cos (-y) ⟷ -y ≤ x
  ← rule cos_mono_le_eq goal=53
    #[54] x ≤ pi
    #[55] 0 ≤ -y
    #[56] -y ≤ pi
  ← apply_prev goal=54 facts=[5]
  ← z3 goal=55 facts=[46]
    #[57] 0 ≤ -y
  ← apply_prev goal=56 facts=[5]
    #[58] abs (-y) ≤ pi / 2
  ← rewrite real_abs_neg sym=false goal=58
  ← intro goal=50
    #[59] cos x ≤ cos y ⟷ -y ≤ (if 0 ≤ x then x else -x)
  ← rewrite if_not_P sym=false goal=59 facts=[37]
    #[60] cos x ≤ cos y ⟷ -y ≤ -x
  ← rewrite cos_neg sym=true goal=60
    #[61] cos (-x) ≤ cos (-y) ⟷ -y ≤ -x
  ← rule cos_mono_le_eq goal=61
    #[62] 0 ≤ -x
    #[63] -x ≤ pi
    #[64] 0 ≤ -y
    #[65] -y ≤ pi
  ← z3 goal=62 facts=[37]
  ← apply_prev goal=63 facts=[5]
    #[66] abs (-x) ≤ pi / 2
  ← rewrite real_abs_neg sym=false goal=66
  ← z3 goal=64 facts=[46]
  ← apply_prev goal=65 facts=[5]
    #[67] abs (-y) ≤ pi / 2
  ← rewrite real_abs_neg sym=false goal=67
qed

theorem tan_mono_lt
  fixes x :: real, y :: real
  prop -(pi / 2) < x --> x < y --> y < pi / 2 --> tan x < tan y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) < x
    #[2] x < y
    #[3] y < pi / 2
    #[4] tan x < tan y
  ← rewrite real_sub_lt sym=true goal=4
    #[5] 0 < tan y - tan x
  cut "0 < cos x" goal=5
    #[6] 0 < cos x
  ← rule cos_pos_pi goal=6
    #[7] x < pi / 2
  ← rule real_lt_trans param_y=y goal=7
  cut "0 < cos y" goal=5
    #[8] 0 < cos y
  ← rule cos_pos_pi goal=8
    #[9] -(pi / 2) < y
  ← rule real_lt_trans param_y=x goal=9
  cut "!a::real. 0 < a --> ~(a=0) " goal=5
    #[10] ∀a::real. 0 < a ⟶ ¬(a = 0)
  ← z3 goal=10
    #[11] ∀a::real. 0 < a ⟶ ¬(a = 0)
  → forward goal=5 facts=[11,6]
    #[12] ¬(cos x = 0)
  → forward goal=5 facts=[11,8]
    #[13] ¬(cos y = 0)
  → forward real_sub_tan goal=5 facts=[13,12]
    #[14] tan y - tan x = sin (y - x) / (cos y * cos x)
  ← rewrite source=prev goal=5 facts=[14]
    #[15] 0 < sin (y - x) / (cos y * cos x)
  ← rewrite real_divide_def sym=false goal=15
    #[16] 0 < sin (y - x) * real_inverse (cos y * cos x)
  ← rule real_lt_mul goal=16
    #[17] 0 < sin (y - x)
    #[18] 0 < real_inverse (cos y * cos x)
  ← rule sin_pos_pi goal=17
    #[19] 0 < y - x
    #[20] y - x < pi
  ← rewrite real_sub_lt sym=false goal=19
  cut "!p. 0 < p --> -(p/2)<x --> y < p/2 --> y - x < p" goal=20
    #[21] ∀p. 0 < p ⟶ -(p / 2) < x ⟶ y < p / 2 ⟶ y - x < p
  ← z3 goal=21
    #[22] ∀p. 0 < p ⟶ -(p / 2) < x ⟶ y < p / 2 ⟶ y - x < p
  ← apply_prev goal=20 facts=[22]
    #[23] 0 < pi
  ← rule pi_pos goal=23
    #[24] 0 < pi
  ← rule real_lt_inv goal=18
    #[25] 0 < cos y * cos x
  ← rule real_lt_mul goal=25
qed

theorem tan_mono_le
  fixes x :: real, y :: real
  prop -(pi / 2) < x --> x <= y --> y < pi / 2 --> tan x <= tan y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) < x
    #[2] x ≤ y
    #[3] y < pi / 2
    #[4] tan x ≤ tan y
  → rewrite target=fact real_le_lt sym=false goal=4 facts=[2]
    #[5] x < y ∨ x = y
  ← rule disjE goal=4 facts=[5]
    #[6] x < y ⟶ tan x ≤ tan y
    #[7] x = y ⟶ tan x ≤ tan y
  ← intro goal=6
    #[8] x < y
    #[9] tan x ≤ tan y
  ← rule real_lt_imp_le goal=9
    #[10] tan x < tan y
  ← rule tan_mono_lt goal=10
  ← intro goal=7
    #[11] x = y
    #[12] tan x ≤ tan y
  ← rewrite source=prev goal=12 facts=[11]
    #[13] tan y ≤ tan y
  ← rule real_le_refl goal=13
    #[14] tan y ≤ tan y
qed

theorem tan_mono_lt_eq
  fixes x :: real, y :: real
  prop -(pi / 2) < x --> x < pi / 2 --> -(pi / 2) < y --> y < pi / 2 --> tan x < tan y <--> x < y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) < x
    #[2] x < pi / 2
    #[3] -(pi / 2) < y
    #[4] y < pi / 2
    #[5] tan x < tan y ⟷ x < y
  ← rule iffI goal=5
    #[6] tan x < tan y ⟶ x < y
    #[7] x < y ⟶ tan x < tan y
  ← rewrite real_less_def sym=false goal=6
    #[8] ¬(tan y ≤ tan x) ⟶ ¬(y ≤ x)
  ← intro goal=8
    #[9] ¬(tan y ≤ tan x)
    #[10] ¬(y ≤ x)
  ← rule contrapositive goal=10 facts=[9]
    #[11] ¬¬(y ≤ x) ⟶ ¬¬(tan y ≤ tan x)
  ← rewrite double_neg sym=false goal=11
    #[12] y ≤ x ⟶ tan y ≤ tan x
  ← intro goal=12
    #[13] y ≤ x
    #[14] tan y ≤ tan x
  ← rule tan_mono_le goal=14
  ← intro goal=7
    #[15] x < y
    #[16] tan x < tan y
  ← rule tan_mono_lt goal=16
qed

theorem tan_mono_le_eq
  fixes x :: real, y :: real
  prop -(pi / 2) < x --> x < pi / 2 --> -(pi / 2) < y --> y < pi / 2 --> tan x <= tan y <--> x <= y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] -(pi / 2) < x
    #[2] x < pi / 2
    #[3] -(pi / 2) < y
    #[4] y < pi / 2
    #[5] tan x ≤ tan y ⟷ x ≤ y
  ← rewrite real_not_lt sym=true goal=5
    #[6] ¬(tan y < tan x) ⟷ ¬(y < x)
  cut "!p. !q. (~p<--> ~q) <--> (p <--> q)" goal=6
    #[7] ∀p. ∀q. (¬p ⟷ ¬q) ⟷ p ⟷ q
  ← z3 goal=7
    #[8] ∀p. ∀q. (¬p ⟷ ¬q) ⟷ p ⟷ q
  ← rewrite source=prev goal=6 facts=[8]
    #[9] tan y < tan x ⟷ y < x
  ← rule tan_mono_lt_eq goal=9
qed

theorem tan_bound_pi2
  fixes x :: real
  prop abs x < pi / 4 --> abs (tan x) < 1
  [hint_backward]
proof
  ← intro goal=0
    #[1] abs x < pi / 4
    #[2] abs (tan x) < 1
  ← rewrite tan_pi4 sym=true goal=2
    #[3] abs (tan x) < tan (pi / 4)
  ← rewrite real_abs_lt sym=false goal=3
    #[4] -(tan (pi / 4)) < tan x ∧ tan x < tan (pi / 4)
  ← rule conjI goal=4
    #[5] -(tan (pi / 4)) < tan x
    #[6] tan x < tan (pi / 4)
  ← rewrite tan_neg sym=true goal=5
    #[7] tan (-(pi / 4)) < tan x
  ← rule tan_mono_lt goal=7
    #[8] -(pi / 2) < -(pi / 4)
    #[9] -(pi / 4) < x
    #[10] x < pi / 2
  ← rewrite real_lt_neg2 sym=false goal=8
    #[11] pi / 4 < pi / 2
  ← rewrite real_divide_def sym=false goal=11
    #[12] pi * real_inverse 4 < pi * real_inverse 2
  ← rule real_lt_lmul: goal=12
    #[13] 0 < pi
    #[14] real_inverse 4 < real_inverse 2
  ← rule pi_pos goal=13
    #[15] 0 < pi
  ← z3 goal=14
    #[16] real_inverse 4 < real_inverse 2
  → rewrite target=fact real_abs_lt sym=false goal=9 facts=[1]
    #[17] -(pi / 4) < x ∧ x < pi / 4
  ← rule conjD1 goal=9 facts=[17]
  → forward conjD2 goal=10 facts=[17]
    #[18] x < pi / 4
  ← rule real_lt_trans goal=10 facts=[18,11]
  ← rule tan_mono_lt goal=6
    #[19] -(pi / 2) < x
  ← rule real_lt_trans goal=19 facts=[8,9]
qed

theorem tan_cot
  fixes x :: real
  prop tan (pi / 2 - x) = cot x
  [hint_rewrite]
proof
  ← rewrite cot_def sym=false goal=0
    #[1] tan (pi / 2 - x) = cos x / sin x
  ← rewrite tan_def sym=false goal=1
    #[2] sin (pi / 2 - x) / cos (pi / 2 - x) = cos x / sin x
  ← rewrite sin_cos sym=false goal=2
    #[3] sin (pi / 2 - x) / sin x = cos x / sin x
  ← rewrite cos_sin sym=false goal=3
qed

theorem real_abs_sin_bound_lt
  fixes x :: real
  prop ~(x = 0) --> abs (sin x) < abs x
  [hint_backward]

theorem real_abs_sin_bound_le
  fixes x :: real
  prop abs (sin x) <= abs x
  [hint_backward]
proof
  ← cases "x = 0" goal=0
    #[1] x = 0 ⟶ abs (sin x) ≤ abs x
    #[2] ¬(x = 0) ⟶ abs (sin x) ≤ abs x
  ← intro goal=1
    #[3] x = 0
    #[4] abs (sin x) ≤ abs x
  ← rewrite source=prev goal=4 facts=[3]
    #[5] abs (sin 0) ≤ abs 0
  ← rewrite real_sin_0 sym=false goal=5
    #[6] abs (0::real) ≤ abs 0
  ← rule real_le_refl goal=6
    #[7] abs (0::real) ≤ abs 0
  ← intro goal=2
    #[8] ¬(x = 0)
    #[9] abs (sin x) ≤ abs x
  ← rule real_lt_imp_le goal=9
    #[10] abs (sin x) < abs x
  ← rule real_abs_sin_bound_lt goal=10
qed

theorem sin_pi6_straddle
  fixes a :: real, b :: real
  prop 0 <= a --> a <= b --> b <= 4 --> sin (a / 6) <= 1 / 2 --> 1 / 2 <= sin (b / 6) --> a <= pi & pi <= b
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ a
    #[2] a ≤ b
    #[3] b ≤ 4
    #[4] sin (a / 6) ≤ 1 / 2
    #[5] 1 / 2 ≤ sin (b / 6)
    #[6] a ≤ pi ∧ pi ≤ b
  → forward sin_mono_le_eq param_x="a / 6" param_y="pi / 6" goal=6
    #[7] -(pi / 2) ≤ a / 6 ⟶ a / 6 ≤ pi / 2 ⟶ -(pi / 2) ≤ pi / 6 ⟶ pi / 6 ≤ pi / 2 ⟶ sin (a / 6) ≤ sin (pi / 6) ⟷ a / 6 ≤ pi / 6
  cut "!p. !x. 0 < p --> 0 <= x --> -(p / 2) ≤ x / 6" goal=6
    #[8] ∀p. ∀x. 0 < p ⟶ 0 ≤ x ⟶ -(p / 2) ≤ x / 6
  ← z3 goal=8
    #[9] ∀p. ∀x. 0 < p ⟶ 0 ≤ x ⟶ -(p / 2) ≤ x / 6
  cut "-(pi / 2) ≤ a / 6" goal=6
    #[10] -(pi / 2) ≤ a / 6
  ← apply_prev goal=10 facts=[9]
    #[11] 0 < pi
  ← rule pi_pos goal=11
    #[12] 0 < pi
  → forward goal=6 facts=[7,10]
    #[13] a / 6 ≤ pi / 2 ⟶ -(pi / 2) ≤ pi / 6 ⟶ pi / 6 ≤ pi / 2 ⟶ sin (a / 6) ≤ sin (pi / 6) ⟷ a / 6 ≤ pi / 6
  cut "a / 6 ≤ pi / 2" goal=6
    #[14] a / 6 ≤ pi / 2
  cut "!x. 0 <= x --> x <= 4 --> x/6 <= pi/2" goal=14
    #[15] ∀x. 0 ≤ x ⟶ x ≤ 4 ⟶ x / 6 ≤ pi / 2
  ← intro x goal=15
    #[16] _VAR x
    #[17] 0 ≤ x
    #[18] x ≤ 4
    #[19] x / 6 ≤ pi / 2
  ← rule real_le_trans param_y="sin (pi/2)" goal=19
    #[20] x / 6 ≤ sin (pi / 2)
    #[21] sin (pi / 2) ≤ pi / 2
  ← rewrite real_sin_pi2 sym=false goal=20
    #[22] x / 6 ≤ 1
  ← z3 goal=22 facts=[17,18]
    #[23] x / 6 ≤ 1
  cut "pi/2=abs (pi/2)" goal=21
    #[24] pi / 2 = abs (pi / 2)
  ← rewrite abs_def sym=false goal=24
    #[25] pi / 2 = (if 0 ≤ pi / 2 then pi / 2 else -(pi / 2))
  cut "0 ≤ pi / 2" goal=25
    #[26] 0 ≤ pi / 2
  ← rule real_lt_imp_le goal=26
    #[27] 0 < pi / 2
  ← rewrite real_divide_def sym=false goal=27
    #[28] 0 < pi * real_inverse 2
  ← rule real_lt_mul goal=28
    #[29] 0 < real_inverse 2
  ← z3 goal=29
    #[30] 0 < real_inverse 2
  ← rewrite if_P sym=false goal=25 facts=[26]
  ← rewrite source=prev goal=21 facts=[24]
    #[31] sin (abs (pi / 2)) ≤ abs (pi / 2)
  cut "sin (abs (pi / 2)) = abs (sin (pi / 2))" goal=31
    #[32] sin (abs (pi / 2)) = abs (sin (pi / 2))
  → rewrite target=fact eq_sym_eq sym=false goal=32 facts=[24]
    #[33] abs (pi / 2) = pi / 2
  ← rewrite source=prev goal=32 facts=[33]
    #[34] sin (pi / 2) = abs (sin (pi / 2))
  ← rewrite real_sin_pi2 sym=false goal=34
    #[35] (1::real) = abs 1
  ← z3 goal=35
    #[36] (1::real) = abs 1
  ← rewrite source=prev goal=31 facts=[32]
    #[37] abs (sin (pi / 2)) ≤ abs (pi / 2)
  ← rule real_abs_sin_bound_le goal=37
    #[38] abs (sin (pi / 2)) ≤ abs (pi / 2)
  ← apply_prev goal=14 facts=[15]
    #[39] a ≤ 4
  ← rule real_le_trans goal=39 facts=[2,3]
    #[40] a ≤ 4
  → forward goal=6 facts=[13,14]
    #[41] -(pi / 2) ≤ pi / 6 ⟶ pi / 6 ≤ pi / 2 ⟶ sin (a / 6) ≤ sin (pi / 6) ⟷ a / 6 ≤ pi / 6
  cut "-(pi / 2) ≤ pi / 6" goal=6
    #[42] -(pi / 2) ≤ pi / 6
  cut "!p. 0 < p --> -(p / 2) ≤ p / 6" goal=42
    #[43] ∀p. 0 < p ⟶ -(p / 2) ≤ p / 6
  ← z3 goal=43
    #[44] ∀p. 0 < p ⟶ -(p / 2) ≤ p / 6
  ← apply_prev goal=42 facts=[44]
  → forward goal=6 facts=[41,42]
    #[45] pi / 6 ≤ pi / 2 ⟶ sin (a / 6) ≤ sin (pi / 6) ⟷ a / 6 ≤ pi / 6
  cut "∀p. 0 < p ⟶ p / 6 ≤ p / 2" goal=6
    #[46] ∀p. 0 < p ⟶ p / 6 ≤ p / 2
  ← z3 goal=46
    #[47] ∀p. 0 < p ⟶ p / 6 ≤ p / 2
  cut "pi / 6 ≤ pi / 2" goal=6
    #[48] pi / 6 ≤ pi / 2
  ← apply_prev goal=48 facts=[47]
  → forward goal=6 facts=[45,48]
    #[49] sin (a / 6) ≤ sin (pi / 6) ⟷ a / 6 ≤ pi / 6
  cut "pi/6 = 1/6 * pi" goal=6
    #[50] pi / 6 = 1 / 6 * pi
  real_norm goal=50
    #[51] pi / 6 = 1 / 6 * pi
  ← rule conjI goal=6
    #[52] a ≤ pi
    #[53] pi ≤ b
  cut "!x. x = 6 * (x /6)" goal=52
    #[54] ∀x. x = 6 * (x / 6)
  ← z3 goal=54
    #[55] ∀x. x = 6 * (x / 6)
  ← rewrite source=prev goal=52 facts=[55]
    #[56] 6 * (a / 6) ≤ 6 * (pi / 6)
  ← rule real_le_lmul goal=56
    #[57] (0::real) ≤ 6
    #[58] a / 6 ≤ pi / 6
  ← rule real_pos goal=57
    #[59] (0::real) ≤ 6
  → rewrite target=fact eq_sym_eq sym=false goal=58 facts=[49]
    #[60] a / 6 ≤ pi / 6 ⟷ sin (a / 6) ≤ sin (pi / 6)
  ← rewrite source=prev goal=58 facts=[60]
    #[61] sin (a / 6) ≤ sin (pi / 6)
  ← rewrite source=prev goal=61 facts=[51]
    #[62] sin (a / 6) ≤ sin (1 / 6 * pi)
  ← rewrite real_sin_pi6 sym=false goal=62
  ← rewrite source=prev goal=53 facts=[55]
    #[63] 6 * (pi / 6) ≤ 6 * (b / 6)
  ← rule real_le_lmul goal=63
    #[64] pi / 6 ≤ b / 6
  → forward sin_mono_le_eq param_x=pi/6 param_y=b/6 goal=64
    #[65] -(pi / 2) ≤ pi / 6 ⟶ pi / 6 ≤ pi / 2 ⟶ -(pi / 2) ≤ b / 6 ⟶ b / 6 ≤ pi / 2 ⟶ sin (pi / 6) ≤ sin (b / 6) ⟷ pi / 6 ≤ b / 6
  cut "sin (pi / 6) ≤ sin (b / 6) ⟷ pi / 6 ≤ b / 6" goal=64
    #[66] sin (pi / 6) ≤ sin (b / 6) ⟷ pi / 6 ≤ b / 6
  ← apply_prev goal=66 facts=[65]
    #[67] -(pi / 2) ≤ b / 6
    #[68] b / 6 ≤ pi / 2
  ← apply_prev goal=67 facts=[9]
    #[69] 0 ≤ b
  ← rule real_le_trans goal=69 facts=[1,2]
    #[70] 0 ≤ b
  ← apply_prev goal=68 facts=[15]
  → rewrite target=fact eq_sym_eq sym=false goal=64 facts=[66]
    #[71] pi / 6 ≤ b / 6 ⟷ sin (pi / 6) ≤ sin (b / 6)
  ← rewrite source=prev goal=64 facts=[71]
    #[72] sin (pi / 6) ≤ sin (b / 6)
  ← rewrite source=prev goal=72 facts=[51]
    #[73] sin (1 / 6 * pi) ≤ sin (b / 6)
  ← rewrite real_sin_pi6 sym=false goal=73
qed

def sec :: real ⇒ real = sec x = 1 / cos x [hint_rewrite]

def csc :: real ⇒ real = csc x = 1 / sin x [hint_rewrite]

theorem sin_csc_inverse
  fixes x :: real
  prop ~(sin x = 0) --> sin x = 1 / csc x
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(sin x = 0)
    #[2] sin x = 1 / csc x
  ← rewrite csc_def sym=false goal=2
    #[3] sin x = 1 / (1 / sin x)
  ← rewrite real_divide_def sym=false goal=3
    #[4] sin x = 1 * real_inverse (1 / sin x)
  ← rewrite real_mul_lid sym=false goal=4
    #[5] sin x = real_inverse (1 / sin x)
  ← rewrite real_divide_def sym=false goal=5
    #[6] sin x = real_inverse (1 * real_inverse (sin x))
  ← rewrite real_mul_lid sym=false goal=6
    #[7] sin x = real_inverse (real_inverse (sin x))
  ← rewrite real_inv_inv sym=false goal=7
    #[8] sin x = real_inverse (real_inverse (sin x))
qed

theorem cos_sec_inverse
  fixes x :: real
  prop ~(cos x = 0) --> cos x = 1 / sec x
proof
  ← intro goal=0
    #[1] ¬(cos x = 0)
    #[2] cos x = 1 / sec x
  ← rewrite sec_def sym=false goal=2
    #[3] cos x = 1 / (1 / cos x)
  ← rewrite real_divide_def sym=false goal=3
    #[4] cos x = 1 * real_inverse (1 / cos x)
  ← rewrite real_divide_def sym=false goal=4
    #[5] cos x = 1 * real_inverse (1 * real_inverse (cos x))
  ← rewrite real_mul_lid sym=false goal=5
    #[6] cos x = real_inverse (1 * real_inverse (cos x))
  ← rewrite real_mul_lid sym=false goal=6
    #[7] cos x = real_inverse (real_inverse (cos x))
  ← rewrite real_inv_inv sym=false goal=7
    #[8] cos x = real_inverse (real_inverse (cos x))
qed

def atn :: real ⇒ real = atn y = (THE x. -(pi / 2) < x ∧ x < pi / 2 ∧ tan x = y) [hint_rewrite]

theorem atn_tan
  fixes y :: real
  prop tan (atn y) = y
  [hint_rewrite]

theorem atn_bound
  fixes y :: real
  prop abs (atn y) < pi / 2
  [hint_backward]

theorem tan_atn
  fixes x :: real
  prop -(pi / 2) < x --> x < pi / 2 --> atn (tan x) = x
  [hint_backward,hint_backward1]

theorem atn_0
  prop atn 0 = 0
  [hint_rewrite]
proof
  cut "atn 0 = atn (tan 0)" goal=0
    #[1] atn 0 = atn (tan 0)
  ← rewrite tan_0 sym=false goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] atn (tan 0) = 0
  ← rule tan_atn goal=2
    #[3] -(pi / 2) < 0
    #[4] 0 < pi / 2
  cut "!x::real. -x < 0 <--> 0 < x" goal=3
    #[5] ∀x::real. -x < 0 ⟷ 0 < x
  ← z3 goal=5
  ← rewrite source=prev goal=3 facts=[5]
  ← rewrite real_divide_def sym=false goal=4
    #[6] 0 < pi * real_inverse 2
  ← rule real_lt_mul goal=6
    #[7] 0 < pi
    #[8] 0 < real_inverse 2
  ← rule pi_pos goal=7
  ← z3 goal=8
  ← rule real_lte_trans goal=4 facts=[4]
    #[9] pi / 2 ≤ pi / 2
  ← rule real_le_refl goal=9
qed

theorem atn_1
  prop atn 1 = pi / 4
  [hint_rewrite]
proof
  ← rewrite tan_pi4 sym=true goal=0
    #[1] atn (tan (pi / 4)) = pi / 4
  ← rule tan_atn goal=1
    #[2] -(pi / 2) < pi / 4
    #[3] pi / 4 < pi / 2
  ← rewrite real_divide_def sym=false goal=2
    #[4] -(pi * real_inverse 2) < pi * real_inverse 4
  ← rewrite real_mul_rneg sym=true goal=4
    #[5] pi * -(real_inverse 2) < pi * real_inverse 4
  ← rule real_lt_lmul: goal=5
    #[6] 0 < pi
    #[7] -(real_inverse 2) < real_inverse 4
  ← rule pi_pos goal=6
  ← z3 goal=7
  ← rewrite real_divide_def sym=false goal=3
    #[8] pi * real_inverse 4 < pi * real_inverse 2
  ← rule real_lt_lmul: goal=8
    #[9] real_inverse 4 < real_inverse 2
  ← z3 goal=9
qed

theorem tan_pi3
  prop tan (pi / 3) = sqrt 3
  [hint_rewrite]
proof
  ← rewrite tan_def sym=false goal=0
    #[1] sin (pi / 3) / cos (pi / 3) = sqrt 3
  cut "pi/3= 1/3 * pi" goal=1
    #[2] pi / 3 = 1 / 3 * pi
  real_norm goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] sin (1 / 3 * pi) / cos (1 / 3 * pi) = sqrt 3
  ← rewrite real_cos_pi3 sym=false goal=3
    #[4] sin (1 / 3 * pi) / (1 / 2) = sqrt 3
  ← rewrite real_sin_pi3 sym=false goal=4
    #[5] sqrt 3 / 2 / (1 / 2) = sqrt 3
  real_norm goal=5
qed

