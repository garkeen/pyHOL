  ← rewrite real_zero_def sym=true goal=36
  ← intro goal=27
    #[37] ¬(n1 = 0)
    #[38] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← rule disjI2 goal=38
    #[39] ∃n. x = -((of_nat n + 1 / 2) * pi)
