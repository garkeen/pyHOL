theorem sin_zero
  fixes x :: real
  prop sin x = 0 <--> (?n. even n & x = of_nat n * (pi / 2)) | (?n. even n & x = -(of_nat n * (pi / 2)))
  [hint_rewrite]
proof
  ← rewrite sin_zero_pi sym=false goal=0
    #[1] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi)) ⟷ (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
  ← rule iffI goal=1
    #[2] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi)) ⟶ (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
    #[3] (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2))) ⟶ (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← intro goal=2
    #[4] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
    #[5] (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
  ← rule disjE goal=5 facts=[4]
    #[6] (∃n. x = of_nat n * pi) ⟶ (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
    #[7] (∃n. x = -(of_nat n * pi)) ⟶ (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
  ← intro goal=6
    #[8] ∃n. x = of_nat n * pi
    #[9] (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
  ← rule disjI1 goal=9
    #[10] ∃n. even n ∧ x = of_nat n * (pi / 2)
  ← rewrite even_exists sym=false goal=10
    #[11] ∃n. (∃m. n = 2 * m) ∧ x = of_nat n * (pi / 2)
  elim n goal=11 facts=[8]
    #[12] _VAR n
    #[13] x = of_nat n * pi
    #[14] ∃n. (∃m. n = 2 * m) ∧ x = of_nat n * (pi / 2)
    #[15] ∃n. even n ∧ x = of_nat n * (pi / 2)
    #[16] (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
  ← rewrite left_exists_and_thm sym=true goal=14
    #[17] ∃n. ∃x1. n = 2 * x1 ∧ x = of_nat n * (pi / 2)
  ← inst 2*n goal=17
    #[18] ∃x1. 2 * n = 2 * x1 ∧ x = of_nat (2 * n) * (pi / 2)
  ← inst n goal=18
    #[19] 2 * n = 2 * n ∧ x = of_nat (2 * n) * (pi / 2)
  ← rule conjI goal=19
    #[20] 2 * n = 2 * n
    #[21] x = of_nat (2 * n) * (pi / 2)
  ← rule eq_refl goal=20
    #[22] 2 * n = 2 * n
  ← rewrite real_of_nat_mul sym=true goal=21
    #[23] x = of_nat 2 * of_nat n * (pi / 2)
  ← rewrite real_of_nat_id sym=false goal=23
    #[24] x = 2 * of_nat n * (pi / 2)
  ← rewrite source=prev goal=24 facts=[13]
    #[25] of_nat n * pi = 2 * of_nat n * (pi / 2)
  real_norm goal=25
    #[26] of_nat n * pi = 2 * of_nat n * (pi / 2)
  ← intro goal=7
    #[27] ∃n. x = -(of_nat n * pi)
    #[28] (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
  ← rule disjI2 goal=28
    #[29] ∃n. even n ∧ x = -(of_nat n * (pi / 2))
  elim m goal=29 facts=[27]
    #[30] _VAR m
    #[31] x = -(of_nat m * pi)
    #[32] ∃n. even n ∧ x = -(of_nat n * (pi / 2))
    #[33] (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
  ← rewrite even_exists sym=false goal=32
    #[34] ∃n. (∃m. n = 2 * m) ∧ x = -(of_nat n * (pi / 2))
  ← inst 2*m goal=34
    #[35] (∃m1. 2 * m = 2 * m1) ∧ x = -(of_nat (2 * m) * (pi / 2))
  ← rule conjI goal=35
    #[36] ∃m1. 2 * m = 2 * m1
    #[37] x = -(of_nat (2 * m) * (pi / 2))
  ← inst m goal=36
    #[38] 2 * m = 2 * m
  ← rule eq_refl goal=38
    #[39] 2 * m = 2 * m
  ← rewrite real_of_nat_mul sym=true goal=37
    #[40] x = -(of_nat 2 * of_nat m * (pi / 2))
  ← rewrite real_of_nat_id sym=false goal=40
    #[41] x = -(2 * of_nat m * (pi / 2))
  ← rewrite source=prev goal=41 facts=[31]
    #[42] -(of_nat m * pi) = -(2 * of_nat m * (pi / 2))
  real_norm goal=42
    #[43] -(of_nat m * pi) = -(2 * of_nat m * (pi / 2))
  ← intro goal=3
    #[44] (∃n. even n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. even n ∧ x = -(of_nat n * (pi / 2)))
    #[45] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← rule disjE goal=45 facts=[44]
    #[46] (∃n. even n ∧ x = of_nat n * (pi / 2)) ⟶ (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
    #[47] (∃n. even n ∧ x = -(of_nat n * (pi / 2))) ⟶ (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← intro goal=46
    #[48] ∃n. even n ∧ x = of_nat n * (pi / 2)
    #[49] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  → rewrite target=fact even_exists sym=false goal=49 facts=[48]
    #[50] ∃n. (∃m. n = 2 * m) ∧ x = of_nat n * (pi / 2)
  elim n goal=49 facts=[50]
    #[51] (∃m. n = 2 * m) ∧ x = of_nat n * (pi / 2)
    #[52] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  → forward conjD1 goal=52 facts=[51]
    #[53] ∃m. n = 2 * m
  → forward conjD2 goal=52 facts=[51]
    #[54] x = of_nat n * (pi / 2)
  elim m goal=52 facts=[53]
    #[55] n = 2 * m
    #[56] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← rule disjI1 goal=56
    #[57] ∃n. x = of_nat n * pi
  ← inst m goal=57
    #[58] x = of_nat m * pi
  → rewrite target=fact source=prev goal=58 facts=[55,54]
    #[59] x = of_nat (2 * m) * (pi / 2)
  ← rewrite source=prev goal=58 facts=[59]
    #[60] of_nat (2 * m) * (pi / 2) = of_nat m * pi
  ← rewrite real_of_nat_mul sym=true goal=60
    #[61] of_nat 2 * of_nat m * (pi / 2) = of_nat m * pi
  ← rewrite real_of_nat_id sym=false goal=61
    #[62] 2 * of_nat m * (pi / 2) = of_nat m * pi
  real_norm goal=62
    #[63] 2 * of_nat m * (pi / 2) = of_nat m * pi
  ← intro goal=47
    #[64] ∃n. even n ∧ x = -(of_nat n * (pi / 2))
    #[65] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  → rewrite target=fact even_exists sym=false goal=65 facts=[64]
    #[66] ∃n. (∃m. n = 2 * m) ∧ x = -(of_nat n * (pi / 2))
  elim n goal=65 facts=[66]
    #[67] (∃m. n = 2 * m) ∧ x = -(of_nat n * (pi / 2))
    #[68] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  → forward conjD1 goal=68 facts=[67]
    #[69] ∃m. n = 2 * m
  → forward conjD2 goal=68 facts=[67]
    #[70] x = -(of_nat n * (pi / 2))
  elim m goal=68 facts=[69]
    #[71] (∃n. x = of_nat n * pi) ∨ (∃n. x = -(of_nat n * pi))
  ← rule disjI2 goal=71
    #[72] ∃n. x = -(of_nat n * pi)
  ← inst m goal=72
    #[73] x = -(of_nat m * pi)
  ← rewrite source=prev goal=73 facts=[70]
    #[74] -(of_nat n * (pi / 2)) = -(of_nat m * pi)
  ← rewrite source=prev goal=74 facts=[55]
    #[75] -(of_nat (2 * m) * (pi / 2)) = -(of_nat m * pi)
  ← rewrite real_of_nat_mul sym=true goal=75
    #[76] -(of_nat 2 * of_nat m * (pi / 2)) = -(of_nat m * pi)
  real_norm goal=76
    #[77] -(of_nat 2 * of_nat m * (pi / 2)) = -(of_nat m * pi)
qed

theorem cos_zero
  fixes x :: real
  prop cos x = 0 <--> (?n. ~(even n) & x = of_nat n * (pi / 2)) | (?n. ~(even n) & x = -(of_nat n * (pi / 2)))
  [hint_rewrite]
proof
  ← rewrite cos_zero_pi sym=false goal=0
    #[1] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi)) ⟷ (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
  ← rule iffI goal=1
    #[2] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi)) ⟶ (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
    #[3] (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2))) ⟶ (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← intro goal=2
    #[4] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
    #[5] (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
  ← rule disjE goal=5 facts=[4]
    #[6] (∃n. x = (of_nat n + 1 / 2) * pi) ⟶ (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
    #[7] (∃n. x = -((of_nat n + 1 / 2) * pi)) ⟶ (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
  ← intro goal=6
    #[8] ∃n. x = (of_nat n + 1 / 2) * pi
    #[9] (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
  ← rule disjI1 goal=9
    #[10] ∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)
  ← rewrite not_odd sym=true goal=10
    #[11] ∃n. ¬¬(odd n) ∧ x = of_nat n * (pi / 2)
  ← rewrite double_neg sym=false goal=11
    #[12] ∃n. odd n ∧ x = of_nat n * (pi / 2)
  ← rewrite odd_exists sym=false goal=12
    #[13] ∃n. (∃m. n = Suc (2 * m)) ∧ x = of_nat n * (pi / 2)
  elim n goal=13 facts=[8]
    #[14] _VAR n
    #[15] x = (of_nat n + 1 / 2) * pi
    #[16] ∃n. (∃m. n = Suc (2 * m)) ∧ x = of_nat n * (pi / 2)
    #[17] ∃n. odd n ∧ x = of_nat n * (pi / 2)
    #[18] ∃n. ¬¬(odd n) ∧ x = of_nat n * (pi / 2)
    #[19] ∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)
    #[20] (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
  ← inst "Suc (2 * n)" goal=16
    #[21] (∃m. Suc (2 * n) = Suc (2 * m)) ∧ x = of_nat (Suc (2 * n)) * (pi / 2)
  ← rule conjI goal=21
    #[22] ∃m. Suc (2 * n) = Suc (2 * m)
    #[23] x = of_nat (Suc (2 * n)) * (pi / 2)
  ← inst n goal=22
    #[24] Suc (2 * n) = Suc (2 * n)
  ← rule eq_refl goal=24
    #[25] Suc (2 * n) = Suc (2 * n)
  ← rewrite add_1_right sym=true goal=23
    #[26] x = of_nat (2 * n + 1) * (pi / 2)
  ← rewrite real_of_nat_add sym=true goal=26
    #[27] x = (of_nat (2 * n) + of_nat 1) * (pi / 2)
  ← rewrite real_of_nat_mul sym=true goal=27
    #[28] x = (of_nat 2 * of_nat n + of_nat 1) * (pi / 2)
  ← rewrite source=prev goal=28 facts=[15]
    #[29] (of_nat n + 1 / 2) * pi = (of_nat 2 * of_nat n + of_nat 1) * (pi / 2)
  real_norm goal=29
    #[30] (of_nat n + 1 / 2) * pi = (of_nat 2 * of_nat n + of_nat 1) * (pi / 2)
  ← intro goal=7
    #[31] ∃n. x = -((of_nat n + 1 / 2) * pi)
    #[32] (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
  ← rule disjI2 goal=32
    #[33] ∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2))
  ← rewrite not_even sym=false goal=33
    #[34] ∃n. odd n ∧ x = -(of_nat n * (pi / 2))
  ← rewrite odd_exists sym=false goal=34
    #[35] ∃n. (∃m. n = Suc (2 * m)) ∧ x = -(of_nat n * (pi / 2))
  elim m goal=35 facts=[31]
    #[36] _VAR m
    #[37] x = -((of_nat m + 1 / 2) * pi)
    #[38] ∃n. (∃m. n = Suc (2 * m)) ∧ x = -(of_nat n * (pi / 2))
    #[39] ∃n. odd n ∧ x = -(of_nat n * (pi / 2))
    #[40] ∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2))
    #[41] (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
  ← inst "Suc (2 * m)" goal=38
    #[42] (∃m1. Suc (2 * m) = Suc (2 * m1)) ∧ x = -(of_nat (Suc (2 * m)) * (pi / 2))
  ← rule conjI goal=42
    #[43] ∃m1. Suc (2 * m) = Suc (2 * m1)
    #[44] x = -(of_nat (Suc (2 * m)) * (pi / 2))
  ← inst m goal=43
    #[45] Suc (2 * m) = Suc (2 * m)
  ← rule eq_refl goal=45
    #[46] Suc (2 * m) = Suc (2 * m)
  ← rewrite add_1_right sym=true goal=44
    #[47] x = -(of_nat (2 * m + 1) * (pi / 2))
  ← rewrite real_of_nat_add sym=true goal=47
    #[48] x = -((of_nat (2 * m) + of_nat 1) * (pi / 2))
  ← rewrite real_of_nat_mul sym=true goal=48
    #[49] x = -((of_nat 2 * of_nat m + of_nat 1) * (pi / 2))
  ← rewrite source=prev goal=49 facts=[37]
    #[50] -((of_nat m + 1 / 2) * pi) = -((of_nat 2 * of_nat m + of_nat 1) * (pi / 2))
  real_norm goal=50
    #[51] -((of_nat m + 1 / 2) * pi) = -((of_nat 2 * of_nat m + of_nat 1) * (pi / 2))
  ← intro goal=3
    #[52] (∃n. ¬(even n) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. ¬(even n) ∧ x = -(of_nat n * (pi / 2)))
    #[53] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  → rewrite target=fact not_even sym=false goal=53 facts=[52]
    #[54] (∃n. odd n ∧ x = of_nat n * (pi / 2)) ∨ (∃n. odd n ∧ x = -(of_nat n * (pi / 2)))
  → rewrite target=fact odd_exists sym=false goal=53 facts=[54]
    #[55] (∃n. (∃m. n = Suc (2 * m)) ∧ x = of_nat n * (pi / 2)) ∨ (∃n. (∃m. n = Suc (2 * m)) ∧ x = -(of_nat n * (pi / 2)))
  ← rule disjE goal=53 facts=[55]
    #[56] (∃n. (∃m. n = Suc (2 * m)) ∧ x = of_nat n * (pi / 2)) ⟶ (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
    #[57] (∃n. (∃m. n = Suc (2 * m)) ∧ x = -(of_nat n * (pi / 2))) ⟶ (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← intro goal=56
    #[58] ∃n. (∃m. n = Suc (2 * m)) ∧ x = of_nat n * (pi / 2)
    #[59] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← rule disjI1 goal=59
    #[60] ∃n. x = (of_nat n + 1 / 2) * pi
  elim n goal=60 facts=[58]
    #[61] (∃m. n = Suc (2 * m)) ∧ x = of_nat n * (pi / 2)
    #[62] ∃n. x = (of_nat n + 1 / 2) * pi
    #[63] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  → forward conjD1 goal=62 facts=[61]
    #[64] ∃m. n = Suc (2 * m)
  → forward conjD2 goal=62 facts=[61]
    #[65] x = of_nat n * (pi / 2)
  elim m goal=62 facts=[64]
    #[66] n = Suc (2 * m)
    #[67] ∃n. x = (of_nat n + 1 / 2) * pi
    #[68] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
  ← inst m goal=67
    #[69] x = (of_nat m + 1 / 2) * pi
  ← rewrite source=prev goal=69 facts=[65]
    #[70] of_nat n * (pi / 2) = (of_nat m + 1 / 2) * pi
  ← rewrite source=prev goal=70 facts=[66]
    #[71] of_nat (Suc (2 * m)) * (pi / 2) = (of_nat m + 1 / 2) * pi
  ← rewrite add_1_right sym=true goal=71
    #[72] of_nat (2 * m + 1) * (pi / 2) = (of_nat m + 1 / 2) * pi
  ← rewrite real_of_nat_add sym=true goal=72
    #[73] (of_nat (2 * m) + of_nat 1) * (pi / 2) = (of_nat m + 1 / 2) * pi
