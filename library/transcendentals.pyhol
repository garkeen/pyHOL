  prop abs x <= 1 --> abs y <= 1 --> acs x < acs y <--> y < x
  [hint_backward,hint_backward1]

theorem acs_mono_le_eq
  fixes x :: real, y :: real
  prop abs x <= 1 --> abs y <= 1 --> acs x <= acs y <--> y <= x
  [hint_backward,hint_backward1]

theorem acs_mono_lt
  fixes x :: real, y :: real
  prop abs x <= 1 --> x < y --> abs y <= 1 --> acs y < acs x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] abs x ≤ 1
    #[2] x < y
    #[3] abs y ≤ 1
    #[4] acs y < acs x
  → forward acs_mono_lt_eq goal=4 facts=[3,1]
    #[5] acs y < acs x ⟷ x < y
  ← rewrite source=prev goal=4 facts=[5]
qed

theorem acs_mono_le
  fixes x :: real, y :: real
  prop abs x <= 1 --> x <= y --> abs y <= 1 --> acs y <= acs x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] abs x ≤ 1
    #[2] x ≤ y
    #[3] abs y ≤ 1
    #[4] acs y ≤ acs x
  → forward acs_mono_le_eq goal=4 facts=[3,1]
    #[5] acs y ≤ acs x ⟷ x ≤ y
  ← rewrite source=prev goal=4 facts=[5]
qed

theorem sin_acs
  fixes x :: real
  prop -1 <= x --> x <= 1 --> sin (acs x) = sqrt (1 - x ^ (2::nat))
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] -1 ≤ x
    #[2] x ≤ 1
    #[3] sin (acs x) = sqrt (1 - x ^ (2::nat))
  ← rewrite eq_sym_eq sym=false goal=3
    #[4] sqrt (1 - x ^ (2::nat)) = sin (acs x)
  ← rule sqrt_unique goal=4
    #[5] 0 ≤ sin (acs x)
    #[6] sin (acs x) ^ (2::nat) = 1 - x ^ (2::nat)
  ← rule sin_pos_pi_le goal=5
    #[7] 0 ≤ acs x
    #[8] acs x ≤ pi
  → forward acs_bounds goal=7 facts=[1,2]
    #[9] 0 ≤ acs x ∧ acs x ≤ pi
  ← rule conjD1 goal=7 facts=[9]
  ← rule conjD2 goal=8 facts=[9]
  → forward sin_circle param_x="acs x" goal=6
    #[10] sin (acs x) ^ (2::nat) + cos (acs x) ^ (2::nat) = 1
  → rewrite target=fact eq_sym_eq sym=false goal=6 facts=[10]
    #[11] 1 = sin (acs x) ^ (2::nat) + cos (acs x) ^ (2::nat)
  ← rewrite source=prev goal=6 facts=[11]
    #[12] sin (acs x) ^ (2::nat) = sin (acs x) ^ (2::nat) + cos (acs x) ^ (2::nat) - x ^ (2::nat)
  → forward cos_acs goal=12 facts=[1,2]
    #[13] cos (acs x) = x
  ← rewrite source=prev goal=12 facts=[13]
    #[14] sin (acs x) ^ (2::nat) = sin (acs x) ^ (2::nat) + x ^ (2::nat) - x ^ (2::nat)
  cut "!a::real. !b. a = a + b -b " goal=14
    #[15] ∀a::real. ∀b. a = a + b - b
  ← z3 goal=15
    #[16] ∀a::real. ∀b. a = a + b - b
  ← apply_prev goal=14 facts=[16]
    #[17] ∀b. sin (acs x) ^ (2::nat) = sin (acs x) ^ (2::nat) + b - b
    #[18] sin (acs x) ^ (2::nat) = sin (acs x) ^ (2::nat) + x ^ (2::nat) - x ^ (2::nat)
qed

theorem acs_inj
  fixes x :: real, y :: real
  prop abs x <= 1 --> abs y <= 1 --> acs x = acs y <--> x = y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] abs x ≤ 1
    #[2] abs y ≤ 1
    #[3] acs x = acs y ⟷ x = y
  ← rewrite real_le_antisym sym=true goal=3
    #[4] acs x ≤ acs y ∧ acs y ≤ acs x ⟷ x ≤ y ∧ y ≤ x
  ← rule iffI goal=4
    #[5] acs x ≤ acs y ∧ acs y ≤ acs x ⟶ x ≤ y ∧ y ≤ x
    #[6] x ≤ y ∧ y ≤ x ⟶ acs x ≤ acs y ∧ acs y ≤ acs x
  ← intro goal=5
    #[7] acs x ≤ acs y ∧ acs y ≤ acs x
    #[8] x ≤ y ∧ y ≤ x
  ← rule conjI goal=8
    #[9] x ≤ y
    #[10] y ≤ x
  → forward conjD1 goal=9 facts=[7]
    #[11] acs x ≤ acs y
  → forward conjD2 goal=9 facts=[7]
    #[12] acs y ≤ acs x
  → forward acs_mono_le_eq goal=9 facts=[2,1]
    #[13] acs y ≤ acs x ⟷ x ≤ y
  → rewrite target=fact source=prev goal=9 facts=[13,12]
  → forward acs_mono_le_eq goal=10 facts=[1,2]
    #[14] acs x ≤ acs y ⟷ y ≤ x
  → rewrite target=fact source=prev goal=10 facts=[14,11]
  ← intro goal=6
    #[15] x ≤ y ∧ y ≤ x
    #[16] acs x ≤ acs y ∧ acs y ≤ acs x
  ← rule conjI goal=16
    #[17] acs x ≤ acs y
    #[18] acs y ≤ acs x
  ← rule acs_mono_le goal=17
    #[19] y ≤ x
  ← rule conjD2 goal=19 facts=[15]
    #[20] y ≤ x
  ← rule acs_mono_le goal=18
    #[21] x ≤ y
  ← rule conjD1 goal=21 facts=[15]
    #[22] x ≤ y
qed

theorem acs_atn
  fixes x :: real
  prop -1 < x --> x < 1 --> acs x = pi / 2 - atn (x / sqrt (1 - x ^ (2::nat)))
