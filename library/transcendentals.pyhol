  ← cases "n1=0" goal=25
    #[26] n1 = 0 ⟶ (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
    #[27] ¬(n1 = 0) ⟶ (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
