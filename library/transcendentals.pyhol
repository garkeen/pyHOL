    #[51] x = -((of_nat n1 - 1 / 2) * pi)
  ← rewrite real_mul_lneg sym=true goal=51
    #[52] x = -(of_nat n1 - 1 / 2) * pi
  ← rewrite real_neg_sub sym=false goal=52
    #[53] x = (1 / 2 - of_nat n1) * pi
  ← rewrite real_minus_def sym=false goal=53
    #[54] x = (1 / 2 + -(of_nat n1)) * pi
  → rewrite target=fact eq_sym_eq sym=false goal=54 facts=[24]
    #[55] -(of_nat n1) = n
  ← rewrite source=prev goal=54 facts=[55]
    #[56] x = (1 / 2 + n) * pi
  ← rewrite real_add_comm sym=false goal=56
  ← intro goal=4
    #[57] (∃n. x = (of_nat n + 1 / 2) * pi) ∨ (∃n. x = -((of_nat n + 1 / 2) * pi))
    #[58] ∃n. ((∃n1. n = of_nat n1) ∨ (∃n1. n = -(of_nat n1))) ∧ x = (n + 1 / 2) * pi
