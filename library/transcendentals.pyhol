    4.1: cut "x ^ z ≤ y ^ z"
    4.1: apply_backward_step rpow_le2
    4.2: rewrite_goal if_P @4.1 sym=false
    5: introduction
    5.1: cut "!x::real. !y. min x y = min y x"
    5.1: z3
    5.2: rewrite_goal_with_prev @5.1
    5.2: rewrite_goal min_def sym=false
    5.2: rewrite_goal if_P @5.0 sym=false
    5.2: cut "y ^ z ≤ x ^ z"
    5.2: apply_backward_step rpow_le2
    5.3: rewrite_goal if_P @5.2 sym=false
  qed

theorem rpow_rpow_nat1
  fixes m :: nat, n :: real, x :: real
  prop x ≥ 0 ⟶ x ^ m ^ n = x ^ (of_nat m * n)
  proof
    1: rewrite_goal rpow_pow sym=true
    1: apply_backward_step rpow_rpow
    1: z3 @0
  qed

theorem rpow_rpow_nat2
  fixes m :: real, n :: nat, x :: real
  prop x ≥ 0 ⟶ x ^ m ^ n = x ^ (m * of_nat n)
  proof
    1: rewrite_goal rpow_pow sym=true
    1: apply_backward_step rpow_rpow
    1: z3 @0
  qed

theorem rpow_base_divide
  fixes x :: real, y :: real, z :: real
  prop x > 0 ⟶ y > 0 ⟶ (x / y) ^ z = x ^ z / y ^ z
  proof
    2: rewrite_goal rpow_div sym=false
  qed

theorem real_abs_rpow
  fixes x :: real, y :: real
  prop abs (x ^ y) = abs x ^ y
  [hint_rewrite]
  proof
    0: rewrite_goal real_real_power_def sym=false
    0: cases "x = 0"
    0: introduction
    0.1: rewrite_goal real_abs_zero sym=false
    0.1: rewrite_goal if_P @0.0 sym=false
    0.1: cut "~(0 < x)"
    0.1: z3 @0.0
    0.2: rewrite_goal if_not_P @0.1 sym=false
    0.2: cut "~(0 < abs x)"
    0.2: z3 @0.0
    0.3: rewrite_goal if_not_P @0.2 sym=false
    0.3: z3
    1: introduction
    1.1: rewrite_goal if_not_P @1.0 sym=false
    1.1: cases "0 < x"
    1.1: introduction
    1.1.1: cut "abs x = x" @1.1.0
    1.1.1: z3 @1.1.0
    1.1.2: rewrite_goal_with_prev @1.1.1
    1.1.2: rewrite_goal if_P @1.1.0 sym=false
    1.1.2: rewrite_goal real_abs_exp sym=false
    1.2: introduction
    1.2.1: rewrite_goal if_not_P @1.2.0 sym=false
    1.2.1: cut "0 < abs x"
    1.2.1: z3 @1.2.0,1.0
    1.2.2: rewrite_goal if_P @1.2.1 sym=false
    1.2.2: cut "abs x = -x"
    1.2.2: z3 @1.2.0
    1.2.3: rewrite_goal_with_prev @1.2.2
    1.2.3: cases "∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n"
    1.2.3: introduction
    1.2.3.1: rewrite_goal if_P @1.2.3.0 sym=false
    1.2.3.1: rewrite_goal real_abs_neg sym=false
    1.2.3.1: rewrite_goal real_abs_exp sym=false
    1.2.4: introduction
    1.2.4.1: rewrite_goal if_not_P @1.2.4.0 sym=false
    1.2.4.1: rewrite_goal real_abs_exp sym=false
  qed

theorem rpow_exp
  fixes p :: real, x :: real
  prop exp x ^ p = exp (x * p)
  proof
    0: rewrite_goal real_real_power_def sym=false
    0: cut "0 < exp x"
    0: apply_backward_step real_exp_pos_lt
    1: rewrite_goal if_P @0 sym=false
    1: rewrite_goal log_exp sym=false
    1: rewrite_goal real_exp_inj sym=false
    1: apply_backward_step real_mult_comm
  qed

theorem rpow_abs
  fixes x :: real
  prop x ^ (2::nat) ^ (1 / 2) = abs x
  proof
    0: rewrite_goal real_pow2_abs sym=true
    0: cut "0<= abs x"
    0: apply_backward_step real_abs_pos
    1: apply_forward_step rpow_rpow @0 param_m="(2::real)" param_n=1/2
    2: rewrite_goal rpow_pow sym=true
    2: rewrite_goal real_of_nat_id sym=false
    2: rewrite_goal_with_prev @1
    2: cut "2 * (1 / 2)=1"
    2: real_norm
    3: rewrite_goal_with_prev @2
    3: rewrite_goal rpow_1 sym=false
  qed

theorem test1
  fixes x :: real
  prop 0 < x ⟶ x < pi / 4 ⟶ -(sin x) + cos x ≥ 0
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal greater_eq_def sym=false
    2: cut "-(sin x) + cos x = -(sin x - cos x)"
    2: real_norm
    3: rewrite_goal_with_prev @2
    3: rewrite_goal sin_cos_combine2 sym=false
    3: rewrite_goal real_mul_lneg sym=false
    3: rewrite_goal real_neg_neg sym=false
    3: apply_backward_step real_le_mul
    3: apply_backward_step sqrt_pos_le
    3: apply_backward_step real_pos
    5: apply_backward_step cos_pos_pi_le
    5: cut "0 < pi"
    5: apply_backward_step pi_pos
    6: cut "!p::real. 0 < x --> x < p /4 --> 0 < p --> -(p/2) <= x + p/4"
    6: z3
    7: apply_prev @6
    8: cut "∀p. 0 < x ⟶ x < p / 4 ⟶ 0 < p ⟶ x + p / 4 ≤ (p / 2)"
    8: z3
    9: apply_prev @8
  qed

theorem test2
  fixes x :: real
  prop -3 * pi / 4 ≤ x ⟶ x ≤ pi / 4 ⟶ -(sin x) + cos x ≥ 0
  proof
    2: rewrite_goal greater_eq_def sym=false
    2: cut "-(sin x) + cos x = -(sin x - cos x)"
    2: real_norm
    3: rewrite_goal_with_prev @2
    3: rewrite_goal sin_cos_combine2 sym=false
    3: rewrite_goal real_mul_lneg sym=true
    3: rewrite_goal real_neg_neg sym=false
    3: apply_backward_step real_le_mul
    3: apply_backward_step sqrt_pos_le
    3: apply_backward_step real_pos
    5: apply_backward_step cos_pos_pi_le
    5: apply_forward_step pi_pos
    6: cut "!p::real. -3 * p / 4 ≤ x --> x ≤ p / 4 --> 0 < p --> -(p / 2) ≤ x + p / 4"
    6: z3
    7: apply_prev @6
    8: cut "∀p. -3 * p / 4 ≤ x ⟶ x ≤ p / 4 ⟶ 0 < p ⟶ x + p / 4 ≤ (p / 2)"
    8: z3
    9: apply_prev @8
  qed

theorem test3
  fixes x :: real
  prop 1 < x ⟶ x < 2 ⟶ x ^ (4::nat) > 0
  [hint_backward,hint_backward1]
  proof
    2: cut "(4::nat) = ((2::nat) * 2)"
    2: nat_norm
    3: rewrite_goal_with_prev @2
    3: rewrite_goal mult_2 sym=false
    3: rewrite_goal real_pow_add sym=false
    3: rewrite_goal real_pow_2 sym=false
    3: z3 @0,1
  qed
