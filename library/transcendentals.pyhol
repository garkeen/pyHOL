  ← rewrite real_of_nat_minus sym=false goal=40
    #[41] x = -(((if n1 ≥ 1 then of_nat n1 - of_nat 1 else 0) + 1 / 2) * pi)
  cut "n1>=1" goal=41
    #[42] n1 ≥ 1
  ← z3 goal=42 facts=[37]
    #[43] n1 ≥ 1
  ← rewrite if_P sym=false goal=41 facts=[43]
    #[44] x = -((of_nat n1 - of_nat 1 + 1 / 2) * pi)
  ← rewrite real_one_def sym=true goal=44
    #[45] x = -((of_nat n1 - 1 + 1 / 2) * pi)
  ← rewrite real_minus_def sym=false goal=45
    #[46] x = -((of_nat n1 + -1 + 1 / 2) * pi)
  ← rewrite real_add_assoc sym=true goal=46
    #[47] x = -((of_nat n1 + (-1 + 1 / 2)) * pi)
  cut "(-1 + 1 / 2) = -(1 / 2)" goal=47
