  ← rewrite if_not_P sym=false goal=38 facts=[37]
    #[39] (if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = 0 ⟷ x = 0 ∧ ¬(y = 0)
  ← cases "∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n" goal=39
