  ← cases "0 < x" goal=19
    #[20] 0 < x ⟶ (if 0 < x then exp (y * log x) else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = 0 ⟷ x = 0 ∧ ¬(y = 0)
    #[21] ¬(0 < x) ⟶ (if 0 < x then exp (y * log x) else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = 0 ⟷ x = 0 ∧ ¬(y = 0)
  ← intro goal=20
    #[22] 0 < x
    #[23] (if 0 < x then exp (y * log x) else if ∃m. ∃n. odd m ∧ odd n ∧ abs y = of_nat m / of_nat n then -(exp (y * log (-x))) else exp (y * log (-x))) = 0 ⟷ x = 0 ∧ ¬(y = 0)
  ← rewrite if_P sym=false goal=23 facts=[22]
    #[24] exp (y * log x) = 0 ⟷ x = 0 ∧ ¬(y = 0)
