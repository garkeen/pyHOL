theory transcendentals
imports real, metric
description "Real transcendentals."

const infsum :: nat set ⇒ (nat ⇒ 'a) ⇒ 'a

def exp :: real ⇒ real = exp x = infsum (from 0) (λn. x ^ n / of_nat (fact n)) [hint_rewrite]

theorem real_exp_add
  fixes x :: real, y :: real
  prop exp (x + y) = exp x * exp y
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: rewrite_goal exp_def sym=false
  qed

theorem real_exp_0
  prop exp 0 = 1
  [hint_rewrite]
  proof
    0: rewrite_goal exp_def sym=false
    0: rewrite_goal real_pow_zero sym=false
  qed

theorem real_exp_nz
  fixes x :: real
  prop ¬(exp x = 0)
  [hint_backward]

theorem real_exp_add_mul
  fixes x :: real, y :: real
  prop exp (x + y) * exp (-x) = exp y
  [hint_rewrite]
  proof
    0: rewrite_goal real_exp_add sym=true
    0: cut "x + y + -x = y"
    0: real_norm
    1: rewrite_goal_with_prev @0
  qed

theorem real_exp_neg_mul
  fixes x :: real
  prop exp x * exp (-x) = 1
  [hint_rewrite]
  proof
    0: rewrite_goal real_exp_add sym=true
    0: rewrite_goal real_add_rinv sym=false
    0: rewrite_goal real_exp_0 sym=false
  qed

theorem real_exp_neg
  fixes x :: real
  prop exp (-x) = real_inverse (exp x)
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: rewrite_goal real_mul_lid sym=true
    0: rewrite_goal real_mult_comm sym=false
    0: apply_forward_step real_exp_neg_mul param_x=x
    1: rewrite_fact eq_sym_eq @0 sym=false
    2: rewrite_goal_with_prev @1
    2: rewrite_goal real_mult_assoc sym=false
    2: apply_forward_step real_exp_nz param_x=x
    3: apply_forward_step real_mul_linv @2
    4: rewrite_goal_with_prev @3
    4: rewrite_goal real_mult_assoc sym=true
    4: rewrite_goal real_exp_neg_mul sym=false
    4: apply_backward_step real_mult_comm
  qed

theorem real_exp_n
  fixes n :: nat, x :: real
  prop exp (of_nat n * x) = exp x ^ n
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: induction n nat_induct
    0: rewrite_goal real_nat_power_def_1 sym=false
    0: rewrite_goal real_zero_def sym=true
    0: rewrite_goal real_mul_lzero sym=false
    0: rewrite_goal real_exp_0 sym=false
    4: introduction n
    4.2: rewrite_goal real_nat_power_def_2 sym=false
    4.2: rewrite_goal add_1_right sym=true
    4.2: rewrite_goal real_of_nat_add sym=true
    4.2: rewrite_goal real_one_def sym=true
    4.2: rewrite_goal real_add_comm sym=false
    4.2: rewrite_goal real_add_rdistrib sym=false
    4.2: rewrite_goal real_mul_lid sym=false
    4.2: rewrite_goal real_exp_add sym=false
    4.2: rewrite_goal_with_prev @4.1
  qed

theorem real_exp_n_sym
  fixes n :: nat, x :: real
  prop exp x ^ n = exp (of_nat n * x)
  proof
    0: rewrite_goal real_exp_n sym=true
  qed

theorem real_exp_sub
  fixes x :: real, y :: real
  prop exp (x - y) = exp x / exp y
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: rewrite_goal real_minus_def sym=false
    0: rewrite_goal real_exp_add sym=false
    0: rewrite_goal real_exp_neg sym=false
    0: rewrite_goal real_divide_def sym=false
  qed

theorem real_exp_pos_le
  fixes x :: real
  prop 0 ≤ exp x
  [hint_backward]
  proof
    0: cut "x = x/2 + x/2"
    0: z3
    1: rewrite_goal_with_prev @0
    1: rewrite_goal real_exp_add sym=false
    1: apply_backward_step real_le_square
  qed

theorem real_exp_pos_lt
  fixes x :: real
  prop 0 < exp x
  [hint_backward]
  proof
    0: rewrite_goal real_lt_le sym=false
    0: apply_backward_step conjI
    0: apply_backward_step real_exp_pos_le
    1: rewrite_goal eq_sym_eq sym=false
    1: apply_backward_step real_exp_nz
  qed

theorem real_exp_le_x
  fixes x :: real
  prop 1 + x ≤ exp x
  [hint_backward]
  proof
    0: cases "1 + x < 0"
    0: introduction
    0.1: apply_backward_step real_le_trans param_y="(0::real)"
    0.1: apply_backward_step real_lt_imp_le
    0.2: apply_backward_step real_exp_pos_le
    1: introduction
    1.1: rewrite_goal exp_def sym=false
  qed

theorem real_exp_lt_1
  fixes x :: real
  prop 0 < x ⟶ 1 < exp x
  [hint_backward]
  proof
    1: apply_forward_step real_exp_le_x param_x=x
    2: apply_backward_step real_lte_trans param_y=1+x
    2: z3 @0
  qed

theorem real_exp_mono_imp
  fixes x :: real, y :: real
  prop x < y ⟶ exp x < exp y
  [hint_backward]
  proof
    1: rewrite_fact real_sub_lt @0 sym=true
    2: apply_forward_step real_exp_lt_1 @1
    3: rewrite_fact real_exp_sub @2 sym=false
    4: cut "!a::real. !b. 0 < a --> 1 < b / a --> a < b"
    4: z3
    5: apply_prev @4
    5: apply_backward_step real_exp_pos_lt
  qed

theorem real_exp_mono_lt
  fixes x :: real, y :: real
  prop exp x < exp y ⟷ x < y
  [hint_rewrite]
  proof
    0: cut "!a::real. !b. !c::real. !d. (a < b --> c < d) --> (a = b --> c = d) --> (b < a --> d < c) --> (c < d <--> a < b)"
    0: z3
    1: apply_prev @0
    1: introduction
    1.1: apply_backward_step real_exp_mono_imp @1.0
    2: introduction
    2.1: rewrite_goal_with_prev @2.0
    3: introduction
    3.1: apply_backward_step real_exp_mono_imp @3.0
  qed

theorem real_exp_mono_le
  fixes x :: real, y :: real
  prop exp x ≤ exp y ⟷ x ≤ y
  [hint_rewrite]
  proof
    0: rewrite_goal real_not_lt sym=true
    0: rewrite_goal real_exp_mono_lt sym=false
  qed

theorem real_exp_inj
  fixes x :: real, y :: real
  prop exp x = exp y ⟷ x = y
  [hint_rewrite]
  proof
    0: rewrite_goal real_le_antisym sym=true
    0: rewrite_goal real_exp_mono_le sym=false
  qed

theorem real_exp_eq_1
  fixes x :: real
  prop exp x = 1 ⟷ x = 0
  [hint_rewrite]
  proof
    0: rewrite_goal real_exp_0 sym=true
    0: rewrite_goal real_exp_inj sym=false
  qed

theorem real_abs_exp
  fixes x :: real
  prop abs (exp x) = exp x
  [hint_rewrite]
  proof
    0: rewrite_goal abs_def sym=false
    0: cut "0 ≤ exp x"
    0: apply_backward_step real_exp_pos_le
    1: rewrite_goal if_P @0 sym=false
  qed

theorem real_exp_sum
  fixes f :: 'a ⇒ real, s :: 'a set
  prop finite s ⟶ exp (sum s f) = product s (λx. exp (f x))
  [hint_backward]
  proof
    1: apply_backward_step finite_induct_strong @0
    1: rewrite_goal sum_empty sym=false
    1: rewrite_goal product_empty sym=false
    1: rewrite_goal real_exp_0 sym=false
    4: introduction x,s1
    4.5: apply_forward_step sum_insert @4.4 param_f=f param_x=x
    4.6: apply_forward_step product_insert @4.4 param_f="(λx1. exp (f x1))" param_x=x
    4.7: rewrite_fact if_not_P @4.5,4.3 sym=false
    4.8: rewrite_fact if_not_P @4.6,4.3 sym=false
    4.9: rewrite_goal_with_prev @4.7
    4.9: rewrite_goal_with_prev @4.8
    4.9: rewrite_goal real_exp_add sym=false
    4.9: rewrite_goal_with_prev @4.2
  qed

theorem real_exp_bound_lemma
  fixes x :: real
  prop 0 ≤ x ⟶ x ≤ real_inverse 2 ⟶ exp x ≤ 1 + 2 * x
  [hint_backward,hint_backward1]

def cos :: real ⇒ real = cos x = infsum (from 0) (λn. if even n then -1 ^ (n DIV 2) * x ^ n / of_nat (fact n) else 0)

def sin :: real ⇒ real = sin x = infsum (from 0) (λn. if even n then 0 else -1 ^ ((n - 1) DIV 2) * x ^ n / of_nat (fact n))

theorem sin_circle
  fixes x :: real
  prop sin x ^ (2::nat) + cos x ^ (2::nat) = 1
  [hint_rewrite]

theorem sin_circle2
  fixes x :: real
  prop sin x ^ (2::nat) = 1 - cos x ^ (2::nat)
  proof
    0: apply_forward_step sin_circle param_x=x
    1: rewrite_fact eq_sym_eq @0 sym=false
    2: rewrite_goal_with_prev @1
    2: real_norm
  qed

theorem sin_circle3
  fixes x :: real
  prop cos x ^ (2::nat) = 1 - sin x ^ (2::nat)
  proof
    0: apply_forward_step sin_circle param_x=x
    1: rewrite_fact eq_sym_eq @0 sym=false
    2: rewrite_goal_with_prev @1
    2: real_norm
  qed

theorem sin_add
  fixes x :: real, y :: real
  prop sin (x + y) = sin x * cos y + cos x * sin y
  [hint_rewrite]

theorem cos_add
  fixes x :: real, y :: real
  prop cos (x + y) = cos x * cos y - sin x * sin y
  [hint_rewrite]

theorem sin_neg
  fixes x :: real
  prop sin (-x) = -(sin x)
  [hint_rewrite]

theorem sin_neg_alt
  fixes c :: real, x :: real
  prop sin (-c * x) = -(sin (c * x))
  proof
    0: rewrite_goal real_mul_lneg sym=false
    0: rewrite_goal sin_neg sym=false
  qed

theorem cos_neg
  fixes x :: real
  prop cos (-x) = cos x
  [hint_rewrite]

theorem cos_neg_alt
  fixes c :: real, x :: real
  prop cos (-c * x) = cos (c * x)
  proof
    0: rewrite_goal real_mul_lneg sym=false
    0: rewrite_goal cos_neg sym=false
  qed

theorem sin_double
  fixes x :: real
  prop sin (2 * x) = 2 * sin x * cos x
  [hint_rewrite]
  proof
    0: rewrite_goal real_mul_2 sym=false
    0: rewrite_goal sin_add sym=false
    0: real_norm
  qed

theorem cos_double
  fixes x :: real
  prop cos (2 * x) = cos x ^ (2::nat) - sin x ^ (2::nat)
  [hint_rewrite]
  proof
    0: rewrite_goal real_mul_2 sym=false
    0: rewrite_goal cos_add sym=false
    0: rewrite_goal real_pow_2 sym=false
  qed

theorem cos_double_cos
  fixes x :: real
  prop cos (2 * x) = 2 * cos x ^ (2::nat) - 1
  [hint_rewrite]
  proof
    0: rewrite_goal cos_double sym=false
    0: apply_forward_step sin_circle param_x=x
    1: rewrite_fact eq_sym_eq @0 sym=false
    2: rewrite_goal_with_prev @1
    2: real_norm
  qed

theorem cos_lower_degree
  fixes x :: real
  prop cos x ^ (2::nat) = 1 / 2 * cos (2 * x) + 1 / 2
  proof
    0: rewrite_goal cos_double_cos sym=false
    0: real_norm
  qed

theorem sin_bound
  fixes x :: real
  prop abs (sin x) ≤ 1
  [hint_backward]
  proof
    0: apply_forward_step real_abs_nat param_n="(1::nat)"
    1: rewrite_fact real_one_def @0 sym=true
    2: rewrite_fact eq_sym_eq @1 sym=false
    3: rewrite_goal_with_prev @2
    3: rewrite_goal real_le_square_abs sym=false
    3: apply_forward_step sin_circle param_x=x
    4: apply_forward_step real_le_square param_x="cos x"
    5: rewrite_goal real_pow_2 sym=false
    5: rewrite_goal real_mul_lid sym=false
    5: rewrite_fact real_pow_2 @3 sym=false
    6: rewrite_fact eq_sym_eq @5 sym=false
    7: rewrite_goal_with_prev @6
    7: cut "!a::real. !b. 0 <= b --> a <= a + b "
    7: z3
    8: apply_prev @7
  qed

theorem cos_bound
  fixes x :: real
  prop abs (cos x) ≤ 1
  [hint_backward]
  proof
    0: rewrite_goal real_one_def sym=false
    0: rewrite_goal real_abs_nat sym=true
    0: rewrite_goal real_le_square_abs sym=false
    0: rewrite_goal real_one_def sym=true
    0: rewrite_goal real_pow_one sym=false
    0: apply_forward_step sin_circle param_x=x
    1: rewrite_fact eq_sym_eq @0 sym=false
    2: rewrite_goal_with_prev @1
    2: cut "!a::real. !b. 0 <= b --> a <= b + a"
    2: z3
    3: apply_prev @2
    3: apply_backward_step real_le_pow_2
  qed

theorem sin_lbound
  fixes x :: real
  prop -1 ≤ sin x
  [hint_backward]
  proof
    0: apply_forward_step sin_bound param_x=x
    1: rewrite_fact real_abs_bounds @0 sym=false
    2: apply_backward_step conjD1 @1
  qed

theorem sin_ubound
  fixes x :: real
  prop sin x ≤ 1
  [hint_backward]
  proof
    0: apply_forward_step sin_bound param_x=x
    1: rewrite_fact real_abs_bounds @0 sym=false
    2: apply_backward_step conjD2 @1
  qed

theorem cos_lbound
  fixes x :: real
  prop -1 ≤ cos x
  [hint_backward]
  proof
    0: apply_forward_step cos_bound param_x=x
    1: rewrite_fact real_abs_bounds @0 sym=false
    2: apply_backward_step conjD1 @1
  qed

theorem cos_ubound
  fixes x :: real
  prop cos x ≤ 1
  [hint_backward]
  proof
    0: apply_forward_step cos_bound param_x=x
    1: rewrite_fact real_abs_bounds @0 sym=false
    2: apply_backward_step conjD2 @1
  qed

theorem cos_abs
  fixes x :: real
  prop cos (abs x) = cos x
  [hint_rewrite]
  proof
    0: rewrite_goal abs_def sym=false
    0: cases "0 ≤ x"
    0: introduction
    0.1: rewrite_goal if_P @0.0 sym=false
    1: introduction
    1.1: rewrite_goal if_not_P @1.0 sym=false
    1.1: rewrite_goal cos_neg sym=false
  qed

theorem sin_sub
  fixes x :: real, y :: real
  prop sin (x - y) = sin x * cos y - cos x * sin y
  [hint_rewrite]
  proof
    0: rewrite_goal real_minus_def sym=false
    0: rewrite_goal sin_add sym=false
    0: rewrite_goal cos_neg sym=false
    0: rewrite_goal sin_neg sym=false
    0: rewrite_goal real_mul_rneg sym=false
  qed

theorem cos_sub
  fixes x :: real, y :: real
  prop cos (x - y) = cos x * cos y + sin x * sin y
  [hint_rewrite]
  proof
    0: rewrite_goal real_minus_def sym=false
    0: rewrite_goal cos_add sym=false
    0: rewrite_goal cos_neg sym=false
    0: rewrite_goal sin_neg sym=false
    0: real_norm
  qed

theorem real_mul_sin_sin
  fixes x :: real, y :: real
  prop sin x * sin y = (cos (x - y) - cos (x + y)) / 2
  [hint_rewrite]
  proof
    0: rewrite_goal cos_add sym=false
    0: rewrite_goal cos_sub sym=false
    0: real_norm
  qed

theorem real_mul_sin_cos
  fixes x :: real, y :: real
  prop sin x * cos y = (sin (x + y) + sin (x - y)) / 2
  [hint_rewrite]
  proof
    0: rewrite_goal sin_add sym=false
    0: rewrite_goal sin_sub sym=false
    0: real_norm
  qed

theorem real_mul_cos_sin
  fixes x :: real, y :: real
  prop cos x * sin y = (sin (x + y) - sin (x - y)) / 2
  [hint_rewrite]
  proof
    0: rewrite_goal sin_add sym=false
    0: rewrite_goal sin_sub sym=false
    0: real_norm
  qed

theorem real_mul_cos_cos
  fixes x :: real, y :: real
  prop cos x * cos y = (cos (x - y) + cos (x + y)) / 2
  [hint_rewrite]
  proof
    0: rewrite_goal cos_add sym=false
    0: rewrite_goal cos_sub sym=false
    0: real_norm
  qed

theorem real_add_sin
  fixes x :: real, y :: real
  prop sin x + sin y = 2 * sin ((x + y) / 2) * cos ((x - y) / 2)
  [hint_rewrite]
  proof
    0: rewrite_goal real_mult_assoc sym=true
    0: rewrite_goal real_mul_sin_cos sym=false
    0: cut "((x + y) / 2 + (x - y) / 2) = x"
    0: real_norm
    1: cut "(x + y) / 2 - (x - y) / 2 = y"
    1: real_norm
    2: rewrite_goal_with_prev @0
    2: rewrite_goal_with_prev @1
    2: real_norm
  qed

theorem real_sub_sin
  fixes x :: real, y :: real
  prop sin x - sin y = 2 * sin ((x - y) / 2) * cos ((x + y) / 2)
  [hint_rewrite]
  proof
    0: rewrite_goal real_mult_assoc sym=true
    0: rewrite_goal real_mul_sin_cos sym=false
    0: cut "(x - y) / 2 + (x + y) / 2 = x"
    0: real_norm
    1: cut "(x - y) / 2 - (x + y) / 2 = -y"
    1: real_norm
    2: rewrite_goal_with_prev @0
    2: rewrite_goal_with_prev @1
    2: rewrite_goal sin_neg sym=false
    2: real_norm
  qed

theorem real_add_cos
  fixes x :: real, y :: real
  prop cos x + cos y = 2 * cos ((x + y) / 2) * cos ((x - y) / 2)
  [hint_rewrite]
  proof
    0: rewrite_goal real_mult_assoc sym=true
    0: rewrite_goal real_mul_cos_cos sym=false
    0: cut "(x + y) / 2 - (x - y) / 2 = y"
    0: real_norm
    1: cut "(x + y) / 2 + (x - y) / 2 = x"
    1: real_norm
    2: rewrite_goal_with_prev @0
    2: rewrite_goal_with_prev @1
    2: real_norm
  qed

theorem real_sub_cos
  fixes x :: real, y :: real
  prop cos x - cos y = 2 * sin ((x + y) / 2) * sin ((y - x) / 2)
  [hint_rewrite]
  proof
    0: rewrite_goal real_mult_assoc sym=true
    0: rewrite_goal real_mul_sin_sin sym=false
    0: cut "(x + y) / 2 - (y - x) / 2 = x"
    0: real_norm
    1: cut "(x + y) / 2 + (y - x) / 2 = y"
    1: real_norm
    2: rewrite_goal_with_prev @0
    2: rewrite_goal_with_prev @1
    2: real_norm
  qed

theorem cos_double_sin
  fixes x :: real
  prop cos (2 * x) = 1 - 2 * sin x ^ (2::nat)
  [hint_rewrite]
  proof
    0: rewrite_goal real_mul_2 sym=false
    0: rewrite_goal cos_add sym=false
    0: apply_forward_step sin_circle param_x=x
    1: rewrite_fact eq_sym_eq @0 sym=false
    2: rewrite_goal_with_prev @1
    2: rewrite_goal real_pow_2 sym=false
    2: real_norm
  qed

theorem sin_lower_degree
  fixes x :: real
  prop sin x ^ (2::nat) = 1 / 2 - 1 / 2 * cos (2 * x)
  proof
    0: rewrite_goal cos_double_sin sym=false
    0: real_norm
  qed

def log :: real ⇒ real = log y = (THE x. exp x = y) [hint_rewrite]

theorem exp_log
  fixes x :: real
  prop 0 < x ⟶ exp (log x) = x
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal log_def sym=false
  qed

theorem exp_log_inv
  fixes c :: nat, x :: real
  prop 0 < x ⟶ exp (-(of_nat c) * log x) = 1 / x ^ (of_nat::nat ⇒ nat) c

theorem exp_log_inv2
  fixes x :: real
  prop 0 < x ⟶ exp (-1 * log x) = 1 / x

theorem exp_log_pow
  fixes n :: nat, x :: real
  prop 0 < x ⟶ exp (of_nat n * log x) = x ^ (of_nat::nat ⇒ nat) n

theorem log_exp
  fixes x :: real
  prop log (exp x) = x
  [hint_rewrite]
  proof
    0: rewrite_goal real_exp_inj sym=true
    0: apply_backward_step exp_log
    0: apply_backward_step real_exp_pos_lt
  qed

theorem real_exp_log
  fixes x :: real
  prop exp (log x) = x ⟷ 0 < x
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: rewrite_fact eq_sym_eq @0.0 sym=false
    0.2: rewrite_goal_with_prev @0.1
    0.2: apply_backward_step real_exp_pos_lt
    1: introduction
    1.1: apply_backward_step exp_log @1.0
  qed

theorem log_mul
  fixes x :: real, y :: real
  prop 0 < x ⟶ 0 < y ⟶ log (x * y) = log x + log y
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal real_exp_inj sym=true
    2: rewrite_goal real_exp_add sym=false
    2: apply_forward_step exp_log @0
    3: apply_forward_step exp_log @1
    4: rewrite_goal_with_prev @2
    4: rewrite_goal_with_prev @3
    4: rewrite_goal real_exp_log sym=false
    4: apply_backward_step real_lt_mul
  qed

theorem log_inj
  fixes x :: real, y :: real
  prop 0 < x ⟶ 0 < y ⟶ log x = log y ⟷ x = y
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: apply_backward_step iffI
    2: introduction
    2.1: rewrite_fact real_exp_inj @2.0 sym=true
    2.2: apply_forward_step exp_log @0
    2.3: apply_forward_step exp_log @1
    2.4: rewrite_fact_with_prev @2.2,2.1
    2.5: rewrite_fact_with_prev @2.3,2.4
    3: introduction
    3.1: rewrite_goal_with_prev @3.0
  qed

theorem log_1
  prop log 1 = 0
  [hint_rewrite]
  proof
    0: rewrite_goal real_exp_inj sym=true
    0: rewrite_goal real_exp_0 sym=false
    0: apply_backward_step exp_log
    0: z3
  qed

theorem log_inv
  fixes x :: real
  prop 0 < x ⟶ log (real_inverse x) = -(log x)
  [hint_backward]
  proof
    1: rewrite_goal real_exp_inj sym=true
    1: rewrite_goal real_exp_neg sym=false
    1: apply_forward_step exp_log @0
    2: rewrite_goal_with_prev @1
    2: rewrite_goal real_exp_log sym=false
    2: apply_backward_step real_lt_inv @0
  qed

theorem log_div
  fixes x :: real, y :: real
  prop 0 < x ⟶ 0 < y ⟶ log (x / y) = log x - log y
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal real_divide_def sym=false
    2: rewrite_goal real_minus_def sym=false
    2: apply_forward_step log_inv @1
    3: rewrite_fact eq_sym_eq @2 sym=false
    4: rewrite_goal_with_prev @3
    4: apply_backward_step log_mul
    4: apply_backward_step real_lt_inv @1
  qed

theorem log_mono_lt
  fixes x :: real, y :: real
  prop 0 < x ⟶ 0 < y ⟶ log x < log y ⟷ x < y
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step exp_log @0
