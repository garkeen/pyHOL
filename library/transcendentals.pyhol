    2.3: real_norm
    3: introduction
    3.1: apply_backward_step disjI2
    3.1: exists_elim m @3.0
    3.3: inst_exists_goal m
    3.3: rewrite_goal_with_prev @3.2
    3.3: real_norm
  qed

theorem sincos_principal_value
  fixes x :: real
  prop ∃y. (-pi < y ∧ y ≤ pi) ∧ sin y = sin x ∧ cos y = cos x
  [hint_backward]
  proof
    0: inst_exists_goal "pi - (2 * pi) * frac((pi - x) / (2 * pi))"
    0: apply_backward_step conjI
    0: apply_backward_step conjI
    0: cut "!p::real. !x. -p < p - x <--> x < (2 * p) * 1"
    0: z3
    1: rewrite_goal_with_prev @0
    1: apply_backward_step real_lt_lmul:
    1: apply_backward_step real_lt_mul
    1: z3
    2: apply_backward_step pi_pos
  qed

theorem sin_cos_eq
  fixes x :: real, y :: real
  prop sin y = sin x ∧ cos y = cos x ⟷ (∃n. integer n ∧ y = x + 2 * n * pi)
  [hint_rewrite]

theorem sin_cos_inj
  fixes x :: real, y :: real
  prop sin x = sin y ⟶ cos x = cos y ⟶ abs (x - y) < 2 * pi ⟶ x = y
  [hint_backward,hint_backward1]

