theorem rpow_0
  fixes x :: real
  prop x ^ (0::real) = 1
  [hint_rewrite]
proof
  ← rewrite real_zero_def sym=false goal=0
    #[1] x ^ (of_nat::nat ⇒ real) 0 = 1
  ← rewrite rpow_pow sym=false goal=1
    #[2] x ^ (0::nat) = 1
  ← rewrite real_nat_power_def_1 sym=false goal=2
qed

theorem rpow_neg
  fixes x :: real, y :: real
  prop x ^ -y = real_inverse (x ^ y)
