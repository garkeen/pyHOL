    1.2.1: apply_backward_step iffI
    1.2.1: introduction
    1.2.1.2: apply_backward_step negE_gen @1.0,1.2.1.1
    1.2.2: introduction
    1.2.2.1: apply_backward_step divides_le_imp
    1.2.2.1: apply_backward_step gcd_divide1
    1.2.2.2: introduction
    1.2.2.2.1: apply_backward_step negE_gen @1.0,1.2.2.2.0
  qed

theorem gcd_le_min_eq
  fixes m :: nat, n :: nat
  prop gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
  [hint_rewrite]
  proof
    0: cases "n=0"
    0: introduction
    0.1: rewrite_goal_with_prev @0.0
    0.1: rewrite_goal gcd_zero_right sym=false
    0.1: cut "min m 0 = 0"
    0.1: rewrite_goal min_def sym=false
    0.1: rewrite_goal nat_less_eq_def_1 sym=false
    0.1: cases " m = 0"
    0.1: introduction
    0.1.1: rewrite_goal if_P @0.1.0 sym=false
    0.2: introduction
    0.2.1: rewrite_goal if_not_P @0.2.0 sym=false
    0.6: rewrite_goal_with_prev @0.5
    0.6: rewrite_goal nat_less_eq_def_1 sym=false
    0.6: apply_backward_step iffI
    0.6: introduction
    0.6.1: apply_backward_step iffI
    0.6.1: introduction
    0.6.1.0: apply_backward_step eq_refl
    0.6.2: introduction
    0.7: introduction
    0.7.1: rewrite_goal_with_prev @0.7.0
    1: introduction
    1.1: cases "m=0"
    1.1: introduction
    1.1.1: rewrite_goal_with_prev @1.1.0
    1.1.1: rewrite_goal gcd_zero_left sym=false
    1.1.1: cut "min 0 n = 0"
    1.1.1: rewrite_goal min_def sym=false
    1.1.1: cut "0 ≤ n"
    1.1.1: apply_backward_step le_0
    1.1.2: rewrite_goal if_P @1.1.1 sym=false
    1.1.4: rewrite_goal_with_prev @1.1.3
    1.1.4: rewrite_goal nat_less_eq_def_1 sym=false
    1.1.4: apply_backward_step iffI
    1.1.4: introduction
    1.1.4.1: rewrite_goal_with_prev @1.1.4.0
    1.1.5: introduction
    1.1.5.1: rewrite_fact eq_sym_eq @1.1.5.0 sym=false
    1.1.5.2: rewrite_goal_with_prev @1.1.5.1
    1.2: introduction
    1.2.1: cut "∀p. p ≤ min m n ⟷ p ≤ m ∧ p ≤ n"
    1.2.1: z3
    1.2.2: rewrite_goal_with_prev @1.2.1
    1.2.2: rewrite_goal gcd_le sym=false
    1.2.2: rewrite_goal gcd_comm sym=false
    1.2.2: rewrite_goal gcd_le sym=false
    1.2.2: apply_backward_step iffI
    1.2.2: introduction
    1.2.2.1: apply_backward_step iffI
    1.2.2.1: apply_backward_step conjD1 @1.2.2.0
    1.2.2.2: apply_backward_step conjD2 @1.2.2.0
    1.2.3: introduction
    1.2.3.1: apply_backward_step conjI
    1.2.3.1: rewrite_goal_with_prev @1.2.3.0
    1.2.3.3: rewrite_goal_with_prev @1.2.3.0
  qed

theorem gcd_le_max
  fixes m :: nat, n :: nat
  prop gcd m n ≤ max m n
  [hint_backward]
  proof
    0: cases "n=0"
    0: introduction
    0.1: rewrite_goal_with_prev @0.0
    0.1: rewrite_goal gcd_zero_right sym=false
    0.1: cut "max m 0 = m"
    0.1: z3
    0.2: rewrite_goal_with_prev @0.1
    0.2: apply_backward_step less_eq_refl
    1: introduction
    1.1: cases "m=0"
    1.1: introduction
    1.1.1: rewrite_goal_with_prev @1.1.0
    1.1.1: rewrite_goal gcd_zero_left sym=false
    1.1.1: cut "max 0 n = n"
    1.1.1: z3
    1.1.2: rewrite_goal_with_prev @1.1.1
    1.1.2: apply_backward_step less_eq_refl
    1.2: introduction
    1.2.1: cut "!p::nat. p <= min m n --> p <= max m n"
    1.2.1: z3
    1.2.2: apply_prev @1.2.1
    1.2.2: rewrite_goal gcd_le_min_eq sym=false
    1.2.2: apply_backward_step iffI
    1.2.2: introduction
    1.2.2.1: apply_backward_step negE_gen @1.2.0,1.2.2.0
    1.2.3: introduction
    1.2.3.1: apply_backward_step negE_gen @1.0,1.2.3.0
  qed

theorem gcd_mod
  fixes d :: nat, m :: nat, n :: nat
  prop gcd n (m * n + d) = gcd n d
  [hint_rewrite]
  proof
    0: induction m nat_induct
    0: rewrite_goal nat_times_def_1 sym=false
    0: rewrite_goal nat_plus_def_1 sym=false
    2: introduction m
    2.2: rewrite_goal nat_times_def_2 sym=false
    2.2: rewrite_goal add_assoc sym=false
    2.2: rewrite_goal gcd_add_left sym=false
  qed
