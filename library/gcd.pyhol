theorem gcd_unique
  fixes a :: nat, b :: nat, d :: nat
  prop (divides d a ∧ divides d b) ∧ (∀e. divides e a ⟶ divides e b ⟶ divides e d) ⟷ d = gcd a b
  [hint_rewrite]
