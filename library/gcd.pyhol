def gcd :: nat ⇒ nat ⇒ nat = gcd m n = (SOME k. divides k m ∧ divides k n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a k)) [hint_rewrite]

theorem gcd
  fixes m :: nat, n :: nat
  prop divides (gcd m n) m ∧ divides (gcd m n) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (gcd m n))
  [hint_backward]
  proof
    0: apply_forward_step bezout param_a=m param_b=n
    1: exists_elim d,x,y @0
    5: apply_forward_step conjD1 @4
    6: apply_forward_step conjD2 @4
    7: rewrite_goal gcd_def sym=false
    7: apply_forward_step someI param_P="(%d. divides d m ∧ divides d n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a d))" param_x=d
    8: apply_prev @7
    8: rewrite_goal conj_assoc sym=false
    8: apply_backward_step conjI
    8: introduction a
    8.3: rewrite_fact eq_sym_eq @6 sym=false
    8.4: apply_backward_step disjE @8.3
    8.4: introduction
    8.4.1: rewrite_goal_with_prev @8.4.0
    8.4.1: apply_backward_step divides_sub
    8.4.1: apply_backward_step divides_rmul
    8.4.2: apply_backward_step divides_rmul
    8.5: introduction
    8.5.1: rewrite_goal_with_prev @8.5.0
    8.5.1: apply_backward_step divides_sub
    8.5.1: apply_backward_step divides_rmul
    8.5.2: apply_backward_step divides_rmul
  qed

