theory gcd
imports products
description "Greatest common divisors"

def divides :: nat ⇒ nat ⇒ bool = divides m n ⟷ (∃k. n = m * k) [hint_rewrite]

theorem divides_le
  fixes m :: nat, n :: nat
  prop divides m n --> m <= n | n = 0
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides m n
    #[2] m ≤ n ∨ n = 0
  cut "!m. !n. m <= m * n | m * n = (0::nat) " goal=2
    #[3] ∀m::nat. ∀n. m ≤ m * n ∨ m * n = 0
  ← z3 goal=3
    #[4] ∀m::nat. ∀n. m ≤ m * n ∨ m * n = 0
  → rewrite target=fact divides_def sym=false goal=2 facts=[1]
    #[5] ∃k. n = m * k
  elim k goal=2 facts=[5]
    #[6] _VAR k
    #[7] n = m * k
    #[8] m ≤ n ∨ n = 0
  ← rewrite source=prev goal=8 facts=[7]
    #[9] m ≤ m * k ∨ m * k = 0
  ← apply_prev goal=9 facts=[4]
    #[10] ∀n. m ≤ m * n ∨ m * n = 0
    #[11] m ≤ m * k ∨ m * k = 0
qed

theorem divides_le_strong
  fixes m :: nat, n :: nat
  prop divides m n --> 1 <= m & m <= n | n = 0
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides m n
    #[2] 1 ≤ m ∧ m ≤ n ∨ n = 0
  → forward divides_le goal=2 facts=[1]
    #[3] m ≤ n ∨ n = 0
  → rewrite target=fact divides_def sym=false goal=2 facts=[1]
    #[4] ∃k. n = m * k
  ← cases "m=0" goal=2
    #[5] m = 0 ⟶ 1 ≤ m ∧ m ≤ n ∨ n = 0
    #[6] ¬(m = 0) ⟶ 1 ≤ m ∧ m ≤ n ∨ n = 0
  ← intro goal=5
    #[7] m = 0
    #[8] 1 ≤ m ∧ m ≤ n ∨ n = 0
  ← rule disjI2 goal=8
    #[9] n = 0
  elim k goal=9 facts=[4]
    #[10] _VAR k
    #[11] n = m * k
    #[12] n = 0
    #[13] 1 ≤ m ∧ m ≤ n ∨ n = 0
  → rewrite target=fact source=prev goal=12 facts=[7,11]
    #[14] n = 0 * k
  → rewrite target=fact nat_times_def_1 sym=false goal=12 facts=[14]
    #[15] n = 0
  ← intro goal=6
    #[16] ¬(m = 0)
    #[17] 1 ≤ m ∧ m ≤ n ∨ n = 0
  ← rule disjE goal=17 facts=[3]
    #[18] m ≤ n ⟶ 1 ≤ m ∧ m ≤ n ∨ n = 0
    #[19] n = 0 ⟶ 1 ≤ m ∧ m ≤ n ∨ n = 0
  ← intro goal=18
    #[20] m ≤ n
    #[21] 1 ≤ m ∧ m ≤ n ∨ n = 0
  ← rule disjI1 goal=21
    #[22] 1 ≤ m ∧ m ≤ n
  ← rule conjI goal=22
    #[23] 1 ≤ m
  ← rule le_1_2 goal=23
  ← intro goal=19
    #[24] n = 0
    #[25] 1 ≤ m ∧ m ≤ n ∨ n = 0
  ← rule disjI2 goal=25
qed

theorem divides_le_imp
  fixes m :: nat, n :: nat
  prop divides m n --> (n = 0 --> m = 0) --> m <= n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] divides m n
    #[2] n = 0 ⟶ m = 0
    #[3] m ≤ n
  → forward divides_le goal=3 facts=[1]
    #[4] m ≤ n ∨ n = 0
  ← rule disjE goal=3 facts=[4]
    #[5] m ≤ n ⟶ m ≤ n
    #[6] n = 0 ⟶ m ≤ n
  ← intro goal=6
    #[7] n = 0
    #[8] m ≤ n
  → forward goal=8 facts=[2,7]
    #[9] m = 0
  ← rewrite source=prev goal=8 facts=[7]
    #[10] m ≤ 0
  ← rewrite source=prev goal=10 facts=[9]
    #[11] (0::nat) ≤ 0
  ← rule le_0 goal=11
    #[12] (0::nat) ≤ 0
qed

theorem properly_divides_le_imp
  fixes m :: nat, n :: nat
  prop divides m n --> ~(n = 0) --> ~(m = n) --> 2 * m <= n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] divides m n
    #[2] ¬(n = 0)
    #[3] ¬(m = n)
    #[4] 2 * m ≤ n
  → rewrite target=fact divides_def sym=false goal=4 facts=[1]
    #[5] ∃k. n = m * k
  elim d goal=4 facts=[5]
    #[6] _VAR d
    #[7] n = m * d
    #[8] 2 * m ≤ n
  → rewrite target=fact source=prev goal=8 facts=[7,3]
    #[9] ¬(m = m * d)
  cut "~(m = m * d) <--> ~(m = 0) & ~(d = 1)" goal=8
    #[10] ¬(m = m * d) ⟷ ¬(m = 0) ∧ ¬(d = 1)
  ← z3 goal=10
    #[11] ¬(m = m * d) ⟷ ¬(m = 0) ∧ ¬(d = 1)
  → rewrite target=fact source=prev goal=8 facts=[11,9]
    #[12] ¬(m = 0) ∧ ¬(d = 1)
  ← rewrite mult_comm sym=false goal=8
    #[13] m * 2 ≤ n
  ← z3 goal=13 facts=[2,3,7,12]
    #[14] m * 2 ≤ n
qed

theorem divides_one
  fixes n :: nat
  prop divides n 1 <--> n = 1
  [hint_rewrite]
proof
  ← rewrite divides_def sym=false goal=0
    #[1] (∃k. 1 = n * k) ⟷ n = 1
  ← rule iffI goal=1
    #[2] (∃k. 1 = n * k) ⟶ n = 1
    #[3] n = 1 ⟶ (∃k. 1 = n * k)
  ← intro goal=2
    #[4] ∃k. 1 = n * k
    #[5] n = 1
  elim k goal=5 facts=[4]
    #[6] _VAR k
    #[7] 1 = n * k
    #[8] n = 1
  → rewrite target=fact eq_sym_eq sym=false goal=8 facts=[7]
    #[9] n * k = 1
  → rewrite target=fact mult_eq_1 sym=false goal=8 facts=[9]
    #[10] n = 1 ∧ k = 1
  ← rule conjD1 goal=8 facts=[10]
    #[11] n = 1
  ← intro goal=3
    #[12] n = 1
    #[13] ∃k. 1 = n * k
  ← inst "(1::nat)" goal=13
    #[14] 1 = n * 1
  ← rewrite source=prev goal=14 facts=[12]
    #[15] (1::nat) = 1 * 1
  ← rewrite mult_1_left sym=false goal=15
    #[16] (1::nat) = 1 * 1
qed

theorem divides_0
  fixes x :: nat
  prop divides 0 x <--> x = 0
  [hint_rewrite]
proof
  ← rewrite divides_def sym=false goal=0
    #[1] (∃k. x = 0 * k) ⟷ x = 0
  ← rule iffI goal=1
    #[2] (∃k. x = 0 * k) ⟶ x = 0
    #[3] x = 0 ⟶ (∃k. x = 0 * k)
  ← intro goal=2
    #[4] ∃k. x = 0 * k
    #[5] x = 0
  elim k goal=5 facts=[4]
    #[6] _VAR k
    #[7] x = 0 * k
    #[8] x = 0
  → rewrite target=fact nat_times_def_1 sym=false goal=8 facts=[7]
    #[9] x = 0
  ← intro goal=3
    #[10] x = 0
    #[11] ∃k. x = 0 * k
  ← inst "(0::nat)" goal=11
    #[12] x = 0 * 0
  ← rewrite mult_0_right sym=false goal=12
qed

theorem divides_1
  fixes x :: nat
  prop divides 1 x
  [hint_backward]
proof
  ← rewrite divides_def sym=false goal=0
    #[1] ∃k. x = 1 * k
  ← inst x goal=1
    #[2] x = 1 * x
  ← rewrite mult_1_left sym=false goal=2
qed

theorem div_add
  fixes a :: nat, b :: nat, d :: nat
  prop divides d a | divides d b --> (a + b) DIV d = a DIV d + b DIV d
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides d a ∨ divides d b
    #[2] (a + b) DIV d = a DIV d + b DIV d
  ← cases "d=0" goal=2
    #[3] d = 0 ⟶ (a + b) DIV d = a DIV d + b DIV d
    #[4] ¬(d = 0) ⟶ (a + b) DIV d = a DIV d + b DIV d
  ← intro goal=3
    #[5] d = 0
    #[6] (a + b) DIV d = a DIV d + b DIV d
  ← rewrite source=prev goal=6 facts=[5]
    #[7] (a + b) DIV 0 = a DIV 0 + b DIV 0
  ← rewrite div_zero sym=false goal=7
    #[8] (0::nat) = 0 + 0
  ← rewrite add_0_right sym=false goal=8
    #[9] (0::nat) = 0 + 0
  ← intro goal=4
    #[10] ¬(d = 0)
    #[11] (a + b) DIV d = a DIV d + b DIV d
  → rewrite target=fact divides_def sym=false goal=11 facts=[1]
    #[12] (∃k. a = d * k) ∨ (∃k. b = d * k)
  ← rule disjE goal=11 facts=[12]
    #[13] (∃k. a = d * k) ⟶ (a + b) DIV d = a DIV d + b DIV d
    #[14] (∃k. b = d * k) ⟶ (a + b) DIV d = a DIV d + b DIV d
  ← intro goal=13
    #[15] ∃k. a = d * k
    #[16] (a + b) DIV d = a DIV d + b DIV d
  elim k goal=16 facts=[15]
    #[17] _VAR k
    #[18] a = d * k
    #[19] (a + b) DIV d = a DIV d + b DIV d
  ← rewrite source=prev goal=19 facts=[18]
    #[20] (d * k + b) DIV d = d * k DIV d + b DIV d
  → forward div_mult_add2 param_a=k param_b=b goal=20 facts=[10]
    #[21] (d * k + b) DIV d = k + b DIV d
  → forward div_mult param_n=k goal=20 facts=[10]
    #[22] d * k DIV d = k
  ← rewrite source=prev goal=20 facts=[21]
    #[23] k + b DIV d = d * k DIV d + b DIV d
  ← rewrite source=prev goal=23 facts=[22]
    #[24] k + b DIV d = d * k DIV d + b DIV d
  ← intro goal=14
    #[25] ∃k. b = d * k
    #[26] (a + b) DIV d = a DIV d + b DIV d
  elim k goal=26 facts=[25]
    #[27] b = d * k
    #[28] (a + b) DIV d = a DIV d + b DIV d
  ← rewrite source=prev goal=28 facts=[27]
    #[29] (a + d * k) DIV d = a DIV d + d * k DIV d
  → forward div_mult param_n=k goal=29 facts=[10]
  → forward div_mult_add4 param_a=k param_b=a goal=29 facts=[10]
    #[30] (a + d * k) DIV d = a DIV d + k
  ← rewrite source=prev goal=29 facts=[30]
    #[31] a DIV d + k = a DIV d + d * k DIV d
  ← rewrite source=prev goal=31 facts=[22]
    #[32] a DIV d + k = a DIV d + d * k DIV d
qed

theorem divides_mod
  fixes m :: nat, n :: nat
  prop divides m n <--> n MOD m = 0
  [hint_rewrite]
proof
  ← rewrite divides_def sym=false goal=0
    #[1] (∃k. n = m * k) ⟷ n MOD m = 0
  ← rewrite mod_eq_0 sym=false goal=1
    #[2] (∃k. n = m * k) ⟷ (∃q. n = q * m)
  ← z3 goal=2
qed

theorem divides_div_mult
  fixes m :: nat, n :: nat
  prop divides m n <--> n DIV m * m = n
  [hint_rewrite]
proof
  ← rewrite divides_def sym=false goal=0
    #[1] (∃k. n = m * k) ⟷ n DIV m * m = n
  ← rule iffI goal=1
    #[2] (∃k. n = m * k) ⟶ n DIV m * m = n
    #[3] n DIV m * m = n ⟶ (∃k. n = m * k)
  ← intro goal=2
    #[4] ∃k. n = m * k
    #[5] n DIV m * m = n
  elim k goal=5 facts=[4]
    #[6] _VAR k
    #[7] n = m * k
    #[8] n DIV m * m = n
  ← rewrite source=prev goal=8 facts=[7]
    #[9] m * k DIV m * m = m * k
  ← cases "m=0" goal=9
    #[10] m = 0 ⟶ m * k DIV m * m = m * k
    #[11] ¬(m = 0) ⟶ m * k DIV m * m = m * k
  ← intro goal=10
    #[12] m = 0
    #[13] m * k DIV m * m = m * k
  ← rewrite source=prev goal=13 facts=[12]
    #[14] 0 * k DIV 0 * 0 = 0 * k
  nat_norm goal=14
    #[15] 0 * k DIV 0 * 0 = 0 * k
  ← intro goal=11
    #[16] ¬(m = 0)
    #[17] m * k DIV m * m = m * k
  → forward div_mult param_n=k goal=17 facts=[16]
    #[18] m * k DIV m = k
  ← rewrite source=prev goal=17 facts=[18]
    #[19] k * m = m * k
  nat_norm goal=19
    #[20] k * m = m * k
  ← intro goal=3
    #[21] n DIV m * m = n
    #[22] ∃k. n = m * k
  → rewrite target=fact eq_sym_eq sym=false goal=22 facts=[21]
    #[23] n = n DIV m * m
  ← rewrite source=prev goal=22 facts=[23]
    #[24] ∃k. n DIV m * m = m * k
  ← inst "n DIV m" goal=24
    #[25] n DIV m * m = m * (n DIV m)
  nat_norm goal=25
    #[26] n DIV m * m = m * (n DIV m)
qed

theorem div_by_div
  fixes m :: nat, n :: nat
  prop ~(n = 0) --> divides m n --> n DIV (n DIV m) = m
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] divides m n
    #[3] n DIV (n DIV m) = m
  → rewrite target=fact divides_div_mult sym=false goal=3 facts=[2]
    #[4] n DIV m * m = n
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] n = n DIV m * m
  ← rewrite source=prev goal=3 facts=[5]
    #[6] n DIV m * m DIV (n DIV m * m DIV m) = m
  cut "(n DIV m * m DIV m) = (n DIV m)" goal=6
    #[7] n DIV m * m DIV m = n DIV m
  ← rewrite source=prev goal=7 facts=[4]
    #[8] n DIV m * m DIV m = n DIV m
  ← rewrite source=prev goal=6 facts=[8]
    #[9] n DIV m * m DIV (n DIV m) = m
  ← rule div_mult goal=9
    #[10] ¬(n DIV m = 0)
  → rewrite target=fact divides_def sym=false goal=10 facts=[2]
    #[11] ∃k. n = m * k
  elim k goal=10 facts=[11]
    #[12] _VAR k
    #[13] n = m * k
    #[14] ¬(n DIV m = 0)
    #[15] n DIV m * m DIV (n DIV m) = m
    #[16] n DIV m * m DIV (n DIV m * m DIV m) = m
    #[17] n DIV (n DIV m) = m
  ← cases "m=0" goal=14
    #[18] m = 0 ⟶ ¬(n DIV m = 0)
    #[19] ¬(m = 0) ⟶ ¬(n DIV m = 0)
  ← intro goal=18
    #[20] m = 0
    #[21] ¬(n DIV m = 0)
  → rewrite target=fact source=prev goal=21 facts=[20,13]
    #[22] n = 0 * k
  → rewrite target=fact nat_times_def_1 sym=false goal=21 facts=[22]
    #[23] n = 0
  ← rule negE_gen goal=21 facts=[1,23]
    #[24] ¬(n DIV m = 0)
  ← intro goal=19
    #[25] ¬(m = 0)
    #[26] ¬(n DIV m = 0)
  → forward div_eq_0 param_m=n goal=26 facts=[25]
    #[27] n DIV m = 0 ⟷ n < m
  ← rewrite source=prev goal=26 facts=[27]
    #[28] ¬(n < m)
  ← rewrite not_lt sym=false goal=28
    #[29] m ≤ n
  ← rewrite source=prev goal=29 facts=[13]
    #[30] m ≤ m * k
  → rewrite target=fact source=prev goal=30 facts=[13,1]
    #[31] ¬(m * k = 0)
  → rewrite target=fact mult_eq_0 sym=false goal=30 facts=[31]
    #[32] ¬(m = 0 ∨ k = 0)
  → rewrite target=fact de_morgan_thm2 sym=false goal=30 facts=[32]
    #[33] ¬(m = 0) ∧ ¬(k = 0)
  → forward conjD2 goal=30 facts=[33]
    #[34] ¬(k = 0)
  ← z3 goal=30 facts=[34]
    #[35] m ≤ m * k
qed

theorem divides_self
  fixes n :: nat
  prop divides n n
  [hint_backward]
proof
  ← rewrite divides_def sym=false goal=0
    #[1] ∃k. n = n * k
  ← inst "(1::nat)" goal=1
    #[2] n = n * 1
  ← rewrite mult_1_right sym=false goal=2
qed

theorem divides_trans
  fixes k :: nat, m :: nat, n :: nat
  prop divides k m --> divides m n --> divides k n
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides k m
    #[2] divides m n
    #[3] divides k n
  → rewrite target=fact divides_def sym=false goal=3 facts=[1]
    #[4] ∃k1. m = k * k1
  → rewrite target=fact divides_def sym=false goal=3 facts=[2]
    #[5] ∃k. n = m * k
  elim p goal=3 facts=[4]
    #[6] _VAR p
    #[7] m = k * p
    #[8] divides k n
  elim q goal=8 facts=[5]
    #[9] _VAR q
    #[10] n = m * q
    #[11] divides k n
  ← rewrite divides_def sym=false goal=11
    #[12] ∃k1. n = k * k1
  ← inst "p * q" goal=12
    #[13] n = k * (p * q)
  ← rewrite source=prev goal=13 facts=[10]
    #[14] m * q = k * (p * q)
  ← rewrite source=prev goal=14 facts=[7]
    #[15] k * p * q = k * (p * q)
  ← rewrite mult_assoc sym=false goal=15
    #[16] k * p * q = k * (p * q)
qed

theorem divides_antisym
  fixes m :: nat, n :: nat
  prop divides m n --> divides n m --> m = n
proof
  ← intro goal=0
    #[1] divides m n
    #[2] divides n m
    #[3] m = n
  → rewrite target=fact divides_def sym=false goal=3 facts=[1]
    #[4] ∃k. n = m * k
  → rewrite target=fact divides_def sym=false goal=3 facts=[2]
    #[5] ∃k. m = n * k
  elim p goal=3 facts=[4]
    #[6] _VAR p
    #[7] n = m * p
    #[8] m = n
  elim q goal=8 facts=[5]
    #[9] _VAR q
    #[10] m = n * q
    #[11] m = n
  cut "m = m * 1" goal=11 facts=[10]
    #[12] m = m * 1
  ← rewrite mult_1_right sym=false goal=12
    #[13] m = m * 1
  → rewrite target=fact source=prev goal=11 facts=[13,10]
    #[14] m * 1 = n * q
  → rewrite target=fact source=prev goal=11 facts=[7,14]
    #[15] m * 1 = m * p * q
  → rewrite target=fact mult_assoc sym=false goal=11 facts=[15]
    #[16] m * 1 = m * (p * q)
  → rewrite target=fact eq_mult_lcancel sym=false goal=11 facts=[16]
    #[17] m = 0 ∨ 1 = p * q
  ← rule disjE goal=11 facts=[17]
    #[18] m = 0 ⟶ m = n
    #[19] 1 = p * q ⟶ m = n
  ← intro goal=18
    #[20] m = 0
    #[21] m = n
  → rewrite target=fact source=prev goal=21 facts=[20,7]
    #[22] n = 0 * p
  → rewrite target=fact nat_times_def_1 sym=false goal=21 facts=[22]
    #[23] n = 0
  ← rewrite source=prev goal=21 facts=[20]
    #[24] 0 = n
  ← rewrite source=prev goal=24 facts=[23]
    #[25] 0 = n
  ← intro goal=19
    #[26] 1 = p * q
    #[27] m = n
  → rewrite target=fact eq_sym_eq sym=false goal=27 facts=[26]
    #[28] p * q = 1
  → rewrite target=fact mult_eq_1 sym=false goal=27 facts=[28]
    #[29] p = 1 ∧ q = 1
  → forward conjD1 goal=27 facts=[29]
    #[30] p = 1
  → rewrite target=fact source=prev goal=27 facts=[30,7]
    #[31] n = m * 1
  → rewrite target=fact mult_1_right sym=false goal=27 facts=[31]
    #[32] n = m
  ← rewrite eq_sym_eq sym=false goal=27
qed

theorem divides_zero
  fixes n :: nat
  prop divides n 0
  [hint_backward]
proof
  ← rewrite divides_def sym=false goal=0
    #[1] ∃k. 0 = n * k
  ← inst "(0::nat)" goal=1
    #[2] 0 = n * 0
  ← rewrite mult_0_right sym=false goal=2
qed

theorem divides_div_divides
  fixes d :: nat, e :: nat, n :: nat
  prop divides d n --> (n = 0 --> e = 0) --> divides (n DIV d) e <--> divides n (d * e)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] divides d n
    #[2] n = 0 ⟶ e = 0
    #[3] divides (n DIV d) e ⟷ divides n (d * e)
  → rewrite target=fact divides_div_mult sym=false goal=3 facts=[1]
    #[4] n DIV d * d = n
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] n = n DIV d * d
  ← rule iffI goal=3
    #[6] divides (n DIV d) e ⟶ divides n (d * e)
    #[7] divides n (d * e) ⟶ divides (n DIV d) e
  ← rewrite divides_def sym=false goal=6
    #[8] (∃k. e = n DIV d * k) ⟶ (∃k. d * e = n * k)
  ← intro goal=8
    #[9] ∃k. e = n DIV d * k
    #[10] ∃k. d * e = n * k
  elim k1 goal=10 facts=[9]
    #[11] _VAR k1
    #[12] e = n DIV d * k1
    #[13] ∃k. d * e = n * k
  ← rewrite source=prev goal=13 facts=[5]
    #[14] ∃k. d * e = n DIV d * d * k
  ← rewrite source=prev goal=14 facts=[12]
    #[15] ∃k. d * (n DIV d * k1) = n DIV d * d * k
  ← inst k1 goal=15
    #[16] d * (n DIV d * k1) = n DIV d * d * k1
  nat_norm goal=16
    #[17] d * (n DIV d * k1) = n DIV d * d * k1
  ← cases "e=0" goal=7
    #[18] e = 0 ⟶ divides n (d * e) ⟶ divides (n DIV d) e
    #[19] ¬(e = 0) ⟶ divides n (d * e) ⟶ divides (n DIV d) e
  ← intro goal=18
    #[20] e = 0
    #[21] divides n (d * e)
    #[22] divides (n DIV d) e
  ← rewrite source=prev goal=22 facts=[20]
    #[23] divides (n DIV d) 0
  ← rule divides_zero goal=23
    #[24] divides (n DIV d) 0
  ← intro goal=19
    #[25] ¬(e = 0)
    #[26] divides (n DIV d) e
  ← rule contrapositive goal=26 facts=[25]
    #[27] ¬(divides (n DIV d) e) ⟶ ¬¬(e = 0)
  ← intro goal=27
    #[28] ¬(divides (n DIV d) e)
    #[29] ¬¬(e = 0)
  ← rewrite double_neg sym=false goal=29
    #[30] e = 0
  ← apply_prev goal=30 facts=[2]
    #[31] n = 0
  ← rule contrapositive goal=31 facts=[28]
    #[32] ¬(n = 0) ⟶ ¬¬(divides (n DIV d) e)
  ← intro goal=32
    #[33] ¬(n = 0)
    #[34] ¬¬(divides (n DIV d) e)
  ← rewrite double_neg sym=false goal=34
    #[35] divides (n DIV d) e
  → rewrite target=fact divides_def sym=false goal=35 facts=[21]
    #[36] ∃k. d * e = n * k
  ← rewrite divides_def sym=false goal=35
    #[37] ∃k. e = n DIV d * k
  elim k goal=37 facts=[36]
    #[38] _VAR k
    #[39] d * e = n * k
    #[40] ∃k. e = n DIV d * k
    #[41] divides (n DIV d) e
    #[42] ¬¬(divides (n DIV d) e)
  → rewrite target=fact source=prev goal=40 facts=[5,39]
    #[43] d * e = n DIV d * d * k
  cut "n DIV d * d * k = d * (n DIV d) * k" goal=40
    #[44] n DIV d * d * k = d * (n DIV d) * k
  nat_norm goal=44
    #[45] n DIV d * d * k = d * (n DIV d) * k
  → rewrite target=fact source=prev goal=40 facts=[45,43]
    #[46] d * e = d * (n DIV d) * k
  → rewrite target=fact mult_assoc sym=false goal=40 facts=[46]
    #[47] d * e = d * (n DIV d * k)
  → rewrite target=fact eq_mult_lcancel sym=false goal=40 facts=[47]
    #[48] d = 0 ∨ e = n DIV d * k
  ← rule disjE goal=40 facts=[48]
    #[49] d = 0 ⟶ (∃k. e = n DIV d * k)
    #[50] e = n DIV d * k ⟶ (∃k1. e = n DIV d * k1)
  ← intro goal=49
    #[51] d = 0
    #[52] ∃k. e = n DIV d * k
  → rewrite target=fact source=prev goal=52 facts=[51,1]
    #[53] divides 0 n
  → rewrite target=fact divides_0 sym=false goal=52 facts=[53]
    #[54] n = 0
  ← rule negE_gen goal=52 facts=[33,54]
    #[55] ∃k. e = n DIV d * k
  ← intro goal=50
    #[56] e = n DIV d * k
    #[57] ∃k. e = n DIV d * k
  ← inst k goal=57
qed

theorem divides_div_self
  fixes d :: nat, e :: nat, n :: nat
  prop divides d n --> divides (n DIV d) n
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides d n
    #[2] divides (n DIV d) n
  → rewrite target=fact divides_div_mult sym=false goal=2 facts=[1]
    #[3] n DIV d * d = n
  ← rewrite divides_def sym=false goal=2
    #[4] ∃k. n = n DIV d * k
  ← inst d goal=4
    #[5] n = n DIV d * d
  ← rewrite eq_sym_eq sym=false goal=5
qed

theorem divides_sum
  fixes k :: nat, m :: nat, n :: nat
  prop divides k m --> divides k n --> divides k (m + n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides k m
    #[2] divides k n
    #[3] divides k (m + n)
  → rewrite target=fact divides_def sym=false goal=3 facts=[1]
    #[4] ∃k1. m = k * k1
  → rewrite target=fact divides_def sym=false goal=3 facts=[2]
    #[5] ∃k1. n = k * k1
  elim p goal=3 facts=[4]
    #[6] _VAR p
    #[7] m = k * p
    #[8] divides k (m + n)
  elim q goal=8 facts=[5]
    #[9] _VAR q
    #[10] n = k * q
    #[11] divides k (m + n)
  ← rewrite divides_def sym=false goal=11
    #[12] ∃k1. m + n = k * k1
  ← inst "p + q" goal=12
    #[13] m + n = k * (p + q)
  ← rewrite source=prev goal=13 facts=[10]
    #[14] m + k * q = k * (p + q)
  ← rewrite source=prev goal=14 facts=[7]
    #[15] k * p + k * q = k * (p + q)
  ← rewrite distrib_l sym=false goal=15
    #[16] k * p + k * q = k * (p + q)
qed

theorem divides_sub
  fixes k :: nat, m :: nat, n :: nat
  prop divides k m --> divides k n --> divides k (m - n)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] divides k m
    #[2] divides k n
    #[3] divides k (m - n)
  → rewrite target=fact divides_def sym=false goal=3 facts=[1]
    #[4] ∃k1. m = k * k1
  → rewrite target=fact divides_def sym=false goal=3 facts=[2]
    #[5] ∃k1. n = k * k1
  ← rewrite divides_def sym=false goal=3
    #[6] ∃k1. m - n = k * k1
  elim k1 goal=6 facts=[4]
    #[7] _VAR k1
    #[8] m = k * k1
    #[9] ∃k1. m - n = k * k1
    #[10] divides k (m - n)
  elim k2 goal=9 facts=[5]
    #[11] _VAR k2
    #[12] n = k * k2
    #[13] ∃k1. m - n = k * k1
    #[14] divides k (m - n)
  ← inst k1-k2 goal=13
    #[15] m - n = k * (k1 - k2)
  ← rewrite source=prev goal=15 facts=[8]
    #[16] k * k1 - n = k * (k1 - k2)
  ← rewrite source=prev goal=16 facts=[12]
    #[17] k * k1 - k * k2 = k * (k1 - k2)
  ← rewrite left_sub_distrib sym=false goal=17
    #[18] k * k1 - k * k2 = k * (k1 - k2)
qed

theorem divides_sum2
  fixes k :: nat, m :: nat, n :: nat
  prop divides k (m + n) --> divides k m --> divides k n
  [hint_forward]
proof
  ← intro goal=0
    #[1] divides k (m + n)
    #[2] divides k m
    #[3] divides k n
  cut "n = m + n - m" goal=3
    #[4] n = m + n - m
  ← rewrite nat_plus_minus_2 sym=false goal=4
    #[5] n = m + n - m
  ← rewrite source=prev goal=3 facts=[5]
    #[6] divides k (m + n - m)
  ← rule divides_sub goal=6
qed

theorem divides_lmul
  fixes a :: nat, d :: nat, x :: nat
  prop divides d a --> divides d (x * a)
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides d a
    #[2] divides d (x * a)
  → rewrite target=fact divides_def sym=false goal=2 facts=[1]
    #[3] ∃k. a = d * k
  ← rewrite divides_def sym=false goal=2
    #[4] ∃k. x * a = d * k
  elim k goal=4 facts=[3]
    #[5] _VAR k
    #[6] a = d * k
    #[7] ∃k. x * a = d * k
    #[8] divides d (x * a)
  ← inst "x * k" goal=7
    #[9] x * a = d * (x * k)
  ← rewrite source=prev goal=9 facts=[6]
    #[10] x * (d * k) = d * (x * k)
  nat_norm goal=10
    #[11] x * (d * k) = d * (x * k)
qed

theorem divides_rmul
  fixes a :: nat, d :: nat, x :: nat
  prop divides d a --> divides d (a * x)
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides d a
    #[2] divides d (a * x)
  ← rewrite mult_comm sym=false goal=2
    #[3] divides d (x * a)
  ← rule divides_lmul goal=3
qed

theorem divides_lmul2
  fixes a :: nat, d :: nat, x :: nat
  prop divides (x * d) a --> divides d a
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides (x * d) a
    #[2] divides d a
  → rewrite target=fact divides_def sym=false goal=2 facts=[1]
    #[3] ∃k. a = x * d * k
  ← rewrite divides_def sym=false goal=2
    #[4] ∃k. a = d * k
  elim k goal=4 facts=[3]
    #[5] _VAR k
    #[6] a = x * d * k
    #[7] ∃k. a = d * k
    #[8] divides d a
  ← inst "x * k" goal=7
    #[9] a = d * (x * k)
  ← rewrite source=prev goal=9 facts=[6]
    #[10] x * d * k = d * (x * k)
  nat_norm goal=10
    #[11] x * d * k = d * (x * k)
qed

theorem divides_rmul2
  fixes a :: nat, d :: nat, x :: nat
  prop divides (d * x) a --> divides d a
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides (d * x) a
    #[2] divides d a
  → rewrite target=fact mult_comm sym=false goal=2 facts=[1]
    #[3] divides (x * d) a
  ← rule divides_lmul2 param_x=x goal=2
qed

theorem divides_mult_left
  fixes k :: nat, m :: nat, n :: nat
  prop divides m n --> divides (k * m) (k * n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides m n
    #[2] divides (k * m) (k * n)
  → rewrite target=fact divides_def sym=false goal=2 facts=[1]
    #[3] ∃k. n = m * k
  elim p goal=2 facts=[3]
    #[4] _VAR p
    #[5] n = m * p
    #[6] divides (k * m) (k * n)
  ← rewrite divides_def sym=false goal=6
    #[7] ∃k1. k * n = k * m * k1
  ← inst p goal=7
    #[8] k * n = k * m * p
  ← rewrite source=prev goal=8 facts=[5]
    #[9] k * (m * p) = k * m * p
  ← rewrite mult_assoc sym=false goal=9
    #[10] k * (m * p) = k * m * p
qed

theorem divides_mult_right
  fixes k :: nat, m :: nat, n :: nat
  prop divides m n --> divides (m * k) (n * k)
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides m n
    #[2] divides (m * k) (n * k)
  → rewrite target=fact divides_def sym=false goal=2 facts=[1]
    #[3] ∃k. n = m * k
  elim p goal=2 facts=[3]
    #[4] _VAR p
    #[5] n = m * p
    #[6] divides (m * k) (n * k)
  ← rewrite divides_def sym=false goal=6
    #[7] ∃k1. n * k = m * k * k1
  ← inst p goal=7
    #[8] n * k = m * k * p
  ← rewrite source=prev goal=8 facts=[5]
    #[9] m * p * k = m * k * p
  nat_norm goal=9
    #[10] m * p * k = m * k * p
qed

theorem divides_cmul2
  fixes a :: nat, b :: nat, c :: nat
  prop divides (c * a) (c * b) --> ~(c = 0) --> divides a b
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] divides (c * a) (c * b)
    #[2] ¬(c = 0)
    #[3] divides a b
  → rewrite target=fact divides_def sym=false goal=3 facts=[1]
    #[4] ∃k. c * b = c * a * k
  ← rewrite divides_def sym=false goal=3
    #[5] ∃k. b = a * k
  elim k goal=5 facts=[4]
    #[6] _VAR k
    #[7] c * b = c * a * k
    #[8] ∃k. b = a * k
    #[9] divides a b
  → rewrite target=fact mult_assoc sym=false goal=8 facts=[7]
    #[10] c * b = c * (a * k)
  → rewrite target=fact eq_mult_lcancel sym=false goal=8 facts=[10]
    #[11] c = 0 ∨ b = a * k
  ← rule disjE goal=8 facts=[11]
    #[12] c = 0 ⟶ (∃k. b = a * k)
    #[13] b = a * k ⟶ (∃k1. b = a * k1)
  ← intro goal=12
    #[14] c = 0
    #[15] ∃k. b = a * k
  ← rule negE_gen goal=15 facts=[2,14]
    #[16] ∃k. b = a * k
  ← intro goal=13
    #[17] b = a * k
    #[18] ∃k. b = a * k
  ← inst k goal=18
qed

theorem divides_lmul2_eq
  fixes a :: nat, b :: nat, c :: nat
  prop ~(c = 0) --> divides (c * a) (c * b) <--> divides a b
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(c = 0)
    #[2] divides (c * a) (c * b) ⟷ divides a b
  ← rule iffI goal=2
    #[3] divides (c * a) (c * b) ⟶ divides a b
    #[4] divides a b ⟶ divides (c * a) (c * b)
  ← intro goal=3
    #[5] divides (c * a) (c * b)
    #[6] divides a b
  ← rule divides_cmul2 goal=6 facts=[5,1]
  ← intro goal=4
    #[7] divides a b
    #[8] divides (c * a) (c * b)
  ← rule divides_mult_left goal=8 facts=[7]
    #[9] divides (c * a) (c * b)
qed

theorem divides_rmul2_eq
  fixes a :: nat, b :: nat, c :: nat
  prop ~(c = 0) --> divides (a * c) (b * c) <--> divides a b
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(c = 0)
    #[2] divides (a * c) (b * c) ⟷ divides a b
  ← rewrite mult_comm sym=false goal=2
    #[3] divides (c * a) (c * b) ⟷ divides a b
  ← rule divides_lmul2_eq goal=3
qed

theorem divides_divides_div
  fixes d :: nat, e :: nat, n :: nat
  prop divides d n --> divides e (n DIV d) <--> divides (d * e) n
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides d n
    #[2] divides e (n DIV d) ⟷ divides (d * e) n
  → rewrite target=fact divides_div_mult sym=false goal=2 facts=[1]
    #[3] n DIV d * d = n
  → rewrite target=fact eq_sym_eq sym=false goal=2 facts=[3]
    #[4] n = n DIV d * d
  ← rule iffI goal=2
    #[5] divides e (n DIV d) ⟶ divides (d * e) n
    #[6] divides (d * e) n ⟶ divides e (n DIV d)
  ← intro goal=5
    #[7] divides e (n DIV d)
    #[8] divides (d * e) n
  ← rewrite source=prev goal=8 facts=[4]
    #[9] divides (d * e) (n DIV d * d)
  cut "n DIV d * d = d * (n DIV d)" goal=9
    #[10] n DIV d * d = d * (n DIV d)
  nat_norm goal=10
    #[11] n DIV d * d = d * (n DIV d)
  ← rewrite source=prev goal=9 facts=[11]
    #[12] divides (d * e) (d * (n DIV d))
  ← rule divides_mult_left goal=12
  ← intro goal=6
    #[13] divides (d * e) n
    #[14] divides e (n DIV d)
  ← cases "d=0" goal=14
    #[15] d = 0 ⟶ divides e (n DIV d)
    #[16] ¬(d = 0) ⟶ divides e (n DIV d)
  ← intro goal=15
    #[17] d = 0
    #[18] divides e (n DIV d)
  ← rewrite source=prev goal=18 facts=[17]
    #[19] divides e (n DIV 0)
  ← rewrite div_zero sym=false goal=19
    #[20] divides e 0
  ← rule divides_zero goal=20
    #[21] divides e 0
  ← intro goal=16
    #[22] ¬(d = 0)
    #[23] divides e (n DIV d)
  ← rule divides_cmul2 param_c=d goal=23
    #[24] divides (d * e) (d * (n DIV d))
  ← rewrite mult_comm sym=false goal=24
    #[25] divides (e * d) (n DIV d * d)
  ← rewrite source=prev goal=25 facts=[3]
    #[26] divides (e * d) n
  ← rewrite mult_comm sym=false goal=26
qed

theorem divides_divides_div_eq
  fixes d :: nat, e :: nat, n :: nat
  prop divides d n & divides e (n DIV d) <--> divides (d * e) n
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] divides d n ∧ divides e (n DIV d) ⟶ divides (d * e) n
    #[2] divides (d * e) n ⟶ divides d n ∧ divides e (n DIV d)
  ← intro goal=1
    #[3] divides d n ∧ divides e (n DIV d)
    #[4] divides (d * e) n
  → forward conjD1 goal=4 facts=[3]
    #[5] divides d n
  → forward conjD2 goal=4 facts=[3]
    #[6] divides e (n DIV d)
  → forward divides_divides_div param_e=e goal=4 facts=[5]
    #[7] divides e (n DIV d) ⟷ divides (d * e) n
  → rewrite target=fact source=prev goal=4 facts=[7,6]
  ← intro goal=2
    #[8] divides (d * e) n
    #[9] divides d n ∧ divides e (n DIV d)
  ← rule conjI goal=9
    #[10] divides d n
    #[11] divides e (n DIV d)
  ← rule divides_rmul2 param_x=e goal=10
  → forward divides_divides_div param_e=e goal=11 facts=[10]
    #[12] divides e (n DIV d) ⟷ divides (d * e) n
  ← rewrite source=prev goal=11 facts=[12]
qed

theorem divides_cases
  fixes m :: nat, n :: nat
  prop divides n m --> m = 0 | m = n | 2 * n <= m
  [hint_backward]

theorem divides_div_not
  fixes n :: nat, q :: nat, r :: nat, x :: nat
  prop x = q * n + r --> 0 < r --> r < n --> ~(divides n x)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] x = q * n + r
    #[2] 0 < r
    #[3] r < n
    #[4] ¬(divides n x)
  ← rewrite source=prev goal=4 facts=[1]
    #[5] ¬(divides n (q * n + r))
  → forward divides_self param_n=n goal=5
    #[6] divides n n
  → forward divides_lmul param_x=q goal=5 facts=[6]
    #[7] divides n (q * n)
  ← rule negI goal=5
    #[8] divides n (q * n + r) ⟶ false
  ← intro goal=8
    #[9] divides n (q * n + r)
    #[10] false
  → forward divides_sum2 goal=10 facts=[9,7]
    #[11] divides n r
  → forward divides_le goal=10 facts=[11]
    #[12] n ≤ r ∨ r = 0
  ← rule contrapositive goal=10 facts=[12]
    #[13] ¬false ⟶ ¬(n ≤ r ∨ r = 0)
  ← intro goal=13
    #[14] ¬false
    #[15] ¬(n ≤ r ∨ r = 0)
  ← rewrite de_morgan_thm2 sym=false goal=15
    #[16] ¬(n ≤ r) ∧ ¬(r = 0)
  ← rule conjI goal=16
    #[17] ¬(n ≤ r)
    #[18] ¬(r = 0)
  ← rewrite not_le sym=false goal=17
  ← rule contrapositive goal=18 facts=[2]
    #[19] ¬¬(r = 0) ⟶ ¬(0 < r)
  ← intro goal=19
    #[20] ¬¬(r = 0)
    #[21] ¬(0 < r)
  → rewrite target=fact double_neg sym=false goal=21 facts=[20]
    #[22] r = 0
  ← rewrite source=prev goal=21 facts=[22]
    #[23] ¬((0::nat) < 0)
  ← rewrite nat_less_def_1 sym=false goal=23
qed

theorem divides_mul2
  fixes a :: nat, b :: nat, c :: nat, d :: nat
  prop divides a b --> divides c d --> divides (a * c) (b * d)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] divides a b
    #[2] divides c d
    #[3] divides (a * c) (b * d)
  → rewrite target=fact divides_def sym=false goal=3 facts=[1]
    #[4] ∃k. b = a * k
  → rewrite target=fact divides_def sym=false goal=3 facts=[2]
    #[5] ∃k. d = c * k
  elim k1 goal=3 facts=[4]
    #[6] _VAR k1
    #[7] b = a * k1
    #[8] divides (a * c) (b * d)
  elim k2 goal=8 facts=[5]
    #[9] _VAR k2
    #[10] d = c * k2
    #[11] divides (a * c) (b * d)
  ← rewrite divides_def sym=false goal=11
    #[12] ∃k. b * d = a * c * k
  ← inst k1*k2 goal=12
    #[13] b * d = a * c * (k1 * k2)
  ← rewrite source=prev goal=13 facts=[7]
    #[14] a * k1 * d = a * c * (k1 * k2)
  ← rewrite source=prev goal=14 facts=[10]
    #[15] a * k1 * (c * k2) = a * c * (k1 * k2)
  nat_norm goal=15
    #[16] a * k1 * (c * k2) = a * c * (k1 * k2)
qed

theorem divides_exp
  fixes n :: nat, x :: nat, y :: nat
  prop divides x y --> divides (x ^ n) (y ^ n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides x y
    #[2] divides (x ^ n) (y ^ n)
  → rewrite target=fact divides_def sym=false goal=2 facts=[1]
    #[3] ∃k. y = x * k
  elim k goal=2 facts=[3]
    #[4] _VAR k
    #[5] y = x * k
    #[6] divides (x ^ n) (y ^ n)
  ← rewrite divides_def sym=false goal=6
    #[7] ∃k. y ^ n = x ^ n * k
  ← inst "k ^ n" goal=7
    #[8] y ^ n = x ^ n * k ^ n
  ← rewrite source=prev goal=8 facts=[5]
    #[9] (x * k) ^ n = x ^ n * k ^ n
  ← rewrite mult_exp sym=false goal=9
    #[10] (x * k) ^ n = x ^ n * k ^ n
qed

theorem divides_exp2
  fixes n :: nat, x :: nat, y :: nat
  prop ~(n = 0) --> divides (x ^ n) y --> divides x y
  [hint_backward,hint_backward1]

theorem divides_exp_le_imp
  fixes m :: nat, n :: nat, p :: nat
  prop m <= n --> divides (p ^ m) (p ^ n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] divides (p ^ m) (p ^ n)
  → rewrite target=fact less_eq_exist sym=false goal=2 facts=[1]
    #[3] ∃p. n = m + p
  elim d goal=2 facts=[3]
    #[4] _VAR d
    #[5] n = m + d
    #[6] divides (p ^ m) (p ^ n)
  ← rewrite source=prev goal=6 facts=[5]
    #[7] divides (p ^ m) (p ^ (m + d))
  ← rewrite nat_power_add sym=false goal=7
    #[8] divides (p ^ m) (p ^ m * p ^ d)
  ← rewrite divides_def sym=false goal=8
    #[9] ∃k. p ^ m * p ^ d = p ^ m * k
  ← inst "p ^ d" goal=9
    #[10] p ^ m * p ^ d = p ^ m * p ^ d
  ← rule eq_refl goal=10
    #[11] p ^ m * p ^ d = p ^ m * p ^ d
qed

theorem divides_exp_le
  fixes m :: nat, n :: nat, p :: nat
  prop 2 <= p --> divides (p ^ m) (p ^ n) <--> m <= n
  [hint_backward]
proof
  ← intro goal=0
    #[1] 2 ≤ p
    #[2] divides (p ^ m) (p ^ n) ⟷ m ≤ n
  ← rule iffI goal=2
    #[3] divides (p ^ m) (p ^ n) ⟶ m ≤ n
    #[4] m ≤ n ⟶ divides (p ^ m) (p ^ n)
  ← intro goal=3
    #[5] divides (p ^ m) (p ^ n)
    #[6] m ≤ n
  → forward divides_le goal=6 facts=[5]
    #[7] p ^ m ≤ p ^ n ∨ p ^ n = 0
  ← rule disjE goal=6 facts=[7]
    #[8] p ^ m ≤ p ^ n ⟶ m ≤ n
    #[9] p ^ n = 0 ⟶ m ≤ n
  ← intro goal=8
    #[10] p ^ m ≤ p ^ n
    #[11] m ≤ n
  ← rule contrapositive goal=11 facts=[10]
    #[12] ¬(m ≤ n) ⟶ ¬(p ^ m ≤ p ^ n)
  ← intro goal=12
    #[13] ¬(m ≤ n)
    #[14] ¬(p ^ m ≤ p ^ n)
  ← rewrite not_le sym=false goal=14
    #[15] p ^ n < p ^ m
  → rewrite target=fact not_le sym=false goal=15 facts=[13]
    #[16] n < m
  ← rewrite lt_exp sym=false goal=15
    #[17] 2 ≤ p ∧ n < m ∨ p = 0 ∧ ¬(n = 0) ∧ m = 0
  ← rule disjI1 goal=17
    #[18] 2 ≤ p ∧ n < m
  ← rule conjI goal=18
  ← intro goal=9
    #[19] p ^ n = 0
    #[20] m ≤ n
  → rewrite target=fact exp_eq_0 sym=false goal=20 facts=[19]
    #[21] p = 0 ∧ ¬(n = 0)
  → forward conjD1 goal=20 facts=[21]
    #[22] p = 0
  ← z3 goal=20 facts=[1,22]
    #[23] m ≤ n
  ← intro goal=4
    #[24] m ≤ n
    #[25] divides (p ^ m) (p ^ n)
  ← rule divides_exp_le_imp goal=25 facts=[24]
    #[26] divides (p ^ m) (p ^ n)
qed

theorem divides_trivial_upperbound
  fixes n :: nat, p :: nat
  prop ~(n = 0) --> 2 <= p --> ~(divides (p ^ n) n)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 2 ≤ p
    #[3] ¬(divides (p ^ n) n)
  ← rule negI goal=3
    #[4] divides (p ^ n) n ⟶ false
  ← intro goal=4
    #[5] divides (p ^ n) n
    #[6] false
  → forward divides_le goal=6 facts=[5]
    #[7] p ^ n ≤ n ∨ n = 0
  ← rule contrapositive goal=6 facts=[7]
    #[8] ¬false ⟶ ¬(p ^ n ≤ n ∨ n = 0)
  ← intro goal=8
    #[9] ¬false
    #[10] ¬(p ^ n ≤ n ∨ n = 0)
  ← rewrite de_morgan_thm2 sym=false goal=10
    #[11] ¬(p ^ n ≤ n) ∧ ¬(n = 0)
  ← rule conjI goal=11
    #[12] ¬(p ^ n ≤ n)
  ← rewrite not_le sym=false goal=12
    #[13] n < p ^ n
  ← rule lte_trans param_m="(2::nat) ^ n" goal=13
    #[14] n < 2 ^ n
    #[15] 2 ^ n ≤ p ^ n
  ← rule lt_pow2_refl goal=14
    #[16] n < 2 ^ n
  → forward le_1_2 goal=15 facts=[1]
    #[17] 1 ≤ n
  ← rule exp_mono_le_imp goal=15
qed

theorem factorization_index
  fixes n :: nat, p :: nat
  prop ~(n = 0) --> 2 <= p --> (?k::nat. divides (p ^ k) n & (!l. k < l --> ~(divides (p ^ l) n)))
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 2 ≤ p
    #[3] ∃k::nat. divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n))
  cut "!a. !b. (~a --> ~b) <--> (b --> a)" goal=3
    #[4] ∀a. ∀b. (¬a ⟶ ¬b) ⟷ (b ⟶ a)
  ← z3 goal=4
    #[5] ∀a. ∀b. (¬a ⟶ ¬b) ⟷ (b ⟶ a)
  ← rewrite not_le sym=true goal=3
    #[6] ∃k::nat. divides (p ^ k) n ∧ (∀l. ¬(l ≤ k) ⟶ ¬(divides (p ^ l) n))
  ← rewrite source=prev goal=6 facts=[5]
    #[7] ∃k::nat. divides (p ^ k) n ∧ (∀l. divides (p ^ l) n ⟶ l ≤ k)
  ← rewrite nat_MAX sym=true goal=7
    #[8] (∃l::nat. divides (p ^ l) n) ∧ (∃M::nat. ∀l. divides (p ^ l) n ⟶ l ≤ M)
  ← rule conjI goal=8
    #[9] ∃l::nat. divides (p ^ l) n
    #[10] ∃M::nat. ∀l. divides (p ^ l) n ⟶ l ≤ M
  ← inst "(0::nat)" goal=9
    #[11] divides (p ^ (0::nat)) n
  ← rewrite nat_nat_power_def_1 sym=false goal=11
    #[12] divides 1 n
  ← rule divides_1 goal=12
    #[13] divides 1 n
  ← inst n goal=10
    #[14] ∀l. divides (p ^ l) n ⟶ l ≤ n
  ← intro x goal=14
    #[15] _VAR x
    #[16] divides (p ^ x) n
    #[17] x ≤ n
  → forward divides_le goal=17 facts=[16]
    #[18] p ^ x ≤ n ∨ n = 0
  ← rule disjE goal=17 facts=[18]
    #[19] p ^ x ≤ n ⟶ x ≤ n
    #[20] n = 0 ⟶ x ≤ n
  ← intro goal=19
    #[21] p ^ x ≤ n
    #[22] x ≤ n
  ← rule less_eq_trans param_m="(2::nat) ^ x" goal=22
    #[23] x ≤ 2 ^ x
    #[24] 2 ^ x ≤ n
  ← rule lt_imp_le goal=23
    #[25] x < 2 ^ x
  ← rule lt_pow2_refl goal=25
    #[26] x < 2 ^ x
  ← rule less_eq_trans param_m="p ^ x" goal=24
    #[27] 2 ^ x ≤ p ^ x
  ← rule exp_mono_le_imp goal=27
  ← intro goal=20
    #[28] n = 0
    #[29] x ≤ n
  ← rule negE_gen goal=29 facts=[1,28]
    #[30] x ≤ n
qed

theorem divides_fact
  fixes n :: nat, p :: nat
  prop 1 <= p --> p <= n --> divides p (fact n)
  [hint_backward,hint_backward1]

theorem divides_2
  fixes n :: nat
  prop divides 2 n <--> even n
  [hint_rewrite]
proof
  ← rewrite divides_def sym=false goal=0
    #[1] (∃k. n = 2 * k) ⟷ even n
  ← rewrite even_exists sym=false goal=1
qed

theorem divides_rexp_Suc
  fixes n :: nat, x :: nat, y :: nat
  prop divides x y --> divides x (y ^ Suc n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides x y
    #[2] divides x (y ^ Suc n)
  ← rewrite nat_nat_power_def_2 sym=false goal=2
    #[3] divides x (y * y ^ n)
  ← rule divides_rmul goal=3
qed

theorem divides_rexp
  fixes n :: nat, x :: nat, y :: nat
  prop divides x y --> ~(n = 0) --> divides x (y ^ n)
  [hint_backward,hint_backward1]

theorem finite_divisors
  fixes n :: nat
  prop ~(n = 0) --> finite ({d. divides d n})
  [hint_backward]

theorem finite_special_divisors
  fixes P :: nat => bool, n :: nat
  prop ~(n = 0) --> finite ({d. P d & divides d n})
  [hint_backward]

theorem divides_eq
  fixes m :: nat, n :: nat
  prop m = n <--> (!d. divides d m <--> divides d n)
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] m = n ⟶ (∀d. divides d m ⟷ divides d n)
    #[2] (∀d. divides d m ⟷ divides d n) ⟶ m = n
  ← intro goal=1
    #[3] m = n
    #[4] ∀d. divides d m ⟷ divides d n
  ← intro d goal=4
    #[5] _VAR d
    #[6] divides d m ⟷ divides d n
  ← rewrite source=prev goal=6 facts=[3]
  ← intro goal=2
    #[7] ∀d. divides d m ⟷ divides d n
    #[8] m = n
  ← rule divides_antisym goal=8
    #[9] divides m n
    #[10] divides n m
  → rewrite target=fact eq_sym_eq sym=false goal=9 facts=[7]
    #[11] ∀d. divides d n ⟷ divides d m
  ← rewrite source=prev goal=9 facts=[11]
    #[12] divides m m
  ← rule divides_self goal=12
    #[13] divides m m
  ← rewrite source=prev goal=10 facts=[7]
    #[14] divides n n
  ← rule divides_self goal=14
    #[15] divides n n
qed

theorem multiples_eq
  fixes m :: nat, n :: nat
  prop m = n <--> (!d. divides m d <--> divides n d)
proof
  ← rule iffI goal=0
    #[1] m = n ⟶ (∀d. divides m d ⟷ divides n d)
    #[2] (∀d. divides m d ⟷ divides n d) ⟶ m = n
  ← intro goal=1
    #[3] m = n
    #[4] ∀d. divides m d ⟷ divides n d
  ← intro d goal=4
    #[5] _VAR d
    #[6] divides m d ⟷ divides n d
  ← rewrite source=prev goal=6 facts=[3]
  ← intro goal=2
    #[7] ∀d. divides m d ⟷ divides n d
    #[8] m = n
  ← rule divides_antisym goal=8
    #[9] divides m n
    #[10] divides n m
  ← rewrite source=prev goal=9 facts=[7]
    #[11] divides n n
  ← rule divides_self goal=11
    #[12] divides n n
  → rewrite target=fact eq_sym_eq sym=false goal=10 facts=[7]
    #[13] ∀d. divides n d ⟷ divides m d
  ← rewrite source=prev goal=10 facts=[13]
    #[14] divides m m
  ← rule divides_self goal=14
    #[15] divides m m
qed

theorem ind_euclid
  fixes P :: nat => nat => bool
  prop (!a. !b. P a b <--> P b a) --> (!a. P a 0) --> (!a. !b. P a b --> P a (a + b)) --> (!a. !b. P a b)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ∀a. ∀b. P a b ⟷ P b a
    #[2] ∀a. P a 0
    #[3] ∀a. ∀b. P a b ⟶ P a (a + b)
    #[4] ∀a. ∀b. P a b
  cut "!n. !a. !b. (a + b = n) --> P a b" goal=4
    #[5] ∀n. ∀a. ∀b. a + b = n ⟶ P a b
  ← rule nat_WF goal=5
    #[6] ∀n. (∀m. m < n ⟶ (∀a. ∀b. a + b = m ⟶ P a b)) ⟶ (∀a. ∀b. a + b = n ⟶ P a b)
  ← intro n goal=6
    #[7] _VAR n
    #[8] ∀m. m < n ⟶ (∀a. ∀b. a + b = m ⟶ P a b)
    #[9] ∀a. ∀b. a + b = n ⟶ P a b
  ← intro a,b goal=9
    #[10] _VAR a
    #[11] _VAR b
    #[12] a + b = n
    #[13] P a b
  → forward lt_cases param_m=a param_n=b goal=13
    #[14] a < b ∨ b < a ∨ a = b
  ← rule disjE goal=13 facts=[14]
    #[15] a < b ⟶ P a b
    #[16] b < a ∨ a = b ⟶ P a b
  ← intro goal=15
    #[17] a < b
    #[18] P a b
  → forward lt_imp_le goal=18 facts=[17]
    #[19] a ≤ b
  → forward sub_add goal=18 facts=[19]
    #[20] b - a + a = b
  → rewrite target=fact eq_sym_eq sym=false goal=18 facts=[20]
    #[21] b = b - a + a
  ← rewrite source=prev goal=18 facts=[21]
    #[22] P a (b - a + a)
  cut "a < b ⟶ a = 0 ∨ a + (b - a) < a + b" goal=22
    #[23] a < b ⟶ a = 0 ∨ a + (b - a) < a + b
  ← z3 goal=23
    #[24] a < b ⟶ a = 0 ∨ a + (b - a) < a + b
  → forward goal=22 facts=[24,17]
    #[25] a = 0 ∨ a + (b - a) < a + b
  ← rule disjE goal=22 facts=[25]
    #[26] a = 0 ⟶ P a (b - a + a)
    #[27] a + (b - a) < a + b ⟶ P a (b - a + a)
  ← intro goal=26
    #[28] a = 0
    #[29] P a (b - a + a)
  ← rewrite source=prev goal=29 facts=[28]
    #[30] P 0 (b - 0 + 0)
  ← rewrite source=prev goal=30 facts=[1]
    #[31] P (b - 0 + 0) 0
  ← apply_prev goal=31 facts=[2]
    #[32] P (b - 0 + 0) 0
  ← intro goal=27
    #[33] a + (b - a) < a + b
    #[34] P a (b - a + a)
  ← rewrite add_comm sym=false goal=34
    #[35] P a (a + (b - a))
  ← apply_prev goal=35 facts=[3]
    #[36] P a (b - a)
  → rewrite target=fact source=prev goal=36 facts=[12,33]
    #[37] a + (b - a) < n
  → forward goal=36 facts=[8,37]
    #[38] ∀a1. ∀b1. a1 + b1 = a + (b - a) ⟶ P a1 b1
  ← apply_prev goal=36 facts=[38]
    #[39] a + (b - a) = a + (b - a)
  ← rule eq_refl goal=39
    #[40] a + (b - a) = a + (b - a)
  ← intro goal=16
    #[41] b < a ∨ a = b
    #[42] P a b
  ← rule disjE goal=42 facts=[41]
    #[43] b < a ⟶ P a b
    #[44] a = b ⟶ P a b
  ← intro goal=43
    #[45] b < a
    #[46] P a b
  → forward lt_imp_le goal=46 facts=[45]
    #[47] b ≤ a
  → forward sub_add goal=46 facts=[47]
    #[48] a - b + b = a
  → rewrite target=fact eq_sym_eq sym=false goal=46 facts=[48]
    #[49] a = a - b + b
  ← rewrite source=prev goal=46 facts=[49]
    #[50] P (a - b + b) b
  cut "b < a ⟶ b = 0 ∨ b + (a - b) < b + a" goal=50
    #[51] b < a ⟶ b = 0 ∨ b + (a - b) < b + a
  ← z3 goal=51
    #[52] b < a ⟶ b = 0 ∨ b + (a - b) < b + a
  → forward goal=50 facts=[52,45]
    #[53] b = 0 ∨ b + (a - b) < b + a
  ← rule disjE goal=50 facts=[53]
    #[54] b = 0 ⟶ P (a - b + b) b
    #[55] b + (a - b) < b + a ⟶ P (a - b + b) b
  ← intro goal=54
    #[56] b = 0
    #[57] P (a - b + b) b
  ← rewrite source=prev goal=57 facts=[56]
    #[58] P (a - 0 + 0) 0
  ← apply_prev goal=58 facts=[2]
    #[59] P (a - 0 + 0) 0
  ← intro goal=55
    #[60] b + (a - b) < b + a
    #[61] P (a - b + b) b
  ← rewrite add_comm sym=false goal=61
    #[62] P (b + (a - b)) b
  → rewrite target=fact add_comm sym=false goal=62 facts=[60]
    #[63] a - b + b < a + b
  → rewrite target=fact source=prev goal=62 facts=[12,63]
    #[64] a - b + b < n
  ← rewrite add_comm sym=false goal=62
  → rewrite target=fact add_comm sym=false goal=61 facts=[3]
    #[65] ∀a. ∀b. P a b ⟶ P a (b + a)
  ← rewrite source=prev goal=61 facts=[1]
    #[66] P b (a - b + b)
  ← apply_prev goal=66 facts=[65]
    #[67] P b (a - b)
  → forward goal=67 facts=[8,64]
    #[68] ∀a1. ∀b1. a1 + b1 = a - b + b ⟶ P a1 b1
  ← apply_prev goal=67 facts=[68]
    #[69] b + (a - b) = a - b + b
  nat_norm goal=69
    #[70] b + (a - b) = a - b + b
  ← intro goal=44
    #[71] a = b
    #[72] P a b
  cut "b = b + 0" goal=72
    #[73] b = b + 0
  ← rewrite add_0_right sym=false goal=73
    #[74] b = b + 0
  ← rewrite source=prev goal=72 facts=[74]
    #[75] P a (b + 0)
  ← rewrite source=prev goal=75 facts=[71]
    #[76] P b (b + 0)
  ← apply_prev goal=76 facts=[3]
    #[77] P b 0
  ← apply_prev goal=77 facts=[2]
    #[78] P b 0
  ← intro "a, b" goal=4
    #[79] P a b
  ← apply_prev param_n=a+b goal=79 facts=[5]
    #[80] a + b = a + b
  ← rule eq_refl goal=80
    #[81] a + b = a + b
qed

theorem bezout_lemma
  fixes a :: nat, b :: nat
  prop (?d. ?x. ?y. (divides d a & divides d b) & (a * x = b * y + d | b * x = a * y + d)) --> (?d. ?x. ?y. (divides d a & divides d (a + b)) & (a * x = (a + b) * y + d | (a + b) * x = a * y + d))
  [hint_backward]
proof
  ← intro goal=0
    #[1] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
    #[2] ∃d. ∃x. ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d)
  elim d,x,y goal=2 facts=[1]
    #[3] _VAR d
    #[4] _VAR x
    #[5] _VAR y
    #[6] (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
    #[7] ∃d. ∃x. ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d)
  → forward conjD1 goal=7 facts=[6]
    #[8] divides d a ∧ divides d b
  → forward conjD2 goal=7 facts=[6]
    #[9] a * x = b * y + d ∨ b * x = a * y + d
  → forward conjD1 goal=7 facts=[8]
    #[10] divides d a
  → forward conjD2 goal=7 facts=[8]
    #[11] divides d b
  ← inst d goal=7
    #[12] ∃x. ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d)
  ← rule disjE goal=12 facts=[9]
    #[13] a * x = b * y + d ⟶ (∃x1. ∃y1. (divides d a ∧ divides d (a + b)) ∧ (a * x1 = (a + b) * y1 + d ∨ (a + b) * x1 = a * y1 + d))
    #[14] b * x = a * y + d ⟶ (∃x1. ∃y1. (divides d a ∧ divides d (a + b)) ∧ (a * x1 = (a + b) * y1 + d ∨ (a + b) * x1 = a * y1 + d))
  ← intro goal=13
    #[15] a * x = b * y + d
    #[16] ∃x. ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d)
  ← inst x+y goal=16
    #[17] ∃y1. (divides d a ∧ divides d (a + b)) ∧ (a * (x + y) = (a + b) * y1 + d ∨ (a + b) * (x + y) = a * y1 + d)
  ← inst y goal=17
    #[18] (divides d a ∧ divides d (a + b)) ∧ (a * (x + y) = (a + b) * y + d ∨ (a + b) * (x + y) = a * y + d)
  ← rule conjI goal=18
    #[19] divides d a ∧ divides d (a + b)
    #[20] a * (x + y) = (a + b) * y + d ∨ (a + b) * (x + y) = a * y + d
  ← rule conjI goal=19
    #[21] divides d (a + b)
  ← rule divides_sum goal=21
  ← rule disjI1 goal=20
    #[22] a * (x + y) = (a + b) * y + d
  ← rewrite distrib_l sym=false goal=22
    #[23] a * x + a * y = (a + b) * y + d
  ← rewrite source=prev goal=23 facts=[15]
    #[24] b * y + d + a * y = (a + b) * y + d
  nat_norm goal=24
    #[25] b * y + d + a * y = (a + b) * y + d
  ← intro goal=14
    #[26] b * x = a * y + d
    #[27] ∃x. ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d)
  ← inst x goal=27
    #[28] ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d)
  ← inst x+y goal=28
    #[29] (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * (x + y) + d ∨ (a + b) * x = a * (x + y) + d)
  ← rule conjI goal=29
    #[30] divides d a ∧ divides d (a + b)
    #[31] a * x = (a + b) * (x + y) + d ∨ (a + b) * x = a * (x + y) + d
  ← rule conjI goal=30
    #[32] divides d (a + b)
  ← rule divides_sum goal=32
  ← rule disjI2 goal=31
    #[33] (a + b) * x = a * (x + y) + d
  ← rewrite distrib_r sym=false goal=33
    #[34] a * x + b * x = a * (x + y) + d
  ← rewrite source=prev goal=34 facts=[26]
    #[35] a * x + (a * y + d) = a * (x + y) + d
  nat_norm goal=35
    #[36] a * x + (a * y + d) = a * (x + y) + d
qed

theorem bezout_add
  fixes a :: nat, b :: nat
  prop ?d. ?x. ?y. (divides d a & divides d b) & (a * x = b * y + d | b * x = a * y + d)
  [hint_backward]
proof
  → forward ind_euclid param_P="(%a. %b. (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)))" goal=0
    #[1] (∀a. ∀b. (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)) ⟷ (∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d))) ⟶ (∀a. ∃d. ∃x. ∃y. (divides d a ∧ divides d 0) ∧ (a * x = 0 * y + d ∨ 0 * x = a * y + d)) ⟶ (∀a. ∀b. (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)) ⟶ (∃d. ∃x. ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d))) ⟶ (∀a. ∀b. ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d))
  cut "!a. !b. ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)" goal=0
    #[2] ∀a. ∀b. ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
  ← apply_prev goal=2 facts=[1]
    #[3] ∀a. ∀b. (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)) ⟷ (∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d))
    #[4] ∀a. ∃d. ∃x. ∃y. (divides d a ∧ divides d 0) ∧ (a * x = 0 * y + d ∨ 0 * x = a * y + d)
    #[5] ∀a. ∀b. (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)) ⟶ (∃d. ∃x. ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d))
  ← intro "a, b" goal=3
    #[6] _VAR a
    #[7] _VAR b
    #[8] (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)) ⟷ (∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d))
  ← rule iffI goal=8
    #[9] (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)) ⟶ (∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d))
    #[10] (∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d)) ⟶ (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d))
  ← intro goal=9
    #[11] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
    #[12] ∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d)
  elim d,x,y goal=12 facts=[11]
    #[13] _VAR d
    #[14] _VAR x
    #[15] _VAR y
    #[16] (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
    #[17] ∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d)
  ← inst d goal=17
    #[18] ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d)
  ← inst x goal=18
    #[19] ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d)
  ← inst y goal=19
    #[20] (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d)
  → forward conjD1 goal=20 facts=[16]
    #[21] divides d a ∧ divides d b
  → forward conjD2 goal=20 facts=[16]
    #[22] a * x = b * y + d ∨ b * x = a * y + d
  → forward conjD1 goal=20 facts=[21]
    #[23] divides d a
  → forward conjD2 goal=20 facts=[21]
    #[24] divides d b
  ← rule conjI goal=20
    #[25] divides d b ∧ divides d a
    #[26] b * x = a * y + d ∨ a * x = b * y + d
  ← rule conjI goal=25
  ← rewrite disj_comm sym=false goal=26
  ← intro goal=10
    #[27] ∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d)
    #[28] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
  elim d,x,y goal=28 facts=[27]
    #[29] (divides d b ∧ divides d a) ∧ (b * x = a * y + d ∨ a * x = b * y + d)
    #[30] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
  ← inst d goal=30
    #[31] ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
  ← inst x goal=31
    #[32] ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
  ← inst y goal=32
    #[33] (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
  → forward conjD1 goal=33 facts=[29]
    #[34] divides d b ∧ divides d a
  → forward conjD1 goal=33 facts=[34]
    #[35] divides d b
  → forward conjD2 goal=33 facts=[34]
    #[36] divides d a
  → forward conjD2 goal=33 facts=[29]
    #[37] b * x = a * y + d ∨ a * x = b * y + d
  ← rule conjI goal=33
    #[38] divides d a ∧ divides d b
    #[39] a * x = b * y + d ∨ b * x = a * y + d
  ← rule conjI goal=38
  ← rewrite disj_comm sym=false goal=39
  ← intro a goal=4
    #[40] ∃d. ∃x. ∃y. (divides d a ∧ divides d 0) ∧ (a * x = 0 * y + d ∨ 0 * x = a * y + d)
  ← inst a goal=40
    #[41] ∃x. ∃y. (divides a a ∧ divides a 0) ∧ (a * x = 0 * y + a ∨ 0 * x = a * y + a)
  ← inst "(1::nat)" goal=41
    #[42] ∃y. (divides a a ∧ divides a 0) ∧ (a * 1 = 0 * y + a ∨ 0 * 1 = a * y + a)
  ← inst "(0::nat)" goal=42
    #[43] (divides a a ∧ divides a 0) ∧ (a * 1 = 0 * 0 + a ∨ 0 * 1 = a * 0 + a)
  ← rule conjI goal=43
    #[44] divides a a ∧ divides a 0
    #[45] a * 1 = 0 * 0 + a ∨ 0 * 1 = a * 0 + a
  ← rule conjI goal=44
    #[46] divides a a
    #[47] divides a 0
  ← rule divides_self goal=46
  ← rule divides_zero goal=47
  ← rule disjI1 goal=45
    #[48] a * 1 = 0 * 0 + a
  nat_norm goal=48
  ← intro a,b goal=5
    #[49] ∃d. ∃x. ∃y. (divides d a ∧ divides d (a + b)) ∧ (a * x = (a + b) * y + d ∨ (a + b) * x = a * y + d)
  ← rule bezout_lemma goal=49
  ← apply_prev goal=0 facts=[2]
    #[50] ∀b. ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
qed

theorem bezout
  fixes a :: nat, b :: nat
  prop ?d. ?x. ?y. (divides d a & divides d b) & (a * x - b * y = d | b * x - a * y = d)
  [hint_backward]
proof
  → forward bezout_add param_a=a param_b=b goal=0
    #[1] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
  elim d,x,y goal=0 facts=[1]
    #[2] _VAR d
    #[3] _VAR x
    #[4] _VAR y
    #[5] (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
    #[6] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x - b * y = d ∨ b * x - a * y = d)
  ← inst d goal=6
    #[7] ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x - b * y = d ∨ b * x - a * y = d)
  ← inst x goal=7
    #[8] ∃y. (divides d a ∧ divides d b) ∧ (a * x - b * y = d ∨ b * x - a * y = d)
  ← inst y goal=8
    #[9] (divides d a ∧ divides d b) ∧ (a * x - b * y = d ∨ b * x - a * y = d)
  → forward conjD1 goal=9 facts=[5]
    #[10] divides d a ∧ divides d b
  → forward conjD1 goal=9 facts=[10]
    #[11] divides d a
  → forward conjD2 goal=9 facts=[10]
    #[12] divides d b
  → forward conjD2 goal=9 facts=[5]
    #[13] a * x = b * y + d ∨ b * x = a * y + d
  ← rule conjI goal=9
    #[14] a * x - b * y = d ∨ b * x - a * y = d
  ← rule disjE goal=14 facts=[13]
    #[15] a * x = b * y + d ⟶ a * x - b * y = d ∨ b * x - a * y = d
    #[16] b * x = a * y + d ⟶ a * x - b * y = d ∨ b * x - a * y = d
  ← intro goal=15
    #[17] a * x = b * y + d
    #[18] a * x - b * y = d ∨ b * x - a * y = d
  ← rule disjI1 goal=18
    #[19] a * x - b * y = d
  ← rewrite source=prev goal=19 facts=[17]
    #[20] b * y + d - b * y = d
  ← rewrite nat_plus_minus_2 sym=false goal=20
    #[21] b * y + d - b * y = d
  ← intro goal=16
    #[22] b * x = a * y + d
    #[23] a * x - b * y = d ∨ b * x - a * y = d
  ← rule disjI2 goal=23
    #[24] b * x - a * y = d
  ← rewrite source=prev goal=24 facts=[22]
    #[25] a * y + d - a * y = d
  ← rewrite nat_plus_minus_2 sym=false goal=25
    #[26] a * y + d - a * y = d
qed

theorem bezout_add_strong
  fixes a :: nat, b :: nat
  prop ~(a = 0) --> (?d. ?x. ?y. (divides d a & divides d b) & a * x = b * y + d)
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(a = 0)
    #[2] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  → forward bezout_add param_a=a param_b=b goal=2
    #[3] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
  elim d,x,y goal=2 facts=[3]
    #[4] _VAR d
    #[5] _VAR x
    #[6] _VAR y
    #[7] (divides d a ∧ divides d b) ∧ (a * x = b * y + d ∨ b * x = a * y + d)
    #[8] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  → forward conjD1 goal=8 facts=[7]
    #[9] divides d a ∧ divides d b
  → forward conjD1 goal=8 facts=[9]
    #[10] divides d a
  → forward conjD2 goal=8 facts=[9]
    #[11] divides d b
  → forward conjD2 goal=8 facts=[7]
    #[12] a * x = b * y + d ∨ b * x = a * y + d
  ← rule disjE goal=8 facts=[12]
    #[13] a * x = b * y + d ⟶ (∃d1. ∃x1. ∃y1. (divides d1 a ∧ divides d1 b) ∧ a * x1 = b * y1 + d1)
    #[14] b * x = a * y + d ⟶ (∃d1. ∃x1. ∃y1. (divides d1 a ∧ divides d1 b) ∧ a * x1 = b * y1 + d1)
  ← intro goal=13
    #[15] a * x = b * y + d
    #[16] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← inst d goal=16
    #[17] ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← inst x goal=17
    #[18] ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← inst y goal=18
    #[19] (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← rule conjI goal=19
  ← intro goal=14
    #[20] b * x = a * y + d
    #[21] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← cases "b=0" goal=21
    #[22] b = 0 ⟶ (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d)
    #[23] ¬(b = 0) ⟶ (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d)
  ← intro goal=22
    #[24] b = 0
    #[25] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← inst d goal=25
    #[26] ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← inst y goal=26
    #[27] ∃y1. (divides d a ∧ divides d b) ∧ a * y = b * y1 + d
  ← inst x goal=27
    #[28] (divides d a ∧ divides d b) ∧ a * y = b * x + d
  ← rule conjI goal=28
    #[29] a * y = b * x + d
  → rewrite target=fact source=prev goal=29 facts=[24,20]
    #[30] 0 * x = a * y + d
  → rewrite target=fact nat_times_def_1 sym=false goal=29 facts=[30]
    #[31] 0 = a * y + d
  → rewrite target=fact eq_sym_eq sym=false goal=29 facts=[31]
    #[32] a * y + d = 0
  → forward add_is_zero goal=29 facts=[32]
    #[33] a * y = 0 ∧ d = 0
  → forward conjD1 goal=29 facts=[33]
    #[34] a * y = 0
  → forward conjD2 goal=29 facts=[33]
    #[35] d = 0
  ← rewrite source=prev goal=29 facts=[24]
    #[36] a * y = 0 * x + d
  ← rewrite source=prev goal=36 facts=[34]
    #[37] 0 = 0 * x + d
  ← rewrite source=prev goal=37 facts=[35]
    #[38] 0 = 0 * x + 0
  nat_norm goal=38
    #[39] 0 = 0 * x + 0
  ← intro goal=23
    #[40] ¬(b = 0)
    #[41] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  → forward divides_le goal=41 facts=[11]
    #[42] d ≤ b ∨ b = 0
  ← rule disjE goal=41 facts=[42]
    #[43] d ≤ b ⟶ (∃d1. ∃x. ∃y. (divides d1 a ∧ divides d1 b) ∧ a * x = b * y + d1)
  ← intro goal=43
    #[44] d ≤ b
    #[45] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  → rewrite target=fact le_lt sym=false goal=45 facts=[44]
    #[46] d < b ∨ d = b
  ← rule disjE goal=45 facts=[46]
    #[47] d < b ⟶ (∃d1. ∃x. ∃y. (divides d1 a ∧ divides d1 b) ∧ a * x = b * y + d1)
    #[48] d = b ⟶ (∃d1. ∃x. ∃y. (divides d1 a ∧ divides d1 b) ∧ a * x = b * y + d1)
  ← intro goal=47
    #[49] d < b
    #[50] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← cases "x=0" goal=50
    #[51] x = 0 ⟶ (∃d. ∃x1. ∃y. (divides d a ∧ divides d b) ∧ a * x1 = b * y + d)
    #[52] ¬(x = 0) ⟶ (∃d. ∃x1. ∃y. (divides d a ∧ divides d b) ∧ a * x1 = b * y + d)
  ← intro goal=51
    #[53] x = 0
    #[54] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  → rewrite target=fact source=prev goal=54 facts=[53,20]
    #[55] b * 0 = a * y + d
  → rewrite target=fact mult_0_right sym=false goal=54 facts=[55]
    #[56] 0 = a * y + d
  → rewrite target=fact eq_sym_eq sym=false goal=54 facts=[56]
    #[57] a * y + d = 0
  → forward add_is_zero goal=54 facts=[57]
    #[58] a * y = 0 ∧ d = 0
  ← inst d goal=54
    #[59] ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← inst y goal=59
    #[60] ∃y1. (divides d a ∧ divides d b) ∧ a * y = b * y1 + d
  ← inst x goal=60
    #[61] (divides d a ∧ divides d b) ∧ a * y = b * x + d
  ← rule conjI goal=61
    #[62] a * y = b * x + d
  → forward conjD2 goal=62 facts=[58]
    #[63] d = 0
  ← rewrite source=prev goal=62 facts=[63]
    #[64] a * y = b * x + 0
  → rewrite target=fact source=prev goal=64 facts=[63,20]
    #[65] b * x = a * y + 0
  → rewrite target=fact add_0_right sym=false goal=64 facts=[65]
    #[66] b * x = a * y
  ← rewrite add_0_right sym=false goal=64
    #[67] a * y = b * x
  ← rewrite eq_sym_eq sym=false goal=67
  ← intro goal=52
    #[68] ¬(x = 0)
    #[69] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  cut "∀m. ∀n. m = n ⟶ (b - 1) * m + d = (b - 1) * n + d" goal=69
    #[70] ∀m. ∀n. m = n ⟶ (b - 1) * m + d = (b - 1) * n + d
  ← z3 goal=70
    #[71] ∀m. ∀n. m = n ⟶ (b - 1) * m + d = (b - 1) * n + d
  → forward goal=69 facts=[71,20]
    #[72] (b - 1) * (b * x) + d = (b - 1) * (a * y + d) + d
  → rewrite target=fact distrib_l sym=false goal=69 facts=[72]
    #[73] (b - 1) * (b * x) + d = (b - 1) * (a * y) + (b - 1) * d + d
  → rewrite target=fact add_assoc sym=false goal=69 facts=[73]
    #[74] (b - 1) * (b * x) + d = (b - 1) * (a * y) + ((b - 1) * d + d)
  cut "((b - 1) * d + d) = (b-1+1)*d" goal=69
    #[75] (b - 1) * d + d = (b - 1 + 1) * d
  nat_norm goal=75
    #[76] (b - 1) * d + d = (b - 1 + 1) * d
  → rewrite target=fact source=prev goal=69 facts=[76,74]
    #[77] (b - 1) * (b * x) + d = (b - 1) * (a * y) + (b - 1 + 1) * d
  cut "(b - 1 + 1) = b" goal=69
    #[78] b - 1 + 1 = b
  ← z3 goal=78 facts=[40]
    #[79] b - 1 + 1 = b
  → rewrite target=fact source=prev goal=69 facts=[79,77]
    #[80] (b - 1) * (b * x) + d = (b - 1) * (a * y) + b * d
  ← inst d goal=69
    #[81] ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← inst "y * (b - 1)" goal=81
    #[82] ∃y1. (divides d a ∧ divides d b) ∧ a * (y * (b - 1)) = b * y1 + d
  ← inst "(b - 1) * x - d" goal=82
    #[83] (divides d a ∧ divides d b) ∧ a * (y * (b - 1)) = b * ((b - 1) * x - d) + d
  ← rule conjI goal=83
    #[84] a * (y * (b - 1)) = b * ((b - 1) * x - d) + d
  cut "!a::nat. !b. !c. !d. a + b = c + d --> d <= a --> c = a - d + b" goal=84
    #[85] ∀a::nat. ∀b. ∀c. ∀d. a + b = c + d ⟶ d ≤ a ⟶ c = a - d + b
  ← z3 goal=85
    #[86] ∀a::nat. ∀b. ∀c. ∀d. a + b = c + d ⟶ d ≤ a ⟶ c = a - d + b
  → forward goal=84 facts=[86,80]
    #[87] b * d ≤ (b - 1) * (b * x) ⟶ (b - 1) * (a * y) = (b - 1) * (b * x) - b * d + d
  cut " (b - 1) * (b * x) =  b * (b - 1) * x" goal=84
    #[88] (b - 1) * (b * x) = b * (b - 1) * x
  ← z3 goal=88
    #[89] (b - 1) * (b * x) = b * (b - 1) * x
  → rewrite target=fact source=prev goal=84 facts=[89,87]
    #[90] b * d ≤ b * (b - 1) * x ⟶ (b - 1) * (a * y) = b * (b - 1) * x - b * d + d
  cut "b * d ≤ b * (b - 1) * x" goal=84 facts=[90]
    #[91] b * d ≤ b * (b - 1) * x
  ← rewrite mult_assoc sym=false goal=91
    #[92] b * d ≤ b * ((b - 1) * x)
  ← rule le_mult2 goal=92
    #[93] b ≤ b
    #[94] d ≤ (b - 1) * x
  ← rule less_eq_refl goal=93
    #[95] b ≤ b
  cut "d = d * 1" goal=94
    #[96] d = d * 1
  ← rewrite mult_1_right sym=false goal=96
    #[97] d = d * 1
  ← rewrite source=prev goal=94 facts=[97]
    #[98] d * 1 ≤ (b - 1) * x
  ← rule le_mult2 goal=98
    #[99] d ≤ b - 1
    #[100] 1 ≤ x
  ← z3 goal=99 facts=[49]
    #[101] d ≤ b - 1
  ← rule le_1_2 goal=100 facts=[68]
    #[102] 1 ≤ x
  → forward goal=84 facts=[90,91]
    #[103] (b - 1) * (a * y) = b * (b - 1) * x - b * d + d
  cut "(b - 1) * (a * y) = a * (y * (b - 1))" goal=84 facts=[103]
    #[104] (b - 1) * (a * y) = a * (y * (b - 1))
  nat_norm goal=104
    #[105] (b - 1) * (a * y) = a * (y * (b - 1))
  → rewrite target=fact source=prev goal=84 facts=[105,103]
    #[106] a * (y * (b - 1)) = b * (b - 1) * x - b * d + d
  ← rewrite source=prev goal=84 facts=[106]
    #[107] b * (b - 1) * x - b * d + d = b * ((b - 1) * x - d) + d
  ← z3 goal=107
    #[108] b * (b - 1) * x - b * d + d = b * ((b - 1) * x - d) + d
  ← intro goal=48
    #[109] d = b
    #[110] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  ← inst b goal=110
    #[111] ∃x. ∃y. (divides b a ∧ divides b b) ∧ a * x = b * y + b
  ← inst b goal=111
    #[112] ∃y. (divides b a ∧ divides b b) ∧ a * b = b * y + b
  ← inst a-1 goal=112
    #[113] (divides b a ∧ divides b b) ∧ a * b = b * (a - 1) + b
  ← rule conjI goal=113
    #[114] divides b a ∧ divides b b
    #[115] a * b = b * (a - 1) + b
  ← rule conjI goal=114
    #[116] divides b a
    #[117] divides b b
  → rewrite target=fact source=prev goal=116 facts=[109,10]
    #[118] divides b a
  ← rule divides_self goal=117
    #[119] divides b b
  ← z3 goal=115 facts=[1]
    #[120] a * b = b * (a - 1) + b
qed

def gcd :: nat ⇒ nat ⇒ nat = gcd m n = (SOME k. divides k m ∧ divides k n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a k)) [hint_rewrite]

theorem gcd
  fixes m :: nat, n :: nat
  prop divides (gcd m n) m & divides (gcd m n) n & (!a. divides a m --> divides a n --> divides a (gcd m n))
  [hint_backward]
proof
  → forward bezout param_a=m param_b=n goal=0
    #[1] ∃d. ∃x. ∃y. (divides d m ∧ divides d n) ∧ (m * x - n * y = d ∨ n * x - m * y = d)
  elim d,x,y goal=0 facts=[1]
    #[2] _VAR d
    #[3] _VAR x
    #[4] _VAR y
    #[5] (divides d m ∧ divides d n) ∧ (m * x - n * y = d ∨ n * x - m * y = d)
    #[6] divides (gcd m n) m ∧ divides (gcd m n) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (gcd m n))
  → forward conjD1 goal=6 facts=[5]
    #[7] divides d m ∧ divides d n
  → forward conjD2 goal=6 facts=[5]
    #[8] m * x - n * y = d ∨ n * x - m * y = d
  ← rewrite gcd_def sym=false goal=6
    #[9] divides (SOME k. divides k m ∧ divides k n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a k)) m ∧ divides (SOME k. divides k m ∧ divides k n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a k)) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (SOME k. divides k m ∧ divides k n ∧ (∀a1. divides a1 m ⟶ divides a1 n ⟶ divides a1 k)))
  → forward someI param_P="(%d. divides d m ∧ divides d n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a d))" param_x=d goal=9
    #[10] divides d m ∧ divides d n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a d) ⟶ divides (SOME x1. divides x1 m ∧ divides x1 n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a x1)) m ∧ divides (SOME x1. divides x1 m ∧ divides x1 n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a x1)) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (SOME x1. divides x1 m ∧ divides x1 n ∧ (∀a1. divides a1 m ⟶ divides a1 n ⟶ divides a1 x1)))
  ← apply_prev goal=9 facts=[10]
    #[11] divides d m ∧ divides d n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a d)
  ← rewrite conj_assoc sym=false goal=11
    #[12] (divides d m ∧ divides d n) ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a d)
  ← rule conjI goal=12
    #[13] ∀a. divides a m ⟶ divides a n ⟶ divides a d
  ← intro a goal=13
    #[14] _VAR a
    #[15] divides a m
    #[16] divides a n
    #[17] divides a d
  → rewrite target=fact eq_sym_eq sym=false goal=17 facts=[8]
    #[18] d = m * x - n * y ∨ d = n * x - m * y
  ← rule disjE goal=17 facts=[18]
    #[19] d = m * x - n * y ⟶ divides a d
    #[20] d = n * x - m * y ⟶ divides a d
  ← intro goal=19
    #[21] d = m * x - n * y
    #[22] divides a d
  ← rewrite source=prev goal=22 facts=[21]
    #[23] divides a (m * x - n * y)
  ← rule divides_sub goal=23
    #[24] divides a (m * x)
    #[25] divides a (n * y)
  ← rule divides_rmul goal=24
  ← rule divides_rmul goal=25
  ← intro goal=20
    #[26] d = n * x - m * y
    #[27] divides a d
  ← rewrite source=prev goal=27 facts=[26]
    #[28] divides a (n * x - m * y)
  ← rule divides_sub goal=28
    #[29] divides a (n * x)
    #[30] divides a (m * y)
  ← rule divides_rmul goal=29
  ← rule divides_rmul goal=30
qed

theorem gcd_divide1
  fixes m :: nat, n :: nat
  prop divides (gcd m n) m
  [hint_backward]
proof
  → forward gcd param_m=m param_n=n goal=0
    #[1] divides (gcd m n) m ∧ divides (gcd m n) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (gcd m n))
  ← rule conjD1 goal=0 facts=[1]
qed

theorem gcd_divides2
  fixes m :: nat, n :: nat
  prop divides (gcd m n) n
  [hint_backward]
proof
  → forward gcd param_m=m param_n=n goal=0
    #[1] divides (gcd m n) m ∧ divides (gcd m n) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (gcd m n))
  → forward conjD2 goal=0 facts=[1]
    #[2] divides (gcd m n) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (gcd m n))
  ← rule conjD1 goal=0 facts=[2]
qed

theorem gcd_is_max
  fixes a :: nat, m :: nat, n :: nat
  prop divides a m --> divides a n --> divides a (gcd m n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides a m
    #[2] divides a n
    #[3] divides a (gcd m n)
  → forward gcd param_m=m param_n=n goal=3
    #[4] divides (gcd m n) m ∧ divides (gcd m n) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (gcd m n))
  → forward conjD2 goal=3 facts=[4]
    #[5] divides (gcd m n) n ∧ (∀a. divides a m ⟶ divides a n ⟶ divides a (gcd m n))
  → forward conjD2 goal=3 facts=[5]
    #[6] ∀a. divides a m ⟶ divides a n ⟶ divides a (gcd m n)
  ← apply_prev goal=3 facts=[6]
qed

theorem divides_gcd
  fixes a :: nat, b :: nat, d :: nat
  prop divides d (gcd a b) <--> divides d a & divides d b
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] divides d (gcd a b) ⟶ divides d a ∧ divides d b
    #[2] divides d a ∧ divides d b ⟶ divides d (gcd a b)
  ← intro goal=1
    #[3] divides d (gcd a b)
    #[4] divides d a ∧ divides d b
  ← rule conjI goal=4
    #[5] divides d a
    #[6] divides d b
  ← rule divides_trans goal=5 facts=[3]
    #[7] divides (gcd a b) a
  ← rule gcd_divide1 goal=7
    #[8] divides (gcd a b) a
  ← rule divides_trans goal=6 facts=[3]
    #[9] divides (gcd a b) b
  ← rule gcd_divides2 goal=9
    #[10] divides (gcd a b) b
  ← intro goal=2
    #[11] divides d a ∧ divides d b
    #[12] divides d (gcd a b)
  ← rule gcd_is_max goal=12
    #[13] divides d a
    #[14] divides d b
  ← rule conjD1 goal=13 facts=[11]
  ← rule conjD2 goal=14 facts=[11]
qed

theorem gcd_unique
  fixes a :: nat, b :: nat, d :: nat
  prop (divides d a & divides d b) & (!e. divides e a --> divides e b --> divides e d) <--> d = gcd a b
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] (divides d a ∧ divides d b) ∧ (∀e. divides e a ⟶ divides e b ⟶ divides e d) ⟶ d = gcd a b
    #[2] d = gcd a b ⟶ (divides d a ∧ divides d b) ∧ (∀e. divides e a ⟶ divides e b ⟶ divides e d)
  ← intro goal=1
    #[3] (divides d a ∧ divides d b) ∧ (∀e. divides e a ⟶ divides e b ⟶ divides e d)
    #[4] d = gcd a b
  → forward conjD1 goal=4 facts=[3]
    #[5] divides d a ∧ divides d b
  → forward conjD2 goal=4 facts=[3]
    #[6] ∀e. divides e a ⟶ divides e b ⟶ divides e d
  → rewrite target=fact divides_gcd sym=true goal=4 facts=[5]
    #[7] divides d (gcd a b)
  ← rule divides_antisym goal=4
    #[8] divides (gcd a b) d
  ← apply_prev goal=8 facts=[6]
    #[9] divides (gcd a b) a
    #[10] divides (gcd a b) b
  ← rule gcd_divide1 goal=9
    #[11] divides (gcd a b) a
  ← rule gcd_divides2 goal=10
    #[12] divides (gcd a b) b
  ← intro goal=2
    #[13] d = gcd a b
    #[14] (divides d a ∧ divides d b) ∧ (∀e. divides e a ⟶ divides e b ⟶ divides e d)
  ← rewrite source=prev goal=14 facts=[13]
    #[15] (divides (gcd a b) a ∧ divides (gcd a b) b) ∧ (∀e. divides e a ⟶ divides e b ⟶ divides e (gcd a b))
  ← rule conjI goal=15
    #[16] divides (gcd a b) a ∧ divides (gcd a b) b
    #[17] ∀e. divides e a ⟶ divides e b ⟶ divides e (gcd a b)
  ← rule conjI goal=16
    #[18] divides (gcd a b) a
    #[19] divides (gcd a b) b
  ← rule gcd_divide1 goal=18
  ← rule gcd_divides2 goal=19
  ← intro e goal=17
    #[20] _VAR e
    #[21] divides e a
    #[22] divides e b
    #[23] divides e (gcd a b)
  ← rule gcd_is_max goal=23
qed

theorem gcd_equals
  fixes a :: nat, m :: nat, n :: nat
  prop divides a m --> divides a n --> (!b. divides b m --> divides b n --> divides b a) --> gcd m n = a
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides a m
    #[2] divides a n
    #[3] ∀b. divides b m ⟶ divides b n ⟶ divides b a
    #[4] gcd m n = a
  ← rewrite eq_sym_eq sym=false goal=4
    #[5] a = gcd m n
  ← rewrite gcd_unique sym=true goal=5
    #[6] (divides a m ∧ divides a n) ∧ (∀e. divides e m ⟶ divides e n ⟶ divides e a)
  ← rule conjI goal=6
    #[7] divides a m ∧ divides a n
  ← rule conjI goal=7
qed

theorem gcd_eq
  fixes u :: nat, v :: nat, x :: nat, y :: nat
  prop (!d. divides d x & divides d y <--> divides d u & divides d v) --> gcd x y = gcd u v
  [hint_backward]
proof
  ← intro goal=0
    #[1] ∀d. divides d x ∧ divides d y ⟷ divides d u ∧ divides d v
    #[2] gcd x y = gcd u v
  ← rule divides_antisym goal=2
    #[3] divides (gcd x y) (gcd u v)
    #[4] divides (gcd u v) (gcd x y)
  ← rewrite divides_gcd sym=false goal=3
    #[5] divides (gcd x y) u ∧ divides (gcd x y) v
  → rewrite target=fact eq_sym_eq sym=false goal=5 facts=[1]
    #[6] ∀d. divides d u ∧ divides d v ⟷ divides d x ∧ divides d y
  ← rewrite source=prev goal=5 facts=[6]
    #[7] divides (gcd x y) x ∧ divides (gcd x y) y
  ← rule conjI goal=7
    #[8] divides (gcd x y) x
    #[9] divides (gcd x y) y
  ← rule gcd_divide1 goal=8
    #[10] divides (gcd x y) x
  ← rule gcd_divides2 goal=9
    #[11] divides (gcd x y) y
  ← rewrite divides_gcd sym=false goal=4
    #[12] divides (gcd u v) x ∧ divides (gcd u v) y
  ← rewrite source=prev goal=12 facts=[1]
    #[13] divides (gcd u v) u ∧ divides (gcd u v) v
  ← rule conjI goal=13
    #[14] divides (gcd u v) u
    #[15] divides (gcd u v) v
  ← rule gcd_divide1 goal=14
    #[16] divides (gcd u v) u
  ← rule gcd_divides2 goal=15
    #[17] divides (gcd u v) v
qed

theorem gcd_comm
  fixes m :: nat, n :: nat
  prop gcd m n = gcd n m
  [hint_rewrite,hint_backward]
proof
  ← rule gcd_equals goal=0
    #[1] divides (gcd n m) m
    #[2] divides (gcd n m) n
    #[3] ∀b. divides b m ⟶ divides b n ⟶ divides b (gcd n m)
  ← rule gcd_divides2 goal=1
  ← rule gcd_divide1 goal=2
  ← intro b goal=3
    #[4] _VAR b
    #[5] divides b m
    #[6] divides b n
    #[7] divides b (gcd n m)
  ← rule gcd_is_max goal=7
qed

theorem gcd_zero_left
  fixes n :: nat
  prop gcd 0 n = n
  [hint_rewrite]
proof
  ← rule gcd_equals goal=0
    #[1] divides n 0
    #[2] divides n n
    #[3] ∀b. divides b 0 ⟶ divides b n ⟶ divides b n
  ← rule divides_zero goal=1
  ← rule divides_self goal=2
qed

theorem gcd_zero_right
  fixes n :: nat
  prop gcd n 0 = n
  [hint_rewrite]
proof
  ← rewrite gcd_comm sym="" goal=0
    #[1] gcd 0 n = n
  ← rewrite gcd_zero_left sym=false goal=1
qed

theorem gcd_zero
  fixes m :: nat, n :: nat
  prop gcd m n = 0 <--> m = 0 & n = 0
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] gcd m n = 0 ⟶ m = 0 ∧ n = 0
    #[2] m = 0 ∧ n = 0 ⟶ gcd m n = 0
  ← intro goal=1
    #[3] gcd m n = 0
    #[4] m = 0 ∧ n = 0
  ← rule conjI goal=4
    #[5] m = 0
    #[6] n = 0
  → forward gcd_divide1 param_m=m param_n=n goal=5
    #[7] divides (gcd m n) m
  → rewrite target=fact source=prev goal=5 facts=[3,7]
    #[8] divides 0 m
  → rewrite target=fact divides_0 sym=false goal=5 facts=[8]
  → forward gcd_divides2 param_m=m param_n=n goal=6
    #[9] divides (gcd m n) n
  → rewrite target=fact source=prev goal=6 facts=[3,9]
    #[10] divides 0 n
  → rewrite target=fact divides_0 sym=false goal=6 facts=[10]
  ← intro goal=2
    #[11] m = 0 ∧ n = 0
    #[12] gcd m n = 0
  → forward conjD1 goal=12 facts=[11]
    #[13] m = 0
  → forward conjD2 goal=12 facts=[11]
    #[14] n = 0
  ← rewrite source=prev goal=12 facts=[13]
    #[15] gcd 0 n = 0
  ← rewrite gcd_zero_left sym=false goal=15
qed

theorem gcd_refl
  fixes n :: nat
  prop gcd n n = n
  [hint_rewrite]
proof
  ← rule gcd_equals goal=0
    #[1] divides n n
    #[2] ∀b. divides b n ⟶ divides b n ⟶ divides b n
  ← rule divides_self goal=1
qed

theorem gcd_1_left
  fixes n :: nat
  prop gcd 1 n = 1
  [hint_rewrite]
proof
  ← rule gcd_equals goal=0
    #[1] divides 1 1
    #[2] divides 1 n
    #[3] ∀b. divides b 1 ⟶ divides b n ⟶ divides b 1
  ← rule divides_1 goal=1
  ← rule divides_1 goal=2
qed

theorem gcd_1_right
  fixes n :: nat
  prop gcd n 1 = 1
  [hint_rewrite]
proof
  ← rewrite gcd_comm sym=false goal=0
    #[1] gcd 1 n = 1
  ← rewrite gcd_1_left sym=false goal=1
qed

theorem gcd_multiple
  fixes m :: nat, n :: nat
  prop gcd n (m * n) = n
  [hint_rewrite]
proof
  ← rule gcd_equals goal=0
    #[1] divides n n
    #[2] divides n (m * n)
    #[3] ∀b. divides b n ⟶ divides b (m * n) ⟶ divides b n
  ← rule divides_self goal=1
  ← rule divides_lmul goal=2
qed

theorem gcd_assoc
  fixes k :: nat, m :: nat, n :: nat
  prop gcd (gcd k m) n = gcd k (gcd m n)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rule gcd_equals goal=0
    #[1] divides (gcd k (gcd m n)) (gcd k m)
    #[2] divides (gcd k (gcd m n)) n
    #[3] ∀b. divides b (gcd k m) ⟶ divides b n ⟶ divides b (gcd k (gcd m n))
  ← rule gcd_is_max goal=1
    #[4] divides (gcd k (gcd m n)) k
    #[5] divides (gcd k (gcd m n)) m
  ← rule gcd_divide1 goal=4
  ← rule divides_trans param_m="gcd m n" goal=5
    #[6] divides (gcd k (gcd m n)) (gcd m n)
    #[7] divides (gcd m n) m
  ← rule gcd_divides2 goal=6
  ← rule gcd_divide1 goal=7
  ← rule divides_trans param_m="gcd m n" goal=2
    #[8] divides (gcd m n) n
  ← rule gcd_divides2 goal=8
  ← intro b goal=3
    #[9] _VAR b
    #[10] divides b (gcd k m)
    #[11] divides b n
    #[12] divides b (gcd k (gcd m n))
  ← rule gcd_is_max goal=12
    #[13] divides b k
    #[14] divides b (gcd m n)
  ← rule divides_trans goal=13 facts=[10]
    #[15] divides (gcd k m) k
  ← rule gcd_divide1 goal=15
    #[16] divides (gcd k m) k
  ← rule gcd_is_max goal=14
    #[17] divides b m
  ← rule divides_trans goal=17 facts=[10]
    #[18] divides (gcd k m) m
  ← rule gcd_divides2 goal=18
    #[19] divides (gcd k m) m
qed

theorem gcd_bazout_sum
  fixes a :: nat, b :: nat, d :: nat, x :: nat, y :: nat
  prop a * x + b * y = d --> divides (gcd a b) d
  [hint_backward]
proof
  ← intro goal=0
    #[1] a * x + b * y = d
    #[2] divides (gcd a b) d
  → rewrite target=fact eq_sym_eq sym=false goal=2 facts=[1]
    #[3] d = a * x + b * y
  ← rewrite source=prev goal=2 facts=[3]
    #[4] divides (gcd a b) (a * x + b * y)
  ← rule divides_sum goal=4
    #[5] divides (gcd a b) (a * x)
    #[6] divides (gcd a b) (b * y)
  ← rule divides_rmul goal=5
    #[7] divides (gcd a b) a
  ← rule gcd_divide1 goal=7
    #[8] divides (gcd a b) a
  ← rule divides_rmul goal=6
    #[9] divides (gcd a b) b
  ← rule gcd_divides2 goal=9
    #[10] divides (gcd a b) b
qed

theorem bezout_gcd
  fixes a :: nat, b :: nat
  prop ?x. ?y. a * x - b * y = gcd a b | b * x - a * y = gcd a b
  [hint_backward]
proof
  → forward bezout param_a=a param_b=b goal=0
    #[1] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ (a * x - b * y = d ∨ b * x - a * y = d)
  elim "d, x, y" goal=0 facts=[1]
    #[2] _VAR d
    #[3] _VAR x
    #[4] _VAR y
    #[5] (divides d a ∧ divides d b) ∧ (a * x - b * y = d ∨ b * x - a * y = d)
    #[6] ∃x. ∃y. a * x - b * y = gcd a b ∨ b * x - a * y = gcd a b
  → forward conjD1 goal=6 facts=[5]
    #[7] divides d a ∧ divides d b
  → forward conjD2 goal=6 facts=[5]
    #[8] a * x - b * y = d ∨ b * x - a * y = d
  → rewrite target=fact divides_gcd sym=true goal=6 facts=[7]
    #[9] divides d (gcd a b)
  → rewrite target=fact divides_def sym=false goal=6 facts=[9]
    #[10] ∃k. gcd a b = d * k
  elim k goal=6 facts=[10]
    #[11] _VAR k
    #[12] gcd a b = d * k
    #[13] ∃x. ∃y. a * x - b * y = gcd a b ∨ b * x - a * y = gcd a b
  ← inst "x * k" goal=13
    #[14] ∃y. a * (x * k) - b * y = gcd a b ∨ b * (x * k) - a * y = gcd a b
  ← inst "y * k" goal=14
    #[15] a * (x * k) - b * (y * k) = gcd a b ∨ b * (x * k) - a * (y * k) = gcd a b
  ← rewrite source=prev goal=15 facts=[12]
    #[16] a * (x * k) - b * (y * k) = d * k ∨ b * (x * k) - a * (y * k) = d * k
  ← rule disjE goal=16 facts=[8]
    #[17] a * x - b * y = d ⟶ a * (x * k) - b * (y * k) = d * k ∨ b * (x * k) - a * (y * k) = d * k
    #[18] b * x - a * y = d ⟶ a * (x * k) - b * (y * k) = d * k ∨ b * (x * k) - a * (y * k) = d * k
  ← intro goal=17
    #[19] a * x - b * y = d
    #[20] a * (x * k) - b * (y * k) = d * k ∨ b * (x * k) - a * (y * k) = d * k
  ← rule disjI1 goal=20
    #[21] a * (x * k) - b * (y * k) = d * k
  → rewrite target=fact eq_sym_eq sym=false goal=21 facts=[19]
    #[22] d = a * x - b * y
  ← rewrite source=prev goal=21 facts=[22]
    #[23] a * (x * k) - b * (y * k) = (a * x - b * y) * k
  ← rewrite mult_assoc sym=true goal=23
    #[24] a * x * k - b * y * k = (a * x - b * y) * k
  ← rewrite mult_comm sym=false goal=24
    #[25] k * (a * x) - k * (b * y) = k * (a * x - b * y)
  ← rewrite left_sub_distrib sym=false goal=25
    #[26] k * (a * x) - k * (b * y) = k * (a * x - b * y)
  ← intro goal=18
    #[27] b * x - a * y = d
    #[28] a * (x * k) - b * (y * k) = d * k ∨ b * (x * k) - a * (y * k) = d * k
  ← rule disjI2 goal=28
    #[29] b * (x * k) - a * (y * k) = d * k
  → rewrite target=fact eq_sym_eq sym=false goal=29 facts=[27]
    #[30] d = b * x - a * y
  ← rewrite source=prev goal=29 facts=[30]
    #[31] b * (x * k) - a * (y * k) = (b * x - a * y) * k
  ← rewrite mult_assoc sym=true goal=31
    #[32] b * x * k - a * y * k = (b * x - a * y) * k
  ← rewrite mult_comm sym=false goal=32
    #[33] k * (b * x) - k * (a * y) = k * (b * x - a * y)
  ← rewrite left_sub_distrib sym=false goal=33
    #[34] k * (b * x) - k * (a * y) = k * (b * x - a * y)
qed

theorem bezout_gcd_strong
  fixes a :: nat, b :: nat
  prop ~(a = 0) --> (?x. ?y. a * x = b * y + gcd a b)
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(a = 0)
    #[2] ∃x. ∃y. a * x = b * y + gcd a b
  → forward bezout_add_strong param_b=b goal=2 facts=[1]
    #[3] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  elim d,x,y goal=2 facts=[3]
    #[4] _VAR d
    #[5] _VAR x
    #[6] _VAR y
    #[7] (divides d a ∧ divides d b) ∧ a * x = b * y + d
    #[8] ∃x. ∃y. a * x = b * y + gcd a b
  → forward conjD1 goal=8 facts=[7]
    #[9] divides d a ∧ divides d b
  → forward conjD2 goal=8 facts=[7]
    #[10] a * x = b * y + d
  → rewrite target=fact divides_gcd sym=true goal=8 facts=[9]
    #[11] divides d (gcd a b)
  → rewrite target=fact divides_def sym=false goal=8 facts=[11]
    #[12] ∃k. gcd a b = d * k
  elim k goal=8 facts=[12]
    #[13] _VAR k
    #[14] gcd a b = d * k
    #[15] ∃x. ∃y. a * x = b * y + gcd a b
  ← rewrite source=prev goal=15 facts=[14]
    #[16] ∃x. ∃y. a * x = b * y + d * k
  ← inst x*k goal=16
    #[17] ∃y. a * (x * k) = b * y + d * k
  ← inst y*k goal=17
    #[18] a * (x * k) = b * (y * k) + d * k
  ← rewrite mult_assoc sym=true goal=18
    #[19] a * x * k = b * y * k + d * k
  ← rewrite source=prev goal=19 facts=[10]
    #[20] (b * y + d) * k = b * y * k + d * k
  ← rewrite distrib_r sym=false goal=20
    #[21] (b * y + d) * k = b * y * k + d * k
qed

theorem gcd_bezout
  fixes a :: nat, b :: nat, d :: nat
  prop (?x. ?y. a * x - b * y = d | b * x - a * y = d) <--> divides (gcd a b) d
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] (∃x. ∃y. a * x - b * y = d ∨ b * x - a * y = d) ⟶ divides (gcd a b) d
    #[2] divides (gcd a b) d ⟶ (∃x. ∃y. a * x - b * y = d ∨ b * x - a * y = d)
  ← intro goal=1
    #[3] ∃x. ∃y. a * x - b * y = d ∨ b * x - a * y = d
    #[4] divides (gcd a b) d
  elim x,y goal=4 facts=[3]
    #[5] _VAR x
    #[6] _VAR y
    #[7] a * x - b * y = d ∨ b * x - a * y = d
    #[8] divides (gcd a b) d
  ← rule disjE goal=8 facts=[7]
    #[9] a * x - b * y = d ⟶ divides (gcd a b) d
    #[10] b * x - a * y = d ⟶ divides (gcd a b) d
  ← intro goal=9
    #[11] a * x - b * y = d
    #[12] divides (gcd a b) d
  → rewrite target=fact eq_sym_eq sym=false goal=12 facts=[11]
    #[13] d = a * x - b * y
  ← rewrite source=prev goal=12 facts=[13]
    #[14] divides (gcd a b) (a * x - b * y)
  ← rule divides_sub goal=14
    #[15] divides (gcd a b) (a * x)
    #[16] divides (gcd a b) (b * y)
  ← rule divides_rmul goal=15
    #[17] divides (gcd a b) a
  ← rule gcd_divide1 goal=17
    #[18] divides (gcd a b) a
  ← rule divides_rmul goal=16
    #[19] divides (gcd a b) b
  ← rule gcd_divides2 goal=19
    #[20] divides (gcd a b) b
  ← intro goal=10
    #[21] b * x - a * y = d
    #[22] divides (gcd a b) d
  → rewrite target=fact eq_sym_eq sym=false goal=22 facts=[21]
    #[23] d = b * x - a * y
  ← rewrite source=prev goal=22 facts=[23]
    #[24] divides (gcd a b) (b * x - a * y)
  ← rule divides_sub goal=24
    #[25] divides (gcd a b) (b * x)
    #[26] divides (gcd a b) (a * y)
  ← rule divides_rmul goal=25
    #[27] divides (gcd a b) b
  ← rule gcd_divides2 goal=27
  ← rule divides_rmul goal=26
    #[28] divides (gcd a b) a
  ← rule gcd_divide1 goal=28
  ← intro goal=2
    #[29] divides (gcd a b) d
    #[30] ∃x. ∃y. a * x - b * y = d ∨ b * x - a * y = d
  → rewrite target=fact divides_def sym=false goal=30 facts=[29]
    #[31] ∃k. d = gcd a b * k
  elim k goal=30 facts=[31]
    #[32] _VAR k
    #[33] d = gcd a b * k
    #[34] ∃x. ∃y. a * x - b * y = d ∨ b * x - a * y = d
  → forward bezout_gcd param_a=a param_b=b goal=34
    #[35] ∃x. ∃y. a * x - b * y = gcd a b ∨ b * x - a * y = gcd a b
  elim x,y goal=34 facts=[35]
    #[36] a * x - b * y = gcd a b ∨ b * x - a * y = gcd a b
    #[37] ∃x. ∃y. a * x - b * y = d ∨ b * x - a * y = d
  ← inst x*k goal=37
    #[38] ∃y. a * (x * k) - b * y = d ∨ b * (x * k) - a * y = d
  ← inst "y * k" goal=38
    #[39] a * (x * k) - b * (y * k) = d ∨ b * (x * k) - a * (y * k) = d
  ← rule disjE goal=39 facts=[36]
    #[40] a * x - b * y = gcd a b ⟶ a * (x * k) - b * (y * k) = d ∨ b * (x * k) - a * (y * k) = d
    #[41] b * x - a * y = gcd a b ⟶ a * (x * k) - b * (y * k) = d ∨ b * (x * k) - a * (y * k) = d
  ← intro goal=40
    #[42] a * x - b * y = gcd a b
    #[43] a * (x * k) - b * (y * k) = d ∨ b * (x * k) - a * (y * k) = d
  ← rule disjI1 goal=43
    #[44] a * (x * k) - b * (y * k) = d
  ← rewrite source=prev goal=44 facts=[33]
    #[45] a * (x * k) - b * (y * k) = gcd a b * k
  ← rewrite mult_assoc sym=true goal=45
    #[46] a * x * k - b * y * k = gcd a b * k
  ← rewrite mult_comm sym=false goal=46
    #[47] k * (a * x) - k * (b * y) = k * gcd a b
  ← rewrite left_sub_distrib sym=true goal=47
    #[48] k * (a * x - b * y) = k * gcd a b
  ← rewrite eq_mult_lcancel sym=false goal=48
    #[49] k = 0 ∨ a * x - b * y = gcd a b
  ← rule disjI2 goal=49
  ← intro goal=41
    #[50] b * x - a * y = gcd a b
    #[51] a * (x * k) - b * (y * k) = d ∨ b * (x * k) - a * (y * k) = d
  ← rule disjI2 goal=51
    #[52] b * (x * k) - a * (y * k) = d
  ← rewrite mult_assoc sym=true goal=52
    #[53] b * x * k - a * y * k = d
  ← rewrite source=prev goal=53 facts=[33]
    #[54] b * x * k - a * y * k = gcd a b * k
  ← rewrite mult_comm sym=false goal=54
    #[55] k * (b * x) - k * (a * y) = k * gcd a b
  ← rewrite left_sub_distrib sym=true goal=55
    #[56] k * (b * x - a * y) = k * gcd a b
  ← rewrite eq_mult_lcancel sym=false goal=56
    #[57] k = 0 ∨ b * x - a * y = gcd a b
  ← rule disjI2 goal=57
qed

theorem gcd_equal_left
  fixes m :: nat, n :: nat
  prop divides m n --> gcd m n = m
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides m n
    #[2] gcd m n = m
  ← rule gcd_equals goal=2
    #[3] divides m m
    #[4] ∀b. divides b m ⟶ divides b n ⟶ divides b m
  ← rule divides_self goal=3
    #[5] divides m m
qed

theorem gcd_equal_right
  fixes m :: nat, n :: nat
  prop divides n m --> gcd m n = n
  [hint_backward]
proof
  ← intro goal=0
    #[1] divides n m
    #[2] gcd m n = n
  ← rule gcd_equals goal=2
    #[3] divides n n
    #[4] ∀b. divides b m ⟶ divides b n ⟶ divides b n
  ← rule divides_self goal=3
    #[5] divides n n
qed

theorem gcd_mult_left
  fixes k :: nat, m :: nat, n :: nat
  prop gcd (k * m) (k * n) = k * gcd m n
  [hint_rewrite]
proof
  ← rule divides_antisym goal=0
    #[1] divides (gcd (k * m) (k * n)) (k * gcd m n)
    #[2] divides (k * gcd m n) (gcd (k * m) (k * n))
  ← rewrite gcd_bezout sym=true goal=1
    #[3] ∃x. ∃y. k * m * x - k * n * y = k * gcd m n ∨ k * n * x - k * m * y = k * gcd m n
  → forward bezout_gcd param_a=m param_b=n goal=3
    #[4] ∃x. ∃y. m * x - n * y = gcd m n ∨ n * x - m * y = gcd m n
  elim x,y goal=3 facts=[4]
    #[5] _VAR x
    #[6] _VAR y
    #[7] m * x - n * y = gcd m n ∨ n * x - m * y = gcd m n
    #[8] ∃x. ∃y. k * m * x - k * n * y = k * gcd m n ∨ k * n * x - k * m * y = k * gcd m n
    #[9] divides (gcd (k * m) (k * n)) (k * gcd m n)
    #[10] divides (k * gcd m n) (gcd (k * m) (k * n))
    #[11] gcd (k * m) (k * n) = k * gcd m n
  ← inst x goal=8
    #[12] ∃y. k * m * x - k * n * y = k * gcd m n ∨ k * n * x - k * m * y = k * gcd m n
  ← inst y goal=12
    #[13] k * m * x - k * n * y = k * gcd m n ∨ k * n * x - k * m * y = k * gcd m n
  ← rule disjE goal=13 facts=[7]
    #[14] m * x - n * y = gcd m n ⟶ k * m * x - k * n * y = k * gcd m n ∨ k * n * x - k * m * y = k * gcd m n
    #[15] n * x - m * y = gcd m n ⟶ k * m * x - k * n * y = k * gcd m n ∨ k * n * x - k * m * y = k * gcd m n
  ← intro goal=14
    #[16] m * x - n * y = gcd m n
    #[17] k * m * x - k * n * y = k * gcd m n ∨ k * n * x - k * m * y = k * gcd m n
  ← rule disjI1 goal=17
    #[18] k * m * x - k * n * y = k * gcd m n
  ← rewrite mult_assoc sym=false goal=18
    #[19] k * (m * x) - k * (n * y) = k * gcd m n
  ← rewrite left_sub_distrib sym=true goal=19
    #[20] k * (m * x - n * y) = k * gcd m n
  ← rewrite eq_mult_lcancel sym=false goal=20
    #[21] k = 0 ∨ m * x - n * y = gcd m n
  ← rule disjI2 goal=21
  ← intro goal=15
    #[22] n * x - m * y = gcd m n
    #[23] k * m * x - k * n * y = k * gcd m n ∨ k * n * x - k * m * y = k * gcd m n
  ← rule disjI2 goal=23
    #[24] k * n * x - k * m * y = k * gcd m n
  ← rewrite mult_assoc sym=false goal=24
    #[25] k * (n * x) - k * (m * y) = k * gcd m n
  ← rewrite left_sub_distrib sym=true goal=25
    #[26] k * (n * x - m * y) = k * gcd m n
  ← rewrite eq_mult_lcancel sym=false goal=26
    #[27] k = 0 ∨ n * x - m * y = gcd m n
  ← rule disjI2 goal=27
  ← rule gcd_is_max goal=10
    #[28] divides (k * gcd m n) (k * m)
    #[29] divides (k * gcd m n) (k * n)
  ← rule divides_mult_left goal=28
    #[30] divides (gcd m n) m
  ← rule gcd_divide1 goal=30
    #[31] divides (gcd m n) m
  ← rule divides_mult_left goal=29
    #[32] divides (gcd m n) n
  ← rule gcd_divides2 goal=32
    #[33] divides (gcd m n) n
qed

theorem gcd_mult_right
  fixes k :: nat, m :: nat, n :: nat
  prop gcd (m * k) (n * k) = k * gcd m n
  [hint_rewrite]
proof
  ← rewrite mult_comm sym=false goal=0
    #[1] gcd (k * m) (k * n) = gcd m n * k
  ← rewrite gcd_mult_left sym=false goal=1
    #[2] k * gcd m n = gcd m n * k
  nat_norm goal=2
qed

theorem gcd_add_left
  fixes m :: nat, n :: nat
  prop gcd m (m + n) = gcd m n
  [hint_rewrite]
proof
  ← rule gcd_equals goal=0
    #[1] divides (gcd m n) m
    #[2] divides (gcd m n) (m + n)
    #[3] ∀b. divides b m ⟶ divides b (m + n) ⟶ divides b (gcd m n)
  ← rule gcd_divide1 goal=1
  ← rule divides_sum goal=2
    #[4] divides (gcd m n) n
  ← rule gcd_divides2 goal=4
  ← intro b goal=3
    #[5] _VAR b
    #[6] divides b m
    #[7] divides b (m + n)
    #[8] divides b (gcd m n)
  ← rule gcd_is_max goal=8
    #[9] divides b n
  → forward divides_sum2 goal=9 facts=[7,6]
qed

theorem gcd_add_right
  fixes m :: nat, n :: nat
  prop gcd (m + n) m = gcd m n
  [hint_rewrite]
proof
  ← rewrite gcd_comm sym=false goal=0
    #[1] gcd m (m + n) = gcd n m
  ← rewrite gcd_add_left sym=false goal=1
    #[2] gcd m n = gcd n m
  ← rule gcd_comm goal=2
qed

theorem gcd_sub_left
  fixes a :: nat, b :: nat
  prop b <= a --> gcd (a - b) b = gcd a b
  [hint_backward]
proof
  ← intro goal=0
    #[1] b ≤ a
    #[2] gcd (a - b) b = gcd a b
  → forward sub_add goal=2 facts=[1]
    #[3] a - b + b = a
  → forward gcd_add_left param_m=b param_n=a-b goal=2
    #[4] gcd b (b + (a - b)) = gcd b (a - b)
  → rewrite target=fact add_comm sym=false goal=2 facts=[4]
    #[5] gcd b (a - b + b) = gcd b (a - b)
  → rewrite target=fact source=prev goal=2 facts=[3,5]
    #[6] gcd b a = gcd b (a - b)
  ← rewrite gcd_comm sym=false goal=2
    #[7] gcd b (a - b) = gcd b a
  ← rewrite source=prev goal=7 facts=[6]
qed

theorem gcd_sub_right
  fixes a :: nat, b :: nat
  prop a <= b --> gcd a (b - a) = gcd a b
  [hint_backward]
proof
  ← intro goal=0
    #[1] a ≤ b
    #[2] gcd a (b - a) = gcd a b
  ← rewrite gcd_comm sym=false goal=2
    #[3] gcd (b - a) a = gcd b a
  ← rule gcd_sub_left goal=3
qed

theorem divides_gcd_left
  fixes m :: nat, n :: nat
  prop divides m n <--> gcd m n = m
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] divides m n ⟶ gcd m n = m
    #[2] gcd m n = m ⟶ divides m n
  ← intro goal=1
    #[3] divides m n
    #[4] gcd m n = m
  ← rule gcd_equal_left goal=4
  ← intro goal=2
    #[5] gcd m n = m
    #[6] divides m n
  → rewrite target=fact eq_sym_eq sym=false goal=6 facts=[5]
    #[7] m = gcd m n
  ← rewrite source=prev goal=6 facts=[7]
    #[8] divides (gcd m n) n
  ← rule gcd_divides2 goal=8
    #[9] divides (gcd m n) n
qed

theorem divides_gcd_right
  fixes m :: nat, n :: nat
  prop divides n m <--> gcd m n = n
  [hint_rewrite]
proof
  ← rewrite gcd_comm sym=false goal=0
    #[1] divides n m ⟷ gcd n m = n
  ← rewrite divides_gcd_left sym=false goal=1
qed

theorem divides_lmul_gcd
  fixes a :: nat, b :: nat, d :: nat
  prop divides d (gcd d a * b) <--> divides d (a * b)
  [hint_rewrite]
proof
  ← rewrite mult_comm sym=false goal=0
    #[1] divides d (b * gcd d a) ⟷ divides d (b * a)
  ← rewrite gcd_mult_right sym=true goal=1
    #[2] divides d (gcd (d * b) (a * b)) ⟷ divides d (b * a)
  ← rule iffI goal=2
    #[3] divides d (gcd (d * b) (a * b)) ⟶ divides d (b * a)
    #[4] divides d (b * a) ⟶ divides d (gcd (d * b) (a * b))
  ← intro goal=3
    #[5] divides d (gcd (d * b) (a * b))
    #[6] divides d (b * a)
  → rewrite target=fact divides_gcd sym=false goal=6 facts=[5]
    #[7] divides d (d * b) ∧ divides d (a * b)
  → forward conjD2 goal=6 facts=[7]
    #[8] divides d (a * b)
  ← rewrite mult_comm sym=false goal=6
  ← intro goal=4
    #[9] divides d (b * a)
    #[10] divides d (gcd (d * b) (a * b))
  ← rewrite divides_gcd sym=false goal=10
    #[11] divides d (d * b) ∧ divides d (a * b)
  ← rule conjI goal=11
    #[12] divides d (d * b)
    #[13] divides d (a * b)
  ← rule divides_rmul goal=12
    #[14] divides d d
  ← rule divides_self goal=14
    #[15] divides d d
  ← rewrite mult_comm sym=false goal=13
qed

theorem divides_rmul_gcd
  fixes a :: nat, b :: nat, d :: nat
  prop divides d (a * gcd d b) <--> divides d (a * b)
  [hint_rewrite]
proof
  ← rewrite mult_comm sym=false goal=0
    #[1] divides d (gcd d b * a) ⟷ divides d (b * a)
  ← rewrite divides_lmul_gcd sym=false goal=1
qed

theorem gcd_le
  fixes m :: nat, n :: nat
  prop gcd m n <= m <--> (m = 0 --> n = 0)
  [hint_rewrite]
proof
  ← cases "m=0" goal=0
    #[1] m = 0 ⟶ gcd m n ≤ m ⟷ (m = 0 ⟶ n = 0)
    #[2] ¬(m = 0) ⟶ gcd m n ≤ m ⟷ (m = 0 ⟶ n = 0)
  ← intro goal=1
    #[3] m = 0
    #[4] gcd m n ≤ m ⟷ (m = 0 ⟶ n = 0)
  ← rewrite source=prev goal=4 facts=[3]
    #[5] gcd 0 n ≤ 0 ⟷ ((0::nat) = 0 ⟶ n = 0)
  ← rewrite gcd_zero_left sym=false goal=5
    #[6] n ≤ 0 ⟷ ((0::nat) = 0 ⟶ n = 0)
  ← rewrite nat_less_eq_def_1 sym=false goal=6
    #[7] n = 0 ⟷ ((0::nat) = 0 ⟶ n = 0)
  ← rule iffI goal=7
    #[8] n = 0 ⟶ (0::nat) = 0 ⟶ n = 0
    #[9] ((0::nat) = 0 ⟶ n = 0) ⟶ n = 0
  ← intro goal=9
    #[10] (0::nat) = 0 ⟶ n = 0
    #[11] n = 0
  ← apply_prev goal=11 facts=[10]
    #[12] (0::nat) = 0
  ← rule eq_refl goal=12
    #[13] (0::nat) = 0
  ← intro goal=2
    #[14] ¬(m = 0)
    #[15] gcd m n ≤ m ⟷ (m = 0 ⟶ n = 0)
  ← cases "n=0" goal=15
    #[16] n = 0 ⟶ gcd m n ≤ m ⟷ (m = 0 ⟶ n = 0)
    #[17] ¬(n = 0) ⟶ gcd m n ≤ m ⟷ (m = 0 ⟶ n = 0)
  ← intro goal=16
    #[18] n = 0
    #[19] gcd m n ≤ m ⟷ (m = 0 ⟶ n = 0)
  ← rewrite source=prev goal=19 facts=[18]
    #[20] gcd m 0 ≤ m ⟷ (m = 0 ⟶ (0::nat) = 0)
  ← rewrite gcd_zero_right sym=false goal=20
    #[21] m ≤ m ⟷ (m = 0 ⟶ (0::nat) = 0)
  ← rule iffI goal=21
    #[22] m ≤ m ⟶ m = 0 ⟶ (0::nat) = 0
    #[23] (m = 0 ⟶ (0::nat) = 0) ⟶ m ≤ m
  ← intro goal=22
    #[24] m ≤ m
    #[25] (0::nat) = 0
  ← rule eq_refl goal=25
  ← intro goal=23
    #[26] m = 0 ⟶ (0::nat) = 0
    #[27] m ≤ m
  ← rule less_eq_refl goal=27
    #[28] m ≤ m
  ← intro goal=17
    #[29] ¬(n = 0)
    #[30] gcd m n ≤ m ⟷ (m = 0 ⟶ n = 0)
  ← rule iffI goal=30
    #[31] gcd m n ≤ m ⟶ m = 0 ⟶ n = 0
    #[32] (m = 0 ⟶ n = 0) ⟶ gcd m n ≤ m
  ← intro goal=31
    #[33] gcd m n ≤ m
    #[34] n = 0
  ← rule negE_gen goal=34 facts=[14,3]
    #[35] n = 0
  ← intro goal=32
    #[36] m = 0 ⟶ n = 0
    #[37] gcd m n ≤ m
  ← rule divides_le_imp goal=37
    #[38] divides (gcd m n) m
    #[39] m = 0 ⟶ gcd m n = 0
  ← rule gcd_divide1 goal=38
    #[40] divides (gcd m n) m
  ← intro goal=39
    #[41] gcd m n = 0
  ← rule negE_gen goal=41 facts=[14,3]
    #[42] gcd m n = 0
qed

theorem gcd_le_min_eq
  fixes m :: nat, n :: nat
  prop gcd m n <= min m n <--> m = 0 <--> n = 0
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
    #[2] ¬(n = 0) ⟶ gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
  ← intro goal=1
    #[3] n = 0
    #[4] gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
  ← rewrite source=prev goal=4 facts=[3]
    #[5] gcd m 0 ≤ min m 0 ⟷ m = 0 ⟷ (0::nat) = 0
  ← rewrite gcd_zero_right sym=false goal=5
    #[6] m ≤ min m 0 ⟷ m = 0 ⟷ (0::nat) = 0
  cut "min m 0 = 0" goal=6
    #[7] min m 0 = 0
  ← rewrite min_def sym=false goal=7
    #[8] (if m ≤ 0 then m else 0) = 0
  ← rewrite nat_less_eq_def_1 sym=false goal=8
    #[9] (if m = 0 then m else 0) = 0
  ← cases " m = 0" goal=9
    #[10] m = 0 ⟶ (if m = 0 then m else 0) = 0
    #[11] ¬(m = 0) ⟶ (if m = 0 then m else 0) = 0
  ← intro goal=10
    #[12] m = 0
    #[13] (if m = 0 then m else 0) = 0
  ← rewrite if_P sym=false goal=13 facts=[12]
  ← intro goal=11
    #[14] ¬(m = 0)
    #[15] (if m = 0 then m else 0) = 0
  ← rewrite if_not_P sym=false goal=15 facts=[14]
    #[16] (if m = 0 then m else 0) = 0
  ← rewrite source=prev goal=6 facts=[7]
    #[17] m ≤ 0 ⟷ m = 0 ⟷ (0::nat) = 0
  ← rewrite nat_less_eq_def_1 sym=false goal=17
    #[18] m = 0 ⟷ m = 0 ⟷ (0::nat) = 0
  ← rule iffI goal=18
    #[19] m = 0 ⟶ m = 0 ⟷ (0::nat) = 0
    #[20] m = 0 ⟷ (0::nat) = 0 ⟶ m = 0
  ← intro goal=19
    #[21] m = 0 ⟷ (0::nat) = 0
  ← rule iffI goal=21
    #[22] m = 0 ⟶ (0::nat) = 0
    #[23] (0::nat) = 0 ⟶ m = 0
  ← intro goal=22
    #[24] (0::nat) = 0
  ← rule eq_refl goal=24
    #[25] (0::nat) = 0
  ← intro goal=23
    #[26] (0::nat) = 0
  ← intro goal=20
    #[27] m = 0 ⟷ (0::nat) = 0
    #[28] m = 0
  ← rewrite source=prev goal=28 facts=[27]
    #[29] m = 0
  ← intro goal=2
    #[30] ¬(n = 0)
    #[31] gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
  ← cases "m=0" goal=31
    #[32] m = 0 ⟶ gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
    #[33] ¬(m = 0) ⟶ gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
  ← intro goal=32
    #[34] gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
  ← rewrite source=prev goal=34 facts=[12]
    #[35] gcd 0 n ≤ min 0 n ⟷ (0::nat) = 0 ⟷ n = 0
  ← rewrite gcd_zero_left sym=false goal=35
    #[36] n ≤ min 0 n ⟷ (0::nat) = 0 ⟷ n = 0
  cut "min 0 n = 0" goal=36
    #[37] min 0 n = 0
  ← rewrite min_def sym=false goal=37
    #[38] (if 0 ≤ n then 0 else n) = 0
  cut "0 ≤ n" goal=38
    #[39] 0 ≤ n
  ← rule le_0 goal=39
    #[40] 0 ≤ n
  ← rewrite if_P sym=false goal=38 facts=[40]
    #[41] (if 0 ≤ n then 0 else n) = 0
  ← rewrite source=prev goal=36 facts=[37]
    #[42] n ≤ 0 ⟷ (0::nat) = 0 ⟷ n = 0
  ← rewrite nat_less_eq_def_1 sym=false goal=42
    #[43] n = 0 ⟷ (0::nat) = 0 ⟷ n = 0
  ← rule iffI goal=43
    #[44] n = 0 ⟶ (0::nat) = 0 ⟷ n = 0
    #[45] (0::nat) = 0 ⟷ n = 0 ⟶ n = 0
  ← intro goal=44
    #[46] (0::nat) = 0 ⟷ n = 0
  ← rewrite source=prev goal=46 facts=[3]
    #[47] (0::nat) = 0 ⟷ n = 0
  ← intro goal=45
    #[48] (0::nat) = 0 ⟷ n = 0
    #[49] n = 0
  → rewrite target=fact eq_sym_eq sym=false goal=49 facts=[48]
    #[50] n = 0 ⟷ (0::nat) = 0
  ← rewrite source=prev goal=49 facts=[50]
    #[51] n = 0
  ← intro goal=33
    #[52] gcd m n ≤ min m n ⟷ m = 0 ⟷ n = 0
  cut "∀p. p ≤ min m n ⟷ p ≤ m ∧ p ≤ n" goal=52
    #[53] ∀p. p ≤ min m n ⟷ p ≤ m ∧ p ≤ n
  ← z3 goal=53
    #[54] ∀p. p ≤ min m n ⟷ p ≤ m ∧ p ≤ n
  ← rewrite source=prev goal=52 facts=[54]
    #[55] gcd m n ≤ m ∧ gcd m n ≤ n ⟷ m = 0 ⟷ n = 0
  ← rewrite gcd_le sym=false goal=55
    #[56] (m = 0 ⟶ n = 0) ∧ gcd m n ≤ n ⟷ m = 0 ⟷ n = 0
  ← rewrite gcd_comm sym=false goal=56
    #[57] (m = 0 ⟶ n = 0) ∧ gcd n m ≤ n ⟷ m = 0 ⟷ n = 0
  ← rewrite gcd_le sym=false goal=57
    #[58] (m = 0 ⟶ n = 0) ∧ (n = 0 ⟶ m = 0) ⟷ m = 0 ⟷ n = 0
  ← rule iffI goal=58
    #[59] (m = 0 ⟶ n = 0) ∧ (n = 0 ⟶ m = 0) ⟶ m = 0 ⟷ n = 0
    #[60] m = 0 ⟷ n = 0 ⟶ (m = 0 ⟶ n = 0) ∧ (n = 0 ⟶ m = 0)
  ← intro goal=59
    #[61] (m = 0 ⟶ n = 0) ∧ (n = 0 ⟶ m = 0)
    #[62] m = 0 ⟷ n = 0
  ← rule iffI goal=62
    #[63] m = 0 ⟶ n = 0
    #[64] n = 0 ⟶ m = 0
  ← rule conjD1 goal=63 facts=[61]
    #[65] m = 0 ⟶ n = 0
  ← rule conjD2 goal=64 facts=[61]
    #[66] n = 0 ⟶ m = 0
  ← intro goal=60
    #[67] m = 0 ⟷ n = 0
    #[68] (m = 0 ⟶ n = 0) ∧ (n = 0 ⟶ m = 0)
  ← rule conjI goal=68
    #[69] m = 0 ⟶ n = 0
    #[70] n = 0 ⟶ m = 0
  ← rewrite source=prev goal=69 facts=[67]
    #[71] n = 0 ⟶ n = 0
  ← rewrite source=prev goal=70 facts=[67]
qed

theorem gcd_le_max
  fixes m :: nat, n :: nat
  prop gcd m n <= max m n
  [hint_backward]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ gcd m n ≤ max m n
    #[2] ¬(n = 0) ⟶ gcd m n ≤ max m n
  ← intro goal=1
    #[3] n = 0
    #[4] gcd m n ≤ max m n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] gcd m 0 ≤ max m 0
  ← rewrite gcd_zero_right sym=false goal=5
    #[6] m ≤ max m 0
  cut "max m 0 = m" goal=6
    #[7] max m 0 = m
  ← z3 goal=7
    #[8] max m 0 = m
  ← rewrite source=prev goal=6 facts=[8]
    #[9] m ≤ m
  ← rule less_eq_refl goal=9
    #[10] m ≤ m
  ← intro goal=2
    #[11] ¬(n = 0)
    #[12] gcd m n ≤ max m n
  ← cases "m=0" goal=12
    #[13] m = 0 ⟶ gcd m n ≤ max m n
    #[14] ¬(m = 0) ⟶ gcd m n ≤ max m n
  ← intro goal=13
    #[15] m = 0
    #[16] gcd m n ≤ max m n
  ← rewrite source=prev goal=16 facts=[15]
    #[17] gcd 0 n ≤ max 0 n
  ← rewrite gcd_zero_left sym=false goal=17
    #[18] n ≤ max 0 n
  cut "max 0 n = n" goal=18
    #[19] max 0 n = n
  ← z3 goal=19
    #[20] max 0 n = n
  ← rewrite source=prev goal=18 facts=[20]
    #[21] n ≤ n
  ← rule less_eq_refl goal=21
    #[22] n ≤ n
  ← intro goal=14
    #[23] ¬(m = 0)
    #[24] gcd m n ≤ max m n
  cut "!p::nat. p <= min m n --> p <= max m n" goal=24
    #[25] ∀p. p ≤ min m n ⟶ p ≤ max m n
  ← z3 goal=25
    #[26] ∀p. p ≤ min m n ⟶ p ≤ max m n
  ← apply_prev goal=24 facts=[26]
    #[27] gcd m n ≤ min m n
  ← rewrite gcd_le_min_eq sym=false goal=27
    #[28] m = 0 ⟷ n = 0
  ← rule iffI goal=28
    #[29] m = 0 ⟶ n = 0
    #[30] n = 0 ⟶ m = 0
  ← intro goal=29
    #[31] n = 0
  ← rule negE_gen goal=31 facts=[23,15]
    #[32] n = 0
  ← intro goal=30
    #[33] m = 0
  ← rule negE_gen goal=33 facts=[11,3]
    #[34] m = 0
qed

theorem gcd_mod
  fixes d :: nat, m :: nat, n :: nat
  prop gcd n (m * n + d) = gcd n d
  [hint_rewrite]
proof
  ← induct m nat_induct goal=0
    #[1] gcd n (0 * n + d) = gcd n d
    #[2] ∀n1. gcd n (n1 * n + d) = gcd n d ⟶ gcd n (Suc n1 * n + d) = gcd n d
  ← rewrite nat_times_def_1 sym=false goal=1
    #[3] gcd n (0 + d) = gcd n d
  ← rewrite nat_plus_def_1 sym=false goal=3
  ← intro m goal=2
    #[4] _VAR m
    #[5] gcd n (m * n + d) = gcd n d
    #[6] gcd n (Suc m * n + d) = gcd n d
  ← rewrite nat_times_def_2 sym=false goal=6
    #[7] gcd n (n + m * n + d) = gcd n d
  ← rewrite add_assoc sym=false goal=7
    #[8] gcd n (n + (m * n + d)) = gcd n d
  ← rewrite gcd_add_left sym=false goal=8
qed

