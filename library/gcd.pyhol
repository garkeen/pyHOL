theory gcd
imports products
description "Greatest common divisors"

def divides :: nat ⇒ nat ⇒ bool = divides m n ⟷ (∃k. n = m * k) [hint_rewrite]

theorem divides_le
  fixes m :: nat, n :: nat
  prop divides m n ⟶ m ≤ n ∨ n = 0
  [hint_backward]
  proof
    1: cut "!m. !n. m <= m * n | m * n = (0::nat) "
    1: z3
    2: rewrite_fact divides_def @0 sym=false
    3: exists_elim k @2
    5: rewrite_goal_with_prev @4
    5: apply_prev @1
  qed

theorem divides_le_strong
  fixes m :: nat, n :: nat
  prop divides m n ⟶ 1 ≤ m ∧ m ≤ n ∨ n = 0
  [hint_backward]
  proof
    1: apply_forward_step divides_le @0
    2: rewrite_fact divides_def @0 sym=false
    3: cases "m=0"
    3: introduction
    3.1: apply_backward_step disjI2
    3.1: exists_elim k @2
    3.3: rewrite_fact_with_prev @3.0,3.2
    3.4: rewrite_fact nat_times_def_1 @3.3 sym=false
    4: introduction
    4.1: apply_backward_step disjE @1
    4.1: introduction
    4.1.1: apply_backward_step disjI1
    4.1.1: apply_backward_step conjI
    4.1.1: apply_backward_step le_1_2
    4.2: introduction
    4.2.1: apply_backward_step disjI2
  qed

theorem divides_le_imp
  fixes m :: nat, n :: nat
  prop divides m n ⟶ (n = 0 ⟶ m = 0) ⟶ m ≤ n
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step divides_le @0
    3: apply_backward_step disjE @2
    4: introduction
    4.1: apply_fact @1,4.0
    4.2: rewrite_goal_with_prev @4.0
    4.2: rewrite_goal_with_prev @4.1
    4.2: apply_backward_step le_0
  qed

theorem properly_divides_le_imp
  fixes m :: nat, n :: nat
  prop divides m n ⟶ ¬(n = 0) ⟶ ¬(m = n) ⟶ 2 * m ≤ n
  [hint_backward,hint_backward1]
  proof
    3: rewrite_fact divides_def @0 sym=false
    4: exists_elim d @3
    6: rewrite_fact_with_prev @5,2
    7: cut "~(m = m * d) <--> ~(m = 0) & ~(d = 1)"
    7: z3
    8: rewrite_fact_with_prev @7,6
    9: rewrite_goal mult_comm sym=false
    9: z3 @1,2,5,8
  qed

theorem divides_one
  fixes n :: nat
  prop divides n 1 ⟷ n = 1
  [hint_rewrite]
  proof
    0: rewrite_goal divides_def sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: exists_elim k @0.0
    0.3: rewrite_fact eq_sym_eq @0.2 sym=false
    0.4: rewrite_fact mult_eq_1 @0.3 sym=false
    0.5: apply_backward_step conjD1 @0.4
    1: introduction
    1.1: inst_exists_goal "(1::nat)"
    1.1: rewrite_goal_with_prev @1.0
    1.1: rewrite_goal mult_1_left sym=false
  qed

theorem divides_0
  fixes x :: nat
  prop divides 0 x ⟷ x = 0
  [hint_rewrite]
  proof
    0: rewrite_goal divides_def sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: exists_elim k @0.0
    0.3: rewrite_fact nat_times_def_1 @0.2 sym=false
    1: introduction
    1.1: inst_exists_goal "(0::nat)"
    1.1: rewrite_goal mult_0_right sym=false
  qed

theorem divides_1
  fixes x :: nat
  prop divides 1 x
  [hint_backward]
  proof
    0: rewrite_goal divides_def sym=false
    0: inst_exists_goal x
    0: rewrite_goal mult_1_left sym=false
  qed

theorem div_add
  fixes a :: nat, b :: nat, d :: nat
  prop divides d a ∨ divides d b ⟶ (a + b) DIV d = a DIV d + b DIV d
  [hint_backward]
  proof
    1: cases "d=0"
    1: introduction
    1.1: rewrite_goal_with_prev @1.0
    1.1: rewrite_goal div_zero sym=false
    1.1: rewrite_goal add_0_right sym=false
    2: introduction
    2.1: rewrite_fact divides_def @0 sym=false
    2.2: apply_backward_step disjE @2.1
    2.2: introduction
    2.2.1: exists_elim k @2.2.0
    2.2.3: rewrite_goal_with_prev @2.2.2
    2.2.3: apply_forward_step div_mult_add2 @2.0 param_a=k param_b=b
    2.2.4: apply_forward_step div_mult @2.0 param_n=k
    2.2.5: rewrite_goal_with_prev @2.2.3
    2.2.5: rewrite_goal_with_prev @2.2.4
    2.3: introduction
    2.3.1: exists_elim k @2.3.0
    2.3.3: rewrite_goal_with_prev @2.3.2
    2.3.3: apply_forward_step div_mult @2.0 param_n=k
    2.3.4: apply_forward_step div_mult_add4 @2.0 param_a=k param_b=a
    2.3.5: rewrite_goal_with_prev @2.3.4
    2.3.5: rewrite_goal_with_prev @2.3.3
  qed

theorem divides_mod
  fixes m :: nat, n :: nat
  prop divides m n ⟷ n MOD m = 0
  [hint_rewrite]
  proof
    0: rewrite_goal divides_def sym=false
    0: rewrite_goal mod_eq_0 sym=false
    0: z3
  qed

theorem divides_div_mult
  fixes m :: nat, n :: nat
  prop divides m n ⟷ n DIV m * m = n
  [hint_rewrite]
  proof
    0: rewrite_goal divides_def sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: exists_elim k @0.0
    0.3: rewrite_goal_with_prev @0.2
    0.3: cases "m=0"
    0.3: introduction
    0.3.1: rewrite_goal_with_prev @0.3.0
    0.3.1: nat_norm
    0.4: introduction
    0.4.1: apply_forward_step div_mult @0.4.0 param_n=k
    0.4.2: rewrite_goal_with_prev @0.4.1
    0.4.2: nat_norm
    1: introduction
    1.1: rewrite_fact eq_sym_eq @1.0 sym=false
    1.2: rewrite_goal_with_prev @1.1
    1.2: inst_exists_goal "n DIV m"
    1.2: nat_norm
  qed

theorem div_by_div
  fixes m :: nat, n :: nat
  prop ¬(n = 0) ⟶ divides m n ⟶ n DIV (n DIV m) = m
  [hint_backward,hint_backward1]
  proof
    2: rewrite_fact divides_div_mult @1 sym=false
    3: rewrite_fact eq_sym_eq @2 sym=false
    4: rewrite_goal_with_prev @3
    4: cut "(n DIV m * m DIV m) = (n DIV m)"
    4: rewrite_goal_with_prev @2
    5: rewrite_goal_with_prev @4
    5: apply_backward_step div_mult
    5: rewrite_fact divides_def @1 sym=false
    6: exists_elim k @5
    8: cases "m=0"
    8: introduction
    8.1: rewrite_fact_with_prev @8.0,7
    8.2: rewrite_fact nat_times_def_1 @8.1 sym=false
    8.3: apply_backward_step negE_gen @0,8.2
    9: introduction
    9.1: apply_forward_step div_eq_0 @9.0 param_m=n
    9.2: rewrite_goal_with_prev @9.1
    9.2: rewrite_goal not_lt sym=false
    9.2: rewrite_goal_with_prev @7
    9.2: rewrite_fact_with_prev @7,0
    9.3: rewrite_fact mult_eq_0 @9.2 sym=false
    9.4: rewrite_fact de_morgan_thm2 @9.3 sym=false
    9.5: apply_forward_step conjD2 @9.4
    9.6: z3 @9.5
  qed

theorem divides_self
  fixes n :: nat
  prop divides n n
  [hint_backward]
  proof
    0: rewrite_goal divides_def sym=false
    0: inst_exists_goal "(1::nat)"
    0: rewrite_goal mult_1_right sym=false
  qed

theorem divides_trans
  fixes k :: nat, m :: nat, n :: nat
  prop divides k m ⟶ divides m n ⟶ divides k n
  [hint_backward]
  proof
    2: rewrite_fact divides_def @0 sym=false
    3: rewrite_fact divides_def @1 sym=false
    4: exists_elim p @2
    6: exists_elim q @3
    8: rewrite_goal divides_def sym=false
    8: inst_exists_goal "p * q"
    8: rewrite_goal_with_prev @7
    8: rewrite_goal_with_prev @5
    8: rewrite_goal mult_assoc sym=false
  qed

theorem divides_antisym
  fixes m :: nat, n :: nat
  prop divides m n ⟶ divides n m ⟶ m = n
  proof
    2: rewrite_fact divides_def @0 sym=false
    3: rewrite_fact divides_def @1 sym=false
    4: exists_elim p @2
    6: exists_elim q @3
    8: cut "m = m * 1" @7
    8: rewrite_goal mult_1_right sym=false
    9: rewrite_fact_with_prev @8,7
    10: rewrite_fact_with_prev @5,9
    11: rewrite_fact mult_assoc @10 sym=false
    12: rewrite_fact eq_mult_lcancel @11 sym=false
    13: apply_backward_step disjE @12
    13: introduction
    13.1: rewrite_fact_with_prev @13.0,5
    13.2: rewrite_fact nat_times_def_1 @13.1 sym=false
    13.3: rewrite_goal_with_prev @13.0
    13.3: rewrite_goal_with_prev @13.2
    14: introduction
    14.1: rewrite_fact eq_sym_eq @14.0 sym=false
    14.2: rewrite_fact mult_eq_1 @14.1 sym=false
    14.3: apply_forward_step conjD1 @14.2
    14.4: rewrite_fact_with_prev @14.3,5
    14.5: rewrite_fact mult_1_right @14.4 sym=false
    14.6: rewrite_goal eq_sym_eq sym=false
  qed

theorem divides_zero
  fixes n :: nat
  prop divides n 0
  [hint_backward]
  proof
    0: rewrite_goal divides_def sym=false
    0: inst_exists_goal "(0::nat)"
    0: rewrite_goal mult_0_right sym=false
  qed

theorem divides_div_divides
  fixes d :: nat, e :: nat, n :: nat
  prop divides d n ⟶ (n = 0 ⟶ e = 0) ⟶ divides (n DIV d) e ⟷ divides n (d * e)
  [hint_backward,hint_backward1]
  proof
    2: rewrite_fact divides_div_mult @0 sym=false
    3: rewrite_fact eq_sym_eq @2 sym=false
    4: apply_backward_step iffI
    4: rewrite_goal divides_def sym=false
    4: introduction
    4.1: exists_elim k1 @4.0
    4.3: rewrite_goal_with_prev @3
    4.3: rewrite_goal_with_prev @4.2
    4.3: inst_exists_goal k1
    4.3: nat_norm
    6: cases "e=0"
    6: introduction
    6.2: rewrite_goal_with_prev @6.0
    6.2: apply_backward_step divides_zero
    7: introduction
    7.2: apply_backward_step contrapositive @7.0
    7.2: introduction
    7.2.1: rewrite_goal double_neg sym=false
    7.2.1: apply_prev @1
    7.2.1: apply_backward_step contrapositive @7.2.0
    7.2.1: introduction
    7.2.1.1: rewrite_goal double_neg sym=false
    7.2.1.1: rewrite_fact divides_def @7.1 sym=false
    7.2.1.2: rewrite_goal divides_def sym=false
    7.2.1.2: exists_elim k @7.2.1.1
    7.2.1.4: rewrite_fact_with_prev @3,7.2.1.3
    7.2.1.5: cut "n DIV d * d * k = d * (n DIV d) * k"
    7.2.1.5: nat_norm
    7.2.1.6: rewrite_fact_with_prev @7.2.1.5,7.2.1.4
    7.2.1.7: rewrite_fact mult_assoc @7.2.1.6 sym=false
    7.2.1.8: rewrite_fact eq_mult_lcancel @7.2.1.7 sym=false
    7.2.1.9: apply_backward_step disjE @7.2.1.8
    7.2.1.9: introduction
    7.2.1.9.1: rewrite_fact_with_prev @7.2.1.9.0,0
    7.2.1.9.2: rewrite_fact divides_0 @7.2.1.9.1 sym=false
    7.2.1.9.3: apply_backward_step negE_gen @7.2.1.0,7.2.1.9.2
    7.2.1.10: introduction
    7.2.1.10.1: inst_exists_goal k
  qed

theorem divides_div_self
  fixes d :: nat, e :: nat, n :: nat
  prop divides d n ⟶ divides (n DIV d) n
  [hint_backward]
  proof
    1: rewrite_fact divides_div_mult @0 sym=false
    2: rewrite_goal divides_def sym=false
    2: inst_exists_goal d
    2: rewrite_goal eq_sym_eq sym=false
  qed

theorem divides_sum
  fixes k :: nat, m :: nat, n :: nat
  prop divides k m ⟶ divides k n ⟶ divides k (m + n)
  [hint_backward]
  proof
    2: rewrite_fact divides_def @0 sym=false
    3: rewrite_fact divides_def @1 sym=false
    4: exists_elim p @2
    6: exists_elim q @3
    8: rewrite_goal divides_def sym=false
    8: inst_exists_goal "p + q"
    8: rewrite_goal_with_prev @7
    8: rewrite_goal_with_prev @5
    8: rewrite_goal distrib_l sym=false
  qed

theorem divides_sub
  fixes k :: nat, m :: nat, n :: nat
  prop divides k m ⟶ divides k n ⟶ divides k (m - n)
  [hint_backward,hint_backward1]
  proof
    2: rewrite_fact divides_def @0 sym=false
    3: rewrite_fact divides_def @1 sym=false
    4: rewrite_goal divides_def sym=false
    4: exists_elim k1 @2
    6: exists_elim k2 @3
    8: inst_exists_goal k1-k2
    8: rewrite_goal_with_prev @5
    8: rewrite_goal_with_prev @7
    8: rewrite_goal left_sub_distrib sym=false
  qed

theorem divides_sum2
  fixes k :: nat, m :: nat, n :: nat
  prop divides k (m + n) ⟶ divides k m ⟶ divides k n
  [hint_forward]
  proof
    2: cut "n = m + n - m"
    2: rewrite_goal nat_plus_minus_2 sym=false
    3: rewrite_goal_with_prev @2
    3: apply_backward_step divides_sub
  qed

theorem divides_lmul
  fixes a :: nat, d :: nat, x :: nat
  prop divides d a ⟶ divides d (x * a)
  [hint_backward]
  proof
    1: rewrite_fact divides_def @0 sym=false
    2: rewrite_goal divides_def sym=false
    2: exists_elim k @1
    4: inst_exists_goal "x * k"
    4: rewrite_goal_with_prev @3
    4: nat_norm
  qed

theorem divides_rmul
  fixes a :: nat, d :: nat, x :: nat
  prop divides d a ⟶ divides d (a * x)
  [hint_backward]
  proof
    1: rewrite_goal mult_comm sym=false
    1: apply_backward_step divides_lmul
  qed

theorem divides_lmul2
  fixes a :: nat, d :: nat, x :: nat
  prop divides (x * d) a ⟶ divides d a
  [hint_backward]
  proof
    1: rewrite_fact divides_def @0 sym=false
    2: rewrite_goal divides_def sym=false
    2: exists_elim k @1
    4: inst_exists_goal "x * k"
    4: rewrite_goal_with_prev @3
    4: nat_norm
  qed

theorem divides_rmul2
  fixes a :: nat, d :: nat, x :: nat
  prop divides (d * x) a ⟶ divides d a
  [hint_backward]
  proof
    1: rewrite_fact mult_comm @0 sym=false
    2: apply_backward_step divides_lmul2 param_x=x
  qed

theorem divides_mult_left
  fixes k :: nat, m :: nat, n :: nat
  prop divides m n ⟶ divides (k * m) (k * n)
  [hint_backward]
  proof
    1: rewrite_fact divides_def @0 sym=false
    2: exists_elim p @1
    4: rewrite_goal divides_def sym=false
    4: inst_exists_goal p
    4: rewrite_goal_with_prev @3
    4: rewrite_goal mult_assoc sym=false
  qed

theorem divides_mult_right
  fixes k :: nat, m :: nat, n :: nat
  prop divides m n ⟶ divides (m * k) (n * k)
  [hint_backward]
  proof
    1: rewrite_fact divides_def @0 sym=false
    2: exists_elim p @1
    4: rewrite_goal divides_def sym=false
    4: inst_exists_goal p
    4: rewrite_goal_with_prev @3
    4: nat_norm
  qed

theorem divides_cmul2
  fixes a :: nat, b :: nat, c :: nat
  prop divides (c * a) (c * b) ⟶ ¬(c = 0) ⟶ divides a b
  [hint_backward,hint_backward1]
  proof
    2: rewrite_fact divides_def @0 sym=false
    3: rewrite_goal divides_def sym=false
    3: exists_elim k @2
    5: rewrite_fact mult_assoc @4 sym=false
    6: rewrite_fact eq_mult_lcancel @5 sym=false
    7: apply_backward_step disjE @6
    7: introduction
    7.1: apply_backward_step negE_gen @1,7.0
    8: introduction
    8.1: inst_exists_goal k
  qed

theorem divides_lmul2_eq
  fixes a :: nat, b :: nat, c :: nat
  prop ¬(c = 0) ⟶ divides (c * a) (c * b) ⟷ divides a b
  [hint_backward]
  proof
    1: apply_backward_step iffI
    1: introduction
    1.1: apply_backward_step divides_cmul2 @1.0,0
    2: introduction
    2.1: apply_backward_step divides_mult_left @2.0
  qed

theorem divides_rmul2_eq
  fixes a :: nat, b :: nat, c :: nat
  prop ¬(c = 0) ⟶ divides (a * c) (b * c) ⟷ divides a b
  [hint_backward]
  proof
    1: rewrite_goal mult_comm sym=false
    1: apply_backward_step divides_lmul2_eq
  qed

theorem divides_divides_div
  fixes d :: nat, e :: nat, n :: nat
  prop divides d n ⟶ divides e (n DIV d) ⟷ divides (d * e) n
  [hint_backward]
  proof
    1: rewrite_fact divides_div_mult @0 sym=false
    2: rewrite_fact eq_sym_eq @1 sym=false
    3: apply_backward_step iffI
    3: introduction
    3.1: rewrite_goal_with_prev @2
    3.1: cut "n DIV d * d = d * (n DIV d)"
    3.1: nat_norm
    3.2: rewrite_goal_with_prev @3.1
    3.2: apply_backward_step divides_mult_left
    4: introduction
    4.1: cases "d=0"
    4.1: introduction
    4.1.1: rewrite_goal_with_prev @4.1.0
    4.1.1: rewrite_goal div_zero sym=false
    4.1.1: apply_backward_step divides_zero
    4.2: introduction
    4.2.1: apply_backward_step divides_cmul2 param_c=d
    4.2.1: rewrite_goal mult_comm sym=false
    4.2.1: rewrite_goal_with_prev @1
    4.2.1: rewrite_goal mult_comm sym=false
  qed

theorem divides_divides_div_eq
  fixes d :: nat, e :: nat, n :: nat
  prop divides d n ∧ divides e (n DIV d) ⟷ divides (d * e) n
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_forward_step conjD1 @0.0
    0.2: apply_forward_step conjD2 @0.0
    0.3: apply_forward_step divides_divides_div @0.1 param_e=e
    0.4: rewrite_fact_with_prev @0.3,0.2
    1: introduction
    1.1: apply_backward_step conjI
    1.1: apply_backward_step divides_rmul2 param_x=e
    1.2: apply_forward_step divides_divides_div @1.1 param_e=e
    1.3: rewrite_goal_with_prev @1.2
  qed

theorem divides_cases
  fixes m :: nat, n :: nat
  prop divides n m ⟶ m = 0 ∨ m = n ∨ 2 * n ≤ m
  [hint_backward]
  proof
    1: cut "m = n | 2 * n <= m <--> m = n * 1 | n * 2 <= m"
    1: z3
    2: rewrite_goal_with_prev @1
    2: rewrite_fact divides_def @0 sym=false
    3: exists_elim k @2
    5: revert_intro @4
    4: induction k nat_induct
    4: introduction
    4.1: apply_backward_step disjI1
    4.1: rewrite_goal_with_prev @4.0
    4.1: rewrite_goal mult_0_right sym=false
    5: introduction k
    5.2: rewrite_fact mult_Suc_right @5.1 sym=false
    5.3: cases "k=0" @5.2
    5.3: introduction
    5.3.1: rewrite_fact_with_prev @5.3.0,5.2
    5.3.2: rewrite_fact mult_0_right @5.3.1 sym=false
    5.3.3: rewrite_fact add_0_right @5.3.2 sym=false
    5.3.4: apply_backward_step disjI2
    5.3.4: apply_backward_step disjI1
    5.3.4: rewrite_goal mult_1_right sym=false
    5.4: introduction
    5.4.1: apply_forward_step le_1_2 @5.4.0
    5.4.2: apply_backward_step disjI2
    5.4.2: apply_backward_step disjI2
    5.4.2: rewrite_goal_with_prev @5.2
    5.4.2: apply_backward_step less_eq_trans param_m="n + n * 1"
    5.4.2: rewrite_goal mult_1_right sym=false
    5.4.2: rewrite_goal mult_comm sym=false
    5.4.2: rewrite_goal mult_2 sym=false
    5.4.2: apply_backward_step less_eq_refl
    5.4.6: z3 @5.4.1
  qed

theorem divides_div_not
  fixes n :: nat, q :: nat, r :: nat, x :: nat
  prop x = q * n + r ⟶ 0 < r ⟶ r < n ⟶ ¬(divides n x)
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal_with_prev @0
    3: apply_forward_step divides_self param_n=n
    4: apply_forward_step divides_lmul @3 param_x=q
    5: apply_backward_step negI
    5: introduction
    5.1: apply_forward_step divides_sum2 @5.0,4
    5.2: apply_forward_step divides_le @5.1
    5.3: apply_backward_step contrapositive @5.2
    5.3: introduction
    5.3.1: rewrite_goal de_morgan_thm2 sym=false
    5.3.1: apply_backward_step conjI
    5.3.1: rewrite_goal not_le sym=false
    5.3.2: apply_backward_step contrapositive @1
    5.3.2: introduction
    5.3.2.1: rewrite_fact double_neg @5.3.2.0 sym=false
    5.3.2.2: rewrite_goal_with_prev @5.3.2.1
    5.3.2.2: rewrite_goal nat_less_def_1 sym=false
  qed

theorem divides_mul2
  fixes a :: nat, b :: nat, c :: nat, d :: nat
  prop divides a b ⟶ divides c d ⟶ divides (a * c) (b * d)
  [hint_backward,hint_backward1]
  proof
    2: rewrite_fact divides_def @0 sym=false
    3: rewrite_fact divides_def @1 sym=false
    4: exists_elim k1 @2
    6: exists_elim k2 @3
    8: rewrite_goal divides_def sym=false
    8: inst_exists_goal k1*k2
    8: rewrite_goal_with_prev @5
    8: rewrite_goal_with_prev @7
    8: nat_norm
  qed

theorem divides_exp
  fixes n :: nat, x :: nat, y :: nat
  prop divides x y ⟶ divides (x ^ n) (y ^ n)
  [hint_backward]
  proof
    1: rewrite_fact divides_def @0 sym=false
    2: exists_elim k @1
    4: rewrite_goal divides_def sym=false
    4: inst_exists_goal "k ^ n"
    4: rewrite_goal_with_prev @3
    4: rewrite_goal mult_exp sym=false
