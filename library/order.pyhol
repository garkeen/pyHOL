theory order
imports nat
description "Orders as explicit relations (phase 3 of the auto2 port)."

-- auto2 writes `'a::linorder` (and the `preorder`/`order` above it); here the
-- class is a predicate on the relation itself, so no type classes are needed:
-- the relation is an ordinary argument.  The `'a::C` annotation in a .pyhol
-- file is *sugar* for the corresponding predicate premise (syntax/parser.py),
-- i.e. the statement
--
--     fixes x :: 'a::linorder
--     prop x <= x
--
-- is stored as
--
--     linorder (less_eq::'a ⇒ 'a ⇒ bool) ⟶
--     linorder_lt (less::'a ⇒ 'a ⇒ bool) ⟶ x <= x
--
-- Both operations are constrained because holpy's `less` and `less_eq` are
-- independent overloaded constants (nat defines each by its own recursion).
-- The premises are discharged at the *use* site by the instance theorems below
-- (`nat_linorder`, `nat_linorder_lt`), so nothing below the item layer knows
-- about classes.  See PROGRAM_VERIFICATION_PORT.md §11 for the design and its
-- boundaries.

def preorder :: ('a ⇒ 'a ⇒ bool) ⇒ bool = preorder le ⟷ (∀x. le x x) ∧ (∀x. ∀y. ∀z. le x y ⟶ le y z ⟶ le x z) [hint_rewrite]

-- Which laws a class stands for is library content, declared here next to the
-- predicates: a `class` item registers the entries into the parser's class
-- registry, and a statement's `'a::C` annotation becomes one premise per
-- entry (syntax/parser.py: with_class_premises).  The declaration's operation
-- types are written for the class's own variable `'a`; at an annotation on
-- `'b` that variable is renamed.
--
-- The class hierarchy mirrors Isabelle's: `ord` fixes the two operations and
-- states no law, `preorder` is the lowest class with laws, and the law tying
-- `<` to `<=` (the compatibility axiom of Isabelle's `preorder`) belongs to
-- every class that has both operations.
class ord =

class preorder = preorder (less_eq :: 'a ⇒ 'a ⇒ bool)

def order :: ('a ⇒ 'a ⇒ bool) ⇒ bool = order le ⟷ preorder le ∧ (∀x. ∀y. le x y ⟶ le y x ⟶ x = y) [hint_rewrite]

class order = order (less_eq :: 'a ⇒ 'a ⇒ bool)

def linorder :: ('a ⇒ 'a ⇒ bool) ⇒ bool = linorder le ⟷ order le ∧ (∀x. ∀y. le x y ∨ le y x) [hint_rewrite]

class linorder = linorder (less_eq :: 'a ⇒ 'a ⇒ bool),
                 linorder_lt (less :: 'a ⇒ 'a ⇒ bool)

-- The strict companion of `linorder` (irreflexive, transitive, trichotomous).
-- A statement about `<` under `'a::linorder` uses these laws.
def linorder_lt :: ('a ⇒ 'a ⇒ bool) ⇒ bool = linorder_lt lt ⟷ (∀x. ¬(lt x x)) ∧ (∀x. ∀y. ∀z. lt x y ⟶ lt y z ⟶ lt x z) ∧ (∀x. ∀y. lt x y ∨ lt y x ∨ x = y) [hint_rewrite]

-- The law tying the two operations together: `lt` really is the strict part of
-- `le`.  In Isabelle this is an *axiom* of the class `preorder`
-- (`less_le_not_le: x < y ⟷ x ≤ y ∧ ¬(y ≤ x)`), inherited by `order`/`linorder`;
-- holpy's kernel has no class axioms, so the sugar injects it as a premise just
-- like `linorder` and `linorder_lt` (see the `class` declarations above).
--
-- It is not redundant: `linorder` and `linorder_lt` alone are satisfied by the
-- reversed strict order as well, which breaks the bridge (`lt 1 0` holds while
-- `1 ≤ 0` fails on nat, with `le` the usual `<=`).  So any lemma that mixes `<`
-- and `≤` (e.g. Isabelle's `strict_sorted_imp_sorted`) needs this premise.
def linorder_lt_le :: ('a ⇒ 'a ⇒ bool) ⇒ ('a ⇒ 'a ⇒ bool) ⇒ bool = linorder_lt_le le lt ⟷ (∀x. ∀y. lt x y ⟶ le x y) [hint_rewrite]

-- The law in the form a proof mixing `<` and `<=` needs, and the nat instance
-- (from nat's own bridge `lt_imp_le`).

theorem linorder_lt_imp_le
  fixes le :: 'a ⇒ 'a ⇒ bool, lt :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a
  prop linorder_lt_le le lt ⟶ lt x y ⟶ le x y
proof
  ← intro goal=0
    #[1] linorder_lt_le le lt
    #[2] lt x y
    #[3] le x y
  → rewrite linorder_lt_le_def sym=false target=fact goal=3 facts=[1]
    #[4] !x. !y. lt x y --> le x y
  ← inst x goal=3 facts=[4]
    #[5] !y. lt x y --> le x y
  ← inst y goal=3 facts=[5]
    #[6] lt x y --> le x y
  ← apply_prev goal=3 facts=[6,2]
qed

theorem nat_linorder_lt_le
  prop linorder_lt_le (less_eq :: nat ⇒ nat ⇒ bool) (less :: nat ⇒ nat ⇒ bool)
proof
  ← rewrite linorder_lt_le_def sym=false goal=0
    #[1] !x::nat. !y. x < y --> x <= y
  ← intro x,y goal=1
    #[2] _VAR x
    #[3] _VAR y
    #[4] x < y
    #[5] x <= y
  ← rule lt_imp_le goal=5 facts=[4]
qed

theorem preorder_refl
  fixes le :: 'a ⇒ 'a ⇒ bool, x :: 'a
  prop preorder le ⟶ le x x
proof
  ← intro goal=0
  → rewrite target=fact preorder_def sym=false goal=2 facts=[1]
  → forward conjD1 goal=2 facts=[3]
  ← apply_prev goal=2 facts=[4]
qed

theorem preorder_trans
  fixes le :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a, z :: 'a
  prop preorder le ⟶ le x y ⟶ le y z ⟶ le x z
proof
  ← intro goal=0
  → rewrite target=fact preorder_def sym=false goal=4 facts=[1]
  → forward conjD2 goal=4 facts=[5]
  → inst "x" goal=4 facts=[6]
  → inst "y" goal=4 facts=[7]
  → inst "z" goal=4 facts=[8]
  ← apply_prev goal=4 facts=[9,2,3]
qed

theorem order_preorder
  fixes le :: 'a ⇒ 'a ⇒ bool
  prop order le ⟶ preorder le
proof
  ← intro goal=0
  → rewrite target=fact order_def sym=false goal=2 facts=[1]
  → forward conjD1 goal=2 facts=[3]
qed

theorem order_antisym
  fixes le :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a
  prop order le ⟶ le x y ⟶ le y x ⟶ x = y
proof
  ← intro goal=0
  → rewrite target=fact order_def sym=false goal=4 facts=[1]
  → forward conjD2 goal=4 facts=[5]
  → inst "x" goal=4 facts=[6]
  → inst "y" goal=4 facts=[7]
  ← apply_prev goal=4 facts=[8,2,3]
qed

theorem linorder_order
  fixes le :: 'a ⇒ 'a ⇒ bool
  prop linorder le ⟶ order le
proof
  ← intro goal=0
  → rewrite target=fact linorder_def sym=false goal=2 facts=[1]
  → forward conjD1 goal=2 facts=[3]
qed

theorem linorder_total
  fixes le :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a
  prop linorder le ⟶ le x y ∨ le y x
proof
  ← intro goal=0
  → rewrite target=fact linorder_def sym=false goal=2 facts=[1]
  → forward conjD2 goal=2 facts=[3]
  ← apply_prev goal=2 facts=[4]
qed

-- The `linorder` laws in the form a proof usually needs: the constraint is
-- unfolded once through the hierarchy, so callers do not repeat the descent.

theorem linorder_refl
  fixes le :: 'a ⇒ 'a ⇒ bool, x :: 'a
  prop linorder le ⟶ le x x
proof
  ← intro goal=0
  → rewrite target=fact linorder_def sym=false goal=2 facts=[1]
  → forward conjD1 goal=2 facts=[3]
  → rewrite target=fact order_def sym=false goal=2 facts=[4]
  → forward conjD1 goal=2 facts=[5]
  → rewrite target=fact preorder_def sym=false goal=2 facts=[6]
  → forward conjD1 goal=2 facts=[7]
  ← apply_prev goal=2 facts=[8]
qed

theorem linorder_trans
  fixes le :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a, z :: 'a
  prop linorder le ⟶ le x y ⟶ le y z ⟶ le x z
proof
  ← intro goal=0
  → rewrite target=fact linorder_def sym=false goal=4 facts=[1]
  → forward conjD1 goal=4 facts=[5]
  → rewrite target=fact order_def sym=false goal=4 facts=[6]
  → forward conjD1 goal=4 facts=[7]
  → rewrite target=fact preorder_def sym=false goal=4 facts=[8]
  → forward conjD2 goal=4 facts=[9]
  ← apply_prev goal=4 facts=[10,2,3]
qed

theorem linorder_antisym
  fixes le :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a
  prop linorder le ⟶ le x y ⟶ le y x ⟶ x = y
proof
  ← intro goal=0
  → rewrite target=fact linorder_def sym=false goal=4 facts=[1]
  → forward conjD1 goal=4 facts=[5]
  → rewrite target=fact order_def sym=false goal=4 facts=[6]
  → forward conjD2 goal=4 facts=[7]
  ← apply_prev goal=4 facts=[8,2,3]
qed

-- The strict-order laws, in the form a proof about `<` needs.

theorem linorder_lt_irrefl
  fixes lt :: 'a ⇒ 'a ⇒ bool, x :: 'a
  prop linorder_lt lt ⟶ ~(lt x x)
proof
  ← intro goal=0
  → rewrite linorder_lt_def sym=false target=fact goal=2 facts=[1]
  → forward conjD1 goal=2 facts=[3]
  ← apply_prev goal=2 facts=[4]
qed

theorem linorder_lt_trans
  fixes lt :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a, z :: 'a
  prop linorder_lt lt ⟶ lt x y ⟶ lt y z ⟶ lt x z
proof
  ← intro goal=0
  → rewrite linorder_lt_def sym=false target=fact goal=4 facts=[1]
  → forward conjD2 goal=4 facts=[5]
  → forward conjD1 goal=4 facts=[6]
  → inst "x" goal=4 facts=[7]
  → inst "y" goal=4 facts=[8]
  → inst "z" goal=4 facts=[9]
  ← apply_prev goal=4 facts=[10,2,3]
qed

theorem linorder_lt_linear
  fixes lt :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a
  prop linorder_lt lt ⟶ lt x y | lt y x | x = y
proof
  ← intro goal=0
  → rewrite linorder_lt_def sym=false target=fact goal=2 facts=[1]
  → forward conjD2 goal=2 facts=[3]
  → forward conjD2 goal=2 facts=[4]
  ← apply_prev goal=2 facts=[5]
qed

theorem linorder_lt_neq
  fixes lt :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a
  prop linorder_lt lt ⟶ lt x y ⟶ ~(x = y)
proof
  ← intro goal=0
    #[1] linorder_lt lt
    #[2] lt x y
    #[3] ~(x = y)
  → rewrite linorder_lt_def sym=false target=fact goal=3 facts=[1]
    #[4] (!x. ~(lt x x)) & (!x. !y. !z. lt x y --> lt y z --> lt x z) & (!x. !y. lt x y | lt y x | x = y)
  → forward conjD1 goal=3 facts=[4]
    #[5] !x. ~(lt x x)
  ← rule negI goal=3
    #[6] x = y --> false
  ← intro goal=6
    #[7] x = y
    #[8] false
  ← inst y goal=8 facts=[5]
    #[9] ~(lt y y)
  → rewrite source=prev target=fact goal=8 facts=[7,2]
    #[10] lt y y
  ← rule negE_gen goal=8 facts=[9,10]
qed

-- `~lt x y` and `x ≠ y` together give the other direction.  (Eliminate the
-- trichotomy with disj_comm + force_disj_true1, dropping the two known-false
-- branches; the port's §9.3 recipe.)
theorem linorder_lt_gt_of_not_lt
  fixes lt :: 'a ⇒ 'a ⇒ bool, x :: 'a, y :: 'a
  prop linorder_lt lt ⟶ ~(x = y) ⟶ ~(lt x y) ⟶ lt y x
proof
  ← intro goal=0
    #[1] linorder_lt lt
    #[2] ~(x = y)
    #[3] ~(lt x y)
    #[4] lt y x
  cut "lt x y | lt y x | x = y" goal=4
    #[5] lt x y | lt y x | x = y
  ← rule linorder_lt_linear goal=5 facts=[1]
    #[6] lt x y | lt y x | x = y
  → rewrite disj_comm sym=false target=fact goal=4 facts=[6]
    #[7] (lt y x | x = y) | lt x y
  → forward force_disj_true1 goal=4 facts=[7,3]
    #[8] lt y x | x = y
  → forward force_disj_true1 goal=4 facts=[8,2]
qed

-- Instances: `nat` is a linear order.  These are ordinary theorems; a future
-- `instance`/solver layer only needs to find one of them by name.

theorem nat_preorder
  prop preorder (less_eq :: nat ⇒ nat ⇒ bool)
proof
  ← rewrite preorder_def sym=false goal=0
  ← rule conjI goal=1
  ← intro x goal=2
  ← rule less_eq_refl goal=5
  ← intro x,y,z goal=3
  ← rule less_eq_trans goal=10 facts=[8,9]
qed

theorem nat_order
  prop order (less_eq :: nat ⇒ nat ⇒ bool)
proof
  ← rewrite order_def sym=false goal=0
  ← rule conjI goal=1
  → forward nat_preorder goal=2
  ← intro x,y goal=3
  ← rewrite le_antisym sym=true goal=8
  → forward conjI goal=9 facts=[6,7]
qed

theorem nat_linorder
  prop linorder (less_eq :: nat ⇒ nat ⇒ bool)
proof
  ← rewrite linorder_def sym=false goal=0
  ← rule conjI goal=1
  → forward nat_order goal=2
  ← intro x,y goal=3
  ← rule le_cases goal=6
qed

theorem nat_linorder_lt
  prop linorder_lt (less :: nat ⇒ nat ⇒ bool)
proof
  ← rewrite linorder_lt_def sym=false goal=0
    #[1] (!x::nat. ~(x < x)) & (!x::nat. !y. !z. x < y --> y < z --> x < z) & (!x::nat. !y. x < y | y < x | x = y)
  ← rule conjI goal=1
    #[2] !x::nat. ~(x < x)
    #[3] (!x::nat. !y. !z. x < y --> y < z --> x < z) & (!x::nat. !y. x < y | y < x | x = y)
  ← intro x goal=2
    #[4] _VAR x
    #[5] ~(x < x)
  ← rule less_irrefl goal=5
  ← rule conjI goal=3
    #[6] !x::nat. !y. !z. x < y --> y < z --> x < z
    #[7] !x::nat. !y. x < y | y < x | x = y
  ← intro x,y,z goal=6
    #[8] _VAR y
    #[9] _VAR z
    #[10] x < y
    #[11] y < z
    #[12] x < z
  ← rule lt_trans goal=12 facts=[10,11]
  ← intro x,y goal=7
    #[13] x < y | y < x | x = y
  ← rule lt_cases goal=13
qed

-- End-to-end demonstration of the sugar: `linorder_le_refl` is stated the way
-- auto2 states it, and `nat_le_refl` uses it at `nat` by discharging the class
-- premise with the instance theorem.

theorem linorder_le_refl
  fixes x :: 'a::linorder
  prop x <= x
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] x <= x
  ← rule linorder_refl goal=3 facts=[1]
    #[4] x <= x
qed

theorem nat_le_refl
  fixes x :: nat
  prop x <= x
proof
  → forward nat_linorder goal=0
  ← rule linorder_refl goal=0 facts=[1]
qed
