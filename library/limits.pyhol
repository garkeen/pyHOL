theory limits
imports real
description "limits"

def has_limit :: (nat ⇒ real) ⇒ real ⇒ bool = has_limit f x ⟷ (∀e. 0 < e ⟶ (∃N. ∀n. N ≤ n ⟶ abs (f n - x) < e))

theorem has_limit_D1
  fixes e :: real, f :: nat ⇒ real, x :: real
  prop has_limit f x ⟶ 0 < e ⟶ (∃N. ∀n. N ≤ n ⟶ abs (f n - x) < e)
  [hint_forward]
  proof
    2: rewrite_fact has_limit_def @0
    3: apply_prev @2,1
  qed

theorem has_limit_D2
  fixes e :: real, f :: nat ⇒ real, x :: real
  prop has_limit f x ⟶ 0 < e ⟶ (∃n. abs (f n - x) < e)
  proof
    2: apply_forward_step has_limit_D1 @0,1
    3: exists_elim n @2
    5: inst_exists_goal n
    5: apply_prev @4
  qed

theorem has_limit_unique
  fixes f :: nat ⇒ real, x :: real, y :: real
  prop has_limit f x ⟶ has_limit f y ⟶ x = y
  proof
    2: apply_backward_step real_eqI_from_lt_gt
    2: introduction ""
    3: introduction ""
    2.1: apply_forward_step has_limit_D2 @0 param_e="y - x"
  qed

theorem has_limit_add
  fixes f :: nat ⇒ real, g :: nat ⇒ real, x :: real, y :: real
  prop has_limit f x ⟶ has_limit g y ⟶ has_limit (λn. f n + g n) (x + y)
  proof
    2: rewrite_goal has_limit_def
    2: introduction e
  qed
