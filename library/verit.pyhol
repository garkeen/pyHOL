theorem verit_imp_simplify3
  fixes P :: bool
  prop (P --> true) <--> true

theorem verit_imp_simplify4
  fixes P :: bool
  prop (true --> P) <--> P

theorem verit_imp_simplify5
  fixes P :: bool
  prop (P --> false) <--> ~P

theorem verit_imp_simplify6
  fixes P :: bool
