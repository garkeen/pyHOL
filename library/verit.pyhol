theory verit
imports real
description "Schematic verit proof rule."

theorem forall_inst
  fixes P :: 'a => bool, x :: 'a
  prop ~(!x1. P x1) | P x

theorem or_pos
  fixes P :: bool
  prop ~P | P

theorem disj_swap_eq
  fixes P :: bool, Q :: bool, R :: bool
  prop P | Q | R <--> Q | P | R

theorem equiv1
  fixes P :: bool, Q :: bool
  prop P <--> Q --> ~P | Q

theorem equiv2
  fixes P :: bool, Q :: bool
  prop P <--> Q --> P | ~Q

theorem not_equiv1
  fixes P :: bool, Q :: bool
  prop ~(P <--> Q) --> P | Q

theorem not_equiv2
  fixes P :: bool, Q :: bool
  prop ~(P <--> Q) --> ~P | ~Q

theorem equiv_pos1
  fixes P :: bool, Q :: bool
  prop ~(P <--> Q) | P | ~Q

theorem equiv_pos2
  fixes P :: bool, Q :: bool
  prop ~(P <--> Q) | ~P | Q

theorem equiv_neg1
  fixes P :: bool, Q :: bool
  prop (P <--> Q) | ~P | ~Q

theorem equiv_neg2
  fixes P :: bool, Q :: bool
  prop (P <--> Q) | P | Q

theorem tmp_LA_pre_int
  fixes x :: int, y :: int
  prop x = y <--> x <= y & y <= x

theorem not_implies1
  fixes P :: bool, Q :: bool
  prop ~(P --> Q) --> P

theorem not_implies2
  fixes P :: bool, Q :: bool
  prop ~(P --> Q) --> ~Q

theorem verit_ite1
  fixes P :: bool, Q :: bool, R :: bool
  prop (if P then Q else R) --> P | R

theorem verit_ite2
  fixes P :: bool, Q :: bool, R :: bool
  prop (if P then Q else R) --> ~P | Q

theorem verit_not_ite1
  fixes P :: bool, Q :: bool, R :: bool
  prop ~(if P then Q else R) --> P | ~R

theorem verit_not_ite2
  fixes P :: bool, Q :: bool, R :: bool
  prop ~(if P then Q else R) --> ~P | ~Q

theorem la_disequality_int
  fixes a :: int, b :: int
  prop a = b | ~(a <= b) | ~(b <= a)

theorem la_disequality_real
  fixes a :: real, b :: real
  prop a = b | ~(a <= b) | ~(b <= a)

theorem neg_neg
  fixes A :: bool
  prop ~~~A | A

fun let :: 'a ⇒ ('a ⇒ 'b) ⇒ 'b
  | let s f = f s

theorem connective_def1
  fixes P :: bool, Q :: bool
  prop (P <--> Q) <--> (P --> Q) & (Q --> P)

theorem verit_ite_intro
  fixes P :: bool, x :: 'a, y :: 'a
  prop if P then x = (if P then x else y) else y = (if P then x else y)

theorem verit_eq_conj
  fixes P :: bool, Q :: bool
  prop Q --> P <--> P & Q
proof
  ← introduction goal=0
    #[1] Q
    #[2] P ⟷ P ∧ Q
  ← apply_backward_step iffI goal=2
    #[3] P ⟶ P ∧ Q
    #[4] P ∧ Q ⟶ P
  ← introduction goal=3
    #[5] P
    #[6] P ∧ Q
  ← apply_backward_step conjI goal=6 facts=[5]
  ← introduction goal=4
    #[7] P ∧ Q
    #[8] P
  ← apply_backward_step conjD1 goal=8 facts=[7]
    #[9] P
qed

theorem verit_implies_neg1
  fixes P :: bool, Q :: bool
  prop (P --> Q) | P

theorem verit_implies_neg2
  fixes P :: bool, Q :: bool
  prop (P --> Q) | ~Q

theorem verit_not_simplify1
  prop ~true <--> false

theorem verit_not_simplify2
  prop ~false <--> true

theorem verit_minus_simplify_3_real
  fixes t :: real
  prop t = t - 0

theorem verit_minus_simplify_3_int
  fixes t :: int
  prop t = t - 0

theorem verit_minus_simplify_4_real
  fixes t :: real
  prop 0 - t = -t

theorem verit_minus_simplify_4_int
  fixes t :: int
  prop 0 - t = -t

theorem verit_bool_simplify1
  fixes P :: bool, Q :: bool
  prop ~(P --> Q) <--> P & ~Q

theorem verit_bool_simplify4
  fixes P :: bool, Q :: bool, R :: bool
  prop (P --> Q --> R) <--> (P & Q --> R)

theorem verit_bool_simplify5
  fixes P :: bool, Q :: bool
  prop ((P --> Q) --> Q) <--> P | Q

theorem verit_bool_simplify6
  fixes P :: bool, Q :: bool
  prop P & (P --> Q) <--> P & Q

theorem verit_bool_simplify7
  fixes P :: bool, Q :: bool
  prop (P --> Q) & P <--> P & Q

theorem verit_equiv_simplify1
  fixes P :: bool, Q :: bool
  prop (~P <--> ~Q) <--> P <--> Q

theorem verit_equiv_simplify2
  fixes P :: bool
  prop (P <--> P) <--> true

theorem verit_equiv_simplify3
  fixes P :: bool
  prop (P <--> ~P) <--> false

theorem verit_equiv_simplify4
  fixes P :: bool
  prop (~P <--> P) <--> false

theorem verit_equiv_simplify5
  fixes P :: bool
  prop (true <--> P) <--> P

theorem verit_equiv_simplify6
  fixes P :: bool
  prop (P <--> true) <--> P
proof
  ← apply_backward_step iffI goal=0
    #[1] P ⟷ true ⟶ P
    #[2] P ⟶ P ⟷ true
  ← introduction goal=1
    #[3] P ⟷ true
    #[4] P
  ← rewrite_goal_with_prev goal=4 facts=[3]
    #[5] true
  ← apply_backward_step trueI goal=5
    #[6] true
  ← introduction goal=2
    #[7] P
    #[8] P ⟷ true
  ← apply_backward_step iffI goal=8
    #[9] P ⟶ true
    #[10] true ⟶ P
  ← introduction goal=9
    #[11] true
  ← apply_backward_step trueI goal=11
  ← introduction goal=10
    #[12] true
qed

theorem verit_equiv_simplify7
  fixes P :: bool
  prop (false <--> P) <--> ~P

theorem verit_equiv_simplify8
  fixes P :: bool
  prop (P <--> false) <--> ~P

theorem verit_conj_pos_neg
  fixes P :: bool
  prop P & ~P --> false

theorem verit_lw_rw_eq_real
  fixes x :: real, y :: real
  prop x = y <--> x <= y & y <= x
proof
  ← rewrite_goal real_le_antisym sym=false goal=0
qed

theorem verit_lw_rw_eq_int
  fixes x :: int, y :: int
  prop x = y <--> x <= y & y <= x

theorem verit_ite_pos1
  fixes P :: bool, Q :: bool, R :: bool
  prop ~(if P then Q else R) | P | R

theorem verit_ite_pos2
  fixes P :: bool, Q :: bool, R :: bool
  prop ~(if P then Q else R) | ~P | Q

theorem verit_ite_neg1
  fixes P :: bool, Q :: bool, R :: bool
  prop (if P then Q else R) | P | ~R

theorem verit_ite_neg2
  fixes P :: bool, Q :: bool, R :: bool
  prop (if P then Q else R) | ~P | ~Q

theorem verit_bfun_elim_exists
  fixes t :: bool => bool, x :: bool
  prop (?x. t x) <--> t false | t true

theorem verit_bfun_elim_forall
  fixes t :: bool => bool, x :: bool
  prop (!x. t x) <--> t false & t true

theorem verit_bfun_elim
  fixes f :: bool => 'a, t :: bool
  prop f t = (if t then f true else f false)

theorem verit_ite_apply
  fixes P :: bool, f :: 'a => 'b, g :: 'a => 'b, x :: 'a
  prop (if P then f else g) x = (if P then f x else g x)
proof
  ← rewrite_goal cond_rator sym=false goal=0
qed

theorem verit_la_generic_neg_greater_int1
  fixes x :: int, y :: int
  prop ~(x > y) <--> ~(y < x)

theorem verit_la_generic_neg_greater_eq_int1
  fixes x :: int, y :: int
  prop ~(x >= y) <--> ~(y <= x)

theorem verit_la_generic_neg_greater_int2
  fixes x :: int, y :: int
  prop ~(x > y) <--> x <= y

theorem verit_la_generic_neg_greater_eq_int2
  fixes x :: int, y :: int
  prop ~(x >= y) <--> x < y

theorem imp_false_false
  fixes P :: bool
  prop (P --> false) <--> ~P

theorem zero_eq_mul_const
  fixes c :: int, m :: int, n :: int
  prop m = n --> c * m = c * n

theorem add_equals
  fixes a :: int, b :: int, x :: int, y :: int
  prop x = y --> a = b --> x + a = y + b

theorem add_eq_with_ge
  fixes a :: int, b :: int, x :: int, y :: int
  prop x = y --> a >= b --> x + a >= y + b

theorem add_ge_with_eq
  fixes a :: int, b :: int, x :: int, y :: int
  prop x >= y --> a = b --> x + a >= y + b

theorem add_ge_with_ge
  fixes a :: int, b :: int, x :: int, y :: int
  prop x >= y --> a >= b --> x + a >= y + b

theorem verit_comp_simplify2
  fixes x :: int
  prop x < x <--> false

theorem verit_comp_simplify4
  fixes x :: int, y :: int
  prop x <= x <--> true

theorem verit_comp_simplify5
  fixes x :: int, y :: int
  prop x >= y <--> y <= x
proof
  ← rewrite_goal greater_eq_def sym=false goal=0
qed

theorem verit_comp_simplify6
  fixes x :: int, y :: int
  prop x < y <--> ~(y <= x)

theorem verit_comp_simplify7
  fixes x :: int, y :: int
  prop x > y <--> ~(x <= y)

theorem verit_comp_simplify2_real
  fixes x :: real
  prop x < x <--> false

theorem verit_comp_simplify4_real
  fixes x :: real, y :: real
  prop x <= x <--> true

theorem verit_comp_simplify5_real
