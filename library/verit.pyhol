  prop x > y <--> ~(x <= y)

theorem verit_la_disequality_int
  fixes x :: int, y :: int
  prop x = y | ~(x <= y) | ~(y <= x)

theorem verit_ite_simplify1
  fixes t1 :: 'a, t2 :: 'a
  prop (if true then t1 else t2) = t1
proof
  ← rewrite_goal if_true sym=false goal=0
qed

theorem verit_ite_simplify2
  fixes t1 :: 'a, t2 :: 'a
  prop (if false then t1 else t2) = t2

theorem verit_ite_simplify3
  fixes P :: bool, t :: 'a
  prop (if P then t else t) = t

theorem verit_ite_simplify4
  fixes P :: bool, t1 :: 'a, t2 :: 'a
  prop (if ~P then t1 else t2) = (if P then t2 else t1)

theorem verit_ite_simplify7
  fixes P :: bool, t1 :: 'a, t2 :: 'a, t3 :: 'a
  prop (if P then if P then t1 else t2 else t3) = (if P then t1 else t3)

theorem verit_ite_simplify8
  fixes P :: bool, t1 :: 'a, t2 :: 'a, t3 :: 'a
  prop (if P then t1 else if P then t2 else t3) = (if P then t1 else t3)

theorem verit_ite_simplify9
  fixes P :: bool
  prop (if P then true else false) <--> P

theorem verit_ite_simplify10
  fixes P :: bool
  prop (if P then false else true) <--> ~P

theorem verit_ite_simplify11
  fixes P :: bool, Q :: bool
  prop (if P then true else Q) <--> P | Q

theorem verit_ite_simplify12
  fixes P :: bool, Q :: bool
  prop (if P then Q else false) <--> P & Q

theorem verit_ite_simplify13
  fixes P :: bool, Q :: bool
  prop (if P then false else Q) <--> ~P & Q

theorem verit_ite_simplify14
