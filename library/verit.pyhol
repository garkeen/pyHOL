  prop x = 0 --> y > 0 --> x + y > 0

theorem verit_real_add_eq_ge
  fixes x :: real, y :: real
  prop x = 0 --> y >= 0 --> x + y >= 0

theorem verit_real_add_gt_gt
  fixes x :: real, y :: real
  prop x > 0 --> y > 0 --> x + y > 0

theorem verit_real_add_gt_ge
  fixes x :: real, y :: real
  prop x > 0 --> y >= 0 --> x + y > 0

theorem verit_real_add_ge_ge
  fixes x :: real, y :: real
  prop x >= 0 --> y >= 0 --> x + y >= 0

theorem verit_la_disequality_real
  fixes x :: real, y :: real
  prop x = y | ~(x <= y) | ~(y <= x)

theorem verit_xor_pos1
  fixes P :: bool, Q :: bool
  prop ~(xor P Q) | P | Q

theorem verit_xor_pos2
  fixes P :: bool, Q :: bool
  prop ~(xor P Q) | ~P | ~Q

theorem verit_xor_neg1
  fixes P :: bool, Q :: bool
  prop xor P Q | P | ~Q

theorem verit_xor_neg2
  fixes P :: bool, Q :: bool
  prop xor P Q | ~P | Q

theorem verit_some_eq_ex
  fixes P :: 'a => bool
  prop P (SOME x. P x) <--> (?x. P x)

theorem verit_some_neg_eq_all
  fixes P :: 'a => bool
  prop P (SOME x. ~(P x)) <--> (!x. P x)

theorem verit_connective_def1
  fixes P :: bool, Q :: bool
  prop xor P Q <--> ~P & Q | P & ~Q

theorem verit_connective_def2
  fixes P :: bool, Q :: bool
  prop (P <--> Q) <--> (P --> Q) & (Q --> P)

theorem verit_connective_def3
  fixes P :: bool, Q :: bool, R :: bool
  prop (if P then Q else R) <--> (P --> Q) & (~P --> R)

theorem verit_connective_def4
  fixes P :: 'a => bool, a :: 'a
  prop (?a. P a) <--> ~(!a. ~(P a))

theorem verit_not_iff_eq
  fixes A :: bool, B :: bool
  prop ~(A <--> B) <--> A & ~B | ~A & B

theorem verit_iff_eq
  fixes A :: bool, B :: bool
  prop (A <--> B) <--> (~A | B) & (~B | A)

theorem verit_not_ite_eq
  fixes P :: bool, Q :: bool, R :: bool
  prop ~(if P then Q else R) <--> P & ~Q | ~P & R

theorem verit_ite_eq
  fixes P :: bool, Q :: bool, R :: bool
  prop (if P then Q else R) <--> (~P | Q) & (P | R)

theorem verit_qnt_conj1
  fixes P :: 'a => bool, Q :: bool
  prop (!x. P x) & Q <--> (!x. P x & Q)

theorem verit_qnt_conj2
  fixes P :: bool, Q :: 'a => bool
  prop P & (!x. Q x) <--> (!x. P & Q x)

theorem verit_qnt_disj1
  fixes P :: 'a => bool, Q :: bool
  prop (!x. P x) | Q <--> (!x. P x | Q)

theorem verit_qnt_disj2
  fixes P :: bool, Q :: 'a => bool
  prop P | (!x. Q x) <--> (!x. P | Q x)

theorem verit_onepoint_forall
  fixes P :: 'a => bool, t :: 'a
  prop (!x. ~(x = t) | P x) <--> ~(t = t) | P t

theorem verit_onepoint_forall_single
  fixes t :: 'a
  prop (!x. ~(x = t)) <--> ~(t = t)

theorem verit_onepoint_exists
  fixes P :: 'a => bool, t :: 'a
  prop (?x. x = t & P x) <--> t = t & P t

theorem verit_onepoint_exists_single
  fixes t :: 'a
  prop (?x. x = t) <--> t = t

def store :: ('a ⇒ 'b) ⇒ 'a ⇒ 'b ⇒ 'a ⇒ 'b = store array i v = (λj. if j = i then v else array j)

def select :: ('a ⇒ 'b) ⇒ 'a ⇒ 'b = select f a = f a

theorem verit_eq_simplify
  fixes t :: 'a
  prop ~(t = t) <--> false

theorem verit_rm_unused_forall
  fixes P :: bool
  prop (!x::'a. P) <--> P

theorem verit_rm_unused_exists
  fixes P :: bool
  prop (?x::'a. P) <--> P

theorem verit_int_add_gt_move_right
  fixes c :: int, x :: int
  prop c + x > 0 <--> x > -c

theorem verit_int_add_ge_move_right
  fixes c :: int, x :: int
  prop c + x >= 0 <--> x >= -c

theorem verit_int_add_eq_move_right
  fixes c :: int, x :: int
  prop c + x = 0 <--> x = -c

theorem verit_round_lia_gcd
  fixes c :: int, k :: int, lb :: int, x :: int
  prop k > 0 --> k * x >= c --> k * lb < c --> k * lb + k > c --> k * x >= k * lb + k

