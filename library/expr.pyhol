theory expr
imports function
domains expr
description "Expressions"

header "Arithmetic expressions"

datatype aexp =
  | N (n :: nat) :: aexp
  | V (x :: nat) :: aexp
  | Plus (a1 :: aexp) (a2 :: aexp) :: aexp
  | Times (c1 :: aexp) (c2 :: aexp) :: aexp

fun aval :: aexp ⇒ (nat ⇒ nat) ⇒ nat
  | aval (N n) s = n
  | aval (V x) s = s x
  | aval (Plus a1 a2) s = aval a1 s + aval a2 s
  | aval (Times c1 c2) s = aval c1 s * aval c2 s

theorem aval_test1
  prop aval (Plus (V 1) (N 5)) ((%x. 0)(1 := 7)) = 12
proof
  ← rewrite aval_def_3 goal=0
    #[1] aval (V 1) ((λx. 0)(1 := 7)) + aval (N 5) ((λx. 0)(1 := 7)) = 12
  ← rewrite aval_def_1 goal=1
    #[2] aval (V 1) ((λx. 0)(1 := 7)) + 5 = 12
  ← rewrite aval_def_2 goal=2
    #[3] (λx::nat. (0::nat))(1 := 7) 1 + 5 = 12
  ← rewrite fun_upd_def goal=3
    #[4] (if (1::nat) = 1 then (7::nat) else 0) + 5 = 12
  cut "(1::nat) = 1" goal=4
    #[5] (1::nat) = 1
  ← rule eq_refl goal=5
  ← rewrite if_P goal=4 facts=[5]
    #[6] (7::nat) + 5 = 12
  nat_norm goal=6
qed

theorem aval_test2
  prop aval (Plus (V 0) (N 5)) ((%x. 0)(1 := 7)) = 5
proof
  ← rewrite aval_def_3 goal=0
    #[1] aval (V 0) ((λx. 0)(1 := 7)) + aval (N 5) ((λx. 0)(1 := 7)) = 5
  ← rewrite aval_def_1 goal=1
    #[2] aval (V 0) ((λx. 0)(1 := 7)) + 5 = 5
  ← rewrite aval_def_2 goal=2
    #[3] (λx::nat. (0::nat))(1 := 7) 0 + 5 = 5
  ← rewrite fun_upd_def goal=3
    #[4] (if (0::nat) = 1 then (7::nat) else 0) + 5 = 5
  cut "~(0::nat) = 1" goal=4
    #[5] ¬((0::nat) = 1)
  nat_const_ineq goal=5
  ← rewrite if_not_P goal=4 facts=[5]
    #[6] (0::nat) + 5 = 5
  ← rewrite nat_plus_def_1 goal=6
qed

inductive avalI :: (nat ⇒ nat) ⇒ aexp ⇒ nat ⇒ bool
  | avalI_const: avalI s (N n) n
  | avalI_var: avalI s (V x) (s x)
  | avalI_plus: avalI s a1 n1 ⟶ avalI s a2 n2 ⟶ avalI s (Plus a1 a2) (n1 + n2)
  | avalI_times: avalI s a1 n1 ⟶ avalI s a2 n2 ⟶ avalI s (Times a1 a2) (n1 * n2)

theorem avalI_test1
  prop avalI ((%x. 0)(1 := 7)) (Plus (V 1) (N 5)) 12

theorem avalI_test2
  prop avalI ((%x. 0)(1 := 7)) (Plus (V 0) (N 5)) 5

