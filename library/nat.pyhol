    1.2.1: cut "∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n"
    1.2.1: z3
    1.2.2: apply_prev @1.2.1
    1.2.2: introduction k
    1.2.2.1: cut "k ≤ m DIV n MOD p ⟷ k + p * ((m DIV n) DIV p) <= (m DIV n)"
    1.2.2.1: rewrite_goal add_comm sym=false
    1.2.2.1: apply_forward_step le_add_lcancel param_m="p * (m DIV n DIV p)" param_n=k param_p="m DIV n MOD p"
    1.2.2.2: rewrite_fact division_simp2 @1.2.2.1 sym=false
    1.2.2.3: rewrite_goal_with_prev @1.2.2.2
    1.2.2.5: rewrite_goal_with_prev @1.2.2.4
    1.2.2.5: rewrite_goal div_div sym=false
    1.2.2.5: cut "~(n * p = 0)"
    1.2.2.5: rewrite_goal mult_eq_0 sym=false
    1.2.2.5: rewrite_goal de_morgan_thm2 sym=false
    1.2.2.5: apply_backward_step conjI
    1.2.2.8: apply_forward_step division @1.2.2.7 param_m=m
    1.2.2.9: apply_forward_step conjD1 @1.2.2.8
    1.2.2.10: cut "m DIV n = ((n * p) * (m DIV (n * p)) + m MOD (n * p)) DIV n"
    1.2.2.10: rewrite_goal division_simp2 sym=false
    1.2.2.11: rewrite_goal_with_prev @1.2.2.10
    1.2.2.11: rewrite_goal mult_assoc sym=false
    1.2.2.11: apply_forward_step div_mult_add2 @1.2.0 param_a="p * (m DIV (n * p))" param_b="m MOD (n * p)"
    1.2.2.12: rewrite_goal_with_prev @1.2.2.11
    1.2.2.12: cut "k + p * (m DIV (n * p)) = p * (m DIV (n * p)) + k"
    1.2.2.12: nat_norm
    1.2.2.13: rewrite_goal_with_prev @1.2.2.12
    1.2.2.13: rewrite_goal le_add_lcancel sym=false
  qed

theorem mod_mult_mod
  fixes m :: nat, n :: nat, p :: nat
  prop m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
  [hint_rewrite]
  proof
    0: cases "n=0"
    0: introduction
    0.1: rewrite_goal_with_prev @0.0
    0.1: rewrite_goal nat_times_def_1 sym=false
    0.1: rewrite_goal nat_plus_def_1 sym=false
    1: introduction
    1.1: cases "p=0"
    1.1: introduction
    1.1.1: rewrite_goal_with_prev @1.1.0
    1.1.1: rewrite_goal mult_0_right sym=false
    1.1.1: rewrite_goal mod_zero sym=false
    1.1.1: rewrite_goal division_simp2 sym=false
    1.2: introduction
    1.2.1: apply_backward_step add_cancel_left param_x="n * (m DIV n DIV p * p)"
    1.2.1: rewrite_goal add_assoc sym=true
    1.2.1: rewrite_goal distrib_l sym=true
    1.2.1: rewrite_goal division_simp1 sym=false
    1.2.1: rewrite_goal division_simp2 sym=false
    1.2.1: cut "n * (m DIV n DIV p * p) = m DIV n DIV p * (n * p)"
    1.2.1: nat_norm
    1.2.2: rewrite_goal_with_prev @1.2.1
    1.2.2: rewrite_goal div_div sym=false
    1.2.2: rewrite_goal division_simp1 sym=false
  qed

theorem mod_mod_exp_min
  fixes m :: nat, n :: nat, p :: nat, x :: nat
  prop x MOD p ^ m MOD p ^ n = x MOD p ^ min m n
  proof
    0: cases "p=0"
    0: introduction
    0.1: rewrite_goal_with_prev @0.0
    0.1: rewrite_goal exp_zero sym=false
    0.1: rewrite_goal min_def sym=false
    0.1: cases "m=0"
    0.1: introduction
    0.1.1: rewrite_goal if_P @0.1.0 sym=false
    0.1.1: cases "m ≤ n"
    0.1.1: introduction
    0.1.1.1: rewrite_goal if_P @0.1.1.0 sym=false
    0.1.1.1: rewrite_goal if_P @0.1.0 sym=false
    0.1.1.1: rewrite_goal mod_1 sym=false
    0.1.1.1: rewrite_goal mod_0 sym=false
    0.1.2: introduction
    0.1.2.1: apply_backward_step negE_gen @0.1.2.0
    0.1.2.1: rewrite_goal_with_prev @0.1.0
    0.1.2.1: apply_backward_step le_0
    0.2: introduction
    0.2.1: rewrite_goal if_not_P @0.2.0 sym=false
    0.2.1: cases "m ≤ n"
    0.2.1: introduction
    0.2.1.1: rewrite_goal if_P @0.2.1.0 sym=false
    0.2.1.1: rewrite_goal if_not_P @0.2.0 sym=false
    0.2.1.1: rewrite_goal mod_zero sym=false
    0.2.1.1: cases "n = 0"
    0.2.1.1: introduction
    0.2.1.1.1: rewrite_fact_with_prev @0.2.1.1.0,0.2.1.0
    0.2.1.1.2: apply_backward_step negE_gen @0.2.0
    0.2.1.1.2: rewrite_fact nat_less_eq_def_1 @0.2.1.1.1 sym=false
    0.2.1.2: introduction
    0.2.1.2.1: rewrite_goal if_not_P @0.2.1.2.0 sym=false
    0.2.1.2.1: rewrite_goal mod_zero sym=false
    0.2.2: introduction
    0.2.2.1: rewrite_goal if_not_P @0.2.2.0 sym=false
    0.2.2.1: rewrite_goal mod_zero sym=false
    1: rewrite_goal min_def sym=false
    1: introduction
    1.1: cases "m ≤ n"
    1.1: introduction
    1.1.1: rewrite_goal if_P @1.1.0 sym=false
    1.1.1: rewrite_fact less_eq_exist @1.1.0 sym=false
    1.1.2: exists_elim d @1.1.1
    1.1.4: rewrite_goal_with_prev @1.1.3
    1.1.4: apply_backward_step mod_lt
    1.1.4: apply_backward_step lte_trans param_m="p ^ m"
    1.1.4: rewrite_goal mod_lt_eq_lt sym=false
    1.1.4: rewrite_goal exp_lt_0 sym=false
    1.1.4: apply_backward_step disjI1
    1.1.7: rewrite_goal le_exp sym=false
    1.1.7: rewrite_goal if_not_P @1.0 sym=false
    1.1.7: apply_backward_step disjI2
    1.1.7: apply_backward_step le_add
    1.2: introduction
    1.2.1: rewrite_goal if_not_P @1.2.0 sym=false
    1.2.1: rewrite_fact not_le @1.2.0 sym=false
    1.2.2: apply_forward_step lt_imp_le @1.2.1
    1.2.3: rewrite_fact less_eq_exist @1.2.2 sym=false
    1.2.4: exists_elim d @1.2.3
    1.2.6: rewrite_goal_with_prev @1.2.5
    1.2.6: rewrite_goal nat_power_add sym=false
    1.2.6: rewrite_goal mod_mod sym=false
  qed

theorem div_exp
  fixes m :: nat, n :: nat, p :: nat
  prop ¬(m = 0) ⟶ m ^ n DIV m ^ p = (if p ≤ n then m ^ (n - p) else if m = 1 then 1 else 0)
  [hint_backward]
  proof
    1: cases "p ≤ n"
    1: introduction
    1.1: rewrite_goal if_P @1.0 sym=false
    1.1: apply_backward_step div_uniq param_r="(0::nat)"
    1.1: rewrite_goal add_0_right sym=false
    1.1: rewrite_goal nat_power_add sym=true
    1.1: apply_forward_step sub_add @1.0
    1.2: rewrite_goal_with_prev @1.1
    1.5: rewrite_goal exp_lt_0 sym=false
    1.5: apply_backward_step disjI1
    2: introduction
    2.1: rewrite_goal if_not_P @2.0 sym=false
    2.1: cases "m =1"
    2.1: introduction
    2.1.1: rewrite_goal if_P @2.1.0 sym=false
    2.1.1: rewrite_goal_with_prev @2.1.0
    2.1.1: rewrite_goal exp_one sym=false
    2.1.1: rewrite_goal div_1 sym=false
    2.2: introduction
    2.2.1: rewrite_goal if_not_P @2.2.0 sym=false
    2.2.1: apply_backward_step div_lt
    2.2.1: rewrite_goal lt_exp sym=false
    2.2.1: apply_backward_step disjI1
    2.2.1: apply_backward_step conjI
    2.2.1: z3 @2.2.0,0
    2.2.2: rewrite_fact not_le @2.0 sym=false
  qed

theorem mod_exp
  fixes m :: nat, n :: nat, p :: nat
  prop ¬(m = 0) ⟶ m ^ n MOD m ^ p = (if p ≤ n ∨ m = 1 then 0 else m ^ n)
  [hint_backward]
  proof
    1: cases "p ≤ n ∨ m = 1"
    1: introduction
    1.1: rewrite_goal if_P @1.0 sym=false
    1.1: apply_backward_step disjE @1.0
    1.1: introduction
    1.1.1: rewrite_goal mod_eq_0 sym=false
    1.1.1: inst_exists_goal "m ^ (n-p)"
    1.1.1: rewrite_goal nat_power_add sym=true
    1.1.1: apply_forward_step sub_add @1.1.0
    1.1.2: rewrite_goal_with_prev @1.1.1
    1.2: introduction
    1.2.1: rewrite_goal_with_prev @1.2.0
    1.2.1: rewrite_goal exp_one sym=false
    1.2.1: rewrite_goal mod_1 sym=false
    2: introduction
    2.1: rewrite_goal if_not_P @2.0 sym=false
    2.1: rewrite_goal mod_eq_self sym=false
    2.1: apply_backward_step disjI2
    2.1: rewrite_goal lt_exp sym=false
    2.1: apply_backward_step disjI1
    2.1: apply_backward_step conjI
    2.1: rewrite_fact de_morgan_thm2 @2.0 sym=false
    2.2: apply_forward_step conjD1 @2.1
    2.3: apply_forward_step conjD2 @2.1
    2.4: cut "2 = Suc 1"
    2.4: rewrite_goal add_1_right sym=true
    2.4: rewrite_goal mult_2 sym=true
    2.4: rewrite_goal mult_1_right sym=false
    2.7: rewrite_goal_with_prev @2.6
    2.7: rewrite_goal nat_one_def sym=false
    2.7: rewrite_goal lesseq_Suc_less sym=false
    2.7: rewrite_goal not_le sym=true
    2.7: rewrite_goal le_lt sym=false
    2.7: rewrite_goal de_morgan_thm2 sym=false
    2.7: rewrite_goal less_Suc_lesseq sym=false
    2.7: apply_backward_step conjI
    2.7: rewrite_goal nat_less_eq_def_1 sym=false
    2.8: rewrite_goal add_1_right sym=true
    2.8: rewrite_goal nat_plus_def_1 sym=false
    2.18: rewrite_fact not_le @2.2 sym=false
  qed
