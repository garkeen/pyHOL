    16.5: apply_backward_step conjI
    16.5: z3 @0,16.4
    16.6: rewrite_goal double_neg sym=false
    16.6: inst_exists_goal q+1
    16.6: rewrite_goal_with_prev @15
    16.6: rewrite_goal_with_prev @16.4
    16.6: nat_norm
  qed

