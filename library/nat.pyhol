  ← rule lt_trans param_m="1 * x ^ (m + Suc p)" goal=165
    #[166] x ^ m < 1 * x ^ (m + Suc p)
    #[167] 1 * x ^ (m + Suc p) < x * x ^ (m + Suc p)
  ← rewrite mult_1_left sym=false goal=166
  ← rewrite lt_mult_rcancel sym=false goal=167
    #[168] 1 < x ∧ ¬(x ^ (m + Suc p) = 0)
  ← rule conjI goal=168
    #[169] ¬(x ^ (m + Suc p) = 0)
  ← rule negI goal=169
    #[170] x ^ (m + Suc p) = 0 ⟶ false
  ← rewrite exp_eq_0 sym=false goal=170
    #[171] x = 0 ∧ ¬(m + Suc p = 0) ⟶ false
  ← intro goal=171
    #[172] x = 0 ∧ ¬(m + Suc p = 0)
    #[173] false
  → forward conjD1 goal=173 facts=[172]
    #[174] x = 0
  ← z3 goal=173 facts=[174,138]
    #[175] false
  ← intro goal=135
    #[176] x = 0 ∧ ¬(m = 0) ∧ n = 0
    #[177] x ^ m < x ^ n
  → forward conjD1 goal=177 facts=[176]
    #[178] x = 0
  → forward conjD2 goal=177 facts=[176]
    #[179] ¬(m = 0) ∧ n = 0
  → forward conjD1 goal=177 facts=[179]
    #[180] ¬(m = 0)
  → forward conjD2 goal=177 facts=[179]
    #[181] n = 0
  ← rewrite source=prev goal=177 facts=[178]
    #[182] (0::nat) ^ m < 0 ^ n
  ← rewrite exp_zero sym=false goal=182
    #[183] (if m = 0 then (1::nat) else 0) < (if n = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=183 facts=[180]
    #[184] (0::nat) < (if n = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=184 facts=[181]
    #[185] (0::nat) < 1
  ← rule le_1_1 goal=185
    #[186] ¬((1::nat) = 0)
  nat_const_ineq goal=186
qed

theorem le_exp
  fixes m :: nat, n :: nat, x :: nat
  prop x ^ m <= x ^ n <--> (if x = 0 then m = 0 --> n = 0 else x = 1 | m <= n)
  [hint_rewrite]
proof
  ← rewrite not_lt sym=true goal=0
    #[1] ¬(x ^ n < x ^ m) ⟷ (if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ ¬(n < m))
  ← rewrite lt_exp sym=false goal=1
    #[2] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟷ (if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ ¬(n < m))
  ← cases "x = 0" goal=2
    #[3] x = 0 ⟶ ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟷ (if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ ¬(n < m))
    #[4] ¬(x = 0) ⟶ ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟷ (if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ ¬(n < m))
  ← intro goal=3
    #[5] x = 0
    #[6] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟷ (if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ ¬(n < m))
  ← rewrite if_P sym=false goal=6 facts=[5]
    #[7] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟷ (m = 0 ⟶ n = 0)
  ← rule iffI goal=7
    #[8] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟶ m = 0 ⟶ n = 0
    #[9] (m = 0 ⟶ n = 0) ⟶ ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0)
  ← intro goal=8
    #[10] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0)
    #[11] m = 0
    #[12] n = 0
  → rewrite target=fact de_morgan_thm2 sym=false goal=12 facts=[10]
    #[13] ¬(2 ≤ x ∧ n < m) ∧ ¬(x = 0 ∧ ¬(n = 0) ∧ m = 0)
  → forward conjD1 goal=12 facts=[13]
    #[14] ¬(2 ≤ x ∧ n < m)
  → forward conjD2 goal=12 facts=[13]
    #[15] ¬(x = 0 ∧ ¬(n = 0) ∧ m = 0)
  → rewrite target=fact de_morgan_thm1 sym=false goal=12 facts=[14]
    #[16] ¬(2 ≤ x) ∨ ¬(n < m)
  → rewrite target=fact not_lt sym=false goal=12 facts=[16]
    #[17] ¬(2 ≤ x) ∨ m ≤ n
  → rewrite target=fact de_morgan_thm1 sym=false goal=12 facts=[15]
    #[18] ¬(x = 0) ∨ ¬(¬(n = 0) ∧ m = 0)
  ← rule disjE goal=12 facts=[18]
    #[19] ¬(x = 0) ⟶ n = 0
    #[20] ¬(¬(n = 0) ∧ m = 0) ⟶ n = 0
  ← intro goal=19
    #[21] ¬(x = 0)
    #[22] n = 0
  ← rule negE_gen goal=22 facts=[21,5]
    #[23] n = 0
  ← rewrite de_morgan_thm1 sym=false goal=20
    #[24] ¬¬(n = 0) ∨ ¬(m = 0) ⟶ n = 0
  ← intro goal=24
    #[25] ¬¬(n = 0) ∨ ¬(m = 0)
    #[26] n = 0
  ← rule disjE goal=26 facts=[25]
    #[27] ¬¬(n = 0) ⟶ n = 0
    #[28] ¬(m = 0) ⟶ n = 0
  ← rewrite double_neg sym=false goal=27
    #[29] n = 0 ⟶ n = 0
  ← intro goal=28
    #[30] ¬(m = 0)
    #[31] n = 0
  ← rule negE_gen goal=31 facts=[30,11]
    #[32] n = 0
  ← intro goal=9
    #[33] m = 0 ⟶ n = 0
    #[34] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0)
  ← rewrite de_morgan_thm2 sym=false goal=34
    #[35] ¬(2 ≤ x ∧ n < m) ∧ ¬(x = 0 ∧ ¬(n = 0) ∧ m = 0)
  ← rule conjI goal=35
    #[36] ¬(2 ≤ x ∧ n < m)
    #[37] ¬(x = 0 ∧ ¬(n = 0) ∧ m = 0)
  ← rewrite de_morgan_thm1 sym=false goal=36
    #[38] ¬(2 ≤ x) ∨ ¬(n < m)
  ← rule disjI1 goal=38
    #[39] ¬(2 ≤ x)
  ← rewrite source=prev goal=39 facts=[5]
    #[40] ¬((2::nat) ≤ 0)
  ← z3 goal=40
    #[41] ¬((2::nat) ≤ 0)
  ← rewrite de_morgan_thm1 sym=false goal=37
    #[42] ¬(x = 0) ∨ ¬(¬(n = 0) ∧ m = 0)
  ← rule disjI2 goal=42
    #[43] ¬(¬(n = 0) ∧ m = 0)
  ← rewrite de_morgan_thm1 sym=false goal=43
    #[44] ¬¬(n = 0) ∨ ¬(m = 0)
  ← rewrite double_neg sym=false goal=44
    #[45] n = 0 ∨ ¬(m = 0)
  ← z3 goal=45 facts=[33]
    #[46] n = 0 ∨ ¬(m = 0)
  ← intro goal=4
    #[47] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟷ (if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ ¬(n < m))
  ← rewrite if_not_P sym=false goal=47 facts=[21]
    #[48] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟷ x = 1 ∨ ¬(n < m)
  ← rule iffI goal=48
    #[49] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0) ⟶ x = 1 ∨ ¬(n < m)
    #[50] x = 1 ∨ ¬(n < m) ⟶ ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0)
  ← intro goal=49
    #[51] x = 1 ∨ ¬(n < m)
  → rewrite target=fact de_morgan_thm2 sym=false goal=51 facts=[10]
  → forward conjD1 goal=51 facts=[13]
  → rewrite target=fact de_morgan_thm1 sym=false goal=51 facts=[14]
  ← rule disjE goal=51 facts=[16]
    #[52] ¬(2 ≤ x) ⟶ x = 1 ∨ ¬(n < m)
    #[53] ¬(n < m) ⟶ x = 1 ∨ ¬(n < m)
  ← intro goal=52
    #[54] ¬(2 ≤ x)
    #[55] x = 1 ∨ ¬(n < m)
  ← rule disjI1 goal=55
    #[56] x = 1
  ← z3 goal=56 facts=[21,54]
    #[57] x = 1
  ← intro goal=53
    #[58] ¬(n < m)
    #[59] x = 1 ∨ ¬(n < m)
  ← rule disjI2 goal=59
  ← intro goal=50
    #[60] x = 1 ∨ ¬(n < m)
    #[61] ¬(2 ≤ x ∧ n < m ∨ x = 0 ∧ ¬(n = 0) ∧ m = 0)
  ← rewrite de_morgan_thm2 sym=false goal=61
    #[62] ¬(2 ≤ x ∧ n < m) ∧ ¬(x = 0 ∧ ¬(n = 0) ∧ m = 0)
  ← rule conjI goal=62
    #[63] ¬(2 ≤ x ∧ n < m)
    #[64] ¬(x = 0 ∧ ¬(n = 0) ∧ m = 0)
  ← rewrite de_morgan_thm1 sym=false goal=63
    #[65] ¬(2 ≤ x) ∨ ¬(n < m)
  ← rule disjE goal=65 facts=[60]
    #[66] x = 1 ⟶ ¬(2 ≤ x) ∨ ¬(n < m)
    #[67] ¬(n < m) ⟶ ¬(2 ≤ x) ∨ ¬(n < m)
  ← intro goal=66
    #[68] x = 1
    #[69] ¬(2 ≤ x) ∨ ¬(n < m)
  ← rule disjI1 goal=69
    #[70] ¬(2 ≤ x)
  ← rewrite source=prev goal=70 facts=[68]
    #[71] ¬((2::nat) ≤ 1)
  ← z3 goal=71
    #[72] ¬((2::nat) ≤ 1)
  ← intro goal=67
    #[73] ¬(2 ≤ x) ∨ ¬(n < m)
  ← rule disjI2 goal=73
  ← rewrite de_morgan_thm1 sym=false goal=64
    #[74] ¬(x = 0) ∨ ¬(¬(n = 0) ∧ m = 0)
  ← rule disjI1 goal=74
qed

theorem eq_exp
  fixes m :: nat, n :: nat, x :: nat
  prop x ^ m = x ^ n <--> (if x = 0 then m = 0 <--> n = 0 else x = 1 | m = n)
  [hint_rewrite]
proof
  → forward le_antisym param_m="x ^ m" param_n="x ^ n" goal=0
    #[1] x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m ⟷ x ^ m = x ^ n
  → rewrite target=fact eq_sym_eq sym=false goal=0 facts=[1]
    #[2] x ^ m = x ^ n ⟷ x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m
  ← rewrite source=prev goal=0 facts=[2]
    #[3] x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m ⟷ (if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n)
  ← rule iffI goal=3
    #[4] x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m ⟶ (if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n)
    #[5] (if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n) ⟶ x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m
  ← intro goal=4
    #[6] x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m
    #[7] if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n
  → forward conjD1 goal=7 facts=[6]
    #[8] x ^ m ≤ x ^ n
  → forward conjD2 goal=7 facts=[6]
    #[9] x ^ n ≤ x ^ m
  → rewrite target=fact le_exp sym=false goal=7 facts=[8]
    #[10] if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ m ≤ n
  → rewrite target=fact le_exp sym=false goal=7 facts=[9]
    #[11] if x = 0 then n = 0 ⟶ m = 0 else x = 1 ∨ n ≤ m
  ← cases "x=0" goal=7
    #[12] x = 0 ⟶ (if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n)
    #[13] ¬(x = 0) ⟶ (if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n)
  ← intro goal=12
    #[14] x = 0
    #[15] if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n
  ← rewrite if_P sym=false goal=15 facts=[14]
    #[16] m = 0 ⟷ n = 0
  → rewrite target=fact if_P sym=false goal=16 facts=[10,14]
    #[17] m = 0 ⟶ n = 0
  → rewrite target=fact if_P sym=false goal=16 facts=[11,14]
    #[18] n = 0 ⟶ m = 0
  ← rule iffI goal=16
  ← intro goal=13
    #[19] ¬(x = 0)
    #[20] if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n
  ← rewrite if_not_P sym=false goal=20 facts=[19]
    #[21] x = 1 ∨ m = n
  → rewrite target=fact if_not_P sym=false goal=21 facts=[10,19]
    #[22] x = 1 ∨ m ≤ n
  → rewrite target=fact if_not_P sym=false goal=21 facts=[11,19]
    #[23] x = 1 ∨ n ≤ m
  ← rule disjE goal=21 facts=[23]
    #[24] x = 1 ⟶ x = 1 ∨ m = n
    #[25] n ≤ m ⟶ x = 1 ∨ m = n
  ← intro goal=24
    #[26] x = 1
    #[27] x = 1 ∨ m = n
  ← rule disjI1 goal=27
  ← intro goal=25
    #[28] n ≤ m
    #[29] x = 1 ∨ m = n
  ← rule disjE goal=29 facts=[22]
    #[30] m ≤ n ⟶ x = 1 ∨ m = n
  ← intro goal=30
    #[31] m ≤ n
    #[32] x = 1 ∨ m = n
  ← rule disjI2 goal=32
    #[33] m = n
  ← rewrite le_antisym sym=true goal=33
    #[34] m ≤ n ∧ n ≤ m
  ← rule conjI goal=34
  ← intro goal=5
    #[35] if x = 0 then m = 0 ⟷ n = 0 else x = 1 ∨ m = n
    #[36] x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m
  ← cases "x=0" goal=36
    #[37] x = 0 ⟶ x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m
    #[38] ¬(x = 0) ⟶ x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m
  ← intro goal=37
    #[39] x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m
  ← rule conjI goal=39
    #[40] x ^ m ≤ x ^ n
    #[41] x ^ n ≤ x ^ m
  ← rewrite le_exp sym=false goal=40
    #[42] if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ m ≤ n
  → rewrite target=fact if_P sym=false goal=42 facts=[35,14]
    #[43] m = 0 ⟷ n = 0
  ← rewrite if_P sym=false goal=42 facts=[14]
    #[44] m = 0 ⟶ n = 0
  ← intro goal=44
    #[45] m = 0
    #[46] n = 0
  → rewrite target=fact source=prev goal=46 facts=[43,45]
  ← rewrite le_exp sym=false goal=41
    #[47] if x = 0 then n = 0 ⟶ m = 0 else x = 1 ∨ n ≤ m
  ← rewrite if_P sym=false goal=47 facts=[14]
    #[48] n = 0 ⟶ m = 0
  ← intro goal=48
    #[49] n = 0
    #[50] m = 0
  ← rewrite source=prev goal=50 facts=[43]
  ← intro goal=38
    #[51] x ^ m ≤ x ^ n ∧ x ^ n ≤ x ^ m
  ← rule conjI goal=51
    #[52] x ^ m ≤ x ^ n
    #[53] x ^ n ≤ x ^ m
  ← rewrite le_exp sym=false goal=52
    #[54] if x = 0 then m = 0 ⟶ n = 0 else x = 1 ∨ m ≤ n
  → rewrite target=fact if_not_P sym=false goal=54 facts=[35,19]
    #[55] x = 1 ∨ m = n
  ← rewrite if_not_P sym=false goal=54 facts=[19]
    #[56] x = 1 ∨ m ≤ n
  ← rule disjE goal=56 facts=[55]
    #[57] x = 1 ⟶ x = 1 ∨ m ≤ n
    #[58] m = n ⟶ x = 1 ∨ m ≤ n
  ← intro goal=57
    #[59] x = 1 ∨ m ≤ n
  ← rule disjI1 goal=59
  ← intro goal=58
    #[60] m = n
    #[61] x = 1 ∨ m ≤ n
  ← rule disjI2 goal=61
    #[62] m ≤ n
  ← rewrite source=prev goal=62 facts=[60]
    #[63] n ≤ n
  ← rule less_eq_refl goal=63
    #[64] n ≤ n
  ← rewrite le_exp sym=false goal=53
    #[65] if x = 0 then n = 0 ⟶ m = 0 else x = 1 ∨ n ≤ m
  ← rewrite if_not_P sym=false goal=65 facts=[19]
    #[66] x = 1 ∨ n ≤ m
  ← rule disjE goal=66 facts=[55]
    #[67] x = 1 ⟶ x = 1 ∨ n ≤ m
    #[68] m = n ⟶ x = 1 ∨ n ≤ m
  ← intro goal=67
    #[69] x = 1 ∨ n ≤ m
  ← rule disjI1 goal=69
  ← intro goal=68
    #[70] x = 1 ∨ n ≤ m
  ← rule disjI2 goal=70
    #[71] n ≤ m
  ← rewrite source=prev goal=71 facts=[60]
  ← rule less_eq_refl goal=63
qed

theorem exp_mono_le_imp
  fixes n :: nat, x :: nat, y :: nat
  prop x <= y --> x ^ n <= y ^ n
  [hint_backward]
proof
  ← intro goal=0
    #[1] x ≤ y
    #[2] x ^ n ≤ y ^ n
  ← induct n nat_induct goal=2
    #[3] x ^ (0::nat) ≤ y ^ (0::nat)
    #[4] ∀n. x ^ n ≤ y ^ n ⟶ x ^ Suc n ≤ y ^ Suc n
  ← rewrite nat_nat_power_def_1 sym=false goal=3
    #[5] (1::nat) ≤ 1
  ← rule less_eq_refl goal=5
    #[6] (1::nat) ≤ 1
  ← intro n goal=4
    #[7] _VAR n
    #[8] x ^ n ≤ y ^ n
    #[9] x ^ Suc n ≤ y ^ Suc n
  ← rewrite nat_nat_power_def_2 sym=false goal=9
    #[10] x * x ^ n ≤ y * y ^ n
  ← rule le_mult2 goal=10
qed

theorem exp_mono_lt_imp
  fixes n :: nat, x :: nat, y :: nat
  prop x < y --> ~(n = 0) --> x ^ n < y ^ n
  [hint_backward,hint_backward1]

theorem exp_mono_le
  fixes n :: nat, x :: nat, y :: nat
  prop x ^ n <= y ^ n <--> x <= y | n = 0
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] x ^ n ≤ y ^ n ⟶ x ≤ y ∨ n = 0
    #[2] x ≤ y ∨ n = 0 ⟶ x ^ n ≤ y ^ n
  ← intro goal=1
    #[3] x ^ n ≤ y ^ n
    #[4] x ≤ y ∨ n = 0
  ← rule contrapositive goal=4 facts=[3]
    #[5] ¬(x ≤ y ∨ n = 0) ⟶ ¬(x ^ n ≤ y ^ n)
  ← intro goal=5
    #[6] ¬(x ≤ y ∨ n = 0)
    #[7] ¬(x ^ n ≤ y ^ n)
  ← rewrite not_le sym=false goal=7
    #[8] y ^ n < x ^ n
  ← rule exp_mono_lt_imp goal=8
    #[9] y < x
    #[10] ¬(n = 0)
  → rewrite target=fact de_morgan_thm2 sym=false goal=9 facts=[6]
    #[11] ¬(x ≤ y) ∧ ¬(n = 0)
  → rewrite target=fact not_le sym=false goal=9 facts=[11]
    #[12] y < x ∧ ¬(n = 0)
  ← rule conjD1 goal=9 facts=[12]
    #[13] y < x
  ← rule conjD2 goal=10 facts=[12]
    #[14] ¬(n = 0)
  ← intro goal=2
    #[15] x ≤ y ∨ n = 0
    #[16] x ^ n ≤ y ^ n
  ← rule disjE goal=16 facts=[15]
    #[17] x ≤ y ⟶ x ^ n ≤ y ^ n
    #[18] n = 0 ⟶ x ^ n ≤ y ^ n
  ← intro goal=17
    #[19] x ≤ y
    #[20] x ^ n ≤ y ^ n
  ← rule exp_mono_le_imp goal=20
  ← intro goal=18
    #[21] n = 0
    #[22] x ^ n ≤ y ^ n
  ← rewrite source=prev goal=22 facts=[21]
    #[23] x ^ (0::nat) ≤ y ^ (0::nat)
  ← rewrite nat_nat_power_def_1 sym=false goal=23
    #[24] (1::nat) ≤ 1
  ← rule less_eq_refl goal=24
    #[25] (1::nat) ≤ 1
qed

theorem exp_mono_lt
  fixes n :: nat, x :: nat, y :: nat
  prop x ^ n < y ^ n <--> x < y & ~(n = 0)
  [hint_rewrite]
proof
  ← rewrite not_le sym=true goal=0
    #[1] ¬(y ^ n ≤ x ^ n) ⟷ ¬(y ≤ x) ∧ ¬(n = 0)
  ← rewrite exp_mono_le sym=false goal=1
    #[2] ¬(y ≤ x ∨ n = 0) ⟷ ¬(y ≤ x) ∧ ¬(n = 0)
  ← rewrite de_morgan_thm2 sym=false goal=2
qed

theorem exp_mono_eq
  fixes n :: nat, x :: nat, y :: nat
  prop x ^ n = y ^ n <--> x = y | n = 0
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] x ^ n = y ^ n ⟶ x = y ∨ n = 0
    #[2] x = y ∨ n = 0 ⟶ x ^ n = y ^ n
  ← intro goal=1
    #[3] x ^ n = y ^ n
    #[4] x = y ∨ n = 0
  → rewrite target=fact le_antisym sym=true goal=4 facts=[3]
    #[5] x ^ n ≤ y ^ n ∧ y ^ n ≤ x ^ n
  → forward conjD1 goal=4 facts=[5]
    #[6] x ^ n ≤ y ^ n
  → forward conjD2 goal=4 facts=[5]
    #[7] y ^ n ≤ x ^ n
  → rewrite target=fact exp_mono_le sym=false goal=4 facts=[6]
    #[8] x ≤ y ∨ n = 0
  → rewrite target=fact exp_mono_le sym=false goal=4 facts=[7]
    #[9] y ≤ x ∨ n = 0
  ← rule disjE goal=4 facts=[8]
    #[10] x ≤ y ⟶ x = y ∨ n = 0
    #[11] n = 0 ⟶ x = y ∨ n = 0
  ← intro goal=10
    #[12] x ≤ y
    #[13] x = y ∨ n = 0
  ← rule disjE goal=13 facts=[9]
    #[14] y ≤ x ⟶ x = y ∨ n = 0
    #[15] n = 0 ⟶ x = y ∨ n = 0
  ← intro goal=14
    #[16] y ≤ x
    #[17] x = y ∨ n = 0
  ← rule disjI1 goal=17
    #[18] x = y
  ← rewrite le_antisym sym=true goal=18
    #[19] x ≤ y ∧ y ≤ x
  ← rule conjI goal=19
  ← intro goal=15
    #[20] n = 0
    #[21] x = y ∨ n = 0
  ← rule disjI2 goal=21
  ← intro goal=11
    #[22] x = y ∨ n = 0
  ← rule disjI2 goal=22
  ← intro goal=2
    #[23] x = y ∨ n = 0
    #[24] x ^ n = y ^ n
  ← rule disjE goal=24 facts=[23]
    #[25] x = y ⟶ x ^ n = y ^ n
    #[26] n = 0 ⟶ x ^ n = y ^ n
  ← intro goal=25
    #[27] x = y
    #[28] x ^ n = y ^ n
  ← rewrite source=prev goal=28 facts=[27]
    #[29] x ^ n = y ^ n
  ← intro goal=26
    #[30] x ^ n = y ^ n
  ← rewrite source=prev goal=30 facts=[20]
    #[31] x ^ (0::nat) = y ^ (0::nat)
  ← rewrite nat_nat_power_def_1 sym=false goal=31
    #[32] x ^ (0::nat) = y ^ (0::nat)
qed

theorem nat_WF
  fixes P :: nat => bool
  prop (!n. (!m. m < n --> P m) --> P n) --> (!n. P n)
proof
  ← intro goal=0
    #[1] ∀n. (∀m. m < n ⟶ P m) ⟶ P n
    #[2] ∀n. P n
  ← intro x goal=2
    #[3] _VAR x
    #[4] P x
  ← apply_prev goal=4 facts=[1]
    #[5] ∀m. m < x ⟶ P m
  ← induct x nat_induct goal=5
    #[6] ∀m. m < 0 ⟶ P m
    #[7] ∀n. (∀m. m < n ⟶ P m) ⟶ (∀m. m < Suc n ⟶ P m)
  ← rewrite nat_less_def_1 sym=false goal=6
    #[8] ∀m. false ⟶ P m
  ← intro m goal=8
    #[9] _VAR m
    #[10] false
    #[11] P m
  ← resolve not_false_res goal=11 facts=[10]
    #[12] P m
  ← intro x goal=7
    #[13] ∀m. m < x ⟶ P m
    #[14] ∀m. m < Suc x ⟶ P m
  ← rewrite nat_less_def_2 sym=false goal=14
    #[15] ∀m. m = x ∨ m < x ⟶ P m
  ← intro m goal=15
    #[16] m = x ∨ m < x
    #[17] P m
  ← rule disjE goal=17 facts=[16]
    #[18] m = x ⟶ P m
    #[19] m < x ⟶ P m
  ← intro goal=18
    #[20] m = x
    #[21] P m
  ← rewrite source=prev goal=21 facts=[20]
    #[22] P x
  ← apply_prev goal=22 facts=[1]
  ← intro goal=19
    #[23] m < x
    #[24] P m
  ← apply_prev goal=24 facts=[13]
qed

theorem nat_WOP
  fixes P :: nat => bool
  prop (?n. P n) <--> (?n. P n & (!m. m < n --> ~(P m)))
proof
  ← rule iffI goal=0
    #[1] (∃n. P n) ⟶ (∃n. P n ∧ (∀m. m < n ⟶ ¬(P m)))
    #[2] (∃n. P n ∧ (∀m. m < n ⟶ ¬(P m))) ⟶ (∃n. P n)
  ← intro goal=1
    #[3] ∃n. P n
    #[4] ∃n. P n ∧ (∀m. m < n ⟶ ¬(P m))
  ← rule contrapositive goal=4 facts=[3]
    #[5] ¬(∃n. P n ∧ (∀m. m < n ⟶ ¬(P m))) ⟶ ¬(∃n. P n)
  ← rewrite not_exists sym=false goal=5
    #[6] (∀n. ¬(P n ∧ (∀m. m < n ⟶ ¬(P m)))) ⟶ (∀n. ¬(P n))
  ← intro goal=6
    #[7] ∀n. ¬(P n ∧ (∀m. m < n ⟶ ¬(P m)))
    #[8] ∀n. ¬(P n)
  ← rule nat_WF goal=8
    #[9] ∀n. (∀m. m < n ⟶ ¬(P m)) ⟶ ¬(P n)
  ← intro n goal=9
    #[10] _VAR n
    #[11] ∀m. m < n ⟶ ¬(P m)
    #[12] ¬(P n)
  → inst target=fact n goal=12 facts=[7]
    #[13] ¬(P n ∧ (∀m. m < n ⟶ ¬(P m)))
  → rewrite target=fact de_morgan_thm1 sym=false goal=12 facts=[13]
    #[14] ¬(P n) ∨ ¬(∀m. m < n ⟶ ¬(P m))
  ← rule disjE goal=12 facts=[14]
    #[15] ¬(P n) ⟶ ¬(P n)
    #[16] ¬(∀m. m < n ⟶ ¬(P m)) ⟶ ¬(P n)
  ← intro goal=16
    #[17] ¬(∀m. m < n ⟶ ¬(P m))
    #[18] ¬(P n)
  ← rule negE_gen goal=18 facts=[17,11]
    #[19] ¬(P n)
  ← intro goal=2
    #[20] ∃n. P n ∧ (∀m. m < n ⟶ ¬(P m))
    #[21] ∃n. P n
  elim n goal=21 facts=[20]
    #[22] P n ∧ (∀m. m < n ⟶ ¬(P m))
    #[23] ∃n. P n
  ← inst n goal=23
    #[24] P n
  ← rule conjD1 goal=24 facts=[22]
    #[25] P n
qed

theorem nat_MAX
  fixes P :: nat => bool
  prop (?x. P x) & (?M. !x. P x --> x <= M) <--> (?m. P m & (!x. P x --> x <= m))

theorem divmod_exist
  fixes m :: nat, n :: nat
  prop ~(n = 0) --> (?q. ?r. m = q * n + r & r < n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] ∃q. ∃r. m = q * n + r ∧ r < n
  → forward nat_WOP param_P="%r. ?q. m = q * n + r" goal=2
    #[3] (∃n1. ∃q. m = q * n + n1) ⟷ (∃n1. (∃q. m = q * n + n1) ∧ (∀m1. m1 < n1 ⟶ ¬(∃q. m = q * n + m1)))
  cut "!A. !B. (A<-->B)-->(A-->B)" goal=2
    #[4] ∀A. ∀B. A ⟷ B ⟶ A ⟶ B
  ← z3 goal=4
    #[5] ∀A. ∀B. A ⟷ B ⟶ A ⟶ B
  → forward goal=2 facts=[5,3]
    #[6] (∃n1. ∃q. m = q * n + n1) ⟶ (∃n1. (∃q. m = q * n + n1) ∧ (∀m1. m1 < n1 ⟶ ¬(∃q. m = q * n + m1)))
  → rewrite target=fact left_imp_exists_thm sym=false goal=2 facts=[6]
    #[7] ∀n1. (∃q. m = q * n + n1) ⟶ (∃n11. (∃q. m = q * n + n11) ∧ (∀m1. m1 < n11 ⟶ ¬(∃q. m = q * n + m1)))
  → rewrite target=fact left_imp_exists_thm sym=false goal=2 facts=[7]
    #[8] ∀n1. ∀q. m = q * n + n1 ⟶ (∃n11. (∃q1. m = q1 * n + n11) ∧ (∀m1. m1 < n11 ⟶ ¬(∃q1. m = q1 * n + m1)))
  → inst target=fact m goal=2 facts=[8]
    #[9] ∀q. m = q * n + m ⟶ (∃n1. (∃q1. m = q1 * n + n1) ∧ (∀m1. m1 < n1 ⟶ ¬(∃q1. m = q1 * n + m1)))
  → inst target=fact "(0::nat)" goal=2 facts=[9]
    #[10] m = 0 * n + m ⟶ (∃n1. (∃q. m = q * n + n1) ∧ (∀m1. m1 < n1 ⟶ ¬(∃q. m = q * n + m1)))
  cut "m = 0 * n + m" goal=2 facts=[10]
    #[11] m = 0 * n + m
  nat_norm goal=11
    #[12] m = 0 * n + m
  → forward goal=2 facts=[10,12]
    #[13] ∃n1. (∃q. m = q * n + n1) ∧ (∀m1. m1 < n1 ⟶ ¬(∃q. m = q * n + m1))
  elim r goal=2 facts=[13]
    #[14] _VAR r
    #[15] (∃q. m = q * n + r) ∧ (∀m1. m1 < r ⟶ ¬(∃q. m = q * n + m1))
    #[16] ∃q. ∃r. m = q * n + r ∧ r < n
  → forward conjD1 goal=16 facts=[15]
    #[17] ∃q. m = q * n + r
  → forward conjD2 goal=16 facts=[15]
    #[18] ∀m1. m1 < r ⟶ ¬(∃q. m = q * n + m1)
  elim q goal=16 facts=[17]
    #[19] _VAR q
    #[20] m = q * n + r
    #[21] ∃q. ∃r. m = q * n + r ∧ r < n
  ← inst q goal=21
    #[22] ∃r. m = q * n + r ∧ r < n
  ← inst r goal=22
    #[23] m = q * n + r ∧ r < n
  ← rule conjI goal=23
    #[24] r < n
  ← rule contrapositive goal=24 facts=[18]
    #[25] ¬(r < n) ⟶ ¬(∀m1. m1 < r ⟶ ¬(∃q. m = q * n + m1))
  ← intro goal=25
    #[26] ¬(r < n)
    #[27] ¬(∀m1. m1 < r ⟶ ¬(∃q. m = q * n + m1))
  → rewrite target=fact not_lt sym=false goal=27 facts=[26]
    #[28] n ≤ r
  → rewrite target=fact less_eq_exist sym=false goal=27 facts=[28]
    #[29] ∃p. r = n + p
  elim d goal=27 facts=[29]
    #[30] _VAR d
    #[31] r = n + d
    #[32] ¬(∀m1. m1 < r ⟶ ¬(∃q. m = q * n + m1))
  ← rewrite not_all sym=false goal=32
    #[33] ∃m1. ¬(m1 < r ⟶ ¬(∃q. m = q * n + m1))
  ← inst d goal=33
    #[34] ¬(d < r ⟶ ¬(∃q. m = q * n + d))
  ← rewrite not_imp sym=false goal=34
    #[35] d < r ∧ ¬¬(∃q. m = q * n + d)
  ← rule conjI goal=35
    #[36] d < r
    #[37] ¬¬(∃q. m = q * n + d)
  ← z3 goal=36 facts=[1,31]
    #[38] d < r
  ← rewrite double_neg sym=false goal=37
    #[39] ∃q. m = q * n + d
  ← inst q+1 goal=39
    #[40] m = (q + 1) * n + d
  ← rewrite source=prev goal=40 facts=[20]
    #[41] q * n + r = (q + 1) * n + d
  ← rewrite source=prev goal=41 facts=[31]
    #[42] q * n + (n + d) = (q + 1) * n + d
  nat_norm goal=42
    #[43] q * n + (n + d) = (q + 1) * n + d
qed

theorem divmod_exist_0
  fixes m :: nat, n :: nat
  prop ?q. ?r. if n = 0 then q = 0 & r = m else m = q * n + r & r < n
  [hint_backward]
proof
  ← cases "n= 0" goal=0
    #[1] n = 0 ⟶ (∃q. ∃r. if n = 0 then q = 0 ∧ r = m else m = q * n + r ∧ r < n)
    #[2] ¬(n = 0) ⟶ (∃q. ∃r. if n = 0 then q = 0 ∧ r = m else m = q * n + r ∧ r < n)
  ← intro goal=1
    #[3] n = 0
    #[4] ∃q. ∃r. if n = 0 then q = 0 ∧ r = m else m = q * n + r ∧ r < n
  ← rewrite if_P sym=false goal=4 facts=[3]
    #[5] ∃q::nat. ∃r. q = 0 ∧ r = m
  ← inst "(0::nat)" goal=5
    #[6] ∃r. (0::nat) = 0 ∧ r = m
  ← inst m goal=6
    #[7] (0::nat) = 0 ∧ m = m
  ← rule conjI goal=7
    #[8] (0::nat) = 0
    #[9] m = m
  ← rule eq_refl goal=8
    #[10] (0::nat) = 0
  ← rule eq_refl goal=9
    #[11] m = m
  ← intro goal=2
    #[12] ¬(n = 0)
    #[13] ∃q. ∃r. if n = 0 then q = 0 ∧ r = m else m = q * n + r ∧ r < n
  ← rewrite if_not_P sym=false goal=13 facts=[12]
    #[14] ∃q. ∃r. m = q * n + r ∧ r < n
  ← rule divmod_exist goal=14
qed

axiom division_0
  fixes m :: nat, n :: nat
  prop if n = 0 then m DIV n = 0 ∧ m MOD n = m else m = m DIV n * n + m MOD n ∧ m MOD n < n
  [hint_backward]

theorem division
  fixes m :: nat, n :: nat
  prop ~(n = 0) --> m = m DIV n * n + m MOD n & m MOD n < n
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] m = m DIV n * n + m MOD n ∧ m MOD n < n
  → forward division_0 param_m=m param_n=n goal=2
    #[3] if n = 0 then m DIV n = 0 ∧ m MOD n = m else m = m DIV n * n + m MOD n ∧ m MOD n < n
  → rewrite target=fact if_not_P sym=false goal=2 facts=[3,1]
qed

theorem div_zero
  fixes n :: nat
  prop n DIV 0 = 0
  [hint_rewrite]
proof
  → forward division_0 param_m=n param_n="(0::nat)" goal=0
    #[1] if (0::nat) = 0 then n DIV 0 = 0 ∧ n MOD 0 = n else n = n DIV 0 * 0 + n MOD 0 ∧ n MOD 0 < 0
  cut "(0::nat) = 0" goal=0 facts=[1]
    #[2] (0::nat) = 0
  ← rule eq_refl goal=2
  → rewrite target=fact if_P sym=false goal=0 facts=[1,2]
    #[3] n DIV 0 = 0 ∧ n MOD 0 = n
  ← rule conjD1 goal=0 facts=[3]
qed

theorem mod_zero
  fixes n :: nat
  prop n MOD 0 = n
  [hint_rewrite]
proof
  → forward division_0 param_m=n param_n="(0::nat)" goal=0
    #[1] if (0::nat) = 0 then n DIV 0 = 0 ∧ n MOD 0 = n else n = n DIV 0 * 0 + n MOD 0 ∧ n MOD 0 < 0
  cut "(0::nat) = 0" goal=0
    #[2] (0::nat) = 0
  ← rule eq_refl goal=2
  → rewrite target=fact if_P sym=false goal=0 facts=[1,2]
    #[3] n DIV 0 = 0 ∧ n MOD 0 = n
  ← rule conjD2 goal=0 facts=[3]
qed

theorem division_simp1
  fixes m :: nat, n :: nat
  prop m DIV n * n + m MOD n = m
  [hint_rewrite]
proof
  ← cases "n = 0" goal=0
    #[1] n = 0 ⟶ m DIV n * n + m MOD n = m
    #[2] ¬(n = 0) ⟶ m DIV n * n + m MOD n = m
  ← intro goal=1
    #[3] n = 0
    #[4] m DIV n * n + m MOD n = m
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m DIV 0 * 0 + m MOD 0 = m
  ← rewrite div_zero sym=false goal=5
    #[6] 0 * 0 + m MOD 0 = m
  ← rewrite mod_zero sym=false goal=6
    #[7] 0 * 0 + m = m
  ← rewrite nat_times_def_1 sym=false goal=7
    #[8] 0 + m = m
  ← rewrite nat_plus_def_1 sym=false goal=8
    #[9] 0 + m = m
  ← intro goal=2
    #[10] ¬(n = 0)
    #[11] m DIV n * n + m MOD n = m
  → forward division param_m=m goal=11 facts=[10]
    #[12] m = m DIV n * n + m MOD n ∧ m MOD n < n
  → forward conjD1 goal=11 facts=[12]
    #[13] m = m DIV n * n + m MOD n
  ← rewrite eq_sym_eq sym=false goal=11
qed

theorem division_simp2
  fixes m :: nat, n :: nat
  prop n * (m DIV n) + m MOD n = m
  [hint_rewrite]
proof
  ← rewrite mult_comm sym=false goal=0
    #[1] m DIV n * n + m MOD n = m
  ← rewrite division_simp1 sym=false goal=1
qed

theorem eq_divmod
  fixes m :: nat, n :: nat, p :: nat
  prop m DIV p = n DIV p & m MOD p = n MOD p <--> m = n
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] m DIV p = n DIV p ∧ m MOD p = n MOD p ⟶ m = n
    #[2] m = n ⟶ m DIV p = n DIV p ∧ m MOD p = n MOD p
  ← intro goal=1
    #[3] m DIV p = n DIV p ∧ m MOD p = n MOD p
    #[4] m = n
  → forward division_simp1 param_m=m param_n=p goal=4
    #[5] m DIV p * p + m MOD p = m
  → forward division_simp1 param_m=n param_n=p goal=4
    #[6] n DIV p * p + n MOD p = n
  → rewrite target=fact eq_sym_eq sym=false goal=4 facts=[5]
    #[7] m = m DIV p * p + m MOD p
  → rewrite target=fact eq_sym_eq sym=false goal=4 facts=[6]
    #[8] n = n DIV p * p + n MOD p
  ← rewrite source=prev goal=4 facts=[7]
    #[9] m DIV p * p + m MOD p = n
  ← rewrite source=prev goal=9 facts=[8]
    #[10] m DIV p * p + m MOD p = n DIV p * p + n MOD p
  → forward conjD1 goal=10 facts=[3]
    #[11] m DIV p = n DIV p
  → forward conjD2 goal=10 facts=[3]
    #[12] m MOD p = n MOD p
  ← rewrite source=prev goal=10 facts=[11]
    #[13] n DIV p * p + m MOD p = n DIV p * p + n MOD p
  ← rewrite source=prev goal=13 facts=[12]
  ← intro goal=2
    #[14] m = n
    #[15] m DIV p = n DIV p ∧ m MOD p = n MOD p
  ← rewrite source=prev goal=15 facts=[14]
    #[16] n DIV p = n DIV p ∧ n MOD p = n MOD p
  ← rule conjI goal=16
    #[17] n DIV p = n DIV p
    #[18] n MOD p = n MOD p
  ← rule eq_refl goal=17
    #[19] n DIV p = n DIV p
  ← rule eq_refl goal=18
    #[20] n MOD p = n MOD p
qed

theorem mod_lt_eq
  fixes m :: nat, n :: nat
  prop m MOD n < n <--> ~(n = 0)
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] m MOD n < n ⟶ ¬(n = 0)
    #[2] ¬(n = 0) ⟶ m MOD n < n
  ← intro goal=1
    #[3] m MOD n < n
    #[4] ¬(n = 0)
  ← rule contrapositive goal=4 facts=[3]
    #[5] ¬¬(n = 0) ⟶ ¬(m MOD n < n)
  ← intro goal=5
    #[6] ¬¬(n = 0)
    #[7] ¬(m MOD n < n)
  → rewrite target=fact double_neg sym=false goal=7 facts=[6]
    #[8] n = 0
  ← rewrite source=prev goal=7 facts=[8]
    #[9] ¬(m MOD 0 < 0)
  ← rewrite nat_less_def_1 sym=false goal=9
    #[10] ¬false
  ← rule negI goal=10
    #[11] false ⟶ false
  ← intro goal=2
    #[12] ¬(n = 0)
    #[13] m MOD n < n
  → forward division param_m=m goal=13 facts=[12]
    #[14] m = m DIV n * n + m MOD n ∧ m MOD n < n
  ← rule conjD2 goal=13 facts=[14]
qed

theorem mod_lt_eq_lt
  fixes m :: nat, n :: nat
  prop m MOD n < n <--> 0 < n
  [hint_rewrite]
proof
  ← rewrite mod_lt_eq sym=false goal=0
    #[1] ¬(n = 0) ⟷ 0 < n
  ← rule iffI goal=1
    #[2] ¬(n = 0) ⟶ 0 < n
    #[3] 0 < n ⟶ ¬(n = 0)
  ← intro goal=2
    #[4] ¬(n = 0)
    #[5] 0 < n
  ← rule le_1_1 goal=5
  ← intro goal=3
    #[6] 0 < n
    #[7] ¬(n = 0)
  ← rule contrapositive goal=7 facts=[6]
    #[8] ¬¬(n = 0) ⟶ ¬(0 < n)
  ← rewrite not_lt sym=false goal=8
    #[9] ¬¬(n = 0) ⟶ n ≤ 0
  ← intro goal=9
    #[10] ¬¬(n = 0)
    #[11] n ≤ 0
  → rewrite target=fact double_neg sym=false goal=11 facts=[10]
    #[12] n = 0
  ← rewrite nat_less_eq_def_1 sym=false goal=11
qed

theorem divmod_uniq_lemma
  fixes m :: nat, n :: nat, q1 :: nat, q2 :: nat, r1 :: nat, r2 :: nat
  prop m = q1 * n + r1 --> r1 < n --> m = q2 * n + r2 --> r2 < n --> q1 = q2 & r1 = r2
  [hint_backward,hint_backward1]

theorem divmod_uniq
  fixes m :: nat, n :: nat, q :: nat, r :: nat
  prop m = q * n + r --> r < n --> m DIV n = q & m MOD n = r
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m = q * n + r
    #[2] r < n
    #[3] m DIV n = q ∧ m MOD n = r
  ← rule divmod_uniq_lemma param_m=m param_n=n goal=3
    #[4] m = m DIV n * n + m MOD n
    #[5] m MOD n < n
  ← rewrite division_simp1 sym=false goal=4
    #[6] m = m DIV n * n + m MOD n
  ← rewrite mod_lt_eq sym=false goal=5
    #[7] ¬(n = 0)
  ← z3 goal=7 facts=[2]
    #[8] ¬(n = 0)
qed

theorem mod_uniq
  fixes m :: nat, n :: nat, q :: nat, r :: nat
  prop m = q * n + r --> r < n --> m MOD n = r
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m = q * n + r
    #[2] r < n
    #[3] m MOD n = r
  → forward divmod_uniq goal=3 facts=[1,2]
    #[4] m DIV n = q ∧ m MOD n = r
  ← rule conjD2 goal=3 facts=[4]
qed

theorem div_uniq
  fixes m :: nat, n :: nat, q :: nat, r :: nat
  prop m = q * n + r --> r < n --> m DIV n = q
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m = q * n + r
    #[2] r < n
    #[3] m DIV n = q
  → forward divmod_uniq goal=3 facts=[1,2]
    #[4] m DIV n = q ∧ m MOD n = r
  ← rule conjD1 goal=3 facts=[4]
qed

theorem div_0
  fixes n :: nat
  prop 0 DIV n = 0
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ 0 DIV n = 0
    #[2] ¬(n = 0) ⟶ 0 DIV n = 0
  ← intro goal=1
    #[3] n = 0
    #[4] 0 DIV n = 0
  ← rewrite source=prev goal=4 facts=[3]
    #[5] 0 DIV 0 = 0
  ← rewrite div_zero sym=false goal=5
    #[6] 0 DIV 0 = 0
  ← intro goal=2
    #[7] ¬(n = 0)
    #[8] 0 DIV n = 0
  ← rule div_uniq param_r="(0::nat)" goal=8
    #[9] 0 = 0 * n + 0
    #[10] 0 < n
  nat_norm goal=9
    #[11] 0 = 0 * n + 0
  ← rule le_1_1 goal=10
qed

theorem mod_0
  fixes n :: nat
  prop 0 MOD n = 0
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ 0 MOD n = 0
    #[2] ¬(n = 0) ⟶ 0 MOD n = 0
  ← intro goal=1
    #[3] n = 0
    #[4] 0 MOD n = 0
  ← rewrite source=prev goal=4 facts=[3]
    #[5] 0 MOD 0 = 0
  ← rewrite mod_zero sym=false goal=5
    #[6] 0 MOD 0 = 0
  ← intro goal=2
    #[7] ¬(n = 0)
    #[8] 0 MOD n = 0
  ← rule mod_uniq param_q="(0::nat)" goal=8
    #[9] 0 = 0 * n + 0
    #[10] 0 < n
  nat_norm goal=9
    #[11] 0 = 0 * n + 0
  ← rule le_1_1 goal=10
qed

theorem div_mult
  fixes m :: nat, n :: nat
  prop ~(m = 0) --> m * n DIV m = n
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(m = 0)
    #[2] m * n DIV m = n
  ← rule div_uniq param_r="(0::nat)" goal=2
    #[3] m * n = n * m + 0
    #[4] 0 < m
  nat_norm goal=3
    #[5] m * n = n * m + 0
  ← rule le_1_1 goal=4
qed

theorem mod_mult
  fixes m :: nat, n :: nat
  prop m * n MOD m = 0
  [hint_rewrite]
proof
  ← cases "m=0" goal=0
    #[1] m = 0 ⟶ m * n MOD m = 0
    #[2] ¬(m = 0) ⟶ m * n MOD m = 0
  ← intro goal=1
    #[3] m = 0
    #[4] m * n MOD m = 0
  ← rewrite source=prev goal=4 facts=[3]
    #[5] 0 * n MOD 0 = 0
  ← rewrite nat_times_def_1 sym=false goal=5
    #[6] 0 MOD 0 = 0
  ← rewrite mod_0 sym=false goal=6
    #[7] 0 MOD 0 = 0
  ← intro goal=2
    #[8] ¬(m = 0)
    #[9] m * n MOD m = 0
  ← rule mod_uniq param_q=n goal=9
    #[10] m * n = n * m + 0
    #[11] 0 < m
  nat_norm goal=10
    #[12] m * n = n * m + 0
  ← rule le_1_1 goal=11
qed

theorem mod_lt
  fixes m :: nat, n :: nat
  prop m < n --> m MOD n = m
  [hint_backward]
proof
  ← intro goal=0
    #[1] m < n
    #[2] m MOD n = m
  ← rule mod_uniq param_q="(0::nat)" goal=2
    #[3] m = 0 * n + m
  nat_norm goal=3
    #[4] m = 0 * n + m
qed

theorem mod_eq_self
  fixes m :: nat, n :: nat
  prop m MOD n = m <--> n = 0 | m < n
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] m MOD n = m ⟶ n = 0 ∨ m < n
    #[2] n = 0 ∨ m < n ⟶ m MOD n = m
  ← intro goal=1
    #[3] m MOD n = m
    #[4] n = 0 ∨ m < n
  ← cases "n=0" goal=4
    #[5] n = 0 ⟶ n = 0 ∨ m < n
    #[6] ¬(n = 0) ⟶ n = 0 ∨ m < n
  ← intro goal=5
    #[7] n = 0
    #[8] n = 0 ∨ m < n
  ← rule disjI1 goal=8 facts=[7]
    #[9] n = 0 ∨ m < n
  ← intro goal=6
    #[10] ¬(n = 0)
    #[11] n = 0 ∨ m < n
  ← rule disjI2 goal=11
    #[12] m < n
  → rewrite target=fact eq_sym_eq sym=false goal=12 facts=[3]
    #[13] m = m MOD n
  ← rewrite source=prev goal=12 facts=[13]
    #[14] m MOD n < n
  ← rewrite mod_lt_eq sym=false goal=14
  ← intro goal=2
    #[15] n = 0 ∨ m < n
    #[16] m MOD n = m
  ← rule disjE goal=16 facts=[15]
    #[17] n = 0 ⟶ m MOD n = m
    #[18] m < n ⟶ m MOD n = m
  ← intro goal=17
    #[19] m MOD n = m
  ← rewrite source=prev goal=19 facts=[7]
    #[20] m MOD 0 = m
  ← rewrite mod_zero sym=false goal=20
    #[21] m MOD 0 = m
  ← intro goal=18
    #[22] m < n
    #[23] m MOD n = m
  ← rule mod_lt goal=23
qed

theorem mod_cases
  fixes n :: nat, p :: nat
  prop n < 2 * p --> n MOD p = (if n < p then n else n - p)
  [hint_backward]
proof
  ← intro goal=0
    #[1] n < 2 * p
    #[2] n MOD p = (if n < p then n else n - p)
  ← cases "n < p" goal=2
    #[3] n < p ⟶ n MOD p = (if n < p then n else n - p)
    #[4] ¬(n < p) ⟶ n MOD p = (if n < p then n else n - p)
  ← intro goal=3
    #[5] n < p
    #[6] n MOD p = (if n < p then n else n - p)
  ← rewrite if_P sym=false goal=6 facts=[5]
    #[7] n MOD p = n
  ← rule mod_lt goal=7
  ← intro goal=4
    #[8] ¬(n < p)
    #[9] n MOD p = (if n < p then n else n - p)
  ← rewrite if_not_P sym=false goal=9 facts=[8]
    #[10] n MOD p = n - p
  ← rule mod_uniq param_q="(1::nat)" goal=10
    #[11] n = 1 * p + (n - p)
    #[12] n - p < p
  ← rewrite mult_1_left sym=false goal=11
    #[13] n = p + (n - p)
  ← z3 goal=13 facts=[8]
    #[14] n = p + (n - p)
  ← z3 goal=12 facts=[1]
    #[15] n - p < p
qed

theorem mod_add_cases
  fixes m :: nat, n :: nat, p :: nat
  prop m < p --> n < p --> (m + n) MOD p = (if m + n < p then m + n else m + n - p)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m < p
    #[2] n < p
    #[3] (m + n) MOD p = (if m + n < p then m + n else m + n - p)
  ← rule mod_cases goal=3
    #[4] m + n < 2 * p
  ← rewrite mult_2 sym=false goal=4
    #[5] m + n < p + p
  ← rule lt_add2 goal=5
qed

theorem mod_eq
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop m = n + q * p --> m MOD p = n MOD p
  [hint_backward]
proof
  ← intro goal=0
    #[1] m = n + q * p
    #[2] m MOD p = n MOD p
  ← cases "p=0" goal=2
    #[3] p = 0 ⟶ m MOD p = n MOD p
    #[4] ¬(p = 0) ⟶ m MOD p = n MOD p
  ← intro goal=3
    #[5] p = 0
    #[6] m MOD p = n MOD p
  → rewrite target=fact source=prev goal=6 facts=[5,1]
    #[7] m = n + q * 0
  → rewrite target=fact mult_0_right sym=false goal=6 facts=[7]
    #[8] m = n + 0
  → rewrite target=fact add_0_right sym=false goal=6 facts=[8]
    #[9] m = n
  ← rewrite source=prev goal=6 facts=[9]
  ← intro goal=4
    #[10] ¬(p = 0)
    #[11] m MOD p = n MOD p
  ← rule mod_uniq param_q="q + n DIV p" goal=11
    #[12] m = (q + n DIV p) * p + n MOD p
    #[13] n MOD p < p
  ← rewrite source=prev goal=12 facts=[1]
    #[14] n + q * p = (q + n DIV p) * p + n MOD p
  ← rewrite distrib_r sym=false goal=14
    #[15] n + q * p = q * p + n DIV p * p + n MOD p
  ← rewrite add_assoc sym=false goal=15
    #[16] n + q * p = q * p + (n DIV p * p + n MOD p)
  ← rewrite division_simp1 sym=false goal=16
    #[17] n + q * p = q * p + n
  nat_norm goal=17
    #[18] n + q * p = q * p + n
  ← rewrite mod_lt_eq sym=false goal=13
qed

theorem div_le
  fixes m :: nat, n :: nat
  prop m DIV n <= m
  [hint_backward]

theorem div_mul_le
  fixes m :: nat, n :: nat
  prop n * (m DIV n) <= m
  [hint_backward]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ n * (m DIV n) ≤ m
    #[2] ¬(n = 0) ⟶ n * (m DIV n) ≤ m
  ← intro goal=1
    #[3] n = 0
    #[4] n * (m DIV n) ≤ m
  ← rewrite source=prev goal=4 facts=[3]
    #[5] 0 * (m DIV 0) ≤ m
  ← rewrite nat_times_def_1 sym=false goal=5
    #[6] 0 ≤ m
  ← rule le_0 goal=6
    #[7] 0 ≤ m
  ← intro goal=2
    #[8] ¬(n = 0)
    #[9] n * (m DIV n) ≤ m
  → forward division param_m=m goal=9 facts=[8]
    #[10] m = m DIV n * n + m MOD n ∧ m MOD n < n
  → forward conjD1 goal=9 facts=[10]
    #[11] m = m DIV n * n + m MOD n
  ← rewrite mult_comm sym=false goal=9
    #[12] m DIV n * n ≤ m
  → forward division param_m=m goal=12 facts=[8]
  → forward conjD1 goal=12 facts=[10]
  ← rewrite source=prev goal=12 facts=[11]
    #[13] (m DIV n * n + m MOD n) DIV n * n ≤ m DIV n * n + m MOD n
  cut "(m DIV n * n + m MOD n) DIV n = m DIV n" goal=13
    #[14] (m DIV n * n + m MOD n) DIV n = m DIV n
  ← rewrite division_simp1 sym=false goal=14
    #[15] (m DIV n * n + m MOD n) DIV n = m DIV n
  ← rewrite source=prev goal=13 facts=[15]
    #[16] m DIV n * n ≤ m DIV n * n + m MOD n
  ← rule le_add goal=16
    #[17] m DIV n * n ≤ m DIV n * n + m MOD n
qed

theorem mod_le_twice
  fixes m :: nat, n :: nat
  prop 0 < m --> m <= n --> 2 * (n MOD m) <= n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < m
    #[2] m ≤ n
    #[3] 2 * (n MOD m) ≤ n
  ← cases "2 * m <= n" goal=3
    #[4] 2 * m ≤ n ⟶ 2 * (n MOD m) ≤ n
    #[5] ¬(2 * m ≤ n) ⟶ 2 * (n MOD m) ≤ n
  ← intro goal=4
    #[6] 2 * m ≤ n
    #[7] 2 * (n MOD m) ≤ n
  ← rule less_eq_trans param_m="2 * m" goal=7
    #[8] 2 * (n MOD m) ≤ 2 * m
  ← rule le_mult2 goal=8
    #[9] (2::nat) ≤ 2
    #[10] n MOD m ≤ m
  ← rule less_eq_refl goal=9
    #[11] (2::nat) ≤ 2
  ← rule lt_imp_le goal=10
    #[12] n MOD m < m
  ← rewrite mod_lt_eq_lt sym=false goal=12
  ← intro goal=5
    #[13] ¬(2 * m ≤ n)
    #[14] 2 * (n MOD m) ≤ n
  ← rule less_eq_trans param_m="m + n MOD m" goal=14
    #[15] 2 * (n MOD m) ≤ m + n MOD m
    #[16] m + n MOD m ≤ n
  ← rewrite mult_2 sym=false goal=15
    #[17] n MOD m + n MOD m ≤ m + n MOD m
  ← rule le_add2 goal=17
    #[18] n MOD m ≤ m
    #[19] n MOD m ≤ n MOD m
  ← rule lt_imp_le goal=18
    #[20] n MOD m < m
  ← rewrite mod_lt_eq_lt sym=false goal=20
  ← rule less_eq_refl goal=19
    #[21] n MOD m ≤ n MOD m
  ← rewrite add_comm sym=false goal=16
    #[22] n MOD m + m ≤ n
  cut "n MOD m = n - m" goal=22
    #[23] n MOD m = n - m
  ← rule mod_uniq param_q="(1::nat)" goal=23
    #[24] n = 1 * m + (n - m)
    #[25] n - m < m
  ← rewrite mult_1_left sym=false goal=24
    #[26] n = m + (n - m)
  ← rewrite add_comm sym=false goal=26
    #[27] n = n - m + m
  ← rewrite eq_sym_eq sym=false goal=27
    #[28] n - m + m = n
  ← rule sub_add goal=28
  ← z3 goal=25 facts=[13]
    #[29] n - m < m
  ← rewrite source=prev goal=22 facts=[23]
    #[30] n - m + m ≤ n
  → forward sub_add goal=30 facts=[2]
    #[31] n - m + m = n
  ← rewrite source=prev goal=30 facts=[31]
    #[32] n ≤ n
  ← rule less_eq_refl goal=32
    #[33] n ≤ n
qed

theorem div_1
  fixes n :: nat
  prop n DIV 1 = n
  [hint_rewrite]
proof
  ← rule div_uniq param_r="(0::nat)" goal=0
    #[1] n = n * 1 + 0
    #[2] (0::nat) < 1
  nat_norm goal=1
  ← rule le_1_1 goal=2
    #[3] ¬((1::nat) = 0)
  nat_const_ineq goal=3
qed

theorem mod_1
  fixes n :: nat
  prop n MOD 1 = 0
  [hint_rewrite]
proof
  ← rule mod_uniq param_q=n goal=0
    #[1] n = n * 1 + 0
    #[2] (0::nat) < 1
  nat_norm goal=1
  ← rewrite nat_one_def sym=false goal=2
    #[3] 0 < Suc 0
  ← rewrite less_Suc_lesseq sym=false goal=3
    #[4] (0::nat) ≤ 0
  ← rule less_eq_refl goal=4
qed

theorem div_lt
  fixes m :: nat, n :: nat
  prop m < n --> m DIV n = 0
  [hint_backward]
proof
  ← intro goal=0
    #[1] m < n
    #[2] m DIV n = 0
  ← rule div_uniq param_r=m goal=2
    #[3] m = 0 * n + m
  nat_norm goal=3
    #[4] m = 0 * n + m
qed

theorem mod_mod
  fixes m :: nat, n :: nat, p :: nat
  prop m MOD (n * p) MOD n = m MOD n
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ m MOD (n * p) MOD n = m MOD n
    #[2] ¬(n = 0) ⟶ m MOD (n * p) MOD n = m MOD n
  ← intro goal=1
    #[3] n = 0
    #[4] m MOD (n * p) MOD n = m MOD n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m MOD (0 * p) MOD 0 = m MOD 0
  ← rewrite nat_times_def_1 sym=false goal=5
    #[6] m MOD 0 MOD 0 = m MOD 0
  ← rewrite mod_zero sym=false goal=6
    #[7] m MOD 0 = m
  ← rewrite mod_zero sym=false goal=7
    #[8] m MOD 0 = m
  ← intro goal=2
    #[9] ¬(n = 0)
    #[10] m MOD (n * p) MOD n = m MOD n
  ← cases "p=0" goal=10
    #[11] p = 0 ⟶ m MOD (n * p) MOD n = m MOD n
    #[12] ¬(p = 0) ⟶ m MOD (n * p) MOD n = m MOD n
  ← intro goal=11
    #[13] p = 0
    #[14] m MOD (n * p) MOD n = m MOD n
  ← rewrite source=prev goal=14 facts=[13]
    #[15] m MOD (n * 0) MOD n = m MOD n
  ← rewrite mult_0_right sym=false goal=15
    #[16] m MOD 0 MOD n = m MOD n
  ← rewrite mod_zero sym=false goal=16
    #[17] m MOD 0 MOD n = m MOD n
  ← intro goal=12
    #[18] ¬(p = 0)
    #[19] m MOD (n * p) MOD n = m MOD n
  ← rewrite eq_sym_eq sym=false goal=19
    #[20] m MOD n = m MOD (n * p) MOD n
  ← rule mod_eq param_q="m DIV (n * p) * p" goal=20
    #[21] m = m MOD (n * p) + m DIV (n * p) * p * n
  ← rewrite mult_assoc sym=false goal=21
    #[22] m = m MOD (n * p) + m DIV (n * p) * (p * n)
  cut "p*n = n*p" goal=22
    #[23] p * n = n * p
  nat_norm goal=23
    #[24] p * n = n * p
  ← rewrite source=prev goal=22 facts=[24]
    #[25] m = m MOD (n * p) + m DIV (n * p) * (n * p)
  ← rewrite add_comm sym=false goal=25
    #[26] m = m DIV (n * p) * (n * p) + m MOD (n * p)
  ← rewrite division_simp1 sym=false goal=26
    #[27] m = m DIV (n * p) * (n * p) + m MOD (n * p)
qed

theorem mod_mod_refl
  fixes m :: nat, n :: nat
  prop m MOD n MOD n = m MOD n
  [hint_rewrite]
proof
  → forward mod_mod param_m=m param_n=n param_p="(1::nat)" goal=0
    #[1] m MOD (n * 1) MOD n = m MOD n
  → rewrite target=fact mult_1_right sym=false goal=0 facts=[1]
qed

theorem mod_mod_le
  fixes m :: nat, n :: nat, p :: nat
  prop ~(n = 0) --> n <= p --> m MOD n MOD p = m MOD n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] n ≤ p
    #[3] m MOD n MOD p = m MOD n
  ← rule mod_lt goal=3
    #[4] m MOD n < p
  ← rule lte_trans param_m=n goal=4
    #[5] m MOD n < n
  ← rewrite mod_lt_eq sym=false goal=5
qed

theorem mod_even_2
  fixes m :: nat, n :: nat
  prop even n --> m MOD n MOD 2 = m MOD 2
  [hint_backward]
proof
  ← intro goal=0
    #[1] even n
    #[2] m MOD n MOD 2 = m MOD 2
  → rewrite target=fact even_exists sym=false goal=2 facts=[1]
    #[3] ∃m. n = 2 * m
  elim p goal=2 facts=[3]
    #[4] _VAR p
    #[5] n = 2 * p
    #[6] m MOD n MOD 2 = m MOD 2
  ← rewrite source=prev goal=6 facts=[5]
    #[7] m MOD (2 * p) MOD 2 = m MOD 2
  ← rewrite mod_mod sym=false goal=7
    #[8] m MOD (2 * p) MOD 2 = m MOD 2
qed

theorem div_mult2
  fixes m :: nat, n :: nat, p :: nat
  prop ~(m = 0) --> m * n DIV (m * p) = n DIV p
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(m = 0)
    #[2] m * n DIV (m * p) = n DIV p
  ← cases "p=0" goal=2
    #[3] p = 0 ⟶ m * n DIV (m * p) = n DIV p
    #[4] ¬(p = 0) ⟶ m * n DIV (m * p) = n DIV p
  ← intro goal=3
    #[5] p = 0
    #[6] m * n DIV (m * p) = n DIV p
  ← rewrite source=prev goal=6 facts=[5]
    #[7] m * n DIV (m * 0) = n DIV 0
  ← rewrite mult_0_right sym=false goal=7
    #[8] m * n DIV 0 = n DIV 0
  ← rewrite div_zero sym=false goal=8
    #[9] m * n DIV 0 = n DIV 0
  ← intro goal=4
    #[10] ¬(p = 0)
    #[11] m * n DIV (m * p) = n DIV p
  ← rule div_uniq param_r="m * (n MOD p)" goal=11
    #[12] m * n = n DIV p * (m * p) + m * (n MOD p)
    #[13] m * (n MOD p) < m * p
  cut "n DIV p * (m * p) = m * (p * (n DIV p)) " goal=12
    #[14] n DIV p * (m * p) = m * (p * (n DIV p))
  nat_norm goal=14
    #[15] n DIV p * (m * p) = m * (p * (n DIV p))
  ← rewrite source=prev goal=12 facts=[15]
    #[16] m * n = m * (p * (n DIV p)) + m * (n MOD p)
  ← rewrite distrib_l sym=true goal=16
    #[17] m * n = m * (p * (n DIV p) + n MOD p)
  ← rewrite division_simp2 sym=false goal=17
    #[18] m * n = m * (p * (n DIV p) + n MOD p)
  ← rewrite mult_comm sym=false goal=13
    #[19] n MOD p * m < p * m
  ← rewrite lt_mult_rcancel sym=false goal=19
    #[20] n MOD p < p ∧ ¬(m = 0)
  ← rule conjI goal=20
    #[21] n MOD p < p
  ← rewrite mod_lt_eq sym=false goal=21
qed

theorem mod_mult2
  fixes m :: nat, n :: nat, p :: nat
  prop m * n MOD (m * p) = m * (n MOD p)
  [hint_rewrite]
proof
  ← cases "p=0" goal=0
    #[1] p = 0 ⟶ m * n MOD (m * p) = m * (n MOD p)
    #[2] ¬(p = 0) ⟶ m * n MOD (m * p) = m * (n MOD p)
  ← intro goal=1
    #[3] p = 0
    #[4] m * n MOD (m * p) = m * (n MOD p)
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m * n MOD (m * 0) = m * (n MOD 0)
  ← rewrite mult_0_right sym=false goal=5
    #[6] m * n MOD 0 = m * (n MOD 0)
  ← rewrite mod_zero sym=false goal=6
    #[7] m * n MOD 0 = m * (n MOD 0)
  ← intro goal=2
    #[8] ¬(p = 0)
    #[9] m * n MOD (m * p) = m * (n MOD p)
  ← cases "m=0" goal=9
    #[10] m = 0 ⟶ m * n MOD (m * p) = m * (n MOD p)
    #[11] ¬(m = 0) ⟶ m * n MOD (m * p) = m * (n MOD p)
  ← intro goal=10
    #[12] m = 0
    #[13] m * n MOD (m * p) = m * (n MOD p)
  ← rewrite source=prev goal=13 facts=[12]
    #[14] 0 * n MOD (0 * p) = 0 * (n MOD p)
  ← rewrite nat_times_def_1 sym=false goal=14
    #[15] 0 MOD 0 = 0
  ← rewrite mod_0 sym=false goal=15
    #[16] 0 MOD 0 = 0
  ← intro goal=11
    #[17] ¬(m = 0)
    #[18] m * n MOD (m * p) = m * (n MOD p)
  ← rule mod_uniq param_q="n DIV p" goal=18
    #[19] m * n = n DIV p * (m * p) + m * (n MOD p)
    #[20] m * (n MOD p) < m * p
  cut "n DIV p * (m * p) = m * (p * (n DIV p))" goal=19
    #[21] n DIV p * (m * p) = m * (p * (n DIV p))
  nat_norm goal=21
    #[22] n DIV p * (m * p) = m * (p * (n DIV p))
  ← rewrite source=prev goal=19 facts=[22]
    #[23] m * n = m * (p * (n DIV p)) + m * (n MOD p)
  ← rewrite distrib_l sym=true goal=23
    #[24] m * n = m * (p * (n DIV p) + n MOD p)
  ← rewrite division_simp2 sym=false goal=24
    #[25] m * n = m * (p * (n DIV p) + n MOD p)
  ← rewrite mult_comm sym=false goal=20
    #[26] n MOD p * m < p * m
  ← rewrite lt_mult_rcancel sym=false goal=26
    #[27] n MOD p < p ∧ ¬(m = 0)
  ← rule conjI goal=27
    #[28] n MOD p < p
  ← rewrite mod_lt_eq sym=false goal=28
qed

theorem mod_exists
  fixes m :: nat, n :: nat
  prop (?q. m = n * q) <--> (if n = 0 then m = 0 else m MOD n = 0)
  [hint_rewrite]
proof
  ← cases "n = 0" goal=0
    #[1] n = 0 ⟶ (∃q. m = n * q) ⟷ (if n = 0 then m = 0 else m MOD n = 0)
    #[2] ¬(n = 0) ⟶ (∃q. m = n * q) ⟷ (if n = 0 then m = 0 else m MOD n = 0)
  ← intro goal=1
    #[3] n = 0
    #[4] (∃q. m = n * q) ⟷ (if n = 0 then m = 0 else m MOD n = 0)
  ← rewrite if_P sym=false goal=4 facts=[3]
    #[5] (∃q. m = n * q) ⟷ m = 0
  ← rewrite source=prev goal=5 facts=[3]
    #[6] (∃q. m = 0 * q) ⟷ m = 0
  ← rewrite nat_times_def_1 sym=false goal=6
    #[7] (∃q::nat. m = 0) ⟷ m = 0
  ← z3 goal=7
    #[8] (∃q::nat. m = 0) ⟷ m = 0
  ← intro goal=2
    #[9] ¬(n = 0)
    #[10] (∃q. m = n * q) ⟷ (if n = 0 then m = 0 else m MOD n = 0)
  ← rewrite if_not_P sym=false goal=10 facts=[9]
    #[11] (∃q. m = n * q) ⟷ m MOD n = 0
  ← rule iffI goal=11
    #[12] (∃q. m = n * q) ⟶ m MOD n = 0
    #[13] m MOD n = 0 ⟶ (∃q. m = n * q)
  ← intro goal=12
    #[14] ∃q. m = n * q
    #[15] m MOD n = 0
  elim q goal=15 facts=[14]
    #[16] _VAR q
    #[17] m = n * q
    #[18] m MOD n = 0
  ← rewrite source=prev goal=18 facts=[17]
    #[19] n * q MOD n = 0
  ← rewrite mod_mult sym=false goal=19
    #[20] n * q MOD n = 0
  ← intro goal=13
    #[21] m MOD n = 0
    #[22] ∃q. m = n * q
  ← inst "m DIV n" goal=22
    #[23] m = n * (m DIV n)
  cut "m = (m DIV n) * n + m MOD n" goal=23
    #[24] m = m DIV n * n + m MOD n
  ← rewrite division_simp1 sym=false goal=24
    #[25] m = m DIV n * n + m MOD n
  → rewrite target=fact source=prev goal=23 facts=[21,25]
    #[26] m = m DIV n * n + 0
  → rewrite target=fact add_0_right sym=false goal=23 facts=[26]
    #[27] m = m DIV n * n
  ← rewrite mult_comm sym=false goal=23
qed

theorem le_rdiv_eq
  fixes a :: nat, b :: nat, n :: nat
  prop ~(a = 0) --> n <= b DIV a <--> a * n <= b
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(a = 0)
    #[2] n ≤ b DIV a ⟷ a * n ≤ b
  ← rule iffI goal=2
    #[3] n ≤ b DIV a ⟶ a * n ≤ b
    #[4] a * n ≤ b ⟶ n ≤ b DIV a
  ← intro goal=3
    #[5] n ≤ b DIV a
    #[6] a * n ≤ b
  ← rule less_eq_trans param_m="a * (b DIV a)" goal=6
    #[7] a * n ≤ a * (b DIV a)
    #[8] a * (b DIV a) ≤ b
  ← rewrite mult_comm sym=false goal=7
    #[9] n * a ≤ b DIV a * a
  ← rewrite le_mult_rcancel sym=false goal=9
    #[10] n ≤ b DIV a ∨ a = 0
  ← rule disjI1 goal=10
  ← rule div_mul_le goal=8
    #[11] a * (b DIV a) ≤ b
  ← intro goal=4
    #[12] a * n ≤ b
    #[13] n ≤ b DIV a
  cut "a * n < a * (b DIV a + 1)" goal=13
    #[14] a * n < a * (b DIV a + 1)
  ← rule let_trans param_m="(b DIV a) * a + b MOD a" goal=14
    #[15] a * n ≤ b DIV a * a + b MOD a
    #[16] b DIV a * a + b MOD a < a * (b DIV a + 1)
  ← rewrite division_simp1 sym=false goal=15
  ← rewrite distrib_l sym=false goal=16
    #[17] b DIV a * a + b MOD a < a * (b DIV a) + a * 1
  cut "b DIV a * a = a * (b DIV a)" goal=17
    #[18] b DIV a * a = a * (b DIV a)
  nat_norm goal=18
    #[19] b DIV a * a = a * (b DIV a)
  ← rewrite source=prev goal=17 facts=[19]
    #[20] a * (b DIV a) + b MOD a < a * (b DIV a) + a * 1
  ← rewrite lt_add_lcancel sym=false goal=20
    #[21] b MOD a < a * 1
  ← rewrite mult_1_right sym=false goal=21
    #[22] b MOD a < a
  ← rewrite mod_lt_eq sym=false goal=22
  → rewrite target=fact mult_comm sym=false goal=13 facts=[14]
    #[23] n * a < (b DIV a + 1) * a
  → rewrite target=fact lt_mult_rcancel sym=false goal=13 facts=[23]
    #[24] n < b DIV a + 1 ∧ ¬(a = 0)
  → forward conjD1 goal=13 facts=[24]
    #[25] n < b DIV a + 1
  → rewrite target=fact add_1_right sym=false goal=13 facts=[25]
    #[26] n < Suc (b DIV a)
  → rewrite target=fact less_Suc_lesseq sym=false goal=13 facts=[26]
qed

theorem rdiv_lt_eq
  fixes a :: nat, b :: nat, n :: nat
  prop ~(a = 0) --> b DIV a < n <--> b < a * n
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(a = 0)
    #[2] b DIV a < n ⟷ b < a * n
  ← rewrite not_le sym=true goal=2
    #[3] ¬(n ≤ b DIV a) ⟷ ¬(a * n ≤ b)
  → forward le_rdiv_eq param_b=b param_n=n goal=3 facts=[1]
    #[4] n ≤ b DIV a ⟷ a * n ≤ b
  ← rewrite source=prev goal=3 facts=[4]
qed

theorem le_ldiv_eq
  fixes a :: nat, b :: nat, n :: nat
  prop ~(a = 0) --> b DIV a <= n <--> b < a * (n + 1)
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(a = 0)
    #[2] b DIV a ≤ n ⟷ b < a * (n + 1)
  ← rewrite add_1_right sym=false goal=2
    #[3] b DIV a ≤ n ⟷ b < a * Suc n
  ← rewrite not_lt sym=true goal=3
    #[4] ¬(n < b DIV a) ⟷ b < a * Suc n
  cut "n < b DIV a <--> Suc n <= b DIV a" goal=4
    #[5] n < b DIV a ⟷ Suc n ≤ b DIV a
  ← rewrite lesseq_Suc_less sym=false goal=5
    #[6] n < b DIV a ⟷ Suc n ≤ b DIV a
  ← rewrite source=prev goal=4 facts=[6]
    #[7] ¬(Suc n ≤ b DIV a) ⟷ b < a * Suc n
  → forward le_rdiv_eq param_b=b param_n="Suc n" goal=7 facts=[1]
    #[8] Suc n ≤ b DIV a ⟷ a * Suc n ≤ b
  ← rewrite source=prev goal=7 facts=[8]
    #[9] ¬(a * Suc n ≤ b) ⟷ b < a * Suc n
  ← rewrite not_le sym=false goal=9
    #[10] ¬(a * Suc n ≤ b) ⟷ b < a * Suc n
qed

theorem ldiv_lt_eq
  fixes a :: nat, b :: nat, n :: nat
  prop ~(a = 0) --> n < b DIV a <--> a * (n + 1) <= b
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(a = 0)
    #[2] n < b DIV a ⟷ a * (n + 1) ≤ b
  ← rewrite not_le sym=true goal=2
    #[3] ¬(b DIV a ≤ n) ⟷ a * (n + 1) ≤ b
  → forward le_ldiv_eq param_b=b param_n=n goal=3 facts=[1]
    #[4] b DIV a ≤ n ⟷ b < a * (n + 1)
  ← rewrite source=prev goal=3 facts=[4]
    #[5] ¬(b < a * (n + 1)) ⟷ a * (n + 1) ≤ b
  ← rewrite not_lt sym=false goal=5
    #[6] ¬(b < a * (n + 1)) ⟷ a * (n + 1) ≤ b
qed

theorem le_ldiv
  fixes a :: nat, b :: nat, n :: nat
  prop ~(a = 0) --> b <= a * n --> b DIV a <= n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(a = 0)
    #[2] b ≤ a * n
    #[3] b DIV a ≤ n
  → forward le_ldiv_eq param_b=b param_n=n goal=3 facts=[1]
    #[4] b DIV a ≤ n ⟷ b < a * (n + 1)
  ← rewrite source=prev goal=3 facts=[4]
    #[5] b < a * (n + 1)
  ← rule let_trans param_m="a * n" goal=5
    #[6] a * n < a * (n + 1)
  ← rewrite distrib_l sym=false goal=6
    #[7] a * n < a * n + a * 1
  ← rewrite lt_add sym=false goal=7
    #[8] 0 < a * 1
  ← rewrite mult_1_right sym=false goal=8
    #[9] 0 < a
  ← rule le_1_1 goal=9
qed

theorem div_mono
  fixes m :: nat, n :: nat, p :: nat
  prop m <= n --> m DIV p <= n DIV p
  [hint_backward]
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] m DIV p ≤ n DIV p
  ← cases "p=0" goal=2
    #[3] p = 0 ⟶ m DIV p ≤ n DIV p
    #[4] ¬(p = 0) ⟶ m DIV p ≤ n DIV p
  ← intro goal=3
    #[5] p = 0
    #[6] m DIV p ≤ n DIV p
  ← rewrite source=prev goal=6 facts=[5]
    #[7] m DIV 0 ≤ n DIV 0
  ← rewrite div_zero sym=false goal=7
    #[8] (0::nat) ≤ 0
  ← rewrite nat_less_eq_def_1 sym=false goal=8
    #[9] (0::nat) ≤ 0
  ← intro goal=4
    #[10] ¬(p = 0)
    #[11] m DIV p ≤ n DIV p
  cut "!a::nat. !b. (!k. k <= a --> k <= b) --> a <= b " goal=11
    #[12] ∀a::nat. ∀b. (∀k. k ≤ a ⟶ k ≤ b) ⟶ a ≤ b
  ← z3 goal=12
    #[13] ∀a::nat. ∀b. (∀k. k ≤ a ⟶ k ≤ b) ⟶ a ≤ b
  ← apply_prev goal=11 facts=[13]
    #[14] ∀k. k ≤ m DIV p ⟶ k ≤ n DIV p
  ← intro k goal=14
    #[15] _VAR k
    #[16] k ≤ m DIV p
    #[17] k ≤ n DIV p
  → forward le_rdiv_eq param_b=n param_n=k goal=17 facts=[10]
    #[18] k ≤ n DIV p ⟷ p * k ≤ n
  ← rewrite source=prev goal=17 facts=[18]
    #[19] p * k ≤ n
  → forward le_rdiv_eq param_b=m param_n=k goal=19 facts=[10]
    #[20] k ≤ m DIV p ⟷ p * k ≤ m
  → rewrite target=fact source=prev goal=19 facts=[20,16]
    #[21] p * k ≤ m
  ← rule less_eq_trans param_m=m goal=19
qed

theorem div_mono_lt
  fixes m :: nat, n :: nat, p :: nat
  prop ~(p = 0) --> m + p <= n --> m DIV p < n DIV p
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(p = 0)
    #[2] m + p ≤ n
    #[3] m DIV p < n DIV p
  cut "!a. !b. (!k::nat. k <= a --> k + 1 <= b) --> a < b" goal=3
    #[4] ∀a::nat. ∀b. (∀k. k ≤ a ⟶ k + 1 ≤ b) ⟶ a < b
  ← z3 goal=4
    #[5] ∀a::nat. ∀b. (∀k. k ≤ a ⟶ k + 1 ≤ b) ⟶ a < b
  ← apply_prev goal=3 facts=[5]
    #[6] ∀k. k ≤ m DIV p ⟶ k + 1 ≤ n DIV p
  ← intro k goal=6
    #[7] _VAR k
    #[8] k ≤ m DIV p
    #[9] k + 1 ≤ n DIV p
  → forward le_rdiv_eq param_b=n param_n=k+1 goal=9 facts=[1]
    #[10] k + 1 ≤ n DIV p ⟷ p * (k + 1) ≤ n
  → forward le_rdiv_eq param_b=m param_n=k goal=9 facts=[1]
    #[11] k ≤ m DIV p ⟷ p * k ≤ m
  → rewrite target=fact source=prev goal=9 facts=[11,8]
    #[12] p * k ≤ m
  ← rewrite source=prev goal=9 facts=[10]
    #[13] p * (k + 1) ≤ n
  ← rule less_eq_trans param_m=m+p goal=13
    #[14] p * (k + 1) ≤ m + p
  ← rewrite distrib_l sym=false goal=14
    #[15] p * k + p * 1 ≤ m + p
  ← rewrite mult_1_right sym=false goal=15
    #[16] p * k + p ≤ m + p
  ← rule le_add2 goal=16
    #[17] p ≤ p
  ← rule less_eq_refl goal=17
    #[18] p ≤ p
qed

theorem div_eq_0
  fixes m :: nat, n :: nat
  prop ~(n = 0) --> m DIV n = 0 <--> m < n
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] m DIV n = 0 ⟷ m < n
  ← rule iffI goal=2
    #[3] m DIV n = 0 ⟶ m < n
    #[4] m < n ⟶ m DIV n = 0
  ← intro goal=3
    #[5] m DIV n = 0
    #[6] m < n
  → forward division param_m=m goal=6 facts=[1]
    #[7] m = m DIV n * n + m MOD n ∧ m MOD n < n
  → forward conjD1 goal=6 facts=[7]
    #[8] m = m DIV n * n + m MOD n
  → rewrite target=fact source=prev goal=6 facts=[5,8]
    #[9] m = 0 * n + m MOD n
  → rewrite target=fact nat_times_def_1 sym=false goal=6 facts=[9]
    #[10] m = 0 + m MOD n
  → rewrite target=fact nat_plus_def_1 sym=false goal=6 facts=[10]
    #[11] m = m MOD n
  ← rewrite source=prev goal=6 facts=[11]
    #[12] m MOD n < n
  ← rewrite mod_lt_eq sym=false goal=12
  ← intro goal=4
    #[13] m < n
    #[14] m DIV n = 0
  ← rule div_uniq param_r=m goal=14
    #[15] m = 0 * n + m
  nat_norm goal=15
    #[16] m = 0 * n + m
qed

theorem mod_eq_0
  fixes m :: nat, n :: nat
  prop m MOD n = 0 <--> (?q. m = q * n)
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ m MOD n = 0 ⟷ (∃q. m = q * n)
    #[2] ¬(n = 0) ⟶ m MOD n = 0 ⟷ (∃q. m = q * n)
  ← intro goal=1
    #[3] n = 0
    #[4] m MOD n = 0 ⟷ (∃q. m = q * n)
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m MOD 0 = 0 ⟷ (∃q. m = q * 0)
  ← rule iffI goal=5
    #[6] m MOD 0 = 0 ⟶ (∃q. m = q * 0)
    #[7] (∃q. m = q * 0) ⟶ m MOD 0 = 0
  ← intro goal=6
    #[8] m MOD 0 = 0
    #[9] ∃q. m = q * 0
  → rewrite target=fact mod_zero sym=false goal=9 facts=[8]
    #[10] m = 0
  ← rewrite source=prev goal=9 facts=[10]
    #[11] ∃q::nat. 0 = q * 0
  ← rewrite mult_0_right sym=false goal=11
    #[12] ∃q::nat. (0::nat) = 0
  ← z3 goal=12
    #[13] ∃q::nat. (0::nat) = 0
  ← intro goal=7
    #[14] ∃q. m = q * 0
    #[15] m MOD 0 = 0
  ← rewrite mod_zero sym=false goal=15
    #[16] m = 0
  elim q goal=16 facts=[14]
    #[17] _VAR q
    #[18] m = q * 0
    #[19] m = 0
    #[20] m MOD 0 = 0
  → rewrite target=fact mult_0_right sym=false goal=19 facts=[18]
    #[21] m = 0
  ← intro goal=2
    #[22] ¬(n = 0)
    #[23] m MOD n = 0 ⟷ (∃q. m = q * n)
  ← rule iffI goal=23
    #[24] m MOD n = 0 ⟶ (∃q. m = q * n)
    #[25] (∃q. m = q * n) ⟶ m MOD n = 0
  ← intro goal=24
    #[26] m MOD n = 0
    #[27] ∃q. m = q * n
  → forward division param_m=m goal=27 facts=[22]
    #[28] m = m DIV n * n + m MOD n ∧ m MOD n < n
  → forward conjD1 goal=27 facts=[28]
    #[29] m = m DIV n * n + m MOD n
  → rewrite target=fact source=prev goal=27 facts=[26,29]
    #[30] m = m DIV n * n + 0
  → rewrite target=fact add_0_right sym=false goal=27 facts=[30]
    #[31] m = m DIV n * n
  ← rule exI goal=27 facts=[31]
  ← intro goal=25
    #[32] ∃q. m = q * n
    #[33] m MOD n = 0
  elim q goal=33 facts=[32]
    #[34] m = q * n
    #[35] m MOD n = 0
  ← rule mod_uniq param_q=q goal=35
    #[36] m = q * n + 0
    #[37] 0 < n
  ← rewrite add_0_right sym=false goal=36
  ← rule le_1_1 goal=37
qed

theorem div_eq_self
  fixes m :: nat, n :: nat
  prop m DIV n = m <--> m = 0 | n = 1
  [hint_rewrite]
proof
  ← cases "m=0" goal=0
    #[1] m = 0 ⟶ m DIV n = m ⟷ m = 0 ∨ n = 1
    #[2] ¬(m = 0) ⟶ m DIV n = m ⟷ m = 0 ∨ n = 1
  ← intro goal=1
    #[3] m = 0
    #[4] m DIV n = m ⟷ m = 0 ∨ n = 1
  ← rewrite source=prev goal=4 facts=[3]
    #[5] 0 DIV n = 0 ⟷ (0::nat) = 0 ∨ n = 1
  ← rewrite div_0 sym=false goal=5
    #[6] (0::nat) = 0 ⟷ (0::nat) = 0 ∨ n = 1
  ← rule iffI goal=6
    #[7] (0::nat) = 0 ⟶ (0::nat) = 0 ∨ n = 1
    #[8] (0::nat) = 0 ∨ n = 1 ⟶ (0::nat) = 0
  ← intro goal=7
    #[9] (0::nat) = 0
    #[10] (0::nat) = 0 ∨ n = 1
  ← rule disjI1 goal=10
  ← intro goal=8
    #[11] (0::nat) = 0 ∨ n = 1
    #[12] (0::nat) = 0
  ← rule eq_refl goal=12
    #[13] (0::nat) = 0
  ← intro goal=2
    #[14] ¬(m = 0)
    #[15] m DIV n = m ⟷ m = 0 ∨ n = 1
  ← cases "n=1" goal=15
    #[16] n = 1 ⟶ m DIV n = m ⟷ m = 0 ∨ n = 1
    #[17] ¬(n = 1) ⟶ m DIV n = m ⟷ m = 0 ∨ n = 1
  ← intro goal=16
    #[18] n = 1
    #[19] m DIV n = m ⟷ m = 0 ∨ n = 1
  ← rewrite source=prev goal=19 facts=[18]
    #[20] m DIV 1 = m ⟷ m = 0 ∨ (1::nat) = 1
  ← rewrite div_1 sym=false goal=20
    #[21] m = m ⟷ m = 0 ∨ (1::nat) = 1
  ← rule iffI goal=21
    #[22] m = m ⟶ m = 0 ∨ (1::nat) = 1
    #[23] m = 0 ∨ (1::nat) = 1 ⟶ m = m
  ← intro goal=22
    #[24] m = m
    #[25] m = 0 ∨ (1::nat) = 1
  ← rule disjI2 goal=25
    #[26] (1::nat) = 1
  ← rule eq_refl goal=26
    #[27] (1::nat) = 1
  ← intro goal=23
    #[28] m = 0 ∨ (1::nat) = 1
    #[29] m = m
  ← rule eq_refl goal=29
    #[30] m = m
  ← intro goal=17
    #[31] ¬(n = 1)
    #[32] m DIV n = m ⟷ m = 0 ∨ n = 1
  ← cases "n=0" goal=32
    #[33] n = 0 ⟶ m DIV n = m ⟷ m = 0 ∨ n = 1
    #[34] ¬(n = 0) ⟶ m DIV n = m ⟷ m = 0 ∨ n = 1
  ← intro goal=33
    #[35] n = 0
    #[36] m DIV n = m ⟷ m = 0 ∨ n = 1
  ← rewrite source=prev goal=36 facts=[35]
    #[37] m DIV 0 = m ⟷ m = 0 ∨ (0::nat) = 1
  ← rule iffI goal=37
    #[38] m DIV 0 = m ⟶ m = 0 ∨ (0::nat) = 1
    #[39] m = 0 ∨ (0::nat) = 1 ⟶ m DIV 0 = m
  ← intro goal=38
    #[40] m DIV 0 = m
    #[41] m = 0 ∨ (0::nat) = 1
  → rewrite target=fact div_zero sym=false goal=41 facts=[40]
    #[42] 0 = m
  ← z3 goal=41 facts=[42,14]
    #[43] m = 0 ∨ (0::nat) = 1
  ← intro goal=39
    #[44] m = 0 ∨ (0::nat) = 1
    #[45] m DIV 0 = m
  ← z3 goal=45 facts=[44,14]
    #[46] m DIV 0 = m
  ← intro goal=34
    #[47] ¬(n = 0)
    #[48] m DIV n = m ⟷ m = 0 ∨ n = 1
  ← rule iffI goal=48
    #[49] m DIV n = m ⟶ m = 0 ∨ n = 1
    #[50] m = 0 ∨ n = 1 ⟶ m DIV n = m
  ← intro goal=49
    #[51] m DIV n = m
    #[52] m = 0 ∨ n = 1
  ← rule contrapositive goal=52 facts=[51]
    #[53] ¬(m = 0 ∨ n = 1) ⟶ ¬(m DIV n = m)
  ← intro goal=53
    #[54] ¬(m = 0 ∨ n = 1)
    #[55] ¬(m DIV n = m)
  cut "!m. !n::nat. m < n --> ~(m = n)" goal=55
    #[56] ∀m::nat. ∀n. m < n ⟶ ¬(m = n)
  ← z3 goal=56
    #[57] ∀m::nat. ∀n. m < n ⟶ ¬(m = n)
  ← apply_prev goal=55 facts=[57]
    #[58] m DIV n < m
  → forward rdiv_lt_eq param_b=m param_n=m goal=58 facts=[47]
    #[59] m DIV n < m ⟷ m < n * m
  ← rewrite source=prev goal=58 facts=[59]
    #[60] m < n * m
  → rewrite target=fact de_morgan_thm2 sym=false goal=60 facts=[54]
    #[61] ¬(m = 0) ∧ ¬(n = 1)
  → forward conjD2 goal=60 facts=[61]
    #[62] ¬(n = 1)
  → forward conjD1 goal=60 facts=[61]
    #[63] ¬(m = 0)
  ← z3 goal=60 facts=[47,62,63]
    #[64] m < n * m
  ← intro goal=50
    #[65] m = 0 ∨ n = 1
    #[66] m DIV n = m
  ← rule disjE goal=66 facts=[65]
    #[67] m = 0 ⟶ m DIV n = m
    #[68] n = 1 ⟶ m DIV n = m
  ← intro goal=67
    #[69] m DIV n = m
  ← rule negE_gen goal=69 facts=[14,3]
    #[70] m DIV n = m
  ← intro goal=68
    #[71] m DIV n = m
  ← rewrite source=prev goal=71 facts=[18]
    #[72] m DIV 1 = m
  ← rewrite div_1 sym=false goal=72
    #[73] m DIV 1 = m
qed

theorem mod_refl
  fixes n :: nat
  prop n MOD n = 0
  [hint_rewrite]
proof
  ← rewrite mod_eq_0 sym=false goal=0
    #[1] ∃q. n = q * n
  ← inst "(1::nat)" goal=1
    #[2] n = 1 * n
  ← rewrite mult_1_left sym=false goal=2
qed

theorem even_mod
  fixes n :: nat
  prop even n <--> n MOD 2 = 0
  [hint_rewrite]
proof
  ← rewrite even_exists sym=false goal=0
    #[1] (∃m. n = 2 * m) ⟷ n MOD 2 = 0
  ← rewrite mod_eq_0 sym=false goal=1
    #[2] (∃m. n = 2 * m) ⟷ (∃q. n = q * 2)
  ← rule iffI goal=2
    #[3] (∃m. n = 2 * m) ⟶ (∃q. n = q * 2)
    #[4] (∃q. n = q * 2) ⟶ (∃m. n = 2 * m)
  ← intro goal=3
    #[5] ∃m. n = 2 * m
    #[6] ∃q. n = q * 2
  elim m goal=6 facts=[5]
    #[7] _VAR m
    #[8] n = 2 * m
    #[9] ∃q. n = q * 2
  ← inst m goal=9
    #[10] n = m * 2
  ← rewrite source=prev goal=10 facts=[8]
    #[11] 2 * m = m * 2
  nat_norm goal=11
    #[12] 2 * m = m * 2
  ← intro goal=4
    #[13] ∃q. n = q * 2
    #[14] ∃m. n = 2 * m
  elim q goal=14 facts=[13]
    #[15] _VAR q
    #[16] n = q * 2
    #[17] ∃m. n = 2 * m
  ← inst q goal=17
    #[18] n = 2 * q
  ← rewrite source=prev goal=18 facts=[16]
    #[19] q * 2 = 2 * q
  nat_norm goal=19
    #[20] q * 2 = 2 * q
qed

theorem odd_mod
  fixes n :: nat
  prop odd n <--> n MOD 2 = 1
  [hint_rewrite]
proof
  ← rewrite not_even sym=true goal=0
    #[1] ¬(even n) ⟷ n MOD 2 = 1
  ← rewrite even_mod sym=false goal=1
    #[2] ¬(n MOD 2 = 0) ⟷ n MOD 2 = 1
  cut "n MOD 2 < 2" goal=2
    #[3] n MOD 2 < 2
  ← rewrite mod_lt_eq sym=false goal=3
    #[4] ¬((2::nat) = 0)
  nat_const_ineq goal=4
  cut "∀n::nat. n < 2 ⟷ n = 0 ∨ n = 1" goal=2
    #[5] ∀n::nat. n < 2 ⟷ n = 0 ∨ n = 1
  ← z3 goal=5
  → rewrite target=fact source=prev goal=2 facts=[5,3]
    #[6] n MOD 2 = 0 ∨ n MOD 2 = 1
  ← rule disjE goal=2 facts=[6]
    #[7] n MOD 2 = 0 ⟶ ¬(n MOD 2 = 0) ⟷ n MOD 2 = 1
    #[8] n MOD 2 = 1 ⟶ ¬(n MOD 2 = 0) ⟷ n MOD 2 = 1
  ← intro goal=7
    #[9] n MOD 2 = 0
    #[10] ¬(n MOD 2 = 0) ⟷ n MOD 2 = 1
  ← rule iffI goal=10
    #[11] ¬(n MOD 2 = 0) ⟶ n MOD 2 = 1
    #[12] n MOD 2 = 1 ⟶ ¬(n MOD 2 = 0)
  ← intro goal=11
    #[13] ¬(n MOD 2 = 0)
    #[14] n MOD 2 = 1
  ← rule negE_gen goal=14 facts=[13,9]
  ← intro goal=12
    #[15] n MOD 2 = 1
    #[16] ¬(n MOD 2 = 0)
  → rewrite target=fact source=prev goal=16 facts=[15,9]
    #[17] (1::nat) = 0
  ← z3 goal=16 facts=[17]
  ← intro goal=8
    #[18] ¬(n MOD 2 = 0) ⟷ n MOD 2 = 1
  ← rule iffI goal=18
    #[19] ¬(n MOD 2 = 0) ⟶ n MOD 2 = 1
    #[20] n MOD 2 = 1 ⟶ ¬(n MOD 2 = 0)
  ← intro goal=19
  ← intro goal=20
    #[21] ¬(n MOD 2 = 0)
  ← rewrite source=prev goal=21 facts=[15]
    #[22] ¬((1::nat) = 0)
  nat_const_ineq goal=22
    #[23] ¬((1::nat) = 0)
qed

theorem mod_2_cases
  fixes n :: nat
  prop n MOD 2 = (if even n then 0 else 1)
  [hint_rewrite]
proof
  ← cases "even n" goal=0
    #[1] even n ⟶ n MOD 2 = (if even n then 0 else 1)
    #[2] ¬(even n) ⟶ n MOD 2 = (if even n then 0 else 1)
  ← intro goal=1
    #[3] even n
    #[4] n MOD 2 = (if even n then 0 else 1)
  ← rewrite if_P sym=false goal=4 facts=[3]
    #[5] n MOD 2 = 0
  → rewrite target=fact even_mod sym=false goal=5 facts=[3]
  ← intro goal=2
    #[6] ¬(even n)
    #[7] n MOD 2 = (if even n then 0 else 1)
  ← rewrite if_not_P sym=false goal=7 facts=[6]
    #[8] n MOD 2 = 1
  → rewrite target=fact not_even sym=false goal=8 facts=[6]
    #[9] odd n
  → rewrite target=fact odd_mod sym=false goal=8 facts=[9]
qed

theorem even_mod_even
  fixes m :: nat, n :: nat
  prop even n --> even (m MOD n) <--> even m
  [hint_backward]
proof
  ← intro goal=0
    #[1] even n
    #[2] even (m MOD n) ⟷ even m
  ← rewrite even_mod sym=false goal=2
    #[3] m MOD n MOD 2 = 0 ⟷ m MOD 2 = 0
  → forward mod_even_2 param_m=m goal=3 facts=[1]
    #[4] m MOD n MOD 2 = m MOD 2
  ← rewrite source=prev goal=3 facts=[4]
qed

theorem odd_mod_even
  fixes m :: nat, n :: nat
  prop even n --> odd (m MOD n) <--> odd m
  [hint_backward]
proof
  ← intro goal=0
    #[1] even n
    #[2] odd (m MOD n) ⟷ odd m
  ← rewrite not_even sym=true goal=2
    #[3] ¬(even (m MOD n)) ⟷ ¬(even m)
  → forward even_mod_even param_m=m goal=3 facts=[1]
    #[4] even (m MOD n) ⟷ even m
  ← rewrite source=prev goal=3 facts=[4]
qed

theorem mod_mult_rmod
  fixes m :: nat, n :: nat, p :: nat
  prop m * (p MOD n) MOD n = m * p MOD n
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ m * (p MOD n) MOD n = m * p MOD n
    #[2] ¬(n = 0) ⟶ m * (p MOD n) MOD n = m * p MOD n
  ← intro goal=1
    #[3] n = 0
    #[4] m * (p MOD n) MOD n = m * p MOD n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m * (p MOD 0) MOD 0 = m * p MOD 0
  ← rewrite mod_zero sym=false goal=5
    #[6] m * (p MOD 0) = m * p
  ← rewrite mod_zero sym=false goal=6
    #[7] m * (p MOD 0) = m * p
  ← intro goal=2
    #[8] ¬(n = 0)
    #[9] m * (p MOD n) MOD n = m * p MOD n
  ← rewrite eq_sym_eq sym=false goal=9
    #[10] m * p MOD n = m * (p MOD n) MOD n
  ← rule mod_eq param_q="m * (p DIV n)" goal=10
    #[11] m * p = m * (p MOD n) + m * (p DIV n) * n
  ← rewrite mult_assoc sym=false goal=11
    #[12] m * p = m * (p MOD n) + m * (p DIV n * n)
  ← rewrite distrib_l sym=true goal=12
    #[13] m * p = m * (p MOD n + p DIV n * n)
  ← rewrite eq_mult_lcancel sym=false goal=13
    #[14] m = 0 ∨ p = p MOD n + p DIV n * n
  ← rule disjI2 goal=14
    #[15] p = p MOD n + p DIV n * n
  ← rewrite add_comm sym=false goal=15
    #[16] p = p DIV n * n + p MOD n
  ← rewrite division_simp1 sym=false goal=16
    #[17] p = p DIV n * n + p MOD n
qed

theorem mod_mult_lmod
  fixes m :: nat, n :: nat, p :: nat
  prop m MOD n * p MOD n = m * p MOD n
  [hint_rewrite]
proof
  ← rewrite mult_comm sym=false goal=0
    #[1] p * (m MOD n) MOD n = p * m MOD n
  ← rewrite mod_mult_rmod sym=false goal=1
qed

theorem mod_mult_mod2
  fixes m :: nat, n :: nat, p :: nat
  prop m MOD n * (p MOD n) MOD n = m * p MOD n
  [hint_rewrite]
proof
  ← rewrite mod_mult_rmod sym=false goal=0
    #[1] m MOD n * p MOD n = m * p MOD n
  ← rewrite mod_mult_lmod sym=false goal=1
qed

theorem mod_exp_mod
  fixes m :: nat, n :: nat, p :: nat
  prop (m MOD n) ^ p MOD n = m ^ p MOD n
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ (m MOD n) ^ p MOD n = m ^ p MOD n
    #[2] ¬(n = 0) ⟶ (m MOD n) ^ p MOD n = m ^ p MOD n
  ← intro goal=1
    #[3] n = 0
    #[4] (m MOD n) ^ p MOD n = m ^ p MOD n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] (m MOD 0) ^ p MOD 0 = m ^ p MOD 0
  ← rewrite mod_zero sym=false goal=5
    #[6] (m MOD 0) ^ p = m ^ p
  ← rewrite mod_zero sym=false goal=6
    #[7] (m MOD 0) ^ p = m ^ p
  ← intro goal=2
    #[8] ¬(n = 0)
    #[9] (m MOD n) ^ p MOD n = m ^ p MOD n
  ← induct p nat_induct goal=9
    #[10] (m MOD n) ^ (0::nat) MOD n = m ^ (0::nat) MOD n
    #[11] ∀n1. (m MOD n) ^ n1 MOD n = m ^ n1 MOD n ⟶ (m MOD n) ^ Suc n1 MOD n = m ^ Suc n1 MOD n
  ← rewrite nat_nat_power_def_1 sym=false goal=10
    #[12] (m MOD n) ^ (0::nat) MOD n = m ^ (0::nat) MOD n
  ← intro p goal=11
    #[13] _VAR p
    #[14] (m MOD n) ^ p MOD n = m ^ p MOD n
    #[15] (m MOD n) ^ Suc p MOD n = m ^ Suc p MOD n
  ← rewrite nat_nat_power_def_2 sym=false goal=15
    #[16] m MOD n * (m MOD n) ^ p MOD n = m * m ^ p MOD n
  ← rewrite mod_mult_lmod sym=false goal=16
    #[17] m * (m MOD n) ^ p MOD n = m * m ^ p MOD n
  cut "m * (m MOD n) ^ p MOD n = m * ((m MOD n) ^ p MOD n) MOD n" goal=17
    #[18] m * (m MOD n) ^ p MOD n = m * ((m MOD n) ^ p MOD n) MOD n
  ← rewrite mod_mult_rmod sym=false goal=18
    #[19] m * (m MOD n) ^ p MOD n = m * ((m MOD n) ^ p MOD n) MOD n
  ← rewrite source=prev goal=17 facts=[19]
    #[20] m * ((m MOD n) ^ p MOD n) MOD n = m * m ^ p MOD n
  ← rewrite source=prev goal=20 facts=[14]
    #[21] m * (m ^ p MOD n) MOD n = m * m ^ p MOD n
  ← rewrite mod_mult_rmod sym=false goal=21
    #[22] m * (m ^ p MOD n) MOD n = m * m ^ p MOD n
qed

theorem mod_mult_add_1
  fixes m :: nat, n :: nat, p :: nat
  prop (m * n + p) MOD n = p MOD n
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ (m * n + p) MOD n = p MOD n
    #[2] ¬(n = 0) ⟶ (m * n + p) MOD n = p MOD n
  ← intro goal=1
    #[3] n = 0
    #[4] (m * n + p) MOD n = p MOD n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] (m * 0 + p) MOD 0 = p MOD 0
  ← rewrite mult_0_right sym=false goal=5
    #[6] (0 + p) MOD 0 = p MOD 0
  ← rewrite nat_plus_def_1 sym=false goal=6
    #[7] (0 + p) MOD 0 = p MOD 0
  ← intro goal=2
    #[8] ¬(n = 0)
    #[9] (m * n + p) MOD n = p MOD n
  ← rule mod_uniq param_q="m+p DIV n" goal=9
    #[10] m * n + p = (m + p DIV n) * n + p MOD n
    #[11] p MOD n < n
  ← rewrite distrib_r sym=false goal=10
    #[12] m * n + p = m * n + p DIV n * n + p MOD n
  ← rewrite add_assoc sym=false goal=12
    #[13] m * n + p = m * n + (p DIV n * n + p MOD n)
  ← rewrite division_simp1 sym=false goal=13
    #[14] m * n + p = m * n + (p DIV n * n + p MOD n)
  ← rewrite mod_lt_eq sym=false goal=11
qed

theorem mod_mult_add_2
  fixes m :: nat, n :: nat, p :: nat
  prop (n * m + p) MOD n = p MOD n
  [hint_rewrite]
proof
  ← rewrite mult_comm sym=false goal=0
    #[1] (m * n + p) MOD n = p MOD n
  ← rewrite mod_mult_add_1 sym=false goal=1
qed

theorem mod_mult_add_3
  fixes m :: nat, n :: nat, p :: nat
  prop (p + m * n) MOD n = p MOD n
  [hint_rewrite]
proof
  ← rewrite add_comm sym=false goal=0
    #[1] (m * n + p) MOD n = p MOD n
  ← rewrite mod_mult_add_1 sym=false goal=1
qed

theorem mod_mult_add_4
  fixes m :: nat, n :: nat, p :: nat
  prop (p + n * m) MOD n = p MOD n
  [hint_rewrite]
proof
  ← rewrite add_comm sym=false goal=0
    #[1] (n * m + p) MOD n = p MOD n
  ← rewrite mod_mult_add_2 sym=false goal=1
qed

theorem div_mult_add1
  fixes a :: nat, b :: nat, n :: nat
  prop ~(n = 0) --> (a * n + b) DIV n = a + b DIV n
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] (a * n + b) DIV n = a + b DIV n
  ← rule div_uniq param_r="b MOD n" goal=2
    #[3] a * n + b = (a + b DIV n) * n + b MOD n
    #[4] b MOD n < n
  ← rewrite distrib_r sym=false goal=3
    #[5] a * n + b = a * n + b DIV n * n + b MOD n
  ← rewrite add_assoc sym=false goal=5
    #[6] a * n + b = a * n + (b DIV n * n + b MOD n)
  ← rewrite division_simp1 sym=false goal=6
    #[7] a * n + b = a * n + (b DIV n * n + b MOD n)
  ← rewrite mod_lt_eq sym=false goal=4
qed

theorem div_mult_add2
  fixes a :: nat, b :: nat, n :: nat
  prop ~(n = 0) --> (n * a + b) DIV n = a + b DIV n
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] (n * a + b) DIV n = a + b DIV n
  ← rewrite mult_comm sym=false goal=2
    #[3] (a * n + b) DIV n = a + b DIV n
  ← rule div_mult_add1 goal=3 facts=[1]
qed

theorem div_mult_add3
  fixes a :: nat, b :: nat, n :: nat
  prop ~(n = 0) --> (b + a * n) DIV n = b DIV n + a
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] (b + a * n) DIV n = b DIV n + a
  ← rewrite add_comm sym=false goal=2
    #[3] (a * n + b) DIV n = a + b DIV n
  ← rule div_mult_add1 goal=3 facts=[1]
qed

theorem div_mult_add4
  fixes a :: nat, b :: nat, n :: nat
  prop ~(n = 0) --> (b + n * a) DIV n = b DIV n + a
  [hint_backward]

theorem mod_add_mod
  fixes a :: nat, b :: nat, n :: nat
  prop (a MOD n + b MOD n) MOD n = (a + b) MOD n
  [hint_rewrite]
proof
  ← cases "n = 0" goal=0
    #[1] n = 0 ⟶ (a MOD n + b MOD n) MOD n = (a + b) MOD n
    #[2] ¬(n = 0) ⟶ (a MOD n + b MOD n) MOD n = (a + b) MOD n
  ← intro goal=1
    #[3] n = 0
    #[4] (a MOD n + b MOD n) MOD n = (a + b) MOD n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] (a MOD 0 + b MOD 0) MOD 0 = (a + b) MOD 0
  ← rewrite mod_zero sym=false goal=5
    #[6] a MOD 0 + b MOD 0 = a + b
  ← rewrite mod_zero sym=false goal=6
    #[7] a MOD 0 + b MOD 0 = a + b
  ← intro goal=2
    #[8] ¬(n = 0)
    #[9] (a MOD n + b MOD n) MOD n = (a + b) MOD n
  ← rewrite eq_sym_eq sym=false goal=9
    #[10] (a + b) MOD n = (a MOD n + b MOD n) MOD n
  ← rule mod_eq param_q="a DIV n + b DIV n" goal=10
    #[11] a + b = a MOD n + b MOD n + (a DIV n + b DIV n) * n
  ← rewrite distrib_r sym=false goal=11
    #[12] a + b = a MOD n + b MOD n + (a DIV n * n + b DIV n * n)
  cut "!a. !b. !c. !d::nat. (a + b) + (c + d) = (c + a) + (d + b)" goal=12
    #[13] ∀a::nat. ∀b. ∀c. ∀d. a + b + (c + d) = c + a + (d + b)
  ← z3 goal=13
    #[14] ∀a::nat. ∀b. ∀c. ∀d. a + b + (c + d) = c + a + (d + b)
  ← rewrite source=prev goal=12 facts=[14]
    #[15] a + b = a DIV n * n + a MOD n + (b DIV n * n + b MOD n)
  ← rewrite division_simp1 sym=false goal=15
    #[16] a + b = a DIV n * n + a MOD n + (b DIV n * n + b MOD n)
qed

theorem div_add_mod
  fixes a :: nat, b :: nat, n :: nat
  prop ~(n = 0) --> (a + b) MOD n = a MOD n + b MOD n <--> (a + b) DIV n = a DIV n + b DIV n
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] (a + b) MOD n = a MOD n + b MOD n ⟷ (a + b) DIV n = a DIV n + b DIV n
  → forward division param_m=a+b goal=2 facts=[1]
    #[3] a + b = (a + b) DIV n * n + (a + b) MOD n ∧ (a + b) MOD n < n
  → forward division param_m=a goal=2 facts=[1]
    #[4] a = a DIV n * n + a MOD n ∧ a MOD n < n
  → forward division param_m=b goal=2 facts=[1]
    #[5] b = b DIV n * n + b MOD n ∧ b MOD n < n
  → forward conjD1 goal=2 facts=[3]
    #[6] a + b = (a + b) DIV n * n + (a + b) MOD n
  → forward conjD1 goal=2 facts=[4]
    #[7] a = a DIV n * n + a MOD n
  → forward conjD1 goal=2 facts=[5]
    #[8] b = b DIV n * n + b MOD n
  cut "!x::nat. !y. !z. !w. x = y --> z= w --> x +z = y + w" goal=2
    #[9] ∀x::nat. ∀y. ∀z. ∀w. x = y ⟶ z = w ⟶ x + z = y + w
  ← z3 goal=9
    #[10] ∀x::nat. ∀y. ∀z. ∀w. x = y ⟶ z = w ⟶ x + z = y + w
  → forward goal=2 facts=[10,7,8]
    #[11] a + b = a DIV n * n + a MOD n + (b DIV n * n + b MOD n)
  → rewrite target=fact source=prev goal=2 facts=[6,11]
    #[12] (a + b) DIV n * n + (a + b) MOD n = a DIV n * n + a MOD n + (b DIV n * n + b MOD n)
  cut "!a::nat. !b::nat. !c. !d. (a + b) + c + d = (a + c) + (b + d)" goal=2
    #[13] ∀a::nat. ∀b. ∀c. ∀d. a + b + c + d = a + c + (b + d)
  ← z3 goal=13
    #[14] ∀a::nat. ∀b. ∀c. ∀d. a + b + c + d = a + c + (b + d)
  → rewrite target=fact eq_sym_eq sym=false goal=2 facts=[14]
    #[15] ∀a::nat. ∀b. ∀c. ∀d. a + c + (b + d) = a + b + c + d
  → rewrite target=fact source=prev goal=2 facts=[15,12]
    #[16] (a + b) DIV n * n + (a + b) MOD n = a DIV n * n + b DIV n * n + a MOD n + b MOD n
  ← rule iffI goal=2
    #[17] (a + b) MOD n = a MOD n + b MOD n ⟶ (a + b) DIV n = a DIV n + b DIV n
    #[18] (a + b) DIV n = a DIV n + b DIV n ⟶ (a + b) MOD n = a MOD n + b MOD n
  ← intro goal=17
    #[19] (a + b) MOD n = a MOD n + b MOD n
    #[20] (a + b) DIV n = a DIV n + b DIV n
  → rewrite target=fact source=prev goal=20 facts=[19,16]
    #[21] (a + b) DIV n * n + (a MOD n + b MOD n) = a DIV n * n + b DIV n * n + a MOD n + b MOD n
  → rewrite target=fact add_assoc sym=false goal=20 facts=[21]
    #[22] (a + b) DIV n * n + (a MOD n + b MOD n) = a DIV n * n + b DIV n * n + (a MOD n + b MOD n)
  → forward add_cancel_right goal=20 facts=[22]
    #[23] (a + b) DIV n * n = a DIV n * n + b DIV n * n
  → rewrite target=fact distrib_r sym=true goal=20 facts=[23]
    #[24] (a + b) DIV n * n = (a DIV n + b DIV n) * n
  → rewrite target=fact eq_mult_rcancel sym=false goal=20 facts=[24]
    #[25] n = 0 ∨ (a + b) DIV n = a DIV n + b DIV n
  ← rule disjE goal=20 facts=[25]
    #[26] n = 0 ⟶ (a + b) DIV n = a DIV n + b DIV n
    #[27] (a + b) DIV n = a DIV n + b DIV n ⟶ (a + b) DIV n = a DIV n + b DIV n
  ← intro goal=26
    #[28] n = 0
    #[29] (a + b) DIV n = a DIV n + b DIV n
  ← rule negE_gen goal=29 facts=[1,28]
    #[30] (a + b) DIV n = a DIV n + b DIV n
  ← intro goal=18
    #[31] (a + b) DIV n = a DIV n + b DIV n
    #[32] (a + b) MOD n = a MOD n + b MOD n
  → rewrite target=fact source=prev goal=32 facts=[31,16]
    #[33] (a DIV n + b DIV n) * n + (a + b) MOD n = a DIV n * n + b DIV n * n + a MOD n + b MOD n
  → rewrite target=fact distrib_r sym=false goal=32 facts=[33]
    #[34] a DIV n * n + b DIV n * n + (a + b) MOD n = a DIV n * n + b DIV n * n + a MOD n + b MOD n
  → rewrite target=fact add_assoc sym=false goal=32 facts=[34]
    #[35] a DIV n * n + (b DIV n * n + (a + b) MOD n) = a DIV n * n + b DIV n * n + (a MOD n + b MOD n)
  → rewrite target=fact add_assoc sym=false goal=32 facts=[35]
    #[36] a DIV n * n + (b DIV n * n + (a + b) MOD n) = a DIV n * n + (b DIV n * n + (a MOD n + b MOD n))
  → forward add_cancel_left goal=32 facts=[36]
    #[37] b DIV n * n + (a + b) MOD n = b DIV n * n + (a MOD n + b MOD n)
  ← rule add_cancel_left goal=32 facts=[37]
qed

theorem div_refl
  fixes n :: nat
  prop ~(n = 0) --> n DIV n = 1
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] n DIV n = 1
  ← rule div_uniq param_r="(0::nat)" goal=2
    #[3] n = 1 * n + 0
    #[4] 0 < n
  nat_norm goal=3
    #[5] n = 1 * n + 0
  ← rule le_1_1 goal=4
qed

theorem mod_le
  fixes m :: nat, n :: nat
  prop m MOD n <= m
  [hint_backward]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ m MOD n ≤ m
    #[2] ¬(n = 0) ⟶ m MOD n ≤ m
  ← intro goal=1
    #[3] n = 0
    #[4] m MOD n ≤ m
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m MOD 0 ≤ m
  ← rewrite mod_zero sym=false goal=5
    #[6] m ≤ m
  ← rule less_eq_refl goal=6
    #[7] m ≤ m
  ← intro goal=2
    #[8] ¬(n = 0)
    #[9] m MOD n ≤ m
  ← rule less_eq_trans param_m="m DIV n * n + m MOD n" goal=9
    #[10] m MOD n ≤ m DIV n * n + m MOD n
    #[11] m DIV n * n + m MOD n ≤ m
  ← rewrite add_comm sym=false goal=10
    #[12] m MOD n ≤ m MOD n + m DIV n * n
  ← rule le_add goal=12
    #[13] m MOD n ≤ m MOD n + m DIV n * n
  ← rewrite division_simp1 sym=false goal=11
    #[14] m ≤ m
  ← rule less_eq_refl goal=14
qed

theorem div_mono2
  fixes m :: nat, n :: nat, p :: nat
  prop ~(p = 0) --> p <= m --> n DIV m <= n DIV p
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(p = 0)
    #[2] p ≤ m
    #[3] n DIV m ≤ n DIV p
  → forward le_rdiv_eq param_b=n param_n="n DIV m" goal=3 facts=[1]
    #[4] n DIV m ≤ n DIV p ⟷ p * (n DIV m) ≤ n
  ← rewrite source=prev goal=3 facts=[4]
    #[5] p * (n DIV m) ≤ n
  ← rule less_eq_trans param_m="m * (n DIV m)" goal=5
    #[6] p * (n DIV m) ≤ m * (n DIV m)
    #[7] m * (n DIV m) ≤ n
  ← rewrite le_mult_rcancel sym=false goal=6
    #[8] p ≤ m ∨ n DIV m = 0
  ← rule disjI1 goal=8
  ← rule div_mul_le goal=7
    #[9] m * (n DIV m) ≤ n
qed

theorem div_le_exclusion
  fixes a :: nat, b :: nat, c :: nat, d :: nat
  prop ~(b = 0) --> b * c < (a + 1) * d --> c DIV d <= a DIV b
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(b = 0)
    #[2] b * c < (a + 1) * d
    #[3] c DIV d ≤ a DIV b
  ← cases "d=0" goal=3
    #[4] d = 0 ⟶ c DIV d ≤ a DIV b
    #[5] ¬(d = 0) ⟶ c DIV d ≤ a DIV b
  ← intro goal=4
    #[6] d = 0
    #[7] c DIV d ≤ a DIV b
  ← rewrite source=prev goal=7 facts=[6]
    #[8] c DIV 0 ≤ a DIV b
  ← rewrite div_zero sym=false goal=8
    #[9] 0 ≤ a DIV b
  ← rule le_0 goal=9
    #[10] 0 ≤ a DIV b
  ← intro goal=5
    #[11] ¬(d = 0)
    #[12] c DIV d ≤ a DIV b
  cut "!a. !b. (!k::nat. k <= a --> k <= b) --> a <= b" goal=12
    #[13] ∀a::nat. ∀b. (∀k. k ≤ a ⟶ k ≤ b) ⟶ a ≤ b
  ← z3 goal=13
    #[14] ∀a::nat. ∀b. (∀k. k ≤ a ⟶ k ≤ b) ⟶ a ≤ b
  ← apply_prev goal=12 facts=[14]
    #[15] ∀k. k ≤ c DIV d ⟶ k ≤ a DIV b
  ← intro k goal=15
    #[16] _VAR k
    #[17] k ≤ c DIV d
    #[18] k ≤ a DIV b
  cut "b * d * k <= b * c --> (b * k) * d < (a + 1) * d" goal=18
    #[19] b * d * k ≤ b * c ⟶ b * k * d < (a + 1) * d
  ← intro goal=19
    #[20] b * d * k ≤ b * c
    #[21] b * k * d < (a + 1) * d
  cut "b * k * d = b * d * k" goal=21
    #[22] b * k * d = b * d * k
  nat_norm goal=22
    #[23] b * k * d = b * d * k
  ← rewrite source=prev goal=21 facts=[23]
    #[24] b * d * k < (a + 1) * d
  ← rule let_trans goal=24 facts=[20,2]
    #[25] b * d * k < (a + 1) * d
  → forward le_rdiv_eq param_b=c param_n=k goal=18 facts=[11]
    #[26] k ≤ c DIV d ⟷ d * k ≤ c
  → rewrite target=fact source=prev goal=18 facts=[26,17]
    #[27] d * k ≤ c
  → forward le_rdiv_eq param_b=a param_n=k goal=18 facts=[1]
    #[28] k ≤ a DIV b ⟷ b * k ≤ a
  ← rewrite source=prev goal=18 facts=[28]
    #[29] b * k ≤ a
  → rewrite target=fact lt_mult_rcancel sym=false goal=29 facts=[19]
    #[30] b * d * k ≤ b * c ⟶ b * k < a + 1 ∧ ¬(d = 0)
  → rewrite target=fact mult_assoc sym=false goal=29 facts=[30]
    #[31] b * (d * k) ≤ b * c ⟶ b * k < a + 1 ∧ ¬(d = 0)
  → rewrite target=fact mult_comm sym=false goal=29 facts=[31]
    #[32] d * k * b ≤ c * b ⟶ k * b < a + 1 ∧ ¬(d = 0)
  → rewrite target=fact le_mult_rcancel sym=false goal=29 facts=[32]
    #[33] d * k ≤ c ∨ b = 0 ⟶ k * b < a + 1 ∧ ¬(d = 0)
  ← rewrite less_Suc_lesseq sym=true goal=29
    #[34] b * k < Suc a
  ← rewrite add_1_right sym=true goal=34
    #[35] b * k < a + 1
  cut "k * b < a + 1 ∧ ¬(d = 0) --> b * k < a + 1" goal=35
    #[36] k * b < a + 1 ∧ ¬(d = 0) ⟶ b * k < a + 1
  ← intro goal=36
    #[37] k * b < a + 1 ∧ ¬(d = 0)
    #[38] b * k < a + 1
  → forward conjD1 goal=38 facts=[37]
    #[39] k * b < a + 1
  cut "b * k = k * b" goal=38
    #[40] b * k = k * b
  nat_norm goal=40
    #[41] b * k = k * b
  ← rewrite source=prev goal=38 facts=[41]
  ← apply_prev goal=35 facts=[36]
    #[42] k * b < a + 1 ∧ ¬(d = 0)
  ← apply_prev goal=42 facts=[33]
    #[43] d * k ≤ c ∨ b = 0
  ← rule disjI1 goal=43
qed

theorem div_eq_exclusion
  fixes a :: nat, b :: nat, c :: nat, d :: nat
  prop b * c < (a + 1) * d --> a * d < (c + 1) * b --> a DIV b = c DIV d
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] b * c < (a + 1) * d
    #[2] a * d < (c + 1) * b
    #[3] a DIV b = c DIV d
  ← cases "b=0" goal=3
    #[4] b = 0 ⟶ a DIV b = c DIV d
    #[5] ¬(b = 0) ⟶ a DIV b = c DIV d
  ← intro goal=4
    #[6] b = 0
    #[7] a DIV b = c DIV d
  ← rewrite source=prev goal=7 facts=[6]
    #[8] a DIV 0 = c DIV d
  ← cases "d=0" goal=8
    #[9] d = 0 ⟶ a DIV 0 = c DIV d
    #[10] ¬(d = 0) ⟶ a DIV 0 = c DIV d
  ← intro goal=9
    #[11] d = 0
    #[12] a DIV 0 = c DIV d
  ← rewrite source=prev goal=12 facts=[11]
    #[13] a DIV 0 = c DIV 0
  ← rewrite div_zero sym=false goal=13
    #[14] a DIV 0 = c DIV 0
  ← intro goal=10
    #[15] ¬(d = 0)
    #[16] a DIV 0 = c DIV d
  → rewrite target=fact source=prev goal=16 facts=[6,2]
    #[17] a * d < (c + 1) * 0
  → rewrite target=fact mult_0_right sym=false goal=16 facts=[17]
    #[18] a * d < 0
  ← rule contrapositive goal=16 facts=[18]
    #[19] ¬(a DIV 0 = c DIV d) ⟶ ¬(a * d < 0)
  ← intro goal=19
    #[20] ¬(a DIV 0 = c DIV d)
    #[21] ¬(a * d < 0)
  ← rewrite not_lt sym=false goal=21
    #[22] 0 ≤ a * d
  ← rule le_0 goal=22
    #[23] 0 ≤ a * d
  ← intro goal=5
    #[24] ¬(b = 0)
    #[25] a DIV b = c DIV d
  ← cases "d=0" goal=25
    #[26] d = 0 ⟶ a DIV b = c DIV d
    #[27] ¬(d = 0) ⟶ a DIV b = c DIV d
  ← intro goal=26
    #[28] a DIV b = c DIV d
  → rewrite target=fact source=prev goal=28 facts=[11,1]
    #[29] b * c < (a + 1) * 0
  → rewrite target=fact mult_0_right sym=false goal=28 facts=[29]
    #[30] b * c < 0
  ← rule contrapositive goal=28 facts=[30]
    #[31] ¬(a DIV b = c DIV d) ⟶ ¬(b * c < 0)
  ← intro goal=31
    #[32] ¬(a DIV b = c DIV d)
    #[33] ¬(b * c < 0)
  ← rewrite not_lt sym=false goal=33
    #[34] 0 ≤ b * c
  ← rule le_0 goal=34
    #[35] 0 ≤ b * c
  ← intro goal=27
    #[36] a DIV b = c DIV d
  ← rewrite le_antisym sym=true goal=36
    #[37] a DIV b ≤ c DIV d ∧ c DIV d ≤ a DIV b
  ← rule conjI goal=37
    #[38] a DIV b ≤ c DIV d
    #[39] c DIV d ≤ a DIV b
  ← rule div_le_exclusion goal=38
    #[40] d * a < (c + 1) * b
  cut "d * a = a*d" goal=40
    #[41] d * a = a * d
  nat_norm goal=41
    #[42] d * a = a * d
  ← rewrite source=prev goal=40 facts=[42]
  ← rule div_le_exclusion goal=39
qed

theorem mult_div_le
  fixes m :: nat, n :: nat, p :: nat
  prop m * (n DIV p) <= m * n DIV p
  [hint_backward]
proof
  ← cases "p=0" goal=0
    #[1] p = 0 ⟶ m * (n DIV p) ≤ m * n DIV p
    #[2] ¬(p = 0) ⟶ m * (n DIV p) ≤ m * n DIV p
  ← intro goal=1
    #[3] p = 0
    #[4] m * (n DIV p) ≤ m * n DIV p
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m * (n DIV 0) ≤ m * n DIV 0
  ← rewrite div_zero sym=false goal=5
    #[6] m * 0 ≤ 0
  ← rewrite mult_0_right sym=false goal=6
    #[7] (0::nat) ≤ 0
  ← rule le_0 goal=7
    #[8] (0::nat) ≤ 0
  ← intro goal=2
    #[9] ¬(p = 0)
    #[10] m * (n DIV p) ≤ m * n DIV p
  → forward le_rdiv_eq param_b="m * n" param_n="m * (n DIV p)" goal=10 facts=[9]
    #[11] m * (n DIV p) ≤ m * n DIV p ⟷ p * (m * (n DIV p)) ≤ m * n
  ← rewrite source=prev goal=10 facts=[11]
    #[12] p * (m * (n DIV p)) ≤ m * n
  cut "p * (m * (n DIV p)) = m * (n DIV p) * p" goal=12
    #[13] p * (m * (n DIV p)) = m * (n DIV p) * p
  nat_norm goal=13
    #[14] p * (m * (n DIV p)) = m * (n DIV p) * p
  ← rewrite source=prev goal=12 facts=[14]
    #[15] m * (n DIV p) * p ≤ m * n
  ← rewrite mult_assoc sym=false goal=15
    #[16] m * (n DIV p * p) ≤ m * n
  ← rule le_mult2 goal=16
    #[17] m ≤ m
    #[18] n DIV p * p ≤ n
  ← rule less_eq_refl goal=17
    #[19] m ≤ m
  ← rule less_eq_trans param_m="n DIV p * p + n MOD p" goal=18
    #[20] n DIV p * p ≤ n DIV p * p + n MOD p
    #[21] n DIV p * p + n MOD p ≤ n
  ← rule le_add goal=20
    #[22] n DIV p * p ≤ n DIV p * p + n MOD p
  ← rewrite division_simp1 sym=false goal=21
    #[23] n ≤ n
  ← rule less_eq_refl goal=23
    #[24] n ≤ n
qed

theorem div_div
  fixes m :: nat, n :: nat, p :: nat
  prop m DIV n DIV p = m DIV (n * p)
  [hint_rewrite]
proof
  ← cases "p=0" goal=0
    #[1] p = 0 ⟶ m DIV n DIV p = m DIV (n * p)
    #[2] ¬(p = 0) ⟶ m DIV n DIV p = m DIV (n * p)
  ← intro goal=1
    #[3] p = 0
    #[4] m DIV n DIV p = m DIV (n * p)
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m DIV n DIV 0 = m DIV (n * 0)
  ← rewrite mult_0_right sym=false goal=5
    #[6] m DIV n DIV 0 = m DIV 0
  ← rewrite div_zero sym=false goal=6
    #[7] m DIV n DIV 0 = m DIV 0
  ← intro goal=2
    #[8] ¬(p = 0)
    #[9] m DIV n DIV p = m DIV (n * p)
  ← cases "n=0" goal=9
    #[10] n = 0 ⟶ m DIV n DIV p = m DIV (n * p)
    #[11] ¬(n = 0) ⟶ m DIV n DIV p = m DIV (n * p)
  ← intro goal=10
    #[12] n = 0
    #[13] m DIV n DIV p = m DIV (n * p)
  ← rewrite source=prev goal=13 facts=[12]
    #[14] m DIV 0 DIV p = m DIV (0 * p)
  ← rewrite nat_times_def_1 sym=false goal=14
    #[15] m DIV 0 DIV p = m DIV 0
  ← rewrite div_zero sym=false goal=15
    #[16] 0 DIV p = 0
  ← rewrite div_0 sym=false goal=16
    #[17] 0 DIV p = 0
  ← intro goal=11
    #[18] ¬(n = 0)
    #[19] m DIV n DIV p = m DIV (n * p)
  cut "!m::nat. !n. (!k. k <= m <--> k <= n) --> m = n" goal=19
    #[20] ∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n
  ← z3 goal=20
    #[21] ∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n
  ← apply_prev goal=19 facts=[21]
    #[22] ∀k. k ≤ m DIV n DIV p ⟷ k ≤ m DIV (n * p)
  ← intro k goal=22
    #[23] _VAR k
    #[24] k ≤ m DIV n DIV p ⟷ k ≤ m DIV (n * p)
  → forward le_rdiv_eq param_b="m DIV n" param_n=k goal=24 facts=[8]
    #[25] k ≤ m DIV n DIV p ⟷ p * k ≤ m DIV n
  cut "~(n * p =0)" goal=24
    #[26] ¬(n * p = 0)
  ← rewrite mult_eq_0 sym=false goal=26
    #[27] ¬(n = 0 ∨ p = 0)
  ← rewrite de_morgan_thm2 sym=false goal=27
    #[28] ¬(n = 0) ∧ ¬(p = 0)
  ← rule conjI goal=28
  → forward le_rdiv_eq param_b=m param_n=k goal=24 facts=[26]
    #[29] k ≤ m DIV (n * p) ⟷ n * p * k ≤ m
  → forward le_rdiv_eq param_b=m param_n=p*k goal=24 facts=[18]
    #[30] p * k ≤ m DIV n ⟷ n * (p * k) ≤ m
  ← rewrite source=prev goal=24 facts=[25]
    #[31] p * k ≤ m DIV n ⟷ k ≤ m DIV (n * p)
  ← rewrite source=prev goal=31 facts=[30]
    #[32] n * (p * k) ≤ m ⟷ k ≤ m DIV (n * p)
  ← rewrite source=prev goal=32 facts=[29]
    #[33] n * (p * k) ≤ m ⟷ n * p * k ≤ m
  ← rewrite mult_assoc sym=false goal=33
    #[34] n * (p * k) ≤ m ⟷ n * p * k ≤ m
qed

theorem div_mod
  fixes m :: nat, n :: nat, p :: nat
  prop m DIV n MOD p = m MOD (n * p) DIV n
  [hint_rewrite]
proof
  ← cases "p=0" goal=0
    #[1] p = 0 ⟶ m DIV n MOD p = m MOD (n * p) DIV n
    #[2] ¬(p = 0) ⟶ m DIV n MOD p = m MOD (n * p) DIV n
  ← intro goal=1
    #[3] p = 0
    #[4] m DIV n MOD p = m MOD (n * p) DIV n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m DIV n MOD 0 = m MOD (n * 0) DIV n
  ← rewrite mult_0_right sym=false goal=5
    #[6] m DIV n MOD 0 = m MOD 0 DIV n
  ← rewrite mod_zero sym=false goal=6
    #[7] m DIV n MOD 0 = m MOD 0 DIV n
  ← intro goal=2
    #[8] ¬(p = 0)
    #[9] m DIV n MOD p = m MOD (n * p) DIV n
  ← cases "n=0" goal=9
    #[10] n = 0 ⟶ m DIV n MOD p = m MOD (n * p) DIV n
    #[11] ¬(n = 0) ⟶ m DIV n MOD p = m MOD (n * p) DIV n
  ← intro goal=10
    #[12] n = 0
    #[13] m DIV n MOD p = m MOD (n * p) DIV n
  ← rewrite source=prev goal=13 facts=[12]
    #[14] m DIV 0 MOD p = m MOD (0 * p) DIV 0
  ← rewrite div_zero sym=false goal=14
    #[15] 0 MOD p = 0
  ← rewrite mod_0 sym=false goal=15
    #[16] 0 MOD p = 0
  ← intro goal=11
    #[17] ¬(n = 0)
    #[18] m DIV n MOD p = m MOD (n * p) DIV n
  cut "∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n" goal=18
    #[19] ∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n
  ← z3 goal=19
    #[20] ∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n
  ← apply_prev goal=18 facts=[20]
    #[21] ∀k. k ≤ m DIV n MOD p ⟷ k ≤ m MOD (n * p) DIV n
  ← intro k goal=21
    #[22] _VAR k
    #[23] k ≤ m DIV n MOD p ⟷ k ≤ m MOD (n * p) DIV n
  cut "k ≤ m DIV n MOD p ⟷ k + p * ((m DIV n) DIV p) <= (m DIV n)" goal=23
    #[24] k ≤ m DIV n MOD p ⟷ k + p * (m DIV n DIV p) ≤ m DIV n
  ← rewrite add_comm sym=false goal=24
    #[25] k ≤ m DIV n MOD p ⟷ p * (m DIV n DIV p) + k ≤ m DIV n
  → forward le_add_lcancel param_m="p * (m DIV n DIV p)" param_n=k param_p="m DIV n MOD p" goal=25
    #[26] p * (m DIV n DIV p) + k ≤ p * (m DIV n DIV p) + m DIV n MOD p ⟷ k ≤ m DIV n MOD p
  → rewrite target=fact division_simp2 sym=false goal=25 facts=[26]
    #[27] p * (m DIV n DIV p) + k ≤ m DIV n ⟷ k ≤ m DIV n MOD p
  ← rewrite source=prev goal=25 facts=[27]
    #[28] k ≤ m DIV n MOD p ⟷ p * (m DIV n DIV p) + k ≤ m DIV n
  ← rewrite source=prev goal=23 facts=[24]
    #[29] k + p * (m DIV n DIV p) ≤ m DIV n ⟷ k ≤ m MOD (n * p) DIV n
  ← rewrite div_div sym=false goal=29
    #[30] k + p * (m DIV (n * p)) ≤ m DIV n ⟷ k ≤ m MOD (n * p) DIV n
  cut "~(n * p = 0)" goal=30
    #[31] ¬(n * p = 0)
  ← rewrite mult_eq_0 sym=false goal=31
    #[32] ¬(n = 0 ∨ p = 0)
  ← rewrite de_morgan_thm2 sym=false goal=32
    #[33] ¬(n = 0) ∧ ¬(p = 0)
  ← rule conjI goal=33
  → forward division param_m=m goal=30 facts=[31]
    #[34] m = m DIV (n * p) * (n * p) + m MOD (n * p) ∧ m MOD (n * p) < n * p
  → forward conjD1 goal=30 facts=[34]
    #[35] m = m DIV (n * p) * (n * p) + m MOD (n * p)
  cut "m DIV n = ((n * p) * (m DIV (n * p)) + m MOD (n * p)) DIV n" goal=30
    #[36] m DIV n = (n * p * (m DIV (n * p)) + m MOD (n * p)) DIV n
  ← rewrite division_simp2 sym=false goal=36
    #[37] m DIV n = (n * p * (m DIV (n * p)) + m MOD (n * p)) DIV n
  ← rewrite source=prev goal=30 facts=[37]
    #[38] k + p * (m DIV (n * p)) ≤ (n * p * (m DIV (n * p)) + m MOD (n * p)) DIV n ⟷ k ≤ m MOD (n * p) DIV n
  ← rewrite mult_assoc sym=false goal=38
    #[39] k + p * (m DIV (n * p)) ≤ (n * (p * (m DIV (n * p))) + m MOD (n * p)) DIV n ⟷ k ≤ m MOD (n * p) DIV n
  → forward div_mult_add2 param_a="p * (m DIV (n * p))" param_b="m MOD (n * p)" goal=39 facts=[17]
    #[40] (n * (p * (m DIV (n * p))) + m MOD (n * p)) DIV n = p * (m DIV (n * p)) + m MOD (n * p) DIV n
  ← rewrite source=prev goal=39 facts=[40]
    #[41] k + p * (m DIV (n * p)) ≤ p * (m DIV (n * p)) + m MOD (n * p) DIV n ⟷ k ≤ m MOD (n * p) DIV n
  cut "k + p * (m DIV (n * p)) = p * (m DIV (n * p)) + k" goal=41
    #[42] k + p * (m DIV (n * p)) = p * (m DIV (n * p)) + k
  nat_norm goal=42
    #[43] k + p * (m DIV (n * p)) = p * (m DIV (n * p)) + k
  ← rewrite source=prev goal=41 facts=[43]
    #[44] p * (m DIV (n * p)) + k ≤ p * (m DIV (n * p)) + m MOD (n * p) DIV n ⟷ k ≤ m MOD (n * p) DIV n
  ← rewrite le_add_lcancel sym=false goal=44
    #[45] p * (m DIV (n * p)) + k ≤ p * (m DIV (n * p)) + m MOD (n * p) DIV n ⟷ k ≤ m MOD (n * p) DIV n
qed

theorem mod_mult_mod
  fixes m :: nat, n :: nat, p :: nat
  prop m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
    #[2] ¬(n = 0) ⟶ m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
  ← intro goal=1
    #[3] n = 0
    #[4] m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] m MOD (0 * p) = 0 * (m DIV 0 MOD p) + m MOD 0
  ← rewrite nat_times_def_1 sym=false goal=5
    #[6] m MOD 0 = 0 + m MOD 0
  ← rewrite nat_plus_def_1 sym=false goal=6
    #[7] m MOD 0 = 0 + m MOD 0
  ← intro goal=2
    #[8] ¬(n = 0)
    #[9] m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
  ← cases "p=0" goal=9
    #[10] p = 0 ⟶ m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
    #[11] ¬(p = 0) ⟶ m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
  ← intro goal=10
    #[12] p = 0
    #[13] m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
  ← rewrite source=prev goal=13 facts=[12]
    #[14] m MOD (n * 0) = n * (m DIV n MOD 0) + m MOD n
  ← rewrite mult_0_right sym=false goal=14
    #[15] m MOD 0 = n * (m DIV n MOD 0) + m MOD n
  ← rewrite mod_zero sym=false goal=15
    #[16] m = n * (m DIV n) + m MOD n
  ← rewrite division_simp2 sym=false goal=16
    #[17] m = n * (m DIV n) + m MOD n
  ← intro goal=11
    #[18] ¬(p = 0)
    #[19] m MOD (n * p) = n * (m DIV n MOD p) + m MOD n
  ← rule add_cancel_left param_x="n * (m DIV n DIV p * p)" goal=19
    #[20] n * (m DIV n DIV p * p) + m MOD (n * p) = n * (m DIV n DIV p * p) + (n * (m DIV n MOD p) + m MOD n)
  ← rewrite add_assoc sym=true goal=20
    #[21] n * (m DIV n DIV p * p) + m MOD (n * p) = n * (m DIV n DIV p * p) + n * (m DIV n MOD p) + m MOD n
  ← rewrite distrib_l sym=true goal=21
    #[22] n * (m DIV n DIV p * p) + m MOD (n * p) = n * (m DIV n DIV p * p + m DIV n MOD p) + m MOD n
  ← rewrite division_simp1 sym=false goal=22
    #[23] n * (m DIV n DIV p * p) + m MOD (n * p) = n * (m DIV n) + m MOD n
  ← rewrite division_simp2 sym=false goal=23
    #[24] n * (m DIV n DIV p * p) + m MOD (n * p) = m
  cut "n * (m DIV n DIV p * p) = m DIV n DIV p * (n * p)" goal=24
    #[25] n * (m DIV n DIV p * p) = m DIV n DIV p * (n * p)
  nat_norm goal=25
    #[26] n * (m DIV n DIV p * p) = m DIV n DIV p * (n * p)
  ← rewrite source=prev goal=24 facts=[26]
    #[27] m DIV n DIV p * (n * p) + m MOD (n * p) = m
  ← rewrite div_div sym=false goal=27
    #[28] m DIV (n * p) * (n * p) + m MOD (n * p) = m
  ← rewrite division_simp1 sym=false goal=28
    #[29] m DIV (n * p) * (n * p) + m MOD (n * p) = m
qed

theorem mod_mod_exp_min
  fixes m :: nat, n :: nat, p :: nat, x :: nat
  prop x MOD p ^ m MOD p ^ n = x MOD p ^ min m n
proof
  ← cases "p=0" goal=0
    #[1] p = 0 ⟶ x MOD p ^ m MOD p ^ n = x MOD p ^ min m n
    #[2] ¬(p = 0) ⟶ x MOD p ^ m MOD p ^ n = x MOD p ^ min m n
  ← intro goal=1
    #[3] p = 0
    #[4] x MOD p ^ m MOD p ^ n = x MOD p ^ min m n
  ← rewrite source=prev goal=4 facts=[3]
    #[5] x MOD 0 ^ m MOD 0 ^ n = x MOD 0 ^ min m n
  ← rewrite exp_zero sym=false goal=5
    #[6] x MOD (if m = 0 then 1 else 0) MOD (if n = 0 then 1 else 0) = x MOD (if min m n = 0 then 1 else 0)
  ← rewrite min_def sym=false goal=6
    #[7] x MOD (if m = 0 then 1 else 0) MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← cases "m=0" goal=7
    #[8] m = 0 ⟶ x MOD (if m = 0 then 1 else 0) MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
    #[9] ¬(m = 0) ⟶ x MOD (if m = 0 then 1 else 0) MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← intro goal=8
    #[10] m = 0
    #[11] x MOD (if m = 0 then 1 else 0) MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=11 facts=[10]
    #[12] x MOD 1 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← cases "m ≤ n" goal=12
    #[13] m ≤ n ⟶ x MOD 1 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
    #[14] ¬(m ≤ n) ⟶ x MOD 1 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← intro goal=13
    #[15] m ≤ n
    #[16] x MOD 1 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=16 facts=[15]
    #[17] x MOD 1 MOD (if n = 0 then 1 else 0) = x MOD (if m = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=17 facts=[10]
    #[18] x MOD 1 MOD (if n = 0 then 1 else 0) = x MOD 1
  ← rewrite mod_1 sym=false goal=18
    #[19] 0 MOD (if n = 0 then 1 else 0) = 0
  ← rewrite mod_0 sym=false goal=19
    #[20] 0 MOD (if n = 0 then 1 else 0) = 0
  ← intro goal=14
    #[21] ¬(m ≤ n)
    #[22] x MOD 1 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← rule negE_gen goal=22 facts=[21]
    #[23] m ≤ n
  ← rewrite source=prev goal=23 facts=[10]
    #[24] 0 ≤ n
  ← rule le_0 goal=24
    #[25] 0 ≤ n
  ← intro goal=9
    #[26] ¬(m = 0)
    #[27] x MOD (if m = 0 then 1 else 0) MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=27 facts=[26]
    #[28] x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← cases "m ≤ n" goal=28
    #[29] m ≤ n ⟶ x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
    #[30] ¬(m ≤ n) ⟶ x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← intro goal=29
    #[31] x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=31 facts=[15]
    #[32] x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD (if m = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=32 facts=[26]
    #[33] x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD 0
  ← rewrite mod_zero sym=false goal=33
    #[34] x MOD (if n = 0 then 1 else 0) = x
  ← cases "n = 0" goal=34
    #[35] n = 0 ⟶ x MOD (if n = 0 then 1 else 0) = x
    #[36] ¬(n = 0) ⟶ x MOD (if n = 0 then 1 else 0) = x
  ← intro goal=35
    #[37] n = 0
    #[38] x MOD (if n = 0 then 1 else 0) = x
  → rewrite target=fact source=prev goal=38 facts=[37,15]
    #[39] m ≤ 0
  ← rule negE_gen goal=38 facts=[26]
    #[40] m = 0
  → rewrite target=fact nat_less_eq_def_1 sym=false goal=40 facts=[39]
    #[41] m = 0
  ← intro goal=36
    #[42] ¬(n = 0)
    #[43] x MOD (if n = 0 then 1 else 0) = x
  ← rewrite if_not_P sym=false goal=43 facts=[42]
    #[44] x MOD 0 = x
  ← rewrite mod_zero sym=false goal=44
    #[45] x MOD 0 = x
  ← intro goal=30
    #[46] x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD (if (if m ≤ n then m else n) = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=46 facts=[21]
    #[47] x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD (if n = 0 then 1 else 0)
  ← rewrite mod_zero sym=false goal=47
    #[48] x MOD 0 MOD (if n = 0 then 1 else 0) = x MOD (if n = 0 then 1 else 0)
  ← rewrite min_def sym=false goal=2
    #[49] ¬(p = 0) ⟶ x MOD p ^ m MOD p ^ n = x MOD p ^ (if m ≤ n then m else n)
  ← intro goal=49
    #[50] ¬(p = 0)
    #[51] x MOD p ^ m MOD p ^ n = x MOD p ^ (if m ≤ n then m else n)
  ← cases "m ≤ n" goal=51
    #[52] m ≤ n ⟶ x MOD p ^ m MOD p ^ n = x MOD p ^ (if m ≤ n then m else n)
    #[53] ¬(m ≤ n) ⟶ x MOD p ^ m MOD p ^ n = x MOD p ^ (if m ≤ n then m else n)
  ← intro goal=52
    #[54] x MOD p ^ m MOD p ^ n = x MOD p ^ (if m ≤ n then m else n)
  ← rewrite if_P sym=false goal=54 facts=[15]
    #[55] x MOD p ^ m MOD p ^ n = x MOD p ^ m
  → rewrite target=fact less_eq_exist sym=false goal=55 facts=[15]
    #[56] ∃p. n = m + p
  elim d goal=55 facts=[56]
    #[57] _VAR d
    #[58] n = m + d
    #[59] x MOD p ^ m MOD p ^ n = x MOD p ^ m
    #[60] x MOD p ^ m MOD p ^ n = x MOD p ^ (if m ≤ n then m else n)
  ← rewrite source=prev goal=59 facts=[58]
    #[61] x MOD p ^ m MOD p ^ (m + d) = x MOD p ^ m
  ← rule mod_lt goal=61
    #[62] x MOD p ^ m < p ^ (m + d)
  ← rule lte_trans param_m="p ^ m" goal=62
    #[63] x MOD p ^ m < p ^ m
    #[64] p ^ m ≤ p ^ (m + d)
  ← rewrite mod_lt_eq_lt sym=false goal=63
    #[65] 0 < p ^ m
  ← rewrite exp_lt_0 sym=false goal=65
    #[66] ¬(p = 0) ∨ m = 0
  ← rule disjI1 goal=66
  ← rewrite le_exp sym=false goal=64
    #[67] if p = 0 then m = 0 ⟶ m + d = 0 else p = 1 ∨ m ≤ m + d
  ← rewrite if_not_P sym=false goal=67 facts=[50]
    #[68] p = 1 ∨ m ≤ m + d
  ← rule disjI2 goal=68
    #[69] m ≤ m + d
  ← rule le_add goal=69
    #[70] m ≤ m + d
  ← intro goal=53
    #[71] x MOD p ^ m MOD p ^ n = x MOD p ^ (if m ≤ n then m else n)
  ← rewrite if_not_P sym=false goal=71 facts=[21]
    #[72] x MOD p ^ m MOD p ^ n = x MOD p ^ n
  → rewrite target=fact not_le sym=false goal=72 facts=[21]
    #[73] n < m
  → forward lt_imp_le goal=72 facts=[73]
    #[74] n ≤ m
  → rewrite target=fact less_eq_exist sym=false goal=72 facts=[74]
    #[75] ∃p. m = n + p
  elim d goal=72 facts=[75]
    #[76] m = n + d
    #[77] x MOD p ^ m MOD p ^ n = x MOD p ^ n
    #[78] x MOD p ^ m MOD p ^ n = x MOD p ^ (if m ≤ n then m else n)
  ← rewrite source=prev goal=77 facts=[76]
    #[79] x MOD p ^ (n + d) MOD p ^ n = x MOD p ^ n
  ← rewrite nat_power_add sym=false goal=79
    #[80] x MOD (p ^ n * p ^ d) MOD p ^ n = x MOD p ^ n
  ← rewrite mod_mod sym=false goal=80
    #[81] x MOD (p ^ n * p ^ d) MOD p ^ n = x MOD p ^ n
qed

theorem div_exp
  fixes m :: nat, n :: nat, p :: nat
  prop ~(m = 0) --> m ^ n DIV m ^ p = (if p <= n then m ^ (n - p) else if m = 1 then 1 else 0)
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(m = 0)
    #[2] m ^ n DIV m ^ p = (if p ≤ n then m ^ (n - p) else if m = 1 then 1 else 0)
  ← cases "p ≤ n" goal=2
    #[3] p ≤ n ⟶ m ^ n DIV m ^ p = (if p ≤ n then m ^ (n - p) else if m = 1 then 1 else 0)
    #[4] ¬(p ≤ n) ⟶ m ^ n DIV m ^ p = (if p ≤ n then m ^ (n - p) else if m = 1 then 1 else 0)
  ← intro goal=3
    #[5] p ≤ n
    #[6] m ^ n DIV m ^ p = (if p ≤ n then m ^ (n - p) else if m = 1 then 1 else 0)
  ← rewrite if_P sym=false goal=6 facts=[5]
    #[7] m ^ n DIV m ^ p = m ^ (n - p)
  ← rule div_uniq param_r="(0::nat)" goal=7
    #[8] m ^ n = m ^ (n - p) * m ^ p + 0
    #[9] 0 < m ^ p
  ← rewrite add_0_right sym=false goal=8
    #[10] m ^ n = m ^ (n - p) * m ^ p
  ← rewrite nat_power_add sym=true goal=10
    #[11] m ^ n = m ^ (n - p + p)
  → forward sub_add goal=11 facts=[5]
    #[12] n - p + p = n
  ← rewrite source=prev goal=11 facts=[12]
    #[13] m ^ n = m ^ (n - p + p)
  ← rewrite exp_lt_0 sym=false goal=9
    #[14] ¬(m = 0) ∨ p = 0
  ← rule disjI1 goal=14
  ← intro goal=4
    #[15] ¬(p ≤ n)
    #[16] m ^ n DIV m ^ p = (if p ≤ n then m ^ (n - p) else if m = 1 then 1 else 0)
  ← rewrite if_not_P sym=false goal=16 facts=[15]
    #[17] m ^ n DIV m ^ p = (if m = 1 then 1 else 0)
  ← cases "m =1" goal=17
    #[18] m = 1 ⟶ m ^ n DIV m ^ p = (if m = 1 then 1 else 0)
    #[19] ¬(m = 1) ⟶ m ^ n DIV m ^ p = (if m = 1 then 1 else 0)
  ← intro goal=18
    #[20] m = 1
    #[21] m ^ n DIV m ^ p = (if m = 1 then 1 else 0)
  ← rewrite if_P sym=false goal=21 facts=[20]
    #[22] m ^ n DIV m ^ p = 1
  ← rewrite source=prev goal=22 facts=[20]
    #[23] 1 ^ n DIV 1 ^ p = 1
  ← rewrite exp_one sym=false goal=23
    #[24] 1 DIV 1 = 1
  ← rewrite div_1 sym=false goal=24
    #[25] 1 DIV 1 = 1
  ← intro goal=19
    #[26] ¬(m = 1)
    #[27] m ^ n DIV m ^ p = (if m = 1 then 1 else 0)
  ← rewrite if_not_P sym=false goal=27 facts=[26]
    #[28] m ^ n DIV m ^ p = 0
  ← rule div_lt goal=28
    #[29] m ^ n < m ^ p
  ← rewrite lt_exp sym=false goal=29
    #[30] 2 ≤ m ∧ n < p ∨ m = 0 ∧ ¬(n = 0) ∧ p = 0
  ← rule disjI1 goal=30
    #[31] 2 ≤ m ∧ n < p
  ← rule conjI goal=31
    #[32] 2 ≤ m
    #[33] n < p
  ← z3 goal=32 facts=[26,1]
    #[34] 2 ≤ m
  → rewrite target=fact not_le sym=false goal=33 facts=[15]
    #[35] n < p
qed

theorem mod_exp
  fixes m :: nat, n :: nat, p :: nat
  prop ~(m = 0) --> m ^ n MOD m ^ p = (if p <= n | m = 1 then 0 else m ^ n)
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(m = 0)
    #[2] m ^ n MOD m ^ p = (if p ≤ n ∨ m = 1 then 0 else m ^ n)
  ← cases "p ≤ n ∨ m = 1" goal=2
    #[3] p ≤ n ∨ m = 1 ⟶ m ^ n MOD m ^ p = (if p ≤ n ∨ m = 1 then 0 else m ^ n)
    #[4] ¬(p ≤ n ∨ m = 1) ⟶ m ^ n MOD m ^ p = (if p ≤ n ∨ m = 1 then 0 else m ^ n)
  ← intro goal=3
    #[5] p ≤ n ∨ m = 1
    #[6] m ^ n MOD m ^ p = (if p ≤ n ∨ m = 1 then 0 else m ^ n)
  ← rewrite if_P sym=false goal=6 facts=[5]
    #[7] m ^ n MOD m ^ p = 0
  ← rule disjE goal=7 facts=[5]
    #[8] p ≤ n ⟶ m ^ n MOD m ^ p = 0
    #[9] m = 1 ⟶ m ^ n MOD m ^ p = 0
  ← intro goal=8
    #[10] p ≤ n
    #[11] m ^ n MOD m ^ p = 0
  ← rewrite mod_eq_0 sym=false goal=11
    #[12] ∃q. m ^ n = q * m ^ p
  ← inst "m ^ (n-p)" goal=12
    #[13] m ^ n = m ^ (n - p) * m ^ p
  ← rewrite nat_power_add sym=true goal=13
    #[14] m ^ n = m ^ (n - p + p)
  → forward sub_add goal=14 facts=[10]
    #[15] n - p + p = n
  ← rewrite source=prev goal=14 facts=[15]
    #[16] m ^ n = m ^ (n - p + p)
  ← intro goal=9
    #[17] m = 1
    #[18] m ^ n MOD m ^ p = 0
  ← rewrite source=prev goal=18 facts=[17]
    #[19] 1 ^ n MOD 1 ^ p = 0
  ← rewrite exp_one sym=false goal=19
    #[20] 1 MOD 1 = 0
  ← rewrite mod_1 sym=false goal=20
    #[21] 1 MOD 1 = 0
  ← intro goal=4
    #[22] ¬(p ≤ n ∨ m = 1)
    #[23] m ^ n MOD m ^ p = (if p ≤ n ∨ m = 1 then 0 else m ^ n)
  ← rewrite if_not_P sym=false goal=23 facts=[22]
    #[24] m ^ n MOD m ^ p = m ^ n
  ← rewrite mod_eq_self sym=false goal=24
    #[25] m ^ p = 0 ∨ m ^ n < m ^ p
  ← rule disjI2 goal=25
    #[26] m ^ n < m ^ p
  ← rewrite lt_exp sym=false goal=26
    #[27] 2 ≤ m ∧ n < p ∨ m = 0 ∧ ¬(n = 0) ∧ p = 0
  ← rule disjI1 goal=27
    #[28] 2 ≤ m ∧ n < p
  ← rule conjI goal=28
    #[29] 2 ≤ m
    #[30] n < p
  → rewrite target=fact de_morgan_thm2 sym=false goal=29 facts=[22]
    #[31] ¬(p ≤ n) ∧ ¬(m = 1)
  → forward conjD1 goal=29 facts=[31]
    #[32] ¬(p ≤ n)
  → forward conjD2 goal=29 facts=[31]
    #[33] ¬(m = 1)
  cut "2 = Suc 1" goal=29
    #[34] 2 = Suc 1
  ← rewrite add_1_right sym=true goal=34
    #[35] (2::nat) = 1 + 1
  ← rewrite mult_2 sym=true goal=35
    #[36] (2::nat) = 2 * 1
  ← rewrite mult_1_right sym=false goal=36
    #[37] (2::nat) = 2 * 1
  ← rewrite source=prev goal=29 facts=[34]
    #[38] Suc 1 ≤ m
  ← rewrite nat_one_def sym=false goal=38
    #[39] Suc (Suc 0) ≤ m
  ← rewrite lesseq_Suc_less sym=false goal=39
    #[40] Suc 0 < m
  ← rewrite not_le sym=true goal=40
    #[41] ¬(m ≤ Suc 0)
  ← rewrite le_lt sym=false goal=41
    #[42] ¬(m < Suc 0 ∨ m = Suc 0)
  ← rewrite de_morgan_thm2 sym=false goal=42
    #[43] ¬(m < Suc 0) ∧ ¬(m = Suc 0)
  ← rewrite less_Suc_lesseq sym=false goal=43
    #[44] ¬(m ≤ 0) ∧ ¬(m = Suc 0)
  ← rule conjI goal=44
    #[45] ¬(m ≤ 0)
    #[46] ¬(m = Suc 0)
  ← rewrite nat_less_eq_def_1 sym=false goal=45
  ← rewrite add_1_right sym=true goal=46
    #[47] ¬(m = 0 + 1)
  ← rewrite nat_plus_def_1 sym=false goal=47
  → rewrite target=fact not_le sym=false goal=30 facts=[32]
    #[48] n < p
qed

