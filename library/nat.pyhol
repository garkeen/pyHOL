theory nat
imports logic
domains nat
description "Natural numbers"

header "Basic definitions"

const zero :: 'a overloaded

const one :: 'a overloaded

datatype nat =
  | zero :: nat
  | Suc (n :: nat) :: nat

def one :: nat = 1 = Suc 0 [hint_rewrite]

const of_nat :: nat ⇒ 'a overloaded

def of_nat :: nat ⇒ nat = of_nat n = n

fun Pre :: nat ⇒ nat
  | Pre 0 = 0
  | Pre (Suc n) = n

const plus :: 'a ⇒ 'a ⇒ 'a overloaded

const minus :: 'a ⇒ 'a ⇒ 'a overloaded

const times :: 'a ⇒ 'a ⇒ 'a overloaded

const power :: 'a ⇒ 'b ⇒ 'a overloaded

fun plus :: nat ⇒ nat ⇒ nat
  | 0 + n = n
  | Suc m + n = Suc (m + n)

fun times :: nat ⇒ nat ⇒ nat
  | 0 * n = 0
  | Suc m * n = n + m * n

fun power :: nat ⇒ nat ⇒ nat
  | n ^ (0::nat) = 1
  | n ^ Suc m = n * n ^ m

theorem add_0_right
  fixes x :: nat
  prop x + 0 = x
  [hint_rewrite]
  proof
    0: induction x nat_induct
    0: rewrite_goal nat_plus_def_1 sym=false
    1: introduction m
    1.2: rewrite_goal nat_plus_def_2 sym=false
    1.2: rewrite_goal_with_prev @1.1
  qed

theorem add_1_left
  fixes x :: nat
  prop 1 + x = Suc x
  [hint_rewrite]
  proof
    0: rewrite_goal nat_one_def
    0: rewrite_goal nat_plus_def_2
    0: rewrite_goal nat_plus_def_1
  qed

theorem add_1_right
  fixes x :: nat
  prop x + 1 = Suc x
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: induction x nat_induct
    0: rewrite_goal nat_plus_def_1
    0: rewrite_goal nat_one_def
    2: introduction n
    2.2: rewrite_goal nat_plus_def_2
    2.2: rewrite_goal_with_prev @2.1
  qed

theorem add_Suc_right
  fixes x :: nat, y :: nat
  prop x + Suc y = Suc (x + y)
  [hint_rewrite]

theorem add_comm
  fixes x :: nat, y :: nat
  prop x + y = y + x
  [hint_backward]
  proof
    0: induction x nat_induct
    0: rewrite_goal add_0_right
    0: rewrite_goal nat_plus_def_1
    2: introduction x
    2.2: rewrite_goal nat_plus_def_2
    2.2: rewrite_goal add_Suc_right
    2.2: rewrite_goal_with_prev @2.1
  qed

theorem add_assoc
  fixes x :: nat, y :: nat, z :: nat
  prop x + y + z = x + (y + z)
  [hint_backward]
  proof
    0: induction x nat_induct
    0: rewrite_goal nat_plus_def_1 sym=false
    1: introduction x
    1.2: rewrite_goal nat_plus_def_2 sym=false
    1.2: rewrite_goal nat_plus_def_2 sym=false
    1.2: rewrite_goal_with_prev @1.1
  qed

theorem mult_0_right
  fixes x :: nat
  prop x * 0 = 0
  [hint_rewrite]
  proof
    0: induction x nat_induct
    0: rewrite_goal nat_times_def_1
    1: introduction n
    1.2: rewrite_goal nat_times_def_2
    1.2: rewrite_goal nat_plus_def_1
  qed

theorem mult_1_left
  fixes x :: nat
  prop 1 * x = x
  [hint_rewrite]
  proof
    0: rewrite_goal nat_one_def
    0: rewrite_goal nat_times_def_2
    0: rewrite_goal nat_times_def_1
    0: nat_norm
  qed

theorem mult_1_right
  fixes x :: nat
  prop x * 1 = x
  [hint_rewrite]
  proof
    0: induction x nat_induct
    0: rewrite_goal nat_times_def_1
    1: introduction n
    1.2: rewrite_goal nat_times_def_2
    1.2: rewrite_goal_with_prev @1.1
    1.2: nat_norm
  qed

theorem mult_Suc_right
  fixes x :: nat, y :: nat
  prop x * Suc y = x + x * y
  [hint_rewrite]

theorem distrib_l
  fixes x :: nat, y :: nat, z :: nat
  prop x * (y + z) = x * y + x * z
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: induction x nat_induct
    0: rewrite_goal nat_times_def_1 sym=false
    0: rewrite_goal add_0_right sym=false
    2: introduction x
    2.2: rewrite_goal nat_times_def_2 sym=false
    2.2: rewrite_goal_with_prev @2.1
    2.2: nat_norm
  qed

theorem distrib_r
  fixes x :: nat, y :: nat, z :: nat
  prop (x + y) * z = x * z + y * z
  [hint_rewrite]
  proof
    0: induction z nat_induct
    0: rewrite_goal mult_0_right sym=false
    0: rewrite_goal add_0_right sym=false
    2: introduction n
    2.2: rewrite_goal mult_Suc_right sym=false
    2.2: rewrite_goal_with_prev @2.1
    2.2: nat_norm
  qed

theorem mult_assoc
  fixes x :: nat, y :: nat, z :: nat
  prop x * y * z = x * (y * z)
  [hint_backward]
  proof
    0: induction x nat_induct
    0: rewrite_goal nat_times_def_1
    0: rewrite_goal nat_times_def_1
    2: introduction x
    2.2: rewrite_goal nat_times_def_2
    2.2: rewrite_goal distrib_r
    2.2: rewrite_goal_with_prev @2.1
  qed

theorem mult_comm
  fixes x :: nat, y :: nat
  prop x * y = y * x
  [hint_backward]
  proof
    0: induction x nat_induct
    0: rewrite_goal mult_0_right
    0: rewrite_goal nat_times_def_1
    2: introduction x
    2.2: rewrite_goal nat_times_def_2
    2.2: rewrite_goal_with_prev @2.1
    2.2: rewrite_goal mult_Suc_right
  qed

theorem add_cancel_left
  fixes x :: nat, y :: nat, z :: nat
  prop x + y = x + z ⟶ y = z
  [hint_backward,hint_forward]
  proof
    1: revert_intro @0
    0: induction x nat_induct
    0: introduction
    0.1: rewrite_fact nat_plus_def_1 @0.0 sym=false
    1: introduction n
    1.3: apply_prev @1.1
    1.3: rewrite_fact nat_plus_def_2 @1.2 sym=false
    1.4: apply_backward_step nat_Suc_inject
  qed

theorem add_cancel_right
  fixes x :: nat, y :: nat, z :: nat
  prop x + z = y + z ⟶ x = y
  [hint_backward,hint_forward]
  proof
    1: rewrite_fact add_comm @0
    2: apply_backward_step add_cancel_left @1
  qed

theorem add_right_eq_zero
  fixes x :: nat, y :: nat
  prop x + y = x ⟶ y = 0
  [hint_backward]
  proof
    1: cut "x + y = x + 0"
    1: rewrite_goal add_0_right
    2: apply_backward_step add_cancel_left @1
  qed

theorem add_left_eq_zero
  fixes x :: nat, y :: nat
  prop x + y = y ⟶ x = 0
  [hint_backward]
  proof
    1: cut "x + y = 0 + y"
    1: rewrite_goal nat_plus_def_1
    2: apply_backward_step add_cancel_right @1
  qed

theorem add_is_zero
  fixes x :: nat, y :: nat
  prop x + y = 0 ⟶ x = 0 ∧ y = 0
  [hint_backward,hint_backward1,hint_forward]
  proof
    1: revert_intro @0
    0: induction x nat_induct
    0: introduction
    0.1: apply_backward_step conjI
    0.1: apply_backward_step eq_refl
    0.2: apply_backward_step add_right_eq_zero @0.0
    1: introduction x
    1.3: rewrite_fact nat_plus_def_2 @1.2 sym=false
    1.4: apply_backward_step contrapositive @1.3
    1.4: introduction
    1.4.1: rewrite_goal eq_sym_eq sym=false
    1.4.1: apply_backward_step nat_zero_Suc_neq
  qed

theorem eq_add_lcancel_0
  fixes m :: nat, n :: nat
  prop m + n = m ⟷ n = 0
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step add_right_eq_zero @0.0
    1: introduction
    1.1: rewrite_goal_with_prev @1.0
    1.1: rewrite_goal add_0_right sym=false
  qed

theorem mult_nonzero
  fixes x :: nat, y :: nat
  prop x * y = 0 ⟶ x = 0 ∨ y = 0
  [hint_backward]
  proof
    1: revert_intro @0
    0: induction x nat_induct
    0: introduction
    0.1: apply_backward_step disjI1
    0.1: apply_backward_step eq_refl
    1: introduction x
    1.3: rewrite_fact nat_times_def_2 @1.2 sym=false
    1.4: apply_forward_step add_is_zero @1.3
    1.5: apply_forward_step conjD1 @1.4
    1.6: apply_backward_step disjI2
  qed

theorem mult_eq_0
  fixes x :: nat, y :: nat
  prop x * y = 0 ⟷ x = 0 ∨ y = 0
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step mult_nonzero
    1: introduction
    1.1: apply_backward_step disjE @1.0
    1.1: introduction
    1.1.1: rewrite_goal_with_prev @1.1.0
    1.1.1: rewrite_goal nat_times_def_1 sym=false
    1.2: introduction
    1.2.1: rewrite_goal_with_prev @1.2.0
    1.2.1: rewrite_goal mult_0_right sym=false
  qed

theorem eq_mult_lcancel
  fixes m :: nat, n :: nat, p :: nat
  prop m * n = m * p ⟷ m = 0 ∨ n = p
  [hint_rewrite]
  proof
    0: induction m nat_induct
    0: apply_backward_step iffI
    0: rewrite_goal nat_times_def_1 sym=false
    0: introduction
    0.1: apply_backward_step disjI1
    2: introduction
    2.1: rewrite_goal nat_times_def_1 sym=false
    4: induction n nat_induct
    4: introduction m
    4.2: rewrite_goal mult_0_right sym=false
    4.2: apply_backward_step iffI
    4.2: introduction
    4.2.1: rewrite_fact eq_sym_eq @4.2.0 sym=false
    4.2.2: apply_forward_step mult_nonzero @4.2.1
    4.2.3: apply_backward_step disjE @4.2.2
    4.2.3: introduction
    4.2.3.1: apply_backward_step disjI1
    4.2.4: introduction
    4.2.4.1: apply_backward_step disjI2
    4.2.4.1: rewrite_goal eq_sym_eq sym=false
    4.3: introduction
    4.3.1: apply_backward_step disjE @4.3.0
    4.3.1: introduction
    4.3.1.1: rewrite_goal_with_prev @4.3.1.0
    4.3.1.1: rewrite_goal nat_times_def_1 sym=false
    4.3.2: introduction
    4.3.2.1: rewrite_fact eq_sym_eq @4.3.2.0 sym=false
    4.3.2.2: rewrite_goal_with_prev @4.3.2.1
    4.3.2.2: rewrite_goal mult_0_right sym=false
    5: induction p nat_induct
    5: introduction m
    5.2: introduction n
    5.2.2: rewrite_goal mult_0_right sym=false
    5.2.2: apply_backward_step iffI
    5.2.2: introduction
    5.2.2.1: apply_backward_step mult_nonzero @5.2.2.0
    5.2.3: introduction
    5.2.3.1: apply_backward_step disjE @5.2.3.0
    5.2.3.1: introduction
    5.2.3.1.1: rewrite_goal_with_prev @5.2.3.1.0
    5.2.3.1.1: rewrite_goal nat_times_def_1 sym=false
    5.2.3.2: introduction
    5.2.3.2.1: rewrite_goal_with_prev @5.2.3.2.0
    5.2.3.2.1: rewrite_goal mult_0_right sym=false
    6: introduction m
    6.2: introduction n
    6.2.2: introduction p
    6.2.2.2: apply_backward_step iffI
    6.2.2.2: introduction
    6.2.2.2.1: apply_backward_step disjI2
  qed

theorem eq_mult_rcancel
  fixes m :: nat, n :: nat, p :: nat
  prop n * m = p * m ⟷ m = 0 ∨ n = p
  [hint_rewrite]
  proof
    0: rewrite_goal mult_comm sym=false
    0: rewrite_goal eq_mult_lcancel sym=false
  qed

theorem one_nonzero
  prop ¬((1::nat) = 0)
  proof
    0: rewrite_goal nat_one_def sym=false
    0: rewrite_goal eq_sym_eq sym=false
    0: apply_forward_step nat_zero_Suc_neq param_n="(0::nat)"
  qed

theorem mult_eq_1
  fixes m :: nat, n :: nat
  prop m * n = 1 ⟷ m = 1 ∧ n = 1
  [hint_rewrite]
  proof
    0: induction n nat_induct
    0: apply_backward_step iffI
    0: introduction
    0.1: rewrite_fact mult_0_right @0.0 sym=false
    0.2: apply_backward_step contrapositive @0.1
    0.2: introduction
    0.2.1: rewrite_goal eq_sym_eq sym=false
    0.2.1: apply_backward_step one_nonzero
    1: introduction
    1.1: apply_forward_step conjD2 @1.0
    1.2: apply_backward_step contrapositive @1.1
    1.2: introduction
    1.2.1: rewrite_goal eq_sym_eq sym=false
    1.2.1: apply_backward_step one_nonzero
    3: induction m nat_induct
    3: introduction m
    3.2: rewrite_goal nat_times_def_1 sym=false
    3.2: apply_backward_step iffI
    3.2: introduction
    3.2.1: apply_backward_step contrapositive @3.2.0
    3.2.1: introduction
    3.2.1.1: rewrite_goal eq_sym_eq sym=false
    3.2.1.1: apply_backward_step one_nonzero
    3.3: introduction
    3.3.1: apply_backward_step conjD1 @3.3.0
    4: introduction n
    4.2: introduction m
    4.2.2: apply_backward_step iffI
    4.2.2: introduction
    4.2.2.1: rewrite_fact mult_Suc_right @4.2.2.0 sym=false
    4.2.2.2: cases "Suc n = 1"
    4.2.2.2: introduction
    4.2.2.2.1: apply_backward_step conjI
    4.2.2.2.1: rewrite_fact_with_prev @4.2.2.2.0,4.2.2.0
    4.2.2.2.2: rewrite_fact mult_1_left @4.2.2.2.1 sym=false
    4.2.2.3: introduction
  qed

header "Binary representation"

def bit0 :: nat ⇒ nat = bit0 n = n + n

def bit1 :: nat ⇒ nat = bit1 n = n + n + 1

theorem one_Suc
  prop Suc 1 = bit0 1
  proof
    0: rewrite_goal bit0_def sym=""
    0: nat_norm
  qed

theorem bit0_Suc
  fixes n :: nat
  prop Suc (bit0 n) = bit1 n
  [hint_rewrite,hint_rewrite_sym]

theorem bit1_Suc
  fixes n :: nat
  prop Suc (bit1 n) = bit0 (Suc n)
  [hint_rewrite]

theorem bit0_bit0_add
  fixes m :: nat, n :: nat
  prop bit0 m + bit0 n = bit0 (m + n)

theorem bit0_bit1_add
  fixes m :: nat, n :: nat
  prop bit0 m + bit1 n = bit1 (m + n)

theorem bit1_bit0_add
  fixes m :: nat, n :: nat
  prop bit1 m + bit0 n = bit1 (m + n)

theorem bit1_bit1_add
  fixes m :: nat, n :: nat
  prop bit1 m + bit1 n = bit0 (Suc (m + n))

theorem bit0_bit0_mult
  fixes m :: nat, n :: nat
  prop bit0 m * bit0 n = bit0 (bit0 (m * n))
  proof
    0: rewrite_goal bit0_def sym=""
    0: rewrite_goal bit0_def sym=""
    0: nat_norm
  qed

theorem bit0_bit1_mult
  fixes m :: nat, n :: nat
  prop bit0 m * bit1 n = bit0 (m * bit1 n)

theorem bit1_bit0_mult
  fixes m :: nat, n :: nat
  prop bit1 m * bit0 n = bit0 (bit1 m * n)

theorem bit1_bit1_mult
  fixes m :: nat, n :: nat
  prop bit1 m * bit1 n = bit1 (m + n + bit0 (m * n))

theorem bit0_nonzero
  fixes m :: nat
  prop ¬(m = 0) ⟶ ¬(bit0 m = 0)
  proof
    1: apply_backward_step contrapositive @0
    1: rewrite_goal double_neg sym=false
    1: introduction
    1.1: rewrite_fact bit0_def @1.0 sym=false
    1.2: apply_forward_step add_is_zero @1.1
    1.3: apply_backward_step conjD1 @1.2
  qed

theorem bit1_nonzero
  fixes m :: nat
  prop ¬(bit1 m = 0)
  proof
    0: rewrite_goal bit1_def sym=false
    0: rewrite_goal add_1_right sym=false
    0: rewrite_goal eq_sym_eq sym=false
    0: apply_backward_step nat_zero_Suc_neq
  qed

theorem bit0_neq
  fixes m :: nat, n :: nat
  prop ¬(m = n) ⟶ ¬(bit0 m = bit0 n)
  proof
    1: revert_intro @0
    0: induction n nat_induct
    0: introduction
    0.1: cut "bit0 0 = 0"
    0.1: rewrite_goal bit0_def sym=false
    0.1: rewrite_goal add_0_right sym=false
    0.3: rewrite_goal_with_prev @0.2
    0.3: apply_backward_step bit0_nonzero
    1: introduction n
  qed

theorem bit1_neq
  fixes m :: nat, n :: nat
  prop ¬(m = n) ⟶ ¬(bit1 m = bit1 n)

theorem bit0_bit1_neq
  fixes m :: nat, n :: nat
  prop ¬(bit0 m = bit1 n)

theorem bit0_neq_one
  fixes m :: nat
  prop ¬(bit0 m = 1)

theorem bit1_neq_one
  fixes m :: nat
  prop ¬(m = 0) ⟶ ¬(bit1 m = 1)

header "Test of macros"

theorem nat_norm_test1
  fixes x :: nat, y :: nat, z :: nat
  prop x + y + (y + z) = y * 2 + (x + z)

theorem nat_const_ineq_test1
  prop ¬((12::nat) = 13)
  proof
    0: nat_const_ineq
  qed

theorem mult_2
  fixes n :: nat
  prop 2 * n = n + n
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: rewrite_goal bit0_def sym=""
    0: rewrite_goal nat_of_nat_def sym=""
    0: rewrite_goal distrib_r sym=false
    0: rewrite_goal mult_1_left sym=false
  qed

fun Sigma :: (nat ⇒ nat) ⇒ nat ⇒ nat
  | Sigma f 0 = 0
  | Sigma f (Suc n) = Sigma f n + f n

theorem Sigma_plus
  fixes f :: nat ⇒ nat, g :: nat ⇒ nat, n :: nat
  prop Sigma (λx. f x + g x) n = Sigma f n + Sigma g n
  proof
    0: induction n nat_induct
    0: rewrite_goal Sigma_def_1 sym=false
    0: rewrite_goal add_0_right sym=false
    2: introduction n
    2.2: rewrite_goal Sigma_def_2 sym=false
    2.2: rewrite_goal_with_prev @2.1
    2.2: nat_norm
  qed

const less_eq :: 'a ⇒ 'a ⇒ bool overloaded

const less :: 'a ⇒ 'a ⇒ bool overloaded

def greater_eq :: 'a ⇒ 'a ⇒ bool = m ≥ n ⟷ n ≤ m [hint_rewrite]

def greater :: 'a ⇒ 'a ⇒ bool = m > n ⟷ n < m [hint_rewrite]

fun less_eq :: nat ⇒ nat ⇒ bool
  | m ≤ 0 ⟷ m = 0
  | m ≤ Suc n ⟷ m = Suc n ∨ m ≤ n

fun less :: nat ⇒ nat ⇒ bool
  | m < 0 ⟷ false
  | m < Suc n ⟷ m = n ∨ m < n

theorem lesseq_Suc_less
  fixes m :: nat, n :: nat
  prop Suc m ≤ n ⟷ m < n
  [hint_rewrite]
  proof
    0: induction n nat_induct
    0: rewrite_goal nat_less_def_1
    0: rewrite_goal nat_less_eq_def_1
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step contrapositive @0.0
    0.1: introduction
    0.1.1: rewrite_goal eq_sym_eq sym=false
    0.1.1: apply_backward_step nat_zero_Suc_neq
    1: introduction
    1.1: apply_resolve_step not_false_res @1.0
    5: introduction n
    5.2: rewrite_goal nat_less_def_2 sym=false
    5.2: rewrite_goal nat_less_eq_def_2 sym=false
    5.2: apply_backward_step iffI
    5.2: introduction
    5.2.1: apply_backward_step disjE @5.2.0
    5.2.1: introduction
    5.2.1.1: apply_backward_step disjI1
    5.2.1.1: apply_backward_step nat_Suc_inject
    5.2.2: introduction
    5.2.2.1: apply_backward_step disjI2
    5.2.2.1: rewrite_fact_with_prev @5.1,5.2.2.0
    5.3: introduction
    5.3.1: apply_backward_step disjE @5.3.0
    5.3.1: introduction
    5.3.1.1: apply_backward_step disjI1
    5.3.1.1: rewrite_goal_with_prev @5.3.1.0
    5.3.2: introduction
    5.3.2.1: apply_backward_step disjI2
    5.3.2.1: rewrite_goal_with_prev @5.1
  qed

theorem less_Suc_lesseq
  fixes m :: nat, n :: nat
  prop m < Suc n ⟷ m ≤ n
  [hint_rewrite]
  proof
    0: induction n nat_induct
    0: rewrite_goal nat_less_eq_def_1
    0: rewrite_goal nat_less_def_2
    0: rewrite_goal nat_less_def_1
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step disjE @0.0
    0.2: introduction
    0.2.1: apply_resolve_step not_false_res @0.2.0
    1: introduction
    1.1: apply_backward_step disjI1
    6: introduction n
    6.2: rewrite_goal nat_less_def_2 sym=false
    6.2: apply_backward_step iffI
    6.2: introduction
    6.2.1: apply_backward_step disjE @6.2.0
    6.2.1: introduction
    6.2.1.1: rewrite_goal nat_less_eq_def_2 sym=false
    6.2.1.1: apply_backward_step disjI1
    6.2.2: rewrite_goal_with_prev @6.1
    6.2.2: introduction
    6.2.2.1: rewrite_goal nat_less_eq_def_2 sym=false
    6.2.2.1: apply_backward_step disjI2
    6.3: rewrite_goal nat_less_eq_def_2 sym=false
    6.3: rewrite_goal_with_prev @6.1
  qed

theorem le_suc
  fixes m :: nat, n :: nat
  prop Suc m ≤ Suc n ⟷ m ≤ n
  [hint_rewrite]
  proof
    0: rewrite_goal lesseq_Suc_less sym=false
    0: rewrite_goal less_Suc_lesseq sym=false
  qed

theorem lt_suc
  fixes m :: nat, n :: nat
  prop Suc m < Suc n ⟷ m < n
  [hint_rewrite]
  proof
    0: rewrite_goal less_Suc_lesseq sym=false
    0: rewrite_goal lesseq_Suc_less sym=false
  qed

theorem lt_imp_le
  fixes m :: nat, n :: nat
  prop m < n ⟶ m ≤ n
  [hint_backward,hint_forward]
  proof
    1: revert_intro @0
    0: induction n nat_induct
    0: introduction
    0.1: rewrite_fact nat_less_def_1 @0.0 sym=false
    0.2: apply_resolve_step not_false_res @0.1
    1: introduction n
    1.3: rewrite_fact less_Suc_lesseq @1.2 sym=false
