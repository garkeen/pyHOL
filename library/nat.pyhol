theory nat
imports logic
domains nat
description "Natural numbers"

header "Basic definitions"

const zero :: 'a overloaded

const one :: 'a overloaded

datatype nat =
  | zero :: nat
  | Suc (n :: nat) :: nat

def one :: nat = 1 = Suc 0 [hint_rewrite]

const of_nat :: nat ⇒ 'a overloaded

def of_nat :: nat ⇒ nat = of_nat n = n

fun Pre :: nat ⇒ nat
  | Pre 0 = 0
  | Pre (Suc n) = n

const plus :: 'a ⇒ 'a ⇒ 'a overloaded

const minus :: 'a ⇒ 'a ⇒ 'a overloaded

const times :: 'a ⇒ 'a ⇒ 'a overloaded

const power :: 'a ⇒ 'b ⇒ 'a overloaded

fun plus :: nat ⇒ nat ⇒ nat
  | 0 + n = n
  | Suc m + n = Suc (m + n)

fun times :: nat ⇒ nat ⇒ nat
  | 0 * n = 0
  | Suc m * n = n + m * n

fun power :: nat ⇒ nat ⇒ nat
  | n ^ (0::nat) = 1
  | n ^ Suc m = n * n ^ m

theorem add_0_right
  fixes x :: nat
  prop x + 0 = x
  [hint_rewrite]
proof
  ← induct x nat_induct goal=0
    #[1] (0::nat) + 0 = 0
    #[2] ∀n. n + 0 = n ⟶ Suc n + 0 = Suc n
  ← rewrite nat_plus_def_1 sym=false goal=1
  ← intro m goal=2
    #[3] _VAR m
    #[4] m + 0 = m
    #[5] Suc m + 0 = Suc m
  ← rewrite nat_plus_def_2 sym=false goal=5
    #[6] Suc (m + 0) = Suc m
  ← rewrite source=prev goal=6 facts=[4]
qed

theorem add_1_left
  fixes x :: nat
  prop 1 + x = Suc x
  [hint_rewrite]
proof
  ← rewrite nat_one_def goal=0
    #[1] Suc 0 + x = Suc x
  ← rewrite nat_plus_def_2 goal=1
    #[2] Suc (0 + x) = Suc x
  ← rewrite nat_plus_def_1 goal=2
qed

theorem add_1_right
  fixes x :: nat
  prop x + 1 = Suc x
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct x nat_induct goal=0
    #[1] 0 + 1 = Suc 0
    #[2] ∀n. n + 1 = Suc n ⟶ Suc n + 1 = Suc (Suc n)
  ← rewrite nat_plus_def_1 goal=1
    #[3] 1 = Suc 0
  ← rewrite nat_one_def goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] n + 1 = Suc n
    #[6] Suc n + 1 = Suc (Suc n)
  ← rewrite nat_plus_def_2 goal=6
    #[7] Suc (n + 1) = Suc (Suc n)
  ← rewrite source=prev goal=7 facts=[5]
qed

theorem add_Suc_right
  fixes x :: nat, y :: nat
  prop x + Suc y = Suc (x + y)
  [hint_rewrite]
proof
  ← induct x nat_induct goal=0
    #[1] 0 + Suc y = Suc (0 + y)
    #[2] ∀n. n + Suc y = Suc (n + y) ⟶ Suc n + Suc y = Suc (Suc n + y)
  ← rewrite nat_plus_def_1 sym=false goal=1
  ← intro m goal=2
    #[3] _VAR m
    #[4] m + Suc y = Suc (m + y)
    #[5] Suc m + Suc y = Suc (Suc m + y)
  ← rewrite nat_plus_def_2 sym=false goal=5
    #[6] Suc (m + Suc y) = Suc (Suc (m + y))
  ← rewrite source=prev goal=6 facts=[4]
qed

theorem add_comm
  fixes x :: nat, y :: nat
  prop x + y = y + x
  [hint_backward]
proof
  ← induct x nat_induct goal=0
    #[1] 0 + y = y + 0
    #[2] ∀n. n + y = y + n ⟶ Suc n + y = y + Suc n
  ← rewrite add_0_right goal=1
    #[3] 0 + y = y
  ← rewrite nat_plus_def_1 goal=3
  ← intro x goal=2
    #[4] _VAR x
    #[5] x + y = y + x
    #[6] Suc x + y = y + Suc x
  ← rewrite nat_plus_def_2 goal=6
    #[7] Suc (x + y) = y + Suc x
  ← rewrite add_Suc_right goal=7
    #[8] Suc (x + y) = Suc (y + x)
  ← rewrite source=prev goal=8 facts=[5]
qed

theorem add_assoc
  fixes x :: nat, y :: nat, z :: nat
  prop x + y + z = x + (y + z)
  [hint_backward]
proof
  ← induct x nat_induct goal=0
    #[1] 0 + y + z = 0 + (y + z)
    #[2] ∀n. n + y + z = n + (y + z) ⟶ Suc n + y + z = Suc n + (y + z)
  ← rewrite nat_plus_def_1 sym=false goal=1
  ← intro x goal=2
    #[3] _VAR x
    #[4] x + y + z = x + (y + z)
    #[5] Suc x + y + z = Suc x + (y + z)
  ← rewrite nat_plus_def_2 sym=false goal=5
    #[6] Suc (x + y) + z = Suc (x + (y + z))
  ← rewrite nat_plus_def_2 sym=false goal=6
    #[7] Suc (x + y + z) = Suc (x + (y + z))
  ← rewrite source=prev goal=7 facts=[4]
qed

theorem mult_0_right
  fixes x :: nat
  prop x * 0 = 0
  [hint_rewrite]
proof
  ← induct x nat_induct goal=0
    #[1] (0::nat) * 0 = 0
    #[2] ∀n. n * 0 = 0 ⟶ Suc n * 0 = 0
  ← rewrite nat_times_def_1 goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] n * 0 = 0
    #[5] Suc n * 0 = 0
  ← rewrite nat_times_def_2 goal=5
    #[6] 0 + n * 0 = 0
  ← rewrite nat_plus_def_1 goal=6
qed

theorem mult_1_left
  fixes x :: nat
  prop 1 * x = x
  [hint_rewrite]
proof
  ← rewrite nat_one_def goal=0
    #[1] Suc 0 * x = x
  ← rewrite nat_times_def_2 goal=1
    #[2] x + 0 * x = x
  ← rewrite nat_times_def_1 goal=2
    #[3] x + 0 = x
  nat_norm goal=3
qed

theorem mult_1_right
  fixes x :: nat
  prop x * 1 = x
  [hint_rewrite]
proof
  ← induct x nat_induct goal=0
    #[1] (0::nat) * 1 = 0
    #[2] ∀n. n * 1 = n ⟶ Suc n * 1 = Suc n
  ← rewrite nat_times_def_1 goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] n * 1 = n
    #[5] Suc n * 1 = Suc n
  ← rewrite nat_times_def_2 goal=5
    #[6] 1 + n * 1 = Suc n
  ← rewrite source=prev goal=6 facts=[4]
    #[7] 1 + n = Suc n
  nat_norm goal=7
    #[8] 1 + n = Suc n
qed

theorem mult_Suc_right
  fixes x :: nat, y :: nat
  prop x * Suc y = x + x * y
  [hint_rewrite]
proof
  ← induct x nat_induct goal=0
    #[1] 0 * Suc y = 0 + 0 * y
    #[2] !n. n * Suc y = n + n * y --> Suc n * Suc y = Suc n + Suc n * y
  ← rewrite nat_times_def_1 goal=1
    #[3] (0::nat) = 0 + 0
  ← rewrite nat_plus_def_1 goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] n * Suc y = n + n * y
    #[6] Suc n * Suc y = Suc n + Suc n * y
  ← rewrite nat_times_def_2 sym=false goal=6
    #[7] Suc y + n * Suc y = Suc n + (y + n * y)
  ← rewrite source=prev goal=7 facts=[5]
    #[8] Suc y + (n + n * y) = Suc n + (y + n * y)
  nat_norm goal=8
    #[9] Suc y + (n + n * y) = Suc n + (y + n * y)
qed

theorem distrib_l
  fixes x :: nat, y :: nat, z :: nat
  prop x * (y + z) = x * y + x * z
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct x nat_induct goal=0
    #[1] 0 * (y + z) = 0 * y + 0 * z
    #[2] ∀n. n * (y + z) = n * y + n * z ⟶ Suc n * (y + z) = Suc n * y + Suc n * z
  ← rewrite nat_times_def_1 sym=false goal=1
    #[3] (0::nat) = 0 + 0
  ← rewrite add_0_right sym=false goal=3
  ← intro x goal=2
    #[4] _VAR x
    #[5] x * (y + z) = x * y + x * z
    #[6] Suc x * (y + z) = Suc x * y + Suc x * z
  ← rewrite nat_times_def_2 sym=false goal=6
    #[7] y + z + x * (y + z) = y + x * y + (z + x * z)
  ← rewrite source=prev goal=7 facts=[5]
    #[8] y + z + (x * y + x * z) = y + x * y + (z + x * z)
  nat_norm goal=8
    #[9] y + z + (x * y + x * z) = y + x * y + (z + x * z)
qed

theorem distrib_r
  fixes x :: nat, y :: nat, z :: nat
  prop (x + y) * z = x * z + y * z
  [hint_rewrite]
proof
  ← induct z nat_induct goal=0
    #[1] (x + y) * 0 = x * 0 + y * 0
    #[2] ∀n. (x + y) * n = x * n + y * n ⟶ (x + y) * Suc n = x * Suc n + y * Suc n
  ← rewrite mult_0_right sym=false goal=1
    #[3] (0::nat) = 0 + 0
  ← rewrite add_0_right sym=false goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] (x + y) * n = x * n + y * n
    #[6] (x + y) * Suc n = x * Suc n + y * Suc n
  ← rewrite mult_Suc_right sym=false goal=6
    #[7] x + y + (x + y) * n = x + x * n + (y + y * n)
  ← rewrite source=prev goal=7 facts=[5]
    #[8] x + y + (x * n + y * n) = x + x * n + (y + y * n)
  nat_norm goal=8
    #[9] x + y + (x * n + y * n) = x + x * n + (y + y * n)
qed

theorem mult_assoc
  fixes x :: nat, y :: nat, z :: nat
  prop x * y * z = x * (y * z)
  [hint_backward]
proof
  ← induct x nat_induct goal=0
    #[1] 0 * y * z = 0 * (y * z)
    #[2] ∀n. n * y * z = n * (y * z) ⟶ Suc n * y * z = Suc n * (y * z)
  ← rewrite nat_times_def_1 goal=1
    #[3] 0 * z = 0
  ← rewrite nat_times_def_1 goal=3
  ← intro x goal=2
    #[4] _VAR x
    #[5] x * y * z = x * (y * z)
    #[6] Suc x * y * z = Suc x * (y * z)
  ← rewrite nat_times_def_2 goal=6
    #[7] (y + x * y) * z = y * z + x * (y * z)
  ← rewrite distrib_r goal=7
    #[8] y * z + x * y * z = y * z + x * (y * z)
  ← rewrite source=prev goal=8 facts=[5]
qed

theorem mult_comm
  fixes x :: nat, y :: nat
  prop x * y = y * x
  [hint_backward]
proof
  ← induct x nat_induct goal=0
    #[1] 0 * y = y * 0
    #[2] ∀n. n * y = y * n ⟶ Suc n * y = y * Suc n
  ← rewrite mult_0_right goal=1
    #[3] 0 * y = 0
  ← rewrite nat_times_def_1 goal=3
  ← intro x goal=2
    #[4] _VAR x
    #[5] x * y = y * x
    #[6] Suc x * y = y * Suc x
  ← rewrite nat_times_def_2 goal=6
    #[7] y + x * y = y * Suc x
  ← rewrite source=prev goal=7 facts=[5]
    #[8] y + y * x = y * Suc x
  ← rewrite mult_Suc_right goal=8
    #[9] y + y * x = y * Suc x
qed

theorem add_cancel_left
  fixes x :: nat, y :: nat, z :: nat
  prop x + y = x + z --> y = z
  [hint_backward,hint_forward]
proof
  ← induct x nat_induct goal=0
    #[3] 0 + y = 0 + z ⟶ y = z
    #[4] ∀n. (n + y = n + z ⟶ y = z) ⟶ Suc n + y = Suc n + z ⟶ y = z
  ← intro goal=3
    #[5] 0 + y = 0 + z
    #[6] y = z
  → rewrite target=fact nat_plus_def_1 sym=false goal=6 facts=[5]
  ← intro n goal=4
    #[7] _VAR n
    #[8] n + y = n + z ⟶ y = z
    #[9] Suc n + y = Suc n + z
    #[10] y = z
  ← apply_prev goal=10 facts=[8]
    #[11] n + y = n + z
  → rewrite target=fact nat_plus_def_2 sym=false goal=11 facts=[9]
    #[12] Suc (n + y) = Suc (n + z)
  ← rule nat_Suc_inject goal=11
qed

theorem add_cancel_right
  fixes x :: nat, y :: nat, z :: nat
  prop x + z = y + z --> x = y
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] x + z = y + z
    #[2] x = y
  → rewrite target=fact add_comm goal=2 facts=[1]
    #[3] z + x = z + y
  ← rule add_cancel_left goal=2 facts=[3]
qed

theorem add_right_eq_zero
  fixes x :: nat, y :: nat
  prop x + y = x --> y = 0
  [hint_backward]
proof
  ← intro goal=0
    #[1] x + y = x
    #[2] y = 0
  cut "x + y = x + 0" goal=2
    #[3] x + y = x + 0
  ← rewrite add_0_right goal=3
  ← rule add_cancel_left goal=2 facts=[3]
qed

theorem add_left_eq_zero
  fixes x :: nat, y :: nat
  prop x + y = y --> x = 0
  [hint_backward]
proof
  ← intro goal=0
    #[1] x + y = y
    #[2] x = 0
  cut "x + y = 0 + y" goal=2
    #[3] x + y = 0 + y
  ← rewrite nat_plus_def_1 goal=3
  ← rule add_cancel_right goal=2 facts=[3]
qed

theorem add_is_zero
  fixes x :: nat, y :: nat
  prop x + y = 0 --> x = 0 & y = 0
  [hint_backward,hint_backward1,hint_forward]
proof
  ← induct x nat_induct goal=0
    #[3] 0 + y = 0 ⟶ (0::nat) = 0 ∧ y = 0
    #[4] ∀n. (n + y = 0 ⟶ n = 0 ∧ y = 0) ⟶ Suc n + y = 0 ⟶ Suc n = 0 ∧ y = 0
  ← intro goal=3
    #[5] 0 + y = 0
    #[6] (0::nat) = 0 ∧ y = 0
  ← rule conjI goal=6
    #[7] (0::nat) = 0
    #[8] y = 0
  ← rule eq_refl goal=7
    #[9] (0::nat) = 0
  ← rule add_right_eq_zero goal=8 facts=[5]
  ← intro x goal=4
    #[10] _VAR x
    #[11] x + y = 0 ⟶ x = 0 ∧ y = 0
    #[12] Suc x + y = 0
    #[13] Suc x = 0 ∧ y = 0
  → rewrite target=fact nat_plus_def_2 sym=false goal=13 facts=[12]
    #[14] Suc (x + y) = 0
  ← rule contrapositive goal=13 facts=[14]
    #[15] ¬(Suc x = 0 ∧ y = 0) ⟶ ¬(Suc (x + y) = 0)
  ← intro goal=15
    #[16] ¬(Suc x = 0 ∧ y = 0)
    #[17] ¬(Suc (x + y) = 0)
  ← rewrite eq_sym_eq sym=false goal=17
    #[18] ¬(0 = Suc (x + y))
  ← rule nat_zero_Suc_neq goal=18
    #[19] ¬(0 = Suc (x + y))
qed

theorem eq_add_lcancel_0
  fixes m :: nat, n :: nat
  prop m + n = m <--> n = 0
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] m + n = m ⟶ n = 0
    #[2] n = 0 ⟶ m + n = m
  ← intro goal=1
    #[3] m + n = m
    #[4] n = 0
  ← rule add_right_eq_zero goal=4 facts=[3]
  ← intro goal=2
    #[5] n = 0
    #[6] m + n = m
  ← rewrite source=prev goal=6 facts=[5]
    #[7] m + 0 = m
  ← rewrite add_0_right sym=false goal=7
    #[8] m + 0 = m
qed

theorem mult_nonzero
  fixes x :: nat, y :: nat
  prop x * y = 0 --> x = 0 | y = 0
  [hint_backward]
proof
  ← induct x nat_induct goal=0
    #[3] 0 * y = 0 ⟶ (0::nat) = 0 ∨ y = 0
    #[4] ∀n. (n * y = 0 ⟶ n = 0 ∨ y = 0) ⟶ Suc n * y = 0 ⟶ Suc n = 0 ∨ y = 0
  ← intro goal=3
    #[5] 0 * y = 0
    #[6] (0::nat) = 0 ∨ y = 0
  ← rule disjI1 goal=6
    #[7] (0::nat) = 0
  ← rule eq_refl goal=7
    #[8] (0::nat) = 0
  ← intro x goal=4
    #[9] _VAR x
    #[10] x * y = 0 ⟶ x = 0 ∨ y = 0
    #[11] Suc x * y = 0
    #[12] Suc x = 0 ∨ y = 0
  → rewrite target=fact nat_times_def_2 sym=false goal=12 facts=[11]
    #[13] y + x * y = 0
  → forward add_is_zero goal=12 facts=[13]
    #[14] y = 0 ∧ x * y = 0
  → forward conjD1 goal=12 facts=[14]
    #[15] y = 0
  ← rule disjI2 goal=12
qed

theorem mult_eq_0
  fixes x :: nat, y :: nat
  prop x * y = 0 <--> x = 0 | y = 0
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] x * y = 0 ⟶ x = 0 ∨ y = 0
    #[2] x = 0 ∨ y = 0 ⟶ x * y = 0
  ← intro goal=1
    #[3] x * y = 0
    #[4] x = 0 ∨ y = 0
  ← rule mult_nonzero goal=4
  ← intro goal=2
    #[5] x = 0 ∨ y = 0
    #[6] x * y = 0
  ← rule disjE goal=6 facts=[5]
    #[7] x = 0 ⟶ x * y = 0
    #[8] y = 0 ⟶ x * y = 0
  ← intro goal=7
    #[9] x = 0
    #[10] x * y = 0
  ← rewrite source=prev goal=10 facts=[9]
    #[11] 0 * y = 0
  ← rewrite nat_times_def_1 sym=false goal=11
    #[12] 0 * y = 0
  ← intro goal=8
    #[13] y = 0
    #[14] x * y = 0
  ← rewrite source=prev goal=14 facts=[13]
    #[15] x * 0 = 0
  ← rewrite mult_0_right sym=false goal=15
    #[16] x * 0 = 0
qed

theorem one_nonzero
  prop ~((1::nat) = 0)
proof
  ← rewrite nat_one_def sym=false goal=0
    #[1] ¬(Suc 0 = 0)
  ← rewrite eq_sym_eq sym=false goal=1
    #[2] ¬(0 = Suc 0)
  → forward nat_zero_Suc_neq param_n="(0::nat)" goal=2
qed

theorem mult_eq_1
  fixes m :: nat, n :: nat
  prop m * n = 1 <--> m = 1 & n = 1
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] m * n = 1 --> m = 1 & n = 1
    #[2] m = 1 & n = 1 --> m * n = 1
  → forward one_nonzero goal=1
    #[3] ~((1::nat) = 0)
  ← type_cases m goal=1
    #[4] 0 * n = 1 --> (0::nat) = 1 & n = 1
    #[5] !n1. Suc n1 * n = 1 --> Suc n1 = 1 & n = 1
  ← intro goal=4
    #[6] 0 * n = 1
    #[7] (0::nat) = 1 & n = 1
  → forward nat_times_def_1 param_n=n goal=7
    #[8] 0 * n = 0
  → rewrite source=prev target=fact goal=7 facts=[6,8]
    #[9] (1::nat) = 0
  ← rule negE_gen goal=7 facts=[3,9]
  ← type_cases n goal=5
    #[10] !n. Suc n * 0 = 1 --> Suc n = 1 & (0::nat) = 1
    #[11] !n. !n1. Suc n1 * Suc n = 1 --> Suc n1 = 1 & Suc n = 1
  ← intro a goal=10
    #[12] _VAR a
    #[13] Suc a * 0 = 1
    #[14] Suc a = 1 & (0::nat) = 1
  → forward mult_0_right param_x="Suc a" goal=14
    #[15] Suc a * 0 = 0
  → rewrite source=prev target=fact goal=14 facts=[15,13]
    #[16] (0::nat) = 1
  → rewrite eq_sym_eq sym=false target=fact goal=14 facts=[3]
    #[17] ~((0::nat) = 1)
  ← rule negE_gen goal=14 facts=[17,16]
  ← intro a,b goal=11
    #[18] _VAR b
    #[19] Suc b * Suc a = 1
    #[20] Suc b = 1 & Suc a = 1
  → rewrite nat_times_def_2 sym=false target=fact goal=20 facts=[19]
    #[21] Suc a + b * Suc a = 1
  → rewrite nat_plus_def_2 sym=false target=fact goal=20 facts=[21]
    #[22] Suc (a + b * Suc a) = 1
  → rewrite nat_one_def sym=false target=fact goal=20 facts=[22]
    #[23] Suc (a + b * Suc a) = Suc 0
  → forward nat_Suc_inject goal=20 facts=[23]
    #[24] a + b * Suc a = 0
  → forward add_is_zero goal=20 facts=[24]
    #[25] a = 0 & b * Suc a = 0
  → forward conjD1 goal=20 facts=[25]
    #[26] a = 0
  → forward conjD2 goal=20 facts=[25]
    #[27] b * Suc a = 0
  → rewrite source=prev target=fact goal=20 facts=[26,27]
    #[28] b * Suc 0 = 0
  → rewrite nat_one_def sym=true target=fact goal=20 facts=[28]
    #[29] b * 1 = 0
  → rewrite mult_1_right sym=false target=fact goal=20 facts=[29]
    #[30] b = 0
  ← rule conjI goal=20
    #[31] Suc b = 1
    #[32] Suc a = 1
  ← rewrite nat_one_def sym=false goal=31
    #[33] Suc b = Suc 0
  ← rewrite source=prev goal=33 facts=[30]
  ← rewrite nat_one_def sym=false goal=32
    #[34] Suc a = Suc 0
  ← rewrite source=prev goal=34 facts=[26]
  ← intro goal=2
    #[35] m = 1 & n = 1
    #[36] m * n = 1
  → forward conjD1 goal=36 facts=[35]
    #[37] m = 1
  → forward conjD2 goal=36 facts=[35]
    #[38] n = 1
  ← rewrite source=prev goal=36 facts=[37]
    #[39] 1 * n = 1
  ← rewrite source=prev goal=39 facts=[38]
    #[40] (1::nat) * 1 = 1
  ← rewrite mult_1_left sym=false goal=40
    #[41] (1::nat) * 1 = 1
qed

header "Binary representation"

def bit0 :: nat ⇒ nat = bit0 n = n + n

def bit1 :: nat ⇒ nat = bit1 n = n + n + 1

theorem one_Suc
  prop Suc 1 = bit0 1
proof
  ← rewrite bit0_def sym="" goal=0
    #[1] Suc 1 = 1 + 1
  nat_norm goal=1
qed

theorem bit0_Suc
  fixes n :: nat
  prop Suc (bit0 n) = bit1 n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite bit0_def sym=false goal=0
    #[1] Suc (n + n) = bit1 n
  ← rewrite bit1_def sym=false goal=1
    #[2] Suc (n + n) = n + n + 1
  ← rewrite nat_one_def sym=false goal=2
    #[3] Suc (n + n) = n + n + Suc 0
  ← rewrite add_Suc_right sym=false goal=3
    #[4] Suc (n + n) = Suc (n + n + 0)
  ← rewrite add_0_right sym=false goal=4
qed

theorem bit1_Suc
  fixes n :: nat
  prop Suc (bit1 n) = bit0 (Suc n)
  [hint_rewrite]
proof
  ← rewrite bit1_def sym=false goal=0
    #[1] Suc (n + n + 1) = bit0 (Suc n)
  ← rewrite bit0_def sym=false goal=1
    #[2] Suc (n + n + 1) = Suc n + Suc n
  ← rewrite nat_one_def sym=false goal=2
    #[3] Suc (n + n + Suc 0) = Suc n + Suc n
  ← rewrite nat_plus_def_2 sym=false goal=3
    #[4] Suc (n + n + Suc 0) = Suc (n + Suc n)
  ← rewrite add_Suc_right sym=false goal=4
    #[5] Suc (Suc (n + n + 0)) = Suc (Suc (n + n))
  ← rewrite add_0_right sym=false goal=5
qed

theorem bit0_bit0_add
  fixes m :: nat, n :: nat
  prop bit0 m + bit0 n = bit0 (m + n)
proof
  ← rewrite bit0_def sym=false goal=0
    #[1] m + m + (n + n) = m + n + (m + n)
  nat_norm goal=1
qed

theorem bit0_bit1_add
  fixes m :: nat, n :: nat
  prop bit0 m + bit1 n = bit1 (m + n)
proof
  ← rewrite bit0_def sym=false goal=0
    #[1] m + m + bit1 n = bit1 (m + n)
  ← rewrite bit1_def sym=false goal=1
    #[2] m + m + (n + n + 1) = m + n + (m + n) + 1
  nat_norm goal=2
qed

theorem bit1_bit0_add
  fixes m :: nat, n :: nat
  prop bit1 m + bit0 n = bit1 (m + n)
proof
  ← rewrite bit1_def sym=false goal=0
    #[1] m + m + 1 + bit0 n = m + n + (m + n) + 1
  ← rewrite bit0_def sym=false goal=1
    #[2] m + m + 1 + (n + n) = m + n + (m + n) + 1
  nat_norm goal=2
qed

theorem bit1_bit1_add
  fixes m :: nat, n :: nat
  prop bit1 m + bit1 n = bit0 (Suc (m + n))
proof
  ← rewrite bit1_def sym=false goal=0
    #[1] m + m + 1 + (n + n + 1) = bit0 (Suc (m + n))
  ← rewrite bit0_def sym=false goal=1
    #[2] m + m + 1 + (n + n + 1) = Suc (m + n) + Suc (m + n)
  nat_norm goal=2
qed

theorem bit0_bit0_mult
  fixes m :: nat, n :: nat
  prop bit0 m * bit0 n = bit0 (bit0 (m * n))
proof
  ← rewrite bit0_def sym="" goal=0
    #[1] (m + m) * (n + n) = bit0 (m * n) + bit0 (m * n)
  ← rewrite bit0_def sym="" goal=1
    #[2] (m + m) * (n + n) = m * n + m * n + (m * n + m * n)
  nat_norm goal=2
qed

theorem bit0_bit1_mult
  fixes m :: nat, n :: nat
  prop bit0 m * bit1 n = bit0 (m * bit1 n)
proof
  ← rewrite bit0_def sym=false goal=0
    #[1] (m + m) * bit1 n = m * bit1 n + m * bit1 n
  ← rewrite bit1_def sym=false goal=1
    #[2] (m + m) * (n + n + 1) = m * (n + n + 1) + m * (n + n + 1)
  nat_norm goal=2
qed

theorem bit1_bit0_mult
  fixes m :: nat, n :: nat
  prop bit1 m * bit0 n = bit0 (bit1 m * n)
proof
  ← rewrite bit0_def sym=false goal=0
    #[1] bit1 m * (n + n) = bit1 m * n + bit1 m * n
  ← rewrite bit1_def sym=false goal=1
    #[2] (m + m + 1) * (n + n) = (m + m + 1) * n + (m + m + 1) * n
  nat_norm goal=2
qed

theorem bit1_bit1_mult
  fixes m :: nat, n :: nat
  prop bit1 m * bit1 n = bit1 (m + n + bit0 (m * n))
proof
  ← rewrite bit1_def sym=false goal=0
    #[1] (m + m + 1) * (n + n + 1) = m + n + bit0 (m * n) + (m + n + bit0 (m * n)) + 1
  ← rewrite bit0_def sym=false goal=1
    #[2] (m + m + 1) * (n + n + 1) = m + n + (m * n + m * n) + (m + n + (m * n + m * n)) + 1
  nat_norm goal=2
qed

theorem bit0_nonzero
  fixes m :: nat
  prop ~(m = 0) --> ~(bit0 m = 0)
proof
  ← intro goal=0
    #[1] ¬(m = 0)
    #[2] ¬(bit0 m = 0)
  ← rule contrapositive goal=2 facts=[1]
    #[3] ¬¬(bit0 m = 0) ⟶ ¬¬(m = 0)
  ← rewrite double_neg sym=false goal=3
    #[4] bit0 m = 0 ⟶ m = 0
  ← intro goal=4
    #[5] bit0 m = 0
    #[6] m = 0
  → rewrite target=fact bit0_def sym=false goal=6 facts=[5]
    #[7] m + m = 0
  → forward add_is_zero goal=6 facts=[7]
    #[8] m = 0 ∧ m = 0
  ← rule conjD1 goal=6 facts=[8]
    #[9] m = 0
qed

theorem bit1_nonzero
  fixes m :: nat
  prop ~(bit1 m = 0)
proof
  ← rewrite bit1_def sym=false goal=0
    #[1] ¬(m + m + 1 = 0)
  ← rewrite add_1_right sym=false goal=1
    #[2] ¬(Suc (m + m) = 0)
  ← rewrite eq_sym_eq sym=false goal=2
    #[3] ¬(0 = Suc (m + m))
  ← rule nat_zero_Suc_neq goal=3
qed

theorem bit0_neq
  fixes m :: nat, n :: nat
  prop ~(m = n) --> ~(bit0 m = bit0 n)

theorem bit1_neq
  fixes m :: nat, n :: nat
  prop ~(m = n) --> ~(bit1 m = bit1 n)

theorem bit0_bit1_neq
  fixes m :: nat, n :: nat
  prop ~(bit0 m = bit1 n)

theorem bit0_neq_one
  fixes m :: nat
  prop ~(bit0 m = 1)
proof
  ← rule negI goal=0
    #[1] bit0 m = 1 --> false
  ← rewrite bit0_def sym=false goal=1
    #[2] m + m = 1 --> false
  ← type_cases m goal=2
    #[3] (0::nat) + 0 = 1 --> false
    #[4] !n. Suc n + Suc n = 1 --> false
  ← rewrite nat_plus_def_1 sym=false goal=3
    #[5] (0::nat) = 1 --> false
  ← intro goal=5
    #[6] (0::nat) = 1
    #[7] false
  → rewrite eq_sym_eq sym=false target=fact goal=7 facts=[6]
    #[8] (1::nat) = 0
  → forward one_nonzero goal=7
    #[9] ~((1::nat) = 0)
  ← rule negE_gen goal=7 facts=[9,8]
  ← rewrite nat_plus_def_2 sym=false goal=4
    #[10] !n. Suc (n + Suc n) = 1 --> false
  ← rewrite nat_one_def sym=false goal=10
    #[11] !n. Suc (n + Suc n) = Suc 0 --> false
  ← intro a goal=11
    #[12] _VAR a
    #[13] Suc (a + Suc a) = Suc 0
    #[14] false
  → forward nat_zero_Suc_neq param_n=a goal=13
    #[15] ~(0 = Suc a)
  → forward nat_Suc_inject goal=14 facts=[13]
    #[16] a + Suc a = 0
  → forward add_is_zero goal=14 facts=[16]
    #[17] a = 0 & Suc a = 0
  → forward conjD2 goal=14 facts=[17]
    #[18] Suc a = 0
  → rewrite eq_sym_eq sym=false target=fact goal=14 facts=[18]
    #[19] 0 = Suc a
  ← rule negE_gen goal=14 facts=[15,19]
qed

theorem bit1_neq_one
  fixes m :: nat
  prop ~(m = 0) --> ~(bit1 m = 1)
proof
  ← intro goal=0
    #[1] ~(m = 0)
    #[2] ~(bit1 m = 1)
  ← rule negI goal=2
    #[3] bit1 m = 1 --> false
  ← intro goal=3
    #[4] bit1 m = 1
    #[5] false
  → rewrite bit1_def sym=false target=fact goal=5 facts=[4]
    #[6] m + m + 1 = 1
  → rewrite add_1_right sym=false target=fact goal=5 facts=[6]
    #[7] Suc (m + m) = 1
  → rewrite nat_one_def sym=false target=fact goal=5 facts=[7]
    #[8] Suc (m + m) = Suc 0
  → forward nat_Suc_inject goal=5 facts=[8]
    #[9] m + m = 0
  → forward add_is_zero goal=5 facts=[9]
    #[10] m = 0 & m = 0
  → forward conjD1 goal=5 facts=[10]
    #[11] m = 0
  ← rule negE_gen goal=5 facts=[1,11]
qed

header "Test of macros"

theorem nat_norm_test1
  fixes x :: nat, y :: nat, z :: nat
  prop x + y + (y + z) = y * 2 + (x + z)
proof
  nat_norm goal=0
qed

theorem nat_const_ineq_test1
  prop ~((12::nat) = 13)
proof
  nat_const_ineq goal=0
qed

theorem mult_2
  fixes n :: nat
  prop 2 * n = n + n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite bit0_def sym="" goal=0
    #[1] of_nat (1 + 1) * n = n + n
  ← rewrite nat_of_nat_def sym="" goal=1
    #[2] (1 + 1) * n = n + n
  ← rewrite distrib_r sym=false goal=2
    #[3] 1 * n + 1 * n = n + n
  ← rewrite mult_1_left sym=false goal=3
qed

fun Sigma :: (nat ⇒ nat) ⇒ nat ⇒ nat
  | Sigma f 0 = 0
  | Sigma f (Suc n) = Sigma f n + f n

theorem Sigma_plus
  fixes f :: nat => nat, g :: nat => nat, n :: nat
  prop Sigma (%x. f x + g x) n = Sigma f n + Sigma g n
proof
  ← induct n nat_induct goal=0
    #[1] Sigma (λx. f x + g x) 0 = Sigma f 0 + Sigma g 0
    #[2] ∀n. Sigma (λx. f x + g x) n = Sigma f n + Sigma g n ⟶ Sigma (λx. f x + g x) (Suc n) = Sigma f (Suc n) + Sigma g (Suc n)
  ← rewrite Sigma_def_1 sym=false goal=1
    #[3] (0::nat) = 0 + 0
  ← rewrite add_0_right sym=false goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] Sigma (λx. f x + g x) n = Sigma f n + Sigma g n
    #[6] Sigma (λx. f x + g x) (Suc n) = Sigma f (Suc n) + Sigma g (Suc n)
  ← rewrite Sigma_def_2 sym=false goal=6
    #[7] Sigma (λx. f x + g x) n + (f n + g n) = Sigma f n + f n + (Sigma g n + g n)
  ← rewrite source=prev goal=7 facts=[5]
    #[8] Sigma f n + Sigma g n + (f n + g n) = Sigma f n + f n + (Sigma g n + g n)
  nat_norm goal=8
    #[9] Sigma f n + Sigma g n + (f n + g n) = Sigma f n + f n + (Sigma g n + g n)
qed

const less_eq :: 'a ⇒ 'a ⇒ bool overloaded

const less :: 'a ⇒ 'a ⇒ bool overloaded

def greater_eq :: 'a ⇒ 'a ⇒ bool = m ≥ n ⟷ n ≤ m [hint_rewrite]

def greater :: 'a ⇒ 'a ⇒ bool = m > n ⟷ n < m [hint_rewrite]

fun less_eq :: nat ⇒ nat ⇒ bool
  | m ≤ 0 ⟷ m = 0
  | m ≤ Suc n ⟷ m = Suc n ∨ m ≤ n

fun less :: nat ⇒ nat ⇒ bool
  | m < 0 ⟷ false
  | m < Suc n ⟷ m = n ∨ m < n

theorem lesseq_Suc_less
  fixes m :: nat, n :: nat
  prop Suc m <= n <--> m < n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] Suc m ≤ 0 ⟷ m < 0
    #[2] ∀n. Suc m ≤ n ⟷ m < n ⟶ Suc m ≤ Suc n ⟷ m < Suc n
  ← rewrite nat_less_def_1 goal=1
    #[3] Suc m ≤ 0 ⟷ false
  ← rewrite nat_less_eq_def_1 goal=3
    #[4] Suc m = 0 ⟷ false
  ← rule iffI goal=4
    #[5] Suc m = 0 ⟶ false
    #[6] false ⟶ Suc m = 0
  ← intro goal=5
    #[7] Suc m = 0
    #[8] false
  ← rule contrapositive goal=8 facts=[7]
    #[9] ¬false ⟶ ¬(Suc m = 0)
  ← intro goal=9
    #[10] ¬false
    #[11] ¬(Suc m = 0)
  ← rewrite eq_sym_eq sym=false goal=11
    #[12] ¬(0 = Suc m)
  ← rule nat_zero_Suc_neq goal=12
    #[13] ¬(0 = Suc m)
  ← intro goal=6
    #[14] false
    #[15] Suc m = 0
  ← resolve not_false_res goal=15 facts=[14]
  ← intro n goal=2
    #[16] _VAR n
    #[17] Suc m ≤ n ⟷ m < n
    #[18] Suc m ≤ Suc n ⟷ m < Suc n
  ← rewrite nat_less_def_2 sym=false goal=18
    #[19] Suc m ≤ Suc n ⟷ m = n ∨ m < n
  ← rewrite nat_less_eq_def_2 sym=false goal=19
    #[20] Suc m = Suc n ∨ Suc m ≤ n ⟷ m = n ∨ m < n
  ← rule iffI goal=20
    #[21] Suc m = Suc n ∨ Suc m ≤ n ⟶ m = n ∨ m < n
    #[22] m = n ∨ m < n ⟶ Suc m = Suc n ∨ Suc m ≤ n
  ← intro goal=21
    #[23] Suc m = Suc n ∨ Suc m ≤ n
    #[24] m = n ∨ m < n
  ← rule disjE goal=24 facts=[23]
    #[25] Suc m = Suc n ⟶ m = n ∨ m < n
    #[26] Suc m ≤ n ⟶ m = n ∨ m < n
  ← intro goal=25
    #[27] Suc m = Suc n
    #[28] m = n ∨ m < n
  ← rule disjI1 goal=28
    #[29] m = n
  ← rule nat_Suc_inject goal=29
  ← intro goal=26
    #[30] Suc m ≤ n
    #[31] m = n ∨ m < n
  ← rule disjI2 goal=31
    #[32] m < n
  → rewrite target=fact source=prev goal=32 facts=[17,30]
    #[33] m < n
  ← intro goal=22
    #[34] m = n ∨ m < n
    #[35] Suc m = Suc n ∨ Suc m ≤ n
  ← rule disjE goal=35 facts=[34]
    #[36] m = n ⟶ Suc m = Suc n ∨ Suc m ≤ n
    #[37] m < n ⟶ Suc m = Suc n ∨ Suc m ≤ n
  ← intro goal=36
    #[38] m = n
    #[39] Suc m = Suc n ∨ Suc m ≤ n
  ← rule disjI1 goal=39
    #[40] Suc m = Suc n
  ← rewrite source=prev goal=40 facts=[38]
    #[41] Suc m = Suc n
  ← intro goal=37
    #[42] m < n
    #[43] Suc m = Suc n ∨ Suc m ≤ n
  ← rule disjI2 goal=43
    #[44] Suc m ≤ n
  ← rewrite source=prev goal=44 facts=[17]
qed

theorem less_Suc_lesseq
  fixes m :: nat, n :: nat
  prop m < Suc n <--> m <= n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] m < Suc 0 ⟷ m ≤ 0
    #[2] ∀n. m < Suc n ⟷ m ≤ n ⟶ m < Suc (Suc n) ⟷ m ≤ Suc n
  ← rewrite nat_less_eq_def_1 goal=1
    #[3] m < Suc 0 ⟷ m = 0
  ← rewrite nat_less_def_2 goal=3
    #[4] m = 0 ∨ m < 0 ⟷ m = 0
  ← rewrite nat_less_def_1 goal=4
    #[5] m = 0 ∨ false ⟷ m = 0
  ← rule iffI goal=5
    #[6] m = 0 ∨ false ⟶ m = 0
    #[7] m = 0 ⟶ m = 0 ∨ false
  ← intro goal=6
    #[8] m = 0 ∨ false
    #[9] m = 0
  ← rule disjE goal=9 facts=[8]
    #[10] m = 0 ⟶ m = 0
    #[11] false ⟶ m = 0
  ← intro goal=11
    #[12] false
    #[13] m = 0
  ← resolve not_false_res goal=13 facts=[12]
    #[14] m = 0
  ← intro goal=7
    #[15] m = 0
    #[16] m = 0 ∨ false
  ← rule disjI1 goal=16
  ← intro n goal=2
    #[17] _VAR n
    #[18] m < Suc n ⟷ m ≤ n
    #[19] m < Suc (Suc n) ⟷ m ≤ Suc n
  ← rewrite nat_less_def_2 sym=false goal=19
    #[20] m = Suc n ∨ m < Suc n ⟷ m ≤ Suc n
  ← rule iffI goal=20
    #[21] m = Suc n ∨ m < Suc n ⟶ m ≤ Suc n
    #[22] m ≤ Suc n ⟶ m = Suc n ∨ m < Suc n
  ← intro goal=21
    #[23] m = Suc n ∨ m < Suc n
    #[24] m ≤ Suc n
  ← rule disjE goal=24 facts=[23]
    #[25] m = Suc n ⟶ m ≤ Suc n
    #[26] m < Suc n ⟶ m ≤ Suc n
  ← intro goal=25
    #[27] m = Suc n
    #[28] m ≤ Suc n
  ← rewrite nat_less_eq_def_2 sym=false goal=28
    #[29] m = Suc n ∨ m ≤ n
  ← rule disjI1 goal=29
  ← rewrite source=prev goal=26 facts=[18]
    #[30] m ≤ n ⟶ m ≤ Suc n
  ← intro goal=30
    #[31] m ≤ n
    #[32] m ≤ Suc n
  ← rewrite nat_less_eq_def_2 sym=false goal=32
    #[33] m = Suc n ∨ m ≤ n
  ← rule disjI2 goal=33
  ← rewrite nat_less_eq_def_2 sym=false goal=22
    #[34] m = Suc n ∨ m ≤ n ⟶ m = Suc n ∨ m < Suc n
  ← rewrite source=prev goal=34 facts=[18]
    #[35] m = Suc n ∨ m ≤ n ⟶ m = Suc n ∨ m ≤ n
qed

theorem le_suc
  fixes m :: nat, n :: nat
  prop Suc m <= Suc n <--> m <= n
  [hint_rewrite]
proof
  ← rewrite lesseq_Suc_less sym=false goal=0
    #[1] m < Suc n ⟷ m ≤ n
  ← rewrite less_Suc_lesseq sym=false goal=1
qed

theorem lt_suc
  fixes m :: nat, n :: nat
  prop Suc m < Suc n <--> m < n
  [hint_rewrite]
proof
  ← rewrite less_Suc_lesseq sym=false goal=0
    #[1] Suc m ≤ n ⟷ m < n
  ← rewrite lesseq_Suc_less sym=false goal=1
qed

theorem lt_imp_le
  fixes m :: nat, n :: nat
  prop m < n --> m <= n
  [hint_backward,hint_forward]
proof
  ← induct n nat_induct goal=0
    #[3] m < 0 ⟶ m ≤ 0
    #[4] ∀n. (m < n ⟶ m ≤ n) ⟶ m < Suc n ⟶ m ≤ Suc n
  ← intro goal=3
    #[5] m < 0
    #[6] m ≤ 0
  → rewrite target=fact nat_less_def_1 sym=false goal=6 facts=[5]
    #[7] false
  ← resolve not_false_res goal=6 facts=[7]
  ← intro n goal=4
    #[8] _VAR n
    #[9] m < n ⟶ m ≤ n
    #[10] m < Suc n
    #[11] m ≤ Suc n
  → rewrite target=fact less_Suc_lesseq sym=false goal=11 facts=[10]
    #[12] m ≤ n
  ← rewrite nat_less_eq_def_2 sym=false goal=11
    #[13] m = Suc n ∨ m ≤ n
  ← rule disjI2 goal=13
qed

theorem le_1_1
  fixes n :: nat
  prop ~(n = 0) --> 0 < n
  [hint_backward,hint_forward]
proof
  ← induct n nat_induct goal=0
    #[1] ~((0::nat) = 0) --> (0::nat) < 0
    #[2] !n. (~(n = 0) --> 0 < n) --> ~(Suc n = 0) --> 0 < Suc n
  ← intro goal=1
    #[3] ~((0::nat) = 0)
    #[4] (0::nat) < 0
  ← rule negE_gen goal=4 facts=[3]
    #[5] (0::nat) = 0
  ← rule eq_refl goal=5
    #[6] (0::nat) = 0
  ← intro n goal=2
    #[7] _VAR n
    #[8] ~(n = 0) --> 0 < n
    #[9] ~(Suc n = 0)
    #[10] 0 < Suc n
  ← rewrite less_Suc_lesseq sym=false goal=10
    #[11] 0 <= n
  ← cases "n = 0" goal=11
    #[12] n = 0 --> 0 <= n
    #[13] ~(n = 0) --> 0 <= n
  ← intro goal=12
    #[14] n = 0
    #[15] 0 <= n
  ← rewrite source=prev goal=15 facts=[14]
    #[16] (0::nat) <= 0
  ← rewrite nat_less_eq_def_1 sym=false goal=16
    #[17] (0::nat) <= 0
  ← intro goal=13
    #[18] ~(n = 0)
    #[19] 0 <= n
  ← rule lt_imp_le goal=19
    #[20] 0 < n
  ← apply_prev goal=20 facts=[8,18]
    #[21] 0 < n
qed

theorem le_1_2
  fixes n :: nat
  prop ~(n = 0) --> 1 <= n
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 1 ≤ n
  ← rewrite nat_one_def sym=false goal=2
    #[3] Suc 0 ≤ n
  ← rewrite lesseq_Suc_less sym=false goal=3
    #[4] 0 < n
  ← rule le_1_1 goal=4
qed

theorem less_eq_exist
  fixes m :: nat, n :: nat
  prop m <= n <--> (?p. n = m + p)
  [hint_rewrite]
proof
  cut "m <= m" goal=0
    #[1] m <= m
  ← induct m nat_induct goal=1
    #[2] (0::nat) <= 0
    #[3] !n. n <= n --> Suc n <= Suc n
  ← rewrite nat_less_eq_def_1 sym=false goal=2
  ← intro n goal=3
    #[4] _VAR n
    #[5] n <= n
    #[6] Suc n <= Suc n
  ← rewrite nat_less_eq_def_2 sym=false goal=6
    #[7] Suc n = Suc n | Suc n <= n
  ← rule disjI1 goal=7
    #[8] Suc n = Suc n
  ← refl goal=8
    #[9] Suc n = Suc n
  ← rule iffI goal=0
    #[10] m <= n --> (?p. n = m + p)
    #[11] (?p. n = m + p) --> m <= n
  ← induct n nat_induct goal=10
    #[12] m <= 0 --> (?p. 0 = m + p)
    #[13] !n. (m <= n --> (?p. n = m + p)) --> m <= Suc n --> (?p. Suc n = m + p)
  ← rewrite nat_less_eq_def_1 sym=false goal=12
    #[14] m = 0 --> (?p. 0 = m + p)
  ← intro goal=14
    #[15] m = 0
    #[16] ?p. 0 = m + p
  ← inst "(0::nat)" goal=16
    #[17] 0 = m + 0
  ← rewrite add_0_right sym=false goal=17
    #[18] 0 = m
  ← rewrite source=prev goal=18 facts=[15]
  ← intro n goal=13
    #[19] m <= n --> (?p. n = m + p)
    #[20] m <= Suc n
    #[21] ?p. Suc n = m + p
  → rewrite nat_less_eq_def_2 sym=false target=fact goal=21 facts=[20]
    #[22] m = Suc n | m <= n
  ← rule disjE goal=21 facts=[22]
    #[23] m = Suc n --> (?p. Suc n = m + p)
    #[24] m <= n --> (?p. Suc n = m + p)
  ← intro goal=23
    #[25] m = Suc n
    #[26] ?p. Suc n = m + p
  ← inst "(0::nat)" goal=26
    #[27] Suc n = m + 0
  ← rewrite add_0_right sym=false goal=27
    #[28] Suc n = m
  ← rewrite source=prev goal=28 facts=[25]
    #[29] Suc n = m
  ← intro goal=24
    #[30] m <= n
    #[31] ?p. Suc n = m + p
  → forward goal=31 facts=[19,30]
    #[32] ?p. n = m + p
  elim p goal=31 facts=[32]
    #[33] _VAR p
    #[34] n = m + p
    #[35] ?p. Suc n = m + p
  ← inst "Suc p" goal=35
    #[36] Suc n = m + Suc p
  ← rewrite add_Suc_right sym=false goal=36
    #[37] Suc n = Suc (m + p)
  ← rewrite source=prev goal=37 facts=[34]
    #[38] Suc n = Suc (m + p)
  ← intro goal=11
    #[39] ?p. n = m + p
    #[40] m <= n
  elim p goal=40 facts=[39]
    #[41] m <= n
  ← rewrite source=prev goal=41 facts=[34]
    #[42] m <= m + p
  ← induct p nat_induct goal=42
    #[43] m <= m + 0
    #[44] !n. m <= m + n --> m <= m + Suc n
  ← rewrite add_0_right sym=false goal=43
  ← intro q goal=44
    #[45] _VAR q
    #[46] m <= m + q
    #[47] m <= m + Suc q
  ← rewrite add_Suc_right sym=false goal=47
    #[48] m <= Suc (m + q)
  ← rewrite nat_less_eq_def_2 sym=false goal=48
    #[49] m = Suc (m + q) | m <= m + q
  ← rule disjI2 goal=49
qed

theorem less_exist
  fixes m :: nat, n :: nat
  prop m < n <--> (?d. n = m + Suc d)
  [hint_rewrite]
proof
  cut "m <= m" goal=0
    #[1] m <= m
  ← induct m nat_induct goal=1
    #[2] (0::nat) <= 0
    #[3] !n. n <= n --> Suc n <= Suc n
  ← rewrite nat_less_eq_def_1 sym=false goal=2
  ← intro n goal=3
    #[4] _VAR n
    #[5] n <= n
    #[6] Suc n <= Suc n
  ← rewrite nat_less_eq_def_2 sym=false goal=6
    #[7] Suc n = Suc n | Suc n <= n
  ← rule disjI1 goal=7
    #[8] Suc n = Suc n
  ← refl goal=8
    #[9] Suc n = Suc n
  ← rule iffI goal=0
    #[10] m < n --> (?d. n = m + Suc d)
    #[11] (?d. n = m + Suc d) --> m < n
  ← induct n nat_induct goal=10
    #[12] m < 0 --> (?d. 0 = m + Suc d)
    #[13] !n. (m < n --> (?d. n = m + Suc d)) --> m < Suc n --> (?d. Suc n = m + Suc d)
  ← rewrite nat_less_def_1 sym=false goal=12
    #[14] false --> (?d. 0 = m + Suc d)
  ← intro goal=14
    #[15] false
    #[16] ?d. 0 = m + Suc d
  ← rule falseE goal=16 facts=[15]
  ← intro k goal=13
    #[17] _VAR k
    #[18] m < k --> (?d. k = m + Suc d)
    #[19] m < Suc k
    #[20] ?d. Suc k = m + Suc d
  → rewrite less_Suc_lesseq sym=false target=fact goal=20 facts=[19]
    #[21] m <= k
  → rewrite less_eq_exist sym=false target=fact goal=20 facts=[21]
    #[22] ?p. k = m + p
  elim p goal=20 facts=[22]
    #[23] _VAR p
    #[24] k = m + p
    #[25] ?d. Suc k = m + Suc d
  ← rewrite add_Suc_right sym=false goal=25
    #[26] ?d. Suc k = Suc (m + d)
  ← inst p goal=26
    #[27] Suc k = Suc (m + p)
  ← rewrite source=prev goal=27 facts=[24]
    #[28] Suc k = Suc (m + p)
  ← intro goal=11
    #[29] ?d. n = m + Suc d
    #[30] m < n
  elim d goal=30 facts=[29]
    #[31] _VAR d
    #[32] n = m + Suc d
    #[33] m < n
  ← rewrite source=prev goal=33 facts=[32]
    #[34] m < m + Suc d
  ← rewrite add_Suc_right sym=false goal=34
    #[35] m < Suc (m + d)
  ← rewrite less_Suc_lesseq sym=false goal=35
    #[36] m <= m + d
  ← induct d nat_induct goal=36
    #[37] m <= m + 0
    #[38] !n. m <= m + n --> m <= m + Suc n
  ← rewrite add_0_right sym=false goal=37
  ← intro q goal=38
    #[39] _VAR q
    #[40] m <= m + q
    #[41] m <= m + Suc q
  ← rewrite add_Suc_right sym=false goal=41
    #[42] m <= Suc (m + q)
  ← rewrite nat_less_eq_def_2 sym=false goal=42
    #[43] m = Suc (m + q) | m <= m + q
  ← rule disjI2 goal=43
qed

theorem less_lesseqI
  fixes m :: nat, n :: nat
  prop m <= n --> ~(m = n) --> m < n
proof
  ← type_cases n goal=0
    #[1] m <= 0 --> ~(m = 0) --> m < 0
    #[2] !n. m <= Suc n --> ~(m = Suc n) --> m < Suc n
  ← intro goal=1
    #[3] m <= 0
    #[4] ~(m = 0)
    #[5] m < 0
  → rewrite nat_less_eq_def_1 sym=false target=fact goal=5 facts=[3]
    #[6] m = 0
  ← rewrite nat_less_def_1 sym=false goal=5
    #[7] false
  ← rule negE_gen goal=7 facts=[4,6]
  ← intro k goal=2
    #[8] _VAR k
    #[9] m <= Suc k
    #[10] ~(m = Suc k)
    #[11] m < Suc k
  → rewrite nat_less_eq_def_2 sym=false target=fact goal=11 facts=[9]
    #[12] m = Suc k | m <= k
  ← rule disjE goal=11 facts=[12]
    #[13] m = Suc k --> m < Suc k
    #[14] m <= k --> m < Suc k
  ← intro goal=13
    #[15] m = Suc k
    #[16] m < Suc k
  ← rule negE_gen goal=16 facts=[10,15]
    #[17] m < Suc k
  ← intro goal=14
    #[18] m <= k
    #[19] m < Suc k
  → rewrite less_Suc_lesseq sym=true target=fact goal=19 facts=[18]
    #[20] m < Suc k
qed

theorem less_lesseq
  fixes m :: nat, n :: nat
  prop m < n <--> m <= n & ~(m = n)
proof
  ← rule iffI goal=0
    #[1] m < n --> m <= n & ~(m = n)
    #[2] m <= n & ~(m = n) --> m < n
  ← intro goal=1
    #[3] m < n
    #[4] m <= n & ~(m = n)
  ← rule conjI goal=4
    #[5] m <= n
    #[6] ~(m = n)
  ← rule lt_imp_le goal=5 facts=[3]
  ← rule negI goal=6
    #[7] m = n --> false
  ← intro goal=7
    #[8] m = n
    #[9] false
  → rewrite less_exist sym=false target=fact goal=9 facts=[3]
    #[10] ?d. n = m + Suc d
  elim d goal=9 facts=[10]
    #[11] _VAR d
    #[12] n = m + Suc d
    #[13] false
  → rewrite source=prev target=fact goal=13 facts=[8,12]
    #[14] n = n + Suc d
  → rewrite eq_sym_eq sym=false target=fact goal=13 facts=[14]
    #[15] n + Suc d = n
  → forward add_right_eq_zero goal=13 facts=[15]
    #[16] Suc d = 0
  → rewrite eq_sym_eq sym=false target=fact goal=13 facts=[16]
    #[17] 0 = Suc d
  → forward nat_zero_Suc_neq param_n=d goal=13
    #[18] ~(0 = Suc d)
  ← rule negE_gen goal=13 facts=[18,17]
    #[19] false
  ← intro goal=2
    #[20] m <= n & ~(m = n)
    #[21] m < n
  → forward conjD1 goal=21 facts=[20]
    #[22] m <= n
  → forward conjD2 goal=21 facts=[20]
    #[23] ~(m = n)
  ← rule less_lesseqI goal=21 facts=[22,23]
qed

theorem le_0
  fixes n :: nat
  prop 0 <= n
  [hint_resolve,hint_rewrite,hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] (0::nat) ≤ 0
    #[2] ∀n. 0 ≤ n ⟶ 0 ≤ Suc n
  ← rewrite nat_less_eq_def_1 goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] 0 ≤ n
    #[5] 0 ≤ Suc n
  ← rewrite nat_less_eq_def_2 goal=5
    #[6] 0 = Suc n ∨ 0 ≤ n
  ← rule disjI2 goal=6
qed

theorem less_0
  fixes n :: nat
  prop 0 < Suc n
proof
  ← rewrite less_Suc_lesseq sym=false goal=0
    #[1] 0 ≤ n
  ← rule le_0 goal=1
qed

theorem less_eq_refl
  fixes n :: nat
  prop n <= n
  [hint_backward]
proof
  ← rewrite less_eq_exist goal=0
    #[1] ∃p. n = n + p
  ← inst "(0::nat)" goal=1
    #[2] n = n + 0
  nat_norm goal=2
qed

theorem Suc_Pre
  fixes n :: nat
  prop 0 < n --> Suc (Pre n) = n
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[3] (0::nat) < 0 ⟶ Suc (Pre 0) = 0
    #[4] ∀n. (0 < n ⟶ Suc (Pre n) = n) ⟶ 0 < Suc n ⟶ Suc (Pre (Suc n)) = Suc n
  ← intro goal=3
    #[5] (0::nat) < 0
    #[6] Suc (Pre 0) = 0
  → rewrite target=fact nat_less_def_1 sym=false goal=6 facts=[5]
    #[7] false
  ← resolve not_false_res goal=6 facts=[7]
  ← intro n goal=4
    #[8] _VAR n
    #[9] 0 < n ⟶ Suc (Pre n) = n
    #[10] 0 < Suc n
    #[11] Suc (Pre (Suc n)) = Suc n
  ← rewrite Pre_def_2 sym=false goal=11
    #[12] Suc (Pre (Suc n)) = Suc n
qed

theorem le_Pre
  fixes m :: nat, n :: nat
  prop 0 < n --> Pre m <= Pre n <--> m <= n
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < n
    #[2] Pre m ≤ Pre n ⟷ m ≤ n
  ← induct m nat_induct goal=2
    #[3] Pre 0 ≤ Pre n ⟷ 0 ≤ n
    #[4] ∀n1. Pre n1 ≤ Pre n ⟷ n1 ≤ n ⟶ Pre (Suc n1) ≤ Pre n ⟷ Suc n1 ≤ n
  ← rewrite Pre_def_1 sym=false goal=3
    #[5] 0 ≤ Pre n ⟷ 0 ≤ n
  ← rule iffI goal=5
    #[6] 0 ≤ Pre n ⟶ 0 ≤ n
    #[7] 0 ≤ n ⟶ 0 ≤ Pre n
  ← intro goal=6
    #[8] 0 ≤ Pre n
    #[9] 0 ≤ n
  ← rule le_0 goal=9
    #[10] 0 ≤ n
  ← intro goal=7
    #[11] 0 ≤ n
    #[12] 0 ≤ Pre n
  ← rule le_0 goal=12
    #[13] 0 ≤ Pre n
  ← intro m goal=4
    #[14] _VAR m
    #[15] Pre m ≤ Pre n ⟷ m ≤ n
    #[16] Pre (Suc m) ≤ Pre n ⟷ Suc m ≤ n
  → forward Suc_Pre goal=16 facts=[1]
    #[17] Suc (Pre n) = n
  ← rewrite Pre_def_2 sym=false goal=16
    #[18] m ≤ Pre n ⟷ Suc m ≤ n
  → forward le_suc param_m=m param_n="Pre n" goal=18
    #[19] Suc m ≤ Suc (Pre n) ⟷ m ≤ Pre n
  → rewrite target=fact source=prev goal=18 facts=[17,19]
    #[20] Suc m ≤ n ⟷ m ≤ Pre n
  ← rewrite eq_sym_eq sym=false goal=18
qed

theorem le_antisym
  fixes m :: nat, n :: nat
  prop m <= n & n <= m <--> m = n
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] m <= n & n <= m --> m = n
    #[2] m = n --> m <= n & n <= m
  ← intro goal=1
    #[3] m <= n & n <= m
    #[4] m = n
  → forward conjD1 goal=4 facts=[3]
    #[5] m <= n
  → forward conjD2 goal=4 facts=[3]
    #[6] n <= m
  → rewrite less_eq_exist sym=false target=fact goal=4 facts=[5]
    #[7] ?p. n = m + p
  elim p goal=4 facts=[7]
    #[8] _VAR p
    #[9] n = m + p
    #[10] m = n
  → rewrite less_eq_exist sym=false target=fact goal=10 facts=[6]
    #[11] ?p. m = n + p
  elim q goal=10 facts=[11]
    #[12] _VAR q
    #[13] m = n + q
    #[14] m = n
  → rewrite source=prev target=fact goal=14 facts=[9,13]
    #[15] m = m + p + q
  → rewrite add_assoc sym=false target=fact goal=14 facts=[15]
    #[16] m = m + (p + q)
  → rewrite eq_sym_eq sym=false target=fact goal=14 facts=[16]
    #[17] m + (p + q) = m
  → forward add_right_eq_zero goal=14 facts=[17]
    #[18] p + q = 0
  → forward add_is_zero goal=14 facts=[18]
    #[19] p = 0 & q = 0
  → forward conjD1 goal=14 facts=[19]
    #[20] p = 0
  ← rewrite source=prev goal=14 facts=[9]
    #[21] m = m + p
  ← rewrite source=prev goal=21 facts=[20]
    #[22] m = m + 0
  ← rewrite add_0_right sym=false goal=22
    #[23] m = m + 0
  ← intro goal=2
    #[24] m = n
    #[25] m <= n & n <= m
  ← rule conjI goal=25
    #[26] m <= n
    #[27] n <= m
  ← rewrite source=prev goal=26 facts=[24]
    #[28] n <= n
  ← rule less_eq_refl goal=28
    #[29] n <= n
  ← rewrite source=prev goal=27 facts=[24]
qed

theorem lt_antisym
  fixes m :: nat, n :: nat
  prop ~(m < n & n < m)
  [hint_backward]
proof
  ← rule negI goal=0
    #[1] m < n & n < m --> false
  ← intro goal=1
    #[2] m < n & n < m
    #[3] false
  → forward conjD1 goal=3 facts=[2]
    #[4] m < n
  → forward conjD2 goal=3 facts=[2]
    #[5] n < m
  → forward lt_imp_le goal=3 facts=[4]
    #[6] m <= n
  → forward lt_imp_le goal=3 facts=[5]
    #[7] n <= m
  → forward conjI goal=3 facts=[6,7]
    #[8] m <= n & n <= m
  → rewrite le_antisym sym=false target=fact goal=3 facts=[8]
    #[9] m = n
  → rewrite less_lesseq sym=false target=fact goal=3 facts=[4]
    #[10] m <= n & ~(m = n)
  → forward conjD2 goal=3 facts=[10]
    #[11] ~(m = n)
  ← rule negE_gen goal=3 facts=[11,9]
qed

theorem let_antisym
  fixes m :: nat, n :: nat
  prop ~(m <= n & n < m)
  [hint_backward]
proof
  ← rule negI goal=0
    #[1] m <= n & n < m --> false
  ← intro goal=1
    #[2] m <= n & n < m
    #[3] false
  → forward conjD1 goal=3 facts=[2]
    #[4] m <= n
  → forward conjD2 goal=3 facts=[2]
    #[5] n < m
  → forward lt_imp_le goal=3 facts=[5]
    #[6] n <= m
  → forward conjI goal=3 facts=[4,6]
    #[7] m <= n & n <= m
  → rewrite le_antisym sym=false target=fact goal=3 facts=[7]
    #[8] m = n
  → rewrite less_lesseq sym=false target=fact goal=3 facts=[5]
    #[9] n <= m & ~(n = m)
  → forward conjD2 goal=3 facts=[9]
    #[10] ~(n = m)
  → rewrite eq_sym_eq sym=false target=fact goal=3 facts=[8]
    #[11] n = m
  ← rule negE_gen goal=3 facts=[10,11]
qed

theorem Pre_inj
  fixes m :: nat, n :: nat
  prop 0 < m --> 0 < n --> Pre m = Pre n <--> m = n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < m
    #[2] 0 < n
    #[3] Pre m = Pre n ⟷ m = n
  ← rewrite le_antisym sym=true goal=3
    #[4] Pre m ≤ Pre n ∧ Pre n ≤ Pre m ⟷ m ≤ n ∧ n ≤ m
  → forward le_Pre param_m=n goal=4 facts=[1]
    #[5] Pre n ≤ Pre m ⟷ n ≤ m
  → forward le_Pre param_m=m goal=4 facts=[2]
    #[6] Pre m ≤ Pre n ⟷ m ≤ n
  ← rule iffI goal=4
    #[7] Pre m ≤ Pre n ∧ Pre n ≤ Pre m ⟶ m ≤ n ∧ n ≤ m
    #[8] m ≤ n ∧ n ≤ m ⟶ Pre m ≤ Pre n ∧ Pre n ≤ Pre m
  ← intro goal=7
    #[9] Pre m ≤ Pre n ∧ Pre n ≤ Pre m
    #[10] m ≤ n ∧ n ≤ m
  → forward conjD1 goal=10 facts=[9]
    #[11] Pre m ≤ Pre n
  → forward conjD2 goal=10 facts=[9]
    #[12] Pre n ≤ Pre m
  ← rule conjI goal=10
    #[13] m ≤ n
    #[14] n ≤ m
  → rewrite target=fact source=prev goal=13 facts=[6,11]
    #[15] m ≤ n
  → rewrite target=fact source=prev goal=14 facts=[5,12]
    #[16] n ≤ m
  ← intro goal=8
    #[17] m ≤ n ∧ n ≤ m
    #[18] Pre m ≤ Pre n ∧ Pre n ≤ Pre m
  → forward conjD1 goal=18 facts=[17]
    #[19] m ≤ n
  → forward conjD2 goal=18 facts=[17]
    #[20] n ≤ m
  ← rule conjI goal=18
    #[21] Pre m ≤ Pre n
    #[22] Pre n ≤ Pre m
  ← rewrite source=prev goal=21 facts=[6]
  ← rewrite source=prev goal=22 facts=[5]
qed

theorem less_eq_trans
  fixes k :: nat, m :: nat, n :: nat
  prop k <= m --> m <= n --> k <= n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] k ≤ m
    #[2] m ≤ n
    #[3] k ≤ n
  → rewrite target=fact less_eq_exist goal=3 facts=[1]
    #[4] ∃p. m = k + p
  → rewrite target=fact less_eq_exist goal=3 facts=[2]
    #[5] ∃p. n = m + p
  elim p goal=3 facts=[4]
    #[6] _VAR p
    #[7] m = k + p
    #[8] k ≤ n
  elim q goal=8 facts=[5]
    #[9] _VAR q
    #[10] n = m + q
    #[11] k ≤ n
  ← rewrite less_eq_exist goal=11
    #[12] ∃p. n = k + p
  ← inst "p + q" goal=12
    #[13] n = k + (p + q)
  ← rewrite source=prev goal=13 facts=[10]
    #[14] m + q = k + (p + q)
  ← rewrite source=prev goal=14 facts=[7]
    #[15] k + p + q = k + (p + q)
  nat_norm goal=15
    #[16] k + p + q = k + (p + q)
qed

theorem lt_trans
  fixes k :: nat, m :: nat, n :: nat
  prop k < m --> m < n --> k < n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] k < m
    #[2] m < n
    #[3] k < n
  → rewrite less_exist sym=false target=fact goal=3 facts=[1]
    #[4] ?d. m = k + Suc d
  elim a goal=3 facts=[4]
    #[5] _VAR a
    #[6] m = k + Suc a
    #[7] k < n
  → rewrite less_exist sym=false target=fact goal=7 facts=[2]
    #[8] ?d. n = m + Suc d
  elim b goal=7 facts=[8]
    #[9] _VAR b
    #[10] n = m + Suc b
    #[11] k < n
  cut "?d. n = k + Suc d" goal=11
    #[12] ?d. n = k + Suc d
  ← inst "a + Suc b" goal=12
    #[13] n = k + Suc (a + Suc b)
  ← rewrite source=prev goal=13 facts=[10]
    #[14] m + Suc b = k + Suc (a + Suc b)
  ← rewrite source=prev goal=14 facts=[6]
    #[15] k + Suc a + Suc b = k + Suc (a + Suc b)
  nat_norm goal=15
    #[16] k + Suc a + Suc b = k + Suc (a + Suc b)
  → rewrite less_exist sym=true target=fact goal=11 facts=[12]
qed

theorem let_trans
  fixes k :: nat, m :: nat, n :: nat
  prop k <= m --> m < n --> k < n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] k <= m
    #[2] m < n
    #[3] k < n
  → rewrite less_eq_exist sym=false target=fact goal=3 facts=[1]
    #[4] ?p. m = k + p
  elim p goal=3 facts=[4]
    #[5] _VAR p
    #[6] m = k + p
    #[7] k < n
  → rewrite less_exist sym=false target=fact goal=7 facts=[2]
    #[8] ?d. n = m + Suc d
  elim d goal=7 facts=[8]
    #[9] _VAR d
    #[10] n = m + Suc d
    #[11] k < n
  cut "?e. n = k + Suc e" goal=11
    #[12] ?e. n = k + Suc e
  ← inst "p + d" goal=12
    #[13] n = k + Suc (p + d)
  ← rewrite source=prev goal=13 facts=[10]
    #[14] m + Suc d = k + Suc (p + d)
  ← rewrite source=prev goal=14 facts=[6]
    #[15] k + p + Suc d = k + Suc (p + d)
  nat_norm goal=15
    #[16] k + p + Suc d = k + Suc (p + d)
  → rewrite less_exist sym=true target=fact goal=11 facts=[12]
qed

theorem lte_trans
  fixes k :: nat, m :: nat, n :: nat
  prop k < m --> m <= n --> k < n
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] k < m
    #[2] m <= n
    #[3] k < n
  → rewrite less_exist sym=false target=fact goal=3 facts=[1]
    #[4] ?d. m = k + Suc d
  elim a goal=3 facts=[4]
    #[5] _VAR a
    #[6] m = k + Suc a
    #[7] k < n
  → rewrite less_eq_exist sym=false target=fact goal=7 facts=[2]
    #[8] ?p. n = m + p
  elim p goal=7 facts=[8]
    #[9] _VAR p
    #[10] n = m + p
    #[11] k < n
  cut "?e. n = k + Suc e" goal=11
    #[12] ?e. n = k + Suc e
  ← inst "a + p" goal=12
    #[13] n = k + Suc (a + p)
  ← rewrite source=prev goal=13 facts=[10]
    #[14] m + p = k + Suc (a + p)
  ← rewrite source=prev goal=14 facts=[6]
    #[15] k + Suc a + p = k + Suc (a + p)
  nat_norm goal=15
    #[16] k + Suc a + p = k + Suc (a + p)
  → rewrite less_exist sym=true target=fact goal=11 facts=[12]
qed

theorem le_lt
  fixes m :: nat, n :: nat
  prop m <= n <--> m < n | m = n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] m ≤ 0 ⟷ m < 0 ∨ m = 0
    #[2] ∀n. m ≤ n ⟷ m < n ∨ m = n ⟶ m ≤ Suc n ⟷ m < Suc n ∨ m = Suc n
  ← rewrite nat_less_eq_def_1 sym=false goal=1
    #[3] m = 0 ⟷ m < 0 ∨ m = 0
  ← rule iffI goal=3
    #[4] m = 0 ⟶ m < 0 ∨ m = 0
    #[5] m < 0 ∨ m = 0 ⟶ m = 0
  ← intro goal=4
    #[6] m = 0
    #[7] m < 0 ∨ m = 0
  ← rule disjI2 goal=7
  ← intro goal=5
    #[8] m < 0 ∨ m = 0
    #[9] m = 0
  ← rule disjE goal=9 facts=[8]
    #[10] m < 0 ⟶ m = 0
    #[11] m = 0 ⟶ m = 0
  ← intro goal=10
    #[12] m < 0
    #[13] m = 0
  → rewrite target=fact nat_less_def_1 sym=false goal=13 facts=[12]
    #[14] false
  ← resolve not_false_res goal=13 facts=[14]
    #[15] m = 0
  ← intro n goal=2
    #[16] _VAR n
    #[17] m ≤ n ⟷ m < n ∨ m = n
    #[18] m ≤ Suc n ⟷ m < Suc n ∨ m = Suc n
  ← rewrite nat_less_eq_def_2 sym=false goal=18
    #[19] m = Suc n ∨ m ≤ n ⟷ m < Suc n ∨ m = Suc n
  ← rewrite source=prev goal=19 facts=[17]
    #[20] m = Suc n ∨ m < n ∨ m = n ⟷ m < Suc n ∨ m = Suc n
  ← rule iffI goal=20
    #[21] m = Suc n ∨ m < n ∨ m = n ⟶ m < Suc n ∨ m = Suc n
    #[22] m < Suc n ∨ m = Suc n ⟶ m = Suc n ∨ m < n ∨ m = n
  ← intro goal=21
    #[23] m = Suc n ∨ m < n ∨ m = n
    #[24] m < Suc n ∨ m = Suc n
  ← rule disjE goal=24 facts=[23]
    #[25] m = Suc n ⟶ m < Suc n ∨ m = Suc n
    #[26] m < n ∨ m = n ⟶ m < Suc n ∨ m = Suc n
  ← intro goal=25
    #[27] m = Suc n
    #[28] m < Suc n ∨ m = Suc n
  ← rule disjI2 goal=28
  ← intro goal=26
    #[29] m < n ∨ m = n
    #[30] m < Suc n ∨ m = Suc n
  ← rule disjI1 goal=30
    #[31] m < Suc n
  ← rewrite nat_less_def_2 sym=false goal=31
    #[32] m = n ∨ m < n
  ← rewrite disj_comm sym=false goal=32
  ← intro goal=22
    #[33] m < Suc n ∨ m = Suc n
    #[34] m = Suc n ∨ m < n ∨ m = n
  ← rule disjE goal=34 facts=[33]
    #[35] m < Suc n ⟶ m = Suc n ∨ m < n ∨ m = n
    #[36] m = Suc n ⟶ m = Suc n ∨ m < n ∨ m = n
  ← intro goal=35
    #[37] m < Suc n
    #[38] m = Suc n ∨ m < n ∨ m = n
  ← rule disjI2 goal=38
    #[39] m < n ∨ m = n
  → rewrite target=fact nat_less_def_2 sym=false goal=39 facts=[37]
    #[40] m = n ∨ m < n
  ← rewrite disj_comm sym=false goal=39
  ← intro goal=36
    #[41] m = Suc n ∨ m < n ∨ m = n
  ← rule disjI1 goal=41
qed

theorem not_le
  fixes m :: nat, n :: nat
  prop ~(m <= n) <--> n < m
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] ~(m <= n) --> n < m
    #[2] n < m --> ~(m <= n)
  ← induct n nat_induct goal=1
    #[3] ~(m <= 0) --> 0 < m
    #[4] !n. (~(m <= n) --> n < m) --> ~(m <= Suc n) --> Suc n < m
  ← rewrite nat_less_eq_def_1 sym=false goal=3
    #[5] ~(m = 0) --> 0 < m
  ← intro goal=5
    #[6] ~(m = 0)
    #[7] 0 < m
  ← rule le_1_1 goal=7 facts=[6]
  ← type_cases m goal=4
    #[8] !n. (~(0 <= n) --> n < 0) --> ~(0 <= Suc n) --> Suc n < 0
    #[9] !n. !n1. (~(Suc n <= n1) --> n1 < Suc n) --> ~(Suc n <= Suc n1) --> Suc n1 < Suc n
  ← intro k goal=8
    #[10] _VAR k
    #[11] ~(0 <= k) --> k < 0
    #[12] ~(0 <= Suc k)
    #[13] Suc k < 0
  ← rewrite nat_less_def_1 sym=false goal=13
    #[14] false
  → forward le_0 param_n=k goal=14
    #[15] 0 <= k
  → forward le_0 param_n="Suc k" goal=14
    #[16] 0 <= Suc k
  ← rule negE_gen goal=14 facts=[12,16]
    #[17] false
  ← intro u,v goal=9
    #[18] _VAR u
    #[19] _VAR v
    #[20] ~(Suc u <= v) --> v < Suc u
    #[21] ~(Suc u <= Suc v)
    #[22] Suc v < Suc u
  ← rewrite less_Suc_lesseq sym=false goal=22
    #[23] Suc v <= u
  ← rewrite lesseq_Suc_less sym=false goal=23
    #[24] v < u
  → rewrite nat_less_eq_def_2 sym=false target=fact goal=24 facts=[21]
    #[25] ~(Suc u = Suc v | Suc u <= v)
  → rewrite de_morgan_thm2 sym=false target=fact goal=24 facts=[25]
    #[26] ~(Suc u = Suc v) & ~(Suc u <= v)
  → forward conjD2 goal=24 facts=[26]
    #[27] ~(Suc u <= v)
  → forward goal=24 facts=[20,27]
    #[28] v < Suc u
  → rewrite less_Suc_lesseq sym=false target=fact goal=24 facts=[28]
    #[29] v <= u
  → forward conjD1 goal=24 facts=[26]
    #[30] ~(Suc u = Suc v)
  ← cases "v = u" goal=24
    #[31] v = u --> v < u
    #[32] ~(v = u) --> v < u
  ← intro goal=31
    #[33] v = u
    #[34] v < u
  ← rewrite source=prev goal=34 facts=[33]
    #[35] u < u
  → rewrite source=prev target=fact goal=35 facts=[33,21]
    #[36] ~(Suc u <= Suc u)
  → forward less_eq_refl param_n="Suc u" goal=35
    #[37] Suc u <= Suc u
  ← rule negE_gen goal=35 facts=[36,37]
    #[38] u < u
  ← intro goal=32
    #[39] ~(v = u)
    #[40] v < u
  ← rule less_lesseqI goal=40 facts=[29,39]
  ← intro goal=2
    #[41] n < m
    #[42] ~(m <= n)
  ← rule negI goal=42
    #[43] m <= n --> false
  ← intro goal=43
    #[44] m <= n
    #[45] false
  → forward lt_imp_le goal=45 facts=[41]
    #[46] n <= m
  → forward conjI goal=45 facts=[44,46]
    #[47] m <= n & n <= m
  → rewrite le_antisym sym=false target=fact goal=45 facts=[47]
    #[48] m = n
  → rewrite less_lesseq sym=false target=fact goal=45 facts=[41]
    #[49] n <= m & ~(n = m)
  → forward conjD2 goal=45 facts=[49]
    #[50] ~(n = m)
  → rewrite eq_sym_eq sym=false target=fact goal=45 facts=[48]
    #[51] n = m
  ← rule negE_gen goal=45 facts=[50,51]
qed

theorem not_lt
  fixes m :: nat, n :: nat
  prop ~(m < n) <--> n <= m
  [hint_rewrite]
proof
  ← rewrite not_le sym=true goal=0
    #[1] ¬¬(n ≤ m) ⟷ n ≤ m
  ← rewrite double_neg sym=false goal=1
qed

theorem eq_mult_lcancel
  fixes m :: nat, n :: nat, p :: nat
  prop m * n = m * p <--> m = 0 | n = p
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] m * n = m * p --> m = 0 | n = p
    #[2] m = 0 | n = p --> m * n = m * p
  ← type_cases m goal=1
    #[3] 0 * n = 0 * p --> (0::nat) = 0 | n = p
    #[4] !n1. Suc n1 * n = Suc n1 * p --> Suc n1 = 0 | n = p
  ← intro goal=3
    #[5] 0 * n = 0 * p
    #[6] (0::nat) = 0 | n = p
  ← rule disjI1 goal=6
    #[7] (0::nat) = 0
  ← refl goal=7
    #[8] (0::nat) = 0
  ← intro k goal=4
    #[9] _VAR k
    #[10] Suc k * n = Suc k * p
    #[11] Suc k = 0 | n = p
  ← cases "n <= p" goal=11
    #[12] n <= p --> Suc k = 0 | n = p
    #[13] ~(n <= p) --> Suc k = 0 | n = p
  ← intro goal=12
    #[14] n <= p
    #[15] Suc k = 0 | n = p
  ← rule disjI2 goal=15
    #[16] n = p
  → rewrite less_eq_exist sym=false target=fact goal=16 facts=[14]
    #[17] ?p1. p = n + p1
  elim d goal=16 facts=[17]
    #[18] _VAR d
    #[19] p = n + d
    #[20] n = p
    #[21] Suc k = 0 | n = p
  → rewrite source=prev target=fact goal=20 facts=[19,10]
    #[22] Suc k * n = Suc k * (n + d)
  → rewrite distrib_l sym=false target=fact goal=20 facts=[22]
    #[23] Suc k * n = Suc k * n + Suc k * d
  → rewrite eq_sym_eq sym=false target=fact goal=20 facts=[23]
    #[24] Suc k * n + Suc k * d = Suc k * n
  → forward add_right_eq_zero goal=20 facts=[24]
    #[25] Suc k * d = 0
  → rewrite mult_eq_0 sym=false target=fact goal=20 facts=[25]
    #[26] Suc k = 0 | d = 0
  ← rule disjE goal=20 facts=[26]
    #[27] Suc k = 0 --> n = p
    #[28] d = 0 --> n = p
  ← intro goal=27
    #[29] Suc k = 0
    #[30] n = p
  → rewrite eq_sym_eq sym=false target=fact goal=30 facts=[29]
    #[31] 0 = Suc k
  → forward nat_zero_Suc_neq param_n=k goal=30
    #[32] ~(0 = Suc k)
  ← rule negE_gen goal=30 facts=[32,31]
    #[33] n = p
  ← intro goal=28
    #[34] d = 0
    #[35] n = p
  → rewrite source=prev target=fact goal=35 facts=[34,19]
    #[36] p = n + 0
  → rewrite add_0_right sym=false target=fact goal=35 facts=[36]
    #[37] p = n
  → rewrite eq_sym_eq sym=false target=fact goal=35 facts=[37]
    #[38] n = p
  ← intro goal=13
    #[39] ~(n <= p)
    #[40] Suc k = 0 | n = p
  → rewrite not_le sym=false target=fact goal=40 facts=[39]
    #[41] p < n
  → rewrite less_exist sym=false target=fact goal=40 facts=[41]
    #[42] ?d. n = p + Suc d
  elim d goal=40 facts=[42]
    #[43] n = p + Suc d
    #[44] Suc k = 0 | n = p
  → rewrite source=prev target=fact goal=44 facts=[43,10]
    #[45] Suc k * (p + Suc d) = Suc k * p
  → rewrite distrib_l sym=false target=fact goal=44 facts=[45]
    #[46] Suc k * p + Suc k * Suc d = Suc k * p
  → forward add_right_eq_zero goal=44 facts=[46]
    #[47] Suc k * Suc d = 0
  → rewrite mult_eq_0 sym=false target=fact goal=44 facts=[47]
    #[48] Suc k = 0 | Suc d = 0
  ← rule disjE goal=44 facts=[48]
    #[49] Suc k = 0 --> Suc k = 0 | n = p
    #[50] Suc d = 0 --> Suc k = 0 | n = p
  ← intro goal=49
    #[51] Suc k = 0 | n = p
  ← intro goal=50
    #[52] Suc d = 0
    #[53] Suc k = 0 | n = p
  ← rule disjI1 goal=51
  → rewrite eq_sym_eq sym=false target=fact goal=53 facts=[52]
    #[54] 0 = Suc d
  → forward nat_zero_Suc_neq param_n=d goal=53
    #[55] ~(0 = Suc d)
  ← rule negE_gen goal=53 facts=[55,54]
    #[56] Suc k = 0 | n = p
  ← intro goal=2
    #[57] m = 0 | n = p
    #[58] m * n = m * p
  ← rule disjE goal=58 facts=[57]
    #[59] m = 0 --> m * n = m * p
    #[60] n = p --> m * n = m * p
  ← intro goal=59
    #[61] m = 0
    #[62] m * n = m * p
  ← rewrite source=prev goal=62 facts=[61]
    #[63] 0 * n = 0 * p
  ← rewrite nat_times_def_1 sym=false goal=63
    #[64] 0 * n = 0 * p
  ← intro goal=60
    #[65] n = p
    #[66] m * n = m * p
  ← rewrite source=prev goal=66 facts=[65]
    #[67] m * n = m * p
qed

theorem eq_mult_rcancel
  fixes m :: nat, n :: nat, p :: nat
  prop n * m = p * m <--> m = 0 | n = p
  [hint_rewrite]
proof
  ← rewrite mult_comm sym=false goal=0
    #[1] m * n = m * p ⟷ m = 0 ∨ n = p
  ← rewrite eq_mult_lcancel sym=false goal=1
qed

theorem le_add
  fixes m :: nat, n :: nat
  prop m <= m + n
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] m ≤ m + 0
    #[2] ∀n. m ≤ m + n ⟶ m ≤ m + Suc n
  ← rewrite add_0_right sym=false goal=1
    #[3] m ≤ m
  ← rule less_eq_refl goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] m ≤ m + n
    #[6] m ≤ m + Suc n
  ← rewrite add_comm sym=false goal=6
    #[7] m ≤ Suc n + m
  ← rewrite nat_plus_def_2 sym=false goal=7
    #[8] m ≤ Suc (n + m)
  ← rewrite nat_less_eq_def_2 sym=false goal=8
    #[9] m = Suc (n + m) ∨ m ≤ n + m
  ← rule disjI2 goal=9
    #[10] m ≤ n + m
  ← rewrite add_comm sym=false goal=10
qed

theorem lt_add
  fixes m :: nat, n :: nat
  prop m < m + n <--> 0 < n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct m nat_induct goal=0
    #[1] 0 < 0 + n ⟷ 0 < n
    #[2] ∀n1. n1 < n1 + n ⟷ 0 < n ⟶ Suc n1 < Suc n1 + n ⟷ 0 < n
  ← rewrite nat_plus_def_1 sym=false goal=1
  ← intro m goal=2
    #[3] _VAR m
    #[4] m < m + n ⟷ 0 < n
    #[5] Suc m < Suc m + n ⟷ 0 < n
  ← rewrite nat_plus_def_2 sym=false goal=5
    #[6] Suc m < Suc (m + n) ⟷ 0 < n
  → rewrite target=fact eq_sym_eq sym=false goal=6 facts=[4]
    #[7] 0 < n ⟷ m < m + n
  ← rewrite source=prev goal=6 facts=[7]
    #[8] Suc m < Suc (m + n) ⟷ m < m + n
  ← rewrite less_Suc_lesseq sym=false goal=8
    #[9] Suc m ≤ m + n ⟷ m < m + n
  ← rewrite lesseq_Suc_less sym=false goal=9
    #[10] Suc m ≤ m + n ⟷ m < m + n
qed

theorem le_add_lcancel
  fixes m :: nat, n :: nat, p :: nat
  prop m + n <= m + p <--> n <= p
  [hint_rewrite]
proof
  ← rewrite less_eq_exist sym=false goal=0
    #[1] (∃p1. m + p = m + n + p1) ⟷ (∃p1. p = n + p1)
  ← rule iffI goal=1
    #[2] (∃p1. m + p = m + n + p1) ⟶ (∃p1. p = n + p1)
    #[3] (∃p1. p = n + p1) ⟶ (∃p1. m + p = m + n + p1)
  ← intro goal=2
    #[4] ∃p1. m + p = m + n + p1
    #[5] ∃p1. p = n + p1
  elim d goal=5 facts=[4]
    #[6] _VAR d
    #[7] m + p = m + n + d
    #[8] ∃p1. p = n + p1
  ← inst d goal=8
    #[9] p = n + d
  → rewrite target=fact add_assoc sym=false goal=9 facts=[7]
    #[10] m + p = m + (n + d)
  ← rule add_cancel_left goal=9 facts=[10]
    #[11] p = n + d
  ← intro goal=3
    #[12] ∃p1. p = n + p1
    #[13] ∃p1. m + p = m + n + p1
  elim d goal=13 facts=[12]
    #[14] p = n + d
    #[15] ∃p1. m + p = m + n + p1
  ← inst d goal=15
    #[16] m + p = m + n + d
  ← rewrite source=prev goal=16 facts=[14]
    #[17] m + (n + d) = m + n + d
  ← rewrite add_assoc sym=false goal=17
    #[18] m + (n + d) = m + n + d
qed

theorem lt_add_lcancel
  fixes m :: nat, n :: nat, p :: nat
  prop m + n < m + p <--> n < p
  [hint_rewrite]
proof
  ← rewrite less_exist sym=false goal=0
    #[1] (∃d. m + p = m + n + Suc d) ⟷ (∃d. p = n + Suc d)
  ← rule iffI goal=1
    #[2] (∃d. m + p = m + n + Suc d) ⟶ (∃d. p = n + Suc d)
    #[3] (∃d. p = n + Suc d) ⟶ (∃d. m + p = m + n + Suc d)
  ← intro goal=2
    #[4] ∃d. m + p = m + n + Suc d
    #[5] ∃d. p = n + Suc d
  elim d goal=5 facts=[4]
    #[6] _VAR d
    #[7] m + p = m + n + Suc d
    #[8] ∃d. p = n + Suc d
  ← inst d goal=8
    #[9] p = n + Suc d
  → rewrite target=fact add_assoc sym=false goal=9 facts=[7]
    #[10] m + p = m + (n + Suc d)
  ← rule add_cancel_left goal=9 facts=[10]
    #[11] p = n + Suc d
  ← intro goal=3
    #[12] ∃d. p = n + Suc d
    #[13] ∃d. m + p = m + n + Suc d
  elim d goal=13 facts=[12]
    #[14] p = n + Suc d
    #[15] ∃d. m + p = m + n + Suc d
  ← inst d goal=15
    #[16] m + p = m + n + Suc d
  ← rewrite source=prev goal=16 facts=[14]
    #[17] m + (n + Suc d) = m + n + Suc d
  ← rewrite add_assoc sym=false goal=17
    #[18] m + (n + Suc d) = m + n + Suc d
qed

theorem le_add2
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop m <= p --> n <= q --> m + n <= p + q
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m ≤ p
    #[2] n ≤ q
    #[3] m + n ≤ p + q
  → rewrite target=fact less_eq_exist sym=false goal=3 facts=[1]
    #[4] ∃p1. p = m + p1
  → rewrite target=fact less_eq_exist sym=false goal=3 facts=[2]
    #[5] ∃p. q = n + p
  elim a goal=3 facts=[4]
    #[6] _VAR a
    #[7] p = m + a
    #[8] m + n ≤ p + q
  elim b goal=8 facts=[5]
    #[9] _VAR b
    #[10] q = n + b
    #[11] m + n ≤ p + q
  ← rewrite less_eq_exist sym=false goal=11
    #[12] ∃p1. p + q = m + n + p1
  ← inst a+b goal=12
    #[13] p + q = m + n + (a + b)
  ← rewrite source=prev goal=13 facts=[7]
    #[14] m + a + q = m + n + (a + b)
  ← rewrite source=prev goal=14 facts=[10]
    #[15] m + a + (n + b) = m + n + (a + b)
  nat_norm goal=15
    #[16] m + a + (n + b) = m + n + (a + b)
qed

theorem let_add2
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop m <= p --> n < q --> m + n < p + q
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m ≤ p
    #[2] n < q
    #[3] m + n < p + q
  → rewrite target=fact less_eq_exist sym=false goal=3 facts=[1]
    #[4] ∃p1. p = m + p1
  → rewrite target=fact less_exist sym=false goal=3 facts=[2]
    #[5] ∃d. q = n + Suc d
  elim a goal=3 facts=[4]
    #[6] _VAR a
    #[7] p = m + a
    #[8] m + n < p + q
  elim b goal=8 facts=[5]
    #[9] _VAR b
    #[10] q = n + Suc b
    #[11] m + n < p + q
  ← rewrite less_exist sym=false goal=11
    #[12] ∃d. p + q = m + n + Suc d
  ← inst a+b goal=12
    #[13] p + q = m + n + Suc (a + b)
  ← rewrite source=prev goal=13 facts=[7]
    #[14] m + a + q = m + n + Suc (a + b)
  ← rewrite source=prev goal=14 facts=[10]
    #[15] m + a + (n + Suc b) = m + n + Suc (a + b)
  nat_norm goal=15
    #[16] m + a + (n + Suc b) = m + n + Suc (a + b)
qed

theorem lt_add2
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop m < p --> n < q --> m + n < p + q
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m < p
    #[2] n < q
    #[3] m + n < p + q
  ← rule let_add2 goal=3
    #[4] m ≤ p
  ← rule lt_imp_le goal=4
qed

theorem le_cases
  fixes m :: nat, n :: nat
  prop m <= n | n <= m
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] m ≤ 0 ∨ 0 ≤ m
    #[2] ∀n. m ≤ n ∨ n ≤ m ⟶ m ≤ Suc n ∨ Suc n ≤ m
  ← rule disjI2 goal=1
    #[3] 0 ≤ m
  ← rule le_0 goal=3
  ← induct m nat_induct goal=2
    #[4] ∀n. 0 ≤ n ∨ n ≤ 0 ⟶ 0 ≤ Suc n ∨ Suc n ≤ 0
    #[5] ∀n. (∀n1. n ≤ n1 ∨ n1 ≤ n ⟶ n ≤ Suc n1 ∨ Suc n1 ≤ n) ⟶ (∀n1. Suc n ≤ n1 ∨ n1 ≤ Suc n ⟶ Suc n ≤ Suc n1 ∨ Suc n1 ≤ Suc n)
  ← intro n goal=4
    #[6] _VAR n
    #[7] 0 ≤ n ∨ n ≤ 0
    #[8] 0 ≤ Suc n ∨ Suc n ≤ 0
  ← rule disjI1 goal=8
    #[9] 0 ≤ Suc n
  ← rule le_0 goal=9
    #[10] 0 ≤ Suc n
  ← intro n goal=5
    #[11] ∀n1. n ≤ n1 ∨ n1 ≤ n ⟶ n ≤ Suc n1 ∨ Suc n1 ≤ n
    #[12] ∀n1. Suc n ≤ n1 ∨ n1 ≤ Suc n ⟶ Suc n ≤ Suc n1 ∨ Suc n1 ≤ Suc n
  ← intro m goal=12
    #[13] _VAR m
    #[14] Suc n ≤ m ∨ m ≤ Suc n
    #[15] Suc n ≤ Suc m ∨ Suc m ≤ Suc n
  ← rule disjE goal=15 facts=[14]
    #[16] Suc n ≤ m ⟶ Suc n ≤ Suc m ∨ Suc m ≤ Suc n
    #[17] m ≤ Suc n ⟶ Suc n ≤ Suc m ∨ Suc m ≤ Suc n
  ← intro goal=16
    #[18] Suc n ≤ m
    #[19] Suc n ≤ Suc m ∨ Suc m ≤ Suc n
  ← rule disjI1 goal=19
    #[20] Suc n ≤ Suc m
  ← rewrite nat_less_eq_def_2 sym=false goal=20
    #[21] Suc n = Suc m ∨ Suc n ≤ m
  ← rule disjI2 goal=21
  ← intro goal=17
    #[22] m ≤ Suc n
    #[23] Suc n ≤ Suc m ∨ Suc m ≤ Suc n
  → rewrite target=fact nat_less_eq_def_2 sym=false goal=23 facts=[22]
    #[24] m = Suc n ∨ m ≤ n
  ← rule disjE goal=23 facts=[24]
    #[25] m = Suc n ⟶ Suc n ≤ Suc m ∨ Suc m ≤ Suc n
    #[26] m ≤ n ⟶ Suc n ≤ Suc m ∨ Suc m ≤ Suc n
  ← intro goal=25
    #[27] m = Suc n
    #[28] Suc n ≤ Suc m ∨ Suc m ≤ Suc n
  ← rule disjI1 goal=28
    #[29] Suc n ≤ Suc m
  → rewrite target=fact eq_sym_eq sym=false goal=29 facts=[27]
    #[30] Suc n = m
  ← rewrite source=prev goal=29 facts=[30]
    #[31] m ≤ Suc m
  ← rewrite nat_less_eq_def_2 sym=false goal=31
    #[32] m = Suc m ∨ m ≤ m
  ← rule disjI2 goal=32
    #[33] m ≤ m
  ← rule less_eq_refl goal=33
    #[34] m ≤ m
  ← rewrite le_suc sym=false goal=26
    #[35] m ≤ n ⟶ n ≤ m ∨ m ≤ n
  ← intro goal=35
    #[36] m ≤ n
    #[37] n ≤ m ∨ m ≤ n
  ← rule disjI2 goal=37
qed

theorem lt_cases
  fixes m :: nat, n :: nat
  prop m < n | n < m | m = n
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] m < 0 ∨ 0 < m ∨ m = 0
    #[2] ∀n. m < n ∨ n < m ∨ m = n ⟶ m < Suc n ∨ Suc n < m ∨ m = Suc n
  ← rule disjI2 goal=1
    #[3] 0 < m ∨ m = 0
  ← induct m nat_induct goal=3
    #[4] (0::nat) < 0 ∨ (0::nat) = 0
    #[5] ∀n. 0 < n ∨ n = 0 ⟶ 0 < Suc n ∨ Suc n = 0
  ← rule disjI2 goal=4
    #[6] (0::nat) = 0
  ← rule eq_refl goal=6
  ← intro m goal=5
    #[7] _VAR m
    #[8] 0 < m ∨ m = 0
    #[9] 0 < Suc m ∨ Suc m = 0
  ← rewrite nat_less_def_2 sym=false goal=9
    #[10] (0 = m ∨ 0 < m) ∨ Suc m = 0
  ← rule disjI1 goal=10
    #[11] 0 = m ∨ 0 < m
  ← rule disjE goal=11 facts=[8]
    #[12] 0 < m ⟶ 0 = m ∨ 0 < m
    #[13] m = 0 ⟶ 0 = m ∨ 0 < m
  ← intro goal=12
    #[14] 0 < m
    #[15] 0 = m ∨ 0 < m
  ← rule disjI2 goal=15
  ← intro goal=13
    #[16] m = 0
    #[17] 0 = m ∨ 0 < m
  ← rule disjI1 goal=17
    #[18] 0 = m
  ← rewrite eq_sym_eq sym=false goal=18
  ← intro n goal=2
    #[19] _VAR n
    #[20] m < n ∨ n < m ∨ m = n
    #[21] m < Suc n ∨ Suc n < m ∨ m = Suc n
  ← rewrite nat_less_def_2 sym=false goal=21
    #[22] (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
  ← rule disjE goal=22 facts=[20]
    #[23] m < n ⟶ (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
    #[24] n < m ∨ m = n ⟶ (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
  ← intro goal=23
    #[25] m < n
    #[26] (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
  ← rule disjI1 goal=26
    #[27] m = n ∨ m < n
  ← rule disjI2 goal=27
  ← intro goal=24
    #[28] n < m ∨ m = n
    #[29] (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
  ← rule disjE goal=29 facts=[28]
    #[30] n < m ⟶ (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
    #[31] m = n ⟶ (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
  ← intro goal=30
    #[32] n < m
    #[33] (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
  ← rule disjI2 goal=33
    #[34] Suc n < m ∨ m = Suc n
  ← rule contrapositive goal=34 facts=[32]
    #[35] ¬(Suc n < m ∨ m = Suc n) ⟶ ¬(n < m)
  ← rewrite de_morgan_thm2 sym=false goal=35
    #[36] ¬(Suc n < m) ∧ ¬(m = Suc n) ⟶ ¬(n < m)
  ← rewrite not_lt sym=false goal=36
    #[37] m ≤ Suc n ∧ ¬(m = Suc n) ⟶ m ≤ n
  ← intro goal=37
    #[38] m ≤ Suc n ∧ ¬(m = Suc n)
    #[39] m ≤ n
  → forward conjD1 goal=39 facts=[38]
    #[40] m ≤ Suc n
  → rewrite target=fact nat_less_eq_def_2 sym=false goal=39 facts=[40]
    #[41] m = Suc n ∨ m ≤ n
  → forward conjD2 goal=39 facts=[38]
    #[42] ¬(m = Suc n)
  ← rule disjE goal=39 facts=[41]
    #[43] m = Suc n ⟶ m ≤ n
    #[44] m ≤ n ⟶ m ≤ n
  ← intro goal=43
    #[45] m = Suc n
    #[46] m ≤ n
  ← rule negE_gen goal=46 facts=[42,45]
    #[47] m ≤ n
  ← intro goal=31
    #[48] m = n
    #[49] (m = n ∨ m < n) ∨ Suc n < m ∨ m = Suc n
  ← rule disjI1 goal=49
    #[50] m = n ∨ m < n
  ← rule disjI1 goal=50
qed

theorem let_cases
  fixes m :: nat, n :: nat
  prop m <= n | n < m
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] m ≤ 0 ∨ 0 < m
    #[2] ∀n. m ≤ n ∨ n < m ⟶ m ≤ Suc n ∨ Suc n < m
  ← induct m nat_induct goal=1
    #[3] (0::nat) ≤ 0 ∨ (0::nat) < 0
    #[4] ∀n. n ≤ 0 ∨ 0 < n ⟶ Suc n ≤ 0 ∨ 0 < Suc n
  ← rule disjI1 goal=3
    #[5] (0::nat) ≤ 0
  ← rule less_eq_refl goal=5
  ← intro m goal=4
    #[6] _VAR m
    #[7] m ≤ 0 ∨ 0 < m
    #[8] Suc m ≤ 0 ∨ 0 < Suc m
  ← rule disjI2 goal=8
    #[9] 0 < Suc m
  ← rule le_1_1 goal=9
    #[10] ¬(Suc m = 0)
  ← rule ineq_sym goal=10
    #[11] ¬(0 = Suc m)
  ← rule nat_zero_Suc_neq goal=11
    #[12] ¬(0 = Suc m)
  ← intro n goal=2
    #[13] _VAR n
    #[14] m ≤ n ∨ n < m
    #[15] m ≤ Suc n ∨ Suc n < m
  ← rewrite nat_less_eq_def_2 sym=false goal=15
    #[16] (m = Suc n ∨ m ≤ n) ∨ Suc n < m
  ← rule disjE goal=16 facts=[14]
    #[17] m ≤ n ⟶ (m = Suc n ∨ m ≤ n) ∨ Suc n < m
    #[18] n < m ⟶ (m = Suc n ∨ m ≤ n) ∨ Suc n < m
  ← intro goal=17
    #[19] m ≤ n
    #[20] (m = Suc n ∨ m ≤ n) ∨ Suc n < m
  ← rule disjI1 goal=20
    #[21] m = Suc n ∨ m ≤ n
  ← rule disjI2 goal=21
  ← induct m nat_induct goal=18
    #[22] n < 0 ⟶ (0 = Suc n ∨ 0 ≤ n) ∨ Suc n < 0
    #[23] ∀n1. (n < n1 ⟶ (n1 = Suc n ∨ n1 ≤ n) ∨ Suc n < n1) ⟶ n < Suc n1 ⟶ (Suc n1 = Suc n ∨ Suc n1 ≤ n) ∨ Suc n < Suc n1
  ← intro goal=22
    #[24] n < 0
    #[25] (0 = Suc n ∨ 0 ≤ n) ∨ Suc n < 0
  ← rule contrapositive goal=25 facts=[24]
    #[26] ¬((0 = Suc n ∨ 0 ≤ n) ∨ Suc n < 0) ⟶ ¬(n < 0)
  ← intro goal=26
    #[27] ¬((0 = Suc n ∨ 0 ≤ n) ∨ Suc n < 0)
    #[28] ¬(n < 0)
  ← rewrite not_lt sym=false goal=28
    #[29] 0 ≤ n
  ← rule le_0 goal=29
    #[30] 0 ≤ n
  ← intro m1 goal=23
    #[31] _VAR m1
    #[32] n < m1 ⟶ (m1 = Suc n ∨ m1 ≤ n) ∨ Suc n < m1
    #[33] n < Suc m1
    #[34] (Suc m1 = Suc n ∨ Suc m1 ≤ n) ∨ Suc n < Suc m1
  → rewrite target=fact nat_less_def_2 sym=false goal=34 facts=[33]
    #[35] n = m1 ∨ n < m1
  ← rule disjE goal=34 facts=[35]
    #[36] n = m1 ⟶ (Suc m1 = Suc n ∨ Suc m1 ≤ n) ∨ Suc n < Suc m1
    #[37] n < m1 ⟶ (Suc m1 = Suc n ∨ Suc m1 ≤ n) ∨ Suc n < Suc m1
  ← intro goal=36
    #[38] n = m1
    #[39] (Suc m1 = Suc n ∨ Suc m1 ≤ n) ∨ Suc n < Suc m1
  ← rule disjI1 goal=39
    #[40] Suc m1 = Suc n ∨ Suc m1 ≤ n
  ← rule disjI1 goal=40
    #[41] Suc m1 = Suc n
  ← rewrite source=prev goal=41 facts=[38]
    #[42] Suc m1 = Suc n
  ← intro goal=37
    #[43] n < m1
    #[44] (Suc m1 = Suc n ∨ Suc m1 ≤ n) ∨ Suc n < Suc m1
  ← rule disjI2 goal=44
    #[45] Suc n < Suc m1
  ← rewrite lt_suc sym=false goal=45
qed

theorem lt_mult
  fixes m :: nat, n :: nat
  prop 0 < m * n <--> 0 < m & 0 < n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] 0 < m * 0 ⟷ 0 < m ∧ (0::nat) < 0
    #[2] ∀n. 0 < m * n ⟷ 0 < m ∧ 0 < n ⟶ 0 < m * Suc n ⟷ 0 < m ∧ 0 < Suc n
  ← rewrite mult_0_right sym=false goal=1
    #[3] (0::nat) < 0 ⟷ 0 < m ∧ (0::nat) < 0
  ← rule iffI goal=3
    #[4] (0::nat) < 0 ⟶ 0 < m ∧ (0::nat) < 0
    #[5] 0 < m ∧ (0::nat) < 0 ⟶ (0::nat) < 0
  ← intro goal=4
    #[6] (0::nat) < 0
    #[7] 0 < m ∧ (0::nat) < 0
  → rewrite target=fact nat_less_def_1 sym=false goal=7 facts=[6]
    #[8] false
  ← resolve not_false_res goal=7 facts=[8]
  ← intro goal=5
    #[9] 0 < m ∧ (0::nat) < 0
    #[10] (0::nat) < 0
  ← rule conjD2 goal=10 facts=[9]
  ← intro n goal=2
    #[11] _VAR n
    #[12] 0 < m * n ⟷ 0 < m ∧ 0 < n
    #[13] 0 < m * Suc n ⟷ 0 < m ∧ 0 < Suc n
  ← rule iffI goal=13
    #[14] 0 < m * Suc n ⟶ 0 < m ∧ 0 < Suc n
    #[15] 0 < m ∧ 0 < Suc n ⟶ 0 < m * Suc n
  ← intro goal=14
    #[16] 0 < m * Suc n
    #[17] 0 < m ∧ 0 < Suc n
  ← rule conjI goal=17
    #[18] 0 < m
    #[19] 0 < Suc n
  ← rule le_1_1 goal=18
    #[20] ¬(m = 0)
  ← rule contrapositive goal=20 facts=[16]
    #[21] ¬¬(m = 0) ⟶ ¬(0 < m * Suc n)
  ← intro goal=21
    #[22] ¬¬(m = 0)
    #[23] ¬(0 < m * Suc n)
  → rewrite target=fact double_neg sym=false goal=23 facts=[22]
    #[24] m = 0
  ← rewrite source=prev goal=23 facts=[24]
    #[25] ¬(0 < 0 * Suc n)
  ← rewrite nat_times_def_1 sym=false goal=25
    #[26] ¬((0::nat) < 0)
  ← rewrite nat_less_def_1 sym=false goal=26
    #[27] ¬false
  ← rule negI goal=27
    #[28] false ⟶ false
  ← rewrite less_Suc_lesseq sym=false goal=19
    #[29] 0 ≤ n
  ← rule le_0 goal=29
    #[30] 0 ≤ n
  ← intro goal=15
    #[31] 0 < m ∧ 0 < Suc n
    #[32] 0 < m * Suc n
  ← rule le_1_1 goal=32
    #[33] ¬(m * Suc n = 0)
  ← rule contrapositive goal=33 facts=[31]
    #[34] ¬¬(m * Suc n = 0) ⟶ ¬(0 < m ∧ 0 < Suc n)
  ← intro goal=34
    #[35] ¬¬(m * Suc n = 0)
    #[36] ¬(0 < m ∧ 0 < Suc n)
  → rewrite target=fact double_neg sym=false goal=36 facts=[35]
    #[37] m * Suc n = 0
  → forward mult_nonzero goal=36 facts=[37]
    #[38] m = 0 ∨ Suc n = 0
  ← rewrite de_morgan_thm1 sym=false goal=36
    #[39] ¬(0 < m) ∨ ¬(0 < Suc n)
  ← rule disjE goal=39 facts=[38]
    #[40] m = 0 ⟶ ¬(0 < m) ∨ ¬(0 < Suc n)
    #[41] Suc n = 0 ⟶ ¬(0 < m) ∨ ¬(0 < Suc n)
  ← intro goal=40
    #[42] m = 0
    #[43] ¬(0 < m) ∨ ¬(0 < Suc n)
  ← rule disjI1 goal=43
    #[44] ¬(0 < m)
  ← rewrite source=prev goal=44 facts=[42]
    #[45] ¬((0::nat) < 0)
  ← rewrite nat_less_def_1 sym=false goal=45
    #[46] ¬false
  ← rule negI goal=46
  ← intro goal=41
    #[47] Suc n = 0
    #[48] ¬(0 < m) ∨ ¬(0 < Suc n)
  ← rule disjI2 goal=48
    #[49] ¬(0 < Suc n)
  ← rewrite source=prev goal=49 facts=[47]
    #[50] ¬((0::nat) < 0)
  ← rewrite nat_less_def_1 sym=false goal=50
    #[51] ¬false
  ← rule negI goal=51
qed

theorem le_mult2
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop m <= n --> p <= q --> m * p <= n * q
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] p ≤ q
    #[3] m * p ≤ n * q
  → rewrite target=fact less_eq_exist sym=false goal=3 facts=[1]
    #[4] ∃p. n = m + p
  → rewrite target=fact less_eq_exist sym=false goal=3 facts=[2]
    #[5] ∃p1. q = p + p1
  elim a goal=3 facts=[4]
    #[6] _VAR a
    #[7] n = m + a
    #[8] m * p ≤ n * q
  elim b goal=8 facts=[5]
    #[9] _VAR b
    #[10] q = p + b
    #[11] m * p ≤ n * q
  ← rewrite less_eq_exist sym=false goal=11
    #[12] ∃p1. n * q = m * p + p1
  ← inst "a * p + m * b + a * b" goal=12
    #[13] n * q = m * p + (a * p + m * b + a * b)
  ← rewrite source=prev goal=13 facts=[7]
    #[14] (m + a) * q = m * p + (a * p + m * b + a * b)
  ← rewrite source=prev goal=14 facts=[10]
    #[15] (m + a) * (p + b) = m * p + (a * p + m * b + a * b)
  nat_norm goal=15
    #[16] (m + a) * (p + b) = m * p + (a * p + m * b + a * b)
qed

theorem le_mult_rcancel
  fixes m :: nat, n :: nat, p :: nat
  prop m * p <= n * p <--> m <= n | p = 0
  [hint_rewrite]
proof
  ← z3 goal=0
qed

theorem lt_mult_rcancel
  fixes m :: nat, n :: nat, p :: nat
  prop m * p < n * p <--> m < n & ~(p = 0)
  [hint_rewrite]
proof
  ← z3 goal=0
qed

theorem lt_mult2
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop m < n --> p < q --> m * p < n * q
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m < n
    #[2] p < q
    #[3] m * p < n * q
  ← rule let_trans param_m="n * p" goal=3
    #[4] m * p ≤ n * p
    #[5] n * p < n * q
  ← rewrite le_mult_rcancel sym=false goal=4
    #[6] m ≤ n ∨ p = 0
  ← rule disjI1 goal=6
    #[7] m ≤ n
  ← rule lt_imp_le goal=7
  ← rewrite mult_comm sym=false goal=5
    #[8] p * n < q * n
  ← rewrite lt_mult_rcancel sym=false goal=8
    #[9] p < q ∧ ¬(n = 0)
  ← rule conjI goal=9
    #[10] ¬(n = 0)
  ← rule contrapositive goal=10 facts=[1]
    #[11] ¬¬(n = 0) ⟶ ¬(m < n)
  ← intro goal=11
    #[12] ¬¬(n = 0)
    #[13] ¬(m < n)
  → rewrite target=fact double_neg sym=false goal=13 facts=[12]
    #[14] n = 0
  ← rewrite source=prev goal=13 facts=[14]
    #[15] ¬(m < 0)
  ← rewrite nat_less_def_1 sym=false goal=15
    #[16] ¬false
  ← rule negI goal=16
    #[17] false ⟶ false
qed

theorem le_square_refl
  fixes n :: nat
  prop n <= n * n
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] (0::nat) ≤ 0 * 0
    #[2] ∀n. n ≤ n * n ⟶ Suc n ≤ Suc n * Suc n
  ← rule le_0 goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] n ≤ n * n
    #[5] Suc n ≤ Suc n * Suc n
  ← rewrite mult_Suc_right sym=false goal=5
    #[6] Suc n ≤ Suc n + Suc n * n
  ← rule le_add goal=6
    #[7] Suc n ≤ Suc n + Suc n * n
qed

fun minus :: nat ⇒ nat ⇒ nat
  | n - 0 = n
  | n - Suc m = Pre (n - m)

theorem nat_minus_l0
  fixes x :: nat
  prop 0 - x = 0
  [hint_rewrite]
proof
  ← induct x nat_induct goal=0
    #[1] (0::nat) - 0 = 0
    #[2] ∀n. 0 - n = 0 ⟶ 0 - Suc n = 0
  ← rewrite nat_minus_def_1 goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] 0 - n = 0
    #[5] 0 - Suc n = 0
  ← rewrite nat_minus_def_2 goal=5
    #[6] Pre (0 - n) = 0
  ← rewrite source=prev goal=6 facts=[4]
    #[7] Pre 0 = 0
  ← rewrite Pre_def_1 goal=7
    #[8] Pre 0 = 0
qed

theorem nat_minus_presuc
  fixes x :: nat, y :: nat
  prop Pre (Suc x - y) = x - y
proof
  ← induct y nat_induct goal=0
    #[1] Pre (Suc x - 0) = x - 0
    #[2] ∀n. Pre (Suc x - n) = x - n ⟶ Pre (Suc x - Suc n) = x - Suc n
  ← rewrite nat_minus_def_1 goal=1
    #[3] Pre (Suc x) = x
  ← rewrite Pre_def_2 goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] Pre (Suc x - n) = x - n
    #[6] Pre (Suc x - Suc n) = x - Suc n
  ← rewrite nat_minus_def_2 goal=6
    #[7] Pre (Pre (Suc x - n)) = Pre (x - n)
  ← rewrite source=prev goal=7 facts=[5]
qed

theorem nat_minus_suc
  fixes x :: nat, y :: nat
  prop Suc x - Suc y = x - y
  [hint_rewrite]
proof
  ← induct y nat_induct goal=0
    #[1] Suc x - Suc 0 = x - 0
    #[2] !n. Suc x - Suc n = x - n --> Suc x - Suc (Suc n) = x - Suc n
  ← rewrite nat_minus_def_2 sym=false goal=1
    #[3] Pre (Suc x - 0) = x - 0
  ← rewrite nat_minus_def_1 sym=false goal=3
    #[4] Pre (Suc x) = x
  ← rewrite Pre_def_2 sym=false goal=4
  ← intro y goal=2
    #[5] _VAR y
    #[6] Suc x - Suc y = x - y
    #[7] Suc x - Suc (Suc y) = x - Suc y
  ← rewrite nat_minus_def_2 sym=false goal=7
    #[8] Pre (Suc x - Suc y) = Pre (x - y)
  ← rewrite source=prev goal=8 facts=[6]
qed

theorem nat_minus_refl
  fixes x :: nat
  prop x - x = 0
  [hint_rewrite]
proof
  ← induct x nat_induct goal=0
    #[1] (0::nat) - 0 = 0
    #[2] ∀n. n - n = 0 ⟶ Suc n - Suc n = 0
  ← rewrite nat_minus_def_1 goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] n - n = 0
    #[5] Suc n - Suc n = 0
  ← rewrite nat_minus_suc goal=5
qed

theorem nat_plus_minus
  fixes x :: nat, y :: nat
  prop x + y - y = x
  [hint_rewrite]
proof
  ← induct y nat_induct goal=0
    #[1] x + 0 - 0 = x
    #[2] ∀n. x + n - n = x ⟶ x + Suc n - Suc n = x
  ← rewrite add_0_right goal=1
    #[3] x - 0 = x
  ← rewrite nat_minus_def_1 sym=false goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] x + n - n = x
    #[6] x + Suc n - Suc n = x
  ← rewrite add_Suc_right sym="" goal=6
    #[7] Suc (x + n) - Suc n = x
  ← rewrite nat_minus_suc sym="" goal=7
qed

theorem nat_plus_minus_2
  fixes x :: nat, y :: nat
  prop x + y - x = y
  [hint_rewrite]
proof
  ← rewrite add_comm goal=0
    #[1] y + x - x = y
  ← rewrite nat_plus_minus goal=1
qed

theorem sub_eq_0
  fixes x :: nat, y :: nat
  prop x - y = 0 <--> x <= y
  [hint_rewrite_sym,hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] x - y = 0 --> x <= y
    #[2] x <= y --> x - y = 0
  ← intro goal=2
    #[3] x <= y
    #[4] x - y = 0
  → rewrite less_eq_exist sym=false target=fact goal=4 facts=[3]
    #[5] ?p. y = x + p
  elim p goal=4 facts=[5]
    #[6] _VAR p
    #[7] y = x + p
    #[8] x - y = 0
  ← rewrite source=prev goal=8 facts=[7]
    #[9] x - (x + p) = 0
  ← induct p nat_induct goal=9
    #[10] x - (x + 0) = 0
    #[11] !n. x - (x + n) = 0 --> x - (x + Suc n) = 0
  ← rewrite add_0_right sym=false goal=10
    #[12] x - x = 0
  ← rule nat_minus_refl goal=12
    #[13] x - x = 0
  ← intro q goal=11
    #[14] _VAR q
    #[15] x - (x + q) = 0
    #[16] x - (x + Suc q) = 0
  ← rewrite add_Suc_right sym=false goal=16
    #[17] x - Suc (x + q) = 0
  ← rewrite nat_minus_def_2 sym=false goal=17
    #[18] Pre (x - (x + q)) = 0
  ← rewrite source=prev goal=18 facts=[15]
    #[19] Pre 0 = 0
  ← rewrite Pre_def_1 sym=false goal=19
    #[20] Pre 0 = 0
  ← intro goal=1
    #[21] x - y = 0
    #[22] x <= y
  ← cases "x <= y" goal=22
    #[23] x <= y --> x <= y
    #[24] ~(x <= y) --> x <= y
  ← intro goal=24
    #[25] ~(x <= y)
    #[26] x <= y
  → rewrite not_le sym=false target=fact goal=26 facts=[25]
    #[27] y < x
  → rewrite less_exist sym=false target=fact goal=26 facts=[27]
    #[28] ?d. x = y + Suc d
  elim d goal=26 facts=[28]
    #[29] _VAR d
    #[30] x = y + Suc d
    #[31] x <= y
  → rewrite source=prev target=fact goal=31 facts=[30,21]
    #[32] y + Suc d - y = 0
  → rewrite nat_plus_minus_2 sym=false target=fact goal=31 facts=[32]
    #[33] Suc d = 0
  → rewrite eq_sym_eq sym=false target=fact goal=31 facts=[33]
    #[34] 0 = Suc d
  → forward nat_zero_Suc_neq param_n=d goal=31
    #[35] ~(0 = Suc d)
  ← rule negE_gen goal=31 facts=[35,34]
    #[36] x <= y
qed

theorem add_subr2
  fixes x :: nat, y :: nat
  prop x - (x + y) = 0
  [hint_rewrite]
proof
  ← rewrite sub_eq_0 sym=false goal=0
    #[1] x ≤ x + y
  ← rule le_add goal=1
qed

theorem add_subr
  fixes x :: nat, y :: nat
  prop y - (x + y) = 0
  [hint_rewrite]
proof
  ← rewrite add_comm sym=false goal=0
    #[1] y - (y + x) = 0
  ← rewrite add_subr2 sym=false goal=1
qed

theorem sub_add
  fixes x :: nat, y :: nat
  prop y <= x --> x - y + y = x
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] y ≤ x
    #[2] x - y + y = x
  → rewrite target=fact less_eq_exist sym=false goal=2 facts=[1]
    #[3] ∃p. x = y + p
  ← rewrite add_comm sym=false goal=2
    #[4] y + (x - y) = x
  elim p goal=4 facts=[3]
    #[5] _VAR p
    #[6] x = y + p
    #[7] y + (x - y) = x
    #[8] x - y + y = x
  ← rewrite source=prev goal=7 facts=[6]
    #[9] y + (y + p - y) = y + p
  ← rewrite nat_plus_minus_2 sym=false goal=9
    #[10] y + (y + p - y) = y + p
qed

theorem left_sub_distrib
  fixes m :: nat, n :: nat, p :: nat
  prop m * (n - p) = m * n - m * p
  [hint_rewrite]
proof
  ← rewrite eq_sym_eq sym=false goal=0
    #[1] m * n - m * p = m * (n - p)
  → forward le_cases param_m=n param_n=p goal=1
    #[2] n ≤ p ∨ p ≤ n
  ← rule disjE goal=1 facts=[2]
    #[3] n ≤ p ⟶ m * n - m * p = m * (n - p)
    #[4] p ≤ n ⟶ m * n - m * p = m * (n - p)
  ← rewrite sub_eq_0 sym=true goal=3
    #[5] n - p = 0 ⟶ m * n - m * p = m * (n - p)
  ← intro goal=5
    #[6] n - p = 0
    #[7] m * n - m * p = m * (n - p)
  ← z3 goal=7
  ← z3 goal=4
qed

theorem suc_sub1
  fixes n :: nat
  prop Suc n - 1 = n
  [hint_rewrite]
proof
  ← rewrite nat_one_def sym=false goal=0
    #[1] Suc n - Suc 0 = n
  ← rewrite nat_minus_suc sym=false goal=1
    #[2] n - 0 = n
  ← rewrite nat_minus_def_1 sym=false goal=2
qed

theorem nat_le_zero
  fixes n :: nat
  prop n <= 0 --> n = 0
  [hint_forward]
proof
  ← intro goal=0
    #[1] n ≤ 0
    #[2] n = 0
  → rewrite target=fact less_eq_exist sym=false goal=2 facts=[1]
    #[3] ∃p. 0 = n + p
  elim p goal=2 facts=[3]
    #[4] _VAR p
    #[5] 0 = n + p
    #[6] n = 0
  → rewrite target=fact eq_sym_eq sym=false goal=6 facts=[5]
    #[7] n + p = 0
  → forward add_is_zero goal=6 facts=[7]
    #[8] n = 0 ∧ p = 0
  ← rule conjD1 goal=6 facts=[8]
    #[9] n = 0
qed

def max :: 'a ⇒ 'a ⇒ 'a = max m n = (if m ≤ n then n else m) [hint_rewrite]

def min :: 'a ⇒ 'a ⇒ 'a = min m n = (if m ≤ n then m else n) [hint_rewrite]

theorem min_simp1
  fixes m :: nat, n :: nat
  prop m <= n --> min m n = m
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] min m n = m
  ← rewrite min_def goal=2
    #[3] (if m ≤ n then m else n) = m
  ← rewrite if_P sym=false goal=3 facts=[1]
qed

fun even :: nat ⇒ bool
  | even 0 ⟷ true
  | even (Suc n) ⟷ ¬(even n)

fun odd :: nat ⇒ bool
  | odd 0 ⟷ false
  | odd (Suc n) ⟷ ¬(odd n)

theorem not_even
  fixes n :: nat
  prop ~(even n) <--> odd n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct n nat_induct goal=0
    #[1] ¬(even 0) ⟷ odd 0
    #[2] ∀n. ¬(even n) ⟷ odd n ⟶ ¬(even (Suc n)) ⟷ odd (Suc n)
  ← rewrite even_def_1 sym=false goal=1
    #[3] ¬true ⟷ odd 0
  ← rewrite odd_def_1 sym=false goal=3
    #[4] ¬true ⟷ false
  ← z3 goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] ¬(even n) ⟷ odd n
    #[7] ¬(even (Suc n)) ⟷ odd (Suc n)
  ← rewrite even_def_2 sym=false goal=7
    #[8] ¬¬(even n) ⟷ odd (Suc n)
  ← rewrite odd_def_2 sym=false goal=8
    #[9] ¬¬(even n) ⟷ ¬(odd n)
  ← rewrite source=prev goal=9 facts=[6]
qed

theorem not_odd
  fixes n :: nat
  prop ~(odd n) <--> even n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct n nat_induct goal=0
    #[1] ¬(odd 0) ⟷ even 0
    #[2] ∀n. ¬(odd n) ⟷ even n ⟶ ¬(odd (Suc n)) ⟷ even (Suc n)
  ← rewrite odd_def_1 sym=false goal=1
    #[3] ¬false ⟷ even 0
  ← rewrite even_def_1 sym=false goal=3
    #[4] ¬false ⟷ true
  ← z3 goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] ¬(odd n) ⟷ even n
    #[7] ¬(odd (Suc n)) ⟷ even (Suc n)
  ← rewrite even_def_2 sym=false goal=7
    #[8] ¬(odd (Suc n)) ⟷ ¬(even n)
  ← rewrite odd_def_2 sym=false goal=8
    #[9] ¬¬(odd n) ⟷ ¬(even n)
  ← rewrite source=prev goal=9 facts=[6]
qed

theorem even_or_odd
  fixes n :: nat
  prop even n | odd n
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] even 0 ∨ odd 0
    #[2] ∀n. even n ∨ odd n ⟶ even (Suc n) ∨ odd (Suc n)
  ← rule disjI1 goal=1
    #[3] even 0
  ← rewrite even_def_1 sym=false goal=3
    #[4] true
  ← rule trueI goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] even n ∨ odd n
    #[7] even (Suc n) ∨ odd (Suc n)
  ← rule disjE goal=7 facts=[6]
    #[8] even n ⟶ even (Suc n) ∨ odd (Suc n)
    #[9] odd n ⟶ even (Suc n) ∨ odd (Suc n)
  ← intro goal=8
    #[10] even n
    #[11] even (Suc n) ∨ odd (Suc n)
  ← rule disjI2 goal=11
    #[12] odd (Suc n)
  ← rewrite odd_def_2 sym=false goal=12
    #[13] ¬(odd n)
  ← rewrite not_odd sym=false goal=13
  ← intro goal=9
    #[14] odd n
    #[15] even (Suc n) ∨ odd (Suc n)
  ← rule disjI1 goal=15
    #[16] even (Suc n)
  ← rewrite even_def_2 sym=false goal=16
    #[17] ¬(even n)
  ← rewrite not_even sym=false goal=17
qed

theorem even_and_odd
  fixes n :: nat
  prop ~(even n & odd n)
  [hint_backward]
proof
  ← rewrite de_morgan_thm1 sym=false goal=0
    #[1] ¬(even n) ∨ ¬(odd n)
  ← rewrite not_even sym=false goal=1
    #[2] odd n ∨ ¬(odd n)
  ← rewrite not_odd sym=false goal=2
    #[3] odd n ∨ even n
  ← rewrite disj_comm sym=false goal=3
    #[4] even n ∨ odd n
  ← rule even_or_odd goal=4
qed

theorem even_add
  fixes m :: nat, n :: nat
  prop even (m + n) <--> even m <--> even n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] even (m + 0) ⟷ even m ⟷ even 0
    #[2] ∀n. even (m + n) ⟷ even m ⟷ even n ⟶ even (m + Suc n) ⟷ even m ⟷ even (Suc n)
  ← rewrite add_0_right sym=false goal=1
    #[3] even m ⟷ even m ⟷ even 0
  ← rewrite even_def_1 sym=false goal=3
    #[4] even m ⟷ even m ⟷ true
  ← rule iffI goal=4
    #[5] even m ⟶ even m ⟷ true
    #[6] even m ⟷ true ⟶ even m
  ← intro goal=5
    #[7] even m
    #[8] even m ⟷ true
  ← rule iffI goal=8
    #[9] even m ⟶ true
    #[10] true ⟶ even m
  ← intro goal=9
    #[11] true
  ← rule trueI goal=11
    #[12] true
  ← intro goal=10
    #[13] true
  ← intro goal=6
    #[14] even m ⟷ true
    #[15] even m
  ← rewrite source=prev goal=15 facts=[14]
    #[16] true
  ← rule trueI goal=16
  ← intro n goal=2
    #[17] _VAR n
    #[18] even (m + n) ⟷ even m ⟷ even n
    #[19] even (m + Suc n) ⟷ even m ⟷ even (Suc n)
  ← rewrite add_Suc_right sym=false goal=19
    #[20] even (Suc (m + n)) ⟷ even m ⟷ even (Suc n)
  ← rewrite even_def_2 sym=false goal=20
    #[21] ¬(even (m + n)) ⟷ even m ⟷ ¬(even n)
  ← rewrite source=prev goal=21 facts=[18]
    #[22] ¬(even m ⟷ even n) ⟷ even m ⟷ ¬(even n)
  ← rule iffI goal=22
    #[23] ¬(even m ⟷ even n) ⟶ even m ⟷ ¬(even n)
    #[24] even m ⟷ ¬(even n) ⟶ ¬(even m ⟷ even n)
  ← intro goal=23
    #[25] ¬(even m ⟷ even n)
    #[26] even m ⟷ ¬(even n)
  ← rule iffI goal=26
    #[27] even m ⟶ ¬(even n)
    #[28] ¬(even n) ⟶ even m
  ← intro goal=27
    #[29] ¬(even n)
  ← rule contrapositive goal=29 facts=[25]
    #[30] ¬¬(even n) ⟶ ¬¬(even m ⟷ even n)
  ← rewrite double_neg sym=false goal=30
    #[31] even n ⟶ even m ⟷ even n
  ← intro goal=31
    #[32] even n
    #[33] even m ⟷ even n
  ← rule iffI goal=33
    #[34] even m ⟶ even n
    #[35] even n ⟶ even m
  ← intro goal=34
  ← intro goal=35
  ← intro goal=28
    #[36] ¬(even n)
    #[37] even m
  ← rule contrapositive goal=37 facts=[25]
    #[38] ¬(even m) ⟶ ¬¬(even m ⟷ even n)
  ← rewrite double_neg sym=false goal=38
    #[39] ¬(even m) ⟶ even m ⟷ even n
  ← intro goal=39
    #[40] ¬(even m)
    #[41] even m ⟷ even n
  ← rule iffI goal=41
    #[42] even m ⟶ even n
    #[43] even n ⟶ even m
  ← intro goal=42
    #[44] even n
  ← rule negE_gen goal=44 facts=[40,7]
    #[45] even n
  ← intro goal=43
    #[46] even m
  ← rule negE_gen goal=46 facts=[36,32]
    #[47] even m
  ← intro goal=24
    #[48] even m ⟷ ¬(even n)
    #[49] ¬(even m ⟷ even n)
  ← rewrite source=prev goal=49 facts=[48]
    #[50] ¬(¬(even n) ⟷ even n)
  cut "!p. ~(~p <--> p)" goal=50
    #[51] ∀p. ¬(¬p ⟷ p)
  ← z3 goal=51
    #[52] ∀p. ¬(¬p ⟷ p)
  ← apply_prev goal=50 facts=[52]
    #[53] ¬(¬(even n) ⟷ even n)
qed

theorem even_mult
  fixes m :: nat, n :: nat
  prop even (m * n) <--> even m | even n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] even (m * 0) ⟷ even m ∨ even 0
    #[2] ∀n. even (m * n) ⟷ even m ∨ even n ⟶ even (m * Suc n) ⟷ even m ∨ even (Suc n)
  ← rewrite mult_0_right sym=false goal=1
    #[3] even 0 ⟷ even m ∨ even 0
  ← rule iffI goal=3
    #[4] even 0 ⟶ even m ∨ even 0
    #[5] even m ∨ even 0 ⟶ even 0
  ← intro goal=4
    #[6] even 0
    #[7] even m ∨ even 0
  ← rule disjI2 goal=7
  ← rewrite even_def_1 sym=false goal=5
    #[8] even m ∨ true ⟶ true
  cut "∀p. (p ∨ true) ⟷ true" goal=8
    #[9] ∀p. p ∨ true ⟷ true
  ← z3 goal=9
  ← rewrite source=prev goal=8 facts=[9]
    #[10] true ⟶ true
  ← intro n goal=2
    #[11] _VAR n
    #[12] even (m * n) ⟷ even m ∨ even n
    #[13] even (m * Suc n) ⟷ even m ∨ even (Suc n)
  ← rewrite mult_Suc_right sym=false goal=13
    #[14] even (m + m * n) ⟷ even m ∨ even (Suc n)
  ← rewrite even_add sym=false goal=14
    #[15] (even m ⟷ even (m * n)) ⟷ even m ∨ even (Suc n)
  ← rewrite source=prev goal=15 facts=[12]
    #[16] (even m ⟷ even m ∨ even n) ⟷ even m ∨ even (Suc n)
  ← rewrite even_def_2 sym=false goal=16
    #[17] (even m ⟷ even m ∨ even n) ⟷ even m ∨ ¬(even n)
  ← rule iffI goal=17
    #[18] even m ⟷ even m ∨ even n ⟶ even m ∨ ¬(even n)
    #[19] even m ∨ ¬(even n) ⟶ even m ⟷ even m ∨ even n
  ← intro goal=18
    #[20] even m ⟷ even m ∨ even n
    #[21] even m ∨ ¬(even n)
  → forward even_or_odd param_n=m goal=21
    #[22] even m ∨ odd m
  ← rule disjE goal=21 facts=[22]
    #[23] even m ⟶ even m ∨ ¬(even n)
    #[24] odd m ⟶ even m ∨ ¬(even n)
  ← intro goal=23
    #[25] even m
    #[26] even m ∨ ¬(even n)
  ← rule disjI1 goal=26
  ← intro goal=24
    #[27] odd m
    #[28] even m ∨ ¬(even n)
  ← rule disjI2 goal=28
    #[29] ¬(even n)
  ← rule contrapositive goal=29 facts=[20]
    #[30] ¬¬(even n) ⟶ ¬(even m ⟷ even m ∨ even n)
  ← rewrite double_neg sym=false goal=30
    #[31] even n ⟶ ¬(even m ⟷ even m ∨ even n)
  ← intro goal=31
    #[32] even n
    #[33] ¬(even m ⟷ even m ∨ even n)
  → rewrite target=fact not_even sym=true goal=33 facts=[27]
    #[34] ¬(even m)
  cut "!p. !q. p --> ~q --> ~(q <--> q | p)" goal=33
    #[35] ∀p. ∀q. p ⟶ ¬q ⟶ ¬(q ⟷ q ∨ p)
  ← z3 goal=35
    #[36] ∀p. ∀q. p ⟶ ¬q ⟶ ¬(q ⟷ q ∨ p)
  ← apply_prev goal=33 facts=[36]
  ← intro goal=19
    #[37] even m ∨ ¬(even n)
    #[38] even m ⟷ even m ∨ even n
  ← rule iffI goal=38
    #[39] even m ⟶ even m ∨ even n
    #[40] even m ∨ even n ⟶ even m
  ← intro goal=39
    #[41] even m ∨ even n
  ← rule disjI1 goal=41
  ← intro goal=40
    #[42] even m ∨ even n
    #[43] even m
  ← rule disjE goal=43 facts=[37]
    #[44] even m ⟶ even m
    #[45] ¬(even n) ⟶ even m
  ← rule disjE goal=45 facts=[42]
    #[46] even m ⟶ ¬(even n) ⟶ even m
    #[47] even n ⟶ ¬(even n) ⟶ even m
  ← intro goal=47
    #[48] ¬(even n)
    #[49] even m
  ← rule negE_gen goal=49 facts=[48,32]
    #[50] even m
qed

theorem even_exp
  fixes m :: nat, n :: nat
  prop even (m ^ n) <--> even m & ~(n = 0)
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] even (m ^ (0::nat)) ⟷ even m ∧ ¬((0::nat) = 0)
    #[2] ∀n. even (m ^ n) ⟷ even m ∧ ¬(n = 0) ⟶ even (m ^ Suc n) ⟷ even m ∧ ¬(Suc n = 0)
  ← rewrite nat_nat_power_def_1 sym=false goal=1
    #[3] even 1 ⟷ even m ∧ ¬((0::nat) = 0)
  ← rewrite nat_one_def sym=false goal=3
    #[4] even (Suc 0) ⟷ even m ∧ ¬((0::nat) = 0)
  ← rewrite even_def_2 sym=false goal=4
    #[5] ¬(even 0) ⟷ even m ∧ ¬((0::nat) = 0)
  ← rewrite even_def_1 sym=false goal=5
    #[6] ¬true ⟷ even m ∧ ¬((0::nat) = 0)
  cut "∀p. ∀q. q ⟶ ¬true ⟷ p ∧ ~q" goal=6
    #[7] ∀p. ∀q. q ⟶ ¬true ⟷ p ∧ ¬q
  ← z3 goal=7
  ← apply_prev goal=6 facts=[7]
    #[8] (0::nat) = 0
  ← rule eq_refl goal=8
  ← intro n goal=2
    #[9] _VAR n
    #[10] even (m ^ n) ⟷ even m ∧ ¬(n = 0)
    #[11] even (m ^ Suc n) ⟷ even m ∧ ¬(Suc n = 0)
  ← rewrite nat_nat_power_def_2 sym=false goal=11
    #[12] even (m * m ^ n) ⟷ even m ∧ ¬(Suc n = 0)
  ← rewrite even_mult sym=false goal=12
    #[13] even m ∨ even (m ^ n) ⟷ even m ∧ ¬(Suc n = 0)
  ← rewrite source=prev goal=13 facts=[10]
    #[14] even m ∨ even m ∧ ¬(n = 0) ⟷ even m ∧ ¬(Suc n = 0)
  ← rule iffI goal=14
    #[15] even m ∨ even m ∧ ¬(n = 0) ⟶ even m ∧ ¬(Suc n = 0)
    #[16] even m ∧ ¬(Suc n = 0) ⟶ even m ∨ even m ∧ ¬(n = 0)
  ← intro goal=15
    #[17] even m ∨ even m ∧ ¬(n = 0)
    #[18] even m ∧ ¬(Suc n = 0)
  ← rule conjI goal=18
    #[19] even m
    #[20] ¬(Suc n = 0)
  ← rule disjE goal=19 facts=[17]
    #[21] even m ⟶ even m
    #[22] even m ∧ ¬(n = 0) ⟶ even m
  ← intro goal=22
    #[23] even m ∧ ¬(n = 0)
    #[24] even m
  ← rule conjD1 goal=24 facts=[23]
    #[25] even m
  ← rewrite eq_sym_eq sym=false goal=20
    #[26] ¬(0 = Suc n)
  ← rule nat_zero_Suc_neq goal=26
    #[27] ¬(0 = Suc n)
  ← intro goal=16
    #[28] even m ∧ ¬(Suc n = 0)
    #[29] even m ∨ even m ∧ ¬(n = 0)
  → forward conjD1 goal=29 facts=[28]
    #[30] even m
  ← rule disjI1 goal=29
qed

theorem odd_add
  fixes m :: nat, n :: nat
  prop odd (m + n) <--> ~(odd m <--> odd n)
  [hint_rewrite]
proof
  ← rewrite not_even sym=true goal=0
    #[1] ¬(even (m + n)) ⟷ ¬(¬(even m) ⟷ ¬(even n))
  ← rewrite even_add sym=false goal=1
    #[2] ¬(even m ⟷ even n) ⟷ ¬(¬(even m) ⟷ ¬(even n))
  cut "∀p. ∀q. (¬p ⟷ ¬q) ⟷ p ⟷ q" goal=2
    #[3] ∀p. ∀q. (¬p ⟷ ¬q) ⟷ p ⟷ q
  ← z3 goal=3
  ← rewrite source=prev goal=2 facts=[3]
    #[4] (even m ⟷ even n) ⟷ ¬(even m) ⟷ ¬(even n)
  ← rewrite source=prev goal=4 facts=[3]
qed

theorem odd_mult
  fixes m :: nat, n :: nat
  prop odd (m * n) <--> odd m & odd n
  [hint_rewrite]
proof
  ← rewrite not_even sym=true goal=0
    #[1] ¬(even (m * n)) ⟷ ¬(even m) ∧ ¬(even n)
  ← rewrite even_mult sym=false goal=1
    #[2] ¬(even m ∨ even n) ⟷ ¬(even m) ∧ ¬(even n)
  ← rewrite de_morgan_thm2 sym=false goal=2
qed

theorem odd_exp
  fixes m :: nat, n :: nat
  prop odd (m ^ n) <--> odd m | n = 0
  [hint_rewrite]
proof
  ← rewrite not_even sym=true goal=0
    #[1] ¬(even (m ^ n)) ⟷ ¬(even m) ∨ n = 0
  ← rewrite even_exp sym=false goal=1
    #[2] ¬(even m ∧ ¬(n = 0)) ⟷ ¬(even m) ∨ n = 0
  ← rewrite de_morgan_thm1 sym=false goal=2
    #[3] ¬(even m) ∨ ¬¬(n = 0) ⟷ ¬(even m) ∨ n = 0
  ← rewrite double_neg sym=false goal=3
qed

theorem even_double
  fixes n :: nat
  prop even (2 * n)
  [hint_backward]
proof
  ← rewrite mult_2 sym=false goal=0
    #[1] even (n + n)
  ← induct n nat_induct goal=1
    #[2] even (0 + 0)
    #[3] ∀n. even (n + n) ⟶ even (Suc n + Suc n)
  ← rewrite add_0_right sym=false goal=2
    #[4] even 0
  ← rewrite even_def_1 sym=false goal=4
    #[5] true
  ← rule trueI goal=5
  ← intro n goal=3
    #[6] _VAR n
    #[7] even (n + n)
    #[8] even (Suc n + Suc n)
  ← rewrite add_Suc_right sym=false goal=8
    #[9] even (Suc (Suc n + n))
  ← rewrite even_def_2 sym=false goal=9
    #[10] ¬(even (Suc n + n))
  ← rewrite nat_plus_def_2 sym=false goal=10
    #[11] ¬(even (Suc (n + n)))
  ← rewrite even_def_2 sym=false goal=11
    #[12] ¬¬(even (n + n))
  ← rewrite double_neg sym=false goal=12
qed

theorem odd_double
  fixes n :: nat
  prop odd (Suc (2 * n))
  [hint_backward]
proof
  ← rewrite not_even sym=true goal=0
    #[1] ¬(even (Suc (2 * n)))
  ← rewrite even_def_2 sym=false goal=1
    #[2] ¬¬(even (2 * n))
  ← rewrite double_neg sym=false goal=2
    #[3] even (2 * n)
  ← rule even_double goal=3
qed

theorem even_exists_lemma
  fixes n :: nat
  prop (even n --> (?m. n = 2 * m)) & (~(even n) --> (?m. n = Suc (2 * m)))
  [hint_backward]

theorem even_exists
  fixes n :: nat
  prop even n <--> (?m. n = 2 * m)
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] even n ⟶ (∃m. n = 2 * m)
    #[2] (∃m. n = 2 * m) ⟶ even n
  → forward even_exists_lemma param_n=n goal=1
    #[3] (even n ⟶ (∃m. n = 2 * m)) ∧ (¬(even n) ⟶ (∃m. n = Suc (2 * m)))
  ← rule conjD1 goal=1 facts=[3]
  ← intro goal=2
    #[4] ∃m. n = 2 * m
    #[5] even n
  elim m goal=5 facts=[4]
    #[6] _VAR m
    #[7] n = 2 * m
    #[8] even n
  ← rewrite source=prev goal=8 facts=[7]
    #[9] even (2 * m)
  ← rule even_double goal=9
    #[10] even (2 * m)
qed

theorem odd_exists
  fixes n :: nat
  prop odd n <--> (?m. n = Suc (2 * m))
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] odd n ⟶ (∃m. n = Suc (2 * m))
    #[2] (∃m. n = Suc (2 * m)) ⟶ odd n
  → forward even_exists_lemma param_n=n goal=1
    #[3] (even n ⟶ (∃m. n = 2 * m)) ∧ (¬(even n) ⟶ (∃m. n = Suc (2 * m)))
  → rewrite target=fact not_even sym=false goal=1 facts=[3]
    #[4] (even n ⟶ (∃m. n = 2 * m)) ∧ (odd n ⟶ (∃m. n = Suc (2 * m)))
  ← rule conjD2 goal=1 facts=[4]
  ← intro goal=2
    #[5] ∃m. n = Suc (2 * m)
    #[6] odd n
  elim m goal=6 facts=[5]
    #[7] _VAR m
    #[8] n = Suc (2 * m)
    #[9] odd n
  ← rewrite source=prev goal=9 facts=[8]
    #[10] odd (Suc (2 * m))
  ← rule odd_double goal=10
    #[11] odd (Suc (2 * m))
qed

const nat_divide :: nat ⇒ nat ⇒ nat

const nat_modulus :: nat ⇒ nat ⇒ nat

fun fact :: nat ⇒ nat
  | fact 0 = 1
  | fact (Suc n) = Suc n * fact n

theorem fact_lt
  fixes n :: nat
  prop 0 < fact n
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] 0 < fact 0
    #[2] ∀n. 0 < fact n ⟶ 0 < fact (Suc n)
  ← rewrite fact_def_1 sym=false goal=1
    #[3] (0::nat) < 1
  ← rule le_1_1 goal=3
    #[4] ¬((1::nat) = 0)
  nat_const_ineq goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] 0 < fact n
    #[7] 0 < fact (Suc n)
  ← rewrite fact_def_2 sym=false goal=7
    #[8] 0 < Suc n * fact n
  ← rewrite lt_mult sym=false goal=8
    #[9] 0 < Suc n ∧ 0 < fact n
  ← rule conjI goal=9
    #[10] 0 < Suc n
  ← rewrite less_Suc_lesseq sym=false goal=10
    #[11] 0 ≤ n
  ← rule le_0 goal=11
    #[12] 0 ≤ n
qed

theorem fact_le
  fixes n :: nat
  prop 1 <= fact n
  [hint_backward]
proof
  ← rewrite nat_one_def sym=false goal=0
    #[1] Suc 0 ≤ fact n
  ← rewrite lesseq_Suc_less sym=false goal=1
    #[2] 0 < fact n
  ← rule fact_lt goal=2
qed

theorem fact_nz
  fixes n :: nat
  prop ~(fact n = 0)
  [hint_backward]
proof
  → forward fact_lt param_n=n goal=0
    #[1] 0 < fact n
  ← rule contrapositive goal=0 facts=[1]
    #[2] ¬¬(fact n = 0) ⟶ ¬(0 < fact n)
  ← rewrite double_neg sym=false goal=2
    #[3] fact n = 0 ⟶ ¬(0 < fact n)
  ← intro goal=3
    #[4] fact n = 0
    #[5] ¬(0 < fact n)
  ← rewrite source=prev goal=5 facts=[4]
    #[6] ¬((0::nat) < 0)
  ← rewrite nat_less_def_1 sym=false goal=6
    #[7] ¬false
  ← rule negI goal=7
    #[8] false ⟶ false
qed

theorem fact_mono
  fixes m :: nat, n :: nat
  prop m <= n --> fact m <= fact n
  [hint_backward]
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] fact m ≤ fact n
  → rewrite target=fact less_eq_exist sym=false goal=2 facts=[1]
    #[3] ∃p. n = m + p
  elim d goal=2 facts=[3]
    #[4] _VAR d
    #[5] n = m + d
    #[6] fact m ≤ fact n
  ← rewrite source=prev goal=6 facts=[5]
    #[7] fact m ≤ fact (m + d)
  ← induct d nat_induct goal=7
    #[8] fact m ≤ fact (m + 0)
    #[9] ∀n. fact m ≤ fact (m + n) ⟶ fact m ≤ fact (m + Suc n)
  ← rewrite add_0_right sym=false goal=8
    #[10] fact m ≤ fact m
  ← rule less_eq_refl goal=10
    #[11] fact m ≤ fact m
  ← intro a goal=9
    #[12] _VAR a
    #[13] fact m ≤ fact (m + a)
    #[14] fact m ≤ fact (m + Suc a)
  ← rewrite add_Suc_right sym=false goal=14
    #[15] fact m ≤ fact (Suc (m + a))
  ← rewrite fact_def_2 sym=false goal=15
    #[16] fact m ≤ Suc (m + a) * fact (m + a)
  ← rewrite add_1_right sym=true goal=16
    #[17] fact m ≤ (m + a + 1) * fact (m + a)
  ← rewrite distrib_r sym=false goal=17
    #[18] fact m ≤ (m + a) * fact (m + a) + 1 * fact (m + a)
  ← rewrite mult_1_left sym=false goal=18
    #[19] fact m ≤ (m + a) * fact (m + a) + fact (m + a)
  ← rewrite add_comm sym=false goal=19
    #[20] fact m ≤ fact (m + a) + (m + a) * fact (m + a)
  ← rule less_eq_trans param_m="fact (m + a)" goal=20
    #[21] fact (m + a) ≤ fact (m + a) + (m + a) * fact (m + a)
  ← rule le_add goal=21
    #[22] fact (m + a) ≤ fact (m + a) + (m + a) * fact (m + a)
qed

theorem exp_eq_0
  fixes m :: nat, n :: nat
  prop m ^ n = 0 <--> m = 0 & ~(n = 0)
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] m ^ (0::nat) = 0 ⟷ m = 0 ∧ ¬((0::nat) = 0)
    #[2] ∀n. m ^ n = 0 ⟷ m = 0 ∧ ¬(n = 0) ⟶ m ^ Suc n = 0 ⟷ m = 0 ∧ ¬(Suc n = 0)
  ← rewrite nat_nat_power_def_1 sym=false goal=1
    #[3] (1::nat) = 0 ⟷ m = 0 ∧ ¬((0::nat) = 0)
  ← rule iffI goal=3
    #[4] (1::nat) = 0 ⟶ m = 0 ∧ ¬((0::nat) = 0)
    #[5] m = 0 ∧ ¬((0::nat) = 0) ⟶ (1::nat) = 0
  ← intro goal=4
    #[6] (1::nat) = 0
    #[7] m = 0 ∧ ¬((0::nat) = 0)
  ← rule contrapositive goal=7 facts=[6]
    #[8] ¬(m = 0 ∧ ¬((0::nat) = 0)) ⟶ ¬((1::nat) = 0)
  ← intro goal=8
    #[9] ¬(m = 0 ∧ ¬((0::nat) = 0))
    #[10] ¬((1::nat) = 0)
  nat_const_ineq goal=10
    #[11] ¬((1::nat) = 0)
  ← intro goal=5
    #[12] m = 0 ∧ ¬((0::nat) = 0)
    #[13] (1::nat) = 0
  → forward conjD2 goal=13 facts=[12]
    #[14] ¬((0::nat) = 0)
  ← rule contrapositive goal=13 facts=[14]
    #[15] ¬((1::nat) = 0) ⟶ ¬¬((0::nat) = 0)
  ← intro goal=15
    #[16] ¬((1::nat) = 0)
    #[17] ¬¬((0::nat) = 0)
  ← rewrite double_neg sym=false goal=17
    #[18] ¬¬((0::nat) = 0)
  ← intro n goal=2
    #[19] _VAR n
    #[20] m ^ n = 0 ⟷ m = 0 ∧ ¬(n = 0)
    #[21] m ^ Suc n = 0 ⟷ m = 0 ∧ ¬(Suc n = 0)
  ← rewrite nat_nat_power_def_2 sym=false goal=21
    #[22] m * m ^ n = 0 ⟷ m = 0 ∧ ¬(Suc n = 0)
  ← rule iffI goal=22
    #[23] m * m ^ n = 0 ⟶ m = 0 ∧ ¬(Suc n = 0)
    #[24] m = 0 ∧ ¬(Suc n = 0) ⟶ m * m ^ n = 0
  ← intro goal=23
    #[25] m * m ^ n = 0
    #[26] m = 0 ∧ ¬(Suc n = 0)
  → forward mult_nonzero goal=26 facts=[25]
    #[27] m = 0 ∨ m ^ n = 0
  ← rule disjE goal=26 facts=[27]
    #[28] m = 0 ⟶ m = 0 ∧ ¬(Suc n = 0)
    #[29] m ^ n = 0 ⟶ m = 0 ∧ ¬(Suc n = 0)
  ← intro goal=28
    #[30] m = 0
    #[31] m = 0 ∧ ¬(Suc n = 0)
  ← rule conjI goal=31
    #[32] ¬(Suc n = 0)
  ← rewrite eq_sym_eq sym=false goal=32
    #[33] ¬(0 = Suc n)
  ← rule nat_zero_Suc_neq goal=33
    #[34] ¬(0 = Suc n)
  ← intro goal=29
    #[35] m ^ n = 0
    #[36] m = 0 ∧ ¬(Suc n = 0)
  → rewrite target=fact source=prev goal=36 facts=[20,35]
    #[37] m = 0 ∧ ¬(n = 0)
  → forward conjD1 goal=36 facts=[37]
    #[38] m = 0
  ← rule conjI goal=36
    #[39] ¬(Suc n = 0)
  ← rule ineq_sym goal=39
    #[40] ¬(0 = Suc n)
  ← rule nat_zero_Suc_neq goal=40
  ← intro goal=24
    #[41] m = 0 ∧ ¬(Suc n = 0)
    #[42] m * m ^ n = 0
  → forward conjD1 goal=42 facts=[41]
    #[43] m = 0
  ← rewrite source=prev goal=42 facts=[43]
    #[44] (0::nat) * 0 ^ n = 0
  ← rewrite nat_times_def_1 sym=false goal=44
    #[45] (0::nat) * 0 ^ n = 0
qed

theorem exp_eq_1
  fixes m :: nat, n :: nat
  prop m ^ n = 1 <--> m = 1 | n = 0
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] m ^ (0::nat) = 1 ⟷ m = 1 ∨ (0::nat) = 0
    #[2] ∀n. m ^ n = 1 ⟷ m = 1 ∨ n = 0 ⟶ m ^ Suc n = 1 ⟷ m = 1 ∨ Suc n = 0
  ← rewrite nat_nat_power_def_1 sym=false goal=1
    #[3] (1::nat) = 1 ⟷ m = 1 ∨ (0::nat) = 0
  ← rule iffI goal=3
    #[4] (1::nat) = 1 ⟶ m = 1 ∨ (0::nat) = 0
    #[5] m = 1 ∨ (0::nat) = 0 ⟶ (1::nat) = 1
  ← intro goal=4
    #[6] (1::nat) = 1
    #[7] m = 1 ∨ (0::nat) = 0
  ← rule disjI2 goal=7
    #[8] (0::nat) = 0
  ← rule eq_refl goal=8
    #[9] (0::nat) = 0
  ← intro goal=5
    #[10] m = 1 ∨ (0::nat) = 0
    #[11] (1::nat) = 1
  ← rule eq_refl goal=11
    #[12] (1::nat) = 1
  ← intro n goal=2
    #[13] _VAR n
    #[14] m ^ n = 1 ⟷ m = 1 ∨ n = 0
    #[15] m ^ Suc n = 1 ⟷ m = 1 ∨ Suc n = 0
  ← rewrite nat_nat_power_def_2 sym=false goal=15
    #[16] m * m ^ n = 1 ⟷ m = 1 ∨ Suc n = 0
  ← rule iffI goal=16
    #[17] m * m ^ n = 1 ⟶ m = 1 ∨ Suc n = 0
    #[18] m = 1 ∨ Suc n = 0 ⟶ m * m ^ n = 1
  ← intro goal=17
    #[19] m * m ^ n = 1
    #[20] m = 1 ∨ Suc n = 0
  ← rule disjI1 goal=20
    #[21] m = 1
  → rewrite target=fact mult_eq_1 sym=false goal=21 facts=[19]
    #[22] m = 1 ∧ m ^ n = 1
  ← rule conjD1 goal=21 facts=[22]
    #[23] m = 1
  ← intro goal=18
    #[24] m = 1 ∨ Suc n = 0
    #[25] m * m ^ n = 1
  ← rule disjE goal=25 facts=[24]
    #[26] m = 1 ⟶ m * m ^ n = 1
    #[27] Suc n = 0 ⟶ m * m ^ n = 1
  ← intro goal=26
    #[28] m = 1
    #[29] m * m ^ n = 1
  ← rewrite source=prev goal=29 facts=[28]
    #[30] (1::nat) * 1 ^ n = 1
  ← induct n nat_induct goal=30
    #[31] (1::nat) * 1 ^ (0::nat) = 1
    #[32] ∀n. (1::nat) * 1 ^ n = 1 ⟶ (1::nat) * 1 ^ Suc n = 1
  ← rewrite nat_nat_power_def_1 sym=false goal=31
    #[33] (1::nat) * 1 = 1
  ← rewrite mult_1_left sym=false goal=33
    #[34] (1::nat) * 1 = 1
  ← intro n1 goal=32
    #[35] _VAR n1
    #[36] (1::nat) * 1 ^ n1 = 1
    #[37] (1::nat) * 1 ^ Suc n1 = 1
  ← rewrite nat_nat_power_def_2 sym=false goal=37
    #[38] (1::nat) * (1 * 1 ^ n1) = 1
  ← rewrite source=prev goal=38 facts=[36]
  ← intro goal=27
    #[39] Suc n = 0
    #[40] m * m ^ n = 1
  ← rule contrapositive goal=40 facts=[39]
    #[41] ¬(m * m ^ n = 1) ⟶ ¬(Suc n = 0)
  ← intro goal=41
    #[42] ¬(m * m ^ n = 1)
    #[43] ¬(Suc n = 0)
  ← rule ineq_sym goal=43
    #[44] ¬(0 = Suc n)
  ← rule nat_zero_Suc_neq goal=44
    #[45] ¬(0 = Suc n)
qed

theorem exp_zero
  fixes n :: nat
  prop (0::nat) ^ n = (if n = 0 then 1 else 0)
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ (0::nat) ^ n = (if n = 0 then 1 else 0)
    #[2] ¬(n = 0) ⟶ (0::nat) ^ n = (if n = 0 then 1 else 0)
  ← intro goal=1
    #[3] n = 0
    #[4] (0::nat) ^ n = (if n = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=4 facts=[3]
    #[5] (0::nat) ^ n = 1
  ← rewrite source=prev goal=5 facts=[3]
    #[6] (0::nat) ^ (0::nat) = 1
  ← rewrite nat_nat_power_def_1 sym=false goal=6
    #[7] (0::nat) ^ (0::nat) = 1
  ← intro goal=2
    #[8] ¬(n = 0)
    #[9] (0::nat) ^ n = (if n = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=9 facts=[8]
    #[10] (0::nat) ^ n = 0
  ← rewrite exp_eq_0 sym=false goal=10
    #[11] (0::nat) = 0 ∧ ¬(n = 0)
  ← rule conjI goal=11
    #[12] (0::nat) = 0
  ← rule eq_refl goal=12
    #[13] (0::nat) = 0
qed

theorem nat_power_1
  fixes m :: nat
  prop m ^ (1::nat) = m
proof
  ← rewrite nat_one_def sym=false goal=0
    #[1] m ^ Suc 0 = m
  ← rewrite nat_nat_power_def_2 sym=false goal=1
    #[2] m * m ^ (0::nat) = m
  ← rewrite nat_nat_power_def_1 sym=false goal=2
    #[3] m * 1 = m
  ← rewrite mult_1_right sym=false goal=3
qed

theorem nat_power_add
  fixes m :: nat, p :: nat, q :: nat
  prop m ^ (p + q) = m ^ p * m ^ q
  [hint_rewrite]
proof
  ← induct q nat_induct goal=0
    #[1] m ^ (p + 0) = m ^ p * m ^ (0::nat)
    #[2] ∀n. m ^ (p + n) = m ^ p * m ^ n ⟶ m ^ (p + Suc n) = m ^ p * m ^ Suc n
  ← rewrite nat_nat_power_def_1 sym=false goal=1
    #[3] m ^ (p + 0) = m ^ p * 1
  ← rewrite add_0_right sym=false goal=3
    #[4] m ^ p = m ^ p * 1
  ← rewrite mult_1_right sym=false goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] m ^ (p + n) = m ^ p * m ^ n
    #[7] m ^ (p + Suc n) = m ^ p * m ^ Suc n
  ← rewrite add_Suc_right sym=false goal=7
    #[8] m ^ Suc (p + n) = m ^ p * m ^ Suc n
  ← rewrite nat_nat_power_def_2 sym=false goal=8
    #[9] m * m ^ (p + n) = m ^ p * (m * m ^ n)
  ← rewrite source=prev goal=9 facts=[6]
    #[10] m * (m ^ p * m ^ n) = m ^ p * (m * m ^ n)
  nat_norm goal=10
    #[11] m * (m ^ p * m ^ n) = m ^ p * (m * m ^ n)
qed

theorem exp_one
  fixes n :: nat
  prop (1::nat) ^ n = 1
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] (1::nat) ^ (0::nat) = 1
    #[2] ∀n. (1::nat) ^ n = 1 ⟶ (1::nat) ^ Suc n = 1
  ← rewrite nat_nat_power_def_1 sym=false goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] (1::nat) ^ n = 1
    #[5] (1::nat) ^ Suc n = 1
  ← rewrite nat_nat_power_def_2 sym=false goal=5
    #[6] (1::nat) * 1 ^ n = 1
  ← rewrite source=prev goal=6 facts=[4]
    #[7] (1::nat) * 1 = 1
  ← rewrite mult_1_left sym=false goal=7
    #[8] (1::nat) * 1 = 1
qed

theorem exp_1
  fixes n :: nat
  prop n ^ (1::nat) = n
  [hint_rewrite]
proof
  ← rewrite nat_one_def sym=false goal=0
    #[1] n ^ Suc 0 = n
  ← rewrite nat_nat_power_def_2 sym=false goal=1
    #[2] n * n ^ (0::nat) = n
  ← rewrite nat_nat_power_def_1 sym=false goal=2
    #[3] n * 1 = n
  ← rewrite mult_1_right sym=false goal=3
qed

theorem exp_2
  fixes n :: nat
  prop n ^ (2::nat) = n * n
  [hint_rewrite]
proof
  ← rewrite bit0_def sym=false goal=0
    #[1] n ^ (of_nat::nat ⇒ nat) (1 + 1) = n * n
  ← rewrite nat_of_nat_def sym="" goal=1
    #[2] n ^ ((1::nat) + 1) = n * n
  ← rewrite nat_power_add sym=false goal=2
    #[3] n ^ (1::nat) * n ^ (1::nat) = n * n
  ← rewrite exp_1 sym=false goal=3
qed

theorem mult_exp
  fixes m :: nat, n :: nat, p :: nat
  prop (m * n) ^ p = m ^ p * n ^ p
  [hint_rewrite]
proof
  ← induct p nat_induct goal=0
    #[1] (m * n) ^ (0::nat) = m ^ (0::nat) * n ^ (0::nat)
    #[2] ∀n1. (m * n) ^ n1 = m ^ n1 * n ^ n1 ⟶ (m * n) ^ Suc n1 = m ^ Suc n1 * n ^ Suc n1
  ← rewrite nat_nat_power_def_1 sym=false goal=1
    #[3] (1::nat) = 1 * 1
  ← rewrite mult_1_left sym=false goal=3
  ← intro p goal=2
    #[4] _VAR p
    #[5] (m * n) ^ p = m ^ p * n ^ p
    #[6] (m * n) ^ Suc p = m ^ Suc p * n ^ Suc p
  ← rewrite nat_nat_power_def_2 sym=false goal=6
    #[7] m * n * (m * n) ^ p = m * m ^ p * (n * n ^ p)
  ← rewrite source=prev goal=7 facts=[5]
    #[8] m * n * (m ^ p * n ^ p) = m * m ^ p * (n * n ^ p)
  nat_norm goal=8
    #[9] m * n * (m ^ p * n ^ p) = m * m ^ p * (n * n ^ p)
qed

theorem exp_mult
  fixes m :: nat, n :: nat, p :: nat
  prop m ^ (n * p) = m ^ n ^ p
  [hint_rewrite]
proof
  ← induct p nat_induct goal=0
    #[1] m ^ (n * 0) = m ^ n ^ (0::nat)
    #[2] ∀n1. m ^ (n * n1) = m ^ n ^ n1 ⟶ m ^ (n * Suc n1) = m ^ n ^ Suc n1
  ← rewrite mult_0_right sym=false goal=1
    #[3] m ^ (0::nat) = m ^ n ^ (0::nat)
  ← rewrite nat_nat_power_def_1 sym=false goal=3
  ← intro p goal=2
    #[4] _VAR p
    #[5] m ^ (n * p) = m ^ n ^ p
    #[6] m ^ (n * Suc p) = m ^ n ^ Suc p
  ← rewrite mult_Suc_right sym=false goal=6
    #[7] m ^ (n + n * p) = m ^ n ^ Suc p
  ← rewrite nat_power_add sym=false goal=7
    #[8] m ^ n * m ^ (n * p) = m ^ n ^ Suc p
  ← rewrite nat_nat_power_def_2 sym=false goal=8
    #[9] m ^ n * m ^ (n * p) = m ^ n * m ^ n ^ p
  ← rewrite source=prev goal=9 facts=[5]
qed

theorem exp_lt_0
  fixes n :: nat, x :: nat
  prop 0 < x ^ n <--> ~(x = 0) | n = 0
  [hint_rewrite]
proof
  ← rewrite not_le sym=true goal=0
    #[1] ¬(x ^ n ≤ 0) ⟷ ¬(x = 0) ∨ n = 0
  ← rewrite nat_less_eq_def_1 sym=false goal=1
    #[2] ¬(x ^ n = 0) ⟷ ¬(x = 0) ∨ n = 0
  ← rewrite exp_eq_0 sym=false goal=2
    #[3] ¬(x = 0 ∧ ¬(n = 0)) ⟷ ¬(x = 0) ∨ n = 0
  ← rewrite de_morgan_thm1 sym=false goal=3
    #[4] ¬(x = 0) ∨ ¬¬(n = 0) ⟷ ¬(x = 0) ∨ n = 0
  ← rewrite double_neg sym=false goal=4
qed

theorem lt_pow2_refl
  fixes n :: nat
  prop n < 2 ^ n
  [hint_backward]
proof
  ← induct n nat_induct goal=0
    #[1] (0::nat) < 2 ^ (0::nat)
    #[2] ∀n. n < 2 ^ n ⟶ Suc n < 2 ^ Suc n
  ← rewrite nat_nat_power_def_1 sym=false goal=1
    #[3] (0::nat) < 1
  ← rule le_1_1 goal=3
    #[4] ¬((1::nat) = 0)
  nat_const_ineq goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] n < 2 ^ n
    #[7] Suc n < 2 ^ Suc n
  ← rewrite nat_nat_power_def_2 sym=false goal=7
    #[8] Suc n < 2 * 2 ^ n
  ← rewrite mult_2 sym=false goal=8
    #[9] Suc n < 2 ^ n + 2 ^ n
  ← rewrite add_1_right sym=true goal=9
    #[10] n + 1 < 2 ^ n + 2 ^ n
  ← rewrite add_comm sym=false goal=10
    #[11] 1 + n < 2 ^ n + 2 ^ n
  ← rule let_add2 goal=11
    #[12] (1::nat) ≤ 2 ^ n
  ← rule le_1_2 goal=12
    #[13] ¬((2::nat) ^ n = 0)
  ← rewrite exp_eq_0 sym=false goal=13
    #[14] ¬((2::nat) = 0 ∧ ¬(n = 0))
  ← rewrite de_morgan_thm1 sym=false goal=14
    #[15] ¬((2::nat) = 0) ∨ ¬¬(n = 0)
  ← rule disjI1 goal=15
    #[16] ¬((2::nat) = 0)
  nat_const_ineq goal=16
    #[17] ¬((2::nat) = 0)
qed

