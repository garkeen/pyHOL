theorem real_measure_union
  fixes s :: real set, t :: real set
  prop real_measurable s ⟶ real_measurable t ⟶ real_measure (s ∪ t) = real_measure s + real_measure t - real_measure (s ∩ t)
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: cut "s ∪ t = s ∩ t ∪ diff s t ∪ diff t s"
    2: z3
    3: rewrite_goal_with_prev @2
    3: cut "∀a::real. ∀b. ∀c. a + b - c = c + (a - c) + (b - c)"
    3: z3
    4: rewrite_goal_with_prev @3
    4: apply_backward_step real_measure_unique
    4: apply_backward_step has_real_measure_disjoint_union
    4: apply_backward_step has_real_measure_disjoint_union
    4: apply_forward_step real_measurable_inter @0,1
    5: rewrite_fact has_real_measure_mesure @4 sym=false
    6: rewrite_goal has_real_measure_real_measurable_real_measure sym=false
    6: apply_backward_step conjI
    6: apply_backward_step real_measurable_diff @0,1
    7: apply_forward_step real_measure_diff_subset @0,4
    8: cut "diff s t = diff s (s ∩ t)" @7
    8: z3
    9: rewrite_goal_with_prev @8
    9: apply_prev @7
    9: apply_backward_step inter_subset_id
    14: rewrite_goal disjoint_def sym=false
    14: z3
    17: cut "diff t s = diff t (s ∩ t)" @8
    17: z3
    18: rewrite_goal_with_prev @17
    18: apply_backward_step has_real_measure_diff_subset
    18: rewrite_fact has_real_measure_mesure @1 sym=false
    19: rewrite_goal inter_comm sym=false
    19: apply_backward_step inter_subset_id
    23: rewrite_goal disjoint_def sym=false
    23: z3
  qed

theorem real_measure_union_le
  fixes s :: real set, t :: real set
  prop real_measurable s ⟶ real_measurable t ⟶ real_measure (s ∪ t) ≤ real_measure s + real_measure t
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: apply_forward_step real_measure_union @0,1
    3: rewrite_goal_with_prev @2
    3: cut "∀a::real. ∀b. a - b ≤ a ⟷ 0 ≤ b"
    3: z3
    4: rewrite_goal_with_prev @3
    4: apply_backward_step real_measure_pos_le
    4: apply_backward_step real_measurable_inter @0,1
  qed

theorem real_measure_unions_le
  fixes f :: real set set
  prop finite f ⟶ (∀s. s ∈ f ⟶ real_measurable s) ⟶ real_measure (⋃f) = sum f (λs. real_measure s)
  [hint_backward,hint_backward1,hint_forward]

theorem real_measure_unions_le_image
  fixes f :: 'a set, s :: 'a ⇒ real set
  prop finite f ⟶ (∀a. a ∈ f ⟶ real_measurable (s a)) ⟶ real_measure (⋃(image s f)) = sum f (λa. real_measure (s a))
  [hint_backward,hint_backward1,hint_forward]

theorem real_negligible_outer
  fixes s :: real set
  prop real_negligible s ⟷ (∀e. 0 < e ⟶ (∃t. s ⊆ t ∧ real_measurable t ∧ real_measure t < e))
  [hint_rewrite]

theorem real_negligible_outer_le
  fixes s :: real set
  prop real_negligible s ⟷ (∀e. 0 < e ⟶ (∃t. s ⊆ t ∧ real_measurable t ∧ real_measure t ≤ e))
  [hint_rewrite]

theorem real_measurable_inner_outer
  fixes s :: real set
  prop real_measurable s ⟷ (∀e. 0 < e ⟶ (∃t. ∃u. t ⊆ s ∧ s ⊆ u ∧ real_measurable t ∧ real_measurable u ∧ abs (real_measure t - real_measure u) < e))
  [hint_rewrite]

theorem has_real_measure_inner_outer
  fixes m :: real, s :: real set
  prop has_real_measure s m ⟷ (∀e. 0 < e ⟶ (∃t. t ⊆ s ∧ real_measurable t ∧ m - e < real_measure t)) ∧ (∀e. 0 < e ⟶ (∃u. s ⊆ u ∧ real_measurable u ∧ real_measure u < m + e))
  [hint_rewrite]

theorem has_real_measure_inner_outer_le
  fixes m :: real, s :: real set
  prop has_real_measure s m ⟷ (∀e. 0 < e ⟶ (∃t. t ⊆ s ∧ real_measurable t ∧ m - e ≤ real_measure t)) ∧ (∀e. 0 < e ⟶ (∃u. s ⊆ u ∧ real_measurable u ∧ real_measure u ≤ m + e))
  [hint_rewrite]

theorem has_real_measure_affinity
  fixes c :: real, m :: real, s :: real set, y :: real
  prop has_real_measure s y ⟶ has_real_measure (image (λx. m * x + c) s) (abs m * y)
  [hint_forward,hint_backward]

theorem has_real_measure_scaling
  fixes m :: real, s :: real set, y :: real
  prop has_real_measure s y ⟶ has_real_measure (image (λx. m * x) s) (abs m * y)
  [hint_backward,hint_forward]
  proof
    1: apply_forward_step has_real_measure_affinity @0 param_c="(0::real)" param_m=m
    2: rewrite_fact real_add_rid @1
  qed

theorem has_real_measure_translation
  fixes a :: real, m :: real, s :: real set
  prop has_real_measure s m ⟶ has_real_measure (image (λx. x + a) s) m
  [hint_backward,hint_forward]
  proof
    1: apply_forward_step has_real_measure_affinity @0 param_c=a param_m="(1::real)"
    2: rewrite_fact real_mul_lid @1
    3: cut "abs 1 * m = m"
    3: z3
    4: rewrite_fact_with_prev @3,2
  qed

theorem real_negligible_translation
  fixes a :: real, s :: real set
  prop real_negligible s ⟶ real_negligible (image (λx. x + a) s)
  [hint_backward,hint_forward]

theorem has_real_measure_translation_eq
  fixes a :: real, m :: real, s :: real set
  prop has_real_measure (image (λx. x + a) s) m ⟷ has_real_measure s m
  [hint_rewrite]

theorem real_negligible_translation_rev
  fixes a :: real, s :: real set
  prop real_negligible (image (λx. x + a) s) ⟶ real_negligible s
  [hint_backward,hint_forward]

theorem real_negligible_translation_eq
  fixes a :: real, s :: real set
  prop real_negligible (image (λx. x + a) s) ⟷ real_negligible s
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step real_negligible_translation_rev param_a=a
    1: introduction
    1.1: apply_backward_step real_negligible_translation
  qed

theorem real_measurable_translation
  fixes a :: real, s :: real set
  prop real_measurable (image (λx. x + a) s) ⟷ real_measurable s
  [hint_rewrite]
  proof
    0: rewrite_goal real_measurable_def
    0: rewrite_goal has_real_measure_translation_eq
  qed

theorem real_measure_translation
  fixes a :: real, s :: real set
  prop real_measurable s ⟶ real_measure (image (λx. x + a) s) = real_measure s
  [hint_forward,hint_backward]
  proof
    1: rewrite_fact has_real_measure_mesure @0
    2: apply_backward_step real_measure_unique
    2: rewrite_goal has_real_measure_translation_eq
  qed

theorem has_real_measure_scaling_eq
  fixes c :: real, m :: real, s :: real set
  prop ¬(c = 0) ⟶ has_real_measure (image (λx. c * x) s) (abs c * m) ⟷ has_real_measure s m
  [hint_backward,hint_forward]
  proof
    1: apply_backward_step iffI
    1: introduction
    1.1: apply_forward_step has_real_measure_scaling @1.0 param_m="real_inverse c"
    1.2: rewrite_fact image_combine @1.1 sym=true
    1.3: rewrite_fact comp_fun_def @1.2 sym=false
    1.4: rewrite_fact real_mult_assoc @1.3 sym=false
    1.5: apply_forward_step real_mul_linv @0
    1.6: rewrite_fact real_abs_mul @1.4 sym=true
    1.7: rewrite_fact_with_prev @1.5,1.6
    1.8: rewrite_fact real_mul_lid @1.7 sym=false
    1.9: rewrite_fact real_one_def @1.8 sym=false
    1.10: rewrite_fact real_abs_nat @1.9 sym=false
    1.11: rewrite_fact real_one_def @1.10 sym=true
    1.12: rewrite_fact real_mul_lid @1.11 sym=false
    1.13: rewrite_fact image_id @1.12 sym=false
    2: introduction
    2.1: apply_backward_step has_real_measure_scaling
  qed

theorem real_measurable_scaling
  fixes c :: real, s :: real set
  prop real_measurable s ⟶ real_measurable (image (λx. c * x) s)
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal real_measurable_def
    1: rewrite_fact real_measurable_def @0
    2: exists_elim m @1
    4: apply_forward_step has_real_measure_scaling @3 param_m=c
    5: apply_backward_step exI @4
