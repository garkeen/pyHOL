theory realintegral
imports realseries
description "Integrals of real->real functions; measures of real set. Refer to realanalysis.ml from hol light."

def evalat :: (real ⇒ real) ⇒ real ⇒ real ⇒ real = evalat f a b = f b - f a [hint_rewrite]

const has_real_integral :: (real ⇒ real) ⇒ real ⇒ real set ⇒ bool

def real_integrable_on :: (real ⇒ real) ⇒ real set ⇒ bool = real_integrable_on f i ⟷ (∃y. has_real_integral f y i) [hint_rewrite]

def real_integral :: real set ⇒ (real ⇒ real) ⇒ real = real_integral i f = (THE y. has_real_integral f y i) [hint_rewrite]

def real_negligible :: real set ⇒ bool = real_negligible s ⟷ (∀a. ∀b. has_real_integral (indicator s) 0 (real_closed_interval a b)) [hint_rewrite]

def absolutely_real_integrable_on :: (real ⇒ real) ⇒ real set ⇒ bool = absolutely_real_integrable_on f s ⟷ real_integrable_on f s ∧ real_integrable_on (λx. abs (f x)) s [hint_rewrite]

def has_real_measure :: real set ⇒ real ⇒ bool = has_real_measure s m ⟷ has_real_integral (λx. 1) m s [hint_rewrite]

def real_measurable :: real set ⇒ bool = real_measurable s ⟷ (∃m. has_real_measure s m) [hint_rewrite]

def real_measure :: real set ⇒ real = real_measure s = (THE m. has_real_measure s m) [hint_rewrite]

theorem real_integrable_integral
  fixes f :: real ⇒ real, i :: real set
  prop real_integrable_on f i ⟶ has_real_integral f (real_integral i f) i
  [hint_backward,hint_rewrite,hint_forward]
  proof
    1: rewrite_goal real_integral_def
    1: rewrite_fact real_integrable_on_def @0
  qed

theorem has_real_integral_integrable
  fixes f :: real ⇒ real, i :: real, s :: real set
  prop has_real_integral f i s ⟶ real_integrable_on f s
  [hint_backward]
  proof
    1: rewrite_goal real_integrable_on_def
    1: apply_backward_step exI param_a=i
  qed

theorem has_real_integral_integral
  fixes f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟷ has_real_integral f (real_integral s f) s
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step real_integrable_integral
    1: introduction
    1.1: apply_backward_step has_real_integral_integrable param_i="real_integral s f"
  qed

theorem has_real_integral_unique
  fixes f :: real ⇒ real, i :: real set, k1 :: real, k2 :: real
  prop has_real_integral f k1 i ⟶ has_real_integral f k2 i ⟶ k1 = k2
  [hint_backward,hint_backward1,hint_forward]

theorem real_integral_unique
  fixes f :: real ⇒ real, k :: real set, y :: real
  prop has_real_integral f y k ⟶ real_integral k f = y
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal real_integral_def
  qed

theorem has_real_integral_integrable_integral
  fixes f :: real ⇒ real, i :: real, s :: real set
  prop has_real_integral f i s ⟷ real_integrable_on f s ∧ real_integral s f = i
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step conjI
    0.1: apply_backward_step has_real_integral_integrable param_i=i
    0.2: apply_backward_step real_integral_unique
    1: introduction
    1.1: apply_forward_step conjD1 @1.0
    1.2: rewrite_fact real_integrable_on_def @1.1
    1.3: apply_forward_step conjD2 @1.0
    1.4: exists_elim j @1.2
    1.6: apply_forward_step real_integral_unique @1.5
    1.7: rewrite_fact_with_prev @1.3,1.6
    1.8: rewrite_goal_with_prev @1.7
  qed

theorem real_integral_eq_has_integral
  fixes f :: real ⇒ real, i :: real, s :: real set
  prop real_integrable_on f s ⟶ real_integral s f = i ⟷ has_real_integral f i s
  proof
    1: apply_backward_step iffI
    1: apply_forward_step real_integrable_integral @0
    2: introduction
    2.1: rewrite_fact_with_prev @2.0,1
    2.2: apply_forward_step real_integrable_integral @0
    3: introduction
    3.1: apply_backward_step real_integral_unique
  qed

theorem has_real_integral_alt
  fixes f :: real ⇒ real, i :: real, s :: real set
  prop has_real_integral f i s ⟷ (∀a. ∀b. real_integrable_on (λx. if x ∈ s then f x else 0) (real_closed_interval a b)) ∧ (∀e. 0 < e ⟶ (∃B. 0 < B ∧ (∀a. ∀b. real_closed_interval (-B) B ⊆ real_closed_interval a b ⟶ abs (real_integral (real_closed_interval a b) (λx. if x ∈ s then f x else 0) - i) < e)))
  [hint_rewrite]

theorem has_real_integral_is_0
  fixes f :: real ⇒ real, s :: real set
  prop (∀x. x ∈ s ⟶ f x = 0) ⟶ has_real_integral f 0 s
  [hint_backward,hint_forward]

theorem has_real_integral_0
  fixes s :: real set
  prop has_real_integral (λx. 0) 0 s
  [hint_backward,hint_resolve]
  proof
    0: apply_backward_step has_real_integral_is_0
    0: introduction x
    0.2: apply_backward_step eq_refl
  qed

theorem has_real_integral_0_eq
  fixes i :: real, s :: real set
  prop has_real_integral (λx. 0) i s ⟷ i = 0
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step has_real_integral_unique param_f="%x::real. (0::real)" param_i=s
    0.1: apply_backward_step has_real_integral_0
    1: introduction
    1.1: rewrite_goal_with_prev @1.0
    1.1: apply_backward_step has_real_integral_0
  qed

theorem has_real_integral_lmul
  fixes c :: real, f :: real ⇒ real, k :: real, s :: real set
  prop has_real_integral f k s ⟶ has_real_integral (λx. c * f x) (c * k) s
  [hint_backward]

theorem has_real_integral_rmul
  fixes c :: real, f :: real ⇒ real, k :: real, s :: real set
  prop has_real_integral f k s ⟶ has_real_integral (λx. f x * c) (k * c) s
  proof
    1: rewrite_goal real_mult_comm
    1: apply_backward_step has_real_integral_lmul
  qed

theorem has_real_integral_neg
  fixes f :: real ⇒ real, k :: real, s :: real set
  prop has_real_integral f k s ⟶ has_real_integral (λx. -(f x)) (-k) s
  [hint_backward]

theorem has_real_integral_add
  fixes f :: real ⇒ real, g :: real ⇒ real, k :: real, l :: real, s :: real set
  prop has_real_integral f k s ⟶ has_real_integral g l s ⟶ has_real_integral (λx. f x + g x) (k + l) s
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_integral_sub
  fixes f :: real ⇒ real, g :: real ⇒ real, k :: real, l :: real, s :: real set
  prop has_real_integral f k s ⟶ has_real_integral g l s ⟶ has_real_integral (λx. f x - g x) (k - l) s
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal real_poly_neg2 sym=false
    2: apply_backward_step has_real_integral_add
    2: apply_backward_step has_real_integral_lmul
  qed

theorem real_integral_0
  fixes s :: real set
  prop real_integral s (λx. 0) = 0
  [hint_rewrite]
  proof
    0: apply_backward_step real_integral_unique
    0: apply_backward_step has_real_integral_0
  qed

theorem real_integral_add
  fixes f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on g s ⟶ real_integral s (λx. f x + g x) = real_integral s (λx. f x) + real_integral s (λx. g x)
  [hint_backward]
  proof
    2: apply_backward_step real_integral_unique
    2: apply_forward_step real_integrable_integral @0
    3: apply_forward_step real_integrable_integral @1
    4: apply_backward_step has_real_integral_add
    4: rewrite_goal eta_conversion sym=false
    5: rewrite_goal eta_conversion sym=false
  qed

theorem real_integral_lmul
  fixes c :: real, f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integral s (λx. c * f x) = c * real_integral s (λx. f x)
  [hint_forward,hint_backward]
  proof
    1: apply_backward_step real_integral_unique
    1: apply_backward_step has_real_integral_lmul
    1: rewrite_goal eta_conversion sym=false
    1: apply_backward_step real_integrable_integral
  qed

theorem real_integral_lmul2
  fixes c :: real, f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on g s ⟶ real_integral s (λx. c * f x * g x) = c * real_integral s (λx. f x * g x)

theorem real_integral_lmul3
  fixes c :: real, f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on g s ⟶ ¬(c = 0) ⟶ (∀x. x ∈ s ⟶ ¬(g x = 0)) ⟶ real_integral s (λx. f x / (c * g x)) = 1 / c * real_integral s (λx. f x / g x)

theorem real_integral_rmul
  fixes c :: real, f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integral s (λx. f x * c) = real_integral s (λx. f x) * c
  [hint_backward]
  proof
    1: rewrite_goal real_mult_comm
    1: apply_backward_step real_integral_lmul
  qed

theorem real_integral_div
  fixes c :: real, f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ ¬(c = 0) ⟶ real_integral s (λx. f x / c) = 1 / c * real_integral s f

theorem real_integral_neg
  fixes f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integral s (λx. -(f x)) = -(real_integral s f)
  [hint_backward]
  proof
    1: apply_backward_step real_integral_unique
    1: apply_backward_step has_real_integral_neg
    1: apply_backward_step real_integrable_integral
  qed

theorem real_integral_sub
  fixes f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on g s ⟶ real_integral s (λx. f x - g x) = real_integral s f - real_integral s g
  [hint_backward]
  proof
    2: apply_backward_step real_integral_unique
    2: apply_backward_step has_real_integral_sub
    2: apply_backward_step real_integrable_integral
    3: apply_backward_step real_integrable_integral
  qed

theorem real_integrable_0
  fixes s :: real set
  prop real_integrable_on (λx. 0) s
  [hint_resolve,hint_backward]
  proof
    0: rewrite_goal real_integrable_on_def
    0: apply_backward_step exI param_a="(0::real)"
    0: apply_backward_step has_real_integral_0
  qed

theorem real_integrable_add
  fixes f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on g s ⟶ real_integrable_on (λx. f x + g x) s
  [hint_backward]
  proof
    2: rewrite_goal real_integrable_on_def sym=false
    2: rewrite_fact real_integrable_on_def @0 sym=false
    3: rewrite_fact real_integrable_on_def @1 sym=false
    4: exists_elim y1 @2
    6: exists_elim y2 @3
    8: inst_exists_goal "y1 + y2"
    8: apply_backward_step has_real_integral_add
  qed

theorem real_integrable_lmul
  fixes c :: real, f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on (λx. c * f x) s
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal real_integrable_on_def
    1: rewrite_fact real_integrable_on_def @0
    2: exists_elim y @1
    4: apply_backward_step exI param_a="c * y"
    4: apply_backward_step has_real_integral_lmul
  qed

theorem real_integrable_rmul
  fixes c :: real, f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on (λx. f x * c) s
  [hint_backward]
  proof
    1: rewrite_goal real_mult_comm
    1: apply_backward_step real_integrable_lmul
  qed

theorem real_integrable_lmul_eq
  fixes c :: real, f :: real ⇒ real, s :: real set
  prop real_integrable_on (λx. c * f x) s ⟷ c = 0 ∨ real_integrable_on f s
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: cases "c = 0"
    0: introduction
    0.2: apply_backward_step disjI1 @0.0
    1: introduction
    1.2: apply_forward_step real_mul_linv @1.0
    1.3: apply_forward_step real_integrable_lmul @1.1 param_c="real_inverse c"
    1.4: rewrite_fact real_mult_assoc @1.3
    1.5: rewrite_fact_with_prev @1.2,1.4
    1.6: rewrite_fact real_mul_lid @1.5
    1.7: apply_backward_step disjI2
    3: introduction
    3.1: apply_backward_step disjE @3.0
    3.1: introduction
    3.1.1: rewrite_goal_with_prev @3.1.0
    3.2: introduction
    3.2.1: apply_backward_step real_integrable_lmul
    3.1.1: rewrite_goal real_mul_lzero
    1.7: rewrite_fact eta_conversion @1.6
    3.1.1: apply_backward_step real_integrable_0
  qed

theorem real_integrable_rmul_eq
  fixes c :: real, f :: real ⇒ real, s :: real set
  prop real_integrable_on (λx. f x * c) s ⟷ c = 0 ∨ real_integrable_on f s
  [hint_rewrite]
  proof
    0: rewrite_goal real_mult_comm
    0: rewrite_goal real_integrable_lmul_eq
  qed

theorem real_integrable_neg
  fixes f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on (λx. -(f x)) s
  [hint_backward]
  proof
    1: rewrite_goal real_integrable_on_def
    1: rewrite_fact real_integrable_on_def @0
    2: exists_elim y @1
    4: apply_backward_step exI param_a=-y
    4: apply_backward_step has_real_integral_neg
  qed

theorem real_integrable_sub
  fixes f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on g s ⟶ real_integrable_on (λx. f x - g x) s
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal real_integrable_on_def sym=false
    2: rewrite_fact real_integrable_on_def @0 sym=false
    3: rewrite_fact real_integrable_on_def @1 sym=false
    4: exists_elim y1 @2
    6: exists_elim y2 @3
    8: inst_exists_goal "y1 - y2"
    8: apply_backward_step has_real_integral_sub
  qed

theorem has_real_integral_sum
  fixes f :: 'a ⇒ real ⇒ real, i :: 'a ⇒ real, s :: real set, t :: 'a set
  prop finite t ⟶ (∀a. a ∈ t ⟶ has_real_integral (f a) (i a) s) ⟶ has_real_integral (λx. sum t (λa. f a x)) (sum t i) s
  [hint_backward,hint_backward1]

theorem real_integral_sum
  fixes f :: 'a ⇒ real ⇒ real, s :: real set, t :: 'a set
  prop finite t ⟶ (∀a. a ∈ t ⟶ real_integrable_on (f a) s) ⟶ real_integral s (λx. sum t (λa. f a x)) = sum t (λa. real_integral s (f a))
  [hint_backward,hint_backward1]
  proof
    2: apply_backward_step real_integral_unique
    2: apply_backward_step has_real_integral_sum
    2: introduction a
    2.2: apply_fact @1,2.1
    2.3: apply_backward_step real_integrable_integral @2.2
  qed

theorem real_integrable_sum
  fixes f :: 'a ⇒ real ⇒ real, s :: real set, t :: 'a set
  prop finite t ⟶ (∀a. a ∈ t ⟶ real_integrable_on (f a) s) ⟶ real_integrable_on (λx. sum t (λa. f a x)) s
  [hint_backward,hint_backward1]
  proof
    2: apply_backward_step has_real_integral_integrable param_i="sum t (λa. real_integral s (f a))"
    2: apply_backward_step has_real_integral_sum
    2: introduction a
    2.2: apply_backward_step real_integrable_integral
    2.2: apply_prev @1
  qed

theorem has_real_integral_eq
  fixes f :: real ⇒ real, g :: real ⇒ real, k :: real, s :: real set
  prop (∀x. x ∈ s ⟶ f x = g x) ⟶ has_real_integral f k s ⟶ has_real_integral g k s
  [hint_forward,hint_backward,hint_backward1]
  proof
    2: rewrite_fact real_sub_0 @0 sym=true
    3: apply_forward_step has_real_integral_is_0 @2
    4: apply_forward_step has_real_integral_sub @1,3
    5: rewrite_fact real_sub_rzero @4 sym=false
    6: cut "(λx. f x - (f x - g x)) = g"
    6: apply_backward_step extension
    6: z3
    8: rewrite_fact_with_prev @7,5
  qed

theorem real_integrable_eq
  fixes f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop (∀x. x ∈ s ⟶ f x = g x) ⟶ real_integrable_on f s ⟶ real_integrable_on g s
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal real_integrable_on_def sym=false
    2: rewrite_fact real_integrable_on_def @1 sym=false
    3: exists_elim y @2
    5: inst_exists_goal y
    5: apply_backward_step has_real_integral_eq @0,4
  qed

theorem has_real_integral_eq_eq
  fixes f :: real ⇒ real, g :: real ⇒ real, k :: real, s :: real set
  prop (∀x. x ∈ s ⟶ f x = g x) ⟶ has_real_integral f k s ⟷ has_real_integral g k s
  [hint_backward,hint_forward]
  proof
    1: apply_backward_step iffI
    1: introduction
    1.1: apply_backward_step has_real_integral_eq @0,1.0
    2: introduction
    2.1: rewrite_fact eq_sym_eq @0 sym=false
    2.2: apply_backward_step has_real_integral_eq @2.1,2.0
  qed

theorem has_real_integral_null
  fixes a :: real, b :: real, f :: real ⇒ real
  prop b ≤ a ⟶ has_real_integral f 0 (real_closed_interval a b)
  [hint_backward,hint_forward]

theorem has_real_integral_null_eq
  fixes a :: real, b :: real, f :: real ⇒ real, i :: real
  prop b ≤ a ⟶ has_real_integral f i (real_closed_interval a b) ⟷ i = 0
  [hint_backward,hint_forward]
  proof
    1: apply_forward_step has_real_integral_null @0 param_f=f
    2: apply_forward_step real_integral_unique @1
    3: apply_backward_step iffI
    3: introduction
    3.1: apply_backward_step has_real_integral_unique param_f=f param_i="real_closed_interval a b"
    4: introduction
    4.1: rewrite_goal_with_prev @4.0
  qed

theorem real_integral_null
  fixes a :: real, b :: real, f :: real ⇒ real
  prop b ≤ a ⟶ real_integral (real_closed_interval a b) f = 0
  [hint_backward,hint_forward]
  proof
    1: apply_backward_step real_integral_unique
    1: apply_backward_step has_real_integral_null
  qed

theorem real_integrable_on_null
  fixes a :: real, b :: real, f :: real ⇒ real
  prop b ≤ a ⟶ real_integrable_on f (real_closed_interval a b)
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal real_integrable_on_def
    1: inst_exists_goal "(0::real)"
    1: apply_backward_step has_real_integral_null
  qed

theorem has_real_integral_empty
  fixes f :: real ⇒ real
  prop has_real_integral f 0 ∅
  [hint_resolve,hint_rewrite,hint_backward]
  proof
    0: apply_backward_step has_real_integral_is_0
    0: introduction x
    0.2: apply_resolve_step member_empty @0.1
  qed

theorem has_real_integral_empty_eq
  fixes f :: real ⇒ real, i :: real
  prop has_real_integral f i ∅ ⟷ i = 0
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step has_real_integral_unique param_f=f param_i="({}::real set)"
    0.1: apply_backward_step has_real_integral_empty
    1: introduction
    1.1: rewrite_goal_with_prev @1.0
    1.1: apply_backward_step has_real_integral_empty
  qed

theorem real_integrable_on_empty
  fixes f :: real ⇒ real
  prop real_integrable_on f ∅
  [hint_backward,hint_resolve]
  proof
    0: rewrite_goal real_integrable_on_def
    0: rewrite_goal has_real_integral_empty_eq
    0: inst_exists_goal "(0::real)"
    0: apply_backward_step eq_refl
  qed

theorem real_integral_empty
  fixes f :: real ⇒ real
  prop real_integral ∅ f = 0
  [hint_rewrite]
  proof
    0: apply_backward_step real_integral_unique
    0: rewrite_goal has_real_integral_empty_eq
  qed

theorem has_real_integral_refl
  fixes a :: real, f :: real ⇒ real
  prop has_real_integral f 0 (real_closed_interval a a)
  [hint_backward]
  proof
    0: apply_backward_step has_real_integral_null
    0: apply_backward_step real_le_refl
  qed

theorem real_integrable_on_refl
  fixes a :: real, f :: real ⇒ real
  prop real_integrable_on f (real_closed_interval a a)
  [hint_backward]
  proof
    0: apply_backward_step real_integrable_on_null
    0: apply_backward_step real_le_refl
  qed

theorem real_integral_refl
  fixes a :: real, f :: real ⇒ real
  prop real_integral (real_closed_interval a a) f = 0
  [hint_rewrite]
  proof
    0: apply_backward_step real_integral_unique
    0: apply_backward_step has_real_integral_refl
  qed

theorem has_real_integral_const
  fixes a :: real, b :: real, c :: real
  prop a ≤ b ⟶ has_real_integral (λx. c) (c * (b - a)) (real_closed_interval a b)
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal real_mult_comm
  qed

theorem real_integrable_const
  fixes a :: real, b :: real, c :: real
  prop real_integrable_on (λx. c) (real_closed_interval a b)
  [hint_backward]
  proof
    0: rewrite_goal real_integrable_on_def
    0: cut "a <= b | b <= a"
    0: apply_backward_step real_le_total
    1: apply_backward_step disjE @0
    1: introduction
    1.1: inst_exists_goal "c * (b - a)"
    1.1: apply_backward_step has_real_integral_const
    2: introduction
    2.1: inst_exists_goal "(0::real)"
    2.1: apply_backward_step has_real_integral_null
  qed

theorem real_integral_const
  fixes a :: real, b :: real, c :: real
  prop a ≤ b ⟶ real_integral (real_closed_interval a b) (λx. c) = c * (b - a)
