  prop a ≤ b ⟶ ¬(p = -1) ⟶ real_integral (real_closed_interval a b) (λx. x ^ p) = evalat (λx. x ^ (p + 1) / (p + 1)) a b

theorem real_integral_inverse_pos_evalat
  fixes a :: real, b :: real
  prop a ≤ b ⟶ 0 < a ⟶ real_integral (real_closed_interval a b) (λx. x ^ -(1::real)) = evalat (λx. log x) a b

theorem real_integral_inverse_neg_evalat
