  prop a ≤ b ⟶ (∀x. x ∈ real_open_interval a b ⟶ ¬(sin x = 0)) ⟶ real_integral (real_closed_interval a b) (λx. sin x ^ -(2::real)) = evalat (λx. -(cot x)) a b

