theorem has_real_integral_negligible_eq
  fixes f :: real ⇒ real, s :: real set
  prop (∀x. x ∈ s ⟶ 0 ≤ f x) ⟶ has_real_integral f 0 s ⟷ real_negligible ({x. x ∈ s ∧ ¬(f x = 0)})
  [hint_backward,hint_forward]
  proof
    1: apply_backward_step iffI
    1: introduction
    1.1: apply_backward_step real_negligible_subset param_s="(Union ({t. ?n. t = {x. x ∈ s & abs (f x) >= (1::real) / (of_nat n + 1)}}))"
    1.1: apply_backward_step real_negligible_countable_unions
    1.1: introduction n
    1.1.1: rewrite_goal has_real_measure_0 sym=true
    1.1.1: rewrite_goal has_real_measure sym=false
    1.1.1: rewrite_goal member_collect sym=false
    1.1.1: apply_backward_step has_real_integral_straddle_null param_g="(λx. if x ∈ s then (of_nat n + 1) * f x else 0)"
    1.1.1: z3 @0
    1.1.2: rewrite_goal has_real_integral_restrict_univ sym=false
    1.1.2: cut "(0::real) = (of_nat n + 1) * 0"
    1.1.2: rewrite_goal real_mul_rzero sym=false
    1.1.3: rewrite_goal_with_prev @1.1.2
    1.1.3: apply_backward_step has_real_integral_lmul
    1.3: apply_backward_step subsetI
    1.3: introduction x
    1.3.2: rewrite_fact member_collect @1.3.1 sym=false
    1.3.3: apply_forward_step conjD2 @1.3.2
    1.3.4: cut "¬(f x = 0) <--> 0 < abs (f x)" @1.3.3
    1.3.4: z3
    1.3.5: rewrite_fact_with_prev @1.3.4,1.3.3
    1.3.6: rewrite_fact real_arch_inv @1.3.5 sym=false
    1.3.7: exists_elim n @1.3.6
    1.3.9: rewrite_goal member_Union sym=false
    1.3.9: rewrite_goal conj_comm sym=false
    1.3.9: rewrite_goal exists_in_gspec1 sym=false
    1.3.9: rewrite_goal member_collect sym=false
    1.3.9: apply_forward_step conjD1 @1.3.2
    1.3.10: inst_exists_goal n-1
    1.3.10: apply_backward_step conjI
    1.3.10: z3 @0,1.3.8
    2: introduction
    2.1: apply_backward_step has_real_integral_negligible param_s="({x. x ∈ s ∧ ¬(f x = 0)})"
    2.1: z3
  qed

theorem real_integration_by_parts
  fixes a :: real, b :: real, c :: real set, f :: real ⇒ real, f1 :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real, y :: real
  prop a ≤ b ⟶ countable c ⟶ real_continuous_on (λx. f x * g x) (real_closed_interval a b) ⟶ (∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)) ⟶ has_real_integral (λx. f x * g1 x) (f b * g b - f a * g a - y) (real_closed_interval a b) ⟶ has_real_integral (λx. f1 x * g x) y (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]
  proof
    5: apply_forward_step real_fundamental_theorem_of_calculus_interior_strong @1,0,2 param_f1="(λx. f x * g1 x + f1 x * g x) "
    6: cut "has_real_integral (λx. f x * g1 x + f1 x * g x) (f b * g b - f a * g a) (real_closed_interval a b)"
    6: apply_prev @5
    6: introduction x
    6.2: apply_backward_step has_real_derivative_mul_atreal
    6.2: apply_fact @3,6.1
    6.3: apply_backward_step conjD1 @6.2
    6.4: apply_backward_step conjD2 @6.2
    8: apply_forward_step has_real_integral_sub @7,4
    9: cut "(λx. f x * g1 x + f1 x * g x - f x * g1 x) = (λx. f1 x * g x)" @8
    9: apply_backward_step extension
    9: z3
    11: cut "f b * g b - f a * g a - (f b * g b - f a * g a - y) = y"
    11: real_norm
    12: rewrite_fact_with_prev @10,8
    13: rewrite_fact_with_prev @11,12
  qed

theorem real_integration_by_parts_simple
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real, y :: real
  prop a ≤ b ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b)) ∧ has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b))) ⟶ has_real_integral (λx. f x * g1 x) (f b * g b - f a * g a - y) (real_closed_interval a b) ⟶ has_real_integral (λx. f1 x * g x) y (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]

theorem real_integration_by_parts_simple_evalat
  fixes a :: real, b :: real, u :: real ⇒ real, v :: real ⇒ real
  prop a ≤ b ⟶ (∀x. x ∈ real_open_interval a b ⟶ real_differentiable u (atreal x) ∧ real_differentiable v (atreal x)) ⟶ real_integral (real_closed_interval a b) (λx. u x * real_derivative v x) = evalat (λx. u x * v x) a b - real_integral (real_closed_interval a b) (λx. real_derivative u x * v x)

theorem real_integrable_by_parts
  fixes a :: real, b :: real, c :: real set, f :: real ⇒ real, f1 :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real
  prop countable c ⟶ real_continuous_on (λx. f x * g x) (real_closed_interval a b) ⟶ (∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)) ⟶ real_integrable_on (λx. f x * g1 x) (real_closed_interval a b) ⟶ real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]
  proof
    4: cut "a <= b | b <= a"
    4: apply_backward_step real_le_total
    5: apply_backward_step disjE @4
    5: introduction
    5.1: rewrite_goal real_integrable_on_def sym=false
    5.1: rewrite_fact real_integrable_on_def @3 sym=false
    5.2: exists_elim y @5.1
    5.4: inst_exists_goal "(f b * g b - f a * g a - y)"
    5.4: apply_backward_step real_integration_by_parts @5.0,0,1,2
    5.4: cut "f b * g b - f a * g a - (f b * g b - f a * g a - y) = y"
    5.4: real_norm
    5.5: rewrite_goal_with_prev @5.4
    6: introduction
    6.1: apply_backward_step real_integrable_on_null
  qed

theorem real_integrable_by_parts_eq
  fixes a :: real, b :: real, c :: real set, f :: real ⇒ real, f1 :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real
  prop countable c ⟶ real_continuous_on (λx. f x * g x) (real_closed_interval a b) ⟶ (∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)) ⟶ real_integrable_on (λx. f x * g1 x) (real_closed_interval a b) ⟷ real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]
  proof
    3: apply_backward_step iffI
    3: introduction
    3.1: apply_backward_step real_integrable_by_parts @0,1,2,3.0
    4: introduction
    4.1: rewrite_goal real_mult_comm sym=false
    4.1: rewrite_fact real_mult_comm @1 sym=false
    4.2: rewrite_fact real_mult_comm @4.0 sym=false
    4.3: rewrite_fact conj_comm @2 sym=false
    4.4: apply_backward_step real_integrable_by_parts @0,4.1,4.3,4.2
  qed

theorem absolute_real_integration_by_parts
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real
  prop a ≤ b ⟶ absolutely_real_integrable_on f1 (real_closed_interval a b) ⟶ absolutely_real_integrable_on g1 (real_closed_interval a b) ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_integral f1 (f x) (real_closed_interval a x)) ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_integral g1 (g x) (real_closed_interval a x)) ⟶ absolutely_real_integrable_on (λx. f x * g1 x) (real_closed_interval a b) ∧ absolutely_real_integrable_on (λx. f1 x * g x) (real_closed_interval a b) ∧ real_integral (real_closed_interval a b) (λx. f x * g1 x) + real_integral (real_closed_interval a b) (λx. f1 x * g x) = f b * g b - f a * g a
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_integral_substitution_strong
  fixes a :: real, b :: real, c :: real, d :: real, f :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real, k :: real set
  prop countable k ⟶ real_integrable_on f (real_closed_interval c d) ⟶ real_continuous_on g (real_closed_interval a b) ⟶ image g (real_closed_interval a b) ⊆ real_closed_interval c d ⟶ (∀x. x ∈ diff (real_closed_interval a b) k ⟶ has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b)) ∧ real_continuous f (within (atreal (g x)) (real_closed_interval c d))) ⟶ a ≤ b ⟶ c ≤ d ⟶ g a ≤ g b ⟶ has_real_integral (λx. f (g x) * g1 x) (real_integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_integral_substitution
  fixes a :: real, b :: real, c :: real, d :: real, f :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real, k :: real set
  prop countable k ⟶ real_continuous_on f (real_closed_interval c d) ⟶ real_continuous_on g (real_closed_interval a b) ⟶ image g (real_closed_interval a b) ⊆ real_closed_interval c d ⟶ (∀x. x ∈ diff (real_closed_interval a b) k ⟶ has_real_derivative g (g1 x) (atreal x)) ⟶ a ≤ b ⟶ c ≤ d ⟶ g a ≤ g b ⟶ has_real_integral (λx. f (g x) * g1 x) (real_integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]

theorem real_integral_substitution
  fixes a :: real, b :: real, c :: real, d :: real, f :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real, k :: real set
  prop countable k ⟶ real_continuous_on f (real_closed_interval c d) ⟶ real_continuous_on g (real_closed_interval a b) ⟶ image g (real_closed_interval a b) ⊆ real_closed_interval c d ⟶ (∀x. x ∈ diff (real_closed_interval a b) k ⟶ has_real_derivative g (g1 x) (atreal x)) ⟶ a ≤ b ⟶ c ≤ d ⟶ g a ≤ g b ⟶ real_integral (real_closed_interval a b) (λx. f (g x) * g1 x) = real_integral (real_closed_interval (g a) (g b)) f
  [hint_backward,hint_backward1,hint_forward]
  proof
    8: apply_backward_step real_integral_unique
    8: apply_backward_step has_real_integral_substitution @0,1,2
  qed

theorem has_real_integral_substitution_simple
  fixes a :: real, b :: real, c :: real, d :: real, f :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real
  prop real_continuous_on f (real_closed_interval c d) ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b))) ⟶ image g (real_closed_interval a b) ⊆ real_closed_interval c d ⟶ a ≤ b ⟶ c ≤ d ⟶ g a ≤ g b ⟶ has_real_integral (λx. f (g x) * g1 x) (real_integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]

theorem real_integral_substitution_simple
  fixes a :: real, b :: real, c :: real, d :: real, f :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real
  prop real_continuous_on f (real_closed_interval c d) ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b))) ⟶ image g (real_closed_interval a b) ⊆ real_closed_interval c d ⟶ a ≤ b ⟶ c ≤ d ⟶ g a ≤ g b ⟶ real_integral (real_closed_interval a b) (λx. f (g x) * g1 x) = real_integral (real_closed_interval (g a) (g b)) f
  [hint_backward,hint_backward1,hint_forward]
  proof
    6: apply_backward_step real_integral_unique
    6: apply_backward_step has_real_integral_substitution_simple @0,1
  qed

theorem real_integral_substitution_simple_incr
  fixes a :: real, b :: real, f :: real ⇒ real, g :: real ⇒ real
  prop real_continuous_on f (real_closed_interval (g a) (g b)) ⟶ (∀x. x ∈ real_open_interval a b ⟶ real_differentiable g (atreal x) ∧ real_derivative g x ≥ 0) ⟶ a ≤ b ⟶ real_integral (real_closed_interval a b) (λx. f (g x) * real_derivative g x) = real_integral (real_closed_interval (g a) (g b)) f

theorem real_integral_substitution_simple_decr
  fixes a :: real, b :: real, f :: real ⇒ real, g :: real ⇒ real
  prop real_continuous_on f (real_closed_interval (g a) (g b)) ⟶ (∀x. x ∈ real_open_interval a b ⟶ real_differentiable g (atreal x) ∧ real_derivative g x ≤ 0) ⟶ a ≤ b ⟶ real_integral (real_closed_interval a b) (λx. f (g x) * real_derivative g x) = real_integral (real_closed_interval (g b) (g a)) (λx. -(f x))

theorem real_monotone_convergence_increasing_ae
  fixes f :: nat ⇒ real ⇒ real, g :: real ⇒ real, s :: real set
  prop (∀k. real_integrable_on (f k) s) ⟶ (∀k. ∀x. x ∈ s ⟶ f k x ≤ f (Suc k) x) ⟶ (∃t. real_negligible t ∧ (∀x. x ∈ diff s t ⟶ tendsto_real (λk. f k x) (g x) sequentially)) ⟶ real_bounded ({y. ∃k. y = real_integral s (f k)}) ⟶ real_integrable_on g s ∧ tendsto_real (λk. real_integral s (f k)) (real_integral s g) sequentially
  [hint_backward,hint_backward1]

theorem real_open_set_rational
  fixes s :: real set
  prop real_open s ⟶ ¬(s = ∅) ⟶ (∃x. rational x ∧ x ∈ s)
  [hint_backward,hint_backward1]

theorem real_open_rational
  fixes P :: real ⇒ bool
  prop real_open ({x. P x}) ⟶ (∃x. P x) ⟶ (∃x. rational x ∧ P x)
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step real_open_set_rational @0
    3: rewrite_fact member_collect @2 sym=false
    4: apply_prev @3
    4: z3 @1
  qed

theorem real_open_set_exists_rational
  fixes s :: real set
  prop real_open s ⟶ (∃x. rational x ∧ x ∈ s) ⟷ (∃x. x ∈ s)
  [hint_backward]
  proof
    1: apply_backward_step iffI
    1: introduction
    1.1: exists_elim x @1.0
    1.3: apply_forward_step conjD2 @1.2
    1.4: apply_backward_step exI @1.3
    2: introduction
    2.1: apply_backward_step real_open_set_rational
    2.1: z3 @2.0
  qed

theorem real_open_exists_rational
  fixes P :: real ⇒ bool
  prop real_open ({x. P x}) ⟶ (∃x. rational x ∧ P x) ⟷ (∃x. P x)
  [hint_backward]
  proof
    1: apply_forward_step real_open_set_exists_rational @0
    2: rewrite_fact member_collect @1 sym=false
  qed

theorem real_continuous_on_const_dyadic_rationals
  fixes a :: real, f :: real ⇒ real
  prop real_continuous_on f univ ⟶ (∀x. integer x ⟶ f x = a) ⟶ (∀x. f x = a ⟶ f (x / 2) = a) ⟶ (∀x. f x = a)
  [hint_backward,hint_backward1]

theorem real_continuous_additive_imp_linear
  fixes f :: real ⇒ real
  prop real_continuous_on f univ ⟶ (∀x. ∀y. f (x + y) = f x + f y) ⟶ (∀a. ∀x. f (a * x) = a * f x)
  [hint_backward,hint_backward1]

theorem real_continuous_floor
  fixes x :: real
  prop ¬(integer x) ⟶ real_continuous floor (atreal x)
  [hint_backward]
  proof
    1: rewrite_goal real_continuous_atreal1 sym=false
    1: introduction e
    1.2: inst_exists_goal "min (x - floor x) ((floor x + 1) - x)"
    1.2: apply_backward_step conjI
    1.2: rewrite_goal real_lt_min sym=false
    1.2: apply_backward_step conjI
    1.2: rewrite_goal real_sub_lt sym=false
    1.2: rewrite_goal real_floor_lt_refl sym=false
    1.4: apply_forward_step floor param_x=x
    1.5: rewrite_goal real_sub_lt sym=false
    1.5: apply_forward_step conjD2 @1.4
    1.6: apply_backward_step conjD2 @1.5
    1.10: introduction x1
    1.10.2: cut "!x. !y. x = y --> abs (x-y) < e"
    1.10.2: z3 @1.1
    1.10.3: apply_prev @1.10.2
    1.10.3: rewrite_goal floor_unique sym=true
    1.10.3: apply_backward_step conjI
    1.10.3: apply_backward_step conjD1 @1.4
    1.10.4: apply_backward_step conjI
    1.10.4: rewrite_fact real_lt_min @1.10.1 sym=false
    1.10.5: apply_forward_step conjD1 @1.10.4
    1.10.6: cut "!y. abs(x1 -x) < x - y --> y <= x1"
    1.10.6: z3
    1.10.7: apply_prev @1.10.6
    1.10.8: apply_forward_step conjD2 @1.10.4
    1.10.9: cut "∀y. abs (x1 - x) < y+1 - x ⟶ x1 < y + 1"
    1.10.9: z3
    1.10.10: apply_prev @1.10.9
  qed
