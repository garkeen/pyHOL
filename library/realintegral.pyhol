    2: cut "real_measurable (⋃({y. ∃n. y = s n})) ∧ real_sums (λn. real_measure (s n)) (real_measure (⋃({y. ∃n. y = s n}))) (from 0)"
    2: apply_prev @1
    2: introduction n
    2.1: rewrite_goal real_measurable_def sym=false
    2.1: inst_exists_goal "(0::real)"
    2.1: rewrite_goal has_real_measure_0 sym=false
    2.1: apply_prev @0
    3: introduction m,n
    3.3: apply_backward_step real_negligible_subset param_s="s n"
    3.3: apply_prev @0
    3.4: rewrite_goal inter_comm sym=false
    3.4: apply_backward_step inter_subset_id
    4: introduction n
    4.1: rewrite_goal real_le_lt sym=false
    4.1: apply_backward_step disjI2
    4.1: apply_backward_step sum_eq_0
    4.1: introduction x
    4.1.2: apply_backward_step real_measure_eq_0
    4.1.2: apply_prev @0
    6: apply_forward_step conjD1 @5
    7: apply_forward_step real_measurable_real_measure_eq_0 @6
    8: rewrite_fact eq_sym_eq @7 sym=false
    9: rewrite_goal_with_prev @8
    9: apply_backward_step real_series_unique param_f="(%k::nat. (0::real))" param_s="from 0"
    9: apply_forward_step conjD2 @5
    10: cut "(λn. real_measure (s n)) = (λk. (0::real))" @9
    10: apply_backward_step extension
    10: introduction x
    10.1: apply_backward_step real_measure_eq_0
    10.1: apply_prev @0
    12: rewrite_fact_with_prev @11,9
    13: apply_backward_step real_series_0
  qed

theorem real_measurable_countable_unions_strong
  fixes B :: real, s :: nat ⇒ real set
  prop (∀n. real_measurable (s n)) ⟶ (∀n. real_measure (⋃({y. ∃k. y = s k ∧ k ≤ n})) ≤ B) ⟶ real_measurable (⋃({y. ∃n. y = s n}))
  [hint_backward,hint_backward1,hint_forward]
  proof
    1: apply_forward_step real_measurable_nested_unions param_B=B param_s="(%n. Union (image s {0..n}))"
    2: cut "⋃({y. ∃n. y = ⋃(image s ({0..n}))}) = ⋃({y. ∃n. y = s n})"
    2: apply_backward_step member_ext
    2: introduction x
    2.1: rewrite_goal member_Union sym=false
  qed

theorem has_real_measure_countable_real_negligible_unions_bounded
  fixes s :: nat ⇒ real set
  prop (∀n. real_measurable (s n)) ⟶ (∀m. ∀n. ¬(m = n) ⟶ real_negligible (s m ∩ s n)) ⟶ real_bounded (⋃({y. ∃n. y = s n})) ⟶ real_measurable (⋃({y. ∃n. y = s n})) ∧ real_sums (λn. real_measure (s n)) (real_measure (⋃({y. ∃n. y = s n}))) (from 0)
  [hint_backward,hint_backward1,hint_forward]

theorem real_measurable_countable_unions
  fixes B :: real, s :: nat ⇒ real set
  prop (∀n. real_measurable (s n)) ⟶ (∀n. sum ({0..n}) (λk. real_measure (s k)) ≤ B) ⟶ real_measurable (⋃({y. ∃n. y = s n}))
  [hint_backward,hint_backward1,hint_forward]

theorem real_measurable_countable_unions_bounded
  fixes s :: nat ⇒ real set
  prop (∀n. real_measurable (s n)) ⟶ real_bounded (⋃({y. ∃n. y = s n})) ⟶ real_measurable (⋃({y. ∃n. y = s n}))
  [hint_backward,hint_backward1,hint_forward]

theorem real_measurable_countable_inters
