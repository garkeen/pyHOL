theorem real_negligible_countable
  fixes s :: real set
  prop countable s ⟶ real_negligible s
  [hint_backward,hint_forward]

theorem real_measurable_compact
  fixes s :: real set
  prop real_compact s ⟶ real_measurable s
  [hint_backward,hint_forward]

theorem real_measurable_open
  fixes s :: real set
  prop real_bounded s ⟶ real_open s ⟶ real_measurable s
