theorem real_measure_disjoint_unions_image_strong
  fixes f :: 'a ⇒ real set, s :: 'a set
  prop finite ({x. x ∈ s ∧ ¬(f x = ∅)}) ⟶ (∀x. x ∈ s ⟶ real_measurable (f x)) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ disjoint (f x) (f y)) ⟶ real_measure (⋃(image f s)) = sum s (λx. real_measure (f x))
