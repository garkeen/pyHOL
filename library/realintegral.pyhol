    7.10: rewrite_fact real_mult_comm @7.9 sym=false
    7.11: rewrite_fact real_mult_assoc @7.10 sym=false
    7.12: cut "real_inverse 2 * 2 =1"
    7.12: apply_backward_step real_mul_linv
    7.12: z3
    7.14: rewrite_fact_with_prev @7.13,7.11
    7.15: rewrite_fact real_mul_lid @7.14 sym=false
    7.16: rewrite_goal real_mult_comm sym=false
  qed

