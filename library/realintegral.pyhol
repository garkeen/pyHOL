  prop finite s ⟶ (∀x. x ∈ s ⟶ real_measurable (f x)) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ disjoint (f x) (f y)) ⟶ has_real_measure (⋃(image f s)) (sum s (λx. real_measure (f x)))
  [hint_backward,hint_backward1,hint_forward]
  proof
    3: apply_backward_step has_real_measure_real_negligible_unions_image @0,1
    3: introduction x,y
    3.5: apply_fact @2,3.2,3.3,3.4
    3.6: rewrite_fact disjoint_def @3.5 sym=false
    3.7: rewrite_goal_with_prev @3.6
    3.7: apply_backward_step real_negligible_empty
  qed

theorem real_measure_disjoint_unions_image
  fixes f :: 'a ⇒ real set, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ real_measurable (f x)) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ disjoint (f x) (f y)) ⟶ real_measure (⋃(image f s)) = sum s (λx. real_measure (f x))
  [hint_backward,hint_backward1,hint_forward]
  proof
    3: apply_backward_step real_measure_unique
    3: apply_backward_step has_real_measure_disjoint_unions_image @0,1,2
  qed

theorem has_real_measure_real_negligible_unions_image_strong
  fixes f :: 'a ⇒ real set, s :: 'a set
  prop finite ({x. x ∈ s ∧ ¬(f x = ∅)}) ⟶ (∀x. x ∈ s ⟶ real_measurable (f x)) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ real_negligible (f x ∩ f y)) ⟶ has_real_measure (⋃(image f s)) (sum s (λx. real_measure (f x)))
  [hint_backward,hint_backward1,hint_forward]

theorem real_measure_real_negligible_unions_image_strong
  fixes f :: 'a ⇒ real set, s :: 'a set
  prop finite ({x. x ∈ s ∧ ¬(f x = ∅)}) ⟶ (∀x. x ∈ s ⟶ real_measurable (f x)) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ real_negligible (f x ∩ f y)) ⟶ real_measure (⋃(image f s)) = sum s (λx. real_measure (f x))
  [hint_backward,hint_backward1,hint_forward]
  proof
    3: apply_backward_step real_measure_unique
    3: apply_backward_step has_real_measure_real_negligible_unions_image_strong @0,1,2
  qed

