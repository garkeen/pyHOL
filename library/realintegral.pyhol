  prop (∀k. real_integrable_on (f k) s) ⟶ real_integrable_on h s ⟶ (∀k. ∀x. x ∈ s ⟶ abs (f k x) ≤ h x) ⟶ (∀x. x ∈ s ⟶ tendsto_real (λk. f k x) (g x) sequentially) ⟶ real_integrable_on g s ∧ tendsto_real (λk. real_integral s (f k)) (real_integral s g) sequentially
