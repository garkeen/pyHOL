  prop a ≤ b ⟶ (∀x. x ∈ real_open_interval a b ⟶ ¬(cos x = 0)) ⟶ real_integral (real_closed_interval a b) (λx. cos x ^ -(2::real)) = evalat (λx. tan x) a b

theorem real_integral_to_cot_evalat
