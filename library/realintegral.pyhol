theorem real_integral_subset_le
  fixes f :: real ⇒ real, s :: real set, t :: real set
  prop s ⊆ t ⟶ real_integrable_on f s ⟶ real_integrable_on f t ⟶ (∀x. x ∈ t ⟶ 0 ≤ f x) ⟶ real_integral s f ≤ real_integral t f
  [hint_backward,hint_forward,hint_backward1]
  proof
    4: apply_backward_step has_real_integral_subset_le param_f=f param_s=s param_t=t
    4: apply_backward_step real_integrable_integral @1
    5: apply_backward_step real_integrable_integral @2
  qed

theorem real_integrable_on_subinterval
  fixes a :: real, b :: real, f :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_closed_interval a b ⊆ s ⟶ real_integrable_on f (real_closed_interval a b)
  [hint_backward,hint_forward,hint_backward1]

theorem real_integrable_on_subinterval_gen
  fixes f :: real ⇒ real, s :: real set, t :: real set
  prop real_integrable_on f s ⟶ t ⊆ s ⟶ is_realinterval t ⟶ real_integrable_on f t
  [hint_backward,hint_forward,hint_backward1]

theorem real_integrable_straddle
  fixes f :: real ⇒ real, s :: real set
  prop (∀e. 0 < e ⟶ (∃g. ∃h. ∃i. ∃j. has_real_integral g i s ∧ has_real_integral h j s ∧ abs (i - j) < e ∧ (∀x. x ∈ s ⟶ g x ≤ f x ∧ f x ≤ h x))) ⟶ real_integrable_on f s
  [hint_backward]

theorem has_real_integral_straddle_null
  fixes f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop (∀x. x ∈ s ⟶ 0 ≤ f x ∧ f x ≤ g x) ⟶ has_real_integral g 0 s ⟶ has_real_integral f 0 s
  [hint_backward,hint_forward,hint_backward1]
  proof
    2: rewrite_goal has_real_integral_integrable_integral sym=false
    2: apply_backward_step conjI
    2: apply_backward_step real_integrable_straddle
    2: introduction e
    2.2: inst_exists_goal "(%x::real. (0::real))"
    2.2: inst_exists_goal g
    2.2: inst_exists_goal "(0::real)"
    2.2: inst_exists_goal "(0::real)"
    2.2: apply_backward_step conjI
    2.2: apply_backward_step has_real_integral_0
    2.3: apply_backward_step conjI
    2.3: apply_backward_step conjI
    2.3: z3 @2.1
    4: rewrite_goal real_le_antisym sym=true
    4: apply_backward_step conjI
    4: apply_backward_step has_real_integral_le param_f=f param_g=g param_s=s
    4: apply_backward_step real_integrable_integral @3
    5: z3 @0
    7: apply_backward_step has_real_integral_le param_f="(%x::real. (0::real))" param_g=f param_s=s
    7: apply_backward_step has_real_integral_0
    8: z3 @0
  qed

theorem has_real_integral_union
  fixes f :: real ⇒ real, i :: real, j :: real, s :: real set, t :: real set
  prop has_real_integral f i s ⟶ has_real_integral f j t ⟶ real_negligible (s ∩ t) ⟶ has_real_integral f (i + j) (s ∪ t)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_integral_unions
  fixes f :: real ⇒ real, i :: real set ⇒ real, t :: real set set
  prop finite t ⟶ (∀s. s ∈ t ⟶ has_real_integral f (i s) s) ⟶ (∀s. ∀s1. s ∈ t ⟶ s1 ∈ t ⟶ ¬(s = s1) ⟶ real_negligible (s ∩ s1)) ⟶ has_real_integral f (sum t i) (⋃t)
  [hint_backward]

theorem real_indefinite_integral_continuous
  fixes a :: real, b :: real, c :: real, d :: real, e :: real, f :: real ⇒ real
  prop real_integrable_on f (real_closed_interval a b) ⟶ c ∈ real_closed_interval a b ⟶ d ∈ real_closed_interval a b ⟶ 0 < e ⟶ (∃k. 0 < k ∧ (∀c1. ∀d1. c1 ∈ real_closed_interval a b ⟶ d1 ∈ real_closed_interval a b ⟶ abs (c1 - c) ≤ k ⟶ abs (d1 - d) ≤ k ⟶ abs (real_integral (real_closed_interval c1 d1) f - real_integral (real_closed_interval c d) f) < e))
  [hint_backward]

theorem real_monotone_convergence_increasing
  fixes f :: nat ⇒ real ⇒ real, g :: real ⇒ real, s :: real set
  prop (∀k. real_integrable_on (f k) s) ⟶ (∀k. ∀x. x ∈ s ⟶ f k x ≤ f (Suc k) x) ⟶ (∀x. x ∈ s ⟶ tendsto_real (λk. f k x) (g x) sequentially) ⟶ real_bounded ({y. ∀k. y = real_integral s (f k)}) ⟶ real_integrable_on g s ∧ tendsto_real (λk. real_integral s (f k)) (real_integral s g) sequentially
  [hint_backward]

theorem real_monotone_convergence_decreasing
  fixes f :: nat ⇒ real ⇒ real, g :: real ⇒ real, s :: real set
  prop (∀k. real_integrable_on (f k) s) ⟶ (∀k. ∀x. x ∈ s ⟶ f (Suc k) x ≤ f k x) ⟶ (∀x. x ∈ s ⟶ tendsto_real (λk. f k x) (g x) sequentially) ⟶ real_bounded ({y. ∀k. y = real_integral s (f k)}) ⟶ real_integrable_on g s ∧ tendsto_real (λk. real_integral s (f k)) (real_integral s g) sequentially
  [hint_backward]

theorem real_beppo_levi_increasing
  fixes f :: nat ⇒ real ⇒ real, s :: real set
  prop (∀k. real_integrable_on (f k) s) ⟶ (∀k. ∀x. x ∈ s ⟶ f k x ≤ f (Suc k) x) ⟶ real_bounded ({y. ∀k. y = real_integral s (f k)}) ⟶ (∃g. ∃k. real_negligible k ∧ (∀x. x ∈ diff s k ⟶ tendsto_real (λk1. f k1 x) (g x) sequentially))
  [hint_backward]

theorem real_beppo_levi_decreasing
  fixes f :: nat ⇒ real ⇒ real, s :: real set
  prop (∀k. real_integrable_on (f k) s) ⟶ (∀k. ∀x. x ∈ s ⟶ f (Suc k) x ≤ f k x) ⟶ real_bounded ({y. ∀k. y = real_integral s (f k)}) ⟶ (∃g. ∃k. real_negligible k ∧ (∀x. x ∈ diff s k ⟶ tendsto_real (λk1. f k1 x) (g x) sequentially))
  [hint_backward]

theorem real_beppo_levi_monotone_convergence_increasing
  fixes f :: nat ⇒ real ⇒ real, s :: real set
  prop (∀k. real_integrable_on (f k) s) ⟶ (∀k. ∀x. x ∈ s ⟶ f k x ≤ f (Suc k) x) ⟶ real_bounded ({y. ∀k. y = real_integral s (f k)}) ⟶ (∃g. ∃k. real_negligible k ∧ (∀x. x ∈ diff s k ⟶ tendsto_real (λk1. f k1 x) (g x) sequentially) ∧ real_integrable_on g s ∧ tendsto_real (λk1. real_integral s (f k1)) (real_integral s g) sequentially)
  [hint_backward]

theorem real_beppo_levi_monotone_convergence_decreasing
  fixes f :: nat ⇒ real ⇒ real, s :: real set
  prop (∀k. real_integrable_on (f k) s) ⟶ (∀k. ∀x. x ∈ s ⟶ f (Suc k) x ≤ f k x) ⟶ real_bounded ({y. ∀k. y = real_integral s (f k)}) ⟶ (∃g. ∃k. real_negligible k ∧ (∀x. x ∈ diff s k ⟶ tendsto_real (λk1. f k1 x) (g x) sequentially) ∧ real_integrable_on g s ∧ tendsto_real (λk1. real_integral s (f k1)) (real_integral s g) sequentially)
  [hint_backward]

theorem real_integral_abs_bound_integral
  fixes f :: real ⇒ real, g :: real ⇒ real, s :: real set
  prop real_integrable_on f s ⟶ real_integrable_on g s ⟶ (∀x. x ∈ s ⟶ abs (f x) ≤ g x) ⟶ abs (real_integral s f) ≤ real_integral s g
  [hint_backward]
  proof
    3: rewrite_goal real_abs_bounds sym=false
    3: rewrite_fact real_abs_bounds @2 sym=false
    4: apply_backward_step conjI
    4: apply_backward_step has_real_integral_le param_f="(%x. -g x)" param_g=f param_s=s
    4: apply_backward_step has_real_integral_neg
    4: apply_backward_step real_integrable_integral @1
    6: apply_backward_step real_integrable_integral @0
    7: z3 @3
    9: apply_backward_step real_integral_le
    9: z3 @3
  qed

theorem absolutely_real_integrable_le
  fixes f :: real ⇒ real, s :: real set
  prop absolutely_real_integrable_on f s ⟶ abs (real_integral s f) ≤ real_integral s (λx. abs (f x))
  [hint_backward,hint_forward]
  proof
    1: apply_backward_step real_integral_abs_bound_integral
    1: rewrite_fact absolutely_real_integrable_on_def @0
    2: apply_backward_step conjD1 @1
    3: apply_backward_step conjD2 @1
    4: z3 @1
  qed

