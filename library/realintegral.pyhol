  prop a ≤ b ⟶ b < 0 ⟶ real_integral (real_closed_interval a b) (λx. x ^ -(1::real)) = evalat (λx. log (-x)) a b

theorem real_integral_inverse_pow_evalat_pos
  fixes a :: real, b :: real, n :: nat
  prop a ≤ b ⟶ 0 < a ⟶ 1 < n ⟶ real_integral (real_closed_interval a b) (λx. 1 / x ^ n) = evalat (λx. 1 / (-(of_nat n - 1) * x ^ (n - 1))) a b

