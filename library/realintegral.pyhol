theorem real_measure_scaling
  fixes c :: real, s :: real set
  prop real_measurable s ⟶ real_measure (image (λx. c * x) s) = abs c * real_measure s
  [hint_backward,hint_forward]
  proof
    1: rewrite_fact has_real_measure_mesure @0
    2: apply_backward_step real_measure_unique
    2: apply_backward_step has_real_measure_scaling @1
  qed

theorem has_real_measure_nested_unions
  fixes B :: real, s :: nat ⇒ real set
  prop (∀n. real_measurable (s n)) ⟶ (∀n. real_measure (s n) ≤ B) ⟶ (∀n. s n ⊆ s (Suc n)) ⟶ real_measurable (⋃({y. ∃n. y = s n})) ∧ tendsto_real (λn. real_measure (s n)) (real_measure (⋃({y. ∃n. y = s n}))) sequentially
  [hint_backward,hint_backward1,hint_forward]

theorem real_measurable_nested_unions
  fixes B :: real, s :: nat ⇒ real set
  prop (∀n. real_measurable (s n)) ⟶ (∀n. real_measure (s n) ≤ B) ⟶ (∀n. s n ⊆ s (Suc n)) ⟶ real_measurable (⋃({y. ∃n. y = s n}))
  [hint_backward,hint_backward1,hint_forward]
  proof
    3: apply_forward_step has_real_measure_nested_unions @0,1,2
    4: apply_backward_step conjD1 @3
  qed

theorem has_real_measure_countable_real_negligible_unions
  fixes B :: real, s :: nat ⇒ real set
  prop (∀n. real_measurable (s n)) ⟶ (∀m. ∀n. ¬(m = n) ⟶ real_negligible (s m ∩ s n)) ⟶ (∀n. sum ({0..n}) (λk. real_measure (s k)) ≤ B) ⟶ real_measurable (⋃({y. ∃n. y = s n})) ∧ real_sums (λn. real_measure (s n)) (real_measure (⋃({y. ∃n. y = s n}))) (from 0)
  [hint_backward,hint_forward,hint_backward1]

theorem real_negligible_countable_unions
  fixes s :: nat ⇒ real set
  prop (∀n. real_negligible (s n)) ⟶ real_negligible (⋃({y. ∃n. y = s n}))
  [hint_backward,hint_forward]
