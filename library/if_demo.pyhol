theory if_demo
imports hoare
description "translated from .imp"

theorem if_demo_vc_0
  fixes n :: nat
  prop !s. true --> (if ~(reg s 0 = n) then reg (Pair ((reg s)(0 := n)) (heap s)) 0 = n else reg s 0 = n)
proof
  ← z3 goal=0
qed

theorem if_demo
  fixes n :: nat
  prop Valid (%st. true) (Cond (%st. ~(reg st 0 = n)) (AssignV (%st. 0) (%st. n)) Skip) (%st. reg st 0 = n)

