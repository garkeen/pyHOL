  fixes c :: real, f :: real => real, s :: real set
  prop real_uniformly_continuous_on f s --> real_uniformly_continuous_on (%x. f x * c) s

theorem real_uniformly_continuous_on_neg
  fixes f :: real => real, s :: real set
