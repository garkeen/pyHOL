theorem real_continuous_div_atreal
  fixes a :: real, f :: real => real, g :: real => real
  prop real_continuous f (atreal a) --> real_continuous g (atreal a) --> ~(g a = 0) --> real_continuous (%x. f x / g x) (atreal a)
