  [hint_backward,hint_backward1]

theorem real_uniformly_continuous_on_sum
  fixes f :: 'a => real => real, s :: 'a set, t :: real set
  prop finite s --> (!a. a Mem s --> real_uniformly_continuous_on (f a) t) --> real_uniformly_continuous_on (%x. sum s (%a. f a x)) t

theorem real_compact_uniformly_continuous
  fixes f :: real => real, s :: real set
  prop real_continuous_on f s --> real_compact s --> real_uniformly_continuous_on f s
  [hint_backward,hint_backward1]

theorem real_compact_continuous_image
  fixes f :: real => real, s :: real set
  prop real_continuous_on f s --> real_compact s --> real_compact (image f s)
  [hint_backward,hint_backward1]

theorem real_dini
  fixes f :: nat => real => real, g :: real => real, s :: real set
  prop real_compact s --> (!n. real_continuous_on (f n) s) --> real_continuous_on g s --> (!x. x Mem s --> tendsto_real (%n. f n x) (g x) sequentially) --> (!n. !x. x Mem s --> f n x <= f (n + 1) x) --> (!e. 0 < e --> eventually (%n. !x. x Mem s --> abs (f n x - g x) < e) sequentially)

