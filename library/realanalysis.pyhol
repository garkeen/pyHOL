  fixes f :: real => real, n :: nat, s :: real set
  prop real_continuous_on f s --> real_continuous_on (%x. f x ^ n) s
  [hint_backward]

theorem real_continuous_on_real_pow
  fixes f :: real => real, p :: real => real, s :: real set
  prop real_continuous_on p s --> real_continuous_on f s --> (!x. x Mem s --> p x >= 0) --> (!x. x Mem s --> f x >= 0) --> real_continuous_on (%x. f x ^ p x) s

