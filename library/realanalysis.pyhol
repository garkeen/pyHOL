theorem real_continuous_withinreal_compose
  fixes f :: real => real, g :: real => real, s :: real set, x :: real
  prop real_continuous f (within (atreal x) s) --> real_continuous g (within (atreal (f x)) (image f s)) --> real_continuous (%x1. g (f x1)) (within (atreal x) s)
  [hint_backward,hint_backward1]

theorem real_continuous_atreal_compose
  fixes f :: real => real, g :: real => real, x :: real
  prop real_continuous f (atreal x) --> real_continuous g (atreal (f x)) --> real_continuous (%x1. g (f x1)) (atreal x)
  [hint_backward,hint_backward1,hint_forward]

def real_continuous_on :: (real ⇒ real) ⇒ real set ⇒ bool = real_continuous_on f s ⟷ (∀x. x ∈ s ⟶ (∀e. 0 < e ⟶ (∃d. 0 < d ∧ (∀x1. x1 ∈ s ∧ abs (x1 - x) < d ⟶ abs (f x1 - f x) < e))))

