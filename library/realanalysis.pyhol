  fixes f :: real => real, g :: real => real, s :: real set
  prop real_continuous_on f s --> real_continuous_on g s --> real_continuous_on (%x. min (f x) (g x)) s

theorem real_continuous_on_eq
  fixes f :: real => real, g :: real => real, s :: real set
  prop (!x. x Mem s --> f x = g x) --> real_continuous_on f s --> real_continuous_on g s

theorem real_continuous_on_union
  fixes f :: real => real, s :: real set, t :: real set
  prop real_closed s --> real_closed t --> real_continuous_on f s --> real_continuous_on f t --> real_continuous_on f (s Un t)

theorem real_continuous_on_union_open
  fixes f :: real => real, s :: real set, t :: real set
  prop real_open s --> real_open t --> real_continuous_on f s --> real_continuous_on f t --> real_continuous_on f (s Un t)

theorem real_continuous_on_cases
  fixes P :: real => bool, f :: real => real, g :: real => real, s :: real set, t :: real set
  prop real_closed s --> real_closed t --> real_continuous_on f s --> real_continuous_on f t --> (!x. x Mem s & ~(P x) | x Mem t & P x --> f x = g x) --> real_continuous_on (%x. if P x then f x else g x) (s Un t)
  [hint_backward]

theorem real_continuous_on_cases_open
  fixes P :: real => bool, f :: real => real, g :: real => real, s :: real set, t :: real set
  prop real_open s --> real_open t --> real_continuous_on f s --> real_continuous_on f t --> (!x. x Mem s & ~(P x) | x Mem t & P x --> f x = g x) --> real_continuous_on (%x. if P x then f x else g x) (s Un t)

theorem real_continuous_sum
  fixes f :: 'a => 'b => real, net :: 'b net, s :: 'a set
  prop finite s --> (!a. a Mem s --> real_continuous (f a) net) --> real_continuous (%x. sum s (%a. f a x)) net

theorem real_continuous_product
  fixes f :: 'a => 'b => real, net :: 'b net, s :: 'a set
  prop finite s --> (!a. a Mem s --> real_continuous (f a) net) --> real_continuous (%x. product s (%a. f a x)) net

theorem real_continuous_on_sum
  fixes f :: 'a => real => real, s :: 'a set, t :: real set
  prop finite s --> (!a. a Mem s --> real_continuous_on (f a) t) --> real_continuous_on (%x. sum s (%a. f a x)) t

