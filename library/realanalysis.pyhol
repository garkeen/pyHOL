  prop real_continuous_on f s --> (!x. x Mem s --> f x < 0) --> real_continuous_on (%x. f x ^ -(1::real)) s

theorem real_continuous_on_abs
  fixes s :: real set
  prop real_continuous_on abs s

theorem real_continuous_on_abs_compose
  fixes f :: real => real, s :: real set
  prop real_continuous_on f s --> real_continuous_on (%x. abs (f x)) s

theorem real_continuous_on_max
  fixes f :: real => real, g :: real => real, s :: real set
  prop real_continuous_on f s --> real_continuous_on g s --> real_continuous_on (%x. max (f x) (g x)) s
