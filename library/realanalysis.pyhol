  prop real_continuous_on f s --> (!x. x Mem s --> ~(f x = 0)) --> real_continuous_on (%x. real_inverse (f x)) s
  [hint_backward,hint_backward1,hint_forward]

theorem real_continuous_on_div
  fixes f :: real => real, g :: real => real, s :: real set
  prop real_continuous_on f s --> real_continuous_on g s --> (!x. x Mem s --> ~(g x = 0)) --> real_continuous_on (%x. f x / g x) s
