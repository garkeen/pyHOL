theorem real_continuous_on_eq_real_continuous_at
  fixes f :: real => real, s :: real set
  prop real_open s --> real_continuous_on f s <--> (!x. x Mem s --> real_continuous f (atreal x))

theorem real_continuous_attains_sup
  fixes f :: real => real, s :: real set
  prop real_compact s --> ~(s = {}) --> real_continuous_on f s --> (?x. x Mem s & (!y. y Mem s --> f y <= f x))

theorem real_continuous_attains_inf
  fixes f :: real => real, s :: real set
  prop real_compact s --> ~(s = {}) --> real_continuous_on f s --> (?x. x Mem s & (!y. y Mem s --> f x <= f y))
  [hint_backward,hint_backward1]

def real_uniformly_continuous_on :: (real ⇒ real) ⇒ real set ⇒ bool = real_uniformly_continuous_on f s ⟷ (∀e. 0 < e ⟶ (∃d. 0 < d ∧ (∀x. ∀x1. x ∈ s ⟶ x1 ∈ s ⟶ abs (x1 - x) < d ⟶ abs (f x1 - f x) < e))) [hint_rewrite]

theorem real_uniformly_continuous_imp_real_continuous
  fixes f :: real => real, s :: real set
  prop real_uniformly_continuous_on f s --> real_continuous_on f s

theorem real_uniformly_continuous_on_sequentially
  fixes f :: real => real, s :: real set
  prop real_uniformly_continuous_on f s <--> (!x. !y. (!n. x n Mem s) --> (!n. y n Mem s) --> tendsto_real (%n. x n - y n) 0 sequentially --> tendsto_real (%n. f (x n) - f (y n)) 0 sequentially)
  [hint_rewrite]

theorem real_uniformly_continuous_on_subset
  fixes f :: real => real, s :: real set, t :: real set
  prop real_uniformly_continuous_on f s --> t Sub s --> real_uniformly_continuous_on f t

theorem real_uniformly_continuous_on_compose
