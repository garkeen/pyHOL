    4.11.2.1: apply_backward_step conjI
    4.11.2.1: rewrite_goal_with_prev @4.11.2.0
    4.11.2.2: rewrite_goal_with_prev @4.11.2.0
    4.11.3: introduction
    4.11.3.1: apply_resolve_step member_empty @4.11.3.0
    4.15: rewrite_goal diff_def sym=false
    4.15: rewrite_goal member_collect sym=false
    4.15: rewrite_goal member_collect sym=false
    4.15: introduction x1
    4.15.2: apply_forward_step conjD1 @4.15.1
    4.15.3: apply_forward_step conjD1 @4.15.2
    4.15.4: apply_prev @2
    6: apply_backward_step sum_subset_simple
    6: apply_backward_step finite_image
    7: apply_backward_step subsetI
