    4.8: rewrite_goal comp_fun_eval sym=false
    4.8: rewrite_goal_with_prev @4.7
    4.8: apply_backward_step real_le_refl
  qed

theorem sum_closed
  fixes P :: real ⇒ bool, f :: 'a ⇒ real, s :: 'a set
  prop P 0 ⟶ (∀x. ∀y. P x ⟶ P y ⟶ P (x + y)) ⟶ (∀a. a ∈ s ⟶ P (f a)) ⟶ P (sum s f)
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal sum_def sym=false
