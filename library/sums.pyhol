    13: apply_backward_step disjI2
    13: rewrite_goal eq_sym_eq sym=false
    13: apply_backward_step sum_image_gen
  qed

theorem sum_image_le
  fixes f :: 'a ⇒ 'b, g :: 'b ⇒ real, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ 0 ≤ g (f x)) ⟶ sum (image f s) g ≤ sum s (g ∘ f)
