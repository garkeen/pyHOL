theory sums
imports iterate
description "Sums of natural numbers and real numbers."

def nsum :: 'a set ⇒ ('a ⇒ nat) ⇒ nat = (nsum::'a set ⇒ ('a ⇒ nat) ⇒ nat) = iterate plus [hint_rewrite]

theorem neutral_nat_add
  prop neutral plus = (0::nat)
  [hint_rewrite]
  proof
    0: rewrite_goal neutral_def sym=false
    0: rewrite_goal eq_add_lcancel_0 sym=false
    0: rewrite_goal add_comm sym=false
    0: rewrite_goal eq_add_lcancel_0 sym=false
    0: apply_forward_step theI param_P="(%x::nat. ∀y::nat. x = 0 ∧ x = 0)" param_a="(0::nat)"
    1: cut "(∀y::nat. (0::nat) = 0 ∧ (0::nat) = 0)"
    1: introduction y
    1.1: apply_backward_step conjI
    1.1: apply_backward_step eq_refl
    2: apply_fact @0,1
    3: cut "(∀x::nat. (∀y::nat. x = 0 ∧ x = 0) ⟶ x = 0)"
    3: introduction x
    3.2: forall_elim x @3.1
    3.3: apply_backward_step conjD1 @3.2
    4: apply_fact @2,3
    5: apply_prev @3
  qed

theorem monoidal_nat_add
  prop monoidal (plus::nat ⇒ nat ⇒ nat)
  [hint_backward]
  proof
    0: rewrite_goal monoidal_def sym=false
    0: apply_backward_step conjI
    0: z3
    1: apply_backward_step conjI
    1: z3
    2: rewrite_goal neutral_nat_add sym=false
    2: z3
  qed

theorem nsum_degenerate
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop ¬(finite ({x. x ∈ s ∧ ¬(f x = 0)})) ⟶ nsum s f = 0
  [hint_backward]
  proof
    1: rewrite_goal nsum_def sym=false
    1: rewrite_goal iterate_def sym=false
    1: rewrite_goal support_def sym=false
    1: rewrite_goal neutral_nat_add sym=false
    1: rewrite_goal if_not_P @0 sym=false
  qed

theorem nsum_empty
  fixes f :: 'a ⇒ nat
  prop nsum ∅ f = 0
  [hint_rewrite]
  proof
    0: rewrite_goal nsum_def sym=false
    0: rewrite_goal neutral_nat_add sym=true
    0: apply_backward_step iterate_empty
    0: apply_backward_step monoidal_nat_add
  qed

theorem nsum_insert
  fixes f :: 'a ⇒ nat, s :: 'a set, x :: 'a
  prop finite s ⟶ nsum (insert x s) f = (if x ∈ s then nsum s f else f x + nsum s f)
  [hint_backward]
  proof
    1: rewrite_goal nsum_def sym=false
    1: apply_backward_step iterate_insert
    1: apply_backward_step monoidal_nat_add
  qed

theorem nsum_union
  fixes f :: 'a ⇒ nat, s :: 'a set, t :: 'a set
  prop finite s ⟶ finite t ⟶ disjoint s t ⟶ nsum (s ∪ t) f = nsum s f + nsum t f
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal nsum_def sym=false
    3: apply_backward_step iterate_union
    3: apply_backward_step monoidal_nat_add
  qed

theorem nsum_diff
  fixes f :: 'a ⇒ nat, s :: 'a set, t :: 'a set
  prop finite s ⟶ t ⊆ s ⟶ nsum (diff s t) f = nsum s f - nsum t f
  [hint_backward]
  proof
    2: rewrite_goal nsum_def sym=false
    2: cut "!x. !y. !z::nat. (x + z = y) --> (x = y - z)"
    2: z3
    3: apply_prev @2
    3: apply_backward_step iterate_diff
    3: apply_backward_step monoidal_nat_add
  qed

theorem nsum_incl_excl
  fixes f :: 'a ⇒ nat, s :: 'a set, t :: 'a set
  prop finite s ⟶ finite t ⟶ nsum s f + nsum t f = nsum (s ∪ t) f + nsum (s ∩ t) f
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal nsum_def sym=false
    2: apply_forward_step monoidal_nat_add
    3: apply_backward_step iterate_incl_excl @2,0,1
  qed

theorem nsum_support
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop nsum (support plus f s) f = nsum s f
  [hint_rewrite]
  proof
    0: rewrite_goal nsum_def sym=false
    0: rewrite_goal iterate_support sym=false
  qed

theorem nsum_add
  fixes f :: 'a ⇒ nat, g :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ nsum s (λx. f x + g x) = nsum s f + nsum s g
  [hint_backward]
  proof
    1: rewrite_goal nsum_def sym=false
    1: apply_backward_step iterate_op
    1: apply_backward_step monoidal_nat_add
  qed

theorem nsum_add_gen
  fixes f :: 'a ⇒ nat, g :: 'a ⇒ nat, s :: 'a set
  prop finite ({x. x ∈ s ∧ ¬(f x = 0)}) ⟶ finite ({x. x ∈ s ∧ ¬(g x = 0)}) ⟶ nsum s (λx. f x + g x) = nsum s f + nsum s g
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal nsum_def sym=false
    2: apply_backward_step iterate_op_gen
    2: apply_backward_step monoidal_nat_add
    3: rewrite_goal support_def sym=false
    3: rewrite_goal neutral_nat_add sym=false
    5: rewrite_goal support_def sym=false
    5: rewrite_goal neutral_nat_add sym=false
  qed

theorem nsum_eq_0
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop (∀x. x ∈ s ⟶ f x = 0) ⟶ nsum s f = 0
  [hint_backward,hint_backward1]
  proof
    1: rewrite_goal nsum_def sym=false
    1: rewrite_goal neutral_nat_add sym=true
    1: apply_backward_step iterate_eq_neutral
    1: apply_backward_step monoidal_nat_add
    2: rewrite_goal neutral_nat_add sym=false
  qed

theorem nsum_0
  fixes s :: 'a set
  prop nsum s (λn. 0) = 0
  [hint_rewrite]
  proof
    0: apply_backward_step nsum_eq_0
    0: introduction x
    0.2: apply_backward_step eq_refl
  qed

theorem nsum_lmul
  fixes c :: nat, f :: 'a ⇒ nat, s :: 'a set
  prop nsum s (λx. c * f x) = c * nsum s f
  [hint_rewrite]
  proof
    0: cases "c=0"
    0: introduction
    0.1: rewrite_goal_with_prev @0.0
    0.1: rewrite_goal nat_times_def_1 sym=false
    0.1: rewrite_goal nsum_0 sym=false
    1: introduction
    1.1: rewrite_goal nsum_def sym=false
    1.1: rewrite_goal iterate_expand_cases sym=false
    1.1: cut "support plus (λx. c * f x) s = support plus f s"
    1.1: rewrite_goal support_def sym=false
    1.1: rewrite_goal neutral_nat_add sym=false
    1.1: z3 @1.0
    1.4: rewrite_goal_with_prev @1.3
    1.4: cases "finite (support plus f s)"
    1.4: introduction
    1.4.1: rewrite_goal if_P @1.4.0 sym=false
    1.4.1: rewrite_goal nsum_def sym=true
    1.4.1: apply_forward_step finite_induct_strong @1.4.0 param_P="(%s. nsum s (λx. c * f x) = c * nsum s f)"
    1.4.2: apply_prev @1.4.1
    1.4.2: rewrite_goal nsum_empty sym=false
    1.4.2: rewrite_goal mult_0_right sym=false
    1.4.4: introduction a,s1
    1.4.4.5: apply_forward_step nsum_insert @1.4.4.4 param_f=f param_x=a
    1.4.4.6: rewrite_fact if_not_P @1.4.4.5,1.4.4.3 sym=false
    1.4.4.7: rewrite_goal_with_prev @1.4.4.6
    1.4.4.7: apply_forward_step nsum_insert @1.4.4.4 param_f="(λx. c * f x)" param_x=a
    1.4.4.8: rewrite_fact if_not_P @1.4.4.7,1.4.4.3 sym=false
    1.4.4.9: rewrite_goal_with_prev @1.4.4.8
    1.4.4.9: rewrite_goal_with_prev @1.4.4.2
    1.4.4.9: rewrite_goal distrib_l sym=false
    1.5: introduction
    1.5.1: rewrite_goal if_not_P @1.5.0 sym=false
    1.5.1: rewrite_goal neutral_nat_add sym=false
    1.5.1: rewrite_goal mult_0_right sym=false
  qed

theorem nsum_rmul
  fixes c :: nat, f :: 'a ⇒ nat, s :: 'a set
  prop nsum s (λx. f x * c) = nsum s f * c
  [hint_rewrite]
  proof
    0: rewrite_goal mult_comm sym=false
    0: rewrite_goal nsum_lmul sym=false
  qed

theorem nsum_le
  fixes f :: 'a ⇒ nat, g :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ f x ≤ g x) ⟶ nsum s f ≤ nsum s g
  [hint_backward,hint_backward1]
  proof
    2: revert_intro @1
    1: apply_backward_step finite_induct_strong @0
    1: rewrite_goal nsum_empty sym=false
    1: introduction
    1.1: apply_backward_step less_eq_refl
    3: introduction x,s
    3.5: apply_forward_step nsum_insert @0 param_f=f param_x=x
    3.6: rewrite_fact if_not_P @3.5,3.3 sym=false
    3.7: apply_forward_step nsum_insert @0 param_f=g param_x=x
    3.8: rewrite_fact if_not_P @3.7,3.3 sym=false
    3.9: rewrite_goal_with_prev @3.8
    3.9: rewrite_goal_with_prev @3.6
    3.9: apply_backward_step le_add2
    3.9: apply_prev @3.4
    3.9: rewrite_goal member_insert sym=false
    3.9: apply_backward_step disjI1
    3.9: apply_backward_step eq_refl
    3.13: apply_prev @3.2
    3.13: introduction x1
    3.13.2: apply_prev @3.4
    3.13.2: rewrite_goal member_insert sym=false
    3.13.2: apply_backward_step disjI2
  qed

theorem nsum_lt
  fixes f :: 'a ⇒ nat, g :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ f x ≤ g x) ⟶ (∃x. x ∈ s ∧ f x < g x) ⟶ nsum s f < nsum s g
  [hint_backward,hint_backward1]
  proof
    3: exists_elim a @2
    5: apply_forward_step conjD1 @4
    6: apply_forward_step conjD2 @4
    7: cut "s = insert a (delete s a)"
    7: rewrite_goal eq_sym_eq sym=false
    7: apply_backward_step insert_delete @5
    9: rewrite_goal_with_prev @8
    9: cut "finite (delete s a)" @8
    9: apply_backward_step finite_subset param_t=s
    9: rewrite_goal delete_def sym=false
    9: z3
    12: apply_forward_step nsum_insert @11 param_f=f param_x=a
    13: cut "~(a ∈ delete s a) "
    13: rewrite_goal member_delete sym=false
    13: z3
    15: rewrite_fact if_not_P @12,14 sym=false
    16: apply_forward_step nsum_insert @11 param_f=g param_x=a
    17: rewrite_fact if_not_P @16,14 sym=false
    18: rewrite_goal_with_prev @17
    18: rewrite_goal_with_prev @15
    18: rewrite_goal add_comm sym=false
    18: apply_backward_step let_add2
    18: apply_backward_step nsum_le
    18: introduction x
    18.2: apply_prev @1
    18.2: rewrite_fact member_delete @18.1 sym=false
    18.3: apply_backward_step conjD2 @18.2
  qed

theorem nsum_lt_all
  fixes f :: 'a ⇒ nat, g :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ ¬(s = ∅) ⟶ (∀x. x ∈ s ⟶ f x < g x) ⟶ nsum s f < nsum s g
  [hint_backward,hint_backward1]
  proof
    3: apply_backward_step nsum_lt
    3: introduction x
    3.2: apply_backward_step lt_imp_le
    3.2: apply_prev @2
    4: rewrite_fact set_equal_iff @1 sym=false
    5: rewrite_fact not_all @4 sym=false
    6: exists_elim a @5
    8: inst_exists_goal a
    8: apply_backward_step conjI
    8: z3 @7
    9: apply_prev @2,8
  qed

theorem nsum_eq
  fixes f :: 'a ⇒ nat, g :: 'a ⇒ nat, s :: 'a set
  prop (∀x. x ∈ s ⟶ f x = g x) ⟶ nsum s f = nsum s g
  [hint_backward]
  proof
    1: rewrite_goal nsum_def sym=false
    1: apply_backward_step iterate_eq
    1: apply_backward_step monoidal_nat_add
  qed

theorem nsum_const
  fixes c :: nat, s :: 'a set
  prop finite s ⟶ nsum s (λn. c) = card s * c
  [hint_backward]
  proof
    1: apply_backward_step finite_induct_strong @0
    1: rewrite_goal nsum_empty sym=false
    1: rewrite_goal card_empty sym=false
    1: rewrite_goal nat_times_def_1 sym=false
    4: introduction a,s
    4.4: apply_forward_step card_insert @0 param_x=a
    4.5: rewrite_fact if_not_P @4.4,4.3 sym=false
    4.6: rewrite_goal_with_prev @4.5
    4.6: apply_forward_step nsum_insert @0 param_f="(λn::'a. c)" param_x=a
    4.7: rewrite_fact if_not_P @4.6,4.3 sym=false
    4.8: rewrite_goal_with_prev @4.7
    4.8: rewrite_goal_with_prev @4.2
    4.8: rewrite_goal nat_times_def_2 sym=false
  qed

theorem nsum_pos_bound
  fixes b :: nat, f :: 'a ⇒ nat, s :: 'a set, x :: 'a
  prop finite s ⟶ nsum s f ≤ b ⟶ x ∈ s ⟶ f x ≤ b
  [hint_backward,hint_backward1]
  proof
    3: revert_intro @2
    2: revert_intro @1
    1: apply_backward_step finite_induct_strong @0
    1: introduction
    1.2: apply_resolve_step member_empty @1.1
    2: introduction a,s
    2.6: rewrite_fact member_insert @2.5 sym=false
    2.7: apply_forward_step nsum_insert @0 param_f=f param_x=a
    2.8: rewrite_fact if_not_P @2.7,2.3 sym=false
    2.9: rewrite_fact_with_prev @2.8,2.4
    2.10: apply_backward_step disjE @2.6
    2.10: introduction
    2.10.1: rewrite_goal_with_prev @2.10.0
    2.10.1: apply_backward_step less_eq_trans param_m="f a + nsum s f"
    2.10.1: apply_backward_step le_add
    2.11: introduction
    2.11.1: apply_prev @2.2
    2.11.1: apply_backward_step less_eq_trans param_m="f a + nsum s f"
    2.11.1: rewrite_goal add_comm sym=false
    2.11.1: apply_backward_step le_add
  qed

theorem nsum_eq_0_iff
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ nsum s f = 0 ⟷ (∀x. x ∈ s ⟶ f x = 0)
  [hint_backward]
  proof
    1: apply_backward_step iffI
    1: introduction
    1.1: introduction x
    1.1.2: cut "!n::nat. n = 0 <--> n <= 0" @1.0
    1.1.2: z3
    1.1.3: rewrite_goal_with_prev @1.1.2
    1.1.3: rewrite_fact_with_prev @1.1.2,1.0
    1.1.4: apply_backward_step nsum_pos_bound param_s=s
    2: introduction
    2.1: apply_backward_step nsum_eq_0
  qed

theorem nsum_pos_lt
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ (∃x. x ∈ s ∧ 0 < f x) ⟶ 0 < nsum s f
  [hint_backward,hint_backward1]
  proof
    2: apply_backward_step le_1_1
    2: apply_forward_step nsum_eq_0_iff @0 param_f=f
    3: rewrite_goal_with_prev @2
    3: rewrite_goal not_all sym=false
    3: rewrite_goal not_imp sym=false
    3: z3 @1
  qed

theorem nsum_pos_lt_all
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ ¬(s = ∅) ⟶ (∀i. i ∈ s ⟶ 0 < f i) ⟶ 0 < nsum s f
  [hint_backward,hint_backward1]
  proof
    3: apply_backward_step nsum_pos_lt
    3: rewrite_fact set_equal_iff @1 sym=false
    4: rewrite_fact not_all @3 sym=false
    5: exists_elim a @4
    7: inst_exists_goal a
    7: apply_backward_step conjI
    7: z3 @6
    8: apply_prev @2,7
  qed

theorem nsum_delete
  fixes a :: 'a, f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ a ∈ s ⟶ f a + nsum (delete s a) f = nsum s f
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal nsum_def sym=false
    2: apply_forward_step monoidal_nat_add
    3: apply_backward_step iterate_delete @2,0,1
  qed

theorem nsum_sing
  fixes f :: 'a ⇒ nat, x :: 'a
  prop nsum ({x}) f = f x
  [hint_rewrite]
  proof
    0: cut "finite({}::'a set)"
    0: apply_backward_step finite_empty
    1: apply_forward_step nsum_insert @0 param_f=f param_x=x
    2: cut "~(x ∈ ∅)"
    2: apply_backward_step member_empty
    3: rewrite_fact if_not_P @1,2 sym=false
    4: rewrite_fact nsum_empty @3 sym=false
    5: rewrite_fact add_0_right @4 sym=false
  qed

theorem nsum_delta
  fixes a :: 'a, b :: nat, s :: 'a set
  prop nsum s (λx. if x = a then b else 0) = (if a ∈ s then b else 0)
  [hint_rewrite]
  proof
    0: rewrite_goal nsum_def sym=false
    0: rewrite_goal neutral_nat_add sym=true
    0: apply_backward_step iterate_delta
    0: apply_backward_step monoidal_nat_add
  qed

theorem nsum_swap
  fixes f :: 'b ⇒ 'c ⇒ nat, s :: 'b set, t :: 'c set
  prop finite s ⟶ finite t ⟶ nsum s (λi. nsum t (f i)) = nsum t (λj. nsum s (λi. f i j))
  [hint_backward,hint_backward1]
  proof
    2: apply_backward_step finite_induct_strong @0
    2: rewrite_goal nsum_empty sym=false
    2: rewrite_goal nsum_0 sym=false
    4: introduction a,s
    4.4: apply_forward_step nsum_insert @0 param_f="(λi. f i j)" param_x=a
    4.5: rewrite_fact if_not_P @4.4,4.3 sym=false
    4.6: rewrite_goal_with_prev @4.5
    4.6: apply_forward_step nsum_insert @0 param_f="(λi. nsum t (f i))" param_x=a
    4.7: rewrite_fact if_not_P @4.6,4.3 sym=false
    4.8: rewrite_goal_with_prev @4.7
    4.8: rewrite_goal_with_prev @4.2
    4.8: rewrite_goal eq_sym_eq sym=false
    4.8: apply_backward_step nsum_add
  qed

theorem nsum_image
  fixes f :: 'a ⇒ 'b, g :: 'b ⇒ nat, s :: 'a set
  prop (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ f x = f y ⟶ x = y) ⟶ nsum (image f s) g = nsum s (g ∘ f)
  [hint_backward]
  proof
    1: rewrite_goal nsum_def sym=false
    1: apply_backward_step iterate_image
    1: apply_backward_step monoidal_nat_add
  qed

theorem nsum_superset
  fixes f :: 'b ⇒ nat, u :: 'b set, v :: 'b set
  prop u ⊆ v ⟶ (∀x. x ∈ v ⟶ ¬(x ∈ u) ⟶ f x = 0) ⟶ nsum v f = nsum u f
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal nsum_def sym=false
    2: apply_backward_step iterate_superset
    2: apply_backward_step monoidal_nat_add
    3: rewrite_goal neutral_nat_add sym=false
  qed

theorem nsum_univ
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop support plus f univ ⊆ s ⟶ nsum s f = nsum univ f
  [hint_backward]
  proof
    1: rewrite_goal nsum_def sym=false
    1: apply_backward_step iterate_univ
    1: apply_backward_step monoidal_nat_add
  qed

theorem nsum_union_rzero
  fixes f :: 'b ⇒ nat, u :: 'b set, v :: 'b set
  prop finite u ⟶ (∀x. x ∈ v ⟶ ¬(x ∈ u) ⟶ f x = 0) ⟶ nsum (u ∪ v) f = nsum u f
  [hint_backward,hint_backward1]
  proof
    2: cut "u ∪ v = u ∪ (diff v u)"
    2: rewrite_goal diff_def sym=false
    2: z3
    4: rewrite_goal_with_prev @3
    4: apply_backward_step nsum_superset
    4: apply_backward_step subset_union_id
    5: introduction x
    5.3: apply_prev @1
    5.3: rewrite_fact diff_def @5.1 sym=false
    5.4: rewrite_fact member_union_iff @5.3 sym=false
    5.5: rewrite_fact member_collect @5.4 sym=false
    5.6: apply_backward_step disjE @5.5
    5.6: introduction
    5.6.1: apply_backward_step negE_gen @5.2,5.6.0
    5.7: introduction
    5.7.1: apply_backward_step conjD1 @5.7.0
  qed

theorem nsum_union_lzero
  fixes f :: 'b ⇒ nat, u :: 'b set, v :: 'b set
  prop finite u ⟶ (∀x. x ∈ v ⟶ ¬(x ∈ u) ⟶ f x = 0) ⟶ nsum (v ∪ u) f = nsum u f
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal union_comm sym=false
    2: apply_backward_step nsum_union_rzero
  qed

theorem nsum_restrict
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ nsum s (λx. if x ∈ s then f x else 0) = nsum s f
  [hint_backward]
  proof
    1: apply_backward_step nsum_eq
    1: introduction x
    1.2: rewrite_goal if_P @1.1 sym=false
  qed

theorem nsum_bound
  fixes b :: nat, f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ f x ≤ b) ⟶ nsum s f ≤ card s * b
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step nsum_const @0 param_c=b
    3: rewrite_fact eq_sym_eq @2 sym=false
    4: rewrite_goal_with_prev @3
    4: apply_backward_step nsum_le
  qed

theorem nsum_bound_gen
  fixes b :: nat, f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ ¬(s = ∅) ⟶ (∀x. x ∈ s ⟶ f x ≤ b DIV card s) ⟶ nsum s f ≤ b
  [hint_backward,hint_backward1]
  proof
    3: apply_forward_step card_eq_0 @0
    4: rewrite_fact eq_sym_eq @3 sym=false
    5: rewrite_fact_with_prev @4,1
    6: cut "nsum s (%x. card s * f x) <= card s * b"
    6: apply_backward_step nsum_bound
    6: introduction x
    6.2: apply_forward_step le_rdiv_eq @5 param_b=b param_n="f x"
    6.3: rewrite_fact eq_sym_eq @6.2 sym=false
