  prop finite t ⟶ t ⊆ s ⟶ (∀x. x ∈ t ⟶ f x = g x) ⟶ (∀x. x ∈ s ⟶ ¬(x ∈ t) ⟶ f x = 0) ⟶ sum s f = sum t g
  [hint_backward,hint_backward1]
  proof
    4: cut "sum s f = sum t f"
    4: apply_backward_step sum_superset
    5: rewrite_goal_with_prev @4
    5: apply_backward_step sum_eq
  qed

theorem sum_restrict_set
  fixes P :: 'a ⇒ bool, f :: 'a ⇒ real, s :: 'a set
  prop sum ({x. x ∈ s ∧ P x}) f = sum s (λx. if P x then f x else 0)
  [hint_rewrite]
  proof
    0: rewrite_goal sum_def sym=false
    0: rewrite_goal neutral_real_add sym=true
    0: apply_backward_step iterate_restrict_set
    0: apply_backward_step monoidal_real_add
  qed

theorem sum_sum_restrict
  fixes R :: 'a ⇒ 'b ⇒ bool, f :: 'a ⇒ 'b ⇒ real, s :: 'a set, t :: 'b set
  prop finite s ⟶ finite t ⟶ sum s (λx. sum ({y. y ∈ t ∧ R x y}) (λy. f x y)) = sum t (λy. sum ({x. x ∈ s ∧ R x y}) (λx. f x y))
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal sum_restrict_set sym=false
    2: apply_backward_step sum_swap
  qed

theorem card_eq_sum
  fixes s :: 'a set
  prop finite s ⟶ of_nat (card s) = sum s (λx. 1)
  [hint_backward]
  proof
    1: apply_forward_step sum_const @0 param_c="(1::real)"
    2: rewrite_goal_with_prev @1
    2: rewrite_goal real_mul_rid sym=false
  qed

theorem sum_multicount_gen
  fixes R :: 'a ⇒ 'b ⇒ bool, k :: 'b ⇒ nat, s :: 'a set, t :: 'b set
  prop finite s ⟶ finite t ⟶ (∀j. j ∈ t ⟶ card ({i. i ∈ s ∧ R i j}) = k j) ⟶ sum s (λi. of_nat (card ({j. j ∈ t ∧ R i j}))) = sum t (λi. of_nat (k i))
  [hint_backward,hint_backward1]
  proof
    3: cut "sum s (λi. of_nat (card ({j. j ∈ t ∧ R i j}))) = sum s (%i. sum {j. j ∈ t ∧ R i j} (%j. 1))"
    3: apply_backward_step sum_eq
    3: introduction x
    3.2: apply_backward_step card_eq_sum
    3.2: apply_backward_step finite_restrict
    5: rewrite_goal_with_prev @4
    5: apply_forward_step sum_sum_restrict @0,1 param_R=R param_f="(%x::'a. %y::'b. (1::real))"
    6: rewrite_goal_with_prev @5
    6: apply_backward_step sum_eq
    6: introduction x
    6.2: cut "finite {x1. x1 ∈ s ∧ R x1 x}"
    6.2: apply_backward_step finite_restrict
    6.3: apply_forward_step sum_const @6.2 param_c="(1::real)"
    6.4: rewrite_goal_with_prev @6.3
    6.4: rewrite_goal real_mul_rid sym=false
    6.4: rewrite_goal real_of_nat_eq sym=false
    6.4: apply_prev @2
  qed

theorem sum_multicount
  fixes R :: 'a ⇒ 'b ⇒ bool, k :: nat, s :: 'a set, t :: 'b set
  prop finite s ⟶ finite t ⟶ (∀j. j ∈ t ⟶ card ({i. i ∈ s ∧ R i j}) = k) ⟶ sum s (λi. of_nat (card ({j. j ∈ t ∧ R i j}))) = of_nat (k * card t)
  [hint_backward,hint_backward1]
  proof
    3: cut "sum s (λi. of_nat (card ({j. j ∈ t ∧ R i j}))) = sum t (%i. of_nat k)"
    3: apply_backward_step sum_multicount_gen
    4: rewrite_goal_with_prev @3
    4: apply_forward_step sum_const @1 param_c="(of_nat::nat⇒real) k"
    5: rewrite_goal_with_prev @4
    5: rewrite_goal real_of_nat_mul sym=false
    5: rewrite_goal real_of_nat_eq sym=false
    5: nat_norm
  qed

theorem sum_image_gen
  fixes f :: 'a ⇒ 'b, g :: 'a ⇒ real, s :: 'a set
  prop finite s ⟶ sum s g = sum (image f s) (λy. sum ({x. x ∈ s ∧ f x = y}) g)
  [hint_backward]
  proof
    1: rewrite_goal sum_def sym=false
    1: apply_backward_step iterate_image_gen
    1: apply_backward_step monoidal_real_add
  qed

theorem sum_group
  fixes f :: 'a ⇒ 'b, g :: 'a ⇒ real, s :: 'a set, t :: 'b set
  prop finite s ⟶ image f s ⊆ t ⟶ sum t (λy. sum ({x. x ∈ s ∧ f x = y}) g) = sum s g
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step sum_image_gen param_f=f param_g=g param_s=s
    3: apply_fact @2,0
    4: rewrite_goal_with_prev @3
    4: apply_backward_step sum_superset
    4: introduction x
    4.3: apply_backward_step sum_eq_0
    4.3: introduction x1
    4.3.2: rewrite_fact member_collect @4.3.1 sym=false
    4.3.3: apply_forward_step conjD1 @4.3.2
    4.3.4: apply_forward_step conjD2 @4.3.2
    4.3.5: rewrite_fact in_image @4.2 sym=false
    4.3.6: apply_backward_step negE_gen @4.3.5
    4.3.6: inst_exists_goal x1
    4.3.6: apply_backward_step conjI
    4.3.6: rewrite_goal_with_prev @4.3.4
  qed

theorem sum_group_relation
  fixes R :: 'a ⇒ 'b ⇒ bool, g :: 'a ⇒ real, s :: 'a set, t :: 'b set
  prop finite s ⟶ (∀x. x ∈ s ⟶ (∃!y. y ∈ t ∧ R x y)) ⟶ sum t (λy. sum ({x. x ∈ s ∧ R x y}) g) = sum s g
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step sum_group @0 param_f="(%x. THE y. y ∈ t ∧ R x y)" param_g=g param_t=t
    3: cut "image (λx. THE y. y ∈ t ∧ R x y) s ⊆ t"
    3: apply_backward_step subsetI
    3: rewrite_goal in_image sym=false
    3: introduction x
    3.2: exists_elim x1 @3.1
    3.4: apply_forward_step conjD1 @3.3
    3.5: apply_forward_step conjD2 @3.3
    3.6: apply_fact @1,3.5
    3.7: apply_forward_step theI' @3.6
    3.8: rewrite_goal_with_prev @3.4
    3.8: apply_backward_step conjD1 @3.7
    6: apply_fact @2,5
    7: rewrite_fact eq_sym_eq @6 sym=false
    8: rewrite_goal_with_prev @7
    8: apply_backward_step sum_eq
    8: introduction x
    8.2: cut "{x1. x1 ∈ s ∧ R x1 x} = {x1. x1 ∈ s ∧ (THE y. y ∈ t ∧ R x1 y) = x}"
    8.2: apply_backward_step member_ext
    8.2: rewrite_goal member_collect sym=false
    8.2: introduction x1
    8.2.1: apply_backward_step iffI
    8.2.1: introduction
    8.2.1.1: apply_forward_step conjD1 @8.2.1.0
    8.2.1.2: apply_forward_step conjD2 @8.2.1.0
    8.2.1.3: apply_backward_step conjI
    8.2.1.3: apply_fact @1,8.2.1.1
    8.2.1.4: rewrite_fact exists1_def @8.2.1.3 sym=""
    8.2.1.5: exists_elim x2 @8.2.1.4
    8.2.1.7: apply_forward_step conjD1 @8.2.1.6
    8.2.1.8: apply_forward_step conjD2 @8.2.1.6
    8.2.1.9: apply_forward_step theI' @8.2.1.3
    8.2.1.10: apply_fact @8.2.1.8,8.2.1.9
    8.2.1.11: rewrite_goal_with_prev @8.2.1.10
    8.2.1.11: rewrite_goal eq_sym_eq sym=false
    8.2.1.11: apply_prev @8.2.1.8
    8.2.1.11: apply_backward_step conjI
    8.2.2: introduction
    8.2.2.1: apply_forward_step conjD1 @8.2.2.0
    8.2.2.2: apply_forward_step conjD2 @8.2.2.0
    8.2.2.3: apply_backward_step conjI
    8.2.2.3: apply_fact @1,8.2.2.1
    8.2.2.4: apply_forward_step theI' @8.2.2.3
    8.2.2.5: apply_forward_step conjD2 @8.2.2.4
    8.2.2.6: rewrite_fact_with_prev @8.2.2.2,8.2.2.5
    8.5: rewrite_goal_with_prev @8.4
  qed

theorem real_of_nat_sum
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ of_nat (nsum s f) = sum s (λx. of_nat (f x))
  [hint_backward]
  proof
    1: apply_backward_step finite_induct_strong @0
    1: rewrite_goal sum_empty sym=false
    1: rewrite_goal nsum_empty sym=false
    1: rewrite_goal real_zero_def sym=false
    4: introduction x,s
    4.4: apply_forward_step sum_insert @0 param_f="(λx1. (of_nat::nat⇒real) (f x1))" param_x=x
    4.5: rewrite_fact if_not_P @4.4,4.3 sym=false
    4.6: rewrite_goal_with_prev @4.5
    4.6: rewrite_fact eq_sym_eq @4.2 sym=false
    4.7: rewrite_goal_with_prev @4.6
    4.7: rewrite_goal real_of_nat_add sym=false
    4.7: rewrite_goal real_of_nat_eq sym=false
    4.7: apply_forward_step nsum_insert @0 param_f=f param_x=x
    4.8: rewrite_fact if_not_P @4.7,4.3 sym=false
  qed

theorem sum_subset
  fixes f :: 'a ⇒ real, u :: 'a set, v :: 'a set
  prop finite u ⟶ finite v ⟶ (∀x. x ∈ diff u v ⟶ f x ≤ 0) ⟶ (∀x. x ∈ diff v u ⟶ 0 ≤ f x) ⟶ sum u f ≤ sum v f
  [hint_backward,hint_backward1]
  proof
    4: apply_forward_step sum_union param_f=f param_s="inter u v" param_t=""
    5: cut "finite (u ∩ v)"
    5: apply_backward_step finite_inter
    5: apply_backward_step disjI1
    7: apply_fact @4,6
    8: forall_elim "diff v u" @7
    9: forall_elim "diff u v" @7
    10: cut "finite (diff v u)" @8
    10: apply_backward_step finite_diff
    11: cut "finite (diff u v)"
    11: apply_backward_step finite_diff
    12: apply_fact @8,10
    13: apply_fact @9,11
    14: cut "disjoint (u ∩ v) (diff v u)"
    14: rewrite_goal disjoint_def sym=false
    14: rewrite_goal diff_def sym=false
    14: z3
    17: apply_fact @12,16
    18: cut "disjoint (u ∩ v) (diff u v)"
    18: rewrite_goal disjoint_def sym=false
    18: rewrite_goal diff_def sym=false
    18: z3
    21: apply_fact @13,20
    22: cut "u ∩ v ∪ diff v u = v" @17
    22: rewrite_goal diff_def sym=false
    22: z3
    24: rewrite_fact_with_prev @23,17
    25: cut "u ∩ v ∪ diff u v = u"
    25: rewrite_goal diff_def sym=false
    25: z3
    27: rewrite_fact_with_prev @26,21
    28: rewrite_goal_with_prev @27
    28: rewrite_goal_with_prev @24
    28: apply_backward_step real_le_ladd_imp
    28: apply_backward_step real_le_trans param_y="(0::real)"
    28: cut "!a::real. a <=0  <--> 0 <= -a"
    28: z3
    29: rewrite_goal_with_prev @28
    29: rewrite_goal sum_neg sym=true
    29: apply_backward_step sum_pos_le
    29: rewrite_fact_with_prev @28,2
    33: apply_backward_step sum_pos_le
  qed

theorem sum_subset_simple
  fixes f :: 'a ⇒ real, u :: 'a set, v :: 'a set
  prop finite v ⟶ u ⊆ v ⟶ (∀x. x ∈ diff v u ⟶ 0 ≤ f x) ⟶ sum u f ≤ sum v f
  [hint_backward,hint_backward1]
  proof
    3: apply_backward_step sum_subset
    3: apply_backward_step finite_subset param_t=v
    4: introduction x
    4.2: rewrite_fact diff_def @4.1 sym=false
    4.3: rewrite_fact member_collect @4.2 sym=false
    4.4: z3 @1,4.3
  qed

theorem sum_mul_bound
  fixes a :: 'a ⇒ real, b :: 'a ⇒ real, s :: 'a set
  prop finite s ⟶ (∀i. i ∈ s ⟶ 0 ≤ a i ∧ 0 ≤ b i) ⟶ sum s (λi. a i * b i) ≤ sum s a * sum s b
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal sum_lmul sym=true
    2: apply_backward_step sum_le
    2: introduction x
    2.2: rewrite_goal real_mult_comm sym=false
    2.2: apply_backward_step real_le_lmul
    2.2: apply_fact @1,2.1
    2.3: apply_backward_step conjD2 @2.2
    2.4: cut "a x = sum {x} a"
    2.4: rewrite_goal sum_sing sym=false
    2.5: rewrite_goal_with_prev @2.4
    2.5: apply_backward_step sum_subset_simple
    2.5: z3 @2.1
    2.6: introduction x1
    2.6.2: rewrite_fact diff_def @2.6.1 sym=false
    2.6.3: rewrite_fact member_collect @2.6.2 sym=false
    2.6.4: apply_forward_step conjD1 @2.6.3
    2.6.5: apply_fact @1,2.6.4
    2.6.6: apply_backward_step conjD1 @2.6.5
  qed

theorem sum_image_nonzero
  fixes d :: 'b ⇒ real, i :: 'a ⇒ 'b, s :: 'a set
  prop finite s ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ i x = i y ⟶ d (i x) = 0) ⟶ sum (image i s) d = sum s (d ∘ i)
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal sum_def sym=false
    2: apply_backward_step iterate_image_nonzero
    2: apply_backward_step monoidal_real_add
    3: rewrite_goal neutral_real_add sym=false
  qed

theorem sum_bijection
  fixes f :: 'a ⇒ real, p :: 'a ⇒ 'a, s :: 'a set
  prop (∀x. x ∈ s ⟶ p x ∈ s) ⟶ (∀y. y ∈ s ⟶ (∃!x. x ∈ s ∧ p x = y)) ⟶ sum s f = sum s (f ∘ p)
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal sum_def sym=false
    2: apply_backward_step iterate_bijection
    2: apply_backward_step monoidal_real_add
  qed

theorem sum_eq_general
  fixes f :: 'a ⇒ real, g :: 'b ⇒ real, h :: 'a ⇒ 'b, s :: 'a set, t :: 'b set
  prop (∀y. y ∈ t ⟶ (∃!x. x ∈ s ∧ h x = y)) ⟶ (∀x. x ∈ s ⟶ h x ∈ t ∧ g (h x) = f x) ⟶ sum s f = sum t g
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal sum_def sym=false
    2: apply_backward_step iterate_eq_general param_h=h
    2: apply_backward_step monoidal_real_add
  qed

theorem sum_eq_general_inverses
  fixes f :: 'a ⇒ real, g :: 'b ⇒ real, h :: 'a ⇒ 'b, k :: 'b ⇒ 'a, s :: 'a set, t :: 'b set
  prop (∀y. y ∈ t ⟶ k y ∈ s ∧ h (k y) = y) ⟶ (∀x. x ∈ s ⟶ h x ∈ t ∧ k (h x) = x ∧ g (h x) = f x) ⟶ sum s f = sum t g
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal sum_def sym=false
    2: apply_backward_step iterate_eq_general_inverses param_h=h param_k=k
    2: apply_backward_step monoidal_real_add
  qed

theorem sum_injection
  fixes f :: 'a ⇒ real, p :: 'a ⇒ 'a, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ p x ∈ s) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ p x = p y ⟶ x = y) ⟶ sum s (f ∘ p) = sum s f
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal sum_def sym=false
    3: apply_backward_step iterate_injection
    3: apply_backward_step monoidal_real_add
  qed

theorem sum_union_nonzero
  fixes f :: 'a ⇒ real, s :: 'a set, t :: 'a set
  prop finite s ⟶ finite t ⟶ (∀x. x ∈ s ∩ t ⟶ f x = 0) ⟶ sum (s ∪ t) f = sum s f + sum t f
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal sum_def sym=false
    3: apply_backward_step iterate_union_nonzero
    3: apply_backward_step monoidal_real_add
    4: rewrite_goal neutral_real_add sym=false
  qed

theorem sum_cases
  fixes P :: 'a ⇒ bool, f :: 'a ⇒ real, g :: 'a ⇒ real, s :: 'a set
  prop finite s ⟶ sum s (λx. if P x then f x else g x) = sum ({x. x ∈ s ∧ P x}) f + sum ({x. x ∈ s ∧ ¬(P x)}) g
  [hint_backward,hint_backward1]
  proof
    1: rewrite_goal sum_def sym=false
    1: apply_backward_step iterate_cases
    1: apply_backward_step monoidal_real_add
  qed

theorem sum_cases_1
  fixes a :: 'a, f :: 'a ⇒ real, s :: 'a set, y :: real
  prop finite s ⟶ a ∈ s ⟶ sum s (λx. if x = a then y else f x) = sum s f + (y - f a)
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step sum_cases @0 param_P="(%x. x = a)" param_f="(%x::'a. y)" param_g=f
    3: cut "{x. x ∈ s ∧ ¬(x = a)} = delete s a" @2
    3: rewrite_goal delete_def sym=false
    3: z3
    5: rewrite_fact_with_prev @4,2
    6: apply_forward_step sum_delete @0,1 param_f=f
    7: cut "{x. x ∈ s ∧ x = a} = {a}"
    7: z3 @1
    8: rewrite_fact_with_prev @7,5
    9: rewrite_fact sum_sing @8 sym=false
    10: rewrite_goal_with_prev @9
    10: rewrite_goal_with_prev @6
    10: real_norm
  qed

theorem sum_le_included
