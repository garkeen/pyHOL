    23.2.7: rewrite_goal_with_prev @23.2.6
    23.2.7: real_norm
    24: rewrite_fact_with_prev @23,22
  qed

theorem real_sums_neg_i_xi
  fixes x :: real
  prop abs x < 1 ⟶ real_sums (λi. -1 ^ i * of_nat i * x ^ i) (-(x / (1 + x) ^ (2::nat))) univ
