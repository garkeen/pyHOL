    #[3] (∀x. abs x < 1 ⟶ real_sums (λi. 1 * x ^ i) (1 / (1 - x)) univ) ⟶ (∃f1. ∀x. abs x < 1 ⟶ has_real_derivative (λx1. 1 / (1 - x1)) (f1 x) (atreal x) ∧ real_sums (λi. of_nat i * 1 * x ^ (i - 1)) (f1 x) univ)
  cut "(∀x. abs x < 1 ⟶ real_sums (λi. 1 * x ^ i) (1 / (1 - x)) univ)" goal=2
    #[4] ∀x. abs x < 1 ⟶ real_sums (λi. 1 * x ^ i) (1 / (1 - x)) univ
  ← introduction x goal=4
    #[5] _VAR x
    #[6] real_sums (λi. 1 * x ^ i) (1 / (1 - x)) univ
  → apply_forward_step real_sums_gp param_n="(0::nat)" param_x=x goal=6
    #[7] abs x < 1 ⟶ real_sums (λk. x ^ k) (x ^ (0::nat) / (1 - x)) (from 0)
  → apply_fact goal=6 facts=[7,1]
    #[8] real_sums (λk. x ^ k) (x ^ (0::nat) / (1 - x)) (from 0)
  → rewrite_fact from_0 sym=false goal=6 facts=[8]
    #[9] real_sums (λk. x ^ k) (x ^ (0::nat) / (1 - x)) univ
  ← rewrite_goal real_mul_lid sym=false goal=6
    #[10] real_sums (λi. x ^ i) (1 / (1 - x)) univ
  → rewrite_fact real_nat_power_def_1 sym=false goal=10 facts=[9]
  → apply_fact goal=2 facts=[3,4]
    #[11] ∃f1. ∀x. abs x < 1 ⟶ has_real_derivative (λx1. 1 / (1 - x1)) (f1 x) (atreal x) ∧ real_sums (λi. of_nat i * 1 * x ^ (i - 1)) (f1 x) univ
  exists_elim f1 goal=2 facts=[11]
    #[12] _VAR f1
    #[13] ∀x. abs x < 1 ⟶ has_real_derivative (λx1. 1 / (1 - x1)) (f1 x) (atreal x) ∧ real_sums (λi. of_nat i * 1 * x ^ (i - 1)) (f1 x) univ
    #[14] real_sums (λi. of_nat i * x ^ i) (x / (1 - x) ^ (2::nat)) univ
  → apply_fact goal=14 facts=[13,1]
    #[15] has_real_derivative (λx1. 1 / (1 - x1)) (f1 x) (atreal x) ∧ real_sums (λi. of_nat i * 1 * x ^ (i - 1)) (f1 x) univ
  → apply_forward_step conjD1 goal=14 facts=[15]
    #[16] has_real_derivative (λx1. 1 / (1 - x1)) (f1 x) (atreal x)
  → apply_forward_step conjD2 goal=14 facts=[15]
    #[17] real_sums (λi. of_nat i * 1 * x ^ (i - 1)) (f1 x) univ
  cut "f1 x = 1 / (1 - x) ^ (2::nat)" goal=14
    #[18] f1 x = 1 / (1 - x) ^ (2::nat)
  ← apply_backward_step real_derivative_unique_atreal goal=18 facts=[16]
    #[19] has_real_derivative (λx1. 1 / (1 - x1)) (1 / (1 - x) ^ (2::nat)) (atreal x)
  cut "has_real_derivative (λx1. 1 / (1 - x1)) (( 0 * (1-x) - 1* (-1)) / (1 - x) ^ (2::nat)) (atreal x)" goal=19
    #[20] has_real_derivative (λx1. 1 / (1 - x1)) ((0 * (1 - x) - 1 * -1) / (1 - x) ^ (2::nat)) (atreal x)
  ← apply_backward_step has_real_derivative_div_atreal goal=20
    #[21] has_real_derivative (λx1. 1) 0 (atreal x)
    #[22] has_real_derivative (λx1. 1 - x1) (-1) (atreal x)
    #[23] ¬(1 - x = 0)
  ← apply_backward_step has_real_derivative_const goal=21
    #[24] has_real_derivative (λx1. 1) 0 (atreal x)
  cut "-1 = (0::real) - 1" goal=22
    #[25] -(1::real) = 0 - 1
  real_norm goal=25
    #[26] -(1::real) = 0 - 1
  ← rewrite_goal_with_prev goal=22 facts=[26]
    #[27] has_real_derivative (λx1. 1 - x1) (0 - 1) (atreal x)
  ← apply_backward_step has_real_derivative_sub goal=27
    #[28] has_real_derivative (λx1. x1) 1 (atreal x)
  ← apply_backward_step has_real_derivative_id goal=28
    #[29] has_real_derivative (λx1. x1) 1 (atreal x)
  ← z3 goal=23 facts=[1]
    #[30] ¬(1 - x = 0)
  cut "(0 * (1 - x) - 1 * -1) = 1" goal=19 facts=[20]
    #[31] 0 * (1 - x) - 1 * -1 = 1
  real_norm goal=31
    #[32] 0 * (1 - x) - 1 * -1 = 1
  → rewrite_fact_with_prev goal=19 facts=[32,20]
  → rewrite_fact_with_prev goal=14 facts=[18,17]
    #[33] real_sums (λi. of_nat i * 1 * x ^ (i - 1)) (1 / (1 - x) ^ (2::nat)) univ
  → apply_forward_step real_series_lmul param_c=x goal=14 facts=[33]
    #[34] real_sums (λn. x * (of_nat n * 1 * x ^ (n - 1))) (x * (1 / (1 - x) ^ (2::nat))) univ
  → rewrite_fact real_divide_def sym=false goal=14 facts=[34]
    #[35] real_sums (λn. x * (of_nat n * 1 * x ^ (n - 1))) (x * (1 * real_inverse ((1 - x) ^ (2::nat)))) univ
  → rewrite_fact real_mul_lid sym=false goal=14 facts=[35]
    #[36] real_sums (λn. x * (of_nat n * 1 * x ^ (n - 1))) (x * real_inverse ((1 - x) ^ (2::nat))) univ
  ← rewrite_goal real_divide_def sym=false goal=14
    #[37] real_sums (λi. of_nat i * x ^ i) (x * real_inverse ((1 - x) ^ (2::nat))) univ
  cut "!n. x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * x ^ n" goal=37 facts=[36]
    #[38] ∀n. x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * x ^ n
  ← introduction n goal=38
    #[39] _VAR n
    #[40] x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * x ^ n
  ← cases "n = 0" goal=40
    #[41] n = 0 ⟶ x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * x ^ n
    #[42] ¬(n = 0) ⟶ x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * x ^ n
  ← introduction goal=41
    #[43] n = 0
    #[44] x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * x ^ n
  ← rewrite_goal_with_prev goal=44 facts=[43]
    #[45] x * (of_nat 0 * 1 * x ^ ((0::nat) - 1)) = of_nat 0 * x ^ (0::nat)
  real_norm goal=45
    #[46] x * (of_nat 0 * 1 * x ^ ((0::nat) - 1)) = of_nat 0 * x ^ (0::nat)
  ← introduction goal=42
    #[47] ¬(n = 0)
    #[48] x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * x ^ n
  cut "x ^ (n-1 + 1) = x * x ^ (n - 1)" goal=48
    #[49] x ^ (n - 1 + 1) = x * x ^ (n - 1)
  ← rewrite_goal real_pow_add sym=false goal=49
    #[50] x ^ (n - 1) * x ^ (1::nat) = x * x ^ (n - 1)
  ← rewrite_goal real_pow_1 sym=false goal=50
    #[51] x ^ (n - 1) * x = x * x ^ (n - 1)
  ← apply_backward_step real_mult_comm goal=51
    #[52] x ^ (n - 1) * x = x * x ^ (n - 1)
  cut "n - 1 + 1 = n" goal=48 facts=[49]
    #[53] n - 1 + 1 = n
  ← apply_backward_step sub_add goal=53
    #[54] 1 ≤ n
  ← apply_backward_step le_1_2 goal=54
  → rewrite_fact_with_prev goal=48 facts=[53,49]
    #[55] x ^ n = x * x ^ (n - 1)
  ← rewrite_goal_with_prev goal=48 facts=[55]
    #[56] x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * (x * x ^ (n - 1))
  real_norm goal=56
    #[57] x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * (x * x ^ (n - 1))
  → rewrite_fact_with_prev goal=37 facts=[38,36]
qed

theorem real_sums_neg_i_xi
  fixes x :: real
  prop abs x < 1 --> real_sums (%i. -1 ^ i * of_nat i * x ^ i) (-(x / (1 + x) ^ (2::nat))) univ
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_sums (λi. -1 ^ i * of_nat i * x ^ i) (-(x / (1 + x) ^ (2::nat))) univ
  → apply_forward_step real_sums_i_xi param_x=-x goal=2
    #[3] abs (-x) < 1 ⟶ real_sums (λi. of_nat i * -x ^ i) (-x / (1 - -x) ^ (2::nat)) univ
  → rewrite_fact real_abs_neg sym=false goal=2 facts=[3]
    #[4] abs x < 1 ⟶ real_sums (λi. of_nat i * -x ^ i) (-x / (1 - -x) ^ (2::nat)) univ
  → apply_fact goal=2 facts=[4,1]
    #[5] real_sums (λi. of_nat i * -x ^ i) (-x / (1 - -x) ^ (2::nat)) univ
  cut "-x = -1 * x" goal=2
    #[6] -x = -1 * x
  real_norm goal=6
    #[7] -x = -1 * x
  → rewrite_fact real_minus_def sym=false goal=2 facts=[5]
    #[8] real_sums (λi. of_nat i * -x ^ i) (-x / (1 + --x) ^ (2::nat)) univ
  → rewrite_fact real_neg_neg sym=false goal=2 facts=[8]
    #[9] real_sums (λi. of_nat i * -x ^ i) (-x / (1 + x) ^ (2::nat)) univ
  → rewrite_fact_with_prev goal=2 facts=[7,9]
    #[10] real_sums (λi. of_nat i * (-1 * x) ^ i) (-1 * x / (1 + x) ^ (2::nat)) univ
  → rewrite_fact real_pow_mul sym=false goal=2 facts=[10]
    #[11] real_sums (λi. of_nat i * (-1 ^ i * x ^ i)) (-1 * x / (1 + x) ^ (2::nat)) univ
  → rewrite_fact real_mul_lneg sym=false goal=2 facts=[11]
    #[12] real_sums (λi. of_nat i * (-1 ^ i * x ^ i)) (-(1 * x) / (1 + x) ^ (2::nat)) univ
  cut "(-(1 * x) / (1 + x) ^ (2::nat)) = (-(x / (1 + x) ^ (2::nat)))" goal=2 facts=[12]
    #[13] -(1 * x) / (1 + x) ^ (2::nat) = -(x / (1 + x) ^ (2::nat))
  ← rewrite_goal real_divide_def sym=false goal=13
    #[14] -(1 * x) * real_inverse ((1 + x) ^ (2::nat)) = -(x * real_inverse ((1 + x) ^ (2::nat)))
  real_norm goal=14
    #[15] -(1 * x) * real_inverse ((1 + x) ^ (2::nat)) = -(x * real_inverse ((1 + x) ^ (2::nat)))
  → rewrite_fact_with_prev goal=2 facts=[13,12]
    #[16] real_sums (λi. of_nat i * (-1 ^ i * x ^ i)) (-(x / (1 + x) ^ (2::nat))) univ
  cut "!i. of_nat i * (-1 ^ i * x ^ i) = -1 ^ i * of_nat i * x ^ i" goal=2 facts=[16]
    #[17] ∀i. of_nat i * (-1 ^ i * x ^ i) = -1 ^ i * of_nat i * x ^ i
  ← introduction i goal=17
    #[18] _VAR i
    #[19] of_nat i * (-1 ^ i * x ^ i) = -1 ^ i * of_nat i * x ^ i
  real_norm goal=19
    #[20] of_nat i * (-1 ^ i * x ^ i) = -1 ^ i * of_nat i * x ^ i
  → rewrite_fact_with_prev goal=2 facts=[17,16]
qed

theorem real_sums_neg_xi
  fixes x :: real
  prop abs x < 1 --> real_sums (%i. -1 ^ i * x ^ i) (1 / (1 + x)) univ
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_sums (λi. -1 ^ i * x ^ i) (1 / (1 + x)) univ
  → apply_forward_step real_sums_gp param_n="(0::nat)" param_x="(-x)" goal=2
    #[3] abs (-x) < 1 ⟶ real_sums (λk. -x ^ k) (-x ^ (0::nat) / (1 - -x)) (from 0)
  → rewrite_fact real_abs_neg sym=false goal=2 facts=[3]
    #[4] abs x < 1 ⟶ real_sums (λk. -x ^ k) (-x ^ (0::nat) / (1 - -x)) (from 0)
  → apply_fact goal=2 facts=[4,1]
    #[5] real_sums (λk. -x ^ k) (-x ^ (0::nat) / (1 - -x)) (from 0)
  → rewrite_fact from_0 sym=false goal=2 facts=[5]
    #[6] real_sums (λk. -x ^ k) (-x ^ (0::nat) / (1 - -x)) univ
  → rewrite_fact real_nat_power_def_1 sym=false goal=2 facts=[6]
    #[7] real_sums (λk. -x ^ k) (1 / (1 - -x)) univ
  → rewrite_fact real_minus_def sym=false goal=2 facts=[7]
    #[8] real_sums (λk. -x ^ k) (1 / (1 + --x)) univ
  → rewrite_fact real_neg_neg sym=false goal=2 facts=[8]
    #[9] real_sums (λk. -x ^ k) (1 / (1 + x)) univ
  ← rewrite_goal real_pow_mul sym=true goal=2
    #[10] real_sums (λi. (-1 * x) ^ i) (1 / (1 + x)) univ
  ← rewrite_goal real_mul_lneg sym=false goal=10
    #[11] real_sums (λi. -(1 * x) ^ i) (1 / (1 + x)) univ
  ← rewrite_goal real_mul_lid sym=false goal=11
qed

theorem exp_series
  fixes x :: real
  prop real_sums (%k. 1 / of_nat (fact k) * x ^ k) (exp x) univ
  [hint_backward]

theorem exp_infsum
  fixes x :: real
  prop real_infsum (from 0) (%k. 1 / of_nat (fact k) * x ^ k) = exp x
  [hint_rewrite]
proof
  ← apply_backward_step real_infsum_unique goal=0
    #[1] real_sums (λk. 1 / of_nat (fact k) * x ^ k) (exp x) (from 0)
  ← rewrite_goal from_0 sym=false goal=1
    #[2] real_sums (λk. 1 / of_nat (fact k) * x ^ k) (exp x) univ
  ← apply_backward_step exp_series goal=2
qed

theorem log_derivative_series
  fixes x :: real
  prop abs x < 1 --> real_sums (%i. -1 ^ i * x ^ i) (real_inverse (1 + x)) univ
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_sums (λi. -1 ^ i * x ^ i) (real_inverse (1 + x)) univ
  ← rewrite_goal real_inverse_divide sym=false goal=2
    #[3] real_sums (λi. -1 ^ i * x ^ i) (1 / (1 + x)) univ
  ← apply_backward_step real_sums_neg_xi goal=3
qed

theorem log_series
  fixes x :: real
  prop abs x < 1 --> real_sums (%k. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) (log (1 + x)) univ
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_sums (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) (log (1 + x)) univ
  → apply_forward_step power_series_integral2 param_a="(λk::nat. -(1::real) ^ k)" param_f="(%x. log (1 + x))" param_f1="(%x. real_inverse (1 + x))" param_r="(1::real)" param_s="(univ::nat set)" goal=2
    #[3] (∀x. abs x < 1 ⟶ has_real_derivative (λx1. log (1 + x1)) (real_inverse (1 + x)) (atreal x)) ⟶ (∀x. abs x < 1 ⟶ real_sums (λi. -1 ^ i * x ^ i) (real_inverse (1 + x)) univ) ⟶ (∀x. abs x < 1 ⟶ real_sums (λi. -1 ^ i * x ^ (i + 1) / of_nat (i + 1)) (log (1 + x) - log (1 + 0)) univ)
  cut "(∀x. abs x < 1 ⟶ has_real_derivative (λx1. log (1 + x1)) (real_inverse (1 + x)) (atreal x))" goal=2 facts=[3]
    #[4] ∀x. abs x < 1 ⟶ has_real_derivative (λx1. log (1 + x1)) (real_inverse (1 + x)) (atreal x)
  ← introduction x goal=4
    #[5] _VAR x
    #[6] has_real_derivative (λx1. log (1 + x1)) (real_inverse (1 + x)) (atreal x)
  cut "real_inverse (1 + x) = real_inverse (1 + x) * 1" goal=6
    #[7] real_inverse (1 + x) = real_inverse (1 + x) * 1
  ← rewrite_goal real_mul_rid sym=false goal=7
    #[8] real_inverse (1 + x) = real_inverse (1 + x) * 1
  ← rewrite_goal_with_prev goal=6 facts=[8]
    #[9] has_real_derivative (λx1. log (1 + x1)) (real_inverse (1 + x) * 1) (atreal x)
  ← apply_backward_step real_diff_chain_atreal goal=9
    #[10] has_real_derivative (λx1. 1 + x1) 1 (atreal x)
    #[11] has_real_derivative log (real_inverse (1 + x)) (atreal (1 + x))
  cut "has_real_derivative (λx1. 1 + x1) (0 + 1) (atreal x)" goal=10
    #[12] has_real_derivative (λx1. 1 + x1) (0 + 1) (atreal x)
  ← apply_backward_step has_real_derivative_add goal=12
    #[13] has_real_derivative (λx1. 1) 0 (atreal x)
    #[14] has_real_derivative (λx1. x1) 1 (atreal x)
  ← apply_backward_step has_real_derivative_const goal=13
    #[15] has_real_derivative (λx1. 1) 0 (atreal x)
  ← apply_backward_step has_real_derivative_id goal=14
    #[16] has_real_derivative (λx1. x1) 1 (atreal x)
  → rewrite_fact real_add_lid sym=false goal=10 facts=[12]
  ← apply_backward_step has_real_derivative_log goal=11
    #[17] 0 < 1 + x
  ← z3 goal=17 facts=[1]
  → apply_fact goal=2 facts=[3,4]
    #[18] (∀x. abs x < 1 ⟶ real_sums (λi. -1 ^ i * x ^ i) (real_inverse (1 + x)) univ) ⟶ (∀x. abs x < 1 ⟶ real_sums (λi. -1 ^ i * x ^ (i + 1) / of_nat (i + 1)) (log (1 + x) - log (1 + 0)) univ)
  cut "(∀x. abs x < 1 ⟶ real_sums (λi. -1 ^ i * x ^ i) (real_inverse (1 + x)) univ)" goal=2 facts=[18]
    #[19] ∀x. abs x < 1 ⟶ real_sums (λi. -1 ^ i * x ^ i) (real_inverse (1 + x)) univ
  ← introduction x goal=19
    #[20] real_sums (λi. -1 ^ i * x ^ i) (real_inverse (1 + x)) univ
  ← apply_backward_step log_derivative_series goal=20
  → apply_fact goal=2 facts=[18,19]
    #[21] ∀x. abs x < 1 ⟶ real_sums (λi. -1 ^ i * x ^ (i + 1) / of_nat (i + 1)) (log (1 + x) - log (1 + 0)) univ
  → apply_fact goal=2 facts=[21,1]
    #[22] real_sums (λi. -1 ^ i * x ^ (i + 1) / of_nat (i + 1)) (log (1 + x) - log (1 + 0)) univ
  → rewrite_fact real_add_rid sym=false goal=2 facts=[22]
    #[23] real_sums (λi. -1 ^ i * x ^ (i + 1) / of_nat (i + 1)) (log (1 + x) - log 1) univ
  → rewrite_fact log_1 sym=false goal=2 facts=[23]
    #[24] real_sums (λi. -1 ^ i * x ^ (i + 1) / of_nat (i + 1)) (log (1 + x) - 0) univ
  → rewrite_fact real_sub_rzero sym=false goal=2 facts=[24]
    #[25] real_sums (λi. -1 ^ i * x ^ (i + 1) / of_nat (i + 1)) (log (1 + x)) univ
  cut "!a::real. !b::real. !x. a * x / b = a / b * x" goal=2
    #[26] ∀a. ∀b. ∀x. a * x / b = a / b * x
  ← rewrite_goal real_divide_def sym=false goal=26
    #[27] ∀a. ∀b. ∀x. a * x * real_inverse b = a * real_inverse b * x
  ← introduction a,b,c goal=27
    #[28] _VAR a
    #[29] _VAR b
    #[30] _VAR c
    #[31] a * c * real_inverse b = a * real_inverse b * c
  real_norm goal=31
    #[32] a * c * real_inverse b = a * real_inverse b * c
  → rewrite_fact_with_prev goal=2 facts=[26,25]
qed

theorem log_infsum
  fixes x :: real
  prop abs x < 1 --> real_infsum (from 0) (%k. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) = log (1 + x)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) = log (1 + x)
  ← apply_backward_step real_infsum_unique goal=2
    #[3] real_sums (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) (log (1 + x)) (from 0)
  ← rewrite_goal from_0 sym=false goal=3
    #[4] real_sums (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) (log (1 + x)) univ
  ← apply_backward_step log_series goal=4 facts=[1]
qed

theorem atn_derivative_series
  fixes x :: real
  prop abs x < 1 --> real_sums (%k. (if even k then -1 ^ (k DIV 2) else 0) * x ^ k) (real_inverse (1 + x ^ (2::nat))) univ
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_sums (λk. (if even k then -1 ^ (k DIV 2) else 0) * x ^ k) (real_inverse (1 + x ^ (2::nat))) univ
  → apply_forward_step real_sums_gp param_n="(0::nat)" param_x="(-1) * x ^ (2::nat)" goal=2
    #[3] abs (-1 * x ^ (2::nat)) < 1 ⟶ real_sums (λk. (-1 * x ^ (2::nat)) ^ k) ((-1 * x ^ (2::nat)) ^ (0::nat) / (1 - -1 * x ^ (2::nat))) (from 0)
  cut "abs (-1 * x ^ (2::nat)) < 1" goal=2 facts=[3]
    #[4] abs (-1 * x ^ (2::nat)) < 1
  ← rewrite_goal real_pow_2 sym=false goal=4
    #[5] abs (-1 * (x * x)) < 1
  ← rewrite_goal real_abs_mul sym=false goal=5
    #[6] abs (-1) * abs (x * x) < 1
  ← rewrite_goal real_abs_neg sym=false goal=6
    #[7] abs 1 * abs (x * x) < 1
  ← rewrite_goal real_abs_mul sym=false goal=7
    #[8] abs 1 * (abs x * abs x) < 1
  ← rewrite_goal real_mult_assoc sym=false goal=8
    #[9] abs 1 * abs x * abs x < 1
  ← rewrite_goal real_abs_mul sym=true goal=9
    #[10] abs (1 * x) * abs x < 1
  ← rewrite_goal real_mul_lid sym=false goal=10
    #[11] abs x * abs x < 1
  ← rewrite_goal real_pow_2 sym=true goal=11
    #[12] abs x ^ (2::nat) < 1
  ← apply_backward_step real_pow_1_lt goal=12
    #[13] ¬((2::nat) = 0)
    #[14] 0 ≤ abs x
  nat_const_ineq goal=13
    #[15] ¬((2::nat) = 0)
  ← apply_backward_step real_abs_pos goal=14
    #[16] 0 ≤ abs x
  → apply_fact goal=2 facts=[3,4]
    #[17] real_sums (λk. (-1 * x ^ (2::nat)) ^ k) ((-1 * x ^ (2::nat)) ^ (0::nat) / (1 - -1 * x ^ (2::nat))) (from 0)
  → rewrite_fact from_0 sym=false goal=2 facts=[17]
    #[18] real_sums (λk. (-1 * x ^ (2::nat)) ^ k) ((-1 * x ^ (2::nat)) ^ (0::nat) / (1 - -1 * x ^ (2::nat))) univ
  → rewrite_fact real_mul_lneg sym=false goal=2 facts=[18]
    #[19] real_sums (λk. -(1 * x ^ (2::nat)) ^ k) (-(1 * x ^ (2::nat)) ^ (0::nat) / (1 - -(1 * x ^ (2::nat)))) univ
  → rewrite_fact real_mul_lid sym=false goal=2 facts=[19]
    #[20] real_sums (λk. -(x ^ (2::nat)) ^ k) (-(x ^ (2::nat)) ^ (0::nat) / (1 - -(x ^ (2::nat)))) univ
  → rewrite_fact real_minus_def sym=false goal=2 facts=[20]
    #[21] real_sums (λk. -(x ^ (2::nat)) ^ k) (-(x ^ (2::nat)) ^ (0::nat) / (1 + --(x ^ (2::nat)))) univ
  → rewrite_fact real_neg_neg sym=false goal=2 facts=[21]
    #[22] real_sums (λk. -(x ^ (2::nat)) ^ k) (-(x ^ (2::nat)) ^ (0::nat) / (1 + x ^ (2::nat))) univ
  → rewrite_fact real_nat_power_def_1 sym=false goal=2 facts=[22]
    #[23] real_sums (λk. -(x ^ (2::nat)) ^ k) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal real_inverse_divide sym=false goal=2
    #[24] real_sums (λk. (if even k then -1 ^ (k DIV 2) else 0) * x ^ k) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal cond_rand sym=false goal=24
    #[25] real_sums (λk. (if even k then times (-1 ^ (k DIV 2)) else times 0) (x ^ k)) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal cond_rator sym=false goal=25
    #[26] real_sums (λk. if even k then -1 ^ (k DIV 2) * x ^ k else 0 * x ^ k) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal real_mul_lzero sym=false goal=26
    #[27] real_sums (λk. if even k then -1 ^ (k DIV 2) * x ^ k else 0) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal real_sums_image_even sym=false goal=27
    #[28] real_sums (λk. -1 ^ (2 * k DIV 2) * x ^ (2 * k)) (1 / (1 + x ^ (2::nat))) univ
  cut "!i. 2 * i DIV 2 = i" goal=28
    #[29] ∀i. 2 * i DIV 2 = i
  ← introduction i goal=29
    #[30] _VAR i
    #[31] 2 * i DIV 2 = i
  ← apply_backward_step div_mult goal=31
  ← rewrite_goal_with_prev goal=28 facts=[29]
    #[32] real_sums (λk. -1 ^ k * x ^ (2 * k)) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal real_pow_pow sym=true goal=32
    #[33] real_sums (λk. -1 ^ k * x ^ (2::nat) ^ k) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal real_pow_mul sym=true goal=33
    #[34] real_sums (λk. (-1 * x ^ (2::nat)) ^ k) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal real_mul_lneg sym=false goal=34
    #[35] real_sums (λk. -(1 * x ^ (2::nat)) ^ k) (1 / (1 + x ^ (2::nat))) univ
  ← rewrite_goal real_mul_lid sym=false goal=35
qed

theorem atn_series
  fixes x :: real
  prop abs x < 1 --> real_sums (%k. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) (atn x) univ
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_sums (λk. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) (atn x) univ
  → apply_forward_step power_series_integral2 param_a="(%k. if even k then (-1) ^ (k DIV 2) else (0::real))" param_f=atn param_f1="(%x. real_inverse (1 + x ^ (2::nat)))" param_r="(1::real)" param_s="(univ::nat set)" goal=2
    #[3] (∀x. abs x < 1 ⟶ has_real_derivative atn (real_inverse (1 + x ^ (2::nat))) (atreal x)) ⟶ (∀x. abs x < 1 ⟶ real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ i) (real_inverse (1 + x ^ (2::nat))) univ) ⟶ (∀x. abs x < 1 ⟶ real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ (i + 1) / of_nat (i + 1)) (atn x - atn 0) univ)
  cut "(∀x. abs x < 1 ⟶ has_real_derivative atn (real_inverse (1 + x ^ (2::nat))) (atreal x))" goal=2
    #[4] ∀x. abs x < 1 ⟶ has_real_derivative atn (real_inverse (1 + x ^ (2::nat))) (atreal x)
  ← introduction x goal=4
    #[5] _VAR x
    #[6] has_real_derivative atn (real_inverse (1 + x ^ (2::nat))) (atreal x)
  ← apply_backward_step has_real_derivative_atn goal=6
    #[7] has_real_derivative atn (real_inverse (1 + x ^ (2::nat))) (atreal x)
  → apply_fact goal=2 facts=[3,4]
    #[8] (∀x. abs x < 1 ⟶ real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ i) (real_inverse (1 + x ^ (2::nat))) univ) ⟶ (∀x. abs x < 1 ⟶ real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ (i + 1) / of_nat (i + 1)) (atn x - atn 0) univ)
  cut "(∀x. abs x < 1 ⟶ real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ i) (real_inverse (1 + x ^ (2::nat))) univ)" goal=2
    #[9] ∀x. abs x < 1 ⟶ real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ i) (real_inverse (1 + x ^ (2::nat))) univ
  ← introduction x goal=9
    #[10] real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ i) (real_inverse (1 + x ^ (2::nat))) univ
  ← apply_backward_step atn_derivative_series goal=10
  → apply_fact goal=2 facts=[8,9]
    #[11] ∀x. abs x < 1 ⟶ real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ (i + 1) / of_nat (i + 1)) (atn x - atn 0) univ
  → apply_fact goal=2 facts=[11,1]
    #[12] real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ (i + 1) / of_nat (i + 1)) (atn x - atn 0) univ
  → rewrite_fact atn_0 sym=false goal=2 facts=[12]
    #[13] real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ (i + 1) / of_nat (i + 1)) (atn x - 0) univ
  → rewrite_fact real_sub_rzero sym=false goal=2 facts=[13]
    #[14] real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ (i + 1) / of_nat (i + 1)) (atn x) univ
  → rewrite_fact cond_rand sym=false goal=2 facts=[14]
    #[15] real_sums (λi. (if even i then times (-1 ^ (i DIV 2)) else times 0) (x ^ (i + 1)) / of_nat (i + 1)) (atn x) univ
  → rewrite_fact cond_rator sym=false goal=2 facts=[15]
    #[16] real_sums (λi. (if even i then -1 ^ (i DIV 2) * x ^ (i + 1) else 0 * x ^ (i + 1)) / of_nat (i + 1)) (atn x) univ
  → rewrite_fact real_mul_lzero sym=false goal=2 facts=[16]
    #[17] real_sums (λi. (if even i then -1 ^ (i DIV 2) * x ^ (i + 1) else 0) / of_nat (i + 1)) (atn x) univ
  → rewrite_fact cond_rand sym=false goal=2 facts=[17]
    #[18] real_sums (λi. (if even i then real_divide (-1 ^ (i DIV 2) * x ^ (i + 1)) else real_divide 0) (of_nat (i + 1))) (atn x) univ
  → rewrite_fact cond_rator sym=false goal=2 facts=[18]
    #[19] real_sums (λi. if even i then -1 ^ (i DIV 2) * x ^ (i + 1) / of_nat (i + 1) else 0 / of_nat (i + 1)) (atn x) univ
  cut "∀i. 0 / i = 0" goal=2
    #[20] ∀i. 0 / i = 0
  ← rewrite_goal real_div_eq_0 sym=false goal=20
    #[21] ∀i::real. (0::real) = 0 ∨ i = 0
  ← introduction i goal=21
    #[22] _VAR i
    #[23] (0::real) = 0 ∨ i = 0
  ← apply_backward_step disjI1 goal=23
    #[24] (0::real) = 0
  ← apply_backward_step eq_refl goal=24
    #[25] (0::real) = 0
  → rewrite_fact_with_prev goal=2 facts=[20,19]
    #[26] real_sums (λi. if even i then -1 ^ (i DIV 2) * x ^ (i + 1) / of_nat (i + 1) else 0) (atn x) univ
  → rewrite_fact real_sums_image_even sym=false goal=2 facts=[26]
    #[27] real_sums (λi. -1 ^ (2 * i DIV 2) * x ^ (2 * i + 1) / of_nat (2 * i + 1)) (atn x) univ
  cut "!i. 2 * i DIV 2 = i" goal=2
    #[28] ∀i. 2 * i DIV 2 = i
  ← introduction i goal=28
    #[29] _VAR i
    #[30] 2 * i DIV 2 = i
  ← apply_backward_step div_mult goal=30
    #[31] ¬((2::nat) = 0)
  nat_const_ineq goal=31
    #[32] ¬((2::nat) = 0)
  → rewrite_fact_with_prev goal=2 facts=[28,27]
    #[33] real_sums (λi. -1 ^ i * x ^ (2 * i + 1) / of_nat (2 * i + 1)) (atn x) univ
  cut "!a. !b. !c::real. a / b * c = a * c / b" goal=2
    #[34] ∀a. ∀b. ∀c. a / b * c = a * c / b
  ← introduction a,b,c goal=34
    #[35] _VAR a
    #[36] _VAR b
    #[37] _VAR c
    #[38] a / b * c = a * c / b
  ← rewrite_goal real_divide_def sym=false goal=38
    #[39] a * real_inverse b * c = a * c * real_inverse b
  real_norm goal=39
    #[40] a * real_inverse b * c = a * c * real_inverse b
  ← rewrite_goal_with_prev goal=2 facts=[34]
qed

theorem atn_infsum
  fixes x :: real
  prop abs x < 1 --> real_infsum (from 0) (%k. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) = atn x
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_infsum (from 0) (λk. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) = atn x
  ← apply_backward_step real_infsum_unique goal=2
    #[3] real_sums (λk. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) (atn x) (from 0)
  ← rewrite_goal from_0 sym=false goal=3
    #[4] real_sums (λk. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) (atn x) univ
  ← apply_backward_step atn_series goal=4 facts=[1]
qed

theorem sin_series
  fixes x :: real
  prop real_sums (%k. -1 ^ k / of_nat (fact (2 * k + 1)) * x ^ (2 * k + 1)) (sin x) univ
  [hint_backward]

theorem sin_infsum
  fixes x :: real
  prop real_infsum (from 0) (%k. -1 ^ k / of_nat (fact (2 * k + 1)) * x ^ (2 * k + 1)) = sin x
  [hint_rewrite]
proof
  ← apply_backward_step real_infsum_unique goal=0
    #[1] real_sums (λk. -1 ^ k / of_nat (fact (2 * k + 1)) * x ^ (2 * k + 1)) (sin x) (from 0)
  ← rewrite_goal from_0 sym=false goal=1
    #[2] real_sums (λk. -1 ^ k / of_nat (fact (2 * k + 1)) * x ^ (2 * k + 1)) (sin x) univ
  ← apply_backward_step sin_series goal=2
qed

theorem cos_series
  fixes x :: real
  prop real_sums (%k. -1 ^ k / of_nat (fact (2 * k)) * x ^ (2 * k)) (cos x) univ
  [hint_backward]

theorem cos_infsum
  fixes x :: real
  prop real_infsum (from 0) (%k. -1 ^ k / of_nat (fact (2 * k)) * x ^ (2 * k)) = cos x
  [hint_rewrite]
proof
  ← apply_backward_step real_infsum_unique goal=0
    #[1] real_sums (λk. -1 ^ k / of_nat (fact (2 * k)) * x ^ (2 * k)) (cos x) (from 0)
  ← rewrite_goal from_0 sym=false goal=1
    #[2] real_sums (λk. -1 ^ k / of_nat (fact (2 * k)) * x ^ (2 * k)) (cos x) univ
  ← apply_backward_step cos_series goal=2
qed

