    6: apply_fact @5,0
    7: rewrite_fact real_add_rid @6 sym=false
    8: rewrite_fact log_1 @7 sym=false
    9: rewrite_fact real_sub_rzero @8 sym=false
    10: cut "!a::real. !b::real. !x. a * x / b = a / b * x"
    10: rewrite_goal real_divide_def sym=false
    10: introduction a,b,c
    10.3: real_norm
    12: rewrite_fact_with_prev @11,9
  qed

theorem log_infsum
  fixes x :: real
  prop abs x < 1 ⟶ real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) = log (1 + x)
  [hint_backward]
  proof
    1: apply_backward_step real_infsum_unique
    1: rewrite_goal from_0 sym=false
    1: apply_backward_step log_series @0
  qed

theorem atn_derivative_series
  fixes x :: real
  prop abs x < 1 ⟶ real_sums (λk. (if even k then -1 ^ (k DIV 2) else 0) * x ^ k) (real_inverse (1 + x ^ (2::nat))) univ
  [hint_backward]
  proof
    1: apply_forward_step real_sums_gp param_n="(0::nat)" param_x="(-1) * x ^ (2::nat)"
    2: cut "abs (-1 * x ^ (2::nat)) < 1" @1
    2: rewrite_goal real_pow_2 sym=false
    2: rewrite_goal real_abs_mul sym=false
    2: rewrite_goal real_abs_neg sym=false
    2: rewrite_goal real_abs_mul sym=false
    2: rewrite_goal real_mult_assoc sym=false
    2: rewrite_goal real_abs_mul sym=true
    2: rewrite_goal real_mul_lid sym=false
    2: rewrite_goal real_pow_2 sym=true
    2: apply_backward_step real_pow_1_lt
    2: nat_const_ineq
    3: apply_backward_step real_abs_pos
    13: apply_fact @1,12
    14: rewrite_fact from_0 @13 sym=false
    15: rewrite_fact real_mul_lneg @14 sym=false
    16: rewrite_fact real_mul_lid @15 sym=false
    17: rewrite_fact real_minus_def @16 sym=false
    18: rewrite_fact real_neg_neg @17 sym=false
    19: rewrite_fact real_nat_power_def_1 @18 sym=false
    20: rewrite_goal real_inverse_divide sym=false
    20: rewrite_goal cond_rand sym=false
    20: rewrite_goal cond_rator sym=false
    20: rewrite_goal real_mul_lzero sym=false
    20: rewrite_goal real_sums_image_even sym=false
    20: cut "!i. 2 * i DIV 2 = i"
    20: introduction i
    20.1: apply_backward_step div_mult
    21: rewrite_goal_with_prev @20
    21: rewrite_goal real_pow_pow sym=true
    21: rewrite_goal real_pow_mul sym=true
    21: rewrite_goal real_mul_lneg sym=false
    21: rewrite_goal real_mul_lid sym=false
  qed

theorem atn_series
  fixes x :: real
  prop abs x < 1 ⟶ real_sums (λk. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) (atn x) univ
  [hint_backward]
  proof
    1: apply_forward_step power_series_integral2 param_a="(%k. if even k then (-1) ^ (k DIV 2) else (0::real))" param_f=atn param_f1="(%x. real_inverse (1 + x ^ (2::nat)))" param_r="(1::real)" param_s="(univ::nat set)"
    2: cut "(∀x. abs x < 1 ⟶ has_real_derivative atn (real_inverse (1 + x ^ (2::nat))) (atreal x))"
    2: introduction x
    2.1: apply_backward_step has_real_derivative_atn
    3: apply_fact @1,2
    4: cut "(∀x. abs x < 1 ⟶ real_sums (λi. (if even i then -1 ^ (i DIV 2) else 0) * x ^ i) (real_inverse (1 + x ^ (2::nat))) univ)"
    4: introduction x
    4.1: apply_backward_step atn_derivative_series
    5: apply_fact @3,4
    6: apply_fact @5,0
    7: rewrite_fact atn_0 @6 sym=false
    8: rewrite_fact real_sub_rzero @7 sym=false
    9: rewrite_fact cond_rand @8 sym=false
    10: rewrite_fact cond_rator @9 sym=false
    11: rewrite_fact real_mul_lzero @10 sym=false
    12: rewrite_fact cond_rand @11 sym=false
    13: rewrite_fact cond_rator @12 sym=false
    14: cut "∀i. 0 / i = 0"
    14: rewrite_goal real_div_eq_0 sym=false
    14: introduction i
    14.1: apply_backward_step disjI1
    14.1: apply_backward_step eq_refl
    16: rewrite_fact_with_prev @15,13
    17: rewrite_fact real_sums_image_even @16 sym=false
    18: cut "!i. 2 * i DIV 2 = i"
    18: introduction i
    18.1: apply_backward_step div_mult
    18.1: nat_const_ineq
    19: rewrite_fact_with_prev @18,17
    20: cut "!a. !b. !c::real. a / b * c = a * c / b"
    20: introduction a,b,c
    20.3: rewrite_goal real_divide_def sym=false
    20.3: real_norm
    21: rewrite_goal_with_prev @20
  qed

theorem atn_infsum
  fixes x :: real
  prop abs x < 1 ⟶ real_infsum (from 0) (λk. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) = atn x
  [hint_backward]
  proof
    1: apply_backward_step real_infsum_unique
    1: rewrite_goal from_0 sym=false
    1: apply_backward_step atn_series @0
  qed

theorem sin_series
  fixes x :: real
  prop real_sums (λk. -1 ^ k / of_nat (fact (2 * k + 1)) * x ^ (2 * k + 1)) (sin x) univ
  [hint_backward]

theorem sin_infsum
  fixes x :: real
  prop real_infsum (from 0) (λk. -1 ^ k / of_nat (fact (2 * k + 1)) * x ^ (2 * k + 1)) = sin x
  [hint_rewrite]
  proof
    0: apply_backward_step real_infsum_unique
    0: rewrite_goal from_0 sym=false
    0: apply_backward_step sin_series
  qed

theorem cos_series
  fixes x :: real
  prop real_sums (λk. -1 ^ k / of_nat (fact (2 * k)) * x ^ (2 * k)) (cos x) univ
  [hint_backward]

theorem cos_infsum
  fixes x :: real
  prop real_infsum (from 0) (λk. -1 ^ k / of_nat (fact (2 * k)) * x ^ (2 * k)) = cos x
  [hint_rewrite]
  proof
    0: apply_backward_step real_infsum_unique
    0: rewrite_goal from_0 sym=false
    0: apply_backward_step cos_series
  qed
