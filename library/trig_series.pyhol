    #[91] has_real_integral f v (real_closed_interval x 0)
  → apply_forward_step real_integral_unique goal=87 facts=[91]
    #[92] real_integral (real_closed_interval x 0) f = v
  ← rewrite_goal_with_prev goal=87 facts=[92]
    #[93] real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (-v) s
  → rewrite_fact if_P sym=false goal=93 facts=[83,51]
    #[94] real_sums (λi. a i * -1 * x ^ (i + 1) / of_nat (i + 1)) v s
  → apply_forward_step real_series_neg goal=93 facts=[94]
    #[95] real_sums (λn. -(a n * -1 * x ^ (n + 1) / of_nat (n + 1))) (-v) s
  cut "!i. -(a i * -1 * x ^ (i + 1) / of_nat (i + 1)) = a i * x ^ (i + 1) / of_nat (i + 1)" goal=93
    #[96] ∀i. -(a i * -1 * x ^ (i + 1) / of_nat (i + 1)) = a i * x ^ (i + 1) / of_nat (i + 1)
  ← rewrite_goal real_divide_def sym=false goal=96
    #[97] ∀i. -(a i * -1 * x ^ (i + 1) * real_inverse (of_nat (i + 1))) = a i * x ^ (i + 1) * real_inverse (of_nat (i + 1))
  ← introduction i goal=97
    #[98] _VAR i
    #[99] -(a i * -1 * x ^ (i + 1) * real_inverse (of_nat (i + 1))) = a i * x ^ (i + 1) * real_inverse (of_nat (i + 1))
  real_norm goal=99
    #[100] -(a i * -1 * x ^ (i + 1) * real_inverse (of_nat (i + 1))) = a i * x ^ (i + 1) * real_inverse (of_nat (i + 1))
  → rewrite_fact_with_prev goal=93 facts=[96,95]
  ← introduction goal=85
    #[101] real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s
  ← rewrite_goal if_not_P sym=false goal=101 facts=[66]
