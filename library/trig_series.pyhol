    9: apply_backward_step has_real_derivative_div_atreal
    9: apply_backward_step has_real_derivative_const
    10: cut "-1 = (0::real) - 1"
    10: real_norm
    11: rewrite_goal_with_prev @10
    11: apply_backward_step has_real_derivative_sub
    11: apply_backward_step has_real_derivative_id
    14: z3 @0
    16: cut "(0 * (1 - x) - 1 * -1) = 1" @15
    16: real_norm
    17: rewrite_fact_with_prev @16,15
    19: rewrite_fact_with_prev @18,8
    20: apply_forward_step real_series_lmul @19 param_c=x
    21: rewrite_fact real_divide_def @20 sym=false
    22: rewrite_fact real_mul_lid @21 sym=false
    23: rewrite_goal real_divide_def sym=false
    23: cut "!n. x * (of_nat n * 1 * x ^ (n - 1)) = of_nat n * x ^ n" @22
