  real_norm goal=45
    #[46] a n * (if x < 0 then -1 else 1) * x ^ (n + 1) * real_inverse (of_nat (n + 1)) = a n * ((if x < 0 then -1 else 1) * x ^ (n + 1) * real_inverse (of_nat (n + 1)))
  ← rewrite_goal_with_prev goal=43 facts=[44]
    #[47] has_real_integral (λx1. a n * x1 ^ n) (a n * ((if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1))) (real_closed_interval (min x 0) (max x 0))
  ← apply_backward_step has_real_integral_lmul goal=47
    #[48] has_real_integral (λx1. x1 ^ n) ((if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0))
  ← cases "x < 0" goal=48
    #[49] x < 0 ⟶ has_real_integral (λx1. x1 ^ n) ((if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0))
    #[50] ¬(x < 0) ⟶ has_real_integral (λx1. x1 ^ n) ((if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0))
  ← introduction goal=49
    #[51] x < 0
