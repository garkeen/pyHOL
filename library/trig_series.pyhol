theorem summable_power_series_derivative
  fixes a :: nat ⇒ real, s :: nat set, y :: real
  prop real_summable s (λi. a i * y ^ i) ⟶ (∀x. abs x < y ⟶ real_summable s (λi. of_nat i * a i * x ^ (i - 1)))
  [hint_backward]
  proof
    1: introduction x
    1.2: apply_backward_step summable_power_series_shift
    1.2: cases "x=0"
    1.2: introduction
    1.2.1: rewrite_goal_with_prev @1.2.0
    1.2.1: apply_backward_step real_summable_comparison param_g="(%n::nat. (0::real))"
    1.2.1: apply_backward_step real_summable_0
    1.2.2: inst_exists_goal "(2::nat)"
    1.2.2: introduction i
    1.2.2.3: cut "~(i = 0)" @1.2.2.1
    1.2.2.3: z3 @1.2.2.1
    1.2.2.4: rewrite_goal real_pow_zero sym=false
    1.2.2.4: rewrite_goal if_not_P @1.2.2.3 sym=false
    1.2.2.4: rewrite_goal real_mul_rzero sym=false
    1.2.2.4: rewrite_goal real_abs_0 sym=false
    1.2.2.4: apply_backward_step real_le_refl
    1.3: introduction
    1.3.1: cut "~(y=0)"
    1.3.1: z3 @1.1
    1.3.2: cut "0 < y"
    1.3.2: z3 @1.1
    1.3.3: cut "0 < abs x"
    1.3.3: apply_backward_step real_abs_nz @1.3.0
    1.3.4: cut "~(abs x = 0)"
    1.3.4: z3 @1.3.0
    1.3.5: cut "0 < (y / (abs x) - 1) / 2"
    1.3.5: rewrite_goal real_divide_def sym=false
    1.3.5: apply_backward_step real_lt_mul
    1.3.5: rewrite_goal real_sub_lt sym=false
    1.3.5: apply_forward_step real_lt_rdiv_eq @1.3.3 param_x="(1::real)" param_y=y
    1.3.6: rewrite_goal_with_prev @1.3.5
    1.3.6: rewrite_goal real_mul_lid sym=false
    1.3.9: apply_backward_step real_lt_inv
    1.3.9: z3
    1.3.13: cut "abs (x * (1 + (y / abs x - 1) / 2)) < y"
    1.3.13: rewrite_goal real_abs_mul sym=false
    1.3.13: cut "!e::real. 0 < e --> abs (1 + e) = 1 + e"
    1.3.13: z3
    1.3.14: apply_fact @1.3.13,1.3.12
    1.3.15: rewrite_goal_with_prev @1.3.14
    1.3.15: rewrite_goal real_add_ldistrib sym=false
    1.3.15: rewrite_goal real_mul_rid sym=false
    1.3.15: cut "∀x. ¬(x = 0) ⟶ x * ((y / x - 1) / 2) = (y - x) / 2"
