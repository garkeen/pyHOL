  qed

theorem has_real_integral_pow_neg
  fixes a :: real, n :: nat
  prop a ≤ 0 ⟶ has_real_integral (λx. x ^ n) (-(a ^ (n + 1) / of_nat (n + 1))) (real_closed_interval a 0)
