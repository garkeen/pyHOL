theorem power_sum_derivative_shift_lemma3
  fixes a :: nat ⇒ real, n :: nat, s :: nat set, x :: real
  prop 0 < n ⟶ sum (image Pre (diff s ({0})) ∩ {0..Pre n}) (λi. of_nat (Suc i) * a (Suc i) * x ^ i) = sum (s ∩ {0..n}) (λi. of_nat i * a i * x ^ (i - 1))
