  → rewrite_fact real_mul_rid sym=false goal=108 facts=[109]
    #[110] real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) v s
qed

theorem power_series_integral2
  fixes a :: nat => real, f :: real => real, f1 :: real => real, r :: real, s :: nat set
  prop (!x. abs x < r --> has_real_derivative f (f1 x) (atreal x)) --> (!x. abs x < r --> real_sums (%i. a i * x ^ i) (f1 x) s) --> (!x. abs x < r --> real_sums (%i. a i * x ^ (i + 1) / of_nat (i + 1)) (f x - f 0) s)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀x. abs x < r ⟶ has_real_derivative f (f1 x) (atreal x)
    #[2] ∀x. abs x < r ⟶ real_sums (λi. a i * x ^ i) (f1 x) s
    #[3] ∀x. abs x < r ⟶ real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (f x - f 0) s
  → apply_forward_step power_series_integral goal=3 facts=[2]
    #[4] ∀x. abs x < r ⟶ real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) s
  ← introduction x goal=3
    #[5] _VAR x
    #[6] abs x < r
    #[7] real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (f x - f 0) s
  → apply_fact goal=7 facts=[4,6]
    #[8] real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) s
  cut "(if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) = f x - f 0" goal=7 facts=[8]
    #[9] (if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) = f x - f 0
  ← cases "x < 0" goal=9
    #[10] x < 0 ⟶ (if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) = f x - f 0
    #[11] ¬(x < 0) ⟶ (if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) = f x - f 0
  ← introduction goal=10
    #[12] x < 0
    #[13] (if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) = f x - f 0
  ← rewrite_goal if_P sym=false goal=13 facts=[12]
    #[14] -(real_integral (real_closed_interval x 0) f1) = f x - f 0
  cut "real_integral (real_closed_interval x 0) f1 = f 0 - f x" goal=14
    #[15] real_integral (real_closed_interval x 0) f1 = f 0 - f x
  ← apply_backward_step real_integral_unique goal=15
    #[16] has_real_integral f1 (f 0 - f x) (real_closed_interval x 0)
  ← apply_backward_step real_fundamental_theorem_of_calculus goal=16
    #[17] x ≤ 0
    #[18] ∀x1. x1 ∈ real_closed_interval x 0 ⟶ has_real_derivative f (f1 x1) (within (atreal x1) (real_closed_interval x 0))
  ← apply_backward_step real_lt_imp_le goal=17 facts=[12]
    #[19] x ≤ 0
  ← introduction x1 goal=18
    #[20] _VAR x1
    #[21] x1 ∈ real_closed_interval x 0
    #[22] has_real_derivative f (f1 x1) (within (atreal x1) (real_closed_interval x 0))
  ← apply_backward_step has_real_derivative_atreal_within goal=22
    #[23] has_real_derivative f (f1 x1) (atreal x1)
  ← apply_prev goal=23 facts=[1]
    #[24] abs x1 < r
  → rewrite_fact real_closed_interval_def sym=false goal=24 facts=[21]
    #[25] x1 ∈ {p. x ≤ p ∧ p ≤ 0}
  → rewrite_fact member_collect sym=false goal=24 facts=[25]
    #[26] x ≤ x1 ∧ x1 ≤ 0
  ← z3 goal=24 facts=[26,6]
    #[27] abs x1 < r
  ← rewrite_goal_with_prev goal=14 facts=[15]
    #[28] -(f 0 - f x) = f x - f 0
  ← rewrite_goal real_neg_sub sym=false goal=28
    #[29] -(f 0 - f x) = f x - f 0
  ← introduction goal=11
    #[30] ¬(x < 0)
    #[31] (if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) = f x - f 0
  ← rewrite_goal if_not_P sym=false goal=31 facts=[30]
    #[32] real_integral (real_closed_interval 0 x) f1 = f x - f 0
  ← apply_backward_step real_integral_unique goal=32
    #[33] has_real_integral f1 (f x - f 0) (real_closed_interval 0 x)
  ← apply_backward_step real_fundamental_theorem_of_calculus goal=33
    #[34] 0 ≤ x
    #[35] ∀x1. x1 ∈ real_closed_interval 0 x ⟶ has_real_derivative f (f1 x1) (within (atreal x1) (real_closed_interval 0 x))
  → rewrite_fact real_not_lt sym=false goal=34 facts=[30]
    #[36] 0 ≤ x
  ← introduction x1 goal=35
    #[37] x1 ∈ real_closed_interval 0 x
    #[38] has_real_derivative f (f1 x1) (within (atreal x1) (real_closed_interval 0 x))
  ← apply_backward_step has_real_derivative_atreal_within goal=38
    #[39] has_real_derivative f (f1 x1) (atreal x1)
  ← apply_prev goal=39 facts=[1]
    #[40] abs x1 < r
  → rewrite_fact real_closed_interval_def sym=false goal=40 facts=[37]
    #[41] x1 ∈ {p. 0 ≤ p ∧ p ≤ x}
  → rewrite_fact member_collect sym=false goal=40 facts=[41]
    #[42] 0 ≤ x1 ∧ x1 ≤ x
  ← z3 goal=40 facts=[42,6]
    #[43] abs x1 < r
  → rewrite_fact_with_prev goal=7 facts=[9,8]
qed

theorem strict_increasing_nat_le
  fixes h :: nat => nat
  prop (!n. h n < h (n + 1)) --> (!n. n <= h n)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ∀n. h n < h (n + 1)
    #[2] ∀n. n ≤ h n
  ← introduction n goal=2
    #[3] _VAR n
    #[4] n ≤ h n
  ← induction n nat_induct goal=4
    #[5] 0 ≤ h 0
    #[6] ∀n. n ≤ h n ⟶ Suc n ≤ h (Suc n)
  ← apply_backward_step le_0 goal=5
    #[7] 0 ≤ h 0
  ← rewrite_goal lesseq_Suc_less sym=false goal=6
    #[8] ∀n. n ≤ h n ⟶ n < h (Suc n)
  ← introduction n goal=8
    #[9] n ≤ h n
    #[10] n < h (Suc n)
  ← apply_backward_step let_trans param_m="h n" goal=10
    #[11] h n < h (Suc n)
  ← rewrite_goal add_1_right sym=true goal=11
    #[12] h n < h (n + 1)
  ← apply_prev goal=12 facts=[1]
    #[13] h n < h (n + 1)
qed

theorem strict_increasing_nat_lt
  fixes h :: nat => nat
  prop (!n. h n < h (n + 1)) --> (!n. !m. n < m --> h n < h m)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ∀n. h n < h (n + 1)
    #[2] ∀n. ∀m. n < m ⟶ h n < h m
  ← introduction n,m goal=2
    #[3] _VAR n
    #[4] _VAR m
    #[5] n < m
    #[6] h n < h m
  revert_intro goal=6 facts=[5]
    #[7] n < m ⟶ h n < h m
  ← induction n nat_induct goal=7
    #[8] 0 < m ⟶ h 0 < h m
    #[9] ∀n. (n < m ⟶ h n < h m) ⟶ Suc n < m ⟶ h (Suc n) < h m
  ← induction m nat_induct goal=8
    #[10] (0::nat) < 0 ⟶ h 0 < h 0
    #[11] ∀n. (0 < n ⟶ h 0 < h n) ⟶ 0 < Suc n ⟶ h 0 < h (Suc n)
  ← z3 goal=10
    #[12] (0::nat) < 0 ⟶ h 0 < h 0
  ← introduction m goal=11
    #[13] 0 < m ⟶ h 0 < h m
    #[14] 0 < Suc m
    #[15] h 0 < h (Suc m)
  ← rewrite_goal add_1_right sym=true goal=15
    #[16] h 0 < h (m + 1)
  → rewrite_fact nat_less_def_2 sym=false goal=16 facts=[14]
    #[17] 0 = m ∨ 0 < m
  ← apply_backward_step disjE goal=16 facts=[17]
    #[18] 0 = m ⟶ h 0 < h (m + 1)
    #[19] 0 < m ⟶ h 0 < h (m + 1)
  ← introduction goal=18
    #[20] 0 = m
    #[21] h 0 < h (m + 1)
  ← rewrite_goal_with_prev goal=21 facts=[20]
    #[22] h m < h (m + 1)
  ← apply_prev goal=22 facts=[1]
    #[23] h m < h (m + 1)
  ← introduction goal=19
    #[24] 0 < m
    #[25] h 0 < h (m + 1)
  ← apply_backward_step lt_trans param_m="h m" goal=25
    #[26] h 0 < h m
    #[27] h m < h (m + 1)
  ← apply_prev goal=26 facts=[13,24]
    #[28] h 0 < h m
  ← apply_prev goal=27 facts=[1]
  ← introduction n goal=9
    #[29] n < m ⟶ h n < h m
    #[30] Suc n < m
    #[31] h (Suc n) < h m
  revert_intro goal=31 facts=[30]
    #[32] Suc n < m ⟶ h (Suc n) < h m
  ← induction m nat_induct goal=32
    #[33] Suc n < 0 ⟶ h (Suc n) < h 0
    #[34] ∀n1. (Suc n < n1 ⟶ h (Suc n) < h n1) ⟶ Suc n < Suc n1 ⟶ h (Suc n) < h (Suc n1)
  ← rewrite_goal nat_less_def_1 sym=false goal=33
    #[35] false ⟶ h (Suc n) < h 0
  ← z3 goal=35
    #[36] false ⟶ h (Suc n) < h 0
  ← introduction m1 goal=34
    #[37] _VAR m1
    #[38] Suc n < m1 ⟶ h (Suc n) < h m1
    #[39] Suc n < Suc m1
    #[40] h (Suc n) < h (Suc m1)
  → rewrite_fact nat_less_def_2 sym=false goal=40 facts=[39]
    #[41] Suc n = m1 ∨ Suc n < m1
  ← apply_backward_step disjE goal=40 facts=[41]
    #[42] Suc n = m1 ⟶ h (Suc n) < h (Suc m1)
    #[43] Suc n < m1 ⟶ h (Suc n) < h (Suc m1)
  ← introduction goal=42
    #[44] Suc n = m1
    #[45] h (Suc n) < h (Suc m1)
  ← rewrite_goal_with_prev goal=45 facts=[44]
    #[46] h m1 < h (Suc m1)
  ← rewrite_goal add_1_right sym=true goal=46
    #[47] h m1 < h (m1 + 1)
  ← apply_prev goal=47 facts=[1]
    #[48] h m1 < h (m1 + 1)
  ← introduction goal=43
    #[49] Suc n < m1
    #[50] h (Suc n) < h (Suc m1)
  ← apply_backward_step lt_trans param_m="h m1" goal=50
    #[51] h (Suc n) < h m1
    #[52] h m1 < h (Suc m1)
  ← apply_prev goal=51 facts=[38,49]
    #[53] h (Suc n) < h m1
  ← rewrite_goal add_1_right sym=true goal=52
    #[54] h m1 < h (m1 + 1)
  ← apply_prev goal=54 facts=[1]
qed

theorem strict_increasing_nat_inj
  fixes h :: nat => nat
  prop (!n. h n < h (n + 1)) --> (!n. !m. h n = h m --> n = m)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ∀n. h n < h (n + 1)
    #[2] ∀n. ∀m. h n = h m ⟶ n = m
  → apply_forward_step strict_increasing_nat_lt goal=2 facts=[1]
    #[3] ∀n. ∀m. n < m ⟶ h n < h m
  ← introduction n,m goal=2
    #[4] _VAR n
    #[5] _VAR m
    #[6] h n = h m
    #[7] n = m
  cut "n = m | n < m | m < n" goal=7
    #[8] n = m ∨ n < m ∨ m < n
  ← z3 goal=8
    #[9] n = m ∨ n < m ∨ m < n
  ← apply_backward_step disjE goal=7 facts=[9]
    #[10] n = m ⟶ n = m
    #[11] n < m ∨ m < n ⟶ n = m
  ← introduction goal=11
    #[12] n < m ∨ m < n
    #[13] n = m
  ← apply_backward_step disjE goal=13 facts=[12]
    #[14] n < m ⟶ n = m
    #[15] m < n ⟶ n = m
  ← introduction goal=14
    #[16] n < m
    #[17] n = m
  → apply_fact goal=17 facts=[3,16]
    #[18] h n < h m
  ← z3 goal=17 facts=[18,6]
    #[19] n = m
  ← introduction goal=15
    #[20] m < n
    #[21] n = m
  → apply_fact goal=21 facts=[3,20]
    #[22] h m < h n
  ← z3 goal=21 facts=[22,6]
    #[23] n = m
qed

theorem strict_increasing_nat_le_eq
  fixes h :: nat => nat
  prop (!n. h n < h (n + 1)) --> (!n. !m. h n <= h m <--> n <= m)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ∀n. h n < h (n + 1)
    #[2] ∀n. ∀m. h n ≤ h m ⟷ n ≤ m
  → apply_forward_step strict_increasing_nat_lt goal=2 facts=[1]
    #[3] ∀n. ∀m. n < m ⟶ h n < h m
  ← introduction n,m goal=2
    #[4] _VAR n
    #[5] _VAR m
    #[6] h n ≤ h m ⟷ n ≤ m
  ← apply_backward_step iffI goal=6
    #[7] h n ≤ h m ⟶ n ≤ m
    #[8] n ≤ m ⟶ h n ≤ h m
  ← introduction goal=7
    #[9] h n ≤ h m
    #[10] n ≤ m
  ← rewrite_goal double_neg sym=true goal=10
    #[11] ¬¬(n ≤ m)
  ← rewrite_goal not_le sym=false goal=11
    #[12] ¬(m < n)
  ← apply_backward_step contrapositive goal=12 facts=[9]
    #[13] ¬¬(m < n) ⟶ ¬(h n ≤ h m)
  ← introduction goal=13
    #[14] ¬¬(m < n)
    #[15] ¬(h n ≤ h m)
  → rewrite_fact double_neg sym=false goal=15 facts=[14]
    #[16] m < n
  → apply_fact goal=15 facts=[3,16]
    #[17] h m < h n
  ← rewrite_goal not_le sym=false goal=15
  ← introduction goal=8
    #[18] n ≤ m
    #[19] h n ≤ h m
  → rewrite_fact le_lt sym=false goal=19 facts=[18]
    #[20] n < m ∨ n = m
  ← apply_backward_step disjE goal=19 facts=[20]
    #[21] n < m ⟶ h n ≤ h m
    #[22] n = m ⟶ h n ≤ h m
  ← introduction goal=21
    #[23] n < m
    #[24] h n ≤ h m
  → apply_fact goal=24 facts=[3,23]
    #[25] h n < h m
  ← apply_backward_step lt_imp_le goal=24 facts=[25]
    #[26] h n ≤ h m
  ← introduction goal=22
    #[27] n = m
    #[28] h n ≤ h m
  ← rewrite_goal_with_prev goal=28 facts=[27]
    #[29] h m ≤ h m
  ← apply_backward_step less_eq_refl goal=29
    #[30] h m ≤ h m
qed

theorem strict_increasing_nat_lt_eq
  fixes h :: nat => nat
  prop (!n. h n < h (n + 1)) --> (!n. !m. h n < h m <--> n < m)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ∀n. h n < h (n + 1)
    #[2] ∀n. ∀m. h n < h m ⟷ n < m
  ← introduction n,m goal=2
    #[3] _VAR n
    #[4] _VAR m
    #[5] h n < h m ⟷ n < m
  ← rewrite_goal not_le sym=true goal=5
    #[6] ¬(h m ≤ h n) ⟷ ¬(m ≤ n)
  → apply_forward_step strict_increasing_nat_le_eq goal=6 facts=[1]
    #[7] ∀n. ∀m. h n ≤ h m ⟷ n ≤ m
  ← rewrite_goal_with_prev goal=6 facts=[7]
qed

theorem strict_increasing_nat_le2
  fixes h :: nat => nat
  prop (!n. h n < h (n + 1)) --> (!n. !m. h n <= m --> n <= m)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ∀n. h n < h (n + 1)
    #[2] ∀n. ∀m. h n ≤ m ⟶ n ≤ m
  ← introduction n,m goal=2
    #[3] _VAR n
    #[4] _VAR m
    #[5] h n ≤ m
    #[6] n ≤ m
  ← apply_backward_step less_eq_trans param_m="h n" goal=6
    #[7] n ≤ h n
  → apply_forward_step strict_increasing_nat_le goal=7 facts=[1]
    #[8] ∀n. n ≤ h n
  ← apply_prev goal=7 facts=[8]
    #[9] n ≤ h n
qed

theorem real_sums_image
  fixes f :: nat ⇒ real, h :: nat ⇒ nat, l :: real, s :: nat set
  prop (∀n. h n < h (n + 1)) ⟶ real_sums f l (image h s) ⟷ real_sums (f ∘ h) l s
  [hint_backward]

theorem real_summable_image
  fixes f :: nat ⇒ real, h :: nat ⇒ nat, s :: nat set
  prop (∀n. h n < h (n + 1)) ⟶ real_summable (image h s) f ⟷ real_summable s (f ∘ h)
  [hint_backward]

theorem real_sums_image_odd
  fixes f :: nat => real, l :: real
  prop real_sums (%i. if odd i then f i else 0) l univ <--> real_sums (%i. f (2 * i + 1)) l univ
  [hint_rewrite]

theorem real_sums_image_even
  fixes f :: nat => real, l :: real
  prop real_sums (%i. if even i then f i else 0) l univ <--> real_sums (%i. f (2 * i)) l univ
  [hint_rewrite]

theorem n_le_pow_lemma
  fixes e :: real
  prop 0 < e --> (?N. !n. N <= n --> of_nat n <= (1 + e) ^ n)
  [hint_backward]

theorem real_summable_lmul_eq
  fixes c :: real, f :: nat => real, s :: nat set
  prop ~(c = 0) --> real_summable s (%i. c * f i) <--> real_summable s f
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ¬(c = 0)
    #[2] real_summable s (λi. c * f i) ⟷ real_summable s f
  ← apply_backward_step iffI goal=2
    #[3] real_summable s (λi. c * f i) ⟶ real_summable s f
    #[4] real_summable s f ⟶ real_summable s (λi. c * f i)
  ← introduction goal=3
    #[5] real_summable s (λi. c * f i)
    #[6] real_summable s f
  cut "f = (%i. real_inverse c * c * f i)" goal=6
    #[7] f = (λi. real_inverse c * c * f i)
  cut "real_inverse c * c = 1" goal=7
    #[8] real_inverse c * c = 1
  ← apply_backward_step real_mul_linv goal=8
  ← rewrite_goal_with_prev goal=7 facts=[8]
    #[9] f = (λi. 1 * f i)
  ← rewrite_goal real_mul_lid sym=false goal=9
    #[10] f = (λi. f i)
  ← rewrite_goal eta_conversion sym=false goal=10
    #[11] f = (λi. f i)
  ← rewrite_goal_with_prev goal=6 facts=[7]
    #[12] real_summable s (λi. real_inverse c * c * f i)
  ← rewrite_goal real_mult_assoc sym=true goal=12
    #[13] real_summable s (λi. real_inverse c * (c * f i))
  ← apply_backward_step real_summable_lmul goal=13
  ← introduction goal=4
    #[14] real_summable s f
    #[15] real_summable s (λi. c * f i)
  ← apply_backward_step real_summable_lmul goal=15 facts=[14]
    #[16] real_summable s (λi. c * f i)
qed

theorem summable_power_series_shift
  fixes a :: nat => real, k :: nat, s :: nat set, x :: real
  prop real_summable s (%i. a i * x ^ i) --> real_summable s (%i. a i * x ^ (i - k))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] real_summable s (λi. a i * x ^ i)
    #[2] real_summable s (λi. a i * x ^ (i - k))
  ← cases "x=0" goal=2
    #[3] x = 0 ⟶ real_summable s (λi. a i * x ^ (i - k))
    #[4] ¬(x = 0) ⟶ real_summable s (λi. a i * x ^ (i - k))
  ← introduction goal=3
    #[5] x = 0
    #[6] real_summable s (λi. a i * x ^ (i - k))
  ← rewrite_goal_with_prev goal=6 facts=[5]
    #[7] real_summable s (λi. a i * 0 ^ (i - k))
  ← apply_backward_step real_summable_comparison param_g="(%i::nat. (0::real))" goal=7
    #[8] real_summable s (λi. 0)
    #[9] ∃N. ∀i. i ≥ N ⟶ i ∈ s ⟶ abs (a i * 0 ^ (i - k)) ≤ 0
  ← apply_backward_step real_summable_0 goal=8
    #[10] real_summable s (λi. 0)
  ← inst_exists_goal k+2 goal=9
    #[11] ∀i. i ≥ k + 2 ⟶ i ∈ s ⟶ abs (a i * 0 ^ (i - k)) ≤ 0
  ← introduction i goal=11
    #[12] _VAR i
    #[13] i ≥ k + 2
    #[14] i ∈ s
    #[15] abs (a i * 0 ^ (i - k)) ≤ 0
  cut "~(i-k=0)" goal=15
    #[16] ¬(i - k = 0)
  ← z3 goal=16 facts=[13]
    #[17] ¬(i - k = 0)
  ← rewrite_goal real_pow_zero sym=false goal=15
    #[18] abs (a i * (if i - k = 0 then 1 else 0)) ≤ 0
  ← rewrite_goal if_not_P sym=false goal=18 facts=[17]
    #[19] abs (a i * 0) ≤ 0
  ← rewrite_goal real_mul_rzero sym=false goal=19
    #[20] abs (0::real) ≤ 0
  ← rewrite_goal real_abs_0 sym=false goal=20
    #[21] (0::real) ≤ 0
  ← apply_backward_step real_le_refl goal=21
    #[22] (0::real) ≤ 0
  ← introduction goal=4
    #[23] ¬(x = 0)
    #[24] real_summable s (λi. a i * x ^ (i - k))
  → apply_forward_step real_summable_lmul_eq param_c="x ^ k" param_f="(λi. a i * x ^ (i - k))" param_s=s goal=24
    #[25] ¬(x ^ k = 0) ⟶ real_summable s (λi. x ^ k * (a i * x ^ (i - k))) ⟷ real_summable s (λi. a i * x ^ (i - k))
  cut "¬(x ^ k = 0)" goal=24 facts=[25]
    #[26] ¬(x ^ k = 0)
  ← apply_backward_step real_pow_nz goal=26
  → apply_fact goal=24 facts=[25,26]
    #[27] real_summable s (λi. x ^ k * (a i * x ^ (i - k))) ⟷ real_summable s (λi. a i * x ^ (i - k))
  → rewrite_fact eq_sym_eq sym=false goal=24 facts=[27]
    #[28] real_summable s (λi. a i * x ^ (i - k)) ⟷ real_summable s (λi. x ^ k * (a i * x ^ (i - k)))
  ← rewrite_goal_with_prev goal=24 facts=[28]
    #[29] real_summable s (λi. x ^ k * (a i * x ^ (i - k)))
  → apply_forward_step real_summable_iff_eventually param_f="(λi. a i * x ^ i)" param_g="(λi. x ^ k * (a i * x ^ (i - k)))" param_s=s goal=29
    #[30] (∃N. ∀n. N ≤ n ∧ n ∈ s ⟶ a n * x ^ n = x ^ k * (a n * x ^ (n - k))) ⟶ real_summable s (λi. a i * x ^ i) ⟷ real_summable s (λi. x ^ k * (a i * x ^ (i - k)))
  cut "(∃N. ∀n. N ≤ n ∧ n ∈ s ⟶ a n * x ^ n = x ^ k * (a n * x ^ (n - k)))" goal=29 facts=[30]
    #[31] ∃N. ∀n. N ≤ n ∧ n ∈ s ⟶ a n * x ^ n = x ^ k * (a n * x ^ (n - k))
  ← inst_exists_goal k goal=31
    #[32] ∀n. k ≤ n ∧ n ∈ s ⟶ a n * x ^ n = x ^ k * (a n * x ^ (n - k))
  ← introduction n goal=32
    #[33] _VAR n
    #[34] k ≤ n ∧ n ∈ s
    #[35] a n * x ^ n = x ^ k * (a n * x ^ (n - k))
  → apply_forward_step conjD1 goal=35 facts=[34]
    #[36] k ≤ n
  cut "a n * x ^ n = a n * x ^ (k + (n-k))" goal=35
    #[37] a n * x ^ n = a n * x ^ (k + (n - k))
  cut "(k + (n - k)) = n" goal=37
    #[38] k + (n - k) = n
  ← z3 goal=38 facts=[36]
    #[39] k + (n - k) = n
  ← rewrite_goal_with_prev goal=37 facts=[39]
    #[40] a n * x ^ n = a n * x ^ (k + (n - k))
  ← rewrite_goal_with_prev goal=35 facts=[40]
    #[41] a n * x ^ (k + (n - k)) = x ^ k * (a n * x ^ (n - k))
  ← rewrite_goal real_pow_add sym=false goal=41
    #[42] a n * (x ^ k * x ^ (n - k)) = x ^ k * (a n * x ^ (n - k))
  real_norm goal=42
    #[43] a n * (x ^ k * x ^ (n - k)) = x ^ k * (a n * x ^ (n - k))
  → apply_fact goal=29 facts=[30,31]
    #[44] real_summable s (λi. a i * x ^ i) ⟷ real_summable s (λi. x ^ k * (a i * x ^ (i - k)))
  → rewrite_fact_with_prev goal=29 facts=[44,1]
qed

theorem power_sum_derivative_shift_lemma
  fixes a :: nat => real, n :: nat, s :: nat set
  prop sum (diff s ({0}) Int {0..n}) (%i. of_nat i * a i) = sum (s Int {0..n}) (%i. of_nat i * a i)
  [hint_rewrite]

theorem power_sum_derivative_shift_lemma2
  fixes a :: nat => real, n :: nat, s :: nat set
  prop 0 < n --> sum (image Pre (diff s ({0})) Int {0..Pre n}) (%i. of_nat (Suc i) * a (Suc i)) = sum (s Int {0..n}) (%i. of_nat i * a i)
  [hint_backward]

theorem power_sum_derivative_shift_lemma3
  fixes a :: nat => real, n :: nat, s :: nat set, x :: real
  prop 0 < n --> sum (image Pre (diff s ({0})) Int {0..Pre n}) (%i. of_nat (Suc i) * a (Suc i) * x ^ i) = sum (s Int {0..n}) (%i. of_nat i * a i * x ^ (i - 1))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 < n
    #[2] sum (image Pre (diff s ({0})) ∩ {0..Pre n}) (λi. of_nat (Suc i) * a (Suc i) * x ^ i) = sum (s ∩ {0..n}) (λi. of_nat i * a i * x ^ (i - 1))
  → apply_forward_step power_sum_derivative_shift_lemma2 param_a="(λi. a i * x ^ (i-1))" param_s=s goal=2 facts=[1]
    #[3] sum (image Pre (diff s ({0})) ∩ {0..Pre n}) (λi. of_nat (Suc i) * (a (Suc i) * x ^ (Suc i - 1))) = sum (s ∩ {0..n}) (λi. of_nat i * (a i * x ^ (i - 1)))
  cut "!i. (Suc i - 1) = i" goal=2
    #[4] ∀i. Suc i - 1 = i
  ← rewrite_goal suc_sub1 sym=false goal=4
    #[5] ∀i::nat. i = i
  ← z3 goal=5
    #[6] ∀i::nat. i = i
  → rewrite_fact_with_prev goal=2 facts=[4,3]
    #[7] sum (image Pre (diff s ({0})) ∩ {0..Pre n}) (λi. of_nat (Suc i) * (a (Suc i) * x ^ i)) = sum (s ∩ {0..n}) (λi. of_nat i * (a i * x ^ (i - 1)))
  → rewrite_fact real_mult_assoc sym=false goal=2 facts=[7]
qed

theorem power_series_derivative_shift_lemma
  fixes a :: nat => real, l :: real, s :: nat set
  prop real_sums (%i. of_nat i * a i) l s <--> real_sums (%i. of_nat i * a i) l (diff s ({0}))
  [hint_rewrite,hint_backward]
proof
  ← rewrite_goal real_sums_def sym=false goal=0
    #[1] tendsto_real (λn. sum (s ∩ {0..n}) (λi. of_nat i * a i)) l sequentially ⟷ tendsto_real (λn. sum (diff s ({0}) ∩ {0..n}) (λi. of_nat i * a i)) l sequentially
  ← rewrite_goal power_sum_derivative_shift_lemma sym=false goal=1
qed

theorem power_series_derivative_shift
  fixes a :: nat => real, l :: real, s :: nat set, x :: real
  prop real_sums (%i. of_nat i * a i * x ^ (i - 1)) l s <--> real_sums (%i. of_nat (Suc i) * a (Suc i) * x ^ i) l (image Pre (diff s ({0})))
  [hint_rewrite]

theorem summable_power_series_derivative
  fixes a :: nat => real, s :: nat set, y :: real
  prop real_summable s (%i. a i * y ^ i) --> (!x. abs x < y --> real_summable s (%i. of_nat i * a i * x ^ (i - 1)))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] real_summable s (λi. a i * y ^ i)
    #[2] ∀x. abs x < y ⟶ real_summable s (λi. of_nat i * a i * x ^ (i - 1))
  ← introduction x goal=2
    #[3] _VAR x
    #[4] abs x < y
    #[5] real_summable s (λi. of_nat i * a i * x ^ (i - 1))
  ← apply_backward_step summable_power_series_shift goal=5
    #[6] real_summable s (λi. of_nat i * a i * x ^ i)
  ← cases "x=0" goal=6
    #[7] x = 0 ⟶ real_summable s (λi. of_nat i * a i * x ^ i)
    #[8] ¬(x = 0) ⟶ real_summable s (λi. of_nat i * a i * x ^ i)
  ← introduction goal=7
    #[9] x = 0
    #[10] real_summable s (λi. of_nat i * a i * x ^ i)
  ← rewrite_goal_with_prev goal=10 facts=[9]
    #[11] real_summable s (λi. of_nat i * a i * 0 ^ i)
  ← apply_backward_step real_summable_comparison param_g="(%n::nat. (0::real))" goal=11
    #[12] real_summable s (λn. 0)
    #[13] ∃N. ∀i. i ≥ N ⟶ i ∈ s ⟶ abs (of_nat i * a i * 0 ^ i) ≤ 0
  ← apply_backward_step real_summable_0 goal=12
    #[14] real_summable s (λn. 0)
  ← inst_exists_goal "(2::nat)" goal=13
    #[15] ∀i. i ≥ 2 ⟶ i ∈ s ⟶ abs (of_nat i * a i * 0 ^ i) ≤ 0
  ← introduction i goal=15
    #[16] _VAR i
    #[17] i ≥ 2
    #[18] i ∈ s
    #[19] abs (of_nat i * a i * 0 ^ i) ≤ 0
  cut "~(i = 0)" goal=19 facts=[17]
    #[20] ¬(i = 0)
  ← z3 goal=20 facts=[17]
    #[21] ¬(i = 0)
  ← rewrite_goal real_pow_zero sym=false goal=19
    #[22] abs (of_nat i * a i * (if i = 0 then 1 else 0)) ≤ 0
  ← rewrite_goal if_not_P sym=false goal=22 facts=[21]
    #[23] abs (of_nat i * a i * 0) ≤ 0
  ← rewrite_goal real_mul_rzero sym=false goal=23
    #[24] abs (0::real) ≤ 0
  ← rewrite_goal real_abs_0 sym=false goal=24
    #[25] (0::real) ≤ 0
  ← apply_backward_step real_le_refl goal=25
    #[26] (0::real) ≤ 0
  ← introduction goal=8
    #[27] ¬(x = 0)
    #[28] real_summable s (λi. of_nat i * a i * x ^ i)
  cut "~(y=0)" goal=28
    #[29] ¬(y = 0)
  ← z3 goal=29 facts=[4]
    #[30] ¬(y = 0)
  cut "0 < y" goal=28
    #[31] 0 < y
  ← z3 goal=31 facts=[4]
    #[32] 0 < y
  cut "0 < abs x" goal=28
    #[33] 0 < abs x
  ← apply_backward_step real_abs_nz goal=33 facts=[27]
    #[34] 0 < abs x
  cut "~(abs x = 0)" goal=28
    #[35] ¬(abs x = 0)
  ← z3 goal=35 facts=[27]
    #[36] ¬(abs x = 0)
  cut "0 < (y / (abs x) - 1) / 2" goal=28
    #[37] 0 < (y / abs x - 1) / 2
  ← rewrite_goal real_divide_def sym=false goal=37
    #[38] 0 < (y / abs x - 1) * real_inverse 2
  ← apply_backward_step real_lt_mul goal=38
    #[39] 0 < y / abs x - 1
    #[40] 0 < real_inverse 2
  ← rewrite_goal real_sub_lt sym=false goal=39
    #[41] 1 < y / abs x
  → apply_forward_step real_lt_rdiv_eq param_x="(1::real)" param_y=y goal=41 facts=[34]
    #[42] 1 < y / abs x ⟷ 1 * abs x < y
  ← rewrite_goal_with_prev goal=41 facts=[42]
    #[43] 1 * abs x < y
  ← rewrite_goal real_mul_lid sym=false goal=43
  ← apply_backward_step real_lt_inv goal=40
    #[44] (0::real) < 2
  ← z3 goal=44
    #[45] (0::real) < 2
  cut "abs (x * (1 + (y / abs x - 1) / 2)) < y" goal=28
