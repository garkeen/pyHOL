    #[9] (0::real) = 0 ∨ of_nat (n + 1) = (0::real)
  ← apply_backward_step disjI1 goal=9
    #[10] (0::real) = 0
  ← apply_backward_step eq_refl goal=10
    #[11] (0::real) = 0
  → rewrite_fact_with_prev goal=2 facts=[8,7]
    #[12] (∀x. x ∈ real_closed_interval 0 a ⟶ has_real_derivative (λx1. x1 ^ (n + 1) / of_nat (n + 1)) (x ^ n) (within (atreal x) (real_closed_interval 0 a))) ⟶ has_real_integral (λx. x ^ n) (a ^ (n + 1) / of_nat (n + 1) - 0) (real_closed_interval 0 a)
  → rewrite_fact real_sub_rzero sym=false goal=2 facts=[12]
    #[13] (∀x. x ∈ real_closed_interval 0 a ⟶ has_real_derivative (λx1. x1 ^ (n + 1) / of_nat (n + 1)) (x ^ n) (within (atreal x) (real_closed_interval 0 a))) ⟶ has_real_integral (λx. x ^ n) (a ^ (n + 1) / of_nat (n + 1)) (real_closed_interval 0 a)
  ← apply_prev goal=2 facts=[13]
    #[14] ∀x. x ∈ real_closed_interval 0 a ⟶ has_real_derivative (λx1. x1 ^ (n + 1) / of_nat (n + 1)) (x ^ n) (within (atreal x) (real_closed_interval 0 a))
  ← introduction x goal=14
    #[15] _VAR x
    #[16] x ∈ real_closed_interval 0 a
    #[17] has_real_derivative (λx1. x1 ^ (n + 1) / of_nat (n + 1)) (x ^ n) (within (atreal x) (real_closed_interval 0 a))
  ← apply_backward_step has_real_derivative_atreal_within goal=17
    #[18] has_real_derivative (λx1. x1 ^ (n + 1) / of_nat (n + 1)) (x ^ n) (atreal x)
  cut "x ^ n = of_nat (n + 1) * x ^ n / of_nat (n + 1) " goal=18
