theorem summable_power_series_shift
  fixes a :: nat ⇒ real, k :: nat, s :: nat set, x :: real
  prop real_summable s (λi. a i * x ^ i) ⟶ real_summable s (λi. a i * x ^ (i - k))
  [hint_backward]
  proof
    1: cases "x=0"
    1: introduction
    1.1: rewrite_goal_with_prev @1.0
    1.1: apply_backward_step real_summable_comparison param_g="(%i::nat. (0::real))"
    1.1: apply_backward_step real_summable_0
    1.2: inst_exists_goal k+2
    1.2: introduction i
    1.2.3: cut "~(i-k=0)"
    1.2.3: z3 @1.2.1
    1.2.4: rewrite_goal real_pow_zero sym=false
    1.2.4: rewrite_goal if_not_P @1.2.3 sym=false
    1.2.4: rewrite_goal real_mul_rzero sym=false
    1.2.4: rewrite_goal real_abs_0 sym=false
    1.2.4: apply_backward_step real_le_refl
    2: introduction
    2.1: apply_forward_step real_summable_lmul_eq param_c="x ^ k" param_f="(λi. a i * x ^ (i - k))" param_s=s
    2.2: cut "¬(x ^ k = 0)" @2.1
    2.2: apply_backward_step real_pow_nz
    2.3: apply_fact @2.1,2.2
    2.4: rewrite_fact eq_sym_eq @2.3 sym=false
    2.5: rewrite_goal_with_prev @2.4
    2.5: apply_forward_step real_summable_iff_eventually param_f="(λi. a i * x ^ i)" param_g="(λi. x ^ k * (a i * x ^ (i - k)))" param_s=s
    2.6: cut "(∃N. ∀n. N ≤ n ∧ n ∈ s ⟶ a n * x ^ n = x ^ k * (a n * x ^ (n - k)))" @2.5
    2.6: inst_exists_goal k
    2.6: introduction n
    2.6.2: apply_forward_step conjD1 @2.6.1
    2.6.3: cut "a n * x ^ n = a n * x ^ (k + (n-k))"
    2.6.3: cut "(k + (n - k)) = n"
    2.6.3: z3 @2.6.2
    2.6.4: rewrite_goal_with_prev @2.6.3
    2.6.5: rewrite_goal_with_prev @2.6.4
    2.6.5: rewrite_goal real_pow_add sym=false
    2.6.5: real_norm
    2.8: apply_fact @2.5,2.7
    2.9: rewrite_fact_with_prev @2.8,0
  qed

