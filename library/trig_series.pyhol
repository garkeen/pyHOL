theory trig_series
imports realgamma
description "Formal inequalities for trig about series."

theorem abs_neg_pow
  fixes n :: nat, x :: real
  prop abs (-x ^ n) = abs x ^ n
  [hint_rewrite]
  proof
    0: rewrite_goal real_abs_pow sym=false
    0: rewrite_goal real_abs_neg sym=false
  qed

theorem abs_neg_one_pow
  fixes n :: nat
  prop abs (-(1::real) ^ n) = 1
  [hint_rewrite]
  proof
    0: rewrite_goal abs_neg_pow sym=false
    0: rewrite_goal real_abs_pow sym=true
    0: rewrite_goal real_pow_one sym=false
    0: z3
  qed

theorem real_infsum_offset
  fixes f :: nat ⇒ real, k :: nat, m :: nat
  prop real_summable (from m) f ⟶ m ≤ k ⟶ real_infsum (from m) f = sum ({m..k}) f + real_infsum (from (k + 1)) f
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step real_summable_from_elsewhere @0 param_n=k+1
    3: rewrite_fact real_summable_def @0 sym=false
    4: exists_elim l @3
    6: apply_backward_step real_infsum_unique
    6: apply_forward_step real_sums_offset @5 param_n=k+1
    7: rewrite_fact nat_plus_minus @6 sym=false
    8: cut "m < k + 1"
    8: z3 @1
    9: apply_fact @7,8
    10: apply_forward_step real_infsum_unique @9
    11: rewrite_goal_with_prev @10
    11: cut "sum ({m..k}) f + (l - sum ({m..k}) f) = l"
    11: real_norm
    12: rewrite_goal_with_prev @11
  qed

theorem real_infsum_offset_alt
  fixes f :: nat ⇒ real, k :: nat, m :: nat
  prop real_summable (from m) f ⟶ m < k ⟶ real_infsum (from m) f = sum ({m..k - 1}) f + real_infsum (from k) f
  [hint_backward,hint_backward1]
  proof
    2: cut "m <= k - 1"
    2: z3 @1
    3: apply_forward_step real_infsum_offset @0,2
    4: cut "k-1+1=k"
    4: apply_backward_step sub_add
    4: z3 @1
    6: rewrite_fact_with_prev @5,3
  qed

theorem power_series_simple_bound
  fixes a :: nat ⇒ real, m :: nat, u :: real, x :: real
  prop real_summable (from m) (λi. a i * x ^ i) ⟶ (∀i. m ≤ i ⟶ abs (a i) ≤ u) ⟶ abs x < 1 ⟶ abs (real_infsum (from m) (λi. a i * x ^ i)) ≤ u * abs x ^ m / (1 - abs x)
  [hint_backward,hint_backward1]
  proof
    3: apply_backward_step real_series_bound param_f="(λi. a i * x ^ i)" param_g="(λi::nat. u * abs x ^ i)" param_s="from m"
    3: rewrite_goal real_sums_infsum sym=false
    4: rewrite_goal real_divide_def sym=false
    4: rewrite_goal real_mult_assoc sym=true
    4: apply_backward_step real_series_lmul
    4: rewrite_goal real_divide_def sym=true
    4: apply_backward_step real_sums_gp
    4: rewrite_goal real_abs_abs sym=false
    10: rewrite_goal in_from sym=false
    10: introduction i
    10.2: rewrite_goal real_abs_mul sym=false
    10.2: rewrite_goal real_abs_pow sym=false
    10.2: rewrite_goal real_mult_comm sym=false
    10.2: apply_backward_step real_le_lmul
    10.2: apply_backward_step real_pow_le
    10.2: apply_backward_step real_abs_pos
    10.4: apply_prev @1
  qed

theorem power_series_simple_bound2
  fixes a :: nat ⇒ real, m :: nat, x :: real
  prop real_summable (from m) (λi. a i * x ^ i) ⟶ (∀i. m ≤ i ⟶ abs (a (Suc i)) ≤ abs (a i)) ⟶ abs x < 1 ⟶ abs (real_infsum (from m) (λi. a i * x ^ i)) ≤ abs (a m) * abs x ^ m / (1 - abs x)
  [hint_backward,hint_backward1]
  proof
    3: apply_backward_step power_series_simple_bound
    3: introduction i
    3.2: revert_intro @3.1
    3.1: induction i nat_induct
    3.1: introduction
    3.1.1: apply_forward_step nat_le_zero @3.1.0
    3.1.2: rewrite_goal_with_prev @3.1.1
    3.1.2: apply_backward_step real_le_refl
    3.2: introduction n
    3.2.3: rewrite_fact nat_less_eq_def_2 @3.2.2 sym=false
    3.2.4: apply_backward_step disjE @3.2.3
    3.2.4: introduction
    3.2.4.1: rewrite_goal_with_prev @3.2.4.0
    3.2.4.1: apply_backward_step real_le_refl
    3.2.5: introduction
    3.2.5.1: apply_backward_step real_le_trans param_y="abs (a n)"
    3.2.5.1: apply_prev @1
    3.2.5.2: apply_prev @3.2.1
  qed

theorem real_sums_simple_bound
  fixes a :: nat ⇒ real, m :: nat, n :: nat, t :: real, u :: real, x :: real
  prop real_sums (λi. a i * x ^ i) t (from n) ⟶ n < m ⟶ (∀i. m ≤ i ⟶ abs (a i) ≤ u) ⟶ abs x < 1 ⟶ abs (t - sum ({n..m - 1}) (λi. a i * x ^ i)) ≤ u * abs x ^ m / (1 - abs x)
  [hint_backward,hint_backward1]
  proof
    4: apply_forward_step real_sums_summable @0
    5: apply_forward_step real_infsum_unique @0
    6: apply_forward_step real_infsum_offset_alt @4,1
    7: rewrite_fact_with_prev @5,6
    8: cut "!a::real. !b. !c. a = b + c --> a - b = c"
    8: z3
    9: apply_fact @8,7
    10: rewrite_goal_with_prev @9
    10: apply_backward_step power_series_simple_bound
    10: apply_forward_step real_summable_from_elsewhere @4 param_n=m
  qed

theorem real_sums_simple_bound2
  fixes a :: nat ⇒ real, m :: nat, n :: nat, t :: real, u :: real, x :: real
  prop real_sums (λi. a i * x ^ i) t (from n) ⟶ n < m ⟶ (∀i. m ≤ i ⟶ abs (a (Suc i)) ≤ abs (a i)) ⟶ abs x < 1 ⟶ abs (t - sum ({n..m - 1}) (λi. a i * x ^ i)) ≤ abs (a m) * abs x ^ m / (1 - abs x)
  [hint_backward,hint_backward1]
  proof
    4: apply_forward_step real_sums_summable @0
    5: apply_forward_step real_infsum_unique @0
    6: apply_forward_step real_infsum_offset_alt @4,1
    7: rewrite_fact_with_prev @5,6
    8: cut "∀a::real. ∀b. ∀c. a = b + c ⟶ a - b = c"
    8: z3
    9: apply_fact @8,7
    10: rewrite_goal_with_prev @9
    10: apply_backward_step power_series_simple_bound2
    10: apply_forward_step real_summable_from_elsewhere @4 param_n=m
  qed

theorem abs_sum_lemma_pos
  fixes a :: real, b :: real
  prop 0 ≤ a * b ⟶ abs (a + b) = abs a + abs b
  [hint_backward]
  proof
    1: z3 @0
  qed

theorem abs_sum_lemma_neg
  fixes a :: real, b :: real
  prop a * b ≤ 0 ⟶ abs (a + b) = abs (abs a - abs b)
  [hint_backward]
  proof
    1: z3 @0
  qed

theorem sign_mul_lemma
  fixes a :: real, b :: real, c :: real
  prop a * b ≤ 0 ⟶ 0 ≤ b * c ⟶ ¬(b = 0) ⟶ a * c ≤ 0
  [hint_backward,hint_backward1]
  proof
    3: z3 @0,1,2
  qed

theorem sum_bound_lemma
  fixes f :: nat ⇒ real, m :: nat, n :: nat
  prop (∀k. abs (f (k + 1)) ≤ abs (f k) ∧ f (k + 1) * f k ≤ 0) ⟶ abs (sum ({m..n}) f) ≤ abs (f m) ∧ 0 ≤ sum ({m..n}) f * f m
  [hint_backward]
  proof
    1: induction n nat_induct
    1: rewrite_goal sum_0_natseg sym=false
    1: cases "m=0"
    1: introduction
    1.1: rewrite_goal if_P @1.0 sym=false
    1.1: rewrite_goal_with_prev @1.0
    1.1: apply_backward_step conjI
    1.1: apply_backward_step real_le_refl
    1.2: apply_backward_step real_le_square
    2: introduction
    2.1: rewrite_goal if_not_P @2.0 sym=false
    2.1: apply_backward_step conjI
    2.1: rewrite_goal real_abs_0 sym=false
    2.1: apply_backward_step real_abs_pos
    2.3: rewrite_goal real_mul_lzero sym=false
    2.3: apply_backward_step real_le_refl
    5: introduction n
    5.2: apply_forward_step conjD1 @5.1
    5.3: apply_forward_step conjD2 @5.1
    5.4: rewrite_goal sum_Suc_natseg sym=false
    5.4: cases "m ≤ Suc n"
    5.4: introduction
    5.4.1: rewrite_goal if_P @5.4.0 sym=false
    5.4.1: apply_backward_step conjI
  qed

theorem alt_sign_converges
  fixes f :: nat ⇒ real, k :: nat
  prop (∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0) ⟶ tendsto_real f 0 sequentially ⟶ (∃l. real_sums f l (from k))
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal real_series_cauchy sym=""
    2: rewrite_fact reallim_sequentially @1 sym=false
    3: rewrite_fact real_sub_rzero @2 sym=false
    4: introduction e
    4.2: rewrite_goal from_inter_natseg_gen sym=false
    4.2: apply_fact @3,4.1
    4.3: exists_elim N @4.2
    4.5: inst_exists_goal N
    4.5: introduction m,n
    4.5.3: apply_forward_step sum_bound_lemma @0 param_m="" param_n=""
    4.5.4: cases "m < k"
    4.5.4: introduction
    4.5.4.1: rewrite_goal if_P @4.5.4.0 sym=false
    4.5.4.1: forall_elim k @4.5.3
    4.5.4.2: forall_elim n @4.5.4.1
    4.5.4.3: apply_backward_step real_let_trans param_y="abs (f k)"
    4.5.4.3: apply_backward_step conjD1 @4.5.4.2
    4.5.4.4: apply_prev @4.4
    4.5.4.4: z3 @4.5.2,4.5.4.0
    4.5.5: introduction
    4.5.5.1: rewrite_goal if_not_P @4.5.5.0 sym=false
    4.5.5.1: forall_elim m @4.5.3
    4.5.5.2: forall_elim n @4.5.5.1
    4.5.5.3: apply_backward_step real_let_trans param_y="abs (f m)"
    4.5.5.3: apply_backward_step conjD1 @4.5.5.2
    4.5.5.4: apply_prev @4.4
    4.5.5.4: rewrite_fact greater_eq_def @4.5.2 sym=false
  qed

theorem alt_sign_summable
  fixes f :: nat ⇒ real, k :: nat
  prop (∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0) ⟶ tendsto_real f 0 sequentially ⟶ real_summable (from k) f
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal real_summable_def sym=false
    2: apply_backward_step alt_sign_converges
  qed

theorem alt_sign_converges2
  fixes f :: nat ⇒ real, k :: nat
  prop (∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0) ⟶ tendsto_real f 0 sequentially ⟶ (∃l. real_sums f l (from k) ∧ abs l ≤ abs (f k) ∧ 0 ≤ l * f k)
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step alt_sign_converges @0,1 param_k=k
    3: exists_elim l @2
    5: inst_exists_goal l
    5: apply_backward_step conjI
    5: rewrite_fact real_sums_def @4 sym=false
    6: rewrite_fact from_inter_natseg @5 sym=false
    7: apply_forward_step reallim_ubound @6 param_b=""
    8: apply_forward_step reallim_lbound @6 param_b=""
    9: apply_forward_step reallim_rmul @6 param_c="f k"
    10: apply_forward_step reallim_lbound @9 param_b="(0::real)"
    11: cut "¬(trivial_limit sequentially)" @10
    11: apply_backward_step trivial_limit_sequentially
    12: apply_fact @7,11
    13: apply_fact @8,11
    14: apply_fact @10,11
    15: forall_elim "abs (f k)" @12
    16: forall_elim "-abs (f k)" @13
    17: apply_forward_step sum_bound_lemma @0 param_m=k param_n=""
    18: apply_backward_step conjI
    18: rewrite_goal real_abs_bounds sym=false
    18: apply_backward_step conjI
    18: apply_prev @16
    18: rewrite_goal eventually_sequentially sym=false
    18: inst_exists_goal "(0::nat)"
    18: introduction n
    18.2: forall_elim n @17
    18.3: apply_forward_step conjD1 @18.2
    18.4: rewrite_fact real_abs_bounds @18.3 sym=false
    18.5: apply_backward_step conjD1 @18.4
    22: apply_prev @12
    22: rewrite_goal eventually_sequentially sym=false
    22: inst_exists_goal "(0::nat)"
    22: introduction n
    22.2: forall_elim n @17
    22.3: apply_forward_step conjD1 @22.2
    22.4: rewrite_fact real_abs_bounds @22.3 sym=false
    22.5: apply_backward_step conjD2 @22.4
    28: apply_prev @14
    28: rewrite_goal eventually_sequentially sym=false
    28: inst_exists_goal "(0::nat)"
    28: introduction n
    28.2: forall_elim n @17
    28.3: apply_backward_step conjD2 @28.2
  qed

theorem alt_sign_bound
  fixes f :: nat ⇒ real, k :: nat
  prop (∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0) ⟶ tendsto_real f 0 sequentially ⟶ abs (real_infsum (from k) f) ≤ abs (f k)
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step alt_sign_converges2 @0,1 param_k=k
    3: exists_elim l @2
    5: apply_forward_step conjD1 @4
    6: apply_forward_step real_infsum_unique @5
    7: rewrite_goal_with_prev @6
    7: apply_forward_step conjD2 @4
    8: apply_backward_step conjD1 @7
  qed

theorem alt_sign_abs_bound
  fixes f :: nat ⇒ real, k :: nat, m :: nat
  prop (∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0) ⟶ tendsto_real f 0 sequentially ⟶ m < k ⟶ abs (real_infsum (from m) f - sum ({m..k - 1}) f) ≤ abs (f k)
  [hint_backward,hint_backward1]
  proof
    3: apply_forward_step alt_sign_summable @0,1 param_k=m
    4: apply_forward_step real_infsum_offset_alt @3,2
    5: apply_forward_step alt_sign_bound @0,1 param_k=k
    6: cut "real_infsum (from m) f - sum ({m..k - 1}) f = real_infsum (from k) f"
    6: rewrite_goal_with_prev @4
    6: real_norm
    8: rewrite_goal_with_prev @7
  qed

theorem alt_sign_upper_bound
  fixes f :: nat ⇒ real, k :: nat, m :: nat
  prop (∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0) ⟶ tendsto_real f 0 sequentially ⟶ m < k ⟶ real_infsum (from m) f ≤ sum ({m..k - 1}) f + abs (f k)
  [hint_backward,hint_backward1]
  proof
    3: apply_forward_step alt_sign_abs_bound @0,1,2
    4: cut "!a::real. !b. !c. abs (a -b) <= c --> a <= b + c"
    4: z3
    5: apply_prev @4
  qed

theorem alt_sign_lower_bound
  fixes f :: nat ⇒ real, k :: nat, m :: nat
  prop (∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0) ⟶ tendsto_real f 0 sequentially ⟶ m < k ⟶ sum ({m..k - 1}) f - abs (f k) ≤ real_infsum (from m) f
  [hint_backward,hint_backward1]
  proof
    3: apply_forward_step alt_sign_abs_bound @0,1,2
    4: cut "∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ b -c ≤ a"
    4: z3
    5: apply_prev @4
  qed

theorem integral_uniform_limit
  fixes a :: real, b :: real, f :: nat ⇒ real ⇒ real, g :: real ⇒ real, s :: nat ⇒ real
  prop (∀e. 0 < e ⟶ (∃N. ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (f n x - g x) < e)) ⟶ (∀n. has_real_integral (f n) (s n) (real_closed_interval a b)) ⟶ (∃r. has_real_integral g r (real_closed_interval a b) ∧ tendsto_real s r sequentially)
  [hint_rewrite,hint_backward,hint_backward1]
  proof
    2: apply_forward_step real_integrable_uniform_limit param_a=a param_b=b param_f=g
    3: cut "(∀e. 0 < e ⟶ (∃g1. (∀x. x ∈ real_closed_interval a b ⟶ abs (g x - g1 x) ≤ e) ∧ real_integrable_on g1 (real_closed_interval a b)))"
    3: introduction e
    3.2: apply_fact @0,3.1
    3.3: exists_elim N @3.2
    3.5: inst_exists_goal "f N"
    3.5: apply_backward_step conjI
    3.5: introduction x
    3.5.2: apply_backward_step real_lt_imp_le
    3.5.2: cut "!a::real. !b. abs (a - b) = abs (b - a)"
    3.5.2: z3
    3.5.3: rewrite_goal_with_prev @3.5.2
    3.5.3: apply_prev @3.4
    3.5.3: apply_backward_step less_eq_refl
    3.6: rewrite_goal real_integrable_on_def sym=false
    3.6: inst_exists_goal "s N"
    3.6: apply_prev @1
    4: apply_fact @2,3
    5: rewrite_fact real_integrable_on_def @4 sym=false
    6: exists_elim r @5
    8: inst_exists_goal r
    8: apply_backward_step conjI
    8: rewrite_goal reallim_sequentially sym=false
    8: introduction e
    8.2: cases "b <= a"
    8.2: introduction
    8.2.1: inst_exists_goal "(0::nat)"
    8.2.1: introduction n
    8.2.1.2: forall_elim n @1
    8.2.1.3: apply_forward_step has_real_integral_null_eq @8.2.0 param_f="" param_i=""
    8.2.1.4: rewrite_fact_with_prev @8.2.1.3,8.2.1.2
    8.2.1.5: rewrite_fact_with_prev @8.2.1.3,7
    8.2.1.6: z3 @8.2.1.4,8.2.1.5,8.1
    8.3: introduction
    8.3.1: forall_elim "(e/2)/(b-a)" @0
    8.3.2: cut "0 < e / 2 / (b - a)" @8.3.1
    8.3.2: z3 @8.3.0,8.1
    8.3.3: apply_fact @8.3.1,8.3.2
    8.3.4: exists_elim N @8.3.3
    8.3.6: inst_exists_goal N
    8.3.6: introduction n
    8.3.6.2: apply_fact @8.3.5,8.3.6.1
    8.3.6.3: apply_backward_step real_let_trans param_y=e/2
    8.3.6.3: cut "e / 2 = ((e / 2) / (b - a)) * (b - a)"
    8.3.6.3: z3 @8.3.0
    8.3.6.4: rewrite_goal_with_prev @8.3.6.3
    8.3.6.4: apply_backward_step has_real_integral_bound param_f="(%x. f n x - (g x))"
    8.3.6.4: z3 @8.1,8.3.0
    8.3.6.5: z3 @8.3.0
    8.3.6.6: apply_backward_step has_real_integral_sub
    8.3.6.6: apply_prev @1
    8.3.6.8: introduction x
    8.3.6.8.2: apply_fact @8.3.6.2,8.3.6.8.1
    8.3.6.8.3: apply_backward_step real_lt_imp_le
    8.3.6.11: z3 @8.1
  qed

theorem integral_series
  fixes a :: real, b :: real, f :: nat ⇒ real ⇒ real, g :: real ⇒ real, r :: nat ⇒ real, s :: nat set
  prop (∀e. 0 < e ⟶ (∃N. ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (sum (s ∩ {0..n}) (λi. f i x) - g x) < e)) ⟶ (∀n. has_real_integral (f n) (r n) (real_closed_interval a b)) ⟶ (∃v. has_real_integral g v (real_closed_interval a b) ∧ real_sums r v s)
  proof
    2: rewrite_goal real_sums_def sym=false
    2: apply_backward_step integral_uniform_limit param_f="(%n. %x. sum (s ∩ {0..n}) (%i. f i x))"
    2: introduction n
    2.1: apply_backward_step has_real_integral_sum
    2.1: apply_backward_step finite_inter_natseg
    2.2: introduction a1
    2.2.2: apply_prev @1
  qed

theorem power_series_uniform
  fixes a :: nat ⇒ real, s :: nat set, t :: real, y :: real
  prop real_summable s (λi. a i * y ^ i) ⟶ abs t < abs y ⟶ (∀e. 0 < e ⟶ (∃N. ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval (-(abs t)) (abs t) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x ^ i) - real_infsum s (λi. a i * x ^ i)) < e))
  [hint_backward,hint_backward1]
  proof
    2: cut "0 < (abs y + abs t) / (abs y - abs t) & (abs y + abs t) / (abs y - abs t) * (abs y - abs t) = abs y + abs t"
    2: apply_backward_step conjI
    2: z3 @1
    3: z3 @1
  qed

theorem has_real_integral_pow_pos
  fixes a :: real, n :: nat
  prop 0 ≤ a ⟶ has_real_integral (λx. x ^ n) (a ^ (n + 1) / of_nat (n + 1)) (real_closed_interval 0 a)
  [hint_backward]
  proof
    1: apply_forward_step real_fundamental_theorem_of_calculus @0 param_f="(λx::real. x ^ (n + 1) / of_nat (n + 1))" param_f1="(λx::real. x ^ n)"
    2: rewrite_fact real_pow_zero @1 sym=false
    3: cut "~n + 1 = 0"
    3: z3
    4: rewrite_fact if_not_P @2,3 sym=false
    5: cut "0 / of_nat (n + 1) = 0"
    5: rewrite_goal real_div_eq_0 sym=false
    5: apply_backward_step disjI1
    5: apply_backward_step eq_refl
    8: rewrite_fact_with_prev @7,4
    9: rewrite_fact real_sub_rzero @8 sym=false
    10: apply_prev @9
    10: introduction x
    10.2: apply_backward_step has_real_derivative_atreal_within
    10.2: cut "x ^ n = of_nat (n + 1) * x ^ n / of_nat (n + 1) "
    10.2: rewrite_goal real_mult_comm sym=false
    10.2: rewrite_goal real_divide_def sym=false
    10.2: rewrite_goal real_mult_assoc sym=true
    10.2: cut "(of_nat (n + 1) * real_inverse (of_nat (n + 1))) = 1"
