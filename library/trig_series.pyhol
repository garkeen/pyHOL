theorem power_series_has_derivative
  fixes a :: nat ⇒ real, f :: real ⇒ real, r :: real, s :: nat set
  prop (∀x. abs x < r ⟶ real_sums (λi. a i * x ^ i) (f x) s) ⟶ (∃f1. ∀x. abs x < r ⟶ has_real_derivative f (f1 x) (atreal x) ∧ real_sums (λi. of_nat i * a i * x ^ (i - 1)) (f1 x) s)
  [hint_backward]
  proof
    1: cut "(!w. 0 < w --> abs w < r --> w < r --> abs w < abs r --> \n		      ?f1. (!x. abs x < w --> has_real_derivative f (f1 x) (atreal x) &\n				  real_sums (λi. of_nat i * a i * x ^ (i - 1)) (f1 x) s))\n     --> ?f1. (!x. abs x < r --> has_real_derivative f (f1 x) (atreal x) &\n				  real_sums (λi. of_nat i * a i * x ^ (i - 1)) (f1 x) s)"
