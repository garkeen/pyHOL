  cut "~n + 1 = 0" goal=2
    #[5] ¬(n + 1 = 0)
  ← z3 goal=5
    #[6] ¬(n + 1 = 0)
  → rewrite_fact if_not_P sym=false goal=2 facts=[4,6]
    #[7] (∀x. x ∈ real_closed_interval 0 a ⟶ has_real_derivative (λx1. x1 ^ (n + 1) / of_nat (n + 1)) (x ^ n) (within (atreal x) (real_closed_interval 0 a))) ⟶ has_real_integral (λx. x ^ n) (a ^ (n + 1) / of_nat (n + 1) - 0 / of_nat (n + 1)) (real_closed_interval 0 a)
  cut "0 / of_nat (n + 1) = 0" goal=2
