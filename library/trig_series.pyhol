  cut "min x 0 = x" goal=87
    #[88] min x 0 = x
  ← z3 goal=88 facts=[51]
  cut "max x 0 = 0" goal=87
    #[89] max x 0 = 0
  ← z3 goal=89 facts=[51]
  → rewrite_fact_with_prev goal=87 facts=[55,82]
    #[90] has_real_integral f v (real_closed_interval x (max x 0))
