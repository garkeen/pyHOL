  ← introduction goal=3
    #[4] ∀w. 0 < w ⟶ abs w < r ⟶ w < r ⟶ abs w < abs r ⟶ (∃f1. ∀x. abs x < w ⟶ has_real_derivative f (f1 x) (atreal x) ∧ real_sums (λi. of_nat i * a i * x ^ (i - 1)) (f1 x) s)
    #[5] ∃f1. ∀x. abs x < r ⟶ has_real_derivative f (f1 x) (atreal x) ∧ real_sums (λi. of_nat i * a i * x ^ (i - 1)) (f1 x) s
