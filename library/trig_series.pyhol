theorem power_series_integral
  fixes a :: nat ⇒ real, f :: real ⇒ real, r :: real, s :: nat set
  prop (∀x. abs x < r ⟶ real_sums (λi. a i * x ^ i) (f x) s) ⟶ (∀x. abs x < r ⟶ real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s)
  [hint_backward]
  proof
    1: introduction x
    1.2: apply_forward_step integral_series param_a="min x 0" param_b="max x 0" param_f="(%i. %x::real. a i * x ^ i)" param_g=f param_r="(%i. a i * (if x < 0 then (-1) else 1) * x ^ (i + 1) / of_nat (i + 1))" param_s=s
    1.3: cut "(∀e. 0 < e ⟶ (∃N. ∀n. ∀x1. N ≤ n ⟶ x1 ∈ real_closed_interval (min x 0) (max x 0) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x1 ^ i) - f x1) < e))"
    1.3: apply_forward_step power_series_uniform param_a=a param_s=s param_t=x param_y="abs x + (r - abs x) / 2"
    1.4: cut "real_summable s (λi. a i * (abs x + (r - abs x) / 2) ^ i)"
    1.4: rewrite_goal real_summable_def sym=false
    1.4: inst_exists_goal "f (abs x + (r - abs x) / 2)"
    1.4: apply_prev @0
    1.4: z3 @1.1
    1.8: cut "abs x < abs (abs x + (r - abs x) / 2)" @1.3
    1.8: z3 @1.1
    1.9: apply_fact @1.3,1.7,1.8
    1.10: introduction e
    1.10.2: apply_fact @1.9,1.10.1
    1.10.3: exists_elim N @1.10.2
    1.10.5: inst_exists_goal N
    1.10.5: introduction n,x1
    1.10.5.4: rewrite_fact real_closed_interval_def @1.10.5.3 sym=false
    1.10.5.5: rewrite_fact member_collect @1.10.5.4 sym=false
    1.10.5.6: cut "x1 ∈ real_closed_interval (-(abs x)) (abs x)"
    1.10.5.6: rewrite_goal real_closed_interval_def sym=false
    1.10.5.6: rewrite_goal member_collect sym=false
    1.10.5.6: z3 @1.10.5.5
    1.10.5.9: apply_fact @1.10.4,1.10.5.2,1.10.5.8
    1.10.5.10: cut "real_infsum s (λi. a i * x1 ^ i) = f x1" @1.10.5.9
    1.10.5.10: apply_backward_step real_infsum_unique
    1.10.5.10: apply_prev @0
    1.10.5.10: z3 @1.10.5.5,1.1
    1.10.5.13: rewrite_fact_with_prev @1.10.5.12,1.10.5.9
    1.11: apply_fact @1.2,1.10
    1.12: cut "(∀n. has_real_integral (λx1. a n * x1 ^ n) (a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0)))"
    1.12: introduction n
    1.12.1: cut "(a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) = (a n * ((if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)))"
    1.12.1: rewrite_goal real_divide_def sym=false
    1.12.1: real_norm
    1.12.3: rewrite_goal_with_prev @1.12.2
    1.12.3: apply_backward_step has_real_integral_lmul
    1.12.3: cases "x < 0"
    1.12.3: introduction
    1.12.3.1: rewrite_goal if_P @1.12.3.0 sym=false
    1.12.3.1: cut "min x (0) = x"
    1.12.3.1: z3 @1.12.3.0
    1.12.3.2: rewrite_goal_with_prev @1.12.3.1
    1.12.3.2: cut "max x 0 = 0"
    1.12.3.2: z3 @1.12.3.0
    1.12.3.3: rewrite_goal_with_prev @1.12.3.2
    1.12.3.3: cut "(-1 * x ^ (n + 1) / of_nat (n + 1)) = -(x ^ (n + 1) / of_nat (n + 1))"
    1.12.3.3: rewrite_goal real_divide_def sym=false
    1.12.3.3: real_norm
    1.12.3.5: rewrite_goal_with_prev @1.12.3.4
    1.12.3.5: apply_backward_step has_real_integral_pow_neg
    1.12.3.5: apply_backward_step real_lt_imp_le @1.12.3.0
    1.12.4: introduction
    1.12.4.1: rewrite_goal if_not_P @1.12.4.0 sym=false
    1.12.4.1: cut "(min x 0) = 0"
    1.12.4.1: z3 @1.12.4.0
    1.12.4.2: rewrite_goal_with_prev @1.12.4.1
    1.12.4.2: cut "(max x 0) = x"
    1.12.4.2: z3 @1.12.4.0
    1.12.4.3: rewrite_goal_with_prev @1.12.4.2
    1.12.4.3: rewrite_goal real_mul_lid sym=false
    1.12.4.3: apply_backward_step has_real_integral_pow_pos
    1.12.4.3: rewrite_fact real_not_lt @1.12.4.0 sym=false
    1.13: apply_fact @1.11,1.12
    1.14: exists_elim v @1.13
    1.16: apply_forward_step conjD1 @1.15
    1.17: apply_forward_step conjD2 @1.15
    1.18: cases "x < 0"
    1.18: introduction
    1.18.1: rewrite_goal if_P @1.18.0 sym=false
    1.18.1: cut "min x 0 = x"
    1.18.1: z3 @1.18.0
    1.18.2: cut "max x 0 = 0"
    1.18.2: z3 @1.18.0
    1.18.3: rewrite_fact_with_prev @1.18.1,1.16
    1.18.4: rewrite_fact_with_prev @1.18.2,1.18.3
    1.18.5: apply_forward_step real_integral_unique @1.18.4
    1.18.6: rewrite_goal_with_prev @1.18.5
    1.18.6: rewrite_fact if_P @1.17,1.18.0 sym=false
    1.18.7: apply_forward_step real_series_neg @1.18.6
    1.18.8: cut "!i. -(a i * -1 * x ^ (i + 1) / of_nat (i + 1)) = a i * x ^ (i + 1) / of_nat (i + 1)"
    1.18.8: rewrite_goal real_divide_def sym=false
    1.18.8: introduction i
    1.18.8.1: real_norm
    1.18.10: rewrite_fact_with_prev @1.18.9,1.18.7
    1.19: introduction
    1.19.1: rewrite_goal if_not_P @1.19.0 sym=false
    1.19.1: cut "min x 0 = 0"
    1.19.1: z3 @1.19.0
    1.19.2: cut "max x 0 = x"
    1.19.2: z3 @1.19.0
    1.19.3: rewrite_fact_with_prev @1.19.1,1.16
    1.19.4: rewrite_fact_with_prev @1.19.2,1.19.3
    1.19.5: apply_forward_step real_integral_unique @1.19.4
    1.19.6: rewrite_goal_with_prev @1.19.5
    1.19.6: rewrite_fact if_not_P @1.17,1.19.0 sym=false
    1.19.7: rewrite_fact real_mul_rid @1.19.6 sym=false
  qed

theorem power_series_integral2
  fixes a :: nat ⇒ real, f :: real ⇒ real, f1 :: real ⇒ real, r :: real, s :: nat set
  prop (∀x. abs x < r ⟶ has_real_derivative f (f1 x) (atreal x)) ⟶ (∀x. abs x < r ⟶ real_sums (λi. a i * x ^ i) (f1 x) s) ⟶ (∀x. abs x < r ⟶ real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (f x - f 0) s)
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step power_series_integral @1
    3: introduction x
    3.2: apply_fact @2,3.1
    3.3: cut "(if x < 0 then -(real_integral (real_closed_interval x 0) f1) else real_integral (real_closed_interval 0 x) f1) = f x - f 0" @3.2
    3.3: cases "x < 0"
    3.3: introduction
    3.3.1: rewrite_goal if_P @3.3.0 sym=false
    3.3.1: cut "real_integral (real_closed_interval x 0) f1 = f 0 - f x"
    3.3.1: apply_backward_step real_integral_unique
    3.3.1: apply_backward_step real_fundamental_theorem_of_calculus
    3.3.1: apply_backward_step real_lt_imp_le @3.3.0
    3.3.2: introduction x1
    3.3.2.2: apply_backward_step has_real_derivative_atreal_within
    3.3.2.2: apply_prev @0
    3.3.2.2: rewrite_fact real_closed_interval_def @3.3.2.1 sym=false
    3.3.2.3: rewrite_fact member_collect @3.3.2.2 sym=false
    3.3.2.4: z3 @3.3.2.3,3.1
    3.3.5: rewrite_goal_with_prev @3.3.4
    3.3.5: rewrite_goal real_neg_sub sym=false
    3.4: introduction
    3.4.1: rewrite_goal if_not_P @3.4.0 sym=false
    3.4.1: apply_backward_step real_integral_unique
    3.4.1: apply_backward_step real_fundamental_theorem_of_calculus
    3.4.1: rewrite_fact real_not_lt @3.4.0 sym=false
    3.4.2: introduction x1
    3.4.2.2: apply_backward_step has_real_derivative_atreal_within
    3.4.2.2: apply_prev @0
    3.4.2.2: rewrite_fact real_closed_interval_def @3.4.2.1 sym=false
    3.4.2.3: rewrite_fact member_collect @3.4.2.2 sym=false
    3.4.2.4: z3 @3.4.2.3,3.1
    3.6: rewrite_fact_with_prev @3.5,3.2
  qed

theorem strict_increasing_nat_le
  fixes h :: nat ⇒ nat
  prop (∀n. h n < h (n + 1)) ⟶ (∀n. n ≤ h n)
  [hint_backward]
  proof
    1: introduction n
    1.1: induction n nat_induct
    1.1: apply_backward_step le_0
    1.2: rewrite_goal lesseq_Suc_less sym=false
    1.2: introduction n
    1.2.1: apply_backward_step let_trans param_m="h n"
    1.2.1: rewrite_goal add_1_right sym=true
    1.2.1: apply_prev @0
  qed

theorem strict_increasing_nat_lt
  fixes h :: nat ⇒ nat
  prop (∀n. h n < h (n + 1)) ⟶ (∀n. ∀m. n < m ⟶ h n < h m)
  [hint_backward]
  proof
    1: introduction n,m
    1.3: revert_intro @1.2
    1.2: induction n nat_induct
    1.2: induction m nat_induct
    1.2: z3
    1.3: introduction m
    1.3.2: rewrite_goal add_1_right sym=true
    1.3.2: rewrite_fact nat_less_def_2 @1.3.1 sym=false
    1.3.3: apply_backward_step disjE @1.3.2
    1.3.3: introduction
    1.3.3.1: rewrite_goal_with_prev @1.3.3.0
    1.3.3.1: apply_prev @0
    1.3.4: introduction
    1.3.4.1: apply_backward_step lt_trans param_m="h m"
    1.3.4.1: apply_prev @1.3.0,1.3.4.0
    1.3.4.2: apply_prev @0
    1.5: introduction n
    1.5.2: revert_intro @1.5.1
    1.5.1: induction m nat_induct
    1.5.1: rewrite_goal nat_less_def_1 sym=false
    1.5.1: z3
    1.5.3: introduction m1
    1.5.3.3: rewrite_fact nat_less_def_2 @1.5.3.2 sym=false
    1.5.3.4: apply_backward_step disjE @1.5.3.3
    1.5.3.4: introduction
    1.5.3.4.1: rewrite_goal_with_prev @1.5.3.4.0
    1.5.3.4.1: rewrite_goal add_1_right sym=true
    1.5.3.4.1: apply_prev @0
    1.5.3.5: introduction
    1.5.3.5.1: apply_backward_step lt_trans param_m="h m1"
    1.5.3.5.1: apply_prev @1.5.3.1,1.5.3.5.0
    1.5.3.5.2: rewrite_goal add_1_right sym=true
    1.5.3.5.2: apply_prev @0
  qed

theorem strict_increasing_nat_inj
  fixes h :: nat ⇒ nat
  prop (∀n. h n < h (n + 1)) ⟶ (∀n. ∀m. h n = h m ⟶ n = m)
  [hint_backward]
  proof
    1: apply_forward_step strict_increasing_nat_lt @0
    2: introduction n,m
    2.3: cut "n = m | n < m | m < n"
    2.3: z3
    2.4: apply_backward_step disjE @2.3
    2.5: introduction
    2.5.1: apply_backward_step disjE @2.5.0
    2.5.1: introduction
    2.5.1.1: apply_fact @1,2.5.1.0
    2.5.1.2: z3 @2.5.1.1,2.2
    2.5.2: introduction
    2.5.2.1: apply_fact @1,2.5.2.0
    2.5.2.2: z3 @2.5.2.1,2.2
  qed

theorem strict_increasing_nat_le_eq
  fixes h :: nat ⇒ nat
  prop (∀n. h n < h (n + 1)) ⟶ (∀n. ∀m. h n ≤ h m ⟷ n ≤ m)
  [hint_backward]
  proof
    1: apply_forward_step strict_increasing_nat_lt @0
    2: introduction n,m
    2.2: apply_backward_step iffI
    2.2: introduction
    2.2.1: rewrite_goal double_neg sym=true
    2.2.1: rewrite_goal not_le sym=false
    2.2.1: apply_backward_step contrapositive @2.2.0
    2.2.1: introduction
    2.2.1.1: rewrite_fact double_neg @2.2.1.0 sym=false
    2.2.1.2: apply_fact @1,2.2.1.1
    2.2.1.3: rewrite_goal not_le sym=false
    2.3: introduction
    2.3.1: rewrite_fact le_lt @2.3.0 sym=false
    2.3.2: apply_backward_step disjE @2.3.1
    2.3.2: introduction
    2.3.2.1: apply_fact @1,2.3.2.0
    2.3.2.2: apply_backward_step lt_imp_le @2.3.2.1
    2.3.3: introduction
    2.3.3.1: rewrite_goal_with_prev @2.3.3.0
    2.3.3.1: apply_backward_step less_eq_refl
  qed

theorem strict_increasing_nat_lt_eq
  fixes h :: nat ⇒ nat
  prop (∀n. h n < h (n + 1)) ⟶ (∀n. ∀m. h n < h m ⟷ n < m)
  [hint_backward]
  proof
    1: introduction n,m
    1.2: rewrite_goal not_le sym=true
    1.2: apply_forward_step strict_increasing_nat_le_eq @0
    1.3: rewrite_goal_with_prev @1.2
  qed

theorem strict_increasing_nat_le2
  fixes h :: nat ⇒ nat
  prop (∀n. h n < h (n + 1)) ⟶ (∀n. ∀m. h n ≤ m ⟶ n ≤ m)
  [hint_backward]
  proof
    1: introduction n,m
    1.3: apply_backward_step less_eq_trans param_m="h n"
    1.3: apply_forward_step strict_increasing_nat_le @0
    1.4: apply_prev @1.3
  qed

theorem real_sums_image
  fixes f :: nat ⇒ real, h :: nat ⇒ nat, l :: real, s :: nat set
  prop (∀n. h n < h (n + 1)) ⟶ real_sums f l (image h s) ⟷ real_sums (f ∘ h) l s
  [hint_backward]
  proof
    1: rewrite_goal real_sums_def sym=false
    1: rewrite_goal reallim_sequentially sym=false
    1: apply_forward_step strict_increasing_nat_le @0
    2: apply_forward_step strict_increasing_nat_inj @0
    3: apply_forward_step strict_increasing_nat_le_eq @0
    4: apply_forward_step strict_increasing_nat_le2 @0
    5: apply_backward_step iffI
    5: introduction
    5.1: introduction e
    5.1.2: apply_fact @5.0,5.1.1
    5.1.3: exists_elim N @5.1.2
    5.1.5: inst_exists_goal N
