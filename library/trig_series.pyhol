    2.9: cut "(∀n. ∀x. -w < x ∧ x < w ⟶ has_real_derivative (λx1. a n * x1 ^ n) (of_nat n * a n * x ^ (n - 1)) (within (atreal x) (real_open_interval (-w) w)))"
    2.9: introduction n,x
    2.9.3: apply_backward_step has_real_derivative_atreal_within
    2.9.3: cut "of_nat n * a n * x ^ (n - 1) = a n * (of_nat n * x ^ (n - 1))"
    2.9.3: real_norm
    2.9.4: rewrite_goal_with_prev @2.9.3
    2.9.4: apply_backward_step has_real_derivative_lmul_atreal
    2.9.4: cut "of_nat n * x ^ (n - 1) = of_nat n * x ^ (n - 1) * 1"
    2.9.4: rewrite_goal real_mul_rid sym=false
    2.9.5: rewrite_goal_with_prev @2.9.4
    2.9.5: apply_backward_step has_real_derivative_pow_atreal
