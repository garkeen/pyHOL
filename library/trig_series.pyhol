theorem power_series_integral
  fixes a :: nat => real, f :: real => real, r :: real, s :: nat set
  prop (!x. abs x < r --> real_sums (%i. a i * x ^ i) (f x) s) --> (!x. abs x < r --> real_sums (%i. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ∀x. abs x < r ⟶ real_sums (λi. a i * x ^ i) (f x) s
    #[2] ∀x. abs x < r ⟶ real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s
  ← introduction x goal=2
    #[3] _VAR x
    #[4] abs x < r
    #[5] real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s
  → apply_forward_step integral_series param_a="min x 0" param_b="max x 0" param_f="(%i. %x::real. a i * x ^ i)" param_g=f param_r="(%i. a i * (if x < 0 then (-1) else 1) * x ^ (i + 1) / of_nat (i + 1))" param_s=s goal=5
    #[6] (∀e. 0 < e ⟶ (∃N. ∀n. ∀x1. N ≤ n ⟶ x1 ∈ real_closed_interval (min x 0) (max x 0) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x1 ^ i) - f x1) < e)) ⟶ (∀n. has_real_integral (λx1. a n * x1 ^ n) (a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0))) ⟶ (∃v. has_real_integral f v (real_closed_interval (min x 0) (max x 0)) ∧ real_sums (λi. a i * (if x < 0 then -1 else 1) * x ^ (i + 1) / of_nat (i + 1)) v s)
  cut "(∀e. 0 < e ⟶ (∃N. ∀n. ∀x1. N ≤ n ⟶ x1 ∈ real_closed_interval (min x 0) (max x 0) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x1 ^ i) - f x1) < e))" goal=5
    #[7] ∀e. 0 < e ⟶ (∃N. ∀n. ∀x1. N ≤ n ⟶ x1 ∈ real_closed_interval (min x 0) (max x 0) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x1 ^ i) - f x1) < e)
  → apply_forward_step power_series_uniform param_a=a param_s=s param_t=x param_y="abs x + (r - abs x) / 2" goal=7
    #[8] real_summable s (λi. a i * (abs x + (r - abs x) / 2) ^ i) ⟶ abs x < abs (abs x + (r - abs x) / 2) ⟶ (∀e. 0 < e ⟶ (∃N. ∀n. ∀x1. N ≤ n ⟶ x1 ∈ real_closed_interval (-(abs x)) (abs x) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x1 ^ i) - real_infsum s (λi. a i * x1 ^ i)) < e))
  cut "real_summable s (λi. a i * (abs x + (r - abs x) / 2) ^ i)" goal=7
    #[9] real_summable s (λi. a i * (abs x + (r - abs x) / 2) ^ i)
  ← rewrite_goal real_summable_def sym=false goal=9
    #[10] ∃l. real_sums (λi. a i * (abs x + (r - abs x) / 2) ^ i) l s
  ← inst_exists_goal "f (abs x + (r - abs x) / 2)" goal=10
    #[11] real_sums (λi. a i * (abs x + (r - abs x) / 2) ^ i) (f (abs x + (r - abs x) / 2)) s
  ← apply_prev goal=11 facts=[1]
    #[12] abs (abs x + (r - abs x) / 2) < r
  ← z3 goal=12 facts=[4]
    #[13] abs (abs x + (r - abs x) / 2) < r
  cut "abs x < abs (abs x + (r - abs x) / 2)" goal=7 facts=[8]
    #[14] abs x < abs (abs x + (r - abs x) / 2)
  ← z3 goal=14 facts=[4]
    #[15] abs x < abs (abs x + (r - abs x) / 2)
  → apply_fact goal=7 facts=[8,9,15]
    #[16] ∀e. 0 < e ⟶ (∃N. ∀n. ∀x1. N ≤ n ⟶ x1 ∈ real_closed_interval (-(abs x)) (abs x) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x1 ^ i) - real_infsum s (λi. a i * x1 ^ i)) < e)
  ← introduction e goal=7
    #[17] _VAR e
    #[18] 0 < e
    #[19] ∃N. ∀n. ∀x1. N ≤ n ⟶ x1 ∈ real_closed_interval (min x 0) (max x 0) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x1 ^ i) - f x1) < e
  → apply_fact goal=19 facts=[16,18]
    #[20] ∃N. ∀n. ∀x1. N ≤ n ⟶ x1 ∈ real_closed_interval (-(abs x)) (abs x) ⟶ abs (sum (s ∩ {0..n}) (λi. a i * x1 ^ i) - real_infsum s (λi. a i * x1 ^ i)) < e
  exists_elim N goal=19 facts=[20]
