theorem power_series_has_derivative2
  fixes a :: nat => real, f :: real => real, r :: real
  prop (!x. abs x < r --> real_sums (%i. a i * x ^ i) (f x) univ) --> (?f1. !x. abs x < r --> has_real_derivative f (f1 x) (atreal x) & real_sums (%i. of_nat (Suc i) * a (Suc i) * x ^ i) (f1 x) univ)
  [hint_backward]

theorem real_sums_i_xi
  fixes x :: real
  prop abs x < 1 --> real_sums (%i. of_nat i * x ^ i) (x / (1 - x) ^ (2::nat)) univ
  [hint_backward]
proof
  ← introduction goal=0
    #[1] abs x < 1
    #[2] real_sums (λi. of_nat i * x ^ i) (x / (1 - x) ^ (2::nat)) univ
