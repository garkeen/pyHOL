theorem power_series_has_derivative2
  fixes a :: nat ⇒ real, f :: real ⇒ real, r :: real
  prop (∀x. abs x < r ⟶ real_sums (λi. a i * x ^ i) (f x) univ) ⟶ (∃f1. ∀x. abs x < r ⟶ has_real_derivative f (f1 x) (atreal x) ∧ real_sums (λi. of_nat (Suc i) * a (Suc i) * x ^ i) (f1 x) univ)
  [hint_backward]
  proof
    1: apply_forward_step power_series_has_derivative @0
    2: rewrite_fact power_series_derivative_shift @1 sym=false
    3: cut "(image Pre (diff univ ({0}))) = univ"
    3: apply_backward_step member_ext
    3: introduction x
    3.1: rewrite_goal in_image sym=false
    3.1: rewrite_goal member_diff sym=false
    3.1: rewrite_goal member_singleton sym=false
    3.1: apply_backward_step iffI
    3.1: introduction
    3.1.1: apply_backward_step member_univ
    3.2: introduction
    3.2.1: inst_exists_goal "Suc x"
    3.2.1: apply_backward_step conjI
    3.2.1: rewrite_goal Pre_def_2 sym=false
    3.2.2: apply_backward_step conjI
    3.2.2: apply_backward_step member_univ
    3.2.3: rewrite_goal eq_sym_eq sym=false
    3.2.3: apply_backward_step nat_zero_Suc_neq
    5: rewrite_fact_with_prev @4,2
  qed

theorem real_sums_i_xi
  fixes x :: real
  prop abs x < 1 ⟶ real_sums (λi. of_nat i * x ^ i) (x / (1 - x) ^ (2::nat)) univ
  [hint_backward]
  proof
    1: apply_forward_step power_series_has_derivative param_a="(%i::nat. (1::real))" param_f="(%x::real. 1 / (1 - x))" param_r="(1::real)" param_s="(univ::nat set)"
