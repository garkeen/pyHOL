  ← introduction goal=50
    #[66] ¬(x < 0)
    #[67] has_real_integral (λx1. x1 ^ n) ((if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0))
  ← rewrite_goal if_not_P sym=false goal=67 facts=[66]
