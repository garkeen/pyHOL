  ← apply_backward_step has_real_integral_pow_pos goal=75
    #[76] 0 ≤ x
  → rewrite_fact real_not_lt sym=false goal=76 facts=[66]
    #[77] 0 ≤ x
  → apply_fact goal=5 facts=[41,42]
    #[78] ∃v. has_real_integral f v (real_closed_interval (min x 0) (max x 0)) ∧ real_sums (λi. a i * (if x < 0 then -1 else 1) * x ^ (i + 1) / of_nat (i + 1)) v s
  exists_elim v goal=5 facts=[78]
    #[79] _VAR v
    #[80] has_real_integral f v (real_closed_interval (min x 0) (max x 0)) ∧ real_sums (λi. a i * (if x < 0 then -1 else 1) * x ^ (i + 1) / of_nat (i + 1)) v s
    #[81] real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s
  → apply_forward_step conjD1 goal=81 facts=[80]
    #[82] has_real_integral f v (real_closed_interval (min x 0) (max x 0))
  → apply_forward_step conjD2 goal=81 facts=[80]
    #[83] real_sums (λi. a i * (if x < 0 then -1 else 1) * x ^ (i + 1) / of_nat (i + 1)) v s
  ← cases "x < 0" goal=81
    #[84] x < 0 ⟶ real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s
    #[85] ¬(x < 0) ⟶ real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s
  ← introduction goal=84
    #[86] real_sums (λi. a i * x ^ (i + 1) / of_nat (i + 1)) (if x < 0 then -(real_integral (real_closed_interval x 0) f) else real_integral (real_closed_interval 0 x) f) s
  ← rewrite_goal if_P sym=false goal=86 facts=[51]
