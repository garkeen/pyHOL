    #[41] (∀n. has_real_integral (λx1. a n * x1 ^ n) (a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0))) ⟶ (∃v. has_real_integral f v (real_closed_interval (min x 0) (max x 0)) ∧ real_sums (λi. a i * (if x < 0 then -1 else 1) * x ^ (i + 1) / of_nat (i + 1)) v s)
  cut "(∀n. has_real_integral (λx1. a n * x1 ^ n) (a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0)))" goal=5
    #[42] ∀n. has_real_integral (λx1. a n * x1 ^ n) (a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0))
  ← introduction n goal=42
    #[43] has_real_integral (λx1. a n * x1 ^ n) (a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval (min x 0) (max x 0))
  cut "(a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)) = (a n * ((if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1)))" goal=43
    #[44] a n * (if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1) = a n * ((if x < 0 then -1 else 1) * x ^ (n + 1) / of_nat (n + 1))
  ← rewrite_goal real_divide_def sym=false goal=44
