theorem power_series_has_derivative
  fixes a :: nat => real, f :: real => real, r :: real, s :: nat set
  prop (!x. abs x < r --> real_sums (%i. a i * x ^ i) (f x) s) --> (?f1. !x. abs x < r --> has_real_derivative f (f1 x) (atreal x) & real_sums (%i. of_nat i * a i * x ^ (i - 1)) (f1 x) s)
  [hint_backward]
