  → apply_forward_step has_real_derivative_series param_f="(%i. %x. a i * x ^ i)" param_f1="(%i. %x. (of_nat i * a i) * x ^ (i - 1))" param_g1="(%x. real_infsum s (%i. (of_nat i * a i) * x ^ (i - 1)))" param_k=s param_s="(real_open_interval (-w) w)" goal=35
