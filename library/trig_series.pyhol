    1.7: introduction x
    1.7.2: forall_elim "(abs x + r) / 2" @1.6
    1.7.3: cut "0 < (abs x + r) / 2"
    1.7.3: z3 @1.7.1
    1.7.4: cut "abs ((abs x + r) / 2) < r" @1.7.2
    1.7.4: z3 @1.7.1
    1.7.5: cut "(abs x + r) / 2 < r" @1.7.2
    1.7.5: z3 @1.7.1
    1.7.6: cut "abs ((abs x + r) / 2) < abs r"
    1.7.6: z3 @1.7.1
    1.7.7: apply_fact @1.7.2,1.7.3,1.7.4,1.7.5,1.7.6
    1.7.8: apply_prev @1.7.7
    1.7.8: z3 @1.7.1
    2: apply_prev @1
    2: introduction w
    2.5: apply_forward_step has_real_derivative_series param_f="(%i. %x. a i * x ^ i)" param_f1="(%i. %x. (of_nat i * a i) * x ^ (i - 1))" param_g1="(%x. real_infsum s (%i. (of_nat i * a i) * x ^ (i - 1)))" param_k=s param_s="(real_open_interval (-w) w)"
    2.6: cut "is_realinterval (real_open_interval (-w) w)" @2.5
