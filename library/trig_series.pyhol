    5.1.5.2: cut "N<= h n"
    5.1.5.2: apply_backward_step less_eq_trans @5.1.5.1
    5.1.5.2: apply_prev @1
    5.1.5.4: apply_fact @5.1.4,5.1.5.3
    5.1.5.5: cut "image h s ∩ {0..(h n)} = image h (s ∩ {0..n})"
    5.1.5.5: apply_backward_step member_ext
    5.1.5.5: introduction x
    5.1.5.5.1: rewrite_goal member_inter_iff sym=false
    5.1.5.5.1: rewrite_goal in_image sym=false
    5.1.5.5.1: rewrite_goal member_inter_iff sym=false
    5.1.5.5.1: rewrite_goal member_natseg_0 sym=false
    5.1.5.5.1: apply_backward_step iffI
    5.1.5.5.1: introduction
    5.1.5.5.1.1: apply_forward_step conjD1 @5.1.5.5.1.0
    5.1.5.5.1.2: apply_forward_step conjD2 @5.1.5.5.1.0
    5.1.5.5.1.3: exists_elim x1 @5.1.5.5.1.1
    5.1.5.5.1.5: inst_exists_goal x1
    5.1.5.5.1.5: rewrite_goal conj_assoc sym=false
    5.1.5.5.1.5: apply_backward_step conjI
    5.1.5.5.1.5: apply_forward_step conjD1 @5.1.5.5.1.4
    5.1.5.5.1.6: rewrite_fact_with_prev @5.1.5.5.1.5,5.1.5.5.1.2
    5.1.5.5.1.7: rewrite_fact_with_prev @3,5.1.5.5.1.6
    5.1.5.5.2: introduction
    5.1.5.5.2.1: exists_elim x1 @5.1.5.5.2.0
    5.1.5.5.2.3: rewrite_fact conj_assoc @5.1.5.5.2.2 sym=false
    5.1.5.5.2.4: apply_forward_step conjD1 @5.1.5.5.2.3
    5.1.5.5.2.5: apply_forward_step conjD2 @5.1.5.5.2.3
    5.1.5.5.2.6: apply_backward_step conjI
    5.1.5.5.2.6: apply_backward_step exI @5.1.5.5.2.4
    5.1.5.5.2.7: apply_forward_step conjD1 @5.1.5.5.2.4
    5.1.5.5.2.8: rewrite_goal_with_prev @5.1.5.5.2.7
    5.1.5.5.2.8: rewrite_goal_with_prev @3
    5.1.5.7: apply_fact @5.1.4,5.1.5.3
    5.1.5.8: rewrite_fact_with_prev @5.1.5.6,5.1.5.7
    5.1.5.9: cut "sum (image h (s ∩ {0..n})) f = sum (s ∩ {0..n}) (f ∘ h)" @5.1.5.8
    5.1.5.9: apply_backward_step sum_image
    5.1.5.9: introduction x,y
    5.1.5.9.5: apply_prev @2,5.1.5.9.4
    5.1.5.11: rewrite_fact_with_prev @5.1.5.10,5.1.5.8
    6: introduction
    6.1: introduction e
    6.1.2: apply_fact @6.0,6.1.1
    6.1.3: exists_elim N @6.1.2
    6.1.5: inst_exists_goal "h N"
    6.1.5: introduction n
    6.1.5.2: cut "∃t. h t ≤ n ∧ (∀i. h i ≤ n ⟶ i ≤ t)"
    6.1.5.2: rewrite_goal nat_MAX sym=true
