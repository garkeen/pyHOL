  cut "max x 0 = 0" goal=56
    #[57] max x 0 = 0
  ← z3 goal=57 facts=[51]
    #[58] max x 0 = 0
  ← rewrite_goal_with_prev goal=56 facts=[58]
    #[59] has_real_integral (λx1. x1 ^ n) (-1 * x ^ (n + 1) / of_nat (n + 1)) (real_closed_interval x 0)
  cut "(-1 * x ^ (n + 1) / of_nat (n + 1)) = -(x ^ (n + 1) / of_nat (n + 1))" goal=59
    #[60] -1 * x ^ (n + 1) / of_nat (n + 1) = -(x ^ (n + 1) / of_nat (n + 1))
  ← rewrite_goal real_divide_def sym=false goal=60
