theory trig_series
imports realgamma
description "Formal inequalities for trig about series."

theorem abs_neg_pow
  fixes n :: nat, x :: real
  prop abs (-x ^ n) = abs x ^ n
  [hint_rewrite]
proof
  ← rewrite_goal real_abs_pow sym=false goal=0
    #[1] abs (-x) ^ n = abs x ^ n
  ← rewrite_goal real_abs_neg sym=false goal=1
qed

theorem abs_neg_one_pow
  fixes n :: nat
  prop abs (-(1::real) ^ n) = 1
  [hint_rewrite]
proof
  ← rewrite_goal abs_neg_pow sym=false goal=0
    #[1] abs (1::real) ^ n = 1
  ← rewrite_goal real_abs_pow sym=true goal=1
    #[2] abs ((1::real) ^ n) = 1
  ← rewrite_goal real_pow_one sym=false goal=2
    #[3] abs (1::real) = 1
  ← z3 goal=3
qed

theorem real_infsum_offset
  fixes f :: nat => real, k :: nat, m :: nat
  prop real_summable (from m) f --> m <= k --> real_infsum (from m) f = sum ({m..k}) f + real_infsum (from (k + 1)) f
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_summable (from m) f
    #[2] m ≤ k
    #[3] real_infsum (from m) f = sum ({m..k}) f + real_infsum (from (k + 1)) f
  → apply_forward_step real_summable_from_elsewhere param_n=k+1 goal=3 facts=[1]
    #[4] real_summable (from (k + 1)) f
  → rewrite_fact real_summable_def sym=false goal=3 facts=[1]
    #[5] ∃l. real_sums f l (from m)
  exists_elim l goal=3 facts=[5]
    #[6] _VAR l
    #[7] real_sums f l (from m)
    #[8] real_infsum (from m) f = sum ({m..k}) f + real_infsum (from (k + 1)) f
  ← apply_backward_step real_infsum_unique goal=8
    #[9] real_sums f (sum ({m..k}) f + real_infsum (from (k + 1)) f) (from m)
  → apply_forward_step real_sums_offset param_n=k+1 goal=9 facts=[7]
    #[10] m < k + 1 ⟶ real_sums f (l - sum ({m..k + 1 - 1}) f) (from (k + 1))
  → rewrite_fact nat_plus_minus sym=false goal=9 facts=[10]
    #[11] m < k + 1 ⟶ real_sums f (l - sum ({m..k}) f) (from (k + 1))
  cut "m < k + 1" goal=9
    #[12] m < k + 1
  ← z3 goal=12 facts=[2]
    #[13] m < k + 1
  → apply_fact goal=9 facts=[11,13]
    #[14] real_sums f (l - sum ({m..k}) f) (from (k + 1))
  → apply_forward_step real_infsum_unique goal=9 facts=[14]
    #[15] real_infsum (from (k + 1)) f = l - sum ({m..k}) f
  ← rewrite_goal_with_prev goal=9 facts=[15]
    #[16] real_sums f (sum ({m..k}) f + (l - sum ({m..k}) f)) (from m)
  cut "sum ({m..k}) f + (l - sum ({m..k}) f) = l" goal=16
    #[17] sum ({m..k}) f + (l - sum ({m..k}) f) = l
  real_norm goal=17
    #[18] sum ({m..k}) f + (l - sum ({m..k}) f) = l
  ← rewrite_goal_with_prev goal=16 facts=[18]
qed

theorem real_infsum_offset_alt
  fixes f :: nat => real, k :: nat, m :: nat
  prop real_summable (from m) f --> m < k --> real_infsum (from m) f = sum ({m..k - 1}) f + real_infsum (from k) f
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_summable (from m) f
    #[2] m < k
    #[3] real_infsum (from m) f = sum ({m..k - 1}) f + real_infsum (from k) f
  cut "m <= k - 1" goal=3
    #[4] m ≤ k - 1
  ← z3 goal=4 facts=[2]
    #[5] m ≤ k - 1
  → apply_forward_step real_infsum_offset goal=3 facts=[1,5]
    #[6] real_infsum (from m) f = sum ({m..k - 1}) f + real_infsum (from (k - 1 + 1)) f
  cut "k-1+1=k" goal=3
    #[7] k - 1 + 1 = k
  ← apply_backward_step sub_add goal=7
    #[8] 1 ≤ k
  ← z3 goal=8 facts=[2]
    #[9] 1 ≤ k
  → rewrite_fact_with_prev goal=3 facts=[7,6]
qed

theorem power_series_simple_bound
  fixes a :: nat => real, m :: nat, u :: real, x :: real
  prop real_summable (from m) (%i. a i * x ^ i) --> (!i. m <= i --> abs (a i) <= u) --> abs x < 1 --> abs (real_infsum (from m) (%i. a i * x ^ i)) <= u * abs x ^ m / (1 - abs x)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_summable (from m) (λi. a i * x ^ i)
    #[2] ∀i. m ≤ i ⟶ abs (a i) ≤ u
    #[3] abs x < 1
    #[4] abs (real_infsum (from m) (λi. a i * x ^ i)) ≤ u * abs x ^ m / (1 - abs x)
  ← apply_backward_step real_series_bound param_f="(λi. a i * x ^ i)" param_g="(λi::nat. u * abs x ^ i)" param_s="from m" goal=4
    #[5] real_sums (λi. a i * x ^ i) (real_infsum (from m) (λi. a i * x ^ i)) (from m)
    #[6] real_sums (λi. u * abs x ^ i) (u * abs x ^ m / (1 - abs x)) (from m)
    #[7] ∀i. i ∈ from m ⟶ abs (a i * x ^ i) ≤ u * abs x ^ i
  ← rewrite_goal real_sums_infsum sym=false goal=5
  ← rewrite_goal real_divide_def sym=false goal=6
    #[8] real_sums (λi. u * abs x ^ i) (u * abs x ^ m * real_inverse (1 - abs x)) (from m)
  ← rewrite_goal real_mult_assoc sym=true goal=8
    #[9] real_sums (λi. u * abs x ^ i) (u * (abs x ^ m * real_inverse (1 - abs x))) (from m)
  ← apply_backward_step real_series_lmul goal=9
    #[10] real_sums (λn. abs x ^ n) (abs x ^ m * real_inverse (1 - abs x)) (from m)
  ← rewrite_goal real_divide_def sym=true goal=10
    #[11] real_sums (λn. abs x ^ n) (abs x ^ m / (1 - abs x)) (from m)
  ← apply_backward_step real_sums_gp goal=11
    #[12] abs (abs x) < 1
  ← rewrite_goal real_abs_abs sym=false goal=12
  ← rewrite_goal in_from sym=false goal=7
    #[13] ∀i. m ≤ i ⟶ abs (a i * x ^ i) ≤ u * abs x ^ i
  ← introduction i goal=13
    #[14] _VAR i
    #[15] m ≤ i
    #[16] abs (a i * x ^ i) ≤ u * abs x ^ i
  ← rewrite_goal real_abs_mul sym=false goal=16
    #[17] abs (a i) * abs (x ^ i) ≤ u * abs x ^ i
  ← rewrite_goal real_abs_pow sym=false goal=17
    #[18] abs (a i) * abs x ^ i ≤ u * abs x ^ i
  ← rewrite_goal real_mult_comm sym=false goal=18
    #[19] abs x ^ i * abs (a i) ≤ abs x ^ i * u
  ← apply_backward_step real_le_lmul goal=19
    #[20] 0 ≤ abs x ^ i
    #[21] abs (a i) ≤ u
  ← apply_backward_step real_pow_le goal=20
    #[22] 0 ≤ abs x
  ← apply_backward_step real_abs_pos goal=22
    #[23] 0 ≤ abs x
  ← apply_prev goal=21 facts=[2]
qed

theorem power_series_simple_bound2
  fixes a :: nat => real, m :: nat, x :: real
  prop real_summable (from m) (%i. a i * x ^ i) --> (!i. m <= i --> abs (a (Suc i)) <= abs (a i)) --> abs x < 1 --> abs (real_infsum (from m) (%i. a i * x ^ i)) <= abs (a m) * abs x ^ m / (1 - abs x)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_summable (from m) (λi. a i * x ^ i)
    #[2] ∀i. m ≤ i ⟶ abs (a (Suc i)) ≤ abs (a i)
    #[3] abs x < 1
    #[4] abs (real_infsum (from m) (λi. a i * x ^ i)) ≤ abs (a m) * abs x ^ m / (1 - abs x)
  ← apply_backward_step power_series_simple_bound goal=4
    #[5] ∀i. m ≤ i ⟶ abs (a i) ≤ abs (a m)
  ← introduction i goal=5
    #[6] _VAR i
    #[7] m ≤ i
    #[8] abs (a i) ≤ abs (a m)
  revert_intro goal=8 facts=[7]
    #[9] m ≤ i ⟶ abs (a i) ≤ abs (a m)
  ← induction i nat_induct goal=9
    #[10] m ≤ 0 ⟶ abs (a 0) ≤ abs (a m)
    #[11] ∀n. (m ≤ n ⟶ abs (a n) ≤ abs (a m)) ⟶ m ≤ Suc n ⟶ abs (a (Suc n)) ≤ abs (a m)
  ← introduction goal=10
    #[12] m ≤ 0
    #[13] abs (a 0) ≤ abs (a m)
  → apply_forward_step nat_le_zero goal=13 facts=[12]
    #[14] m = 0
  ← rewrite_goal_with_prev goal=13 facts=[14]
    #[15] abs (a 0) ≤ abs (a 0)
  ← apply_backward_step real_le_refl goal=15
    #[16] abs (a 0) ≤ abs (a 0)
  ← introduction n goal=11
    #[17] _VAR n
    #[18] m ≤ n ⟶ abs (a n) ≤ abs (a m)
    #[19] m ≤ Suc n
    #[20] abs (a (Suc n)) ≤ abs (a m)
  → rewrite_fact nat_less_eq_def_2 sym=false goal=20 facts=[19]
    #[21] m = Suc n ∨ m ≤ n
  ← apply_backward_step disjE goal=20 facts=[21]
    #[22] m = Suc n ⟶ abs (a (Suc n)) ≤ abs (a m)
    #[23] m ≤ n ⟶ abs (a (Suc n)) ≤ abs (a m)
  ← introduction goal=22
    #[24] m = Suc n
    #[25] abs (a (Suc n)) ≤ abs (a m)
  ← rewrite_goal_with_prev goal=25 facts=[24]
    #[26] abs (a (Suc n)) ≤ abs (a (Suc n))
  ← apply_backward_step real_le_refl goal=26
    #[27] abs (a (Suc n)) ≤ abs (a (Suc n))
  ← introduction goal=23
    #[28] m ≤ n
    #[29] abs (a (Suc n)) ≤ abs (a m)
  ← apply_backward_step real_le_trans param_y="abs (a n)" goal=29
    #[30] abs (a (Suc n)) ≤ abs (a n)
    #[31] abs (a n) ≤ abs (a m)
  ← apply_prev goal=30 facts=[2]
  ← apply_prev goal=31 facts=[18]
qed

theorem real_sums_simple_bound
  fixes a :: nat => real, m :: nat, n :: nat, t :: real, u :: real, x :: real
  prop real_sums (%i. a i * x ^ i) t (from n) --> n < m --> (!i. m <= i --> abs (a i) <= u) --> abs x < 1 --> abs (t - sum ({n..m - 1}) (%i. a i * x ^ i)) <= u * abs x ^ m / (1 - abs x)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_sums (λi. a i * x ^ i) t (from n)
    #[2] n < m
    #[3] ∀i. m ≤ i ⟶ abs (a i) ≤ u
    #[4] abs x < 1
    #[5] abs (t - sum ({n..m - 1}) (λi. a i * x ^ i)) ≤ u * abs x ^ m / (1 - abs x)
  → apply_forward_step real_sums_summable goal=5 facts=[1]
    #[6] real_summable (from n) (λi. a i * x ^ i)
  → apply_forward_step real_infsum_unique goal=5 facts=[1]
    #[7] real_infsum (from n) (λi. a i * x ^ i) = t
  → apply_forward_step real_infsum_offset_alt goal=5 facts=[6,2]
    #[8] real_infsum (from n) (λi. a i * x ^ i) = sum ({n..m - 1}) (λi. a i * x ^ i) + real_infsum (from m) (λi. a i * x ^ i)
  → rewrite_fact_with_prev goal=5 facts=[7,8]
    #[9] t = sum ({n..m - 1}) (λi. a i * x ^ i) + real_infsum (from m) (λi. a i * x ^ i)
  cut "!a::real. !b. !c. a = b + c --> a - b = c" goal=5
    #[10] ∀a::real. ∀b. ∀c. a = b + c ⟶ a - b = c
  ← z3 goal=10
    #[11] ∀a::real. ∀b. ∀c. a = b + c ⟶ a - b = c
  → apply_fact goal=5 facts=[11,9]
    #[12] t - sum ({n..m - 1}) (λi. a i * x ^ i) = real_infsum (from m) (λi. a i * x ^ i)
  ← rewrite_goal_with_prev goal=5 facts=[12]
    #[13] abs (real_infsum (from m) (λi. a i * x ^ i)) ≤ u * abs x ^ m / (1 - abs x)
  ← apply_backward_step power_series_simple_bound goal=13
    #[14] real_summable (from m) (λi. a i * x ^ i)
  → apply_forward_step real_summable_from_elsewhere param_n=m goal=14 facts=[6]
    #[15] real_summable (from m) (λi. a i * x ^ i)
qed

theorem real_sums_simple_bound2
  fixes a :: nat => real, m :: nat, n :: nat, t :: real, u :: real, x :: real
  prop real_sums (%i. a i * x ^ i) t (from n) --> n < m --> (!i. m <= i --> abs (a (Suc i)) <= abs (a i)) --> abs x < 1 --> abs (t - sum ({n..m - 1}) (%i. a i * x ^ i)) <= abs (a m) * abs x ^ m / (1 - abs x)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_sums (λi. a i * x ^ i) t (from n)
    #[2] n < m
    #[3] ∀i. m ≤ i ⟶ abs (a (Suc i)) ≤ abs (a i)
    #[4] abs x < 1
    #[5] abs (t - sum ({n..m - 1}) (λi. a i * x ^ i)) ≤ abs (a m) * abs x ^ m / (1 - abs x)
  → apply_forward_step real_sums_summable goal=5 facts=[1]
    #[6] real_summable (from n) (λi. a i * x ^ i)
  → apply_forward_step real_infsum_unique goal=5 facts=[1]
    #[7] real_infsum (from n) (λi. a i * x ^ i) = t
  → apply_forward_step real_infsum_offset_alt goal=5 facts=[6,2]
    #[8] real_infsum (from n) (λi. a i * x ^ i) = sum ({n..m - 1}) (λi. a i * x ^ i) + real_infsum (from m) (λi. a i * x ^ i)
  → rewrite_fact_with_prev goal=5 facts=[7,8]
    #[9] t = sum ({n..m - 1}) (λi. a i * x ^ i) + real_infsum (from m) (λi. a i * x ^ i)
  cut "∀a::real. ∀b. ∀c. a = b + c ⟶ a - b = c" goal=5
    #[10] ∀a::real. ∀b. ∀c. a = b + c ⟶ a - b = c
  ← z3 goal=10
    #[11] ∀a::real. ∀b. ∀c. a = b + c ⟶ a - b = c
  → apply_fact goal=5 facts=[11,9]
    #[12] t - sum ({n..m - 1}) (λi. a i * x ^ i) = real_infsum (from m) (λi. a i * x ^ i)
  ← rewrite_goal_with_prev goal=5 facts=[12]
    #[13] abs (real_infsum (from m) (λi. a i * x ^ i)) ≤ abs (a m) * abs x ^ m / (1 - abs x)
  ← apply_backward_step power_series_simple_bound2 goal=13
    #[14] real_summable (from m) (λi. a i * x ^ i)
  → apply_forward_step real_summable_from_elsewhere param_n=m goal=14 facts=[6]
    #[15] real_summable (from m) (λi. a i * x ^ i)
qed

theorem abs_sum_lemma_pos
  fixes a :: real, b :: real
  prop 0 <= a * b --> abs (a + b) = abs a + abs b
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 ≤ a * b
    #[2] abs (a + b) = abs a + abs b
  ← z3 goal=2 facts=[1]
qed

theorem abs_sum_lemma_neg
  fixes a :: real, b :: real
  prop a * b <= 0 --> abs (a + b) = abs (abs a - abs b)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] a * b ≤ 0
    #[2] abs (a + b) = abs (abs a - abs b)
  ← z3 goal=2 facts=[1]
qed

theorem sign_mul_lemma
  fixes a :: real, b :: real, c :: real
  prop a * b <= 0 --> 0 <= b * c --> ~(b = 0) --> a * c <= 0
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] a * b ≤ 0
    #[2] 0 ≤ b * c
    #[3] ¬(b = 0)
    #[4] a * c ≤ 0
  ← z3 goal=4 facts=[1,2,3]
qed

theorem sum_bound_lemma
  fixes f :: nat => real, m :: nat, n :: nat
  prop (!k. abs (f (k + 1)) <= abs (f k) & f (k + 1) * f k <= 0) --> abs (sum ({m..n}) f) <= abs (f m) & 0 <= sum ({m..n}) f * f m
  [hint_backward]

theorem alt_sign_converges
  fixes f :: nat => real, k :: nat
  prop (!n. abs (f (n + 1)) <= abs (f n) & f (n + 1) * f n <= 0) --> tendsto_real f 0 sequentially --> (?l. real_sums f l (from k))
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0
    #[2] tendsto_real f 0 sequentially
    #[3] ∃l. real_sums f l (from k)
  ← rewrite_goal real_series_cauchy sym="" goal=3
    #[4] ∀e. 0 < e ⟶ (∃N. ∀m. ∀n. m ≥ N ⟶ abs (sum (from k ∩ {m..n}) f) < e)
  → rewrite_fact reallim_sequentially sym=false goal=4 facts=[2]
    #[5] ∀e. 0 < e ⟶ (∃N. ∀n. N ≤ n ⟶ abs (f n - 0) < e)
  → rewrite_fact real_sub_rzero sym=false goal=4 facts=[5]
    #[6] ∀e. 0 < e ⟶ (∃N. ∀n. N ≤ n ⟶ abs (f n) < e)
  ← introduction e goal=4
    #[7] _VAR e
    #[8] 0 < e
    #[9] ∃N. ∀m. ∀n. m ≥ N ⟶ abs (sum (from k ∩ {m..n}) f) < e
  ← rewrite_goal from_inter_natseg_gen sym=false goal=9
    #[10] ∃N. ∀m. ∀n. m ≥ N ⟶ abs (sum (if m < k then {k..n} else {m..n}) f) < e
  → apply_fact goal=10 facts=[6,8]
    #[11] ∃N. ∀n. N ≤ n ⟶ abs (f n) < e
  exists_elim N goal=10 facts=[11]
    #[12] _VAR N
    #[13] ∀n. N ≤ n ⟶ abs (f n) < e
    #[14] ∃N. ∀m. ∀n. m ≥ N ⟶ abs (sum (if m < k then {k..n} else {m..n}) f) < e
    #[15] ∃N. ∀m. ∀n. m ≥ N ⟶ abs (sum (from k ∩ {m..n}) f) < e
  ← inst_exists_goal N goal=14
    #[16] ∀m. ∀n. m ≥ N ⟶ abs (sum (if m < k then {k..n} else {m..n}) f) < e
  ← introduction m,n goal=16
    #[17] _VAR m
    #[18] _VAR n
    #[19] m ≥ N
    #[20] abs (sum (if m < k then {k..n} else {m..n}) f) < e
  → apply_forward_step sum_bound_lemma param_m="" param_n="" goal=20 facts=[1]
    #[21] ∀m. ∀n. abs (sum ({m..n}) f) ≤ abs (f m) ∧ 0 ≤ sum ({m..n}) f * f m
  ← cases "m < k" goal=20
    #[22] m < k ⟶ abs (sum (if m < k then {k..n} else {m..n}) f) < e
    #[23] ¬(m < k) ⟶ abs (sum (if m < k then {k..n} else {m..n}) f) < e
  ← introduction goal=22
    #[24] m < k
    #[25] abs (sum (if m < k then {k..n} else {m..n}) f) < e
  ← rewrite_goal if_P sym=false goal=25 facts=[24]
    #[26] abs (sum ({k..n}) f) < e
  → forall_elim k goal=26 facts=[21]
    #[27] ∀n. abs (sum ({k..n}) f) ≤ abs (f k) ∧ 0 ≤ sum ({k..n}) f * f k
  → forall_elim n goal=26 facts=[27]
    #[28] abs (sum ({k..n}) f) ≤ abs (f k) ∧ 0 ≤ sum ({k..n}) f * f k
  ← apply_backward_step real_let_trans param_y="abs (f k)" goal=26
    #[29] abs (sum ({k..n}) f) ≤ abs (f k)
    #[30] abs (f k) < e
  ← apply_backward_step conjD1 goal=29 facts=[28]
    #[31] abs (sum ({k..n}) f) ≤ abs (f k)
  ← apply_prev goal=30 facts=[13]
    #[32] N ≤ k
  ← z3 goal=32 facts=[19,24]
    #[33] N ≤ k
  ← introduction goal=23
    #[34] ¬(m < k)
    #[35] abs (sum (if m < k then {k..n} else {m..n}) f) < e
  ← rewrite_goal if_not_P sym=false goal=35 facts=[34]
    #[36] abs (sum ({m..n}) f) < e
  → forall_elim m goal=36 facts=[21]
    #[37] ∀n. abs (sum ({m..n}) f) ≤ abs (f m) ∧ 0 ≤ sum ({m..n}) f * f m
  → forall_elim n goal=36 facts=[37]
    #[38] abs (sum ({m..n}) f) ≤ abs (f m) ∧ 0 ≤ sum ({m..n}) f * f m
  ← apply_backward_step real_let_trans param_y="abs (f m)" goal=36
    #[39] abs (sum ({m..n}) f) ≤ abs (f m)
    #[40] abs (f m) < e
  ← apply_backward_step conjD1 goal=39 facts=[38]
    #[41] abs (sum ({m..n}) f) ≤ abs (f m)
  ← apply_prev goal=40 facts=[13]
    #[42] N ≤ m
  → rewrite_fact greater_eq_def sym=false goal=42 facts=[19]
    #[43] N ≤ m
qed

theorem alt_sign_summable
  fixes f :: nat => real, k :: nat
  prop (!n. abs (f (n + 1)) <= abs (f n) & f (n + 1) * f n <= 0) --> tendsto_real f 0 sequentially --> real_summable (from k) f
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0
    #[2] tendsto_real f 0 sequentially
    #[3] real_summable (from k) f
  ← rewrite_goal real_summable_def sym=false goal=3
    #[4] ∃l. real_sums f l (from k)
  ← apply_backward_step alt_sign_converges goal=4
qed

theorem alt_sign_converges2
  fixes f :: nat => real, k :: nat
  prop (!n. abs (f (n + 1)) <= abs (f n) & f (n + 1) * f n <= 0) --> tendsto_real f 0 sequentially --> (?l. real_sums f l (from k) & abs l <= abs (f k) & 0 <= l * f k)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0
    #[2] tendsto_real f 0 sequentially
    #[3] ∃l. real_sums f l (from k) ∧ abs l ≤ abs (f k) ∧ 0 ≤ l * f k
  → apply_forward_step alt_sign_converges param_k=k goal=3 facts=[1,2]
    #[4] ∃l. real_sums f l (from k)
  exists_elim l goal=3 facts=[4]
    #[5] _VAR l
    #[6] real_sums f l (from k)
    #[7] ∃l. real_sums f l (from k) ∧ abs l ≤ abs (f k) ∧ 0 ≤ l * f k
  ← inst_exists_goal l goal=7
    #[8] real_sums f l (from k) ∧ abs l ≤ abs (f k) ∧ 0 ≤ l * f k
  ← apply_backward_step conjI goal=8
    #[9] abs l ≤ abs (f k) ∧ 0 ≤ l * f k
  → rewrite_fact real_sums_def sym=false goal=9 facts=[6]
    #[10] tendsto_real (λn. sum (from k ∩ {0..n}) f) l sequentially
  → rewrite_fact from_inter_natseg sym=false goal=9 facts=[10]
    #[11] tendsto_real (λn. sum ({k..n}) f) l sequentially
  → apply_forward_step reallim_ubound param_b="" goal=9 facts=[11]
    #[12] ∀b. ¬(trivial_limit sequentially) ⟶ eventually (λx. sum ({k..x}) f ≤ b) sequentially ⟶ l ≤ b
  → apply_forward_step reallim_lbound param_b="" goal=9 facts=[11]
    #[13] ∀b. ¬(trivial_limit sequentially) ⟶ eventually (λx. b ≤ sum ({k..x}) f) sequentially ⟶ b ≤ l
  → apply_forward_step reallim_rmul param_c="f k" goal=9 facts=[11]
    #[14] tendsto_real (λx. sum ({k..x}) f * f k) (l * f k) sequentially
  → apply_forward_step reallim_lbound param_b="(0::real)" goal=9 facts=[14]
    #[15] ¬(trivial_limit sequentially) ⟶ eventually (λx. 0 ≤ sum ({k..x}) f * f k) sequentially ⟶ 0 ≤ l * f k
  cut "¬(trivial_limit sequentially)" goal=9 facts=[15]
    #[16] ¬(trivial_limit sequentially)
  ← apply_backward_step trivial_limit_sequentially goal=16
    #[17] ¬(trivial_limit sequentially)
  → apply_fact goal=9 facts=[12,17]
    #[18] ∀b. eventually (λx. sum ({k..x}) f ≤ b) sequentially ⟶ l ≤ b
  → apply_fact goal=9 facts=[13,17]
    #[19] ∀b. eventually (λx. b ≤ sum ({k..x}) f) sequentially ⟶ b ≤ l
  → apply_fact goal=9 facts=[15,17]
    #[20] eventually (λx. 0 ≤ sum ({k..x}) f * f k) sequentially ⟶ 0 ≤ l * f k
  → forall_elim "abs (f k)" goal=9 facts=[18]
    #[21] eventually (λx. sum ({k..x}) f ≤ abs (f k)) sequentially ⟶ l ≤ abs (f k)
  → forall_elim "-abs (f k)" goal=9 facts=[19]
    #[22] eventually (λx. -(abs (f k)) ≤ sum ({k..x}) f) sequentially ⟶ -(abs (f k)) ≤ l
  → apply_forward_step sum_bound_lemma param_m=k param_n="" goal=9 facts=[1]
    #[23] ∀n. abs (sum ({k..n}) f) ≤ abs (f k) ∧ 0 ≤ sum ({k..n}) f * f k
  ← apply_backward_step conjI goal=9
    #[24] abs l ≤ abs (f k)
    #[25] 0 ≤ l * f k
  ← rewrite_goal real_abs_bounds sym=false goal=24
    #[26] -(abs (f k)) ≤ l ∧ l ≤ abs (f k)
  ← apply_backward_step conjI goal=26
    #[27] -(abs (f k)) ≤ l
    #[28] l ≤ abs (f k)
  ← apply_prev goal=27 facts=[22]
    #[29] eventually (λx. -(abs (f k)) ≤ sum ({k..x}) f) sequentially
  ← rewrite_goal eventually_sequentially sym=false goal=29
    #[30] ∃N. ∀n. N ≤ n ⟶ -(abs (f k)) ≤ sum ({k..n}) f
  ← inst_exists_goal "(0::nat)" goal=30
    #[31] ∀n. 0 ≤ n ⟶ -(abs (f k)) ≤ sum ({k..n}) f
  ← introduction n goal=31
    #[32] _VAR n
    #[33] 0 ≤ n
    #[34] -(abs (f k)) ≤ sum ({k..n}) f
  → forall_elim n goal=34 facts=[23]
    #[35] abs (sum ({k..n}) f) ≤ abs (f k) ∧ 0 ≤ sum ({k..n}) f * f k
  → apply_forward_step conjD1 goal=34 facts=[35]
    #[36] abs (sum ({k..n}) f) ≤ abs (f k)
  → rewrite_fact real_abs_bounds sym=false goal=34 facts=[36]
    #[37] -(abs (f k)) ≤ sum ({k..n}) f ∧ sum ({k..n}) f ≤ abs (f k)
  ← apply_backward_step conjD1 goal=34 facts=[37]
    #[38] -(abs (f k)) ≤ sum ({k..n}) f
  ← apply_prev goal=28 facts=[18]
    #[39] eventually (λx. sum ({k..x}) f ≤ abs (f k)) sequentially
  ← rewrite_goal eventually_sequentially sym=false goal=39
    #[40] ∃N. ∀n. N ≤ n ⟶ sum ({k..n}) f ≤ abs (f k)
  ← inst_exists_goal "(0::nat)" goal=40
    #[41] ∀n. 0 ≤ n ⟶ sum ({k..n}) f ≤ abs (f k)
  ← introduction n goal=41
    #[42] sum ({k..n}) f ≤ abs (f k)
  → forall_elim n goal=42 facts=[23]
  → apply_forward_step conjD1 goal=42 facts=[35]
  → rewrite_fact real_abs_bounds sym=false goal=42 facts=[36]
  ← apply_backward_step conjD2 goal=42 facts=[37]
    #[43] sum ({k..n}) f ≤ abs (f k)
  ← apply_prev goal=25 facts=[20]
    #[44] eventually (λx. 0 ≤ sum ({k..x}) f * f k) sequentially
  ← rewrite_goal eventually_sequentially sym=false goal=44
    #[45] ∃N. ∀n. N ≤ n ⟶ 0 ≤ sum ({k..n}) f * f k
  ← inst_exists_goal "(0::nat)" goal=45
    #[46] ∀n. 0 ≤ n ⟶ 0 ≤ sum ({k..n}) f * f k
  ← introduction n goal=46
    #[47] 0 ≤ sum ({k..n}) f * f k
  → forall_elim n goal=47 facts=[23]
  ← apply_backward_step conjD2 goal=47 facts=[35]
    #[48] 0 ≤ sum ({k..n}) f * f k
qed

theorem alt_sign_bound
  fixes f :: nat => real, k :: nat
  prop (!n. abs (f (n + 1)) <= abs (f n) & f (n + 1) * f n <= 0) --> tendsto_real f 0 sequentially --> abs (real_infsum (from k) f) <= abs (f k)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0
    #[2] tendsto_real f 0 sequentially
    #[3] abs (real_infsum (from k) f) ≤ abs (f k)
  → apply_forward_step alt_sign_converges2 param_k=k goal=3 facts=[1,2]
    #[4] ∃l. real_sums f l (from k) ∧ abs l ≤ abs (f k) ∧ 0 ≤ l * f k
  exists_elim l goal=3 facts=[4]
    #[5] _VAR l
    #[6] real_sums f l (from k) ∧ abs l ≤ abs (f k) ∧ 0 ≤ l * f k
    #[7] abs (real_infsum (from k) f) ≤ abs (f k)
  → apply_forward_step conjD1 goal=7 facts=[6]
    #[8] real_sums f l (from k)
  → apply_forward_step real_infsum_unique goal=7 facts=[8]
    #[9] real_infsum (from k) f = l
  ← rewrite_goal_with_prev goal=7 facts=[9]
    #[10] abs l ≤ abs (f k)
  → apply_forward_step conjD2 goal=10 facts=[6]
    #[11] abs l ≤ abs (f k) ∧ 0 ≤ l * f k
  ← apply_backward_step conjD1 goal=10 facts=[11]
    #[12] abs l ≤ abs (f k)
qed

theorem alt_sign_abs_bound
  fixes f :: nat => real, k :: nat, m :: nat
  prop (!n. abs (f (n + 1)) <= abs (f n) & f (n + 1) * f n <= 0) --> tendsto_real f 0 sequentially --> m < k --> abs (real_infsum (from m) f - sum ({m..k - 1}) f) <= abs (f k)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0
    #[2] tendsto_real f 0 sequentially
    #[3] m < k
    #[4] abs (real_infsum (from m) f - sum ({m..k - 1}) f) ≤ abs (f k)
  → apply_forward_step alt_sign_summable param_k=m goal=4 facts=[1,2]
    #[5] real_summable (from m) f
  → apply_forward_step real_infsum_offset_alt goal=4 facts=[5,3]
    #[6] real_infsum (from m) f = sum ({m..k - 1}) f + real_infsum (from k) f
  → apply_forward_step alt_sign_bound param_k=k goal=4 facts=[1,2]
    #[7] abs (real_infsum (from k) f) ≤ abs (f k)
  cut "real_infsum (from m) f - sum ({m..k - 1}) f = real_infsum (from k) f" goal=4
    #[8] real_infsum (from m) f - sum ({m..k - 1}) f = real_infsum (from k) f
  ← rewrite_goal_with_prev goal=8 facts=[6]
    #[9] sum ({m..k - 1}) f + real_infsum (from k) f - sum ({m..k - 1}) f = real_infsum (from k) f
  real_norm goal=9
    #[10] sum ({m..k - 1}) f + real_infsum (from k) f - sum ({m..k - 1}) f = real_infsum (from k) f
  ← rewrite_goal_with_prev goal=4 facts=[8]
qed

theorem alt_sign_upper_bound
  fixes f :: nat => real, k :: nat, m :: nat
  prop (!n. abs (f (n + 1)) <= abs (f n) & f (n + 1) * f n <= 0) --> tendsto_real f 0 sequentially --> m < k --> real_infsum (from m) f <= sum ({m..k - 1}) f + abs (f k)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0
    #[2] tendsto_real f 0 sequentially
    #[3] m < k
    #[4] real_infsum (from m) f ≤ sum ({m..k - 1}) f + abs (f k)
  → apply_forward_step alt_sign_abs_bound goal=4 facts=[1,2,3]
    #[5] abs (real_infsum (from m) f - sum ({m..k - 1}) f) ≤ abs (f k)
  cut "!a::real. !b. !c. abs (a -b) <= c --> a <= b + c" goal=4
    #[6] ∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ a ≤ b + c
  ← z3 goal=6
    #[7] ∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ a ≤ b + c
  ← apply_prev goal=4 facts=[7]
qed

theorem alt_sign_lower_bound
  fixes f :: nat => real, k :: nat, m :: nat
  prop (!n. abs (f (n + 1)) <= abs (f n) & f (n + 1) * f n <= 0) --> tendsto_real f 0 sequentially --> m < k --> sum ({m..k - 1}) f - abs (f k) <= real_infsum (from m) f
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀n. abs (f (n + 1)) ≤ abs (f n) ∧ f (n + 1) * f n ≤ 0
    #[2] tendsto_real f 0 sequentially
    #[3] m < k
    #[4] sum ({m..k - 1}) f - abs (f k) ≤ real_infsum (from m) f
  → apply_forward_step alt_sign_abs_bound goal=4 facts=[1,2,3]
    #[5] abs (real_infsum (from m) f - sum ({m..k - 1}) f) ≤ abs (f k)
  cut "∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ b -c ≤ a" goal=4
    #[6] ∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ b - c ≤ a
  ← z3 goal=6
    #[7] ∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ b - c ≤ a
  ← apply_prev goal=4 facts=[7]
qed

theorem integral_uniform_limit
  fixes a :: real, b :: real, f :: nat => real => real, g :: real => real, s :: nat => real
  prop (!e. 0 < e --> (?N. !n. !x. N <= n --> x Mem real_closed_interval a b --> abs (f n x - g x) < e)) --> (!n. has_real_integral (f n) (s n) (real_closed_interval a b)) --> (?r. has_real_integral g r (real_closed_interval a b) & tendsto_real s r sequentially)
  [hint_rewrite,hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀e. 0 < e ⟶ (∃N. ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (f n x - g x) < e)
    #[2] ∀n. has_real_integral (f n) (s n) (real_closed_interval a b)
    #[3] ∃r. has_real_integral g r (real_closed_interval a b) ∧ tendsto_real s r sequentially
  → apply_forward_step real_integrable_uniform_limit param_a=a param_b=b param_f=g goal=3
    #[4] (∀e. 0 < e ⟶ (∃g1. (∀x. x ∈ real_closed_interval a b ⟶ abs (g x - g1 x) ≤ e) ∧ real_integrable_on g1 (real_closed_interval a b))) ⟶ real_integrable_on g (real_closed_interval a b)
  cut "(∀e. 0 < e ⟶ (∃g1. (∀x. x ∈ real_closed_interval a b ⟶ abs (g x - g1 x) ≤ e) ∧ real_integrable_on g1 (real_closed_interval a b)))" goal=3
    #[5] ∀e. 0 < e ⟶ (∃g1. (∀x. x ∈ real_closed_interval a b ⟶ abs (g x - g1 x) ≤ e) ∧ real_integrable_on g1 (real_closed_interval a b))
  ← introduction e goal=5
    #[6] _VAR e
    #[7] 0 < e
    #[8] ∃g1. (∀x. x ∈ real_closed_interval a b ⟶ abs (g x - g1 x) ≤ e) ∧ real_integrable_on g1 (real_closed_interval a b)
  → apply_fact goal=8 facts=[1,7]
    #[9] ∃N. ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (f n x - g x) < e
  exists_elim N goal=8 facts=[9]
    #[10] _VAR N
    #[11] ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (f n x - g x) < e
    #[12] ∃g1. (∀x. x ∈ real_closed_interval a b ⟶ abs (g x - g1 x) ≤ e) ∧ real_integrable_on g1 (real_closed_interval a b)
  ← inst_exists_goal "f N" goal=12
    #[13] (∀x. x ∈ real_closed_interval a b ⟶ abs (g x - f N x) ≤ e) ∧ real_integrable_on (f N) (real_closed_interval a b)
  ← apply_backward_step conjI goal=13
    #[14] ∀x. x ∈ real_closed_interval a b ⟶ abs (g x - f N x) ≤ e
    #[15] real_integrable_on (f N) (real_closed_interval a b)
  ← introduction x goal=14
    #[16] _VAR x
    #[17] x ∈ real_closed_interval a b
    #[18] abs (g x - f N x) ≤ e
  ← apply_backward_step real_lt_imp_le goal=18
    #[19] abs (g x - f N x) < e
  cut "!a::real. !b. abs (a - b) = abs (b - a)" goal=19
    #[20] ∀a::real. ∀b. abs (a - b) = abs (b - a)
  ← z3 goal=20
    #[21] ∀a::real. ∀b. abs (a - b) = abs (b - a)
  ← rewrite_goal_with_prev goal=19 facts=[21]
    #[22] abs (f N x - g x) < e
  ← apply_prev goal=22 facts=[11]
    #[23] N ≤ N
  ← apply_backward_step less_eq_refl goal=23
    #[24] N ≤ N
  ← rewrite_goal real_integrable_on_def sym=false goal=15
    #[25] ∃y. has_real_integral (f N) y (real_closed_interval a b)
  ← inst_exists_goal "s N" goal=25
    #[26] has_real_integral (f N) (s N) (real_closed_interval a b)
  ← apply_prev goal=26 facts=[2]
    #[27] has_real_integral (f N) (s N) (real_closed_interval a b)
  → apply_fact goal=3 facts=[4,5]
    #[28] real_integrable_on g (real_closed_interval a b)
  → rewrite_fact real_integrable_on_def sym=false goal=3 facts=[28]
    #[29] ∃y. has_real_integral g y (real_closed_interval a b)
  exists_elim r goal=3 facts=[29]
    #[30] _VAR r
    #[31] has_real_integral g r (real_closed_interval a b)
    #[32] ∃r. has_real_integral g r (real_closed_interval a b) ∧ tendsto_real s r sequentially
  ← inst_exists_goal r goal=32
    #[33] has_real_integral g r (real_closed_interval a b) ∧ tendsto_real s r sequentially
  ← apply_backward_step conjI goal=33
    #[34] tendsto_real s r sequentially
  ← rewrite_goal reallim_sequentially sym=false goal=34
    #[35] ∀e. 0 < e ⟶ (∃N. ∀n. N ≤ n ⟶ abs (s n - r) < e)
  ← introduction e goal=35
    #[36] ∃N. ∀n. N ≤ n ⟶ abs (s n - r) < e
  ← cases "b <= a" goal=36
    #[37] b ≤ a ⟶ (∃N. ∀n. N ≤ n ⟶ abs (s n - r) < e)
    #[38] ¬(b ≤ a) ⟶ (∃N. ∀n. N ≤ n ⟶ abs (s n - r) < e)
  ← introduction goal=37
    #[39] b ≤ a
    #[40] ∃N. ∀n. N ≤ n ⟶ abs (s n - r) < e
  ← inst_exists_goal "(0::nat)" goal=40
    #[41] ∀n. 0 ≤ n ⟶ abs (s n - r) < e
  ← introduction n goal=41
    #[42] _VAR n
    #[43] 0 ≤ n
    #[44] abs (s n - r) < e
  → forall_elim n goal=44 facts=[2]
    #[45] has_real_integral (f n) (s n) (real_closed_interval a b)
  → apply_forward_step has_real_integral_null_eq param_f="" param_i="" goal=44 facts=[39]
    #[46] ∀f. ∀i. has_real_integral f i (real_closed_interval a b) ⟷ i = 0
  → rewrite_fact_with_prev goal=44 facts=[46,45]
    #[47] s n = 0
  → rewrite_fact_with_prev goal=44 facts=[46,31]
    #[48] r = 0
  ← z3 goal=44 facts=[47,48,7]
    #[49] abs (s n - r) < e
  ← introduction goal=38
    #[50] ¬(b ≤ a)
    #[51] ∃N. ∀n. N ≤ n ⟶ abs (s n - r) < e
  → forall_elim "(e/2)/(b-a)" goal=51 facts=[1]
    #[52] 0 < e / 2 / (b - a) ⟶ (∃N. ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (f n x - g x) < e / 2 / (b - a))
  cut "0 < e / 2 / (b - a)" goal=51 facts=[52]
    #[53] 0 < e / 2 / (b - a)
  ← z3 goal=53 facts=[50,7]
    #[54] 0 < e / 2 / (b - a)
  → apply_fact goal=51 facts=[52,54]
    #[55] ∃N. ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (f n x - g x) < e / 2 / (b - a)
  exists_elim N goal=51 facts=[55]
    #[56] ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (f n x - g x) < e / 2 / (b - a)
    #[57] ∃N. ∀n. N ≤ n ⟶ abs (s n - r) < e
  ← inst_exists_goal N goal=57
    #[58] ∀n. N ≤ n ⟶ abs (s n - r) < e
  ← introduction n goal=58
    #[59] N ≤ n
    #[60] abs (s n - r) < e
  → apply_fact goal=60 facts=[56,59]
    #[61] ∀x. x ∈ real_closed_interval a b ⟶ abs (f n x - g x) < e / 2 / (b - a)
  ← apply_backward_step real_let_trans param_y=e/2 goal=60
    #[62] abs (s n - r) ≤ e / 2
    #[63] e / 2 < e
  cut "e / 2 = ((e / 2) / (b - a)) * (b - a)" goal=62
    #[64] e / 2 = e / 2 / (b - a) * (b - a)
  ← z3 goal=64 facts=[50]
    #[65] e / 2 = e / 2 / (b - a) * (b - a)
  ← rewrite_goal_with_prev goal=62 facts=[65]
    #[66] abs (s n - r) ≤ e / 2 / (b - a) * (b - a)
  ← apply_backward_step has_real_integral_bound param_f="(%x. f n x - (g x))" goal=66
    #[67] 0 ≤ e / 2 / (b - a)
    #[68] a ≤ b
    #[69] has_real_integral (λx. f n x - g x) (s n - r) (real_closed_interval a b)
    #[70] ∀x. x ∈ real_closed_interval a b ⟶ abs (f n x - g x) ≤ e / 2 / (b - a)
  ← z3 goal=67 facts=[7,50]
    #[71] 0 ≤ e / 2 / (b - a)
  ← z3 goal=68 facts=[50]
    #[72] a ≤ b
  ← apply_backward_step has_real_integral_sub goal=69
    #[73] has_real_integral (f n) (s n) (real_closed_interval a b)
  ← apply_prev goal=73 facts=[2]
  ← introduction x goal=70
    #[74] abs (f n x - g x) ≤ e / 2 / (b - a)
  → apply_fact goal=74 facts=[61,17]
    #[75] abs (f n x - g x) < e / 2 / (b - a)
  ← apply_backward_step real_lt_imp_le goal=74
  ← z3 goal=63 facts=[7]
    #[76] e / 2 < e
qed

theorem integral_series
  fixes a :: real, b :: real, f :: nat => real => real, g :: real => real, r :: nat => real, s :: nat set
  prop (!e. 0 < e --> (?N. !n. !x. N <= n --> x Mem real_closed_interval a b --> abs (sum (s Int {0..n}) (%i. f i x) - g x) < e)) --> (!n. has_real_integral (f n) (r n) (real_closed_interval a b)) --> (?v. has_real_integral g v (real_closed_interval a b) & real_sums r v s)
proof
  ← introduction goal=0
    #[1] ∀e. 0 < e ⟶ (∃N. ∀n. ∀x. N ≤ n ⟶ x ∈ real_closed_interval a b ⟶ abs (sum (s ∩ {0..n}) (λi. f i x) - g x) < e)
    #[2] ∀n. has_real_integral (f n) (r n) (real_closed_interval a b)
    #[3] ∃v. has_real_integral g v (real_closed_interval a b) ∧ real_sums r v s
  ← rewrite_goal real_sums_def sym=false goal=3
    #[4] ∃v. has_real_integral g v (real_closed_interval a b) ∧ tendsto_real (λn. sum (s ∩ {0..n}) r) v sequentially
  ← apply_backward_step integral_uniform_limit param_f="(%n. %x. sum (s ∩ {0..n}) (%i. f i x))" goal=4
    #[5] ∀n. has_real_integral (λx. sum (s ∩ {0..n}) (λi. f i x)) (sum (s ∩ {0..n}) r) (real_closed_interval a b)
  ← introduction n goal=5
    #[6] _VAR n
    #[7] has_real_integral (λx. sum (s ∩ {0..n}) (λi. f i x)) (sum (s ∩ {0..n}) r) (real_closed_interval a b)
  ← apply_backward_step has_real_integral_sum goal=7
    #[8] finite (s ∩ {0..n})
    #[9] ∀i. i ∈ s ∩ {0..n} ⟶ has_real_integral (f i) (r i) (real_closed_interval a b)
  ← apply_backward_step finite_inter_natseg goal=8
    #[10] finite (s ∩ {0..n})
  ← introduction a1 goal=9
    #[11] _VAR a1
    #[12] a1 ∈ s ∩ {0..n}
    #[13] has_real_integral (f a1) (r a1) (real_closed_interval a b)
  ← apply_prev goal=13 facts=[2]
    #[14] has_real_integral (f a1) (r a1) (real_closed_interval a b)
qed

theorem power_series_uniform
  fixes a :: nat => real, s :: nat set, t :: real, y :: real
  prop real_summable s (%i. a i * y ^ i) --> abs t < abs y --> (!e. 0 < e --> (?N. !n. !x. N <= n --> x Mem real_closed_interval (-(abs t)) (abs t) --> abs (sum (s Int {0..n}) (%i. a i * x ^ i) - real_infsum s (%i. a i * x ^ i)) < e))
  [hint_backward,hint_backward1]

theorem has_real_integral_pow_pos
  fixes a :: real, n :: nat
  prop 0 <= a --> has_real_integral (%x. x ^ n) (a ^ (n + 1) / of_nat (n + 1)) (real_closed_interval 0 a)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 ≤ a
    #[2] has_real_integral (λx. x ^ n) (a ^ (n + 1) / of_nat (n + 1)) (real_closed_interval 0 a)
