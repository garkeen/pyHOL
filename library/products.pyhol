theorem nproduct_restrict
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ nproduct s (λi. if i ∈ s then f i else 1) = nproduct s f
  [hint_backward]
  proof
    1: apply_backward_step nproduct_eq
    1: introduction x
    1.2: rewrite_goal if_P @1.1 sym=false
  qed

theorem nproduct_restrict_set
  fixes P :: 'a ⇒ bool, f :: 'a ⇒ nat, s :: 'a set
  prop nproduct ({i. i ∈ s ∧ P i}) f = nproduct s (λi. if P i then f i else 1)
  [hint_rewrite]
