  qed

theorem nproduct_eq_natseg
  fixes f :: nat ⇒ nat, g :: nat ⇒ nat, m :: nat, n :: nat
  prop (∀i. m ≤ i ⟶ i ≤ n ⟶ f i = g i) ⟶ nproduct ({m..n}) f = nproduct ({m..n}) g
  [hint_backward]
  proof
    1: apply_backward_step nproduct_eq
    1: introduction i
    1.2: rewrite_fact member_natseg @1.1 sym=false
    1.3: apply_prev @0
    1.3: apply_backward_step conjD1 @1.2
    1.4: apply_backward_step conjD2 @1.2
  qed

theorem nproduct_eq_0
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ nproduct s f = 0 ⟷ (∃x. x ∈ s ∧ f x = 0)
  [hint_backward]
  proof
    1: apply_backward_step finite_induct_strong @0
    1: rewrite_goal nproduct_empty sym=false
    1: apply_backward_step iffI
    1: introduction
    1.1: z3 @1.0
    2: introduction
    2.1: exists_elim x @2.0
    2.3: apply_forward_step conjD1 @2.2
    2.4: apply_resolve_step member_empty @2.3
    5: introduction x,s
    5.4: apply_forward_step nproduct_insert @0 param_f=f param_x=x
    5.5: rewrite_fact if_not_P @5.4,5.3 sym=false
    5.6: rewrite_goal_with_prev @5.5
    5.6: rewrite_goal mult_eq_0 sym=false
    5.6: rewrite_goal_with_prev @5.2
    5.6: rewrite_goal member_insert sym=false
    5.6: z3
  qed

theorem nproduct_eq_0_natseg
  fixes f :: nat ⇒ nat, m :: nat, n :: nat
  prop nproduct ({m..n}) f = 0 ⟷ (∃x. m ≤ x ∧ x ≤ n ∧ f x = 0)
