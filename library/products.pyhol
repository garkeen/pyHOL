theory products
imports sums
description "Products of natural numbers and real numbers."

def nproduct :: 'a set ⇒ ('a ⇒ nat) ⇒ nat = (nproduct::'a set ⇒ ('a ⇒ nat) ⇒ nat) = iterate times [hint_rewrite]

theorem neutral_nat_mul
  prop neutral times = (1::nat)
  [hint_rewrite]
  proof
    0: rewrite_goal neutral_def sym=false
    0: apply_forward_step theI param_P="(%x::nat. ∀y. x * y = y ∧ y * x = y)" param_a="(1::nat)"
    1: cut "(∀y::nat. 1 * y = y ∧ y * 1 = y)" @0
    1: z3
    2: apply_fact @0,1
    3: cut "(∀x::nat. (∀y. x * y = y ∧ y * x = y) ⟶ x = 1)" @2
    3: z3
    4: apply_fact @2,3
    5: apply_prev @3
  qed

theorem monoidal_nat_mul
  prop monoidal (times::nat ⇒ nat ⇒ nat)
  [hint_backward]
  proof
    0: rewrite_goal monoidal_def sym=false
    0: apply_backward_step conjI
    0: introduction x,y
    0.2: apply_backward_step mult_comm
    1: apply_backward_step conjI
    1: introduction x,y,z
    1.3: rewrite_goal mult_assoc sym=false
    2: introduction x
    2.1: rewrite_goal neutral_nat_mul sym=false
    2.1: rewrite_goal mult_1_left sym=false
  qed

theorem nproduct_empty
  fixes f :: 'a ⇒ nat
  prop nproduct ∅ f = 1
  [hint_rewrite]
  proof
    0: rewrite_goal nproduct_def sym=false
    0: rewrite_goal neutral_nat_mul sym=true
    0: apply_backward_step iterate_empty
    0: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_insert
  fixes f :: 'a ⇒ nat, s :: 'a set, x :: 'a
  prop finite s ⟶ nproduct (insert x s) f = (if x ∈ s then nproduct s f else f x * nproduct s f)
  [hint_backward]
  proof
    1: rewrite_goal nproduct_def sym=false
    1: apply_backward_step iterate_insert
    1: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_support
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop nproduct (support times f s) f = nproduct s f
  [hint_rewrite]
  proof
    0: rewrite_goal nproduct_def sym=false
    0: rewrite_goal iterate_support sym=false
  qed

theorem nproduct_union
  fixes f :: 'a ⇒ nat, s :: 'a set, t :: 'a set
  prop finite s ⟶ finite t ⟶ disjoint s t ⟶ nproduct (s ∪ t) f = nproduct s f * nproduct t f
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal nproduct_def sym=false
    3: apply_backward_step iterate_union
    3: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_image
  fixes f :: 'a ⇒ 'b, g :: 'b ⇒ nat, s :: 'a set
  prop (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ f x = f y ⟶ x = y) ⟶ nproduct (image f s) g = nproduct s (g ∘ f)
  [hint_backward]
  proof
    1: rewrite_goal nproduct_def sym=false
    1: apply_backward_step iterate_image
    1: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_injection
  fixes f :: 'a ⇒ nat, p :: 'a ⇒ 'a, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ p x ∈ s) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ p x = p y ⟶ x = y) ⟶ nproduct s (f ∘ p) = nproduct s f
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal nproduct_def sym=false
    3: apply_backward_step iterate_injection
    3: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_add_split
  fixes f :: nat ⇒ nat, m :: nat, n :: nat, p :: nat
  prop m ≤ n + 1 ⟶ nproduct ({m..n + p}) f = nproduct ({m..n}) f * nproduct ({n + 1..n + p}) f
  [hint_backward]
  proof
    1: apply_forward_step natseg_add_split @0 param_p=p
    2: rewrite_goal_with_prev @1
    2: apply_backward_step nproduct_union
    2: apply_backward_step finite_natseg
    3: apply_backward_step finite_natseg
    4: rewrite_goal disjoint_natseg sym=false
    4: apply_backward_step disjI1
    4: z3
  qed

theorem nproduct_pos_lt
  fixes f :: 'a ⇒ nat, p :: 'a ⇒ 'a, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ 0 < f x) ⟶ 0 < nproduct s f
  [hint_backward,hint_backward1]
  proof
    2: revert_intro @1
    1: apply_backward_step finite_induct_strong @0
    1: introduction
    1.1: rewrite_goal nproduct_empty sym=false
    1.1: z3
    2: introduction x,s
    2.5: apply_forward_step nproduct_insert @0 param_f=f param_x=x
    2.6: rewrite_fact if_not_P @2.5,2.3 sym=false
    2.7: rewrite_goal_with_prev @2.6
    2.7: rewrite_goal lt_mult sym=false
    2.7: apply_backward_step conjI
    2.7: apply_prev @2.4
    2.7: rewrite_goal member_insert sym=false
    2.7: apply_backward_step disjI1
    2.7: apply_backward_step eq_refl
    2.11: apply_prev @2.2
    2.11: introduction x1
    2.11.2: apply_prev @2.4
    2.11.2: rewrite_goal member_insert sym=false
    2.11.2: apply_backward_step disjI2
  qed

theorem nproduct_pos_lt_natseg
  fixes f :: nat ⇒ nat, m :: nat, n :: nat
  prop (∀x. m ≤ x ⟶ x ≤ n ⟶ 0 < f x) ⟶ 0 < nproduct ({m..n}) f
  [hint_backward]
  proof
    1: apply_backward_step nproduct_pos_lt
    1: apply_backward_step finite_natseg
    2: introduction x
    2.2: rewrite_fact member_natseg @2.1 sym=false
    2.3: apply_forward_step conjD1 @2.2
    2.4: apply_forward_step conjD2 @2.2
    2.5: apply_prev @0
  qed

theorem nproduct_offset
  fixes f :: nat ⇒ nat, m :: nat, n :: nat, p :: nat
  prop nproduct ({m + p..n + p}) f = nproduct ({m..n}) (λi. f (i + p))
  [hint_rewrite]
  proof
    0: rewrite_goal natseg_offset_image sym=false
    0: apply_forward_step nproduct_image param_f="(λi. i + p)" param_g=f param_s={m..n}
    1: rewrite_fact comp_fun_def @0 sym=false
    2: apply_prev @1
    2: introduction x,y
    2.5: apply_backward_step add_cancel_right @2.4
  qed

theorem nproduct_sing
  fixes f :: 'a ⇒ nat, x :: 'a
  prop nproduct ({x}) f = f x
  [hint_rewrite]
  proof
    0: apply_forward_step nproduct_insert param_f=f param_s="({}::'a set)" param_x=x
    1: cut "finite (∅::'a set)"
    1: apply_backward_step finite_empty
    2: apply_fact @0,1
    3: cut "~(x ∈ ∅)"
    3: apply_backward_step member_empty
    4: rewrite_fact if_not_P @2,3 sym=false
    5: rewrite_fact nproduct_empty @4 sym=false
    6: rewrite_fact mult_1_right @5 sym=false
  qed

theorem nproduct_sing_natseg
  fixes f :: nat ⇒ nat, n :: nat
  prop nproduct ({n..n}) f = f n
  [hint_rewrite]
  proof
    0: rewrite_goal natseg_sing sym=false
    0: rewrite_goal nproduct_sing sym=false
  qed

theorem nproduct_0_natseg
  fixes f :: nat ⇒ nat, m :: nat
  prop nproduct ({m..0}) f = (if m = 0 then f 0 else 1)
  [hint_rewrite]
  proof
    0: rewrite_goal natseg_0 sym=false
    0: cases "m = 0 "
    0: introduction
    0.1: rewrite_goal if_P @0.0 sym=false
    0.1: rewrite_goal nproduct_sing sym=false
    1: introduction
    1.1: rewrite_goal if_not_P @1.0 sym=false
    1.1: rewrite_goal nproduct_empty sym=false
  qed

theorem nproduct_Suc_natseg
  fixes f :: nat ⇒ nat, m :: nat, n :: nat
  prop nproduct ({m..Suc n}) f = (if m ≤ Suc n then nproduct ({m..n}) f * f (Suc n) else nproduct ({m..n}) f)
  [hint_rewrite]
  proof
    0: rewrite_goal natseg_Suc sym=false
    0: cases " m ≤ Suc n"
    0: introduction
    0.1: rewrite_goal if_P @0.0 sym=false
    0.1: cut "finite {m..n}"
    0.1: apply_backward_step finite_natseg
    0.2: apply_forward_step nproduct_insert @0.1 param_f=f param_x="Suc n"
    0.3: cut "~(Suc n ∈ {m..n})"
    0.3: rewrite_goal member_natseg sym=false
    0.3: rewrite_goal lesseq_Suc_less sym=false
    0.3: rewrite_goal de_morgan_thm1 sym=false
    0.3: apply_backward_step disjI2
    0.3: rewrite_goal not_lt sym=false
    0.3: apply_backward_step less_eq_refl
    0.9: rewrite_fact if_not_P @0.2,0.8 sym=false
    0.10: rewrite_goal_with_prev @0.9
    0.10: apply_backward_step mult_comm
    1: introduction
    1.1: rewrite_goal if_not_P @1.0 sym=false
  qed

theorem nproduct_eq
  fixes f :: 'a ⇒ nat, g :: 'a ⇒ nat, s :: 'a set
  prop (∀x. x ∈ s ⟶ f x = g x) ⟶ nproduct s f = nproduct s g
  [hint_backward]
  proof
    1: rewrite_goal nproduct_def sym=false
    1: apply_backward_step iterate_eq
