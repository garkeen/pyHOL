theorem nproduct_univ
  fixes f :: 'a ⇒ nat, s :: 'a set
  prop support times f univ ⊆ s ⟶ nproduct s f = nproduct univ f
  [hint_backward]
  proof
    1: rewrite_goal nproduct_def sym=false
    1: apply_backward_step iterate_univ
    1: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_pair
  fixes f :: nat ⇒ nat, m :: nat, n :: nat
  prop nproduct ({2 * m..2 * n + 1}) f = nproduct ({m..n}) (λi. f (2 * i) * f (2 * i + 1))
  [hint_rewrite]
  proof
    0: rewrite_goal nproduct_def sym=false
    0: apply_backward_step iterate_pair
    0: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_reflect
  fixes m :: nat, n :: nat, x :: nat ⇒ nat
  prop nproduct ({m..n}) x = (if n < m then 1 else nproduct ({0..n - m}) (λi. x (n - i)))
  [hint_rewrite]
  proof
    0: rewrite_goal nproduct_def sym=false
    0: rewrite_goal neutral_nat_mul sym=true
    0: apply_backward_step iterate_reflect
    0: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_delete
  fixes a :: 'a, f :: 'a ⇒ nat, s :: 'a set
  prop finite s ⟶ a ∈ s ⟶ f a * nproduct (delete s a) f = nproduct s f
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal nproduct_def sym=false
    2: apply_backward_step iterate_delete
    2: apply_backward_step monoidal_nat_mul
  qed

theorem nproduct_fact
  fixes n :: nat
  prop nproduct ({1..n}) (λm. m) = fact n
  [hint_rewrite]
  proof
    0: induction n nat_induct
    0: rewrite_goal fact_def_1 sym=false
    0: apply_backward_step nproduct_eq_1_natseg
    0: z3
    3: introduction n
    3.2: rewrite_goal nproduct_Suc_natseg sym=false
    3.2: cut "1 ≤ Suc n"
    3.2: apply_backward_step le_1_2
    3.2: apply_backward_step ineq_sym
    3.2: apply_backward_step nat_zero_Suc_neq
    3.5: rewrite_goal if_P @3.4 sym=false
    3.5: rewrite_goal_with_prev @3.1
    3.5: rewrite_goal fact_def_2 sym=false
    3.5: apply_backward_step mult_comm
  qed

theorem nproduct_delta
  fixes a :: 'a, b :: nat, s :: 'a set
  prop nproduct s (λx. if x = a then b else 1) = (if a ∈ s then b else 1)
  [hint_rewrite]
  proof
    0: rewrite_goal nproduct_def sym=false
    0: rewrite_goal neutral_nat_mul sym=true
    0: apply_backward_step iterate_delta
    0: apply_backward_step monoidal_nat_mul
  qed

def iproduct :: 'a set ⇒ ('a ⇒ int) ⇒ int = (iproduct::'a set ⇒ ('a ⇒ int) ⇒ int) = iterate times [hint_rewrite]

theorem neutral_int_mul
  prop neutral times = (1::int)
  [hint_rewrite]
  proof
    0: rewrite_goal neutral_def sym=false
    0: apply_forward_step theI param_P="(%x::int. ∀y. x * y = y ∧ y * x = y)" param_a="(1::int)"
    1: cut "(∀y::int. 1 * y = y ∧ y * 1 = y)"
    1: z3
    2: apply_fact @0,1
    3: cut "(∀x::int. (∀y. x * y = y ∧ y * x = y) ⟶ x = 1)"
    3: z3
    4: apply_fact @2,3
    5: apply_prev @3
  qed

theorem monoidal_int_mul
  prop monoidal (times::int ⇒ int ⇒ int)
  [hint_backward]
  proof
    0: rewrite_goal monoidal_def sym=false
    0: apply_backward_step conjI
    0: z3
    1: apply_backward_step conjI
    1: z3
    2: rewrite_goal neutral_int_mul sym=false
    2: z3
  qed

theorem iproduct_empty
  fixes f :: 'a ⇒ int
  prop iproduct ∅ f = 1
  [hint_rewrite]
  proof
    0: rewrite_goal iproduct_def sym=false
    0: rewrite_goal neutral_int_mul sym=true
    0: apply_backward_step iterate_empty
    0: apply_backward_step monoidal_int_mul
  qed

theorem iproduct_insert
  fixes f :: 'a ⇒ int, s :: 'a set, x :: 'a
  prop finite s ⟶ iproduct (insert x s) f = (if x ∈ s then iproduct s f else f x * iproduct s f)
  [hint_backward]
  proof
    1: rewrite_goal iproduct_def sym=false
    1: apply_backward_step iterate_insert
    1: apply_backward_step monoidal_int_mul
  qed

def product :: 'a set ⇒ ('a ⇒ real) ⇒ real = (product::'a set ⇒ ('a ⇒ real) ⇒ real) = iterate times [hint_rewrite]

theorem product_empty
  fixes f :: 'a ⇒ real
  prop product ∅ f = 1
  [hint_rewrite]
  proof
    0: rewrite_goal product_def sym=false
    0: rewrite_goal neutral_real_mul sym=true
    0: apply_backward_step iterate_empty
    0: apply_backward_step monoidal_real_mul
  qed

theorem product_insert
  fixes f :: 'a ⇒ real, s :: 'a set, x :: 'a
  prop finite s ⟶ product (insert x s) f = (if x ∈ s then product s f else f x * product s f)
  [hint_backward]
  proof
    1: rewrite_goal product_def sym=false
    1: apply_backward_step iterate_insert
    1: apply_backward_step monoidal_real_mul
  qed

theorem product_support
  fixes f :: 'a ⇒ real, s :: 'a set
  prop product (support times f s) f = product s f
  [hint_rewrite]
  proof
    0: rewrite_goal product_def sym=false
    0: rewrite_goal iterate_support sym=false
  qed

theorem product_union
  fixes f :: 'a ⇒ real, s :: 'a set, t :: 'a set
  prop finite s ⟶ finite t ⟶ disjoint s t ⟶ product (s ∪ t) f = product s f * product t f
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal product_def sym=false
    3: apply_backward_step iterate_union
    3: apply_backward_step monoidal_real_mul
  qed

theorem product_image
  fixes f :: 'a ⇒ 'b, g :: 'b ⇒ real, s :: 'a set
  prop (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ f x = f y ⟶ x = y) ⟶ product (image f s) g = product s (g ∘ f)
  [hint_backward]
  proof
    1: rewrite_goal product_def sym=false
    1: apply_backward_step iterate_image
    1: apply_backward_step monoidal_real_mul
  qed

theorem product_injection
  fixes f :: 'a ⇒ real, p :: 'a ⇒ 'a, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ p x ∈ s) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ p x = p y ⟶ x = y) ⟶ product s (f ∘ p) = product s f
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal product_def sym=false
    3: apply_backward_step iterate_injection
    3: apply_backward_step monoidal_real_mul
  qed

theorem product_add_split
  fixes f :: nat ⇒ real, m :: nat, n :: nat, p :: nat
  prop m ≤ n + 1 ⟶ product ({m..n + p}) f = product ({m..n}) f * product ({n + 1..n + p}) f
  [hint_backward]
  proof
    1: apply_forward_step natseg_add_split @0 param_p=p
    2: rewrite_goal_with_prev @1
    2: apply_backward_step product_union
    2: apply_backward_step finite_natseg
    3: apply_backward_step finite_natseg
    4: rewrite_goal disjoint_natseg sym=false
    4: z3
  qed

theorem product_pos_le
  fixes f :: 'a ⇒ real, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ 0 ≤ f x) ⟶ 0 ≤ product s f
  [hint_backward,hint_backward1]
  proof
    2: revert_intro @1
    1: apply_backward_step finite_induct_strong @0
    1: introduction
    1.1: rewrite_goal product_empty sym=false
    1.1: z3
    2: introduction a,s
    2.5: apply_forward_step product_insert @0 param_f=f param_x=a
    2.6: rewrite_fact if_not_P @2.5,2.3 sym=false
    2.7: rewrite_goal_with_prev @2.6
    2.7: apply_backward_step real_le_mul
    2.7: apply_prev @2.4
    2.7: z3
    2.9: apply_prev @2.2
    2.9: introduction x
    2.9.2: apply_prev @2.4
    2.9.2: z3 @2.9.1
  qed

theorem product_pos_le_natseg
  fixes f :: nat ⇒ real, m :: nat, n :: nat
  prop (∀x. m ≤ x ⟶ x ≤ n ⟶ 0 ≤ f x) ⟶ 0 ≤ product ({m..n}) f
  [hint_backward]
  proof
    1: apply_backward_step product_pos_le
    1: apply_backward_step finite_natseg
    2: rewrite_goal member_natseg sym=false
    2: z3 @0
  qed

theorem product_pos_lt
  fixes f :: 'a ⇒ real, s :: 'a set
  prop finite s ⟶ (∀x. x ∈ s ⟶ 0 < f x) ⟶ 0 < product s f
  [hint_backward,hint_backward1]
  proof
    2: revert_intro @1
    1: apply_backward_step finite_induct_strong @0
    1: introduction
    1.1: rewrite_goal product_empty sym=false
    1.1: z3
    2: introduction a,s
    2.5: apply_forward_step product_insert @0 param_f=f param_x=a
    2.6: rewrite_fact if_not_P @2.5,2.3 sym=false
    2.7: rewrite_goal_with_prev @2.6
    2.7: apply_backward_step real_lt_mul
    2.7: apply_prev @2.4
    2.7: z3
    2.9: apply_prev @2.2
    2.9: z3 @2.4
  qed

theorem product_pos_lt_natseg
  fixes f :: nat ⇒ real, m :: nat, n :: nat
  prop (∀x. m ≤ x ⟶ x ≤ n ⟶ 0 < f x) ⟶ 0 < product ({m..n}) f
  [hint_backward]
  proof
    1: apply_backward_step product_pos_lt
    1: apply_backward_step finite_natseg
    2: rewrite_goal member_natseg sym=false
    2: z3 @0
  qed
