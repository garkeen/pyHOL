    5: cut "~(m ∈ {m + 1..n})"
    5: rewrite_goal member_natseg sym=false
    5: rewrite_goal de_morgan_thm1 sym=false
    5: apply_backward_step disjI1
    5: z3
    9: rewrite_fact if_not_P @4,8 sym=false
  qed

