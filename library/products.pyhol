    2.7: apply_forward_step nproduct_insert @0 param_f=g param_x=x
    2.8: rewrite_fact if_not_P @2.7,2.3 sym=false
    2.9: rewrite_goal_with_prev @2.8
    2.9: rewrite_goal_with_prev @2.6
    2.9: apply_backward_step le_mult2
    2.9: rewrite_fact member_insert @2.4 sym=false
    2.10: apply_prev @2.9
    2.10: apply_backward_step disjI1
    2.10: apply_backward_step eq_refl
    2.13: apply_prev @2.2
    2.13: introduction x1
    2.13.2: apply_prev @2.9
