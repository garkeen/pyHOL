theorem nproduct_mul_gen
  fixes f :: 'a ⇒ nat, g :: 'a ⇒ nat, s :: 'a set
  prop finite ({x. x ∈ s ∧ ¬(f x = 1)}) ⟶ finite ({x. x ∈ s ∧ ¬(g x = 1)}) ⟶ nproduct s (λx. f x * g x) = nproduct s f * nproduct s g
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal nproduct_def sym=false
    2: apply_backward_step iterate_op_gen
