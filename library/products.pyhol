    4.5: rewrite_fact if_not_P @4.4,4.3 sym=false
    4.6: apply_forward_step card_insert @0 param_x=x
    4.7: rewrite_fact if_not_P @4.6,4.3 sym=false
    4.8: rewrite_goal_with_prev @4.7
    4.8: rewrite_goal nat_nat_power_def_2 sym=false
    4.8: rewrite_fact_with_prev @4.2,4.5
  qed

