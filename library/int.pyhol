theorem int_gcd
  fixes c :: int, d :: int, m :: int, n :: int, x :: int, y :: int
  prop c > 0 ⟶ 0 ≤ x + d ⟶ c * y = x ⟶ c * n + d < 0 ⟶ c * (n + 1) + d > 0 ⟶ 0 ≤ 1 * y + -(n + 1)
  proof
    5: z3 @0,1,2,3,4
  qed

