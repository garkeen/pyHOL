theory int
imports list
description "integers"

type int

const of_nat :: nat ⇒ int

def zero :: int = (0::int) = of_nat 0

def one :: int = (1::int) = of_nat 1

const plus :: int ⇒ int ⇒ int

def int_divides :: int ⇒ int ⇒ bool = int_divides p q ⟷ (∃m. m * p = q)

const uminus :: 'a ⇒ 'a

def abs :: 'a ⇒ 'a = abs n = (if 0 ≤ n then n else -n) [hint_rewrite]

const less_eq :: int ⇒ int ⇒ bool

const less :: int ⇒ int ⇒ bool

