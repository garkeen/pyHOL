theory metric
imports misc
description "Formalization of general topological and metric spaces. Refer to metric.ml from HOL Light."

type net 'a

const within :: 'a net ⇒ 'a set ⇒ 'a net

theorem net_within_univ
  fixes net :: 'a net
  prop within net univ = net
  [hint_rewrite]

theorem within_within
  fixes net :: 'a net, s :: 'a set, t :: 'a set
  prop within (within net s) t = within net (s Int t)
  [hint_rewrite,hint_rewrite_sym]

const eventually :: ('a ⇒ bool) ⇒ 'a net ⇒ bool

def trivial_limit :: 'a net ⇒ bool = trivial_limit net ⟷ eventually (λx. false) net [hint_rewrite,hint_rewrite_sym]

theorem eventually_within_imp
  fixes P :: 'a => bool, net :: 'a net, s :: 'a set
  prop eventually P (within net s) <--> eventually (%x. x Mem s --> P x) net
  [hint_rewrite]

theorem eventually_imp_within
  fixes P :: 'a => bool, net :: 'a net, s :: 'a set
  prop eventually P net --> eventually P (within net s)
  [hint_backward,hint_forward]

theorem eventually_within_inter_imp
  fixes P :: 'a => bool, net :: 'a net, s :: 'a set, t :: 'a set
  prop eventually P (within net (s Int t)) <--> eventually (%x. x Mem t --> P x) (within net s)
  [hint_rewrite]
proof
  ← rewrite within_within sym=true goal=0
    #[1] eventually P (within (within net s) t) ⟷ eventually (λx. x ∈ t ⟶ P x) (within net s)
  ← rewrite eventually_within_imp sym=false goal=1
    #[2] eventually (λx. x ∈ t ⟶ P x) (within net s) ⟷ eventually (λx. x ∈ s ⟶ x ∈ t ⟶ P x) net
  ← rewrite eventually_within_imp sym=false goal=2
qed

theorem nontrivial_limit_within
  fixes net :: 'a net, s :: 'a set
  prop trivial_limit net --> trivial_limit (within net s)
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] trivial_limit net
    #[2] trivial_limit (within net s)
  ← rewrite trivial_limit_def sym=false goal=2
    #[3] eventually (λx. false) (within net s)
  → rewrite target=fact trivial_limit_def sym=false goal=3 facts=[1]
    #[4] eventually (λx. false) net
  ← rule eventually_imp_within goal=3
qed

theorem eventually_happens
  fixes P :: 'a => bool, net :: 'a net
  prop eventually P net --> trivial_limit net | (?x. P x)
  [hint_backward,hint_forward]

theorem always_eventually
  fixes P :: 'a => bool, net :: 'a net
  prop (!x. P x) --> eventually P net
  [hint_backward]

theorem eventually_mono
  fixes P :: 'a => bool, Q :: 'a => bool, net :: 'a net
  prop (!x. P x --> Q x) --> eventually P net --> eventually Q net
  [hint_backward,hint_backward1]

theorem eventually_and
  fixes P :: 'a => bool, Q :: 'a => bool, net :: 'a net
  prop eventually (%x. P x & Q x) net <--> eventually P net & eventually Q net
  [hint_rewrite]

theorem eventually_mp
  fixes P :: 'a => bool, Q :: 'a => bool, net :: 'a net
  prop eventually (%x. P x --> Q x) net --> eventually P net --> eventually Q net
  [hint_backward,hint_backward1,hint_forward]

theorem eventually_eq_mp
  fixes P :: 'a => bool, Q :: 'a => bool, net :: 'a net
  prop eventually (%x. P x <--> Q x) net --> eventually P net --> eventually Q net
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] eventually (λx. P x ⟷ Q x) net
    #[2] eventually P net
    #[3] eventually Q net
  ← rule eventually_mp param_P=P goal=3
    #[4] eventually (λx. P x ⟶ Q x) net
  ← rule eventually_mp param_P="(λx. P x ⟷ Q x)" goal=4
    #[5] eventually (λx. P x ⟷ Q x ⟶ P x ⟶ Q x) net
  ← rule always_eventually goal=5
    #[6] ∀x. P x ⟷ Q x ⟶ P x ⟶ Q x
  ← z3 goal=6
    #[7] ∀x. P x ⟷ Q x ⟶ P x ⟶ Q x
qed

theorem eventually_iff
  fixes P :: 'a => bool, Q :: 'a => bool, net :: 'a net
  prop eventually (%x. P x <--> Q x) net --> eventually P net <--> eventually Q net
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] eventually (λx. P x ⟷ Q x) net
    #[2] eventually P net ⟷ eventually Q net
  ← rule iffI goal=2
    #[3] eventually P net ⟶ eventually Q net
    #[4] eventually Q net ⟶ eventually P net
  ← intro goal=3
    #[5] eventually P net
    #[6] eventually Q net
  ← rule eventually_eq_mp param_P=P goal=6
  ← intro goal=4
    #[7] eventually Q net
    #[8] eventually P net
  ← rule eventually_eq_mp param_P=Q goal=8
    #[9] eventually (λx. Q x ⟷ P x) net
  ← rewrite eq_sym_eq sym=false goal=9
qed

theorem eventually_true
  fixes net :: 'a net
  prop eventually (%x. true) net <--> true
  [hint_rewrite]

theorem eventually_within_subset
  fixes P :: 'a => bool, net :: 'a net, s :: 'a set, t :: 'a set
  prop eventually P (within net s) --> t Sub s --> eventually P (within net t)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] eventually P (within net s)
    #[2] t ⊆ s
    #[3] eventually P (within net t)
  ← rewrite eventually_within_imp sym=false goal=3
    #[4] eventually (λx. x ∈ t ⟶ P x) net
  → rewrite target=fact eventually_within_imp sym=false goal=4 facts=[1]
    #[5] eventually (λx. x ∈ s ⟶ P x) net
  ← rule eventually_mono param_P="(λx. x ∈ s ⟶ P x)" goal=4
    #[6] ∀x. (x ∈ s ⟶ P x) ⟶ x ∈ t ⟶ P x
  ← z3 goal=6 facts=[2]
    #[7] ∀x. (x ∈ s ⟶ P x) ⟶ x ∈ t ⟶ P x
qed

theorem always_within_eventually
  fixes P :: 'a => bool, net :: 'a net, s :: 'a set
  prop (!x. x Mem s --> P x) --> eventually P (within net s)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ∀x. x ∈ s ⟶ P x
    #[2] eventually P (within net s)
  ← rewrite eventually_within_imp sym=false goal=2
    #[3] eventually (λx. x ∈ s ⟶ P x) net
  ← rule always_eventually goal=3 facts=[1]
qed

theorem not_eventually
  fixes P :: 'a => bool, net :: 'a net
  prop (!x. ~(P x)) --> ~(trivial_limit net) --> ~(eventually P net)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ∀x. ¬(P x)
    #[2] ¬(trivial_limit net)
    #[3] ¬(eventually P net)
  → rewrite target=fact not_exists sym=true goal=3 facts=[1]
    #[4] ¬(∃x. P x)
  → forward conjI goal=3 facts=[4,2]
    #[5] ¬(∃x. P x) ∧ ¬(trivial_limit net)
  ← rule contrapositive goal=3 facts=[5]
    #[6] ¬¬(eventually P net) ⟶ ¬(¬(∃x. P x) ∧ ¬(trivial_limit net))
  ← intro goal=6
    #[7] ¬¬(eventually P net)
    #[8] ¬(¬(∃x. P x) ∧ ¬(trivial_limit net))
  → rewrite target=fact double_neg sym=false goal=8 facts=[7]
    #[9] eventually P net
  → forward eventually_happens goal=8 facts=[9]
    #[10] trivial_limit net ∨ (∃x. P x)
  ← rewrite de_morgan_thm1 sym=false goal=8
    #[11] ¬¬(∃x. P x) ∨ ¬¬(trivial_limit net)
  ← rewrite double_neg sym=false goal=11
    #[12] (∃x. P x) ∨ trivial_limit net
  ← rewrite disj_comm sym=false goal=12
qed

theorem eventually_forall
  fixes P :: 'b => 'a => bool, net :: 'a net, s :: 'b set
  prop finite s --> ~(s = {}) --> eventually (%x. !a. a Mem s --> P a x) net <--> (!a. a Mem s --> eventually (P a) net)
  [hint_backward,hint_backward1,hint_forward]

theorem forall_eventually
  fixes P :: 'b => 'a => bool, net :: 'a net, s :: 'b set
  prop finite s --> ~(s = {}) --> (!a. a Mem s --> eventually (P a) net) <--> eventually (%x. !a. a Mem s --> P a x) net
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] finite s
    #[2] ¬(s = ∅)
    #[3] (∀a. a ∈ s ⟶ eventually (P a) net) ⟷ eventually (λx. ∀a. a ∈ s ⟶ P a x) net
  ← rewrite eq_sym_eq sym=false goal=3
    #[4] eventually (λx. ∀a. a ∈ s ⟶ P a x) net ⟷ (∀a. a ∈ s ⟶ eventually (P a) net)
  ← rule eventually_forall goal=4
qed

theorem eventually_trivial
  fixes P :: 'a => bool, net :: 'a net
  prop trivial_limit net --> eventually P net
  [hint_backward]
proof
  ← intro goal=0
    #[1] trivial_limit net
    #[2] eventually P net
  → rewrite target=fact trivial_limit_def sym=false goal=2 facts=[1]
    #[3] eventually (λx. false) net
  ← rule eventually_mono param_P="(λx::'a. false)" goal=2
    #[4] ∀x. false ⟶ P x
  ← z3 goal=4
    #[5] ∀x. false ⟶ P x
qed

const sequentially :: nat net

theorem eventually_sequentially
  fixes P :: nat => bool
  prop eventually P sequentially <--> (?N. !n. N <= n --> P n)
  [hint_rewrite]

theorem trivial_limit_sequentially
  prop ~(trivial_limit sequentially)
  [hint_backward]
proof
  ← rewrite trivial_limit_def sym=false goal=0
    #[1] ¬(eventually (λx. false) sequentially)
  ← rewrite eventually_sequentially sym=false goal=1
    #[2] ¬(∃N::nat. ∀n. N ≤ n ⟶ false)
  ← z3 goal=2
qed

theorem eventually_happens_sequentially
  fixes P :: nat => bool
  prop eventually P sequentially --> (?n. P n)
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] eventually P sequentially
    #[2] ∃n. P n
  → forward eventually_happens goal=2 facts=[1]
    #[3] trivial_limit sequentially ∨ (∃x. P x)
  ← rule disjE goal=2 facts=[3]
    #[4] trivial_limit sequentially ⟶ (∃n. P n)
    #[5] (∃x. P x) ⟶ (∃n. P n)
  ← intro goal=4
    #[6] trivial_limit sequentially
    #[7] ∃n. P n
  → rewrite target=fact double_neg sym=true goal=7 facts=[6]
    #[8] ¬¬(trivial_limit sequentially)
  ← rule negE_gen goal=7 facts=[8]
    #[9] ¬(trivial_limit sequentially)
  ← rule trivial_limit_sequentially goal=9
    #[10] ¬(trivial_limit sequentially)
qed

theorem eventually_sequentially_within
  fixes P :: nat => bool, k :: nat set
  prop eventually P (within sequentially k) <--> finite k | (?N. !n. n Mem k --> N <= n --> P n)
  [hint_rewrite,hint_rewrite_sym]

theorem trivial_limit_sequentially_within
  fixes k :: nat set
  prop trivial_limit (within sequentially k) <--> finite k
  [hint_rewrite]

theorem eventually_subsequence
  fixes P :: nat ⇒ bool, R :: nat ⇒ nat
  prop (∀m. ∀n. m < n ⟶ R m < R n) ⟶ eventually P sequentially ⟶ eventually (P ∘ R) sequentially
  [hint_backward,hint_backward1]

theorem arch_eventually_lt
  fixes x :: real
  prop eventually (%n. x < of_nat n) sequentially
  [hint_backward]
proof
  → forward real_arch_simple param_x=x+1 goal=0
    #[1] ∃n. x + 1 ≤ of_nat n
  ← rewrite eventually_sequentially sym=false goal=0
    #[2] ∃N. ∀n. N ≤ n ⟶ x < of_nat n
  elim N goal=2 facts=[1]
    #[3] _VAR N
    #[4] x + 1 ≤ of_nat N
    #[5] ∃N. ∀n. N ≤ n ⟶ x < of_nat n
    #[6] eventually (λn. x < of_nat n) sequentially
  ← inst N goal=5
    #[7] ∀n. N ≤ n ⟶ x < of_nat n
  ← intro n goal=7
    #[8] _VAR n
    #[9] N ≤ n
    #[10] x < of_nat n
  → rewrite target=fact real_of_nat_le sym=true goal=10 facts=[9]
    #[11] (of_nat::nat ⇒ real) N ≤ of_nat n
  ← z3 goal=10 facts=[11,4]
qed

theorem arch_eventually_le
  fixes x :: real
  prop eventually (%n. x <= of_nat n) sequentially
  [hint_backward]
proof
  → forward real_arch_simple param_x=x goal=0
    #[1] ∃n. x ≤ of_nat n
  ← rewrite eventually_sequentially sym=false goal=0
    #[2] ∃N. ∀n. N ≤ n ⟶ x ≤ of_nat n
  ← rewrite real_of_nat_le sym=true goal=2
    #[3] ∃N. ∀n. (of_nat::nat ⇒ real) N ≤ of_nat n ⟶ x ≤ of_nat n
  elim N goal=3 facts=[1]
    #[4] _VAR N
    #[5] x ≤ of_nat N
    #[6] ∃N. ∀n. (of_nat::nat ⇒ real) N ≤ of_nat n ⟶ x ≤ of_nat n
    #[7] ∃N. ∀n. N ≤ n ⟶ x ≤ of_nat n
    #[8] eventually (λn. x ≤ of_nat n) sequentially
  ← inst N goal=6
    #[9] ∀n. (of_nat::nat ⇒ real) N ≤ of_nat n ⟶ x ≤ of_nat n
  ← z3 goal=9 facts=[5]
qed

theorem arch_eventually_abs_inv_offset
  fixes a :: real, e :: real
  prop eventually (%n. abs (real_inverse (of_nat n + a)) < e) sequentially <--> 0 < e
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] eventually (λn. abs (real_inverse (of_nat n + a)) < e) sequentially ⟶ 0 < e
    #[2] 0 < e ⟶ eventually (λn. abs (real_inverse (of_nat n + a)) < e) sequentially
  ← intro goal=1
    #[3] eventually (λn. abs (real_inverse (of_nat n + a)) < e) sequentially
    #[4] 0 < e
  → forward eventually_happens goal=4 facts=[3]
    #[5] trivial_limit sequentially ∨ (∃x. abs (real_inverse (of_nat x + a)) < e)
  ← rule disjE goal=4 facts=[5]
    #[6] trivial_limit sequentially ⟶ 0 < e
    #[7] (∃x. abs (real_inverse (of_nat x + a)) < e) ⟶ 0 < e
  ← intro goal=6
    #[8] trivial_limit sequentially
    #[9] 0 < e
  ← rule contrapositive goal=9 facts=[8]
    #[10] ¬(0 < e) ⟶ ¬(trivial_limit sequentially)
  ← intro goal=10
    #[11] ¬(0 < e)
    #[12] ¬(trivial_limit sequentially)
  ← rule trivial_limit_sequentially goal=12
    #[13] ¬(trivial_limit sequentially)
  ← z3 goal=7
    #[14] (∃x. abs (real_inverse (of_nat x + a)) < e) ⟶ 0 < e
  ← intro goal=2
    #[15] 0 < e
    #[16] eventually (λn. abs (real_inverse (of_nat n + a)) < e) sequentially
  ← rule eventually_mono param_P="(λn. max 0 (max (2 * abs a) (2/e)) < of_nat n)" goal=16
    #[17] ∀x. max 0 (max (2 * abs a) (2 / e)) < of_nat x ⟶ abs (real_inverse (of_nat x + a)) < e
    #[18] eventually (λn. max 0 (max (2 * abs a) (2 / e)) < of_nat n) sequentially
  ← intro n goal=17
    #[19] _VAR n
    #[20] max 0 (max (2 * abs a) (2 / e)) < of_nat n
    #[21] abs (real_inverse (of_nat n + a)) < e
  → rewrite target=fact real_max_lt sym=false goal=21 facts=[20]
    #[22] (0::real) < of_nat n ∧ max (2 * abs a) (2 / e) < of_nat n
  ← rule real_let_trans param_y="real_inverse (of_nat n /2)" goal=21
    #[23] abs (real_inverse (of_nat n + a)) ≤ real_inverse (of_nat n / 2)
    #[24] real_inverse (of_nat n / 2) < e
  → forward conjD2 goal=23 facts=[22]
    #[25] max (2 * abs a) (2 / e) < of_nat n
  → rewrite target=fact real_max_lt sym=false goal=23 facts=[25]
    #[26] 2 * abs a < of_nat n ∧ 2 / e < of_nat n
  ← rewrite real_abs_inv sym=false goal=23
    #[27] real_inverse (abs (of_nat n + a)) ≤ real_inverse (of_nat n / 2)
  ← rule real_le_inv2 goal=27
    #[28] 0 < of_nat n / 2
    #[29] of_nat n / 2 ≤ abs (of_nat n + a)
  ← z3 goal=28 facts=[22]
    #[30] 0 < of_nat n / 2
  ← z3 goal=29 facts=[26,15]
  cut "e = real_inverse (real_inverse e)" goal=24
    #[31] e = real_inverse (real_inverse e)
  ← rewrite real_inv_inv sym=false goal=31
    #[32] e = real_inverse (real_inverse e)
  ← rewrite source=prev goal=24 facts=[32]
    #[33] real_inverse (of_nat n / 2) < real_inverse (real_inverse e)
  ← rule real_lt_inv2 goal=33
    #[34] 0 < real_inverse e
    #[35] real_inverse e < of_nat n / 2
  ← rule real_lt_inv goal=34
  ← z3 goal=35 facts=[26,15]
  ← rule arch_eventually_lt goal=18
    #[36] eventually (λn. max 0 (max (2 * abs a) (2 / e)) < of_nat n) sequentially
qed

theorem arch_eventually_inv_offset
  fixes a :: real, e :: real
  prop eventually (%n. real_inverse (of_nat n + a) < e) sequentially <--> 0 < e
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] eventually (λn. real_inverse (of_nat n + a) < e) sequentially ⟶ 0 < e
    #[2] 0 < e ⟶ eventually (λn. real_inverse (of_nat n + a) < e) sequentially
  → forward arch_eventually_lt param_x="abs a" goal=1
    #[3] eventually (λn. abs a < of_nat n) sequentially
  ← intro goal=1
    #[4] eventually (λn. real_inverse (of_nat n + a) < e) sequentially
    #[5] 0 < e
  → forward conjI goal=5 facts=[4,3]
    #[6] eventually (λn. real_inverse (of_nat n + a) < e) sequentially ∧ eventually (λn. abs a < of_nat n) sequentially
  → rewrite target=fact eventually_and sym=true goal=5 facts=[6]
    #[7] eventually (λx. real_inverse (of_nat x + a) < e ∧ abs a < of_nat x) sequentially
  → forward eventually_happens goal=5 facts=[7]
    #[8] trivial_limit sequentially ∨ (∃x. real_inverse (of_nat x + a) < e ∧ abs a < of_nat x)
  ← rule disjE goal=5 facts=[8]
    #[9] trivial_limit sequentially ⟶ 0 < e
    #[10] (∃x. real_inverse (of_nat x + a) < e ∧ abs a < of_nat x) ⟶ 0 < e
  ← intro goal=9
    #[11] trivial_limit sequentially
    #[12] 0 < e
  ← rule contrapositive goal=12 facts=[11]
    #[13] ¬(0 < e) ⟶ ¬(trivial_limit sequentially)
  ← intro goal=13
    #[14] ¬(0 < e)
    #[15] ¬(trivial_limit sequentially)
  ← rule trivial_limit_sequentially goal=15
    #[16] ¬(trivial_limit sequentially)
  ← intro goal=10
    #[17] ∃x. real_inverse (of_nat x + a) < e ∧ abs a < of_nat x
    #[18] 0 < e
  elim n goal=18 facts=[17]
    #[19] _VAR n
    #[20] real_inverse (of_nat n + a) < e ∧ abs a < of_nat n
    #[21] 0 < e
  ← z3 goal=21 facts=[20]
    #[22] 0 < e
  ← intro goal=2
    #[23] 0 < e
    #[24] eventually (λn. real_inverse (of_nat n + a) < e) sequentially
  ← rule eventually_mono param_P="(λn. abs (real_inverse (of_nat n + a)) < e)" goal=24
    #[25] ∀x. abs (real_inverse (of_nat x + a)) < e ⟶ real_inverse (of_nat x + a) < e
    #[26] eventually (λn. abs (real_inverse (of_nat n + a)) < e) sequentially
  ← z3 goal=25
    #[27] ∀x. abs (real_inverse (of_nat x + a)) < e ⟶ real_inverse (of_nat x + a) < e
  ← rewrite arch_eventually_abs_inv_offset sym=false goal=26
qed

theorem arch_eventually_inv1
  fixes e :: real
  prop eventually (%n. real_inverse (of_nat n + 1) < e) sequentially <--> 0 < e
  [hint_rewrite]
proof
  ← rewrite arch_eventually_inv_offset sym=false goal=0
qed

theorem arch_eventually_inv
  fixes e :: real
  prop eventually (%n. real_inverse (of_nat n) < e) sequentially <--> 0 < e
  [hint_rewrite]
proof
  cut "!n. of_nat n = of_nat n + (0::real)" goal=0
    #[1] ∀n. of_nat n = of_nat n + (0::real)
  ← intro n goal=1
    #[2] _VAR n
    #[3] of_nat n = of_nat n + (0::real)
  ← rewrite real_add_rid sym=false goal=3
  ← rewrite source=prev goal=0 facts=[1]
    #[4] eventually (λn. real_inverse (of_nat n + 0) < e) sequentially ⟷ 0 < e
  ← rewrite arch_eventually_inv_offset sym=false goal=4
qed

theorem arch_eventually_pow
  fixes b :: real, x :: real
  prop 1 < x --> eventually (%n. b < x ^ n) sequentially
  [hint_backward]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] eventually (λn. b < x ^ n) sequentially
  ← rewrite eventually_sequentially sym=false goal=2
    #[3] ∃N::nat. ∀n. N ≤ n ⟶ b < x ^ n
  → forward real_arch_pow param_y=b goal=3 facts=[1]
    #[4] ∃n::nat. b < x ^ n
  elim N goal=3 facts=[4]
    #[5] _VAR N
    #[6] b < x ^ N
    #[7] ∃N::nat. ∀n. N ≤ n ⟶ b < x ^ n
    #[8] eventually (λn. b < x ^ n) sequentially
  ← inst N goal=7
    #[9] ∀n. N ≤ n ⟶ b < x ^ n
  ← intro n goal=9
    #[10] _VAR n
    #[11] N ≤ n
    #[12] b < x ^ n
  ← rule real_lte_trans param_y="x ^ N" goal=12
    #[13] x ^ N ≤ x ^ n
  ← rule real_pow_mono goal=13
    #[14] 1 ≤ x
  ← rule real_lt_imp_le goal=14
qed

theorem arch_eventually_pow_inv
  fixes e :: real, x :: real
  prop 1 < e --> abs x < 1 --> eventually (%n. abs (x ^ n) < e) sequentially
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 1 < e
    #[2] abs x < 1
    #[3] eventually (λn. abs (x ^ n) < e) sequentially
  ← cases "x = 0" goal=3
    #[4] x = 0 ⟶ eventually (λn. abs (x ^ n) < e) sequentially
    #[5] ¬(x = 0) ⟶ eventually (λn. abs (x ^ n) < e) sequentially
  ← intro goal=4
    #[6] x = 0
    #[7] eventually (λn. abs (x ^ n) < e) sequentially
  ← rewrite source=prev goal=7 facts=[6]
    #[8] eventually (λn. abs (0 ^ n) < e) sequentially
  ← rewrite real_pow_zero sym=false goal=8
    #[9] eventually (λn. abs (if n = 0 then 1 else 0) < e) sequentially
  ← rewrite eventually_sequentially sym=false goal=9
    #[10] ∃N::nat. ∀n. N ≤ n ⟶ abs (if n = 0 then 1 else 0) < e
  ← inst "(1::nat)" goal=10
    #[11] ∀n::nat. 1 ≤ n ⟶ abs (if n = 0 then 1 else 0) < e
  ← z3 goal=11 facts=[1]
    #[12] ∀n::nat. 1 ≤ n ⟶ abs (if n = 0 then 1 else 0) < e
  ← intro goal=5
    #[13] ¬(x = 0)
    #[14] eventually (λn. abs (x ^ n) < e) sequentially
  → forward arch_eventually_pow param_b="real_inverse e" param_x="real_inverse (abs x)" goal=14
    #[15] 1 < real_inverse (abs x) ⟶ eventually (λn. real_inverse e < real_inverse (abs x) ^ n) sequentially
  cut "1 < real_inverse (abs x)" goal=14
    #[16] 1 < real_inverse (abs x)
  ← z3 goal=16 facts=[13,2]
    #[17] 1 < real_inverse (abs x)
  → forward goal=14 facts=[15,17]
    #[18] eventually (λn. real_inverse e < real_inverse (abs x) ^ n) sequentially
  ← rule eventually_mono param_P="(λn::nat. real_inverse e < real_inverse (abs x) ^ n)" goal=14
    #[19] ∀x1::nat. real_inverse e < real_inverse (abs x) ^ x1 ⟶ abs (x ^ x1) < e
  ← intro n goal=19
    #[20] _VAR n
    #[21] real_inverse e < real_inverse (abs x) ^ n
    #[22] abs (x ^ n) < e
  ← rewrite real_abs_pow sym=false goal=22
    #[23] abs x ^ n < e
  ← rewrite real_inv_inv sym=true goal=23
    #[24] real_inverse (real_inverse (abs x ^ n)) < real_inverse (real_inverse e)
  ← rule real_lt_inv2 goal=24
    #[25] 0 < real_inverse e
    #[26] real_inverse e < real_inverse (abs x ^ n)
  ← z3 goal=25 facts=[1]
    #[27] 0 < real_inverse e
  → rewrite target=fact real_pow_inv sym=false goal=26 facts=[21]
    #[28] real_inverse e < real_inverse (abs x ^ n)
qed

theorem eventually_in_sequentially
  fixes P :: nat => bool
  prop eventually P sequentially <--> finite ({n. ~(P n)})
  [hint_rewrite,hint_rewrite_sym]

theorem eventually_no_subsequence
  fixes P :: nat => bool
  prop eventually P sequentially <--> ~(?r. (!m::nat. !n. m < n --> r m < r n) & (!n. ~(P (r n))))
  [hint_rewrite]
proof
  ← rewrite eventually_in_sequentially sym=false goal=0
    #[1] finite ({n. ¬(P n)}) ⟷ ¬(∃r. (∀m::nat. ∀n. m < n ⟶ r m < r n) ∧ (∀n. ¬(P (r n))))
  cut "!p. !q. (p <--> ~q) <-->  (~p <--> q)" goal=1
    #[2] ∀p. ∀q. (p ⟷ ¬q) ⟷ ¬p ⟷ q
  ← z3 goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] ¬(finite ({n. ¬(P n)})) ⟷ (∃r. (∀m::nat. ∀n. m < n ⟶ r m < r n) ∧ (∀n. ¬(P (r n))))
  ← rewrite infinite_def sym=true goal=3
    #[4] infinite ({n. ¬(P n)}) ⟷ (∃r. (∀m::nat. ∀n. m < n ⟶ r m < r n) ∧ (∀n. ¬(P (r n))))
  ← rewrite infinite_enumerate_eq_alt sym=false goal=4
    #[5] (∃r. (∀m::nat. ∀n. m < n ⟶ r m < r n) ∧ (∀n. r n ∈ {n1. ¬(P n1)})) ⟷ (∃r. (∀m::nat. ∀n. m < n ⟶ r m < r n) ∧ (∀n. ¬(P (r n))))
  ← rewrite member_collect sym=false goal=5
qed

theorem eventually_ubound_le_sequentially
  fixes f :: nat => real
  prop (?b. eventually (%n. f n <= b) sequentially) <--> (?b. !n. f n <= b)
  [hint_rewrite]

theorem eventually_lbound_le_sequentially
  fixes f :: nat => real
  prop (?b. eventually (%n. b <= f n) sequentially) <--> (?b. !n. b <= f n)
  [hint_rewrite]

const netlimit :: 'a net ⇒ 'a

const at_infinity :: real net

def at_posinfinity :: real net = at_posinfinity = at_infinity

def at_neginfinity :: real net = at_neginfinity = at_infinity

def real_open :: real set ⇒ bool = real_open s ⟷ (∀x. x ∈ s ⟶ (∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s))) [hint_rewrite]

def real_closed :: real set ⇒ bool = real_closed s ⟷ real_open (diff univ s) [hint_rewrite]

theorem real_open_empty
  prop real_open {}
  [hint_backward]

theorem real_open_univ
  prop real_open univ
  [hint_backward]

theorem real_open_inter
  fixes s :: real set, t :: real set
  prop real_open s --> real_open t --> real_open (s Int t)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] real_open s
    #[2] real_open t
    #[3] real_open (s ∩ t)
  ← rewrite real_open_def sym=false goal=3
    #[4] ∀x. x ∈ s ∩ t ⟶ (∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∩ t))
  → rewrite target=fact real_open_def sym=false goal=4 facts=[1]
    #[5] ∀x. x ∈ s ⟶ (∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s))
  → rewrite target=fact real_open_def sym=false goal=4 facts=[2]
    #[6] ∀x. x ∈ t ⟶ (∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ t))
  ← intro x goal=4
    #[7] _VAR x
    #[8] x ∈ s ∩ t
    #[9] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∩ t)
  → rewrite target=fact member_inter_iff sym=false goal=9 facts=[8]
    #[10] x ∈ s ∧ x ∈ t
  → forward conjD1 goal=9 facts=[10]
    #[11] x ∈ s
  → forward conjD2 goal=9 facts=[10]
    #[12] x ∈ t
  → forward goal=9 facts=[5,11]
    #[13] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s)
  → forward goal=9 facts=[6,12]
    #[14] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ t)
  elim d1 goal=9 facts=[13]
    #[15] _VAR d1
    #[16] 0 < d1 ∧ (∀x1. abs (x1 - x) < d1 ⟶ x1 ∈ s)
    #[17] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∩ t)
  elim d2 goal=17 facts=[14]
    #[18] _VAR d2
    #[19] 0 < d2 ∧ (∀x1. abs (x1 - x) < d2 ⟶ x1 ∈ t)
    #[20] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∩ t)
  ← rewrite member_inter_iff sym=false goal=20
    #[21] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∧ x1 ∈ t)
  → forward conjD1 goal=21 facts=[16]
    #[22] 0 < d1
  → forward conjD1 goal=21 facts=[19]
    #[23] 0 < d2
  → forward real_down2 param_d1=d1 param_d2=d2 goal=21
    #[24] 0 < d1 ⟶ 0 < d2 ⟶ (∃e. 0 < e ∧ e < d1 ∧ e < d2)
  → forward goal=21 facts=[24,22,23]
    #[25] ∃e. 0 < e ∧ e < d1 ∧ e < d2
  elim e goal=21 facts=[25]
    #[26] _VAR e
    #[27] 0 < e ∧ e < d1 ∧ e < d2
    #[28] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∧ x1 ∈ t)
    #[29] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∩ t)
  ← inst e goal=28
    #[30] 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∧ x1 ∈ t)
  ← rule conjI goal=30
    #[31] 0 < e
    #[32] ∀x1. abs (x1 - x) < e ⟶ x1 ∈ s ∧ x1 ∈ t
  ← rule conjD1 goal=31 facts=[27]
    #[33] 0 < e
  → forward conjD2 goal=32 facts=[16]
    #[34] ∀x1. abs (x1 - x) < d1 ⟶ x1 ∈ s
  → forward conjD2 goal=32 facts=[19]
    #[35] ∀x1. abs (x1 - x) < d2 ⟶ x1 ∈ t
  ← intro x1 goal=32
    #[36] _VAR x1
    #[37] abs (x1 - x) < e
    #[38] x1 ∈ s ∧ x1 ∈ t
  ← rule conjI goal=38
    #[39] x1 ∈ s
    #[40] x1 ∈ t
  ← apply_prev goal=39 facts=[34]
    #[41] abs (x1 - x) < d1
  ← rule real_lt_trans param_y=e goal=41
    #[42] e < d1
  → forward conjD2 goal=42 facts=[27]
    #[43] e < d1 ∧ e < d2
  ← rule conjD1 goal=42 facts=[43]
    #[44] e < d1
  ← apply_prev goal=40 facts=[35]
    #[45] abs (x1 - x) < d2
  ← rule real_lt_trans param_y=e goal=45
    #[46] e < d2
  ← rule conjD2 goal=46 facts=[43]
    #[47] e < d2
qed

theorem real_open_halfspace_gt
  fixes a :: real
  prop real_open ({x. a < x})
  [hint_backward]
proof
  ← rewrite real_open_def sym=false goal=0
    #[1] ∀x. x ∈ {x1. a < x1} ⟶ (∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ {x2. a < x2}))
  ← intro x goal=1
    #[2] _VAR x
    #[3] x ∈ {x1. a < x1}
    #[4] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ {x2. a < x2})
  → rewrite target=fact member_collect sym=false goal=4 facts=[3]
    #[5] a < x
  ← rewrite member_collect sym=false goal=4
    #[6] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ a < x1)
  ← inst "abs (a - x)" goal=6
    #[7] 0 < abs (a - x) ∧ (∀x1. abs (x1 - x) < abs (a - x) ⟶ a < x1)
  ← rule conjI goal=7
    #[8] 0 < abs (a - x)
    #[9] ∀x1. abs (x1 - x) < abs (a - x) ⟶ a < x1
  ← z3 goal=8 facts=[5]
  ← intro x1 goal=9
    #[10] _VAR x1
    #[11] abs (x1 - x) < abs (a - x)
    #[12] a < x1
  ← z3 goal=12 facts=[5,11]
qed

theorem real_open_halfspace_lt
  fixes a :: real
  prop real_open ({x. x < a})
  [hint_backward]
proof
  ← rewrite real_open_def sym=false goal=0
    #[1] ∀x. x ∈ {x1. x1 < a} ⟶ (∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ {x2. x2 < a}))
  ← intro x goal=1
    #[2] _VAR x
    #[3] x ∈ {x1. x1 < a}
    #[4] ∃e. 0 < e ∧ (∀x1. abs (x1 - x) < e ⟶ x1 ∈ {x2. x2 < a})
  ← inst "abs (a - x)" goal=4
    #[5] 0 < abs (a - x) ∧ (∀x1. abs (x1 - x) < abs (a - x) ⟶ x1 ∈ {x2. x2 < a})
  → rewrite target=fact member_collect sym=false goal=5 facts=[3]
    #[6] x < a
  ← rule conjI goal=5
    #[7] 0 < abs (a - x)
    #[8] ∀x1. abs (x1 - x) < abs (a - x) ⟶ x1 ∈ {x2. x2 < a}
  ← z3 goal=7 facts=[6]
  ← intro x1 goal=8
    #[9] _VAR x1
    #[10] abs (x1 - x) < abs (a - x)
    #[11] x1 ∈ {x. x < a}
  ← rewrite member_collect sym=false goal=11
    #[12] x1 < a
  ← z3 goal=12 facts=[10,6]
qed

theorem real_open_real_interval
  fixes a :: real, b :: real
  prop real_open (real_open_interval a b)
  [hint_backward]
proof
  ← rewrite real_open_interval_def sym=false goal=0
    #[1] real_open ({p. a < p ∧ p < b})
  cut "{p. a < p ∧ p < b} = inter {p. a < p}  {p. p < b} " goal=1
    #[2] {p. a < p ∧ p < b} = {p. a < p} ∩ {p. p < b}
  ← z3 goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] real_open ({p. a < p} ∩ {p. p < b})
  ← rule real_open_inter goal=3
    #[4] real_open ({p. a < p})
    #[5] real_open ({p. p < b})
  ← rule real_open_halfspace_gt goal=4
  ← rule real_open_halfspace_lt goal=5
qed

def real_bounded :: real set ⇒ bool = real_bounded s ⟷ (∃B. ∀x. x ∈ s ⟶ abs x ≤ B) [hint_rewrite]

theorem real_bounded_pos
  fixes s :: real set
  prop real_bounded s <--> (?B. 0 < B & (!x. x Mem s --> abs x <= B))
  [hint_rewrite]
proof
  ← rewrite real_bounded_def sym=false goal=0
    #[1] (∃B. ∀x. x ∈ s ⟶ abs x ≤ B) ⟷ (∃B. 0 < B ∧ (∀x. x ∈ s ⟶ abs x ≤ B))
  ← rule iffI goal=1
    #[2] (∃B. ∀x. x ∈ s ⟶ abs x ≤ B) ⟶ (∃B. 0 < B ∧ (∀x. x ∈ s ⟶ abs x ≤ B))
    #[3] (∃B. 0 < B ∧ (∀x. x ∈ s ⟶ abs x ≤ B)) ⟶ (∃B. ∀x. x ∈ s ⟶ abs x ≤ B)
  ← intro goal=2
    #[4] ∃B. ∀x. x ∈ s ⟶ abs x ≤ B
    #[5] ∃B. 0 < B ∧ (∀x. x ∈ s ⟶ abs x ≤ B)
  elim B goal=5 facts=[4]
    #[6] _VAR B
    #[7] ∀x. x ∈ s ⟶ abs x ≤ B
    #[8] ∃B. 0 < B ∧ (∀x. x ∈ s ⟶ abs x ≤ B)
  ← inst "1+abs B" goal=8
    #[9] 0 < 1 + abs B ∧ (∀x. x ∈ s ⟶ abs x ≤ 1 + abs B)
  ← rule conjI goal=9
    #[10] 0 < 1 + abs B
    #[11] ∀x. x ∈ s ⟶ abs x ≤ 1 + abs B
  ← z3 goal=10
    #[12] 0 < 1 + abs B
  ← intro x goal=11
    #[13] _VAR x
    #[14] x ∈ s
    #[15] abs x ≤ 1 + abs B
  → forward goal=15 facts=[7,14]
    #[16] abs x ≤ B
  ← z3 goal=15 facts=[16]
    #[17] abs x ≤ 1 + abs B
  ← intro goal=3
    #[18] ∃B. 0 < B ∧ (∀x. x ∈ s ⟶ abs x ≤ B)
    #[19] ∃B. ∀x. x ∈ s ⟶ abs x ≤ B
  elim B goal=19 facts=[18]
    #[20] 0 < B ∧ (∀x. x ∈ s ⟶ abs x ≤ B)
    #[21] ∃B. ∀x. x ∈ s ⟶ abs x ≤ B
  → forward conjD2 goal=21 facts=[20]
    #[22] ∀x. x ∈ s ⟶ abs x ≤ B
  ← rule exI goal=21 facts=[22]
    #[23] ∃B. ∀x. x ∈ s ⟶ abs x ≤ B
qed

theorem real_bounded_real_closed_interval
  fixes a :: real, b :: real
  prop real_bounded (real_closed_interval a b)
  [hint_backward]
proof
  ← rewrite real_bounded_def sym=false goal=0
    #[1] ∃B. ∀x. x ∈ real_closed_interval a b ⟶ abs x ≤ B
  ← rewrite real_closed_interval_def sym=false goal=1
    #[2] ∃B. ∀x. x ∈ {p. a ≤ p ∧ p ≤ b} ⟶ abs x ≤ B
  ← inst "max (abs a) (abs b)" goal=2
    #[3] ∀x. x ∈ {p. a ≤ p ∧ p ≤ b} ⟶ abs x ≤ max (abs a) (abs b)
  ← rewrite member_collect sym=false goal=3
    #[4] ∀x. a ≤ x ∧ x ≤ b ⟶ abs x ≤ max (abs a) (abs b)
  ← z3 goal=4
qed

theorem real_bounded_real_open_interval
  fixes a :: real, b :: real
  prop real_bounded (real_open_interval a b)
  [hint_backward]
proof
  ← rewrite real_bounded_def sym=false goal=0
    #[1] ∃B. ∀x. x ∈ real_open_interval a b ⟶ abs x ≤ B
  ← rewrite real_open_interval_def sym=false goal=1
    #[2] ∃B. ∀x. x ∈ {p. a < p ∧ p < b} ⟶ abs x ≤ B
  ← inst "max (abs a) (abs b)" goal=2
    #[3] ∀x. x ∈ {p. a < p ∧ p < b} ⟶ abs x ≤ max (abs a) (abs b)
  ← rewrite member_collect sym=false goal=3
    #[4] ∀x. a < x ∧ x < b ⟶ abs x ≤ max (abs a) (abs b)
  ← z3 goal=4
qed

theorem real_bounded_shrink
  fixes s :: real set
  prop real_bounded (image (%x. x / (1 + abs x)) s)
  [hint_backward]

theorem not_real_bounded_univ
  prop ~(real_bounded univ)
  [hint_backward]

const real_compact :: real set ⇒ bool

theorem real_compact_interval
  fixes a :: real, b :: real
  prop real_compact (real_closed_interval a b)
  [hint_backward]

