theory integral
imports real, metric
description "Basic results about integral."

const has_integral :: (real ⇒ real) ⇒ real ⇒ real set ⇒ bool

const continuous_on :: (real ⇒ real) ⇒ real set ⇒ bool

def integrable_on :: (real ⇒ real) ⇒ real set ⇒ bool = integrable_on f i ⟷ (∃y. has_integral f y i) [hint_rewrite]

def integral :: real set ⇒ (real ⇒ real) ⇒ real = integral i f = (THE y. has_integral f y i) [hint_rewrite]

theorem integrable_integral
  fixes f :: real => real, i :: real set
  prop integrable_on f i --> has_integral f (integral i f) i
  [hint_backward]

theorem has_integral_integrable
  fixes f :: real => real, i :: real, s :: real set
  prop has_integral f i s --> integrable_on f s
  [hint_forward]
proof
  ← intro goal=0
    #[1] has_integral f i s
    #[2] integrable_on f s
  ← rewrite integrable_on_def goal=2
    #[3] ∃y. has_integral f y s
  ← inst i goal=3
qed

theorem has_integral_integral
  fixes f :: real => real, s :: real set
  prop integrable_on f s <--> has_integral f (integral s f) s
proof
  ← rule iffI goal=0
    #[1] integrable_on f s ⟶ has_integral f (integral s f) s
    #[2] has_integral f (integral s f) s ⟶ integrable_on f s
  ← intro goal=1
    #[3] integrable_on f s
    #[4] has_integral f (integral s f) s
  ← rule integrable_integral goal=4 facts=[3]
  ← intro goal=2
    #[5] has_integral f (integral s f) s
    #[6] integrable_on f s
  ← rewrite integrable_on_def goal=6
    #[7] ∃y. has_integral f y s
  ← rule exI param_a="integral s f" goal=7
qed

theorem has_integral_unique
  fixes f :: real => real, i :: real set, k1 :: real, k2 :: real
  prop has_integral f k1 i & has_integral f k2 i --> k1 = k2

theorem integral_unique
  fixes f :: real => real, k :: real set, y :: real
  prop has_integral f y k --> integral k f = y

theorem has_integral_integrable_integral
  fixes f :: real => real, i :: real, s :: real set
  prop has_integral f i s <--> integrable_on f s & integral s f = i

theorem integral_eq_has_integral
  fixes f :: real => real, s :: real set, y :: real
  prop integrable_on f s --> integral s f = y <--> has_integral f y s

theorem has_integral_is_0
  fixes f :: real => real, s :: real set
  prop (!x. x Mem s --> f x = 0) --> has_integral f 0 s

theorem has_integral_0
  fixes s :: real set
  prop has_integral (%x. 0) 0 s
proof
  ← rule has_integral_is_0 goal=0
    #[1] ∀x. x ∈ s ⟶ (0::real) = 0
  ← intro x goal=1
    #[2] _VAR x
    #[3] x ∈ s
    #[4] (0::real) = 0
  ← rule eq_refl goal=4
    #[5] (0::real) = 0
qed

theorem has_integral_0_eq
  fixes i :: real, s :: real set
  prop has_integral (%x. 0) i s <--> i = 0

theorem has_integral_cmul
  fixes c :: real, f :: real => real, k :: real, s :: real set
  prop has_integral f k s --> has_integral (%x. c * f x) (c * k) s

theorem has_integral_neg
  fixes f :: real => real, k :: real, s :: real set
  prop has_integral f k s --> has_integral (%x. -(f x)) (-k) s

theorem has_integral_add
  fixes f :: real => real, g :: real => real, k :: real, l :: real, s :: real set
  prop has_integral f k s & has_integral g l s --> has_integral (%x. f x + g x) (k + l) s

theorem has_integral_sub
  fixes f :: real => real, g :: real => real, k :: real, l :: real, s :: real set
  prop has_integral f k s & has_integral g l s --> has_integral (%x. f x - g x) (k - l) s

theorem integral_0
  fixes s :: real set
  prop integral s (%x. 0) = 0

theorem integral_add
  fixes f :: real => real, g :: real => real, s :: real set
  prop integrable_on f s & integrable_on g s --> integral s (%x. f x + g x) = integral s f + integral s g

theorem integral_cmul
  fixes c :: real, f :: real => real, s :: real set
  prop integrable_on f s --> integral s (%x. c * f x) = c * integral s f

theorem integral_neg
  fixes f :: real => real, s :: real set
  prop integrable_on f s --> integral s (%x. -(f x)) = -(integral s f)

theorem integral_sub
  fixes f :: real => real, g :: real => real, s :: real set
  prop integrable_on f s & integrable_on g s --> integral s (%x. f x - g x) = integral s f - integral s g

theorem integrable_0
  fixes s :: real set
  prop integrable_on (%x. 0) s

theorem integrable_add
  fixes f :: real => real, g :: real => real, s :: real set
  prop integrable_on f s & integrable_on g s --> integrable_on (%x. f x + g x) s

theorem integrable_cmul
  fixes c :: real, f :: real => real, s :: real set
  prop integrable_on f s --> integrable_on (%x. c * f x) s

theorem integrable_cmul_eq
  fixes c :: real, f :: real => real, s :: real set
  prop integrable_on (%x. c * f x) s <--> c = 0 | integrable_on f s

theorem integrable_neg
  fixes f :: real => real, s :: real set
  prop integrable_on f s --> integrable_on (%x. -(f x)) s

theorem integrable_neg_eq
  fixes f :: real => real, s :: real set
  prop integrable_on (%x. -(f x)) s <--> integrable_on f s

theorem integrable_sub
  fixes f :: real => real, g :: real => real, s :: real set
  prop integrable_on f s & integrable_on g s --> integrable_on (%x. f x - g x) s

theorem has_integral_eq
  fixes f :: real => real, g :: real => real, k :: real, s :: real set
  prop (!x. x Mem s --> f x = g x) & has_integral f k s --> has_integral g k s

theorem integrable_eq
  fixes f :: real => real, g :: real => real, s :: real set
  prop (!x. x Mem s --> f x = g x) & integrable_on f s --> integrable_on g s

theorem has_integral_eq_eq
  fixes f :: real => real, g :: real => real, k :: real, s :: real set
  prop (!x. x Mem s --> f x = g x) --> has_integral f k s <--> has_integral g k s

theorem has_integral_null
  fixes a :: real, b :: real, f :: real => real
  prop a = b --> has_integral f 0 (real_closed_interval a b)

theorem has_integral_null_eq
  fixes a :: real, b :: real, f :: real => real, i :: real
  prop a = b --> has_integral f i (real_closed_interval a b) <--> i = 0

theorem integral_null
  fixes a :: real, b :: real, f :: real => real
  prop a = b --> integral (real_closed_interval a b) f = 0

theorem integrable_on_null
  fixes a :: real, b :: real, f :: real => real
  prop a = b --> integrable_on f (real_closed_interval a b)

theorem has_integral_empty
  fixes f :: real => real
  prop has_integral f 0 {}

theorem has_integral_empty_eq
  fixes f :: real => real, i :: real
  prop has_integral f i {} <--> i = 0

theorem integrable_on_empty
  fixes f :: real => real
  prop integrable_on f {}

theorem integral_empty
  fixes f :: real => real
  prop integral {} f = 0

theorem has_integral_refl
  fixes a :: real, f :: real => real
  prop has_integral f 0 (real_closed_interval a a)

theorem integrable_on_refl
  fixes a :: real, f :: real => real
  prop integrable_on f (real_closed_interval a a)

theorem integral_refl
  fixes a :: real, f :: real => real
  prop integral (real_closed_interval a a) f = 0

theorem interval_split_l
  fixes a :: real, b :: real, c :: real
  prop real_closed_interval a b Int {x. x <= c} = real_closed_interval a (min b c)

theorem interval_split_r
  fixes a :: real, b :: real, c :: real
  prop real_closed_interval a b Int {x. x >= c} = real_closed_interval (max a c) b

theorem has_ingegral_split
  fixes a :: real, b :: real, c :: real, f :: real => real, i :: real, j :: real
  prop has_integral f i (real_closed_interval a b Int {x. x <= c}) & has_integral f j (real_closed_interval a b Int {x. x >= c}) --> has_integral f (i + j) (real_closed_interval a b)

theorem integrable_split
  fixes a :: real, b :: real, c :: real, f :: real => real
  prop integrable_on f (real_closed_interval a b) --> integrable_on f (real_closed_interval a b Int {x. x <= c}) & integrable_on f (real_closed_interval a b Int {x. x >= c})

theorem has_integral_const
  fixes a :: real, b :: real, c :: real
  prop has_integral (%x. c) (c * (b - a)) (real_closed_interval a b)

theorem integrable_const
  fixes a :: real, b :: real, c :: real
  prop integrable_on (%x. c) (real_closed_interval a b)

theorem integral_const
  fixes a :: real, b :: real, c :: real
  prop integral (real_closed_interval a b) (%x. c) = c * (b - a)

theorem has_integral_le
  fixes f :: real => real, g :: real => real, i :: real, j :: real, s :: real set
  prop has_integral f i s & has_integral g j s & (!x. x Mem s --> f x <= g x) --> i <= j

theorem integral_le
  fixes f :: real => real, g :: real => real, s :: real set
  prop integrable_on f s & integrable_on g s & (!x. x Mem s --> f x <= g x) --> integral s f <= integral s g

theorem has_integral_pos
  fixes f :: real => real, i :: real, s :: real set
  prop has_integral f i s & (!x. x Mem s --> 0 <= f x) --> 0 <= i

theorem integral_pos
  fixes f :: real => real, s :: real set
  prop integrable_on f s & (!x. x Mem s --> 0 <= f x) --> 0 <= integral s f

theorem has_integral_neg0
  fixes f :: real => real, i :: real, s :: real set
  prop has_integral f i s & (!x. x Mem s --> f x <= 0) --> i <= 0

theorem has_integral_lbound
  fixes B :: real, a :: real, b :: real, f :: real => real, i :: real
  prop has_integral f i (real_closed_interval a b) & (!x. x Mem real_closed_interval a b --> B <= f x) --> B * (b - a) <= i

theorem has_integral_ubound
  fixes B :: real, a :: real, b :: real, f :: real => real, i :: real
  prop has_integral f i (real_closed_interval a b) & (!x. x Mem real_closed_interval a b --> f x <= B) --> i <= B * (b - a)

theorem integral_lbound
  fixes B :: real, a :: real, b :: real, f :: real => real
  prop integrable_on f (real_closed_interval a b) & (!x. x Mem real_closed_interval a b --> B <= f x) --> B * (b - a) <= integral (real_closed_interval a b) f

theorem integral_ubound
  fixes B :: real, a :: real, b :: real, f :: real => real
  prop integrable_on f (real_closed_interval a b) & (!x. x Mem real_closed_interval a b --> f x <= B) --> integral (real_closed_interval a b) f <= B * (b - a)

theorem integrable_uniform_limit
  fixes a :: real, b :: real, f :: real => real
  prop (!e. 0 < e --> (?g. (!x. x Mem real_closed_interval a b --> abs (f x - g x) <= e) & integrable_on g (real_closed_interval a b))) --> integrable_on f (real_closed_interval a b)

def indicator :: real set ⇒ real ⇒ real = indicator s = (λx. if x ∈ s then 1 else 0) [hint_rewrite]

def negligible :: real set ⇒ bool = negligible s ⟷ (∀a. ∀b. has_integral (indicator s) 0 (real_closed_interval a b))

theorem has_integral_negligible
  fixes f :: real => real, s :: real set, t :: real set
  prop negligible s & (!x. x Mem diff t s --> f x = 0) --> has_integral f 0 t

theorem has_integral_on_negligible
  fixes f :: real => real, s :: real set
  prop negligible s --> has_integral f 0 s

theorem integrable_on_negligible
  fixes f :: real => real, s :: real set
  prop negligible s --> integrable_on f s

theorem integral_on_negligible
  fixes f :: real => real, s :: real set
  prop negligible s --> integral s f = 0

theorem has_integral_spike
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set, y :: real
  prop negligible s & (!x. x Mem diff t s --> f x = g x) & has_integral f y t --> has_integral g y t

theorem has_integral_spike_eq
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set, y :: real
  prop negligible s & (!x. x Mem diff t s --> f x = g x) --> has_integral f y t <--> has_integral g y t

theorem integrable_spike
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set
  prop negligible s & (!x. x Mem diff t s --> f x = g x) & integrable_on f t --> integrable_on g t

theorem integrable_spike_eq
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set
  prop negligible s & (!x. x Mem diff t s --> f x = g x) --> integrable_on f t <--> integrable_on g t

theorem integral_spike
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set
  prop negligible s & (!x. x Mem diff t s --> f x = g x) --> integral t f = integral t g

theorem negligible_subset
  fixes s :: real set, t :: real set
  prop negligible s & t Sub s --> negligible t

theorem negligible_diff
  fixes s :: real set, t :: real set
  prop negligible s --> negligible (diff s t)

theorem negligible_inter
  fixes s :: real set, t :: real set
  prop negligible s | negligible t --> negligible (s Int t)

theorem negligible_union
  fixes s :: real set, t :: real set
  prop negligible s & negligible t --> negligible (s Un t)

theorem negligible_union_eq
  fixes s :: real set, t :: real set
  prop negligible (s Un t) <--> negligible s & negligible t

theorem negligible_sing
  fixes a :: real
  prop negligible ({a})

theorem negligible_insert
  fixes a :: real, s :: real set
  prop negligible (insert a s) <--> negligible s

theorem negligible_empty
  prop negligible {}

theorem negligible_finite
  fixes a :: real, s :: real set
  prop finite s --> negligible s

theorem negligible_Union
  fixes s :: real set set
  prop finite s & (!t. t Mem s --> negligible t) --> negligible (UN s)

theorem NEGLIGIBLE
  fixes s :: real set
  prop negligible s <--> (!t. has_integral (indicator s) 0 t)

theorem has_integral_spike_finite
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set, y :: real
  prop finite s & (!x. x Mem diff t s --> g x = f x) & has_integral f y t --> has_integral g y t

theorem has_integral_spike_finite_eq
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set, y :: real
  prop finite s & (!x. x Mem diff t s --> g x = f x) --> has_integral f y t <--> has_integral g y t

theorem integrable_spike_finite
  fixes f :: real => real, g :: real => real, s :: real set, t :: real set
  prop finite s & (!x. x Mem diff t s --> g x = f x) & integrable_on f t --> integrable_on g t

theorem integral_eq
  fixes f :: real => real, g :: real => real, s :: real set
  prop (!x. x Mem s --> g x = f x) --> integral s f = integral s g

theorem integral_eq_0
  fixes f :: real => real, s :: real set
  prop (!x. x Mem s --> f x = 0) --> integral s f = 0

theorem negligible_frontier_interval
  fixes a :: real, b :: real
  prop negligible (diff (real_closed_interval a b) (real_open_interval a b))

theorem has_integral_spike_interior
  fixes a :: real, b :: real, f :: real => real, g :: real => real, y :: real
  prop (!x. x Mem real_open_interval a b --> g x = f x) & has_integral f y (real_closed_interval a b) --> has_integral g y (real_closed_interval a b)

theorem has_integral_spike_interior_eq
  fixes a :: real, b :: real, f :: real => real, g :: real => real, y :: real
  prop (!x. x Mem real_open_interval a b --> g x = f x) --> has_integral f y (real_closed_interval a b) <--> has_integral g y (real_closed_interval a b)

theorem integrable_spike_interior
  fixes a :: real, b :: real, f :: real => real, g :: real => real
  prop (!x. x Mem real_open_interval a b --> g x = f x) --> integrable_on f (real_closed_interval a b) --> integrable_on g (real_closed_interval a b)

theorem integrable_continuous
  fixes a :: real, b :: real, f :: real => real
  prop continuous_on f (real_closed_interval a b) --> integrable_on f (real_closed_interval a b)

theorem integrable_subinterval
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real
  prop integrable_on f (real_closed_interval a b) & real_closed_interval c d Sub real_closed_interval a b --> integrable_on f (real_closed_interval c d)

theorem has_integral_combine
  fixes a :: real, b :: real, c :: real, f :: real => real, i :: real, j :: real
  prop a <= c & c <= b & has_integral f i (real_closed_interval a c) & has_integral f j (real_closed_interval c b) --> has_integral f (i + j) (real_closed_interval a b)

theorem integral_combine
  fixes a :: real, b :: real, c :: real, f :: real => real
  prop a <= c & c <= b & integrable_on f (real_closed_interval a b) --> integral (real_closed_interval a c) f + integral (real_closed_interval c b) f = integral (real_closed_interval a b) f

theorem integrable_combine
  fixes a :: real, b :: real, c :: real, f :: real => real
  prop a <= c & c <= b & integrable_on f (real_closed_interval a c) & integrable_on f (real_closed_interval c b) --> integrable_on f (real_closed_interval a b)

const at :: real ⇒ real net

const has_v_derivative :: (real ⇒ real) ⇒ real ⇒ real net ⇒ bool

const continuous :: ('a ⇒ real) ⇒ 'a net ⇒ bool

theorem integral_has_v_derivative_pointwise
  fixes a :: real, b :: real, f :: real => real, x :: real
  prop integrable_on f (real_closed_interval a b) & x Mem real_closed_interval a b & continuous f (within (at x) (real_closed_interval a b)) --> has_v_derivative (%u. integral (real_closed_interval a u) f) (f x) (within (at x) (real_closed_interval a b))

theorem integral_has_v_derivative
  fixes a :: real, b :: real, f :: real => real
  prop continuous_on f (real_closed_interval a b) --> (!x. x Mem real_closed_interval a b --> has_v_derivative (%u. integral (real_closed_interval a u) f) (f x) (within (at x) (real_closed_interval a b)))

theorem antiderivative_continuous
  fixes a :: real, b :: real, f :: real => real
  prop continuous_on f (real_closed_interval a b) --> (?g. !x. x Mem real_closed_interval a b --> has_v_derivative g (f x) (within (at x) (real_closed_interval a b)))

theorem has_integral_restrict_open_subinterval
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, i :: real
  prop has_integral f i (real_closed_interval c d) & real_closed_interval c d Sub real_closed_interval a b --> has_integral (%x. if x Mem real_open_interval c d then f x else 0) i (real_closed_interval a b)

theorem has_integral_restrict_closed_subinterval
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, i :: real
  prop has_integral f i (real_closed_interval c d) & real_closed_interval c d Sub real_closed_interval a b --> has_integral (%x. if x Mem real_closed_interval c d then f x else 0) i (real_closed_interval a b)

theorem has_integral_restrict_closed_subinterval_eq
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, i :: real
  prop real_closed_interval c d Sub real_closed_interval a b --> has_integral (%x. if x Mem real_closed_interval c d then f x else 0) i (real_closed_interval a b) <--> has_integral f i (real_closed_interval c d)

theorem has_integral_restrict
  fixes f :: real => real, i :: real, s :: real set, t :: real set
  prop s Sub t --> has_integral (%x. if x Mem s then f x else 0) i t <--> has_integral f i s

theorem integral_restrict
  fixes f :: real => real, s :: real set, t :: real set
  prop s Sub t --> integral t (%x. if x Mem s then f x else 0) = integral s f

theorem integrable_restrict
  fixes f :: real => real, s :: real set, t :: real set
  prop s Sub t --> integrable_on (%x. if x Mem s then f x else 0) t <--> integrable_on f s

theorem has_integral_restrict_univ
  fixes f :: real => real, i :: real, s :: real set
  prop has_integral (%x. if x Mem s then f x else 0) i univ <--> has_integral f i s

theorem integral_restrict_univ
  fixes f :: real => real, s :: real set
  prop integral univ (%x. if x Mem s then f x else 0) = integral s f

theorem integrable_restrict_univ
  fixes f :: real => real, s :: real set
  prop integrable_on (%x. if x Mem s then f x else 0) univ <--> integrable_on f s

theorem has_integral_restrict_inter
  fixes f :: real => real, i :: real, s :: real set, t :: real set
  prop has_integral (%x. if x Mem s then f x else 0) i t <--> has_integral f i (s Int t)

theorem integral_restrict_inter
  fixes f :: real => real, s :: real set, t :: real set
  prop integral t (%x. if x Mem s then f x else 0) = integral (s Int t) f

theorem integrable_restrict_inter
  fixes f :: real => real, s :: real set, t :: real set
  prop integrable_on (%x. if x Mem s then f x else 0) t <--> integrable_on f (s Int t)

theorem has_integral_on_superset
  fixes f :: real => real, i :: real, s :: real set, t :: real set
  prop (!x. ~(x Mem s) --> f x = 0) & s Sub t & has_integral f i s --> has_integral f i t

theorem integrable_on_superset
  fixes f :: real => real, s :: real set, t :: real set
  prop (!x. ~(x Mem s) --> f x = 0) & s Sub t & integrable_on f s --> integrable_on f t

theorem negligible_on_intervals
  fixes s :: real set
  prop negligible s <--> (!a. !b. negligible (s Int real_closed_interval a b))

theorem has_integral_reflect_lemma
  fixes a :: real, b :: real, f :: real => real, i :: real
  prop has_integral f i (real_closed_interval a b) --> has_integral (%x. f (-x)) i (real_closed_interval (-b) (-a))

theorem has_integral_reflect
  fixes a :: real, b :: real, f :: real => real, i :: real
  prop has_integral (%x. f (-x)) i (real_closed_interval (-b) (-a)) <--> has_integral f i (real_closed_interval a b)

theorem integrable_reflect
  fixes a :: real, b :: real, f :: real => real
  prop integrable_on (%x. f (-x)) (real_closed_interval (-b) (-a)) <--> integrable_on f (real_closed_interval a b)

theorem integral_reflect
  fixes a :: real, b :: real, f :: real => real
  prop integral (real_closed_interval (-b) (-a)) (%x. f (-x)) = integral (real_closed_interval a b) f

theorem has_integral_translation
  fixes a :: real, f :: real => real, i :: real, s :: real set
  prop has_integral (%x. f (a + x)) i s <--> has_integral f i (image (%x. a + x) s)

theorem integral_translation
  fixes a :: real, f :: real => real, s :: real set
  prop integral s (%x. f (a + x)) = integral (image (%x. a + x) s) f

theorem integrable_translation
  fixes a :: real, f :: real => real, s :: real set
  prop integrable_on (%x. f (a + x)) s <--> integrable_on f (image (%x. a + x) s)

theorem has_integral_pos_ae
  fixes f :: real => real, i :: real, s :: real set, t :: real set
  prop has_integral f i s & negligible t & (!x. x Mem diff s t --> 0 <= f x) --> 0 <= i

theorem integral_pos_ae
  fixes f :: real => real, s :: real set, t :: real set
  prop integrable_on f s & negligible t & (!x. x Mem diff s t --> 0 <= f x) --> 0 <= integral s f

theorem has_integral_subset_le
  fixes f :: real => real, i :: real, j :: real, s :: real set, t :: real set
  prop s Sub t & has_integral f i s & has_integral f j t & (!x. x Mem t --> 0 <= f x) --> i <= j

theorem integral_subset_le
  fixes f :: real => real, s :: real set, t :: real set
  prop s Sub t & integrable_on f s & integrable_on f t & (!x. x Mem t --> 0 <= f x) --> integral s f <= integral t f

theorem integrable_on_subinterval
  fixes a :: real, b :: real, f :: real => real, s :: real set
  prop integrable_on f s & real_closed_interval a b Sub s --> integrable_on f (real_closed_interval a b)

theorem integral_split
  fixes a :: real, b :: real, f :: real => real, t :: real
  prop integrable_on f (real_closed_interval a b) --> integral (real_closed_interval a b) f = integral (real_closed_interval a (min b t)) f + integral (real_closed_interval (max a t) b) f

theorem integral_split_signed
  fixes a :: real, b :: real, f :: real => real, t :: real
  prop a <= t & a <= b & integrable_on f (real_closed_interval a (max b t)) --> integral (real_closed_interval a b) f = integral (real_closed_interval a t) f + (if b < t then -1 else 1) * integral (real_closed_interval (min b t) (max b t)) f

theorem integrable_reflect_gen
  fixes f :: real => real, s :: real set
  prop integrable_on (%x. f (-x)) s <--> integrable_on f (image uminus s)

theorem integral_reflect_gen
  fixes f :: real => real, s :: real set
  prop integral s (%x. f (-x)) = integral (image uminus s) f

theorem has_integral_straddle_null
  fixes f :: real => real, g :: real => real, s :: real set
  prop (!x. x Mem s --> 0 <= f x & f x <= g x) & has_integral g 0 s --> has_integral f 0 s

theorem has_integral_diff
  fixes f :: real => real, i :: real, j :: real, s :: real set, t :: real set
  prop has_integral f i s & has_integral f j t & negligible (diff t s) --> has_integral f (i - j) (diff s t)

theorem integral_diff
  fixes f :: real => real, s :: real set, t :: real set
  prop integrable_on f s & integrable_on f t & negligible (diff t s) --> integral (diff s t) f = integral s f - integral t f

theorem integrable_diff
  fixes f :: real => real, s :: real set, t :: real set
  prop integrable_on f s & integrable_on f t & t Sub s --> integrable_on f (diff s t)

theorem interval_image_affinity_interval
  fixes a :: real, b :: real, c :: real, m :: real
  prop ?u. ?v. image (%x. m * x + c) (real_closed_interval a b) = real_closed_interval u v

theorem integration_by_parts
  fixes a :: real, b :: real, f :: real => real, f2 :: real => real, g :: real => real, g2 :: real => real, y :: real
  prop a <= b & continuous_on (%x. f x * g x) (real_closed_interval a b) & (!x. x Mem real_closed_interval a b --> has_v_derivative f (f2 x) (at x) & has_v_derivative g (g2 x) (at x)) & has_integral (%x. f x * g2 x) (f b * g b - f a * g a - y) (real_closed_interval a b) --> has_integral (%x. f2 x * g x) y (real_closed_interval a b)

theorem integration_by_parts_simple
  fixes a :: real, b :: real, f :: real => real, f2 :: real => real, g :: real => real, g2 :: real => real, y :: real
  prop a <= b & continuous_on (%x. f x * g x) (real_closed_interval a b) & (!x. x Mem real_closed_interval a b --> has_v_derivative f (f2 x) (within (at x) (real_closed_interval a b)) & has_v_derivative g (g2 x) (within (at x) (real_closed_interval a b))) & has_integral (%x. f x * g2 x) (f b * g b - f a * g a - y) (real_closed_interval a b) --> has_integral (%x. f2 x * g x) y (real_closed_interval a b)

theorem integrable_by_parts
  fixes a :: real, b :: real, f :: real => real, f2 :: real => real, g :: real => real, g2 :: real => real
  prop continuous_on (%x. f x * g x) (real_closed_interval a b) & (!x. x Mem real_open_interval a b --> has_v_derivative f (f2 x) (at x) & has_v_derivative g (g2 x) (at x)) & integrable_on (%x. f x * g2 x) (real_closed_interval a b) --> integrable_on (%x. f2 x * g x) (real_closed_interval a b)

theorem integrable_by_parts_eq
  fixes a :: real, b :: real, f :: real => real, f2 :: real => real, g :: real => real, g2 :: real => real
  prop continuous_on (%x. f x * g x) (real_closed_interval a b) & (!x. x Mem real_open_interval a b --> has_v_derivative f (f2 x) (at x) & has_v_derivative g (g2 x) (at x)) --> integrable_on (%x. f x * g2 x) (real_closed_interval a b) <--> integrable_on (%x. f2 x * g x) (real_closed_interval a b)

theorem has_integral_subsitution
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, g :: real => real, g2 :: real => real
  prop integrable_on f (real_closed_interval c d) & continuous_on g (real_closed_interval a b) & image g (real_closed_interval a b) Sub real_closed_interval c d & (!x. x Mem real_closed_interval a b --> has_v_derivative g (g2 x) (within (at x) (real_closed_interval a b)) & continuous f (within (at (g x)) (real_closed_interval c d))) & a <= b & c <= d & g a <= g b --> has_integral (%x. g2 x * f (g x)) (integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)

