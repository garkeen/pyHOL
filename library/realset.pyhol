theory realset
imports real
description "Supremum and infimum. Relaitonal counterparts of sup and inf. Refer to sets.ml from HOL light"

def sup :: real set ⇒ real = sup s = (THE a. (∀x. x ∈ s ⟶ x ≤ a) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ a ≤ b)) [hint_rewrite]

theorem sup_eq
  fixes s :: real set, t :: real set
  prop (!b. (!x. x Mem s --> x <= b) <--> (!x. x Mem t --> x <= b)) --> sup s = sup t
  [hint_backward]
proof
  ← intro goal=0
    #[1] ∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟷ (∀x. x ∈ t ⟶ x ≤ b)
    #[2] sup s = sup t
  ← rewrite sup_def sym=false goal=2
    #[3] (THE a. (∀x. x ∈ s ⟶ x ≤ a) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ a ≤ b)) = (THE a. (∀x. x ∈ t ⟶ x ≤ a) ∧ (∀b. (∀x. x ∈ t ⟶ x ≤ b) ⟶ a ≤ b))
  ← rewrite source=prev goal=3 facts=[1]
qed

theorem sup
  fixes s :: real set
  prop ~(s = {}) --> (?b. !x. x Mem s --> x <= b) --> (!x. x Mem s --> x <= sup s) & (!b. (!x. x Mem s --> x <= b) --> sup s <= b)
  [hint_backward,hint_backward1]

theorem sup_finite_lemma
  fixes s :: real set
  prop finite s --> ~(s = {}) --> (?b. b Mem s & (!x. x Mem s --> x <= b))
  [hint_backward,hint_backward1]

theorem sup_finite
  fixes s :: real set
  prop finite s --> ~(s = {}) --> sup s Mem s & (!x. x Mem s --> x <= sup s)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] finite s
    #[2] ¬(s = ∅)
    #[3] sup s ∈ s ∧ (∀x. x ∈ s ⟶ x ≤ sup s)
  → forward sup_finite_lemma goal=3 facts=[1,2]
    #[4] ∃b. b ∈ s ∧ (∀x. x ∈ s ⟶ x ≤ b)
  ← rule conjI goal=3
    #[5] sup s ∈ s
    #[6] ∀x. x ∈ s ⟶ x ≤ sup s
  → forward sup goal=5 facts=[2]
    #[7] (∃b. ∀x. x ∈ s ⟶ x ≤ b) ⟶ (∀x. x ∈ s ⟶ x ≤ sup s) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b)
  elim b goal=5 facts=[4]
    #[8] _VAR b
    #[9] b ∈ s ∧ (∀x. x ∈ s ⟶ x ≤ b)
    #[10] sup s ∈ s
    #[11] ∀x. x ∈ s ⟶ x ≤ sup s
    #[12] sup s ∈ s ∧ (∀x. x ∈ s ⟶ x ≤ sup s)
  → forward conjD2 goal=10 facts=[9]
    #[13] ∀x. x ∈ s ⟶ x ≤ b
  cut "(∃b. ∀x. x ∈ s ⟶ x ≤ b)" goal=10
    #[14] ∃b. ∀x. x ∈ s ⟶ x ≤ b
  ← rule exI goal=14 facts=[13]
    #[15] ∃b. ∀x. x ∈ s ⟶ x ≤ b
  → forward goal=10 facts=[7,15]
    #[16] (∀x. x ∈ s ⟶ x ≤ sup s) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b)
  → forward conjD1 goal=10 facts=[16]
    #[17] ∀x. x ∈ s ⟶ x ≤ sup s
  → forward conjD2 goal=10 facts=[16]
    #[18] ∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b
  → forward conjD1 goal=10 facts=[9]
    #[19] b ∈ s
  cut "sup s = b" goal=10
    #[20] sup s = b
  ← rewrite real_le_antisym sym=true goal=20
    #[21] sup s ≤ b ∧ b ≤ sup s
  ← rule conjI goal=21
    #[22] sup s ≤ b
    #[23] b ≤ sup s
  ← apply_prev goal=22 facts=[18]
  ← apply_prev goal=23 facts=[17]
  ← rewrite source=prev goal=10 facts=[20]
  ← rule conjD1 goal=11 facts=[16]
qed

theorem real_le_sup_finite
  fixes a :: real, s :: real set
  prop finite s --> ~(s = {}) --> a <= sup s <--> (?x. x Mem s & a <= x)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] finite s
    #[2] ¬(s = ∅)
    #[3] a ≤ sup s ⟷ (∃x. x ∈ s ∧ a ≤ x)
  → forward sup_finite goal=3 facts=[1,2]
    #[4] sup s ∈ s ∧ (∀x. x ∈ s ⟶ x ≤ sup s)
  ← rule iffI goal=3
    #[5] a ≤ sup s ⟶ (∃x. x ∈ s ∧ a ≤ x)
    #[6] (∃x. x ∈ s ∧ a ≤ x) ⟶ a ≤ sup s
  ← intro goal=5
    #[7] a ≤ sup s
    #[8] ∃x. x ∈ s ∧ a ≤ x
  ← inst "sup s" goal=8
    #[9] sup s ∈ s ∧ a ≤ sup s
  ← rule conjI goal=9
    #[10] sup s ∈ s
  ← rule conjD1 goal=10 facts=[4]
    #[11] sup s ∈ s
  ← intro goal=6
    #[12] ∃x. x ∈ s ∧ a ≤ x
    #[13] a ≤ sup s
  → forward conjD2 goal=13 facts=[4]
    #[14] ∀x. x ∈ s ⟶ x ≤ sup s
  elim a1 goal=13 facts=[12]
    #[15] _VAR a1
    #[16] a1 ∈ s ∧ a ≤ a1
    #[17] a ≤ sup s
  → forward conjD1 goal=17 facts=[16]
    #[18] a1 ∈ s
  → forward conjD2 goal=17 facts=[16]
    #[19] a ≤ a1
  → forward goal=17 facts=[14,18]
    #[20] a1 ≤ sup s
  ← rule real_le_trans goal=17 facts=[19,20]
    #[21] a ≤ sup s
qed

theorem real_sup_le
  fixes b :: real, s :: real set
  prop ~(s = {}) --> (!x. x Mem s --> x <= b) --> sup s <= b
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(s = ∅)
    #[2] ∀x. x ∈ s ⟶ x ≤ b
    #[3] sup s ≤ b
  → forward sup goal=3 facts=[1]
    #[4] (∃b. ∀x. x ∈ s ⟶ x ≤ b) ⟶ (∀x. x ∈ s ⟶ x ≤ sup s) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b)
  cut "(∃b. ∀x. x ∈ s ⟶ x ≤ b)" goal=3
    #[5] ∃b. ∀x. x ∈ s ⟶ x ≤ b
  ← rule exI goal=5 facts=[2]
    #[6] ∃b. ∀x. x ∈ s ⟶ x ≤ b
  → forward goal=3 facts=[4,6]
    #[7] (∀x. x ∈ s ⟶ x ≤ sup s) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b)
  → forward conjD2 goal=3 facts=[7]
    #[8] ∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b
  ← apply_prev goal=3 facts=[8,2]
qed

theorem real_le_sup
  fixes a :: real, b :: real, s :: real set, y :: real
  prop y Mem s --> a <= y --> (!x. x Mem s --> x <= b) --> a <= sup s
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] y ∈ s
    #[2] a ≤ y
    #[3] ∀x. x ∈ s ⟶ x ≤ b
    #[4] a ≤ sup s
  → forward sup param_s=s goal=4
    #[5] ¬(s = ∅) ⟶ (∃b. ∀x. x ∈ s ⟶ x ≤ b) ⟶ (∀x. x ∈ s ⟶ x ≤ sup s) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b)
  cut "¬(s = ∅)" goal=4 facts=[5]
    #[6] ¬(s = ∅)
  ← z3 goal=6 facts=[1]
    #[7] ¬(s = ∅)
  → forward goal=4 facts=[5,7]
    #[8] (∃b. ∀x. x ∈ s ⟶ x ≤ b) ⟶ (∀x. x ∈ s ⟶ x ≤ sup s) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b)
  cut "(∃b. ∀x. x ∈ s ⟶ x ≤ b)" goal=4 facts=[8]
    #[9] ∃b. ∀x. x ∈ s ⟶ x ≤ b
  ← rule exI goal=9 facts=[3]
    #[10] ∃b. ∀x. x ∈ s ⟶ x ≤ b
  → forward goal=4 facts=[8,10]
    #[11] (∀x. x ∈ s ⟶ x ≤ sup s) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b)
  → forward conjD1 goal=4 facts=[11]
    #[12] ∀x. x ∈ s ⟶ x ≤ sup s
  ← rule real_le_trans goal=4 facts=[2]
    #[13] y ≤ sup s
  ← apply_prev goal=13 facts=[12]
qed

theorem element_le_sup
  fixes a :: real, s :: real set
  prop (?b. !x. x Mem s --> x <= b) --> a Mem s --> a <= sup s
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ∃b. ∀x. x ∈ s ⟶ x ≤ b
    #[2] a ∈ s
    #[3] a ≤ sup s
  elim b goal=3 facts=[1]
    #[4] _VAR b
    #[5] ∀x. x ∈ s ⟶ x ≤ b
    #[6] a ≤ sup s
  ← rule real_le_sup param_b=b goal=6 facts=[2]
    #[7] a ≤ a
  ← rule real_le_refl goal=7
    #[8] a ≤ a
qed

theorem sup_approach
  fixes c :: real, s :: real set
  prop ~(s = {}) --> (?b. !x. x Mem s --> x <= b) --> c < sup s --> (?x. x Mem s & c < x)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(s = ∅)
    #[2] ∃b. ∀x. x ∈ s ⟶ x ≤ b
    #[3] c < sup s
    #[4] ∃x. x ∈ s ∧ c < x
  ← rewrite double_neg sym=true goal=4
    #[5] ¬¬(∃x. x ∈ s ∧ c < x)
  ← rule negI goal=5
    #[6] ¬(∃x. x ∈ s ∧ c < x) ⟶ false
  ← intro goal=6
    #[7] ¬(∃x. x ∈ s ∧ c < x)
    #[8] false
  → rewrite target=fact not_exists sym=false goal=8 facts=[7]
    #[9] ∀x. ¬(x ∈ s ∧ c < x)
  → rewrite target=fact de_morgan_thm1 sym=false goal=8 facts=[9]
    #[10] ∀x. ¬(x ∈ s) ∨ ¬(c < x)
  → rewrite target=fact real_not_lt sym=false goal=8 facts=[10]
    #[11] ∀x. ¬(x ∈ s) ∨ x ≤ c
  ← rule contrapositive goal=8 facts=[3]
    #[12] ¬false ⟶ ¬(c < sup s)
  ← intro goal=12
    #[13] ¬false
    #[14] ¬(c < sup s)
  ← rewrite real_not_lt sym=false goal=14
    #[15] sup s ≤ c
  → forward sup goal=15 facts=[1,2]
    #[16] (∀x. x ∈ s ⟶ x ≤ sup s) ∧ (∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b)
  → forward conjD2 goal=15 facts=[16]
    #[17] ∀b. (∀x. x ∈ s ⟶ x ≤ b) ⟶ sup s ≤ b
  ← apply_prev goal=15 facts=[17]
    #[18] ∀x. x ∈ s ⟶ x ≤ c
  ← z3 goal=18 facts=[11]
    #[19] ∀x. x ∈ s ⟶ x ≤ c
qed

def inf :: real set ⇒ real = inf s = (THE a. (∀x. x ∈ s ⟶ a ≤ x) ∧ (∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ a)) [hint_rewrite]

theorem inf_eq
  fixes s :: real set, t :: real set
  prop (!a. (!x. x Mem s --> a <= x) <--> (!x. x Mem t --> a <= x)) --> inf s = inf t
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] ∀a. (∀x. x ∈ s ⟶ a ≤ x) ⟷ (∀x. x ∈ t ⟶ a ≤ x)
    #[2] inf s = inf t
  ← rewrite inf_def sym=false goal=2
    #[3] (THE a. (∀x. x ∈ s ⟶ a ≤ x) ∧ (∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ a)) = (THE a. (∀x. x ∈ t ⟶ a ≤ x) ∧ (∀b. (∀x. x ∈ t ⟶ b ≤ x) ⟶ b ≤ a))
  ← rewrite source=prev goal=3 facts=[1]
qed

theorem inf
  fixes s :: real set
  prop ~(s = {}) --> (?b. !x. x Mem s --> b <= x) --> (!x. x Mem s --> inf s <= x) & (!b. (!x. x Mem s --> b <= x) --> b <= inf s)
  [hint_backward,hint_backward1]

theorem inf_finite_lemma
  fixes s :: real set
  prop finite s --> ~(s = {}) --> (?b. b Mem s & (!x. x Mem s --> b <= x))
  [hint_backward,hint_backward1]

theorem inf_finite
  fixes s :: real set
  prop finite s --> ~(s = {}) --> inf s Mem s & (!x. x Mem s --> inf s <= x)
  [hint_backward,hint_backward1]

theorem real_le_inf_finite
  fixes a :: real, s :: real set
  prop finite s --> ~(s = {}) --> a <= inf s <--> (!x. x Mem s --> a <= x)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] finite s
    #[2] ¬(s = ∅)
    #[3] a ≤ inf s ⟷ (∀x. x ∈ s ⟶ a ≤ x)
  → forward inf_finite goal=3 facts=[1,2]
    #[4] inf s ∈ s ∧ (∀x. x ∈ s ⟶ inf s ≤ x)
  → forward conjD1 goal=3 facts=[4]
    #[5] inf s ∈ s
  → forward conjD2 goal=3 facts=[4]
    #[6] ∀x. x ∈ s ⟶ inf s ≤ x
  ← rule iffI goal=3
    #[7] a ≤ inf s ⟶ (∀x. x ∈ s ⟶ a ≤ x)
    #[8] (∀x. x ∈ s ⟶ a ≤ x) ⟶ a ≤ inf s
  ← intro goal=7
    #[9] a ≤ inf s
    #[10] ∀x. x ∈ s ⟶ a ≤ x
  ← intro x goal=10
    #[11] _VAR x
    #[12] x ∈ s
    #[13] a ≤ x
  → forward goal=13 facts=[6,12]
    #[14] inf s ≤ x
  ← rule real_le_trans goal=13 facts=[9,14]
  ← intro goal=8
    #[15] ∀x. x ∈ s ⟶ a ≤ x
    #[16] a ≤ inf s
  ← apply_prev goal=16 facts=[15]
qed

theorem real_inf_le_finite
  fixes a :: real, s :: real set
  prop finite s --> ~(s = {}) --> inf s <= a <--> (?x. x Mem s & x <= a)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] finite s
    #[2] ¬(s = ∅)
    #[3] inf s ≤ a ⟷ (∃x. x ∈ s ∧ x ≤ a)
  → forward inf_finite goal=3 facts=[1,2]
    #[4] inf s ∈ s ∧ (∀x. x ∈ s ⟶ inf s ≤ x)
  → forward conjD1 goal=3 facts=[4]
    #[5] inf s ∈ s
  → forward conjD2 goal=3 facts=[4]
    #[6] ∀x. x ∈ s ⟶ inf s ≤ x
  ← rule iffI goal=3
    #[7] inf s ≤ a ⟶ (∃x. x ∈ s ∧ x ≤ a)
    #[8] (∃x. x ∈ s ∧ x ≤ a) ⟶ inf s ≤ a
  ← intro goal=7
    #[9] inf s ≤ a
    #[10] ∃x. x ∈ s ∧ x ≤ a
  ← inst "inf s" goal=10
    #[11] inf s ∈ s ∧ inf s ≤ a
  ← rule conjI goal=11
  ← intro goal=8
    #[12] ∃x. x ∈ s ∧ x ≤ a
    #[13] inf s ≤ a
  elim a1 goal=13 facts=[12]
    #[14] _VAR a1
    #[15] a1 ∈ s ∧ a1 ≤ a
    #[16] inf s ≤ a
  ← rule real_le_trans param_y=a1 goal=16
    #[17] inf s ≤ a1
    #[18] a1 ≤ a
  ← apply_prev goal=17 facts=[6]
    #[19] a1 ∈ s
  ← rule conjD1 goal=19 facts=[15]
    #[20] a1 ∈ s
  ← rule conjD2 goal=18 facts=[15]
    #[21] a1 ≤ a
qed

theorem real_inf_le
  fixes a :: real, b :: real, s :: real set, y :: real
  prop y Mem s --> y <= b --> (!x. x Mem s --> a <= x) --> inf s <= b
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] y ∈ s
    #[2] y ≤ b
    #[3] ∀x. x ∈ s ⟶ a ≤ x
    #[4] inf s ≤ b
  → forward inf param_s=s goal=4
    #[5] ¬(s = ∅) ⟶ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ⟶ (∀x. x ∈ s ⟶ inf s ≤ x) ∧ (∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ inf s)
  cut "¬(s = ∅)" goal=4
    #[6] ¬(s = ∅)
  ← z3 goal=6 facts=[1]
    #[7] ¬(s = ∅)
  → forward goal=4 facts=[5,7]
    #[8] (∃b. ∀x. x ∈ s ⟶ b ≤ x) ⟶ (∀x. x ∈ s ⟶ inf s ≤ x) ∧ (∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ inf s)
  cut "(∃b. ∀x. x ∈ s ⟶ b ≤ x)" goal=4 facts=[8]
    #[9] ∃b. ∀x. x ∈ s ⟶ b ≤ x
  ← rule exI goal=9 facts=[3]
    #[10] ∃b. ∀x. x ∈ s ⟶ b ≤ x
  → forward goal=4 facts=[8,10]
    #[11] (∀x. x ∈ s ⟶ inf s ≤ x) ∧ (∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ inf s)
  → forward conjD1 goal=4 facts=[11]
    #[12] ∀x. x ∈ s ⟶ inf s ≤ x
  ← rule real_le_trans param_y=y goal=4
    #[13] inf s ≤ y
  ← apply_prev goal=13 facts=[12]
qed

theorem real_le_inf
  fixes b :: real, s :: real set
  prop ~(s = {}) --> (!x. x Mem s --> b <= x) --> b <= inf s
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(s = ∅)
    #[2] ∀x. x ∈ s ⟶ b ≤ x
    #[3] b ≤ inf s
  → forward inf goal=3 facts=[1]
    #[4] (∃b. ∀x. x ∈ s ⟶ b ≤ x) ⟶ (∀x. x ∈ s ⟶ inf s ≤ x) ∧ (∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ inf s)
  cut "(∃b. ∀x. x ∈ s ⟶ b ≤ x)" goal=3
    #[5] ∃b. ∀x. x ∈ s ⟶ b ≤ x
  ← rule exI goal=5 facts=[2]
    #[6] ∃b. ∀x. x ∈ s ⟶ b ≤ x
  → forward goal=3 facts=[4,6]
    #[7] (∀x. x ∈ s ⟶ inf s ≤ x) ∧ (∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ inf s)
  → forward conjD2 goal=3 facts=[7]
    #[8] ∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ inf s
  ← apply_prev goal=3 facts=[8]
qed

theorem inf_le_element
  fixes a :: real, s :: real set
  prop (?b. !x. x Mem s --> b <= x) --> a Mem s --> inf s <= a
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ∃b. ∀x. x ∈ s ⟶ b ≤ x
    #[2] a ∈ s
    #[3] inf s ≤ a
  elim b goal=3 facts=[1]
    #[4] _VAR b
    #[5] ∀x. x ∈ s ⟶ b ≤ x
    #[6] inf s ≤ a
  ← rule real_inf_le param_a=b goal=6 facts=[2]
    #[7] a ≤ a
  ← rule real_le_refl goal=7
    #[8] a ≤ a
qed

theorem inf_approach
  fixes c :: real, s :: real set
  prop ~(s = {}) --> (?b. !x. x Mem s --> b <= x) --> inf s < c --> (?x. x Mem s & x < c)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(s = ∅)
    #[2] ∃b. ∀x. x ∈ s ⟶ b ≤ x
    #[3] inf s < c
    #[4] ∃x. x ∈ s ∧ x < c
  → rewrite target=fact real_less_def sym=false goal=4 facts=[3]
    #[5] ¬(c ≤ inf s)
  ← rule contrapositive goal=4 facts=[5]
    #[6] ¬(∃x. x ∈ s ∧ x < c) ⟶ ¬¬(c ≤ inf s)
  ← rewrite double_neg sym=false goal=6
    #[7] ¬(∃x. x ∈ s ∧ x < c) ⟶ c ≤ inf s
  ← intro goal=7
    #[8] ¬(∃x. x ∈ s ∧ x < c)
    #[9] c ≤ inf s
  → rewrite target=fact not_exists sym=false goal=9 facts=[8]
    #[10] ∀x. ¬(x ∈ s ∧ x < c)
  → rewrite target=fact de_morgan_thm1 sym=false goal=9 facts=[10]
    #[11] ∀x. ¬(x ∈ s) ∨ ¬(x < c)
  → rewrite target=fact real_not_lt sym=false goal=9 facts=[11]
    #[12] ∀x. ¬(x ∈ s) ∨ c ≤ x
  → forward inf goal=9 facts=[1,2]
    #[13] (∀x. x ∈ s ⟶ inf s ≤ x) ∧ (∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ inf s)
  → forward conjD2 goal=9 facts=[13]
    #[14] ∀b. (∀x. x ∈ s ⟶ b ≤ x) ⟶ b ≤ inf s
  ← apply_prev goal=9 facts=[14]
    #[15] ∀x. x ∈ s ⟶ c ≤ x
  ← z3 goal=15 facts=[12]
    #[16] ∀x. x ∈ s ⟶ c ≤ x
qed

def has_inf :: real set ⇒ real ⇒ bool = has_inf s b ⟷ (∀c. (∀x. x ∈ s ⟶ c ≤ x) ⟷ c ≤ b) [hint_rewrite]

def has_sup :: real set ⇒ real ⇒ bool = has_sup s b ⟷ (∀c. (∀x. x ∈ s ⟶ x ≤ c) ⟷ b ≤ c) [hint_rewrite]

theorem has_inf_lbound
  fixes b :: real, s :: real set, x :: real
  prop has_inf s b --> x Mem s --> b <= x
  [hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] has_inf s b
    #[2] x ∈ s
    #[3] b ≤ x
  → rewrite target=fact has_inf_def sym=false goal=3 facts=[1]
    #[4] ∀c. (∀x. x ∈ s ⟶ c ≤ x) ⟷ c ≤ b
  → inst target=fact b goal=3 facts=[4]
    #[5] (∀x. x ∈ s ⟶ b ≤ x) ⟷ b ≤ b
  cut "(∀x. x ∈ s ⟶ b ≤ x)" goal=3 facts=[5]
    #[6] ∀x. x ∈ s ⟶ b ≤ x
  ← z3 goal=6 facts=[5]
    #[7] ∀x. x ∈ s ⟶ b ≤ x
  ← apply_prev goal=3 facts=[7]
qed

theorem has_sup_ubound
  fixes b :: real, s :: real set, x :: real
  prop has_sup s b --> x Mem s --> x <= b
  [hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] has_sup s b
    #[2] x ∈ s
    #[3] x ≤ b
  → rewrite target=fact has_sup_def sym=false goal=3 facts=[1]
    #[4] ∀c. (∀x. x ∈ s ⟶ x ≤ c) ⟷ b ≤ c
  → inst target=fact b goal=3 facts=[4]
    #[5] (∀x. x ∈ s ⟶ x ≤ b) ⟷ b ≤ b
  cut "(∀x. x ∈ s ⟶ x ≤ b)" goal=3 facts=[5]
    #[6] ∀x. x ∈ s ⟶ x ≤ b
  ← rewrite source=prev goal=6 facts=[5]
    #[7] b ≤ b
  ← z3 goal=7
    #[8] b ≤ b
  ← apply_prev goal=3 facts=[6]
qed

theorem has_inf_inf
  fixes l :: real, s :: real set
  prop has_inf s l <--> ~(s = {}) & (?b. !x. x Mem s --> b <= x) & inf s = l
  [hint_rewrite]

theorem has_sup_sup
  fixes l :: real, s :: real set
  prop has_sup s l <--> ~(s = {}) & (?b. !x. x Mem s --> x <= b) & sup s = l
  [hint_rewrite]

theorem inf_exists
  fixes s :: real set
  prop (?l. has_inf s l) <--> ~(s = {}) & (?b. !x. x Mem s --> b <= x)
  [hint_rewrite]
proof
  ← rewrite has_inf_inf sym=false goal=0
    #[1] (∃l. ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ∧ inf s = l) ⟷ ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x)
  ← rule iffI goal=1
    #[2] (∃l. ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ∧ inf s = l) ⟶ ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x)
    #[3] ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ⟶ (∃l. ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ∧ inf s = l)
  ← intro goal=2
    #[4] ∃l. ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ∧ inf s = l
    #[5] ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x)
  elim l goal=5 facts=[4]
    #[6] _VAR l
    #[7] ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ∧ inf s = l
    #[8] ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x)
  → rewrite target=fact conj_assoc sym=false goal=8 facts=[7]
    #[9] (¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x)) ∧ inf s = l
  ← rule conjD1 goal=8 facts=[9]
    #[10] ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x)
  ← intro goal=3
    #[11] ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x)
    #[12] ∃l. ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ∧ inf s = l
  → forward conjD1 goal=12 facts=[11]
    #[13] ¬(s = ∅)
  → forward conjD2 goal=12 facts=[11]
    #[14] ∃b. ∀x. x ∈ s ⟶ b ≤ x
  elim b goal=12 facts=[14]
    #[15] _VAR b
    #[16] ∀x. x ∈ s ⟶ b ≤ x
    #[17] ∃l. ¬(s = ∅) ∧ (∃b. ∀x. x ∈ s ⟶ b ≤ x) ∧ inf s = l
  ← inst b goal=17
    #[18] ¬(s = ∅) ∧ (∃b1. ∀x. x ∈ s ⟶ b1 ≤ x) ∧ inf s = b
  ← rule conjI goal=18
    #[19] (∃b1. ∀x. x ∈ s ⟶ b1 ≤ x) ∧ inf s = b
  ← rule conjI goal=19
    #[20] inf s = b
qed

theorem sup_exists
  fixes s :: real set
  prop (?l. has_sup s l) <--> ~(s = {}) & (?b. !x. x Mem s --> x <= b)
  [hint_rewrite]

theorem has_inf_approach
  fixes c :: real, l :: real, s :: real set
  prop has_inf s l --> l < c --> (?x. x Mem s & x < c)
  [hint_backward,hint_backward1,hint_forward]

theorem has_sup_approach
  fixes c :: real, l :: real, s :: real set
  prop has_sup s l --> c < l --> (?x. x Mem s & c < x)
  [hint_backward,hint_backward1]

theorem has_inf
  fixes l :: real, s :: real set
  prop has_inf s l <--> ~(s = {}) & (!x. x Mem s --> l <= x) & (!c. l < c --> (?x. x Mem s & x < c))
  [hint_rewrite]

theorem has_sup
  fixes l :: real, s :: real set
  prop has_sup s l <--> ~(s = {}) & (!x. x Mem s --> x <= l) & (!c. c < l --> (?x. x Mem s & c < x))
  [hint_rewrite]

