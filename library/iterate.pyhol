    20.6.1: rewrite_fact member_union_iff @20.1 sym=false
    20.6.2: apply_backward_step disjE @20.6.1
    20.6.2: introduction
    20.6.2.1: rewrite_fact in_support @20.6.2.0 sym=false
    20.6.2.2: apply_backward_step conjD1 @20.6.2.1
    20.6.3: introduction
    20.6.3.1: rewrite_fact in_support @20.6.3.0 sym=false
    20.6.3.2: apply_backward_step conjD1 @20.6.3.1
    22: rewrite_goal_with_prev @21
    22: rewrite_goal_with_prev @16
  qed

theorem iterate_natseg_0
  fixes f :: nat ⇒ 'a, m :: nat, op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟶ iterate op ({m..0}) f = (if m = 0 then f 0 else neutral op)
  [hint_backward]
  proof
    1: rewrite_goal natseg_0 sym=false
    1: cases "m = 0"
    1: introduction
    1.1: rewrite_goal if_P @1.0 sym=false
    1.1: apply_backward_step iterate_sing @0
    2: introduction
    2.1: rewrite_goal if_not_P @2.0 sym=false
    2.1: apply_backward_step iterate_empty
  qed

theorem iterate_natseg_Suc
  fixes f :: nat ⇒ 'a, m :: nat, n :: nat, op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟶ iterate op ({m..Suc n}) f = (if m ≤ Suc n then op (iterate op ({m..n}) f) (f (Suc n)) else iterate op ({m..n}) f)
  [hint_backward]
  proof
    1: rewrite_goal natseg_Suc sym=false
    1: cases "m ≤ Suc n"
    1: introduction
    1.1: rewrite_goal if_P @1.0 sym=false
    1.1: apply_forward_step iterate_insert @0 param_f=f param_s={m..n} param_x="Suc n"
    1.2: cut "finite ({m..n})"
    1.2: apply_backward_step finite_natseg
    1.3: apply_fact @1.1,1.2
    1.4: cut "~(Suc n ∈ {m..n})"
    1.4: rewrite_goal member_natseg sym=false
    1.4: rewrite_goal de_morgan_thm1 sym=false
    1.4: apply_backward_step disjI2
    1.4: rewrite_goal not_le sym=false
    1.4: rewrite_goal nat_less_def_2 sym=false
    1.4: apply_backward_step disjI1
    1.4: apply_backward_step eq_refl
    1.11: rewrite_fact if_not_P @1.3,1.10 sym=false
    1.12: rewrite_goal_with_prev @1.11
    1.12: rewrite_fact monoidal_def @0 sym=false
    1.13: apply_forward_step conjD1 @1.12
    1.14: apply_prev @1.13
    2: introduction
    2.1: rewrite_goal if_not_P @2.0 sym=false
  qed

theorem iterate_natseg_0_lt
  fixes f :: nat ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟶ iterate op ({i. i < 0}) f = neutral op
  [hint_backward]
  proof
    1: rewrite_goal natseg_clauses_lt_1 sym=false
    1: apply_backward_step iterate_empty
  qed

theorem iterate_natseg_Suc_lt
  fixes f :: nat ⇒ 'a, k :: nat, op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟶ iterate op ({i. i < Suc k}) f = op (iterate op ({i. i < k}) f) (f k)
  [hint_backward]
  proof
    1: rewrite_goal natseg_clauses_lt_2 sym=false
    1: apply_forward_step iterate_insert @0 param_f=f param_s="{i. i < k}" param_x=k
    2: cut "finite ({i. i < k})"
    2: apply_backward_step finite_natseg_lt
    3: apply_fact @1,2
    4: cut "~(k ∈ {i. i < k})"
    4: rewrite_goal member_collect sym=false
    4: rewrite_goal not_lt sym=false
    4: apply_backward_step less_eq_refl
    7: rewrite_fact if_not_P @3,6 sym=false
    8: rewrite_fact monoidal_def @0 sym=false
    9: apply_forward_step conjD1 @8
    10: rewrite_goal_with_prev @7
    10: apply_prev @9
  qed

theorem iterate_natseg_0_le
  fixes f :: nat ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟶ iterate op ({i. i ≤ 0}) f = f 0
  [hint_backward]
  proof
    1: rewrite_goal natseg_clauses_le_1 sym=false
    1: apply_backward_step iterate_sing
  qed

theorem iterate_natseg_Suc_le
  fixes f :: nat ⇒ 'a, k :: nat, op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟶ iterate op ({i. i ≤ Suc k}) f = op (iterate op ({i. i ≤ k}) f) (f (Suc k))
  [hint_backward]
  proof
    1: rewrite_goal natseg_clauses_le_2 sym=false
    1: apply_forward_step iterate_insert @0 param_f=f param_s="{i. i ≤ k}" param_x="Suc k"
    2: cut "finite ({i. i ≤ k})"
    2: apply_backward_step finite_natseg_le
    3: apply_fact @1,2
    4: cut "~(Suc k ∈ {i. i ≤ k})"
    4: rewrite_goal member_collect sym=false
    4: rewrite_goal not_le sym=false
    4: rewrite_goal nat_less_def_2 sym=false
    4: apply_backward_step disjI1
    4: apply_backward_step eq_refl
    9: rewrite_fact if_not_P @3,8 sym=false
    10: rewrite_goal_with_prev @9
    10: rewrite_fact monoidal_def @0 sym=false
    11: apply_forward_step conjD1 @10
    12: apply_prev @11
  qed

theorem iterate_pair
  fixes f :: nat ⇒ 'a, m :: nat, n :: nat, op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟶ iterate op ({2 * m..2 * n + 1}) f = iterate op ({m..n}) (λi. op (f (2 * i)) (f (2 * i + 1)))
  [hint_backward]
  proof
    1: induction n nat_induct
    1: rewrite_goal natseg_0 sym=false
    1: cases "m = 0"
    1: introduction
    1.1: rewrite_goal if_P @1.0 sym=false
    1.1: rewrite_goal_with_prev @1.0
    1.1: apply_forward_step iterate_sing @0 param_f="(λi. op (f (2 * i)) (f (2 * i + 1)))" param_x="(0::nat)"
    1.2: rewrite_goal_with_prev @1.1
    1.2: rewrite_goal mult_0_right sym=false
    1.2: rewrite_goal nat_one_def sym=false
    1.2: rewrite_goal nat_plus_def_1 sym=false
    1.2: rewrite_goal natseg_Suc sym=false
    1.2: cut "0 ≤ Suc 0"
    1.2: apply_backward_step le_0
    1.3: rewrite_goal if_P @1.2 sym=false
    1.3: rewrite_goal natseg_sing sym=false
    1.3: apply_forward_step iterate_insert @0 param_f=f param_s="{(0::nat)}" param_x="Suc 0"
    1.4: cut "finite ({(0::nat)})"
    1.4: apply_backward_step finite_insert
    1.4: apply_backward_step finite_empty
    1.6: apply_fact @1.3,1.5
    1.7: cut "~(Suc 0 ∈ {0})"
    1.7: rewrite_goal member_insert sym=false
    1.7: rewrite_goal de_morgan_thm2 sym=false
    1.7: apply_backward_step conjI
    1.7: rewrite_goal eq_sym_eq sym=false
    1.7: apply_backward_step nat_zero_Suc_neq
    1.9: apply_backward_step member_empty
    1.13: rewrite_fact if_not_P @1.6,1.12 sym=false
    1.14: rewrite_goal_with_prev @1.13
    1.14: apply_forward_step iterate_sing @0 param_f=f param_x="(0::nat)"
    1.15: rewrite_goal_with_prev @1.14
    1.15: rewrite_fact monoidal_def @0 sym=false
    1.16: apply_forward_step conjD1 @1.15
    1.17: apply_prev @1.16
    2: introduction
    2.1: rewrite_goal if_not_P @2.0 sym=false
    2.1: cut "{2 * m..2 * 0 + 1} = {}"
    2.1: rewrite_goal natseg_empty sym=false
    2.1: z3 @2.0
    2.3: rewrite_goal_with_prev @2.2
    2.3: apply_forward_step iterate_empty @0 param_f="(λi. op (f (2 * i)) (f (2 * i + 1)))"
    2.4: rewrite_goal_with_prev @2.3
    2.4: apply_backward_step iterate_empty @0
    5: introduction n
    5.2: cases "m <= Suc n"
    5.2: introduction
    5.2.1: cut "2 * Suc n + 1 = Suc (2 * Suc n)"
    5.2.1: rewrite_goal add_1_right sym=false
    5.2.2: rewrite_goal_with_prev @5.2.1
    5.2.2: apply_forward_step iterate_natseg_Suc @0 param_f=f param_m="2 * m" param_n="2 * Suc n"
    5.2.3: cut "2 * m ≤ Suc (2 * Suc n)"
    5.2.3: rewrite_goal nat_less_eq_def_2 sym=false
    5.2.3: apply_backward_step disjI2
    5.2.3: apply_backward_step le_mult2
    5.2.3: apply_backward_step less_eq_refl
    5.2.7: rewrite_fact if_P @5.2.2,5.2.6 sym=false
    5.2.8: rewrite_goal_with_prev @5.2.7
    5.2.8: cut "2 * Suc n = Suc(2 * n + 1)"
    5.2.8: rewrite_goal add_1_right sym=true
    5.2.8: nat_norm
    5.2.10: cut "iterate op ({2 * m..2 * Suc n}) f = iterate op ({2 * m..Suc (2 * n + 1)}) f"
    5.2.10: rewrite_goal_with_prev @5.2.9
    5.2.11: rewrite_goal_with_prev @5.2.10
    5.2.11: apply_forward_step iterate_natseg_Suc @0 param_f=f param_m="2 * m" param_n="2 * n + 1"
    5.2.12: cut "2 * m ≤ Suc (2 * n + 1)"
    5.2.12: rewrite_goal add_1_right sym=true
    5.2.12: rewrite_fact add_1_right @5.2.0 sym=true
    5.2.13: z3 @5.2.12
    5.2.15: rewrite_fact if_P @5.2.11,5.2.14 sym=false
    5.2.16: rewrite_goal_with_prev @5.2.15
    5.2.16: apply_forward_step iterate_natseg_Suc @0 param_f="(λi. op (f (2 * i)) (f (2 * i + 1)))" param_m=m param_n=n
    5.2.17: rewrite_fact if_P @5.2.16,5.2.0 sym=false
    5.2.18: rewrite_goal_with_prev @5.2.17
    5.2.18: rewrite_goal_with_prev @5.1
    5.2.18: apply_forward_step monoidal_ac @0
    5.2.19: apply_forward_step conjD2 @5.2.18
    5.2.20: apply_forward_step conjD2 @5.2.19
    5.2.21: apply_forward_step conjD2 @5.2.20
    5.2.22: apply_forward_step conjD1 @5.2.21
    5.2.23: rewrite_goal_with_prev @5.2.22
    5.2.23: rewrite_goal_with_prev @5.2.1
    5.2.23: rewrite_goal_with_prev @5.2.9
    5.3: introduction
    5.3.1: rewrite_fact not_le @5.3.0 sym=false
    5.3.2: cut "{m..Suc n} = {}"
    5.3.2: apply_backward_step natseg_emptyI @5.3.1
    5.3.3: rewrite_goal_with_prev @5.3.2
    5.3.3: apply_forward_step iterate_empty @0 param_f="(λi. op (f (2 * i)) (f (2 * i + 1)))"
    5.3.4: rewrite_goal_with_prev @5.3.3
    5.3.4: cut "{2 * m..2 * Suc n + 1} = {}"
    5.3.4: rewrite_goal natseg_empty sym=false
    5.3.4: rewrite_goal add_1_right sym=true
    5.3.4: rewrite_fact add_1_right @5.3.1 sym=true
    5.3.5: z3 @5.3.4
    5.3.8: rewrite_goal_with_prev @5.3.7
    5.3.8: apply_backward_step iterate_empty
  qed

theorem iterate_reflect
  fixes m :: nat, n :: nat, op :: 'a ⇒ 'a ⇒ 'a, x :: nat ⇒ 'a
  prop monoidal op ⟶ iterate op ({m..n}) x = (if n < m then neutral op else iterate op ({0..n - m}) (λi. x (n - i)))
  [hint_backward]
  proof
    1: rewrite_goal natseg_empty sym=true
    1: cases "{m..n} = ∅"
    1: introduction
    1.1: rewrite_goal if_P @1.0 sym=false
    1.1: rewrite_goal_with_prev @1.0
    1.1: apply_backward_step iterate_empty
    2: introduction
    2.1: rewrite_goal if_not_P @2.0 sym=false
    2.1: rewrite_fact natseg_empty @2.0 sym=false
    2.2: rewrite_fact not_lt @2.1 sym=false
    2.3: apply_forward_step iterate_image @0 param_f="(λi. (n - i))" param_g=x param_s="{0..n - m}"
    2.4: rewrite_fact comp_fun_def @2.3 sym=false
    2.5: rewrite_fact member_natseg @2.4 sym=false
    2.6: cut "image (λi. n - i) ({0..n - m}) = {m..n}"
    2.6: apply_backward_step member_ext
    2.6: rewrite_goal in_image sym=false
    2.6: rewrite_goal member_natseg sym=false
    2.6: z3 @2.2
    2.10: rewrite_fact_with_prev @2.9,2.5
    2.11: apply_prev @2.10
    2.11: introduction x,y
    2.11.5: z3 @2.11.2,2.11.3,2.11.4
  qed
