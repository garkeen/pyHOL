theory iterate
imports set, real
description "Basic results about iterate."

const neutral :: ('a ⇒ 'a ⇒ 'a) ⇒ 'a

const monoidal :: ('a ⇒ 'a ⇒ 'a) ⇒ bool

const itset :: ('b ⇒ 'a ⇒ 'a) ⇒ 'b set ⇒ 'a ⇒ 'a

def nat_interval :: nat ⇒ nat ⇒ nat set = {m..n} = {p. m ≤ p ∧ p ≤ n} [hint_rewrite]

theorem finite_natseg
  fixes m :: nat, n :: nat
  prop finite ({m..n})
  [hint_backward]
  proof
    0: apply_backward_step finite_subset param_t="{x. x <= n}"
    0: apply_backward_step finite_natseg_le
    1: rewrite_goal nat_interval_def sym=false
    1: z3
  qed

theorem natseg_combine_r
  fixes m :: nat, n :: nat, p :: nat
  prop m ≤ p + 1 ⟶ p ≤ n ⟶ {m..p} ∪ {p + 1..n} = {m..n}
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal nat_interval_def sym=false
    2: z3 @0,1
  qed

theorem natseg_combine_l
  fixes m :: nat, n :: nat, p :: nat
  prop m ≤ p ⟶ p ≤ n + 1 ⟶ {m..p - 1} ∪ {p..n} = {m..n}
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal nat_interval_def sym=false
    2: z3 @0,1
  qed

theorem natseg_lrec
  fixes m :: nat, n :: nat
  prop m ≤ n ⟶ {m..n} = insert m ({m + 1..n})
  [hint_backward]
  proof
    1: rewrite_goal nat_interval_def sym=false
    1: z3 @0
  qed

theorem natseg_rrec
  fixes m :: nat, n :: nat
  prop m ≤ n ⟶ insert n ({m..n - 1}) = {m..n}
  [hint_backward]
  proof
    1: rewrite_goal nat_interval_def sym=false
    1: z3 @0
  qed

theorem natseg_rec
  fixes m :: nat, n :: nat
  prop m ≤ Suc n ⟶ {m..Suc n} = insert (Suc n) ({m..n})
  [hint_backward]
  proof
    1: apply_forward_step natseg_rrec @0
    2: rewrite_fact suc_sub1 @1 sym=false
    3: rewrite_goal_with_prev @2
  qed

theorem member_natseg
  fixes m :: nat, n :: nat, p :: nat
  prop p ∈ {m..n} ⟷ m ≤ p ∧ p ≤ n
  [hint_rewrite]
  proof
    0: rewrite_goal nat_interval_def sym=false
    0: rewrite_goal member_collect sym=false
  qed

theorem member_natseg_0
  fixes n :: nat, p :: nat
  prop p ∈ {0..n} ⟷ p ≤ n
  [hint_rewrite]
  proof
    0: rewrite_goal member_natseg sym=false
    0: z3
  qed

theorem natseg_empty
  fixes m :: nat, n :: nat
  prop {m..n} = ∅ ⟷ n < m
  [hint_rewrite]
  proof
    0: rewrite_goal set_equal_iff sym=false
    0: rewrite_goal member_natseg sym=false
    0: z3
  qed

theorem natseg_emptyI
  fixes m :: nat, n :: nat
  prop n < m ⟶ {m..n} = ∅
  [hint_backward]
  proof
    1: rewrite_goal natseg_empty sym=false
  qed

theorem natseg_sing
  fixes n :: nat
  prop {n..n} = {n}
  [hint_rewrite]
  proof
    0: rewrite_goal nat_interval_def sym=false
    0: z3
  qed

theorem finite_subset_natseg
  fixes s :: nat set
  prop finite s ⟷ (∃n. s ⊆ {0..n})
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: rewrite_goal subset_def sym=""
    0.1: rewrite_goal member_natseg_0 sym=false
    0.1: apply_backward_step finite_induct_strong @0.0
    0.1: inst_exists_goal "(0::nat)"
    0.1: introduction x
    0.1.2: apply_resolve_step member_empty @0.1.1
    0.3: introduction a,s
    0.3.4: rewrite_goal member_insert sym=false
    0.3.4: exists_elim n @0.3.2
    0.3.6: inst_exists_goal "max a n"
    0.3.6: introduction x
    0.3.6.2: rewrite_goal max_def sym=false
    0.3.6.2: apply_backward_step disjE @0.3.6.1
    0.3.6.2: introduction
    0.3.6.2.1: rewrite_goal_with_prev @0.3.6.2.0
    0.3.6.2.1: cases "a ≤ n"
    0.3.6.2.1: introduction
    0.3.6.2.1.1: rewrite_goal if_P @0.3.6.2.1.0 sym=false
    0.3.6.2.2: introduction
    0.3.6.2.2.1: rewrite_goal if_not_P @0.3.6.2.2.0 sym=false
    0.3.6.2.2.1: apply_backward_step less_eq_refl
    0.3.6.3: introduction
    0.3.6.3.1: cases "a ≤ n"
    0.3.6.3.1: introduction
    0.3.6.3.1.1: rewrite_goal if_P @0.3.6.3.1.0 sym=false
    0.3.6.3.1.1: apply_prev @0.3.5
    0.3.6.3.2: introduction
    0.3.6.3.2.1: rewrite_goal if_not_P @0.3.6.3.2.0 sym=false
    0.3.6.3.2.1: apply_backward_step less_eq_trans param_m=n
    0.3.6.3.2.1: apply_prev @0.3.5
    0.3.6.3.2.2: apply_forward_step le_cases param_m=n param_n=a
    0.3.6.3.2.3: apply_backward_step disjE @0.3.6.3.2.2
    0.3.6.3.2.4: introduction
    0.3.6.3.2.4.1: apply_backward_step negE_gen @0.3.6.3.2.0,0.3.6.3.2.4.0
    1: introduction
    1.1: exists_elim n @1.0
    1.3: apply_backward_step finite_subset param_t={0..n}
    1.3: apply_backward_step finite_natseg
  qed

theorem card_natseg_lemma
  fixes d :: nat, m :: nat
  prop card ({m..m + d}) = d + 1
  [hint_rewrite]
  proof
    0: induction d nat_induct
    0: rewrite_goal nat_plus_def_1 sym=false
    0: rewrite_goal add_0_right sym=false
    0: rewrite_goal natseg_sing sym=false
    0: rewrite_goal card_sing sym=false
    4: introduction n
    4.2: rewrite_goal nat_plus_def_2 sym=false
    4.2: rewrite_goal add_Suc_right sym=false
    4.2: cut "{m..Suc (m + n)} = insert (Suc (m + n)) ({m..(m + n)})"
    4.2: apply_backward_step natseg_rec
    4.2: rewrite_goal nat_less_eq_def_2 sym=false
    4.2: apply_backward_step disjI2
    4.2: apply_backward_step le_add
    4.6: rewrite_goal_with_prev @4.5
    4.6: cut "finite {m..m + n}"
    4.6: apply_backward_step finite_natseg
    4.7: apply_forward_step card_insert @4.6 param_x="Suc (m + n)"
    4.8: cut "~(Suc (m + n) ∈ {m..m + n})"
    4.8: rewrite_goal member_natseg sym=false
    4.8: rewrite_goal add_1_right sym=true
    4.8: z3
    4.11: rewrite_fact if_not_P @4.7,4.10 sym=false
    4.12: rewrite_fact_with_prev @4.1,4.11
  qed

theorem card_natseg
  fixes m :: nat, n :: nat
  prop card ({m..n}) = n + 1 - m
  [hint_rewrite]
  proof
    0: apply_forward_step let_cases param_m=m param_n=n
    1: apply_backward_step disjE @0
    1: introduction
    1.1: rewrite_fact less_eq_exist @1.0 sym=false
    1.2: exists_elim d @1.1
    1.4: rewrite_goal_with_prev @1.3
    1.4: rewrite_goal card_natseg_lemma sym=false
    1.4: z3
    2: introduction
    2.1: cut "{m..n} = ∅"
    2.1: rewrite_goal natseg_empty sym=false
    2.2: rewrite_goal_with_prev @2.1
    2.2: rewrite_goal card_empty sym=false
    2.2: z3 @2.0
  qed

theorem has_size_natseg
  fixes m :: nat, n :: nat
  prop has_size ({m..n}) (n + 1 - m)
  [hint_backward]
  proof
    0: rewrite_goal has_size_def sym=false
    0: apply_backward_step conjI
    0: apply_backward_step finite_natseg
    1: rewrite_goal card_natseg sym=false
  qed

theorem card_natseg_1
  fixes n :: nat
  prop card ({1..n}) = n
  [hint_rewrite]
  proof
    0: rewrite_goal card_natseg sym=false
    0: rewrite_goal add_comm sym=false
    0: rewrite_goal nat_plus_minus_2 sym=false
  qed

theorem has_size_natseg_1
  fixes n :: nat
  prop has_size ({1..n}) n
  [hint_backward]
  proof
    0: rewrite_goal has_size_def sym=false
    0: apply_backward_step conjI
    0: apply_backward_step finite_natseg
    1: rewrite_goal card_natseg_1 sym=false
  qed

theorem natseg_0
  fixes m :: nat
  prop {m..0} = (if m = 0 then {0} else ∅)
  [hint_rewrite]
  proof
    0: cases "m = 0"
    0: introduction
    0.1: rewrite_goal if_P @0.0 sym=false
    0.1: rewrite_goal_with_prev @0.0
    0.1: rewrite_goal natseg_sing sym=false
    1: introduction
    1.1: rewrite_goal if_not_P @1.0 sym=false
    1.1: apply_forward_step le_1_1 @1.0
    1.2: apply_backward_step natseg_emptyI @1.1
  qed

theorem natseg_Suc
  fixes m :: nat, n :: nat
  prop {m..Suc n} = (if m ≤ Suc n then insert (Suc n) ({m..n}) else {m..n})
  [hint_rewrite]
  proof
    0: cases "m ≤ Suc n"
    0: introduction
    0.1: rewrite_goal if_P @0.0 sym=false
    0.1: apply_backward_step natseg_rec @0.0
    1: introduction
    1.1: rewrite_goal if_not_P @1.0 sym=false
    1.1: rewrite_fact not_le @1.0 sym=false
    1.2: cut "{m..n} = {}"
    1.2: rewrite_goal natseg_empty sym=false
    1.2: rewrite_fact nat_less_eq_def_2 @1.0 sym=false
    1.3: rewrite_fact de_morgan_thm2 @1.2 sym=false
    1.4: rewrite_fact not_le @1.3 sym=false
    1.5: apply_backward_step conjD2 @1.4
    1.7: rewrite_goal_with_prev @1.6
    1.7: rewrite_goal natseg_empty sym=false
  qed

theorem inter_natseg
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop {m..n} ∩ {p..q} = {max m p..min n q}
  [hint_rewrite]
  proof
    0: rewrite_goal nat_interval_def sym=false
    0: z3
  qed

theorem disjoint_natseg
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop disjoint ({m..n}) ({p..q}) ⟷ n < p ∨ q < m ∨ n < m ∨ q < p
  [hint_rewrite]
  proof
    0: rewrite_goal disjoint_def sym=false
    0: rewrite_goal inter_natseg sym=false
    0: rewrite_goal natseg_empty sym=false
    0: z3
  qed

theorem natseg_add_split
  fixes m :: nat, n :: nat, p :: nat
  prop m ≤ n + 1 ⟶ {m..n + p} = {m..n} ∪ {n + 1..n + p}
  [hint_backward]
  proof
    1: apply_backward_step member_ext
    1: rewrite_goal member_union_iff sym=false
    1: rewrite_goal member_natseg sym=false
    1: z3 @0
  qed

theorem natseg_offset_image
  fixes m :: nat, n :: nat, p :: nat
  prop {m + p..n + p} = image (λi. i + p) ({m..n})
  [hint_rewrite]
  proof
    0: apply_backward_step member_ext
    0: rewrite_goal in_image sym=false
    0: rewrite_goal member_natseg sym=false
    0: z3
  qed

theorem subset_natseg
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop {m..n} ⊆ {p..q} ⟷ n < m ∨ p ≤ m ∧ n ≤ q
  [hint_rewrite]
  proof
    0: rewrite_goal subset_def sym=""
    0: rewrite_goal member_natseg sym=false
    0: z3
  qed

theorem natseg_le
  fixes n :: nat
  prop {x. x ≤ n} = {0..n}
  [hint_rewrite]
  proof
    0: apply_backward_step member_ext
    0: rewrite_goal member_natseg_0 sym=false
    0: rewrite_goal member_collect sym=false
    0: introduction x
    0.1: apply_backward_step eq_refl
  qed

theorem natseg_lt
  fixes n :: nat
  prop {x. x < n} = (if n = 0 then ∅ else {0..n - 1})
  [hint_rewrite]
  proof
    0: apply_backward_step member_ext
    0: cases "n = 0"
    0: introduction
    0.1: rewrite_goal if_P @0.0 sym=false
    0.1: rewrite_goal_with_prev @0.0
    0.1: z3
    1: introduction
    1.1: rewrite_goal if_not_P @1.0 sym=false
    1.1: rewrite_goal member_natseg_0 sym=false
    1.1: rewrite_goal member_collect sym=false
    1.1: z3 @1.0
  qed

def neutral :: ('a ⇒ 'a ⇒ 'a) ⇒ 'a = neutral op = (THE x. ∀y. op x y = y ∧ op y x = y) [hint_rewrite]

def monoidal :: ('a ⇒ 'a ⇒ 'a) ⇒ bool = monoidal op ⟷ (∀x. ∀y. op x y = op y x) ∧ (∀x. ∀y. ∀z. op x (op y z) = op (op x y) z) ∧ (∀x. op (neutral op) x = x) [hint_rewrite]

theorem monoidal_ac
  fixes op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟶ (∀a. op (neutral op) a = a) ∧ (∀a. op a (neutral op) = a) ∧ (∀a. ∀b. op a b = op b a) ∧ (∀a. ∀b. ∀c. op (op a b) c = op a (op b c)) ∧ (∀a. ∀b. ∀c. op a (op b c) = op b (op a c))
  [hint_backward,hint_forward]
  proof
    1: rewrite_fact monoidal_def @0
    2: apply_backward_step conjI
    2: apply_forward_step conjD1 @1
    3: apply_forward_step conjD2 @1
    4: apply_backward_step conjD2 @3
    5: apply_backward_step conjI
    5: introduction a
    5.1: forall_elim a @2
    5.2: forall_elim "(neutral op)" @5.1
    5.3: rewrite_goal_with_prev @5.2
    5.3: apply_prev @4
    6: apply_backward_step conjI
    6: apply_backward_step conjI
    6: introduction a,b,c
    6.3: rewrite_goal eq_sym_eq sym=false
    6.3: apply_forward_step conjD1 @3
    6.4: apply_prev @6.3
    7: introduction a,b,c
    7.3: forall_elim b @2
    7.4: forall_elim "(op a c)" @7.3
    7.5: rewrite_goal_with_prev @7.4
    7.5: forall_elim b @2
    7.6: forall_elim c @7.5
    7.7: rewrite_goal_with_prev @7.6
    7.7: apply_forward_step conjD1 @3
    7.8: apply_prev @7.7
  qed

def support :: ('a ⇒ 'a ⇒ 'a) ⇒ ('b ⇒ 'a) ⇒ 'b set ⇒ 'b set = support op f s = {x. x ∈ s ∧ ¬(f x = neutral op)} [hint_rewrite]

def iterate :: ('a ⇒ 'a ⇒ 'a) ⇒ 'b set ⇒ ('b ⇒ 'a) ⇒ 'a = iterate op s f = (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op) [hint_rewrite]

theorem in_support
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set, x :: 'b
  prop x ∈ support op f s ⟷ x ∈ s ∧ ¬(f x = neutral op)
  [hint_rewrite]
  proof
    0: rewrite_goal support_def sym=false
    0: rewrite_goal member_collect sym=false
  qed

theorem support_support
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set
  prop support op f (support op f s) = support op f s
  [hint_rewrite]
  proof
    0: rewrite_goal support_def sym=false
    0: rewrite_goal in_support sym=false
    0: apply_backward_step member_ext
    0: introduction x
    0.1: rewrite_goal member_collect sym=false
    0.1: apply_backward_step iffI
    0.1: introduction
    0.1.1: apply_backward_step conjD1 @0.1.0
    0.2: introduction
    0.2.1: apply_backward_step conjI @0.2.0
    0.2.1: apply_backward_step conjD2 @0.2.0
  qed

theorem support_eq_empty
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set
  prop (∀x. x ∈ s ⟶ f x = neutral op) ⟷ support op f s = ∅
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step member_ext
    0.1: introduction x
    0.1.1: rewrite_goal in_support sym=false
    0.1.1: rewrite_goal member_empty_simp sym=false
    0.1.1: apply_backward_step iffI
    0.1.1: introduction
    0.1.1.1: apply_forward_step conjD1 @0.1.1.0
    0.1.1.2: apply_forward_step conjD2 @0.1.1.0
    0.1.1.3: apply_fact @0.0,0.1.1.1
    0.1.1.4: apply_backward_step negE @0.1.1.2
    0.1.1.4: rewrite_fact_with_prev @0.1.1.3,0.1.1.2
    0.1.2: z3
    1: introduction
    1.1: rewrite_fact set_equal_iff @1.0 sym=false
    1.2: introduction x
    1.2.2: forall_elim x @1.1
    1.2.3: rewrite_fact in_support @1.2.2 sym=false
    1.2.4: rewrite_fact member_empty_simp @1.2.3 sym=false
    1.2.5: cut "x ∈ s ∧ ¬(f x = neutral op) --> false"
    1.2.5: introduction
    1.2.5.1: rewrite_fact_with_prev @1.2.4,1.2.5.0
    1.2.6: cut "~(x ∈ s ∧ ¬(f x = neutral op))"
    1.2.6: rewrite_goal_with_prev @1.2.4
    1.2.6: z3
    1.2.8: rewrite_fact de_morgan_thm1 @1.2.7 sym=false
    1.2.9: apply_backward_step disjE @1.2.8
    1.2.9: introduction
    1.2.9.1: apply_backward_step negE_gen @1.2.9.0,1.2.1
    1.2.10: cut "!A::bool. (~~A) = A"
    1.2.10: z3
    1.2.11: forall_elim "(f x = neutral op)" @1.2.10
    1.2.12: introduction
    1.2.12.1: rewrite_fact_with_prev @1.2.11,1.2.12.0
  qed

theorem support_subset
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set
  prop support op f s ⊆ s
  [hint_backward]
  proof
    0: apply_backward_step subsetI
    0: introduction x
    0.2: rewrite_fact in_support @0.1 sym=false
    0.3: apply_backward_step conjD1 @0.2
  qed

theorem finite_support
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set
  prop finite s ⟶ finite (support op f s)
  [hint_backward]
  proof
    1: apply_backward_step finite_subset param_t=s
    1: apply_backward_step support_subset
  qed

theorem support_empty
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a
  prop support op f ∅ = ∅
  [hint_rewrite]
  proof
    0: rewrite_goal support_def sym=false
    0: z3
  qed

theorem support_insert
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set, x :: 'b
  prop support op f (insert x s) = (if f x = neutral op then support op f s else insert x (support op f s))
  [hint_rewrite]
  proof
    0: cases "f x = neutral op"
    0: introduction
    0.1: rewrite_goal if_P @0.0 sym=false
    0.1: rewrite_goal support_def sym=false
    0.1: apply_backward_step member_ext
    0.1: rewrite_goal member_insert sym=false
    0.1: introduction x1
    0.1.1: rewrite_goal member_collect sym=false
    0.1.1: apply_backward_step iffI
    0.1.1: introduction
    0.1.1.1: apply_forward_step conjD1 @0.1.1.0
    0.1.1.2: apply_forward_step conjD2 @0.1.1.0
    0.1.1.3: apply_backward_step conjI
    0.1.1.3: apply_backward_step disjE @0.1.1.1
    0.1.1.3: introduction
    0.1.1.3.1: rewrite_fact_with_prev @0.1.1.3.0,0.1.1.2
    0.1.1.3.2: apply_backward_step negE_gen @0.1.1.3.1,0.0
    0.1.2: introduction
    0.1.2.1: apply_forward_step conjD1 @0.1.2.0
    0.1.2.2: apply_forward_step conjD2 @0.1.2.0
    0.1.2.3: apply_backward_step conjI
    0.1.2.3: apply_backward_step disjI2
    1: introduction
    1.1: rewrite_goal if_not_P @1.0 sym=false
    1.1: apply_backward_step member_ext
    1.1: rewrite_goal in_support sym=false
    1.1: rewrite_goal member_insert sym=false
    1.1: rewrite_goal in_support sym=false
    1.1: introduction x1
    1.1.1: apply_backward_step iffI
    1.1.1: introduction
    1.1.1.1: apply_forward_step conjD1 @1.1.1.0
    1.1.1.2: apply_forward_step conjD2 @1.1.1.0
    1.1.1.3: apply_backward_step disjE @1.1.1.1
    1.1.1.3: introduction
    1.1.1.3.1: apply_backward_step disjI1
    1.1.1.4: introduction
    1.1.1.4.1: apply_backward_step disjI2
    1.1.1.4.1: apply_backward_step conjI
    1.1.2: introduction
    1.1.2.1: apply_backward_step disjE @1.1.2.0
    1.1.2.1: introduction
    1.1.2.1.1: apply_backward_step conjI
    1.1.2.1.1: apply_backward_step disjI1
    1.1.2.1.2: rewrite_goal_with_prev @1.1.2.1.0
    1.1.2.2: introduction
    1.1.2.2.1: apply_forward_step conjD1 @1.1.2.2.0
    1.1.2.2.2: apply_forward_step conjD2 @1.1.2.2.0
    1.1.2.2.3: apply_backward_step conjI
    1.1.2.2.3: apply_backward_step disjI2
  qed

theorem support_union
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set, t :: 'b set
  prop support op f (s ∪ t) = support op f s ∪ support op f t
  [hint_rewrite]
  proof
    0: rewrite_goal support_def sym=false
    0: apply_backward_step member_ext
