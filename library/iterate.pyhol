theory iterate
imports set, real
description "Basic results about iterate."

const neutral :: ('a ⇒ 'a ⇒ 'a) ⇒ 'a

const monoidal :: ('a ⇒ 'a ⇒ 'a) ⇒ bool

const itset :: ('b ⇒ 'a ⇒ 'a) ⇒ 'b set ⇒ 'a ⇒ 'a

def nat_interval :: nat ⇒ nat ⇒ nat set = {m..n} = {p. m ≤ p ∧ p ≤ n} [hint_rewrite]

theorem finite_natseg
  fixes m :: nat, n :: nat
  prop finite ({m..n})
  [hint_backward]

theorem natseg_combine_r
  fixes m :: nat, n :: nat, p :: nat
  prop m <= p + 1 --> p <= n --> {m..p} Un {p + 1..n} = {m..n}
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m ≤ p + 1
    #[2] p ≤ n
    #[3] {m..p} ∪ {p + 1..n} = {m..n}
  ← rewrite nat_interval_def sym=false goal=3
    #[4] {p1. m ≤ p1 ∧ p1 ≤ p} ∪ {p1. p + 1 ≤ p1 ∧ p1 ≤ n} = {p1. m ≤ p1 ∧ p1 ≤ n}
  ← z3 goal=4 facts=[1,2]
qed

theorem natseg_combine_l
  fixes m :: nat, n :: nat, p :: nat
  prop m <= p --> p <= n + 1 --> {m..p - 1} Un {p..n} = {m..n}
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] m ≤ p
    #[2] p ≤ n + 1
    #[3] {m..p - 1} ∪ {p..n} = {m..n}
  ← rewrite nat_interval_def sym=false goal=3
    #[4] {p1. m ≤ p1 ∧ p1 ≤ p - 1} ∪ {p1. p ≤ p1 ∧ p1 ≤ n} = {p1. m ≤ p1 ∧ p1 ≤ n}
  ← z3 goal=4 facts=[1,2]
qed

theorem natseg_lrec
  fixes m :: nat, n :: nat
  prop m <= n --> {m..n} = insert m ({m + 1..n})
  [hint_backward]
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] {m..n} = insert m ({m + 1..n})
  ← rewrite nat_interval_def sym=false goal=2
    #[3] {p. m ≤ p ∧ p ≤ n} = insert m ({p. m + 1 ≤ p ∧ p ≤ n})
  ← z3 goal=3 facts=[1]
qed

theorem natseg_rrec
  fixes m :: nat, n :: nat
  prop m <= n --> insert n ({m..n - 1}) = {m..n}
  [hint_backward]
proof
  ← intro goal=0
    #[1] m ≤ n
    #[2] insert n ({m..n - 1}) = {m..n}
  ← rewrite nat_interval_def sym=false goal=2
    #[3] insert n ({p. m ≤ p ∧ p ≤ n - 1}) = {p. m ≤ p ∧ p ≤ n}
  ← z3 goal=3 facts=[1]
qed

theorem natseg_rec
  fixes m :: nat, n :: nat
  prop m <= Suc n --> {m..Suc n} = insert (Suc n) ({m..n})
  [hint_backward]
proof
  ← intro goal=0
    #[1] m ≤ Suc n
    #[2] {m..Suc n} = insert (Suc n) ({m..n})
  → forward natseg_rrec goal=2 facts=[1]
    #[3] insert (Suc n) ({m..Suc n - 1}) = {m..Suc n}
  → rewrite target=fact suc_sub1 sym=false goal=2 facts=[3]
    #[4] insert (Suc n) ({m..n}) = {m..Suc n}
  ← rewrite source=prev goal=2 facts=[4]
qed

theorem member_natseg
  fixes m :: nat, n :: nat, p :: nat
  prop p Mem {m..n} <--> m <= p & p <= n
  [hint_rewrite]
proof
  ← rewrite nat_interval_def sym=false goal=0
    #[1] p ∈ {p1. m ≤ p1 ∧ p1 ≤ n} ⟷ m ≤ p ∧ p ≤ n
  ← rewrite member_collect sym=false goal=1
qed

theorem member_natseg_0
  fixes n :: nat, p :: nat
  prop p Mem {0..n} <--> p <= n
  [hint_rewrite]
proof
  ← rewrite member_natseg sym=false goal=0
    #[1] 0 ≤ p ∧ p ≤ n ⟷ p ≤ n
  ← z3 goal=1
qed

theorem natseg_empty
  fixes m :: nat, n :: nat
  prop {m..n} = {} <--> n < m
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] (∀x. x ∈ {m..n} ⟷ x ∈ ∅) ⟷ n < m
  ← rewrite member_natseg sym=false goal=1
    #[2] (∀x. m ≤ x ∧ x ≤ n ⟷ x ∈ ∅) ⟷ n < m
  ← z3 goal=2
qed

theorem natseg_emptyI
  fixes m :: nat, n :: nat
  prop n < m --> {m..n} = {}
  [hint_backward]
proof
  ← intro goal=0
    #[1] n < m
    #[2] {m..n} = ∅
  ← rewrite natseg_empty sym=false goal=2
qed

theorem natseg_sing
  fixes n :: nat
  prop {n..n} = {n}
  [hint_rewrite]
proof
  ← rewrite nat_interval_def sym=false goal=0
    #[1] {p. n ≤ p ∧ p ≤ n} = {n}
  ← z3 goal=1
qed

theorem finite_subset_natseg
  fixes s :: nat set
  prop finite s <--> (?n. s Sub {0..n})
  [hint_rewrite]

theorem card_natseg_lemma
  fixes d :: nat, m :: nat
  prop card ({m..m + d}) = d + 1
  [hint_rewrite]

theorem card_natseg
  fixes m :: nat, n :: nat
  prop card ({m..n}) = n + 1 - m
  [hint_rewrite]

theorem has_size_natseg
  fixes m :: nat, n :: nat
  prop has_size ({m..n}) (n + 1 - m)
  [hint_backward]
proof
  ← rewrite has_size_def sym=false goal=0
    #[1] finite ({m..n}) ∧ card ({m..n}) = n + 1 - m
  ← rule conjI goal=1
    #[2] finite ({m..n})
    #[3] card ({m..n}) = n + 1 - m
  ← rule finite_natseg goal=2
  ← rewrite card_natseg sym=false goal=3
qed

theorem card_natseg_1
  fixes n :: nat
  prop card ({1..n}) = n
  [hint_rewrite]
proof
  ← rewrite card_natseg sym=false goal=0
    #[1] n + 1 - 1 = n
  ← rewrite add_comm sym=false goal=1
    #[2] 1 + n - 1 = n
  ← rewrite nat_plus_minus_2 sym=false goal=2
qed

theorem has_size_natseg_1
  fixes n :: nat
  prop has_size ({1..n}) n
  [hint_backward]
proof
  ← rewrite has_size_def sym=false goal=0
    #[1] finite ({1..n}) ∧ card ({1..n}) = n
  ← rule conjI goal=1
    #[2] finite ({1..n})
    #[3] card ({1..n}) = n
  ← rule finite_natseg goal=2
  ← rewrite card_natseg_1 sym=false goal=3
qed

theorem natseg_0
  fixes m :: nat
  prop {m..0} = (if m = 0 then {0} else {})
  [hint_rewrite]
proof
  ← cases "m = 0" goal=0
    #[1] m = 0 ⟶ {m..0} = (if m = 0 then {0} else ∅)
    #[2] ¬(m = 0) ⟶ {m..0} = (if m = 0 then {0} else ∅)
  ← intro goal=1
    #[3] m = 0
    #[4] {m..0} = (if m = 0 then {0} else ∅)
  ← rewrite if_P sym=false goal=4 facts=[3]
    #[5] {m..0} = {0}
  ← rewrite source=prev goal=5 facts=[3]
    #[6] {0..0} = {0}
  ← rewrite natseg_sing sym=false goal=6
    #[7] {0..0} = {0}
  ← intro goal=2
    #[8] ¬(m = 0)
    #[9] {m..0} = (if m = 0 then {0} else ∅)
  ← rewrite if_not_P sym=false goal=9 facts=[8]
    #[10] {m..0} = ∅
  → forward le_1_1 goal=10 facts=[8]
    #[11] 0 < m
  ← rule natseg_emptyI goal=10 facts=[11]
qed

theorem natseg_Suc
  fixes m :: nat, n :: nat
  prop {m..Suc n} = (if m <= Suc n then insert (Suc n) ({m..n}) else {m..n})
  [hint_rewrite]
proof
  ← cases "m ≤ Suc n" goal=0
    #[1] m ≤ Suc n ⟶ {m..Suc n} = (if m ≤ Suc n then insert (Suc n) ({m..n}) else {m..n})
    #[2] ¬(m ≤ Suc n) ⟶ {m..Suc n} = (if m ≤ Suc n then insert (Suc n) ({m..n}) else {m..n})
  ← intro goal=1
    #[3] m ≤ Suc n
    #[4] {m..Suc n} = (if m ≤ Suc n then insert (Suc n) ({m..n}) else {m..n})
  ← rewrite if_P sym=false goal=4 facts=[3]
    #[5] {m..Suc n} = insert (Suc n) ({m..n})
  ← rule natseg_rec goal=5 facts=[3]
  ← intro goal=2
    #[6] ¬(m ≤ Suc n)
    #[7] {m..Suc n} = (if m ≤ Suc n then insert (Suc n) ({m..n}) else {m..n})
  ← rewrite if_not_P sym=false goal=7 facts=[6]
    #[8] {m..Suc n} = {m..n}
  → rewrite target=fact not_le sym=false goal=8 facts=[6]
    #[9] Suc n < m
  cut "{m..n} = {}" goal=8
    #[10] {m..n} = ∅
  ← rewrite natseg_empty sym=false goal=10
    #[11] n < m
  → rewrite target=fact nat_less_eq_def_2 sym=false goal=11 facts=[6]
    #[12] ¬(m = Suc n ∨ m ≤ n)
  → rewrite target=fact de_morgan_thm2 sym=false goal=11 facts=[12]
    #[13] ¬(m = Suc n) ∧ ¬(m ≤ n)
  → rewrite target=fact not_le sym=false goal=11 facts=[13]
    #[14] ¬(m = Suc n) ∧ n < m
  ← rule conjD2 goal=11 facts=[14]
  ← rewrite source=prev goal=8 facts=[10]
    #[15] {m..Suc n} = ∅
  ← rewrite natseg_empty sym=false goal=15
qed

theorem inter_natseg
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop {m..n} Int {p..q} = {max m p..min n q}
  [hint_rewrite]
proof
  ← rewrite nat_interval_def sym=false goal=0
    #[1] {p1. m ≤ p1 ∧ p1 ≤ n} ∩ {p1. p ≤ p1 ∧ p1 ≤ q} = {p1. max m p ≤ p1 ∧ p1 ≤ min n q}
  ← z3 goal=1
qed

theorem disjoint_natseg
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop disjoint ({m..n}) ({p..q}) <--> n < p | q < m | n < m | q < p
  [hint_rewrite]
proof
  ← rewrite disjoint_def sym=false goal=0
    #[1] {m..n} ∩ {p..q} = ∅ ⟷ n < p ∨ q < m ∨ n < m ∨ q < p
  ← rewrite inter_natseg sym=false goal=1
    #[2] {max m p..min n q} = ∅ ⟷ n < p ∨ q < m ∨ n < m ∨ q < p
  ← rewrite natseg_empty sym=false goal=2
    #[3] min n q < max m p ⟷ n < p ∨ q < m ∨ n < m ∨ q < p
  ← z3 goal=3
qed

theorem natseg_add_split
  fixes m :: nat, n :: nat, p :: nat
  prop m <= n + 1 --> {m..n + p} = {m..n} Un {n + 1..n + p}
  [hint_backward]

theorem natseg_offset_image
  fixes m :: nat, n :: nat, p :: nat
  prop {m + p..n + p} = image (%i. i + p) ({m..n})
  [hint_rewrite]

theorem subset_natseg
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop {m..n} Sub {p..q} <--> n < m | p <= m & n <= q
  [hint_rewrite]
proof
  ← rewrite subset_def sym="" goal=0
    #[1] (∀x. x ∈ {m..n} ⟶ x ∈ {p..q}) ⟷ n < m ∨ p ≤ m ∧ n ≤ q
  ← rewrite member_natseg sym=false goal=1
    #[2] (∀x. m ≤ x ∧ x ≤ n ⟶ p ≤ x ∧ x ≤ q) ⟷ n < m ∨ p ≤ m ∧ n ≤ q
  ← z3 goal=2
qed

theorem natseg_le
  fixes n :: nat
  prop {x. x <= n} = {0..n}
  [hint_rewrite]

theorem natseg_lt
  fixes n :: nat
  prop {x. x < n} = (if n = 0 then {} else {0..n - 1})
  [hint_rewrite]

def neutral :: ('a ⇒ 'a ⇒ 'a) ⇒ 'a = neutral op = (THE x. ∀y. op x y = y ∧ op y x = y) [hint_rewrite]

def monoidal :: ('a ⇒ 'a ⇒ 'a) ⇒ bool = monoidal op ⟷ (∀x. ∀y. op x y = op y x) ∧ (∀x. ∀y. ∀z. op x (op y z) = op (op x y) z) ∧ (∀x. op (neutral op) x = x) [hint_rewrite]

theorem monoidal_ac
  fixes op :: 'a => 'a => 'a
  prop monoidal op --> (!a. op (neutral op) a = a) & (!a. op a (neutral op) = a) & (!a. !b. op a b = op b a) & (!a. !b. !c. op (op a b) c = op a (op b c)) & (!a. !b. !c. op a (op b c) = op b (op a c))
  [hint_backward,hint_forward]

def support :: ('a ⇒ 'a ⇒ 'a) ⇒ ('b ⇒ 'a) ⇒ 'b set ⇒ 'b set = support op f s = {x. x ∈ s ∧ ¬(f x = neutral op)} [hint_rewrite]

def iterate :: ('a ⇒ 'a ⇒ 'a) ⇒ 'b set ⇒ ('b ⇒ 'a) ⇒ 'a = iterate op s f = (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op) [hint_rewrite]

theorem in_support
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, x :: 'b
  prop x Mem support op f s <--> x Mem s & ~(f x = neutral op)
  [hint_rewrite]
proof
  ← rewrite support_def sym=false goal=0
    #[1] x ∈ {x1. x1 ∈ s ∧ ¬(f x1 = neutral op)} ⟷ x ∈ s ∧ ¬(f x = neutral op)
  ← rewrite member_collect sym=false goal=1
qed

theorem support_support
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop support op f (support op f s) = support op f s
  [hint_rewrite]

theorem support_eq_empty
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop (!x. x Mem s --> f x = neutral op) <--> support op f s = {}
  [hint_rewrite]

theorem support_subset
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop support op f s Sub s
  [hint_backward]

theorem finite_support
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop finite s --> finite (support op f s)
  [hint_backward]

theorem support_empty
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a
  prop support op f {} = {}
  [hint_rewrite]
proof
  ← rewrite support_def sym=false goal=0
    #[1] {x. x ∈ ∅ ∧ ¬(f x = neutral op)} = ∅
  ← z3 goal=1
qed

theorem support_insert
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, x :: 'b
  prop support op f (insert x s) = (if f x = neutral op then support op f s else insert x (support op f s))
  [hint_rewrite]

theorem support_union
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, t :: 'b set
  prop support op f (s Un t) = support op f s Un support op f t
  [hint_rewrite]

theorem support_inter
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, t :: 'b set
  prop support op f (s Int t) = support op f s Int support op f t
  [hint_rewrite]

theorem support_diff
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, t :: 'b set
  prop support op f (diff s t) = diff (support op f s) (support op f t)
  [hint_rewrite]

theorem support_image
  fixes f :: 'b ⇒ 'c, g :: 'c ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set
  prop support op g (image f s) = image f (support op (g ∘ f) s)
  [hint_rewrite]

theorem support_delta
  fixes a :: 'b, f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop support op (%x. if x = a then f x else neutral op) s = (if a Mem s then support op f ({a}) else {})
  [hint_rewrite]

theorem finite_support_delta
  fixes a :: 'b, f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop finite (support op (%x. if x = a then f x else neutral op) s)
  [hint_backward]

theorem iterate_support
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop iterate op (support op f s) f = iterate op s f
  [hint_rewrite]
proof
  ← rewrite iterate_def sym=false goal=0
    #[1] (if finite (support op f (support op f s)) then itset (λx. λa. op (f x) a) (support op f (support op f s)) (neutral op) else neutral op) = (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op)
  ← rewrite support_support sym=false goal=1
qed

theorem iterate_expand_cases
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop iterate op s f = (if finite (support op f s) then iterate op (support op f s) f else neutral op)
  [hint_rewrite]
proof
  ← rewrite iterate_def sym=false goal=0
    #[1] (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op) = (if finite (support op f s) then if finite (support op f (support op f s)) then itset (λx. λa. op (f x) a) (support op f (support op f s)) (neutral op) else neutral op else neutral op)
  ← rewrite support_support sym=false goal=1
    #[2] (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op) = (if finite (support op f s) then if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op else neutral op)
  ← cases "finite (support op f s)" goal=2
    #[3] finite (support op f s) ⟶ (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op) = (if finite (support op f s) then if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op else neutral op)
    #[4] ¬(finite (support op f s)) ⟶ (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op) = (if finite (support op f s) then if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op else neutral op)
  ← intro goal=3
    #[5] finite (support op f s)
    #[6] (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op) = (if finite (support op f s) then if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op else neutral op)
  ← rewrite if_P sym=false goal=6 facts=[5]
    #[7] itset (λx. λa. op (f x) a) (support op f s) (neutral op) = (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op)
  ← rewrite if_P sym=false goal=7 facts=[5]
  ← intro goal=4
    #[8] ¬(finite (support op f s))
    #[9] (if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op) = (if finite (support op f s) then if finite (support op f s) then itset (λx. λa. op (f x) a) (support op f s) (neutral op) else neutral op else neutral op)
  ← rewrite if_not_P sym=false goal=9 facts=[8]
qed

theorem iterate_empty
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a
  prop monoidal op --> iterate op {} f = neutral op
  [hint_backward]

theorem iterate_insert_gen
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, x :: 'b
  prop monoidal op --> finite (support op f s) --> iterate op (insert x s) f = (if x Mem s then iterate op s f else op (f x) (iterate op s f))
  [hint_backward,hint_backward1]

theorem iterate_insert
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, x :: 'b
  prop monoidal op --> finite s --> iterate op (insert x s) f = (if x Mem s then iterate op s f else op (f x) (iterate op s f))
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] monoidal op
    #[2] finite s
    #[3] iterate op (insert x s) f = (if x ∈ s then iterate op s f else op (f x) (iterate op s f))
  ← rule iterate_insert_gen goal=3 facts=[1]
    #[4] finite (support op f s)
  ← rule finite_support goal=4
qed

theorem iterate_union
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, t :: 'b set
  prop monoidal op --> finite s --> finite t --> disjoint s t --> iterate op (s Un t) f = op (iterate op s f) (iterate op t f)
  [hint_backward,hint_backward1]

theorem iterate_diff
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, t :: 'b set
  prop monoidal op --> finite s --> t Sub s --> op (iterate op (diff s t) f) (iterate op t f) = iterate op s f
  [hint_backward,hint_backward1]

theorem iterate_incl_excl
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, t :: 'b set
  prop monoidal op --> finite s --> finite t --> op (iterate op s f) (iterate op t f) = op (iterate op (s Un t) f) (iterate op (s Int t) f)
  [hint_backward,hint_backward1]

theorem iterate_closed
  fixes P :: 'a => bool, f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> P (neutral op) --> (!x. !y. P x --> P y --> P (op x y)) --> (!x. x Mem s & ~(f x = neutral op) --> P (f x)) --> P (iterate op s f)
  [hint_backward,hint_backward1]

theorem iterate_related
  fixes R :: 'a => 'a => bool, f :: 'b => 'a, g :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> R (neutral op) (neutral op) --> (!x1. !y1. !x2. !y2. R x1 x2 --> R y1 y2 --> R (op x1 y1) (op x2 y2)) --> finite s --> (!x. x Mem s --> R (f x) (g x)) --> R (iterate op s f) (iterate op s g)
  [hint_backward,hint_backward1]

theorem iterate_eq_neutral
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> (!x. x Mem s --> f x = neutral op) --> iterate op s f = neutral op
  [hint_backward,hint_backward1]

theorem iterate_sing
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, x :: 'b
  prop monoidal op --> iterate op ({x}) f = f x
  [hint_backward]

theorem iterate_closed_nonempty
  fixes P :: 'a => bool, f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> (!x. !y. P x --> P y --> P (op x y)) --> finite s --> ~(s = {}) --> (!x. x Mem s --> P (f x)) --> P (iterate op s f)
  [hint_backward,hint_backward1]

theorem iterate_related_nonempty
  fixes R :: 'a => 'a => bool, f :: 'b => 'a, g :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> (!x1. !y1. !x2. !y2. R x1 x2 --> R y1 y2 --> R (op x1 y1) (op x2 y2)) --> finite s --> ~(s = {}) --> (!x. x Mem s --> R (f x) (g x)) --> R (iterate op s f) (iterate op s g)
  [hint_backward,hint_backward1]

theorem iterate_delete
  fixes a :: 'b, f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> finite s --> a Mem s --> op (f a) (iterate op (delete s a) f) = iterate op s f
  [hint_backward,hint_backward1]

theorem iterate_delta
  fixes a :: 'b, f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> iterate op s (%x. if x = a then f x else neutral op) = (if a Mem s then f a else neutral op)
  [hint_backward]
proof
  ← intro goal=0
    #[1] monoidal op
    #[2] iterate op s (λx. if x = a then f x else neutral op) = (if a ∈ s then f a else neutral op)
  ← rewrite iterate_support sym=true goal=2
    #[3] iterate op (support op (λx. if x = a then f x else neutral op) s) (λx. if x = a then f x else neutral op) = (if a ∈ s then f a else neutral op)
  ← rewrite support_delta sym=false goal=3
    #[4] iterate op (if a ∈ s then support op f ({a}) else ∅) (λx. if x = a then f x else neutral op) = (if a ∈ s then f a else neutral op)
  ← cases "a ∈ s" goal=4
    #[5] a ∈ s ⟶ iterate op (if a ∈ s then support op f ({a}) else ∅) (λx. if x = a then f x else neutral op) = (if a ∈ s then f a else neutral op)
    #[6] ¬(a ∈ s) ⟶ iterate op (if a ∈ s then support op f ({a}) else ∅) (λx. if x = a then f x else neutral op) = (if a ∈ s then f a else neutral op)
  ← intro goal=5
    #[7] a ∈ s
    #[8] iterate op (if a ∈ s then support op f ({a}) else ∅) (λx. if x = a then f x else neutral op) = (if a ∈ s then f a else neutral op)
  ← rewrite if_P sym=false goal=8 facts=[7]
    #[9] iterate op (support op f ({a})) (λx. if x = a then f x else neutral op) = f a
  ← rewrite support_insert sym=false goal=9
    #[10] iterate op (if f a = neutral op then support op f ∅ else insert a (support op f ∅)) (λx. if x = a then f x else neutral op) = f a
  ← cases "f a = neutral op" goal=10
    #[11] f a = neutral op ⟶ iterate op (if f a = neutral op then support op f ∅ else insert a (support op f ∅)) (λx. if x = a then f x else neutral op) = f a
    #[12] ¬(f a = neutral op) ⟶ iterate op (if f a = neutral op then support op f ∅ else insert a (support op f ∅)) (λx. if x = a then f x else neutral op) = f a
  ← intro goal=11
    #[13] f a = neutral op
    #[14] iterate op (if f a = neutral op then support op f ∅ else insert a (support op f ∅)) (λx. if x = a then f x else neutral op) = f a
  ← rewrite if_P sym=false goal=14 facts=[13]
    #[15] iterate op (support op f ∅) (λx. if x = a then f x else neutral op) = f a
  ← rewrite support_empty sym=false goal=15
    #[16] iterate op ∅ (λx. if x = a then f x else neutral op) = f a
  → forward iterate_empty param_f="(λx. if x = a then f x else neutral op)" goal=16 facts=[1]
    #[17] iterate op ∅ (λx. if x = a then f x else neutral op) = neutral op
  ← rewrite source=prev goal=16 facts=[17]
    #[18] neutral op = f a
  ← rewrite source=prev goal=18 facts=[13]
    #[19] neutral op = f a
  ← intro goal=12
    #[20] ¬(f a = neutral op)
    #[21] iterate op (if f a = neutral op then support op f ∅ else insert a (support op f ∅)) (λx. if x = a then f x else neutral op) = f a
  ← rewrite if_not_P sym=false goal=21 facts=[20]
    #[22] iterate op (insert a (support op f ∅)) (λx. if x = a then f x else neutral op) = f a
  ← rewrite support_empty sym=false goal=22
    #[23] iterate op ({a}) (λx. if x = a then f x else neutral op) = f a
  → forward iterate_sing param_f="(λx. if x = a then f x else neutral op)" param_x=a goal=23 facts=[1]
    #[24] iterate op ({a}) (λx. if x = a then f x else neutral op) = (if a = a then f a else neutral op)
  cut "a = a" goal=23
    #[25] a = a
  ← rule eq_refl goal=25
    #[26] a = a
  → rewrite target=fact if_P sym=false goal=23 facts=[24,26]
    #[27] iterate op ({a}) (λx. if x = a then f x else neutral op) = f a
  ← intro goal=6
    #[28] ¬(a ∈ s)
    #[29] iterate op (if a ∈ s then support op f ({a}) else ∅) (λx. if x = a then f x else neutral op) = (if a ∈ s then f a else neutral op)
  ← rewrite if_not_P sym=false goal=29 facts=[28]
    #[30] iterate op ∅ (λx. if x = a then f x else neutral op) = neutral op
  ← rule iterate_empty goal=30
qed

theorem iterate_image
  fixes f :: 'b ⇒ 'c, g :: 'c ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set
  prop monoidal op ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ f x = f y ⟶ x = y) ⟶ iterate op (image f s) g = iterate op s (g ∘ f)
  [hint_backward,hint_backward1]

theorem iterate_bijection
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, p :: 'b ⇒ 'b, s :: 'b set
  prop monoidal op ⟶ (∀x. x ∈ s ⟶ p x ∈ s) ⟶ (∀y. y ∈ s ⟶ (∃!x. x ∈ s ∧ p x = y)) ⟶ iterate op s f = iterate op s (f ∘ p)
  [hint_backward,hint_backward1]

theorem iterate_eq
  fixes f :: 'b => 'a, g :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> (!x. x Mem s --> f x = g x) --> iterate op s f = iterate op s g
  [hint_backward,hint_backward1]

theorem iterate_restrict_set
  fixes P :: 'b => bool, f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> iterate op ({x. x Mem s & P x}) f = iterate op s (%x. if P x then f x else neutral op)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] monoidal op
    #[2] iterate op ({x. x ∈ s ∧ P x}) f = iterate op s (λx. if P x then f x else neutral op)
  ← rewrite iterate_support sym=true goal=2
    #[3] iterate op (support op f ({x. x ∈ s ∧ P x})) f = iterate op (support op (λx. if P x then f x else neutral op) s) (λx. if P x then f x else neutral op)
  ← rewrite support_def sym=false goal=3
    #[4] iterate op ({x. x ∈ {x1. x1 ∈ s ∧ P x1} ∧ ¬(f x = neutral op)}) f = iterate op ({x. x ∈ s ∧ ¬((if P x then f x else neutral op) = neutral op)}) (λx. if P x then f x else neutral op)
  ← rewrite member_collect sym=false goal=4
    #[5] iterate op ({x. (x ∈ s ∧ P x) ∧ ¬(f x = neutral op)}) f = iterate op ({x. x ∈ s ∧ ¬((if P x then f x else neutral op) = neutral op)}) (λx. if P x then f x else neutral op)
  cut "∀x. ∀a. ¬((if P x then f x else a) = a) ⟷ P x ∧ ¬(f x = a)" goal=5
    #[6] ∀x. ∀a. ¬((if P x then f x else a) = a) ⟷ P x ∧ ¬(f x = a)
  ← z3 goal=6
    #[7] ∀x. ∀a. ¬((if P x then f x else a) = a) ⟷ P x ∧ ¬(f x = a)
  ← rewrite source=prev goal=5 facts=[7]
    #[8] iterate op ({x. (x ∈ s ∧ P x) ∧ ¬(f x = neutral op)}) f = iterate op ({x. x ∈ s ∧ P x ∧ ¬(f x = neutral op)}) (λx. if P x then f x else neutral op)
  ← rewrite conj_assoc sym=false goal=8
    #[9] iterate op ({x. (x ∈ s ∧ P x) ∧ ¬(f x = neutral op)}) f = iterate op ({x. (x ∈ s ∧ P x) ∧ ¬(f x = neutral op)}) (λx. if P x then f x else neutral op)
  ← rule iterate_eq goal=9
    #[10] ∀x. x ∈ {x1. (x1 ∈ s ∧ P x1) ∧ ¬(f x1 = neutral op)} ⟶ f x = (if P x then f x else neutral op)
  ← rewrite member_collect sym=false goal=10
    #[11] ∀x. (x ∈ s ∧ P x) ∧ ¬(f x = neutral op) ⟶ f x = (if P x then f x else neutral op)
  ← intro x goal=11
    #[12] _VAR x
    #[13] (x ∈ s ∧ P x) ∧ ¬(f x = neutral op)
    #[14] f x = (if P x then f x else neutral op)
  → forward conjD1 goal=14 facts=[13]
    #[15] x ∈ s ∧ P x
  → forward conjD2 goal=14 facts=[15]
    #[16] P x
  ← rewrite if_P sym=false goal=14 facts=[16]
    #[17] f x = (if P x then f x else neutral op)
qed

theorem iterate_eq_general
  fixes f :: 'c => 'a, g :: 'b => 'a, h :: 'c => 'b, op :: 'a => 'a => 'a, s :: 'c set, t :: 'b set
  prop monoidal op --> (!y. y Mem t --> (?!x. x Mem s & h x = y)) --> (!x. x Mem s --> h x Mem t & g (h x) = f x) --> iterate op s f = iterate op t g
  [hint_backward,hint_backward1]

theorem iterate_eq_general_inverses
  fixes f :: 'c => 'a, g :: 'b => 'a, h :: 'c => 'b, k :: 'b => 'c, op :: 'a => 'a => 'a, s :: 'c set, t :: 'b set
  prop monoidal op --> (!y. y Mem t --> k y Mem s & h (k y) = y) --> (!x. x Mem s --> h x Mem t & k (h x) = x & g (h x) = f x) --> iterate op s f = iterate op t g
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] monoidal op
    #[2] ∀y. y ∈ t ⟶ k y ∈ s ∧ h (k y) = y
    #[3] ∀x. x ∈ s ⟶ h x ∈ t ∧ k (h x) = x ∧ g (h x) = f x
    #[4] iterate op s f = iterate op t g
  ← rule iterate_eq_general param_h=h goal=4 facts=[1]
    #[5] ∀y. y ∈ t ⟶ (∃!x. x ∈ s ∧ h x = y)
    #[6] ∀x. x ∈ s ⟶ h x ∈ t ∧ g (h x) = f x
  ← intro y goal=5
    #[7] _VAR y
    #[8] y ∈ t
    #[9] ∃!x. x ∈ s ∧ h x = y
  → forward goal=9 facts=[2,8]
    #[10] k y ∈ s ∧ h (k y) = y
  ← rewrite exists1_def sym="" goal=9
    #[11] ∃x. (x ∈ s ∧ h x = y) ∧ (∀y1. y1 ∈ s ∧ h y1 = y ⟶ y1 = x)
  ← inst "k y" goal=11
    #[12] (k y ∈ s ∧ h (k y) = y) ∧ (∀y1. y1 ∈ s ∧ h y1 = y ⟶ y1 = k y)
  ← rule conjI goal=12
    #[13] ∀y1. y1 ∈ s ∧ h y1 = y ⟶ y1 = k y
  ← intro y1 goal=13
    #[14] _VAR y1
    #[15] y1 ∈ s ∧ h y1 = y
    #[16] y1 = k y
  → forward conjD1 goal=16 facts=[15]
    #[17] y1 ∈ s
  → forward conjD2 goal=16 facts=[15]
    #[18] h y1 = y
  → forward goal=16 facts=[3,17]
    #[19] h y1 ∈ t ∧ k (h y1) = y1 ∧ g (h y1) = f y1
  → forward conjD1 goal=16 facts=[19]
    #[20] h y1 ∈ t
  → forward goal=16 facts=[2,20]
    #[21] k (h y1) ∈ s ∧ h (k (h y1)) = h y1
  → forward conjD2 goal=16 facts=[21]
    #[22] h (k (h y1)) = h y1
  → forward conjD2 goal=16 facts=[15]
  → rewrite target=fact source=prev goal=16 facts=[18,22]
    #[23] h (k y) = y
  → rewrite target=fact eq_sym_eq sym=false goal=16 facts=[18]
    #[24] y = h y1
  ← rewrite source=prev goal=16 facts=[24]
    #[25] y1 = k (h y1)
  → forward conjD2 goal=25 facts=[19]
    #[26] k (h y1) = y1 ∧ g (h y1) = f y1
  → forward conjD1 goal=25 facts=[26]
    #[27] k (h y1) = y1
  ← rewrite source=prev goal=25 facts=[27]
    #[28] y1 = k (h y1)
  ← intro x goal=6
    #[29] _VAR x
    #[30] x ∈ s
    #[31] h x ∈ t ∧ g (h x) = f x
  → forward goal=31 facts=[3,30]
    #[32] h x ∈ t ∧ k (h x) = x ∧ g (h x) = f x
  → forward conjD1 goal=31 facts=[32]
    #[33] h x ∈ t
  → forward conjD2 goal=31 facts=[32]
    #[34] k (h x) = x ∧ g (h x) = f x
  → forward conjD2 goal=31 facts=[34]
    #[35] g (h x) = f x
  ← rule conjI goal=31
qed

theorem iterate_injection
  fixes f :: 'b ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, p :: 'b ⇒ 'b, s :: 'b set
  prop monoidal op ⟶ finite s ⟶ (∀x. x ∈ s ⟶ p x ∈ s) ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ p x = p y ⟶ x = y) ⟶ iterate op s (f ∘ p) = iterate op s f
  [hint_backward,hint_backward1]

theorem iterate_union_nonzero
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set, t :: 'b set
  prop monoidal op --> finite s --> finite t --> (!x. x Mem s Int t --> f x = neutral op) --> iterate op (s Un t) f = op (iterate op s f) (iterate op t f)
  [hint_backward,hint_backward1]

theorem iterate_op
  fixes f :: 'b => 'a, g :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> finite s --> iterate op s (%x. op (f x) (g x)) = op (iterate op s f) (iterate op s g)
  [hint_backward,hint_backward1]

theorem iterate_superset
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, u :: 'b set, v :: 'b set
  prop monoidal op --> u Sub v --> (!x. x Mem v --> ~(x Mem u) --> f x = neutral op) --> iterate op v f = iterate op u f
  [hint_backward,hint_backward1]

theorem iterate_univ
  fixes f :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> support op f univ Sub s --> iterate op s f = iterate op univ f
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] monoidal op
    #[2] support op f univ ⊆ s
    #[3] iterate op s f = iterate op univ f
  → rewrite target=fact support_def sym=false goal=3 facts=[2]
    #[4] {x. x ∈ univ ∧ ¬(f x = neutral op)} ⊆ s
  ← rewrite eq_sym_eq sym=false goal=3
    #[5] iterate op univ f = iterate op s f
  ← rule iterate_superset goal=5 facts=[1]
    #[6] s ⊆ univ
    #[7] ∀x. x ∈ univ ⟶ ¬(x ∈ s) ⟶ f x = neutral op
  ← rule subset_univ goal=6
    #[8] s ⊆ univ
  ← intro x goal=7
    #[9] _VAR x
    #[10] x ∈ univ
    #[11] ¬(x ∈ s)
    #[12] f x = neutral op
  → forward subsetE param_x=x goal=12 facts=[4]
    #[13] x ∈ {x1. x1 ∈ univ ∧ ¬(f x1 = neutral op)} ⟶ x ∈ s
  → rewrite target=fact member_collect sym=false goal=12 facts=[13]
    #[14] x ∈ univ ∧ ¬(f x = neutral op) ⟶ x ∈ s
  ← rule contrapositive goal=12 facts=[11]
    #[15] ¬(f x = neutral op) ⟶ ¬¬(x ∈ s)
  ← rewrite double_neg sym=false goal=15
    #[16] ¬(f x = neutral op) ⟶ x ∈ s
  ← intro goal=16
    #[17] ¬(f x = neutral op)
    #[18] x ∈ s
  ← apply_prev goal=18 facts=[14]
    #[19] x ∈ univ ∧ ¬(f x = neutral op)
  ← rule conjI goal=19
qed

theorem iterate_swap
  fixes f :: 'b => 'c => 'a, op :: 'a => 'a => 'a, s :: 'b set, t :: 'c set
  prop monoidal op --> finite s --> finite t --> iterate op s (%i. iterate op t (f i)) = iterate op t (%j. iterate op s (%i. f i j))
  [hint_backward,hint_backward1]

theorem iterate_image_nonzero
  fixes f :: 'b ⇒ 'c, g :: 'c ⇒ 'a, op :: 'a ⇒ 'a ⇒ 'a, s :: 'b set
  prop monoidal op ⟶ finite s ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ f x = f y ⟶ g (f x) = neutral op) ⟶ iterate op (image f s) g = iterate op s (g ∘ f)
  [hint_backward,hint_backward1]

theorem iterate_image_gen
  fixes f :: 'a => 'b, g :: 'a => 'c, op :: 'c => 'c => 'c, s :: 'a set
  prop monoidal op --> finite s --> iterate op s g = iterate op (image f s) (%y. iterate op ({x. x Mem s & f x = y}) g)
  [hint_backward,hint_backward1]

theorem iterate_cases
  fixes P :: 'b => bool, f :: 'b => 'a, g :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> finite s --> iterate op s (%x. if P x then f x else g x) = op (iterate op ({x. x Mem s & P x}) f) (iterate op ({x. x Mem s & ~(P x)}) g)
  [hint_backward,hint_backward1]

theorem iterate_op_gen
  fixes f :: 'b => 'a, g :: 'b => 'a, op :: 'a => 'a => 'a, s :: 'b set
  prop monoidal op --> finite (support op f s) --> finite (support op g s) --> iterate op s (%x. op (f x) (g x)) = op (iterate op s f) (iterate op s g)
  [hint_backward,hint_backward1]

theorem iterate_natseg_0
  fixes f :: nat => 'a, m :: nat, op :: 'a => 'a => 'a
  prop monoidal op --> iterate op ({m..0}) f = (if m = 0 then f 0 else neutral op)
  [hint_backward]
proof
  ← intro goal=0
    #[1] monoidal op
    #[2] iterate op ({m..0}) f = (if m = 0 then f 0 else neutral op)
  ← rewrite natseg_0 sym=false goal=2
    #[3] iterate op (if m = 0 then {0} else ∅) f = (if m = 0 then f 0 else neutral op)
  ← cases "m = 0" goal=3
    #[4] m = 0 ⟶ iterate op (if m = 0 then {0} else ∅) f = (if m = 0 then f 0 else neutral op)
    #[5] ¬(m = 0) ⟶ iterate op (if m = 0 then {0} else ∅) f = (if m = 0 then f 0 else neutral op)
  ← intro goal=4
    #[6] m = 0
    #[7] iterate op (if m = 0 then {0} else ∅) f = (if m = 0 then f 0 else neutral op)
  ← rewrite if_P sym=false goal=7 facts=[6]
    #[8] iterate op ({0}) f = f 0
  ← rule iterate_sing goal=8 facts=[1]
    #[9] iterate op ({0}) f = f 0
  ← intro goal=5
    #[10] ¬(m = 0)
    #[11] iterate op (if m = 0 then {0} else ∅) f = (if m = 0 then f 0 else neutral op)
  ← rewrite if_not_P sym=false goal=11 facts=[10]
    #[12] iterate op ∅ f = neutral op
  ← rule iterate_empty goal=12
qed

theorem iterate_natseg_Suc
  fixes f :: nat => 'a, m :: nat, n :: nat, op :: 'a => 'a => 'a
  prop monoidal op --> iterate op ({m..Suc n}) f = (if m <= Suc n then op (iterate op ({m..n}) f) (f (Suc n)) else iterate op ({m..n}) f)
  [hint_backward]

theorem iterate_natseg_0_lt
  fixes f :: nat => 'a, op :: 'a => 'a => 'a
  prop monoidal op --> iterate op ({i. i < 0}) f = neutral op
  [hint_backward]

theorem iterate_natseg_Suc_lt
  fixes f :: nat => 'a, k :: nat, op :: 'a => 'a => 'a
  prop monoidal op --> iterate op ({i. i < Suc k}) f = op (iterate op ({i. i < k}) f) (f k)
  [hint_backward]

theorem iterate_natseg_0_le
  fixes f :: nat => 'a, op :: 'a => 'a => 'a
  prop monoidal op --> iterate op ({i. i <= 0}) f = f 0
  [hint_backward]

theorem iterate_natseg_Suc_le
  fixes f :: nat => 'a, k :: nat, op :: 'a => 'a => 'a
  prop monoidal op --> iterate op ({i. i <= Suc k}) f = op (iterate op ({i. i <= k}) f) (f (Suc k))
  [hint_backward]

theorem iterate_pair
  fixes f :: nat => 'a, m :: nat, n :: nat, op :: 'a => 'a => 'a
  prop monoidal op --> iterate op ({2 * m..2 * n + 1}) f = iterate op ({m..n}) (%i. op (f (2 * i)) (f (2 * i + 1)))
  [hint_backward]

theorem iterate_reflect
  fixes m :: nat, n :: nat, op :: 'a => 'a => 'a, x :: nat => 'a
  prop monoidal op --> iterate op ({m..n}) x = (if n < m then neutral op else iterate op ({0..n - m}) (%i. x (n - i)))
  [hint_backward]

header "Missing monoidal/neutral definitions and numseg clauses"

axiom finite_recursion
  fixes f :: 'b ⇒ 'a ⇒ 'a, b :: 'a
  prop (∀x. ∀y. ∀s. ¬(x = y) ⟶ f x (f y s) = f y (f x s)) ⟶ itset f ∅ b = b ∧ (∀x. ∀s. finite s ⟶ itset f (insert x s) b = (if x ∈ s then itset f s b else f x (itset f s b)))

axiom monoidal_def
  fixes op :: 'a ⇒ 'a ⇒ 'a
  prop monoidal op ⟷ (∀x. ∀y. op x y = op y x) ∧ (∀x. ∀y. ∀z. op x (op y z) = op (op x y) z) ∧ (∀x. op (neutral op) x = x)
  [hint_rewrite]

axiom neutral_def
  fixes op :: 'a ⇒ 'a ⇒ 'a
  prop neutral op = (THE x. ∀y. op x y = y ∧ op y x = y)
  [hint_rewrite]

axiom finite_natseg_le
  fixes n :: nat
  prop finite ({x. x ≤ n})
  [hint_backward]

axiom finite_natseg_lt
  fixes n :: nat
  prop finite ({x. x < n})
  [hint_backward]

axiom member_numseg
  fixes x :: nat, m :: nat, n :: nat
  prop x ∈ {m..n} ⟷ m ≤ x ∧ x ≤ n
  [hint_rewrite]

axiom natseg_clauses_le_1
  fixes k :: nat
  prop {i::nat. i ≤ 0} = {0}
  [hint_rewrite]

axiom natseg_clauses_le_2
  fixes k :: nat
  prop {i. i ≤ Suc k} = insert (Suc k) ({i. i ≤ k})
  [hint_rewrite]

axiom natseg_clauses_lt_1
  fixes k :: nat
  prop {i::nat. i < 0} = ∅
  [hint_rewrite]

axiom natseg_clauses_lt_2
  fixes k :: nat
  prop {i. i < Suc k} = insert k ({i. i < k})
  [hint_rewrite]

