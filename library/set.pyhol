theory set
imports nat
description "Set theory"

header "Set type and basic operations"

type set 'a

const member :: 'a ⇒ 'a set ⇒ bool

const empty_set :: 'a set

const insert :: 'a ⇒ 'a set ⇒ 'a set

const subset :: 'a set ⇒ 'a set ⇒ bool

const inter :: 'a set ⇒ 'a set ⇒ 'a set

const union :: 'a set ⇒ 'a set ⇒ 'a set

const diff :: 'a set ⇒ 'a set ⇒ 'a set

const collect :: ('a ⇒ bool) ⇒ 'a set

const countable :: 'a set ⇒ bool

const Union :: 'a set set ⇒ 'a set

const Inter :: 'a set set ⇒ 'a set

const comp_fun :: ('a ⇒ 'b) ⇒ ('b ⇒ 'c) ⇒ ('a ⇒ 'c)

const finite :: 'a set ⇒ bool

const delete :: 'a set ⇒ 'a ⇒ 'a set

const image :: ('a ⇒ 'b) ⇒ 'a set ⇒ 'b set

const disjoint :: 'a set ⇒ 'a set ⇒ bool

const from :: nat ⇒ nat set

const univ :: 'a set

const card :: 'a set ⇒ nat

const has_size :: 'a set ⇒ nat ⇒ bool

const infinite :: 'a set ⇒ bool

axiom member_empty_simp
  fixes x :: 'a
  prop x ∈ ∅ ⟷ false
  [hint_rewrite]

axiom member_insert
  fixes x :: 'a, y :: 'a, A :: 'a set
  prop x ∈ insert y A ⟷ x = y ∨ x ∈ A
  [hint_rewrite]


header "Membership and definitions"

axiom subset_def
  fixes A :: 'a set, B :: 'a set
  prop A ⊆ B ⟷ (∀x. x ∈ A ⟶ x ∈ B)
  [hint_rewrite]

theorem member_empty
  fixes x :: 'a
  prop x ∈ ∅ ⟷ false
  [hint_rewrite]
  proof
    0: rewrite_goal member_empty_simp sym=false
  qed

theorem member_singleton
  fixes x :: 'a, a :: 'a
  prop x ∈ {a} ⟷ x = a
  [hint_rewrite]
  proof
    0: rewrite_goal member_insert sym=false
    0: rewrite_goal member_empty_simp sym=false
    0: rewrite_goal disj_false_right sym=false
  qed

axiom member_univ
  fixes x :: 'a
  prop x ∈ univ ⟷ true
  [hint_rewrite]

axiom member_inter_iff
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop x ∈ A ∩ B ⟷ x ∈ A ∧ x ∈ B
  [hint_rewrite]

axiom inter_def
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop x ∈ A ∩ B ⟷ x ∈ A ∧ x ∈ B
  [hint_rewrite]

axiom member_union_iff
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop x ∈ A ∪ B ⟷ x ∈ A ∨ x ∈ B
  [hint_rewrite]

axiom member_diff
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop x ∈ diff A B ⟷ x ∈ A ∧ ¬(x ∈ B)
  [hint_rewrite]

axiom diff_def
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop x ∈ diff A B ⟷ x ∈ A ∧ ¬(x ∈ B)
  [hint_rewrite]

axiom member_delete
  fixes x :: 'a, A :: 'a set, a :: 'a
  prop x ∈ delete A a ⟷ x ∈ A ∧ ¬(x = a)
  [hint_rewrite]

axiom delete_def
  fixes x :: 'a, A :: 'a set, a :: 'a
  prop x ∈ delete A a ⟷ x ∈ A ∧ ¬(x = a)
  [hint_rewrite]

axiom member_collect
  fixes x :: 'a, P :: 'a ⇒ bool
  prop x ∈ collect P ⟷ P x
  [hint_rewrite]

axiom member_Union
  fixes x :: 'a, A :: 'a set set
  prop x ∈ Union A ⟷ (∃S. S ∈ A ∧ x ∈ S)
  [hint_rewrite]

axiom in_image
  fixes y :: 'b, f :: 'a ⇒ 'b, A :: 'a set
  prop y ∈ image f A ⟷ (∃x. x ∈ A ∧ y = f x)
  [hint_rewrite]

axiom image_def
  fixes y :: 'b, f :: 'a ⇒ 'b, A :: 'a set
  prop y ∈ image f A ⟷ (∃x. x ∈ A ∧ y = f x)
  [hint_rewrite]

axiom disjoint_def
  fixes A :: 'a set, B :: 'a set
  prop disjoint A B ⟷ A ∩ B = ∅
  [hint_rewrite]

axiom infinite_def
  fixes A :: 'a set
  prop infinite A ⟷ ¬finite A
  [hint_rewrite]

axiom has_size_def
  fixes A :: 'a set, n :: nat
  prop has_size A n ⟷ finite A ∧ card A = n
  [hint_rewrite]

axiom set_equal_iff
  fixes A :: 'a set, B :: 'a set
  prop A = B ⟷ (∀x. x ∈ A ⟷ x ∈ B)
  [hint_rewrite]

axiom member_ext
  fixes A :: 'a set, B :: 'a set
  prop A = B ⟷ (∀x. x ∈ A ⟷ x ∈ B)
  [hint_rewrite]

header "Subset"

theorem subset_refl
  fixes A :: 'a set
  prop A ⊆ A
  [hint_rewrite]
  proof
    0: rewrite_goal subset_def sym=false
    0: introduction x
    0: apply_prev
  qed

axiom subset_trans
  fixes A :: 'a set, B :: 'a set, C :: 'a set
  prop A ⊆ B ⟶ B ⊆ C ⟶ A ⊆ C
  [hint_backward]

axiom subset_empty
  fixes A :: 'a set
  prop A ⊆ ∅ ⟷ A = ∅
  [hint_rewrite]

theorem subset_univ
  fixes A :: 'a set
  prop A ⊆ univ
  [hint_rewrite]
  proof
    0: rewrite_goal subset_def sym=false
    0: rewrite_goal member_univ sym=false
    0: introduction x
    0.2: apply_backward_step trueI
  qed

axiom subset_union_id
  fixes A :: 'a set, B :: 'a set
  prop A ∪ B = A ⟷ B ⊆ A
  [hint_rewrite]

theorem subset_diff
  fixes A :: 'a set, B :: 'a set
  prop diff A B ⊆ A
  [hint_rewrite]
  proof
    0: rewrite_goal subset_def sym=false
    0: rewrite_goal member_diff sym=false
    0: introduction x
    0.2: apply_forward_step conjD1 @0.1
    0.2: apply_prev
  qed

header "Union and intersection"

axiom inter_comm
  fixes A :: 'a set, B :: 'a set
  prop A ∩ B = B ∩ A
  [hint_rewrite]

axiom inter_subset_id
  fixes A :: 'a set, B :: 'a set
  prop A ∩ B = A ⟷ A ⊆ B
  [hint_rewrite]

axiom union_comm
  fixes A :: 'a set, B :: 'a set
  prop A ∪ B = B ∪ A
  [hint_rewrite]

theorem union_empty
  fixes A :: 'a set
  prop A ∪ ∅ = A
  [hint_rewrite]
  proof
    0: rewrite_goal set_equal_iff sym=false
    0: rewrite_goal member_union_iff sym=false
    0: rewrite_goal member_empty_simp sym=false
    0: rewrite_goal disj_false_right sym=false
    0: introduction x
    0.1: reflexive
  qed

header "Finite sets"

axiom finite_empty
  fixes A :: 'a set
  prop finite (∅::'a set)
  [hint_backward]

axiom finite_insert
  fixes A :: 'a set, a :: 'a
  prop finite (insert a A) ⟷ finite A
  [hint_backward,hint_rewrite]

axiom finite_subset
  fixes A :: 'a set, B :: 'a set
  prop A ⊆ B ⟶ finite B ⟶ finite A
  [hint_backward]

axiom finite_union_imp
  fixes A :: 'a set, B :: 'a set
  prop finite A ⟶ finite B ⟶ finite (A ∪ B)
  [hint_backward]

axiom finite_inter
  fixes A :: 'a set, B :: 'a set
  prop finite A ∨ finite B ⟶ finite (A ∩ B)
  [hint_backward]

axiom finite_image
  fixes f :: 'a ⇒ 'b, A :: 'a set
  prop finite A ⟶ finite (image f A)
  [hint_backward]

axiom finite_delete
  fixes A :: 'a set, a :: 'a
  prop finite (delete A a) ⟷ finite A
  [hint_backward,hint_rewrite]

axiom finite_diff
  fixes A :: 'a set, B :: 'a set
  prop finite A ⟶ finite (diff A B)
  [hint_backward]

header "Image"

axiom image_empty
  fixes f :: 'a ⇒ 'b
  prop image f ∅ = ∅
  [hint_rewrite]

axiom image_insert
  fixes f :: 'a ⇒ 'b, A :: 'a set, a :: 'a
  prop image f (insert a A) = insert (f a) (image f A)
  [hint_rewrite]

axiom image_id
  fixes A :: 'a set
  prop image (λx. x) A = A
  [hint_rewrite]

axiom image_combine
  fixes f :: 'b ⇒ 'c, g :: 'a ⇒ 'b, A :: 'a set
  prop image f (image g A) = image (comp_fun g f) A
  [hint_rewrite]

header "Cardinality"

axiom card_empty
  fixes A :: 'a set
  prop card (∅::'a set) = 0
  [hint_rewrite]

axiom card_sing
  fixes a :: 'a
  prop card {a} = 1
  [hint_rewrite]

axiom card_insert
  fixes A :: 'a set, a :: 'a
  prop finite A ⟶ ¬(a ∈ A) ⟶ card (insert a A) = card A + 1
  [hint_rewrite]

axiom card_eq_0
  fixes A :: 'a set
  prop finite A ⟶ card A = 0 ⟶ A = ∅

header "Other"

axiom insert_delete
  fixes A :: 'a set, a :: 'a
  prop a ∈ A ⟶ insert a (delete A a) = A
  [hint_rewrite]

axiom infinite_nonempty
  fixes A :: 'a set
  prop infinite A ⟶ ¬(A = ∅)

axiom infinite_diff_finite
  fixes A :: 'a set, B :: 'a set
  prop infinite A ⟶ finite B ⟶ infinite (diff A B)


header "Composition, from, and missing definitions"

axiom comp_fun_def
  fixes f :: 'a ⇒ 'b, g :: 'b ⇒ 'c
  prop comp_fun f g = (λx. g (f x))
  [hint_rewrite]

axiom from_def
  fixes n :: nat
  prop from n = {m. n ≤ m}
  [hint_rewrite]

header "Finite set induction and recursion"

axiom finite_induct_strong
  fixes P :: 'a set ⇒ bool
  prop P ∅ ⟶ (∀x. ∀s. P s ⟶ ¬(x ∈ s) ⟶ finite s ⟶ P (insert x s)) ⟶ (∀s. finite s ⟶ P s)


axiom finite_restrict
  fixes s :: 'a set, P :: 'a ⇒ bool
  prop finite s ⟶ finite {x. x ∈ s ∧ P x}
  [hint_backward]

axiom finite_image_inj_eq
  fixes f :: 'a ⇒ 'b, s :: 'a set
  prop (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ f x = f y ⟶ x = y) ⟶ (finite (image f s) ⟷ finite s)
  [hint_rewrite]

header "Natural numbers as sets"

axiom nat_finite
  fixes s :: nat set
  prop finite s ⟷ (∃a. ∀x. x ∈ s ⟶ x ≤ a)
  [hint_rewrite]

axiom nat_infinite
  fixes A :: nat set
  prop infinite (univ::nat set)

axiom nat_infinite_eq
  fixes s :: nat set
  prop infinite s ⟷ (∀a. ∃x. x ∈ s ∧ a < x)
  [hint_rewrite]

header "Set comprehension quantifiers"

axiom exists_in_gspec1
  fixes P :: 'a ⇒ bool, Q :: 'a ⇒ bool
  prop (∃x. x ∈ {y. P y} ∧ Q x) ⟷ (∃x. P x ∧ Q x)
  [hint_rewrite]

axiom forall_in_gspec1
  fixes P :: 'a ⇒ bool, Q :: 'a ⇒ bool
  prop (∀x. x ∈ {y. P y} ⟶ Q x) ⟷ (∀x. P x ⟶ Q x)
  [hint_rewrite]

header "Cardinality and surjectivity"

axiom card_image_inj
  fixes f :: 'a ⇒ 'b, s :: 'a set
  prop finite s ⟶ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ f x = f y ⟶ x = y) ⟶ card (image f s) = card s

axiom surjective_iff_injective
  fixes s :: 'a set, f :: 'a ⇒ 'a
  prop finite s ⟶ image f s ⊆ s ⟶ ((∀y. y ∈ s ⟶ (∃x. x ∈ s ∧ f x = y)) ⟷ (∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ f x = f y ⟶ x = y))
