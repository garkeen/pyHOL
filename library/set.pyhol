theory set
imports nat
description "Set theory"

header "Set type and basic operations"

typeabbrev set 'a = 'a ⇒ bool

def member :: 'a ⇒ 'a set ⇒ bool = member x A ⟷ A x

def empty_set :: 'a set = empty_set = (λx. false)

def insert :: 'a ⇒ 'a set ⇒ 'a set = insert y A = (λx. x = y ∨ A x)

def subset :: 'a set ⇒ 'a set ⇒ bool = subset A B ⟷ (∀x. member x A ⟶ member x B)

def inter :: 'a set ⇒ 'a set ⇒ 'a set = inter A B = (λx. A x ∧ B x)

def union :: 'a set ⇒ 'a set ⇒ 'a set = union A B = (λx. A x ∨ B x)

def diff :: 'a set ⇒ 'a set ⇒ 'a set = diff A B = (λx. A x ∧ ¬ B x)

def collect :: ('a ⇒ bool) ⇒ 'a set = collect P = (λx. P x)

const countable :: 'a set ⇒ bool

def Union :: 'a set set ⇒ 'a set = Union A = (λx. ∃S. A S ∧ S x)

def Inter :: 'a set set ⇒ 'a set = Inter A = (λx. ∀S. A S ⟶ S x)

def comp_fun :: ('a ⇒ 'b) ⇒ ('b ⇒ 'c) ⇒ 'a ⇒ 'c = f ∘ g = (λx. g (f x)) [hint_rewrite]

def finite :: 'a set ⇒ bool = finite A ⟷ (∀P::'a set ⇒ bool. P ({}::'a set) ∧ (∀x::'a. ∀B::'a set. P B ⟶ P (insert x B)) ⟶ P A)

-- `fin_sub X` ("everything below X is finite") is the predicate that has
-- to be instantiated for the P in `finite_def` to get subset closure:
-- `finite B` then yields `fin_sub B`, and `fin_sub B` applied to a subset
-- of `B` yields finiteness.  Named so the instantiated induction
-- hypothesis carries no beta-redex.
def fin_sub :: 'a set ⇒ bool = fin_sub X ⟷ (!Y::'a set. Y Sub X --> finite Y) [hint_rewrite]

-- `fin_union B X` and `fin_image f X` exist only so that the P in
-- `finite_def` can be a *partial application* rather than a lambda: the
-- varying argument is last, so `fin_union A` / `fin_image f` are terms of
-- type 'a set => bool, and the instantiated induction hypothesis carries
-- no beta-redex to reduce.
def fin_union :: 'a set ⇒ 'a set ⇒ bool = fin_union B X ⟷ finite (B Un X) [hint_rewrite]


def delete :: 'a set ⇒ 'a ⇒ 'a set = delete A a = (λx. A x ∧ ¬(x = a))

def image :: ('a ⇒ 'b) ⇒ 'a set ⇒ 'b set = image f A = (λy. ∃x. A x ∧ y = f x)

def disjoint :: 'a set ⇒ 'a set ⇒ bool = disjoint A B ⟷ inter A B = empty_set

def fin_image :: ('a ⇒ 'b) ⇒ 'a set ⇒ bool = fin_image f X ⟷ finite (image f X) [hint_rewrite]

def from :: nat ⇒ nat set = from n = (λm. n ≤ m)

def univ :: 'a set = univ = (λx. true)

const card :: 'a set ⇒ nat

def has_size :: 'a set ⇒ nat ⇒ bool = has_size A n ⟷ finite A ∧ card A = n

def infinite :: 'a set ⇒ bool = infinite A ⟷ ¬ finite A

-- `card_inj f X` is the P instantiated in `finite_def` to get
-- `card (image f X) = card X` for an injective f.  Finiteness is a premise
-- (not a parameter) because card_insert needs it.
def card_inj :: ('a ⇒ 'b) ⇒ 'a set ⇒ bool = card_inj f X ⟷ (finite X --> (!x::'a. !y::'a. x Mem X --> y Mem X --> f x = f y --> x = y) --> card (image f X) = card X) [hint_rewrite]

theorem member_empty_simp
  fixes x :: 'a
  prop x ∈ ∅ ⟷ false
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite empty_set_def sym=false goal=1
qed

theorem member_insert
  fixes x :: 'a, y :: 'a, A :: 'a set
  prop x ∈ insert y A ⟷ x = y ∨ x ∈ A
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite insert_def sym=false goal=1
qed

header "Membership and definitions"


theorem member_empty
  fixes x :: 'a
  prop x Mem {} <--> false
  [hint_rewrite]
proof
  ← rewrite member_empty_simp sym=false goal=0
qed

theorem member_singleton
  fixes x :: 'a, a :: 'a
  prop x Mem {a} <--> x = a
  [hint_rewrite]
proof
  ← rewrite member_insert sym=false goal=0
    #[1] x = a ∨ x ∈ ∅ ⟷ x = a
  ← rewrite member_empty_simp sym=false goal=1
    #[2] x = a ∨ false ⟷ x = a
  ← rewrite disj_false_right sym=false goal=2
qed

theorem member_univ
  fixes x :: 'a
  prop x ∈ univ ⟷ true
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite univ_def sym=false goal=1
qed

theorem member_inter_iff
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop x ∈ A ∩ B ⟷ x ∈ A ∧ x ∈ B
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite inter_def sym=false goal=1
qed


theorem member_union_iff
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop x ∈ A ∪ B ⟷ x ∈ A ∨ x ∈ B
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite union_def sym=false goal=1
qed

theorem member_diff
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop x ∈ diff A B ⟷ x ∈ A ∧ ¬(x ∈ B)
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite diff_def sym=false goal=1
qed


theorem member_delete
  fixes x :: 'a, A :: 'a set, a :: 'a
  prop x ∈ delete A a ⟷ x ∈ A ∧ ¬(x = a)
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite delete_def sym=false goal=1
qed


theorem member_collect
  fixes x :: 'a, P :: 'a ⇒ bool
  prop x ∈ collect P ⟷ P x
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite collect_def sym=false goal=1
qed

theorem member_Union
  fixes x :: 'a, A :: 'a set set
  prop x ∈ ⋃A ⟷ (∃S. S ∈ A ∧ x ∈ S)
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite Union_def sym=false goal=1
qed

theorem member_Inter
  fixes x :: 'a, A :: 'a set set
  prop x ∈ ⋂A ⟷ (∀S. S ∈ A ⟶ x ∈ S)
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite Inter_def sym=false goal=1
qed

theorem in_image
  fixes y :: 'b, f :: 'a ⇒ 'b, A :: 'a set
  prop y ∈ image f A ⟷ (∃x. x ∈ A ∧ y = f x)
  [hint_rewrite]
proof
  ← rewrite member_def sym=false goal=0
  ← rewrite image_def sym=false goal=1
qed





axiom set_equal_iff
  fixes A :: 'a set, B :: 'a set
  prop A = B ⟷ (∀x. x ∈ A ⟷ x ∈ B)
  [hint_rewrite]


header "Subset"

theorem subsetE
  fixes A :: 'a set, B :: 'a set, x :: 'a
  prop A Sub B --> x Mem A --> x Mem B
proof
  ← intro goal=0
  → rewrite target=fact subset_def sym=false goal=3 facts=[1]
  ← apply_prev goal=3 facts=[4,2]
qed

theorem subset_refl
  fixes A :: 'a set
  prop A Sub A
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
qed

theorem subset_trans
  fixes A :: 'a set, B :: 'a set, C :: 'a set
  prop A Sub B --> B Sub C --> A Sub C
  [hint_backward]
proof
  ← intro goal=0
  → rewrite target=fact subset_def sym=false goal=3 facts=[1]
  → rewrite target=fact subset_def sym=false goal=3 facts=[2]
  ← rewrite subset_def sym=false goal=3
  ← intro x goal=6
  → forward goal=9 facts=[4,8]
  ← apply_prev goal=9 facts=[5,10]
qed

-- `insert x` is the one constructor in `finite_def`, so both directions of
-- subset reasoning have to eliminate it: either the new element is already
-- absent from the subset (subset_insert_imp) or it is deleted before the
-- subset is compared (delete_subset_insert).
theorem subset_insert_imp
  fixes A :: 'a set, B :: 'a set, x :: 'a
  prop A Sub insert x B --> ~(x Mem A) --> A Sub B
proof
  ← intro goal=0
  ← rewrite subset_def sym=false goal=3
  ← intro z goal=4
  → forward subsetE goal=7 facts=[1,6]
  → rewrite target=fact member_insert sym=false goal=7 facts=[8]
  → rewrite target=fact disj_comm sym=false goal=7 facts=[9]
  cut "~(z = x)" goal=7
  ← rule negI goal=11
  ← intro goal=12
  → rewrite target=fact source=prev goal=14 facts=[13,6]
  ← rule negE_gen goal=14 facts=[2,15]
  → forward force_disj_true1 goal=7 facts=[10,11]
qed

theorem delete_subset_insert
  fixes A :: 'a set, B :: 'a set, x :: 'a
  prop A Sub insert x B --> delete A x Sub B
proof
  ← intro goal=0
  ← rewrite subset_def sym=false goal=2
  ← intro z goal=3
  → rewrite target=fact member_delete sym=false goal=6 facts=[5]
  → forward conjD1 goal=6 facts=[7]
  → forward conjD2 goal=6 facts=[7]
  → forward subsetE goal=6 facts=[1,8]
  → rewrite target=fact member_insert sym=false goal=6 facts=[10]
  → rewrite target=fact disj_comm sym=false goal=6 facts=[11]
  → forward force_disj_true1 goal=6 facts=[12,9]
qed

theorem insert_delete
  fixes A :: 'a set, a :: 'a
  prop a Mem A --> insert a (delete A a) = A
  [hint_rewrite]
proof
  ← intro goal=0
  ← rewrite set_equal_iff sym=false goal=2
  ← intro x goal=3
  ← rewrite member_insert sym=false goal=5
  ← rewrite member_delete sym=false goal=6
  ← cases "x = a" goal=7
  ← intro goal=8
  ← rewrite source=prev goal=11 facts=[10]
  ← rewrite eq_mean_true sym=false goal=12
  ← rewrite not_true sym=false goal=13
  ← rewrite conj_false_left sym=false goal=14
  ← rewrite disj_false_right sym=false goal=15
  ← rule iffI goal=16
  ← intro goal=17
  ← intro goal=18
  ← rule trueI goal=20
  ← intro goal=9
  → rewrite target=fact eq_false sym=false goal=23 facts=[22]
  ← rewrite source=prev goal=23 facts=[24]
  ← rewrite not_false sym=false goal=25
  ← rewrite conj_true_right sym=false goal=26
  ← rewrite disj_false_left sym=false goal=27
qed

theorem subset_empty
  fixes A :: 'a set
  prop A Sub {} <--> A = {}
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
    #[1] (∀x. x ∈ A ⟶ x ∈ ∅) ⟷ A = ∅
  ← rewrite member_empty_simp sym=false goal=1
    #[2] (∀x. x ∈ A ⟶ false) ⟷ A = ∅
  ← rewrite set_equal_iff sym=false goal=2
    #[3] (∀x. x ∈ A ⟶ false) ⟷ (∀x. x ∈ A ⟷ x ∈ ∅)
  ← rewrite member_empty_simp sym=false goal=3
    #[4] (∀x. x ∈ A ⟶ false) ⟷ (∀x. x ∈ A ⟷ false)
  ← rewrite imp_false_iff sym=false goal=4
    #[5] (∀x. ¬(x ∈ A)) ⟷ (∀x. x ∈ A ⟷ false)
  ← rewrite eq_false sym=false goal=5
qed

theorem subset_univ
  fixes A :: 'a set
  prop A Sub univ
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
    #[1] ∀x. x ∈ A ⟶ x ∈ univ
  ← rewrite member_univ sym=false goal=1
    #[2] ∀x. x ∈ A ⟶ true
  ← intro x goal=2
    #[3] _VAR x
    #[4] x ∈ A
    #[5] true
  ← rule trueI goal=5
    #[6] true
qed

theorem subset_union_id
  fixes A :: 'a set, B :: 'a set
  prop A Un B = A <--> B Sub A
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] (∀x. x ∈ A ∪ B ⟷ x ∈ A) ⟷ B ⊆ A
  ← rewrite member_union_iff sym=false goal=1
    #[2] (∀x. x ∈ A ∨ x ∈ B ⟷ x ∈ A) ⟷ B ⊆ A
  ← rewrite subset_def sym=false goal=2
    #[3] (∀x. x ∈ A ∨ x ∈ B ⟷ x ∈ A) ⟷ (∀x. x ∈ B ⟶ x ∈ A)
  ← rewrite disj_iff_left sym=false goal=3
qed

theorem subset_inter_left
  fixes A :: 'a set, B :: 'a set
  prop A Int B Sub A
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
  ← intro z goal=1
  → rewrite target=fact member_inter_iff sym=false goal=4 facts=[3]
  → forward conjD1 goal=4 facts=[5]
qed

theorem subset_inter_right
  fixes A :: 'a set, B :: 'a set
  prop A Int B Sub B
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
  ← intro z goal=1
  → rewrite target=fact member_inter_iff sym=false goal=4 facts=[3]
  → forward conjD2 goal=4 facts=[5]
qed

theorem subset_delete
  fixes A :: 'a set, a :: 'a
  prop delete A a Sub A
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
  ← intro z goal=1
  → rewrite target=fact member_delete sym=false goal=4 facts=[3]
  → forward conjD1 goal=4 facts=[5]
qed

theorem subset_insert_delete
  fixes A :: 'a set, a :: 'a
  prop A Sub insert a (delete A a)
proof
  ← rewrite subset_def sym=false goal=0
  ← intro z goal=1
  ← rewrite member_insert sym=false goal=4
  ← rewrite member_delete sym=false goal=5
  cases "z = a" goal=6
  ← intro goal=7
  ← rewrite source=prev goal=10 facts=[9]
  ← rewrite eq_mean_true sym=false goal=11
  ← rewrite disj_true_left sym=false goal=12
  ← rule trueI goal=13
  ← intro goal=8
  → rewrite target=fact eq_false sym=false goal=16 facts=[15]
  ← rewrite source=prev goal=16 facts=[17]
  ← rewrite not_false sym=false goal=18
  ← rewrite conj_true_right sym=false goal=19
  ← rewrite disj_false_left sym=false goal=20
qed

theorem subset_insert
  fixes A :: 'a set, a :: 'a
  prop A Sub insert a A
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
  ← intro z goal=1
  ← rewrite member_insert sym=false goal=4
  ← rule disjI2 goal=5
qed

theorem subset_diff
  fixes A :: 'a set, B :: 'a set
  prop diff A B Sub A
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
  ← intro x goal=1
  → rewrite target=fact member_diff sym=false goal=4 facts=[3]
  → forward conjD1 goal=4 facts=[5]
qed

header "Union and intersection"

theorem inter_comm
  fixes A :: 'a set, B :: 'a set
  prop A Int B = B Int A
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
  ← rewrite member_inter_iff sym=false goal=1
  ← intro x goal=2
  ← rewrite conj_comm sym=false loc="0.1" goal=4
qed

theorem inter_subset_id
  fixes A :: 'a set, B :: 'a set
  prop A Int B = A <--> A Sub B
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] (∀x. x ∈ A ∩ B ⟷ x ∈ A) ⟷ A ⊆ B
  ← rewrite member_inter_iff sym=false goal=1
    #[2] (∀x. x ∈ A ∧ x ∈ B ⟷ x ∈ A) ⟷ A ⊆ B
  ← rewrite subset_def sym=false goal=2
    #[3] (∀x. x ∈ A ∧ x ∈ B ⟷ x ∈ A) ⟷ (∀x. x ∈ A ⟶ x ∈ B)
  ← rewrite conj_iff_left sym=false goal=3
qed

theorem union_comm
  fixes A :: 'a set, B :: 'a set
  prop A Un B = B Un A
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
  ← rewrite member_union_iff sym=false goal=1
  ← intro x goal=2
  ← rewrite disj_comm sym=false loc="0.1" goal=4
qed

theorem union_insert
  fixes A :: 'a set, B :: 'a set, x :: 'a
  prop A Un insert x B = insert x (A Un B)
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
  ← intro z goal=1
  ← rewrite member_union_iff sym=false goal=3
  ← rewrite member_insert sym=false goal=4
  ← rewrite member_union_iff sym=false goal=5
  cases "z = x" goal=6
  ← intro goal=7
  ← rewrite source=prev goal=10 facts=[9]
  ← rewrite eq_mean_true sym=false goal=11
  ← rewrite disj_true_left sym=false goal=12
  ← rewrite disj_true_right sym=false goal=13
  ← intro goal=8
  → rewrite target=fact eq_false sym=false goal=16 facts=[15]
  ← rewrite source=prev goal=16 facts=[17]
  ← rewrite disj_false_left sym=false goal=18
qed

theorem union_empty
  fixes A :: 'a set
  prop A Un {} = A
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] ∀x. x ∈ A ∪ ∅ ⟷ x ∈ A
  ← rewrite member_union_iff sym=false goal=1
    #[2] ∀x. x ∈ A ∨ x ∈ ∅ ⟷ x ∈ A
  ← rewrite member_empty_simp sym=false goal=2
    #[3] ∀x. x ∈ A ∨ false ⟷ x ∈ A
  ← rewrite disj_false_right sym=false goal=3
    #[4] ∀x. x ∈ A ⟷ x ∈ A
  ← intro x goal=4
    #[5] _VAR x
    #[6] x ∈ A ⟷ x ∈ A
  ← refl goal=6
qed

-- The mirror of `union_empty` (used when `∅` ends up on the left).
theorem empty_union
  fixes A :: 'a set
  prop {} Un A = A
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
  ← rewrite member_union_iff sym=false goal=1
  ← rewrite member_empty_simp sym=false goal=2
  ← rewrite disj_false_left sym=false goal=3
  ← intro x goal=4
  ← refl goal=6
qed

-- `insert` on the left of a union: needed to assemble `set (xs @ ys)`.
theorem insert_union
  fixes x :: 'a, A :: 'a set, B :: 'a set
  prop insert x A Un B = insert x (A Un B)
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] !x1. x1 Mem insert x A Un B <--> x1 Mem insert x (A Un B)
  ← intro z goal=1
    #[2] _VAR z
    #[3] z Mem insert x A Un B <--> z Mem insert x (A Un B)
  ← rewrite member_union_iff loc=0.1 sym=false goal=3
    #[4] z Mem insert x A | z Mem B <--> z Mem insert x (A Un B)
  ← rewrite member_insert loc=0.1.0.1 sym=false goal=4
    #[5] (z = x | z Mem A) | z Mem B <--> z Mem insert x (A Un B)
  ← rewrite member_insert loc=1 sym=false goal=5
    #[6] (z = x | z Mem A) | z Mem B <--> z = x | z Mem A Un B
  ← rewrite member_union_iff loc=1.1 sym=false goal=6
    #[7] (z = x | z Mem A) | z Mem B <--> z = x | z Mem A | z Mem B
  ← rewrite disj_assoc_eq loc=1 sym=false goal=7
qed

-- Two inserts commute (set level): needed for `ordered_insert_set`.
theorem insert_comm
  fixes x :: 'a, y :: 'a, A :: 'a set
  prop insert x (insert y A) = insert y (insert x A)
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] !x1. x1 Mem insert x (insert y A) <--> x1 Mem insert y (insert x A)
  ← intro z goal=1
    #[2] _VAR z
    #[3] z Mem insert x (insert y A) <--> z Mem insert y (insert x A)
  ← rewrite member_insert loc=0.1 sym=false goal=3
    #[4] z = x | z Mem insert y A <--> z Mem insert y (insert x A)
  ← rewrite member_insert loc=0.1.1 sym=false goal=4
    #[5] z = x | z = y | z Mem A <--> z Mem insert y (insert x A)
  ← rewrite member_insert loc=1 sym=false goal=5
    #[6] z = x | z = y | z Mem A <--> z = y | z Mem insert x A
  ← rewrite member_insert loc=1.1 sym=false goal=6
    #[7] z = x | z = y | z Mem A <--> z = y | z = x | z Mem A
  ← rule disj_left_comm goal=7
qed

-- `A` (resp. `B`) is contained in its union: the standard way to move a
-- membership into a union (used by the `strict_sorted` lemmas).
theorem subset_union_left
  fixes A :: 'a set, B :: 'a set
  prop A Sub A Un B
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
    #[1] !x. x Mem A --> x Mem A Un B
  ← intro x goal=1
    #[2] _VAR x
    #[3] x Mem A
    #[4] x Mem A Un B
  ← rewrite member_union_iff sym=false goal=4
    #[5] x Mem A | x Mem B
  ← rule disjI1 goal=5
qed

theorem subset_union_right
  fixes A :: 'a set, B :: 'a set
  prop B Sub A Un B
  [hint_rewrite]
proof
  ← rewrite subset_def sym=false goal=0
    #[1] !x. x Mem B --> x Mem A Un B
  ← intro x goal=1
    #[2] _VAR x
    #[3] x Mem B
    #[4] x Mem A Un B
  ← rewrite member_union_iff sym=false goal=4
    #[5] x Mem A | x Mem B
  ← rule disjI2 goal=5
qed

-- Eliminate a bounded universal at a member: `(∀z. z ∈ B ⟶ P z)` plus
-- `y ∈ B` gives `P y` in one checked step (`rule all_mem_elim`), which is what
-- every `strict_sorted` proof needs when it uses the head-adjacent law.
theorem all_mem_elim
  fixes B :: 'a set, y :: 'a, P :: 'a ⇒ bool
  prop (∀z. z Mem B ⟶ P z) ⟶ y Mem B ⟶ P y
proof
  ← intro goal=0
    #[1] !z. z Mem B --> P z
    #[2] y Mem B
    #[3] P y
  ← inst y goal=3 facts=[1]
    #[4] y Mem B --> P y
  ← apply_prev goal=3 facts=[4,2]
qed

header "Image"

theorem image_empty
  fixes f :: 'a => 'b
  prop image f {} = {}
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] ∀x. x ∈ image f ∅ ⟷ x ∈ ∅
  ← rewrite in_image sym=false goal=1
    #[2] ∀x. (∃x1. x1 ∈ ∅ ∧ x = f x1) ⟷ x ∈ ∅
  ← rewrite member_empty_simp sym=false goal=2
    #[3] ∀x. (∃x1. false ∧ x = f x1) ⟷ false
  ← rewrite conj_false_right sym=false goal=3
    #[4] ∀x::'b. (∃x1::'a. false) ⟷ false
  ← rewrite exists_false sym=false goal=4
    #[5] ∀x::'b. false ⟷ false
  ← intro x goal=5
    #[6] _VAR x
    #[7] false ⟷ false
  ← refl goal=7
qed

theorem image_insert
  fixes f :: 'a => 'b, A :: 'a set, a :: 'a
  prop image f (insert a A) = insert (f a) (image f A)
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
  ← intro x goal=1
  ← rewrite in_image sym=false goal=3
  ← rewrite member_insert sym=false goal=4
  ← rewrite exists_disj_conj_distrib sym=false goal=5
  ← rewrite exists_eq_left sym=false goal=6
  ← rewrite in_image sym=true goal=7
qed

header "Finite sets"

-- The three lemmas below are the *only* way out of the `finite_def`
-- encoding used in this theory: `finite A` is definitionally
-- `∀P. P {} ∧ (∀x B. P B ⟶ P (insert x B)) ⟶ P A`, so every derived
-- fact about finite sets has to be obtained by instantiating that P
-- (finite_induct), by building an insertion (finite_insert_imp), or by
-- shrinking to a subset (finite_subset).

theorem finite_induct
  fixes A :: 'a set
  prop finite A --> (!P::'a set => bool. P {} & (!x. !B. P B --> P (insert x B)) --> P A)
proof
  ← intro goal=0
  → rewrite target=fact finite_def sym=false goal=2 facts=[1]
qed

theorem finite_insert_imp
  fixes A :: 'a set, a :: 'a
  prop finite A --> finite (insert a A)
proof
  ← intro goal=0
  ← rewrite finite_def sym=false goal=2
  ← intro P goal=3
  → rewrite target=fact finite_def sym=false goal=6 facts=[1]
  → inst "P" goal=6 facts=[7]
  → forward goal=6 facts=[8,5]
  → forward conjD2 goal=6 facts=[5]
  → inst a goal=6 facts=[10]
  → inst A goal=6 facts=[11]
  ← apply_prev goal=6 facts=[12,9]
qed

theorem finite_empty
  fixes A :: 'a set
  prop finite ({}::'a set)
  [hint_backward]
proof
  ← rewrite finite_def sym=false goal=0
  ← intro P goal=1
  → forward conjD1 goal=4 facts=[3]
qed

-- The induction in `finite_def` only *adds* elements, so a statement about
-- arbitrary subsets has to be phrased as a predicate on the constructed set
-- and instantiated for the P.  `fin_sub` is that predicate; this lemma
-- derives it from `finite A` by discharging its two induction premises
-- (`fin_sub {}`, and the insert step, which is where the case split on
-- `x ∈ Y` lands).  Subset closure then follows by running the forall in
-- `fin_sub`.
theorem finite_fin_sub
  fixes A :: 'a set
  prop finite A --> fin_sub A
proof
  ← intro goal=0
  → rewrite target=fact finite_def sym=false goal=2 facts=[1]
  → inst "(fin_sub::'a set => bool)" goal=2 facts=[3]
  cut "fin_sub ({}::'a set) & (!x::'a. !B1::'a set. fin_sub B1 --> fin_sub (insert x B1))" goal=2
  ← rule conjI goal=5
  ← rewrite fin_sub_def sym=false goal=6
  ← intro Y goal=8
  → rewrite target=fact subset_empty sym=false goal=11 facts=[10]
  ← rewrite source=prev goal=11 facts=[12]
  ← rule finite_empty goal=13
  ← intro x,B1 goal=7
  → rewrite target=fact fin_sub_def sym=false goal=18 facts=[17]
  ← rewrite fin_sub_def sym=false goal=18
  ← intro Y goal=20
  cases "x Mem Y" goal=22
  ← intro goal=24
  → forward subset_insert_imp goal=26 facts=[21,25]
  → inst "Y" goal=26 facts=[19]
  ← apply_prev goal=26 facts=[28,27]
  ← intro goal=23
  → forward delete_subset_insert goal=31 facts=[21]
  → inst "delete Y x" goal=31 facts=[19]
  → forward goal=31 facts=[33,32]
  → forward insert_delete goal=31 facts=[30]
  → rewrite target=fact eq_sym_eq sym=false goal=31 facts=[35]
  ← rewrite source=prev goal=31 facts=[36]
  ← rule finite_insert_imp goal=37 facts=[34]
  ← apply_prev goal=2 facts=[4,5]
qed

theorem finite_subset
  fixes A :: 'a set, B :: 'a set
  prop A Sub B --> finite B --> finite A
  [hint_backward]
proof
  ← intro goal=0
  → forward finite_fin_sub goal=3 facts=[2]
  → rewrite target=fact fin_sub_def sym=false goal=3 facts=[4]
  ← apply_prev goal=3 facts=[5,1]
qed

theorem finite_insert
  fixes A :: 'a set, a :: 'a
  prop finite (insert a A) <--> finite A
  [hint_backward,hint_rewrite]
proof
  ← rule iffI goal=0
  ← intro goal=1
  → forward subset_insert param_A=A param_a=a goal=4
  ← rule finite_subset goal=4 facts=[5,3]
  ← intro goal=2
  ← rule finite_insert_imp goal=7 facts=[6]
qed

theorem finite_union_imp
  fixes A :: 'a set, B :: 'a set
  prop finite A --> finite B --> finite (A Un B)
  [hint_backward]
proof
  ← intro goal=0
  → rewrite target=fact finite_def sym=false goal=3 facts=[2]
  → inst "(fin_union A)" goal=3 facts=[4]
  cut "fin_union A {} & (!x::'a. !B1::'a set. fin_union A B1 --> fin_union A (insert x B1))" goal=3
  ← rule conjI goal=6
  ← rewrite fin_union_def sym=false goal=7
  ← rewrite union_empty sym=false goal=9
  ← intro x,B1 goal=8
  → rewrite target=fact fin_union_def sym=false goal=13 facts=[12]
  ← rewrite fin_union_def sym=false goal=13
  ← rewrite union_insert sym=false goal=15
  ← rule finite_insert_imp goal=16 facts=[14]
  ← rewrite fin_union_def sym=true goal=3
  ← apply_prev goal=18 facts=[5,6]
qed

theorem finite_inter
  fixes A :: 'a set, B :: 'a set
  prop finite A | finite B --> finite (A Int B)
  [hint_backward]
proof
  ← intro goal=0
  ← rule disjE2 param_A="finite A" param_B="finite B" goal=2
  ← intro goal=3
  → forward subset_inter_left param_A=A param_B=B goal=6
  ← rule finite_subset goal=6 facts=[7,5]
  ← intro goal=4
  → forward subset_inter_right param_A=A param_B=B goal=10
  ← rule finite_subset goal=10 facts=[11,9]
qed

theorem finite_image
  fixes f :: 'a => 'b, A :: 'a set
  prop finite A --> finite (image f A)
  [hint_backward]
proof
  ← intro goal=0
  → rewrite target=fact finite_def sym=false goal=2 facts=[1]
  → inst "(fin_image f)" goal=2 facts=[3]
  cut "fin_image f {} & (!x::'a. !B::'a set. fin_image f B --> fin_image f (insert x B))" goal=2
  ← rule conjI goal=5
  ← rewrite fin_image_def sym=false goal=6
  ← rewrite image_empty sym=false goal=8
  ← rule finite_empty goal=9
  ← intro x,B goal=7
  → rewrite target=fact fin_image_def sym=false goal=14 facts=[13]
  ← rewrite fin_image_def sym=false goal=14
  ← rewrite image_insert sym=false goal=16
  ← rule finite_insert_imp goal=17 facts=[15]
  ← rewrite fin_image_def sym=true goal=2
  ← apply_prev goal=19 facts=[4,5]
qed

theorem finite_delete
  fixes A :: 'a set, a :: 'a
  prop finite (delete A a) <--> finite A
  [hint_backward,hint_rewrite]
proof
  ← rule iffI goal=0
  ← intro goal=1
  → forward subset_insert_delete param_A=A param_a=a goal=4
  → forward finite_insert_imp param_a=a goal=4 facts=[3]
  ← rule finite_subset goal=4 facts=[5,6]
  ← intro goal=2
  → forward subset_delete param_A=A param_a=a goal=8
  ← rule finite_subset goal=8 facts=[9,7]
qed

theorem finite_diff
  fixes A :: 'a set, B :: 'a set
  prop finite A --> finite (diff A B)
  [hint_backward]
proof
  ← intro goal=0
  → forward subset_diff param_A=A param_B=B goal=2
  ← rule finite_subset goal=2 facts=[3,1]
qed

header "Image"

theorem image_id
  fixes A :: 'a set
  prop image (%x. x) A = A
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] ∀x. x ∈ image (λx1. x1) A ⟷ x ∈ A
  ← rewrite in_image sym=false goal=1
    #[2] ∀x. (∃x1. x1 ∈ A ∧ x = x1) ⟷ x ∈ A
  ← rewrite exists_eq sym=false goal=2
    #[3] ∀x. x ∈ A ⟷ x ∈ A
  ← intro x goal=3
    #[4] _VAR x
    #[5] x ∈ A ⟷ x ∈ A
  ← refl goal=5
qed

theorem image_combine
  fixes f :: 'b => 'c, g :: 'a => 'b, A :: 'a set
  prop image f (image g A) = image (g O f) A
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
  ← intro x goal=1
  ← rewrite in_image sym=false goal=3
  ← rewrite in_image sym=false goal=4
  ← rewrite comp_fun_def sym=false goal=5
  ← rewrite exists_flatten sym=false goal=6
qed

theorem insert_absorb
  fixes A :: 'a set, a :: 'a
  prop a Mem A --> insert a A = A
  [hint_rewrite]
proof
  ← intro goal=0
  ← rewrite set_equal_iff sym=false goal=2
  ← intro x goal=3
  ← rewrite member_insert sym=false goal=5
  cases "x = a" goal=6
  ← intro goal=7
  ← rewrite disj_comm sym=false goal=10
  ← rewrite disj_iff_left sym=false goal=11
  ← intro goal=12
  → rewrite target=fact eq_sym_eq sym=false goal=13 facts=[9]
  → rewrite target=fact source=prev goal=13 facts=[14,1]
  ← intro goal=8
  → rewrite target=fact eq_false sym=false goal=16 facts=[15]
  ← rewrite source=prev goal=16 facts=[17]
  ← rewrite disj_false_left sym=false goal=18
qed

-- An element is a member of its own singleton, and inserting it twice is
-- inserting it once.  The second is what the `ordered_insert` equation for the
-- `x = y` case needs (there the right-hand set is `{x} Un set (y # ys)`).
theorem mem_insert_self
  fixes x :: 'a, A :: 'a set
  prop x ∈ insert x A
proof
  ← rewrite member_insert sym=false goal=0
    #[1] x = x | x Mem A
  ← rule disjI1 goal=1
    #[2] x = x
  ← refl goal=2
qed

theorem insert_idem
  fixes x :: 'a, A :: 'a set
  prop insert x (insert x A) = insert x A
  [hint_rewrite]
proof
  → forward mem_insert_self param_x=x param_A=A goal=0
    #[1] x Mem insert x A
  ← rule insert_absorb goal=0 facts=[1]
qed

theorem exists_in_gspec1
  fixes P :: 'a => bool, Q :: 'a => bool
  prop (?x. x Mem {y. P y} & Q x) <--> (?x. P x & Q x)
  [hint_rewrite]
proof
  ← rewrite member_collect sym=false goal=0
qed

theorem forall_in_gspec1
  fixes P :: 'a => bool, Q :: 'a => bool
  prop (!x. x Mem {y. P y} --> Q x) <--> (!x. P x --> Q x)
  [hint_rewrite]
proof
  ← rewrite member_collect sym=false goal=0
qed

header "Cardinality and surjectivity"

-- `card` is AXIOMATIZED, not defined, and this is deliberate.  A real
-- definition would be `card A = the n such that A is in bijection with
-- {0..<n}` (or: A has a distinct enumeration of length n); using either
-- form requires proving that witness n is unique, i.e. the pigeonhole
-- principle, which this library does not have (holpy also has no
-- type-definition primitive, so the usual `finited` quotient route is
-- closed too).
--
-- The two equations below characterize card on *every finite set* -- by
-- `finite_induct` they pin down card A for all finite A -- so this is a
-- complete recursion, not an arbitrary axiomatization.  It has the same
-- status as the deliberate `set_equal_iff` axiom above: listed as AXIOM by
-- the verifier and surfaced in the trust report.
axiom card_empty
  fixes A :: 'a set
  prop card ({}::'a set) = 0

axiom card_insert
  fixes A :: 'a set, a :: 'a
  prop finite A --> ~(a Mem A) --> card (insert a A) = Suc (card A)

-- {i | i < n} is the shape auto2's Dijkstra uses (`verts G = {i. i < size G}`),
-- so the two facts that make it usable are proved here from the axioms.
theorem less_than_eq_empty
  fixes n :: nat
  prop ({i::nat. i < 0}::nat set) = {}
proof
  ← rewrite set_equal_iff sym=false goal=0
  ← intro x goal=1
  ← rewrite member_collect sym=false goal=3
  ← rewrite member_empty_simp sym=false goal=4
  ← rewrite nat_less_def_1 sym=false goal=5
qed

theorem less_than_eq_insert
  fixes n :: nat
  prop ({i::nat. i < Suc n}::nat set) = insert n {i::nat. i < n}
proof
  ← rewrite set_equal_iff sym=false goal=0
  ← intro x goal=1
  ← rewrite member_collect sym=false goal=3
  ← rewrite member_insert sym=false goal=4
  ← rewrite member_collect sym=false goal=5
  ← rewrite nat_less_def_2 sym=false goal=6
qed

theorem less_than_finite
  fixes n :: nat
  prop finite ({i::nat. i < n}::nat set)
proof
  ← induct n nat_induct goal=0
  ← rewrite less_than_eq_empty sym=false goal=1
  ← rule finite_empty goal=3
  ← rewrite less_than_eq_insert sym=false goal=2
  ← rewrite finite_insert sym=false goal=4
qed

theorem less_than_card
  fixes n :: nat
  prop card ({i::nat. i < n}::nat set) = n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
  ← rewrite less_than_eq_empty sym=false goal=1
  ← rule card_empty goal=3
  ← intro n goal=2
  ← rewrite less_than_eq_insert sym=false goal=6
  → forward less_than_finite param_n=n goal=7
  cut "~(n Mem {i::nat. i < n})" goal=7
  ← rewrite member_collect sym=false goal=9
  ← rule less_irrefl goal=10
  → forward card_insert goal=7 facts=[8,9]
  ← rewrite source=prev goal=7 facts=[12]
  ← rewrite source=prev goal=13 facts=[5]
qed


theorem card_image_inj
  fixes f :: 'a => 'b, s :: 'a set
  prop finite s --> (!x. !y. x Mem s --> y Mem s --> f x = f y --> x = y) --> card (image f s) = card s
proof
  ← intro goal=0
    #[1] finite s
    #[2] !x. !y. x Mem s --> y Mem s --> f x = f y --> x = y
    #[3] card (image f s) = card s
  → forward finite_induct param_A=s goal=3 facts=[1]
    #[4] !P. P {} & (!x. !B. P B --> P (insert x B)) --> P s
  ← inst "(card_inj::('a => 'b) => 'a set => bool) f" goal=3 facts=[4]
    #[5] card_inj f {} & (!x. !B. card_inj f B --> card_inj f (insert x B)) --> card_inj f s
  cut "card_inj f ({}::'a set) & (!x::'a. !B::'a set. card_inj f B --> card_inj f (insert x B))" goal=3
    #[6] card_inj f {} & (!x. !B. card_inj f B --> card_inj f (insert x B))
  ← rule conjI goal=6
    #[7] card_inj f {}
    #[8] !x. !B. card_inj f B --> card_inj f (insert x B)
  ← rewrite card_inj_def sym=false goal=7
    #[9] finite ({}::'a => bool) --> (!x. !y. x Mem {} --> y Mem {} --> f x = f y --> x = y) --> card (image f {}) = card ({}::'a => bool)
  ← intro goal=9
    #[10] finite ({}::'a => bool)
    #[11] !x. !y. x Mem {} --> y Mem {} --> f x = f y --> x = y
    #[12] card (image f {}) = card ({}::'a => bool)
  ← rewrite image_empty sym=false goal=12
    #[13] card ({}::'b => bool) = card ({}::'a => bool)
  ← rewrite card_empty sym=false goal=13
    #[14] card ({}::'b => bool) = card ({}::'a => bool)
  ← intro x,B goal=8
    #[15] _VAR x
    #[16] _VAR B
    #[17] card_inj f B
    #[18] card_inj f (insert x B)
  ← rewrite card_inj_def sym=false goal=18
    #[19] finite (insert x B) --> (!x1. !y. x1 Mem insert x B --> y Mem insert x B --> f x1 = f y --> x1 = y) --> card (image f (insert x B)) = card (insert x B)
  ← intro goal=19
    #[20] finite (insert x B)
    #[21] !x1. !y. x1 Mem insert x B --> y Mem insert x B --> f x1 = f y --> x1 = y
    #[22] card (image f (insert x B)) = card (insert x B)
  → rewrite finite_insert sym=false target=fact goal=22 facts=[20]
    #[23] finite B
  cut "!u::'a. !v::'a. u Mem B --> v Mem B --> f u = f v --> u = v" goal=22
    #[24] !u. !v. u Mem B --> v Mem B --> f u = f v --> u = v
  ← intro u,v goal=24
    #[25] _VAR u
    #[26] _VAR v
    #[27] u Mem B
    #[28] v Mem B
    #[29] f u = f v
    #[30] u = v
  → forward subset_insert param_A=B param_a=x goal=27
    #[31] B Sub insert x B
  → forward subsetE goal=30 facts=[31,27]
    #[32] u Mem insert x B
  → forward subsetE goal=30 facts=[31,28]
    #[33] v Mem insert x B
  ← apply_prev goal=30 facts=[21,32,33,29]
    #[34] u = v
  ← cases "x Mem B" goal=22
    #[35] x Mem B --> card (image f (insert x B)) = card (insert x B)
    #[36] ~(x Mem B) --> card (image f (insert x B)) = card (insert x B)
  ← intro goal=35
    #[37] x Mem B
    #[38] card (image f (insert x B)) = card (insert x B)
  → forward insert_absorb goal=38 facts=[37]
    #[39] insert x B = B
  ← rewrite source=prev goal=38 facts=[39]
    #[40] card (image f B) = card B
  → rewrite card_inj_def sym=false target=fact goal=40 facts=[17]
    #[41] finite B --> (!x. !y. x Mem B --> y Mem B --> f x = f y --> x = y) --> card (image f B) = card B
  ← apply_prev goal=40 facts=[41,23,24]
    #[42] card (image f B) = card B
  ← intro goal=36
    #[43] ~(x Mem B)
    #[44] card (image f (insert x B)) = card (insert x B)
  → forward finite_image param_A=B param_f=f goal=44
    #[45] finite B --> finite (image f B)
  → forward image_insert param_A=B param_a=x param_f=f goal=44
    #[46] image f (insert x B) = insert (f x) (image f B)
  → forward card_insert param_A=B param_a=x goal=44 facts=[23,43]
    #[47] card (insert x B) = Suc (card B)
  → forward goal=44 facts=[45,23]
    #[48] finite (image f B)
  cut "x Mem insert x B" goal=44
    #[49] x Mem insert x B
  ← rewrite member_insert sym=false goal=49
    #[50] x = x | x Mem B
  ← rule disjI1 goal=50
    #[51] x = x
  ← rule eq_refl goal=51
    #[52] x = x
  cut "~(f x Mem image f B)" goal=44
    #[53] ~(f x Mem image f B)
  ← rule negI goal=53
    #[54] f x Mem image f B --> false
  ← intro goal=54
    #[55] f x Mem image f B
    #[56] false
  → rewrite in_image sym=false target=fact goal=56 facts=[55]
    #[57] ?x1. x1 Mem B & f x = f x1
  elim z goal=56 facts=[57]
    #[58] _VAR z
    #[59] z Mem B & f x = f z
    #[60] false
  → forward conjD1 goal=60 facts=[59]
    #[61] z Mem B
  → forward conjD2 goal=60 facts=[59]
    #[62] f x = f z
  → forward subset_insert param_A=B param_a=x goal=60
  → forward subsetE goal=60 facts=[31,61]
    #[63] z Mem insert x B
  → forward goal=60 facts=[21,49,63,62]
    #[64] x = z
  → rewrite eq_sym_eq sym=false target=fact goal=60 facts=[64]
    #[65] z = x
  → rewrite source=prev target=fact goal=60 facts=[65,61]
    #[66] x Mem B
  ← rule negE_gen param_A="x Mem B" goal=60 facts=[43,66]
    #[67] false
  → forward card_insert param_A="image f B" param_a="f x" goal=44 facts=[48,53]
    #[68] card (insert (f x) (image f B)) = Suc (card (image f B))
  ← rewrite source=prev goal=44 facts=[46]
    #[69] card (insert (f x) (image f B)) = card (insert x B)
  ← rewrite source=prev goal=69 facts=[68]
    #[70] Suc (card (image f B)) = card (insert x B)
  ← rewrite source=prev goal=70 facts=[47]
    #[71] Suc (card (image f B)) = Suc (card B)
  → rewrite card_inj_def sym=false target=fact goal=71 facts=[17]
  → forward goal=71 facts=[41,23,24]
  ← rewrite source=prev goal=71 facts=[42]
    #[72] Suc (card (image f B)) = Suc (card B)
  → forward goal=3 facts=[5,6]
    #[73] card_inj f s
  → rewrite card_inj_def sym=false target=fact goal=3 facts=[73]
    #[74] finite s --> (!x. !y. x Mem s --> y Mem s --> f x = f y --> x = y) --> card (image f s) = card s
  ← apply_prev goal=3 facts=[74,1,2]
qed

-- The three predicates below exist only so that `finite_induct` can be
-- instantiated as P without a lambda (hence without a beta-redex):
-- `card_le_bound`/`card_img_le` are the monotonicity facts, `card_faithful`
-- is the pigeonhole step "equal image cardinality forces injectivity".
-- `card_le_bound` quantifies over the bounded set *inside* P: the induction
-- step for `x ∈ A` needs the hypothesis at `delete A x`, which is only
-- available if P is instantiated for every subset, not just for A.
def card_le_bound :: 'a set ⇒ bool = card_le_bound X ⟷ (!A::'a set. finite X --> A Sub X --> card A <= card X) [hint_rewrite]

def card_img_le :: ('a ⇒ 'b) ⇒ 'a set ⇒ bool = card_img_le g X ⟷ (finite X --> card (image g X) <= card X) [hint_rewrite]

def card_faithful :: ('a ⇒ 'a) ⇒ 'a set ⇒ bool = card_faithful g X ⟷ (finite X --> card (image g X) = card X --> (!x. !y. x Mem X --> y Mem X --> g x = g y --> x = y)) [hint_rewrite]

theorem insert_subset_imp
  fixes A :: 'a set, B :: 'a set, x :: 'a
  prop x Mem B --> A Sub B --> insert x A Sub B
proof
  ← intro goal=0
    #[1] x Mem B
    #[2] A Sub B
    #[3] insert x A Sub B
  ← rewrite subset_def sym=false goal=3
    #[4] !x1. x1 Mem insert x A --> x1 Mem B
  ← intro z goal=4
    #[5] _VAR z
    #[6] z Mem insert x A
    #[7] z Mem B
  → rewrite member_insert sym=false target=fact goal=7 facts=[6]
    #[8] z = x | z Mem A
  ← cases "z Mem A" goal=7
    #[9] z Mem A --> z Mem B
    #[10] ~(z Mem A) --> z Mem B
  ← intro goal=9
    #[11] z Mem A
    #[12] z Mem B
  → forward subsetE goal=12 facts=[2,11]
    #[13] z Mem B
  ← intro goal=10
    #[14] ~(z Mem A)
    #[15] z Mem B
  → forward force_disj_true1 goal=15 facts=[8,14]
    #[16] z = x
  → rewrite eq_sym_eq sym=false target=fact goal=15 facts=[16]
    #[17] x = z
  → rewrite source=prev target=fact goal=15 facts=[17,1]
    #[18] z Mem B
qed

theorem card_le_bound_empty
  fixes A :: 'a set
  prop A Sub {} --> card A <= card ({}::'a set)
proof
  ← intro goal=0
  → rewrite target=fact subset_empty sym=false goal=2 facts=[1]
  ← rewrite source=prev goal=2 facts=[3]
  ← rewrite card_empty sym=false goal=4
  ← rule less_eq_refl goal=5
qed

theorem not_mem_delete_self
  fixes A :: 'a set, x :: 'a
  prop ~(x Mem delete A x)
proof
  ← rule negI goal=0
  ← intro goal=1
  → rewrite target=fact member_delete sym=false goal=3 facts=[2]
  → forward conjD2 goal=3 facts=[4]
  → forward eq_refl param_x=x goal=3
  ← rule negE_gen param_A="x = x" goal=3 facts=[5,6]
qed

theorem delete_subset_insert_imp
  fixes A :: 'a set, B :: 'a set, x :: 'a
  prop x Mem A --> A Sub insert x B --> delete A x Sub B
proof
  ← intro goal=0
  ← rewrite subset_def sym=false goal=3
  ← intro y goal=4
  → rewrite target=fact member_delete sym=false goal=7 facts=[6]
  → forward conjD1 goal=7 facts=[8]
  → forward conjD2 goal=7 facts=[8]
  → forward subsetE goal=7 facts=[2,9]
  → rewrite target=fact member_insert sym=false goal=7 facts=[11]
  → rewrite target=fact disj_comm sym=false goal=7 facts=[12]
  ← rule force_disj_true1 goal=7 facts=[13,10]
qed

theorem card_mono
  fixes A :: 'a set, B :: 'a set
  prop A Sub B --> finite B --> card A <= card B
proof
  ← intro goal=0
    #[1] A Sub B
    #[2] finite B
    #[3] card A <= card B
  → forward finite_induct param_A=B goal=3 facts=[2]
    #[4] !P. P {} & (!x. !B1. P B1 --> P (insert x B1)) --> P B
  ← inst "(card_le_bound::'a set => bool)" goal=3 facts=[4]
    #[5] card_le_bound ({}::'a => bool) & (!x::'a. !B1. card_le_bound B1 --> card_le_bound (insert x B1)) --> card_le_bound B
  cut "card_le_bound ({}::'a set) & (!x::'a. !B1::'a set. card_le_bound B1 --> card_le_bound (insert x B1))" goal=3
    #[6] card_le_bound ({}::'a => bool) & (!x::'a. !B1. card_le_bound B1 --> card_le_bound (insert x B1))
  ← rule conjI goal=6
    #[7] card_le_bound ({}::'a => bool)
    #[8] !x::'a. !B1. card_le_bound B1 --> card_le_bound (insert x B1)
  ← rewrite card_le_bound_def sym=false goal=7
    #[9] !A::'a => bool. finite ({}::'a => bool) --> A Sub {} --> card A <= card ({}::'a => bool)
  ← intro A1 goal=9
    #[10] _VAR A1
    #[11] finite ({}::'a => bool)
    #[12] A1 Sub {}
    #[13] card A1 <= card ({}::'a => bool)
  → forward card_le_bound_empty param_A=A1 goal=13
    #[14] A1 Sub {} --> card A1 <= card ({}::'a => bool)
  ← apply_prev goal=13 facts=[14,12]
    #[15] card A1 <= card ({}::'a => bool)
  ← intro x,B1 goal=8
    #[16] _VAR x
    #[17] _VAR B1
    #[18] card_le_bound B1
    #[19] card_le_bound (insert x B1)
  → rewrite card_le_bound_def sym=false target=fact goal=19 facts=[18]
    #[20] !A. finite B1 --> A Sub B1 --> card A <= card B1
  ← rewrite card_le_bound_def sym=false goal=19
    #[21] !A. finite (insert x B1) --> A Sub insert x B1 --> card A <= card (insert x B1)
  ← intro A1 goal=21
    #[22] finite (insert x B1)
    #[23] A1 Sub insert x B1
    #[24] card A1 <= card (insert x B1)
  → rewrite finite_insert sym=false target=fact goal=24 facts=[22]
    #[25] finite B1
  ← cases "x Mem B1" goal=24
    #[26] x Mem B1 --> card A1 <= card (insert x B1)
    #[27] ~(x Mem B1) --> card A1 <= card (insert x B1)
  ← intro goal=26
    #[28] x Mem B1
    #[29] card A1 <= card (insert x B1)
  → forward insert_absorb goal=29 facts=[28]
    #[30] insert x B1 = B1
  → rewrite source=prev target=fact goal=29 facts=[30,23]
    #[31] A1 Sub B1
  ← rewrite source=prev goal=29 facts=[30]
    #[32] card A1 <= card B1
  ← apply_prev goal=32 facts=[20,25,31]
    #[33] card A1 <= card B1
  ← intro goal=27
    #[34] ~(x Mem B1)
    #[35] card A1 <= card (insert x B1)
  ← cases "x Mem A1" goal=35
    #[36] x Mem A1 --> card A1 <= card (insert x B1)
    #[37] ~(x Mem A1) --> card A1 <= card (insert x B1)
  ← intro goal=37
    #[38] ~(x Mem A1)
    #[39] card A1 <= card (insert x B1)
  → forward subset_insert_imp goal=39 facts=[23,38]
    #[40] A1 Sub B1
  ← inst A1 goal=39 facts=[20]
    #[41] finite B1 --> A1 Sub B1 --> card A1 <= card B1
  ← rewrite card_insert sym=false goal=39 facts=[25,34]
    #[42] card A1 <= Suc (card B1)
  ← rewrite nat_less_eq_def_2 sym=false goal=42
    #[43] card A1 = Suc (card B1) | card A1 <= card B1
  ← rule disjI2 goal=43
    #[44] card A1 <= card B1
  ← apply_prev goal=44 facts=[41,25,40]
    #[45] card A1 <= card B1
  ← intro goal=36
    #[46] x Mem A1
    #[47] card A1 <= card (insert x B1)
  → forward insert_delete goal=47 facts=[46]
    #[48] insert x (delete A1 x) = A1
  → rewrite eq_sym_eq sym=false target=fact goal=47 facts=[48]
    #[49] A1 = insert x (delete A1 x)
  ← rewrite source=prev goal=47 facts=[49]
    #[50] card (insert x (delete A1 x)) <= card (insert x B1)
  → forward finite_subset param_A=A1 param_B="insert x B1" goal=50 facts=[23,22]
    #[51] finite A1
  → forward subset_delete param_A=A1 param_a=x goal=50
    #[52] delete A1 x Sub A1
  → forward finite_subset goal=50 facts=[52,51]
    #[53] finite (delete A1 x)
  → forward not_mem_delete_self param_A=A1 param_x=x goal=50
    #[54] ~(x Mem delete A1 x)
  ← rewrite card_insert sym=false goal=50 facts=[53,54]
    #[55] Suc (card (delete A1 x)) <= card (insert x B1)
  ← rewrite card_insert sym=false goal=55 facts=[25,34]
    #[56] Suc (card (delete A1 x)) <= Suc (card B1)
  ← rewrite lesseq_Suc_less sym=false goal=56
    #[57] card (delete A1 x) < Suc (card B1)
  ← rewrite less_Suc_lesseq sym=false goal=57
    #[58] card (delete A1 x) <= card B1
  → forward delete_subset_insert_imp goal=58 facts=[46,23]
    #[59] delete A1 x Sub B1
  ← inst "delete A1 x" goal=58 facts=[20]
    #[60] finite B1 --> delete A1 x Sub B1 --> card (delete A1 x) <= card B1
  ← apply_prev goal=58 facts=[60,25,59]
    #[61] card (delete A1 x) <= card B1
  → forward goal=3 facts=[5,6]
    #[62] card_le_bound B
  → rewrite card_le_bound_def sym=false target=fact goal=3 facts=[62]
    #[63] !A. finite B --> A Sub B --> card A <= card B
  ← apply_prev goal=3 facts=[63,2,1]
qed

theorem card_image_le
  fixes g :: 'a => 'b, X :: 'a set
  prop finite X --> card (image g X) <= card X
proof
  ← intro goal=0
    #[1] finite X
    #[2] card (image g X) <= card X
  → forward finite_induct param_A=X goal=2 facts=[1]
    #[3] !P. P {} & (!x. !B. P B --> P (insert x B)) --> P X
  ← inst "(card_img_le::('a => 'b) => 'a set => bool) g" goal=2 facts=[3]
    #[4] card_img_le g {} & (!x. !B. card_img_le g B --> card_img_le g (insert x B)) --> card_img_le g X
  cut "card_img_le g ({}::'a set) & (!x::'a. !B::'a set. card_img_le g B --> card_img_le g (insert x B))" goal=2
    #[5] card_img_le g {} & (!x. !B. card_img_le g B --> card_img_le g (insert x B))
  ← rule conjI goal=5
    #[6] card_img_le g {}
    #[7] !x. !B. card_img_le g B --> card_img_le g (insert x B)
  ← rewrite card_img_le_def sym=false goal=6
    #[8] finite ({}::'a => bool) --> card (image g {}) <= card ({}::'a => bool)
  ← intro goal=8
    #[9] finite ({}::'a => bool)
    #[10] card (image g {}) <= card ({}::'a => bool)
  ← rewrite image_empty sym=false goal=10
    #[11] card ({}::'b => bool) <= card ({}::'a => bool)
  ← rewrite card_empty sym=false goal=11
    #[12] (0::nat) <= 0
  ← rule less_eq_refl goal=12
    #[13] (0::nat) <= 0
  ← intro x,B goal=7
    #[14] _VAR x
    #[15] _VAR B
    #[16] card_img_le g B
    #[17] card_img_le g (insert x B)
  → rewrite card_img_le_def sym=false target=fact goal=17 facts=[16]
    #[18] finite B --> card (image g B) <= card B
  ← rewrite card_img_le_def sym=false goal=17
    #[19] finite (insert x B) --> card (image g (insert x B)) <= card (insert x B)
  ← intro goal=19
    #[20] finite (insert x B)
    #[21] card (image g (insert x B)) <= card (insert x B)
  → rewrite finite_insert sym=false target=fact goal=21 facts=[20]
    #[22] finite B
  ← cases "x Mem B" goal=21
    #[23] x Mem B --> card (image g (insert x B)) <= card (insert x B)
    #[24] ~(x Mem B) --> card (image g (insert x B)) <= card (insert x B)
  ← intro goal=23
    #[25] x Mem B
    #[26] card (image g (insert x B)) <= card (insert x B)
  → forward insert_absorb goal=26 facts=[25]
    #[27] insert x B = B
  ← rewrite source=prev goal=26 facts=[27]
    #[28] card (image g B) <= card B
  ← apply_prev goal=28 facts=[18,22]
    #[29] card (image g B) <= card B
  ← intro goal=24
    #[30] ~(x Mem B)
    #[31] card (image g (insert x B)) <= card (insert x B)
  ← rewrite image_insert sym=false goal=31
    #[32] card (insert (g x) (image g B)) <= card (insert x B)
  ← rewrite card_insert sym=false goal=32 facts=[22,30]
    #[33] card (insert (g x) (image g B)) <= Suc (card B)
  → forward finite_image param_A=B param_f=g goal=33
    #[34] finite B --> finite (image g B)
  → forward goal=33 facts=[34,22]
    #[35] finite (image g B)
  ← cases "g x Mem image g B" goal=33
    #[36] g x Mem image g B --> card (insert (g x) (image g B)) <= Suc (card B)
    #[37] ~(g x Mem image g B) --> card (insert (g x) (image g B)) <= Suc (card B)
  ← intro goal=36
    #[38] g x Mem image g B
    #[39] card (insert (g x) (image g B)) <= Suc (card B)
  → forward insert_absorb goal=39 facts=[38]
    #[40] insert (g x) (image g B) = image g B
  ← rewrite source=prev goal=39 facts=[40]
    #[41] card (image g B) <= Suc (card B)
  ← rewrite nat_less_eq_def_2 sym=false goal=41
    #[42] card (image g B) = Suc (card B) | card (image g B) <= card B
  ← rule disjI2 goal=42
    #[43] card (image g B) <= card B
  ← apply_prev goal=43 facts=[18,22]
  ← intro goal=37
    #[44] ~(g x Mem image g B)
    #[45] card (insert (g x) (image g B)) <= Suc (card B)
  ← rewrite card_insert sym=false goal=45 facts=[35,44]
    #[46] Suc (card (image g B)) <= Suc (card B)
  ← rewrite lesseq_Suc_less sym=false goal=46
    #[47] card (image g B) < Suc (card B)
  ← rewrite less_Suc_lesseq sym=false goal=47
    #[48] card (image g B) <= card B
  ← apply_prev goal=48 facts=[18,22]
  → forward goal=2 facts=[4,5]
    #[49] card_img_le g X
  → rewrite card_img_le_def sym=false target=fact goal=2 facts=[49]
    #[50] finite X --> card (image g X) <= card X
  ← apply_prev goal=2 facts=[50,1]
qed

theorem card_subset_eq
  fixes A :: 'a set, B :: 'a set
  prop A Sub B --> finite B --> card A = card B --> A = B
proof
  ← intro goal=0
    #[1] A Sub B
    #[2] finite B
    #[3] card A = card B
    #[4] A = B
  → forward finite_subset param_A=A param_B=B goal=4 facts=[1,2]
    #[5] finite A
  ← rewrite set_equal_iff sym=false goal=4
    #[6] !x. x Mem A <--> x Mem B
  ← intro z goal=6
    #[7] _VAR z
    #[8] z Mem A <--> z Mem B
  ← rule iffI goal=8
    #[9] z Mem A --> z Mem B
    #[10] z Mem B --> z Mem A
  ← intro goal=9
    #[11] z Mem A
    #[12] z Mem B
  → forward subsetE goal=12 facts=[1,11]
    #[13] z Mem B
  ← intro goal=10
    #[14] z Mem B
    #[15] z Mem A
  ← cases "z Mem A" goal=15
    #[16] z Mem A --> z Mem A
    #[17] ~(z Mem A) --> z Mem A
  ← intro goal=17
    #[18] ~(z Mem A)
    #[19] z Mem A
  → forward insert_subset_imp goal=19 facts=[14,1]
    #[20] insert z A Sub B
  → forward card_mono goal=19 facts=[20,2]
    #[21] card (insert z A) <= card B
  → forward card_insert param_A=A param_a=z goal=19 facts=[5,18]
    #[22] card (insert z A) = Suc (card A)
  → rewrite source=prev target=fact goal=19 facts=[22,21]
    #[23] Suc (card A) <= card B
  → rewrite eq_sym_eq sym=false target=fact goal=19 facts=[3]
    #[24] card B = card A
  → rewrite source=prev target=fact goal=19 facts=[24,23]
    #[25] Suc (card A) <= card A
  → rewrite lesseq_Suc_less sym=false target=fact goal=19 facts=[25]
    #[26] card A < card A
  → forward less_irrefl param_n="card A" goal=19
    #[27] ~(card A < card A)
  ← rule negE_gen param_A="card A < card A" param_C="z Mem A" goal=19 facts=[27,26]
qed

-- The pigeonhole step behind `surjective_iff_injective`: for a finite
-- self-map of `s` that is surjective on `s`, two preimages of the same
-- point must coincide.  Stated with the element variables in `fixes`
-- (not as a lambda over them) so that the element-level equality
-- rewrites go through.
theorem surjective_imp_injective
  fixes s :: 'a set, f :: 'a => 'a, x :: 'a, y :: 'a
  prop finite s --> image f s Sub s --> (!z. z Mem s --> (?w. w Mem s & f w = z)) --> x Mem s --> y Mem s --> f x = f y --> x = y
proof
  ← intro goal=0
    #[1] finite s
    #[2] image f s Sub s
    #[3] !z. z Mem s --> (?w. w Mem s & f w = z)
    #[4] x Mem s
    #[5] y Mem s
    #[6] f x = f y
    #[7] x = y
  ← cases "x = y" goal=7
    #[8] x = y --> x = y
    #[9] ~(x = y) --> x = y
  ← intro goal=9
    #[10] ~(x = y)
    #[11] x = y
  → forward subset_delete param_A=s param_a=x goal=11
    #[12] delete s x Sub s
  → forward finite_subset param_A="delete s x" param_B=s goal=11 facts=[12,1]
    #[13] finite (delete s x)
  → forward not_mem_delete_self param_A=s param_x=x goal=11
    #[14] ~(x Mem delete s x)
  → forward insert_delete param_A=s param_a=x goal=11 facts=[4]
    #[15] insert x (delete s x) = s
  → forward card_insert param_A="delete s x" param_a=x goal=11 facts=[13,14]
    #[16] card (insert x (delete s x)) = Suc (card (delete s x))
  → rewrite eq_sym_eq sym=false target=fact goal=11 facts=[15]
    #[17] s = insert x (delete s x)
  → rewrite source=prev target=fact goal=11 facts=[15,16]
    #[18] card s = Suc (card (delete s x))
  → forward less_eq_refl param_n="card (delete s x)" goal=11
    #[19] card (delete s x) <= card (delete s x)
  → rewrite less_Suc_lesseq sym=true target=fact goal=11 facts=[19]
    #[20] card (delete s x) < Suc (card (delete s x))
  → rewrite eq_sym_eq sym=false target=fact goal=11 facts=[18]
    #[21] Suc (card (delete s x)) = card s
  → rewrite source=prev target=fact goal=11 facts=[21,20]
    #[22] card (delete s x) < card s
  → forward card_image_le param_X="delete s x" param_g=f goal=11 facts=[13]
    #[23] card (image f (delete s x)) <= card (delete s x)
  → rewrite eq_sym_eq sym=false target=fact goal=11 facts=[10]
    #[24] ~(y = x)
  cut "y Mem delete s x" goal=11
    #[25] y Mem delete s x
  ← rewrite member_delete sym=false goal=25
    #[26] y Mem s & ~(y = x)
  ← rule conjI goal=26
  cut "f x Mem image f (delete s x)" goal=11
    #[27] f x Mem image f (delete s x)
  ← rewrite in_image sym=false goal=27
    #[28] ?x1. x1 Mem delete s x & f x = f x1
  ← inst y goal=28
    #[29] y Mem delete s x & f x = f y
  → forward conjI goal=29 facts=[25,6]
  → forward insert_absorb goal=11 facts=[27]
    #[30] insert (f x) (image f (delete s x)) = image f (delete s x)
  → forward image_insert param_A="delete s x" param_a=x param_f=f goal=11
    #[31] image f (insert x (delete s x)) = insert (f x) (image f (delete s x))
  → rewrite source=prev target=fact goal=11 facts=[15,31]
    #[32] image f s = insert (f x) (image f (delete s x))
  → rewrite source=prev target=fact goal=11 facts=[30,32]
    #[33] image f s = image f (delete s x)
  cut "card (image f s) = card (image f (delete s x))" goal=11
    #[34] card (image f s) = card (image f (delete s x))
  ← rewrite source=prev goal=34 facts=[33]
  → rewrite eq_sym_eq sym=false target=fact goal=11 facts=[34]
    #[35] card (image f (delete s x)) = card (image f s)
  → rewrite source=prev target=fact goal=11 facts=[35,23]
    #[36] card (image f s) <= card (delete s x)
  → rewrite less_Suc_lesseq sym=true target=fact goal=11 facts=[36]
    #[37] card (image f s) < Suc (card (delete s x))
  → rewrite lesseq_Suc_less sym=true target=fact goal=11 facts=[37]
    #[38] Suc (card (image f s)) <= Suc (card (delete s x))
  → rewrite lesseq_Suc_less sym=true target=fact goal=11 facts=[22]
    #[39] Suc (card (delete s x)) <= card s
  → forward less_eq_trans goal=11 facts=[38,39]
    #[40] Suc (card (image f s)) <= card s
  → rewrite lesseq_Suc_less sym=false target=fact goal=11 facts=[40]
    #[41] card (image f s) < card s
  cut "s Sub image f s" goal=11
    #[42] s Sub image f s
  ← rewrite subset_def sym=false goal=42
    #[43] !x. x Mem s --> x Mem image f s
  ← intro z1 goal=43
    #[44] _VAR z1
    #[45] z1 Mem s
    #[46] z1 Mem image f s
  → forward goal=46 facts=[3,45]
    #[47] ?w. w Mem s & f w = z1
  elim w1 goal=46 facts=[47]
    #[48] _VAR w1
    #[49] w1 Mem s & f w1 = z1
    #[50] z1 Mem image f s
  → rewrite eq_sym_eq sym=false target=fact goal=50 facts=[49]
    #[51] w1 Mem s & z1 = f w1
  ← rewrite in_image sym=false goal=50
    #[52] ?x. x Mem s & z1 = f x
  ← inst w1 goal=52
  cut "image f s = s" goal=11
    #[53] image f s = s
  ← rewrite set_equal_iff sym=false goal=53
    #[54] !x. x Mem image f s <--> x Mem s
  ← intro z goal=54
    #[55] _VAR z
    #[56] z Mem image f s <--> z Mem s
  → forward subsetE param_A="image f s" param_B=s param_x=z goal=56 facts=[2]
    #[57] z Mem image f s --> z Mem s
  → forward subsetE param_A=s param_B="image f s" param_x=z goal=57 facts=[42]
    #[58] z Mem s --> z Mem image f s
  ← rule iffI goal=56
  → forward subsetE param_A="image f s" param_B=s param_x=z goal=57 facts=[2]
  → forward subsetE param_A=s param_B="image f s" param_x=z goal=58 facts=[42]
  cut "card (image f s) = card s" goal=11
    #[59] card (image f s) = card s
  ← rewrite source=prev goal=59 facts=[53]
  → rewrite eq_sym_eq sym=false target=fact goal=11 facts=[59]
    #[60] card s = card (image f s)
  → rewrite source=prev target=fact goal=11 facts=[60,41]
    #[61] card (image f s) < card (image f s)
  → forward less_irrefl param_n="card (image f s)" goal=11
    #[62] ~(card (image f s) < card (image f s))
  ← rule negE_gen param_A="card (image f s) < card (image f s)" param_C="x = y" goal=11 facts=[62,61]
qed

theorem surjective_iff_injective
  fixes s :: 'a set, f :: 'a => 'a
  prop finite s --> image f s Sub s --> (!y. y Mem s --> (?x. x Mem s & f x = y)) <--> (!x. !y. x Mem s --> y Mem s --> f x = f y --> x = y)
proof
  ← intro goal=0
    #[1] finite s
    #[2] image f s Sub s
    #[3] (!y. y Mem s --> (?x. x Mem s & f x = y)) <--> (!x. !y. x Mem s --> y Mem s --> f x = f y --> x = y)
  ← rule iffI goal=3
    #[4] (!y. y Mem s --> (?x. x Mem s & f x = y)) --> (!x. !y. x Mem s --> y Mem s --> f x = f y --> x = y)
    #[5] (!x. !y. x Mem s --> y Mem s --> f x = f y --> x = y) --> (!y. y Mem s --> (?x. x Mem s & f x = y))
  ← intro goal=4
    #[6] !y. y Mem s --> (?x. x Mem s & f x = y)
    #[7] !x. !y. x Mem s --> y Mem s --> f x = f y --> x = y
  ← intro x,y goal=7
    #[8] _VAR x
    #[9] _VAR y
    #[10] x Mem s
    #[11] y Mem s
    #[12] f x = f y
    #[13] x = y
  → forward surjective_imp_injective param_f=f param_s=s param_x=x param_y=y goal=13
    #[14] finite s --> image f s Sub s --> (!z. z Mem s --> (?w. w Mem s & f w = z)) --> x Mem s --> y Mem s --> f x = f y --> x = y
  ← apply_prev goal=13 facts=[14,1,2,6,10,11,12]
  ← intro goal=5
    #[15] !x. !y. x Mem s --> y Mem s --> f x = f y --> x = y
    #[16] !y. y Mem s --> (?x. x Mem s & f x = y)
  → forward card_image_inj param_f=f param_s=s goal=16 facts=[1,15]
    #[17] card (image f s) = card s
  → forward card_subset_eq param_A="image f s" param_B=s goal=16 facts=[2,1,17]
    #[18] image f s = s
  ← intro y goal=16
    #[19] ?x. x Mem s & f x = y
  → rewrite eq_sym_eq sym=false target=fact goal=19 facts=[18]
    #[20] s = image f s
  → rewrite source=prev target=fact goal=19 facts=[20,11]
    #[21] y Mem image f s
  → rewrite in_image sym=false target=fact goal=19 facts=[21]
    #[22] ?x. x Mem s & y = f x
  elim x0 goal=19 facts=[22]
    #[23] _VAR x0
    #[24] x0 Mem s & y = f x0
    #[25] ?x. x Mem s & f x = y
  → rewrite eq_sym_eq sym=false target=fact goal=25 facts=[24]
    #[26] x0 Mem s & f x0 = y
  ← inst x0 goal=25
qed

header "Monotone operators and least fixed point"

def bnd_mono :: ('a set ⇒ 'a set) ⇒ bool = bnd_mono h ⟷ (∀W. ∀X. W ⊆ X ⟶ h W ⊆ h X) [hint_rewrite]

def lfp :: ('a set ⇒ 'a set) ⇒ 'a set = lfp h = ⋂({X. h X ⊆ X}) [hint_rewrite]

theorem Union_union
  fixes A :: 'a set set, B :: 'a set set
  prop UN (A Un B) = UN A Un UN B
  [hint_rewrite]
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] ∀x. x ∈ ⋃(A ∪ B) ⟷ x ∈ ⋃A ∪ ⋃B
  ← rewrite member_union_iff sym=false goal=1
    #[2] ∀x. x ∈ ⋃(A ∪ B) ⟷ x ∈ ⋃A ∨ x ∈ ⋃B
  ← rewrite member_Union sym=false goal=2
    #[3] ∀x. (∃S. S ∈ A ∪ B ∧ x ∈ S) ⟷ (∃S. S ∈ A ∧ x ∈ S) ∨ (∃S. S ∈ B ∧ x ∈ S)
  ← rewrite member_union_iff sym=false goal=3
    #[4] ∀x. (∃S. (S ∈ A ∨ S ∈ B) ∧ x ∈ S) ⟷ (∃S. S ∈ A ∧ x ∈ S) ∨ (∃S. S ∈ B ∧ x ∈ S)
  ← rewrite exists_disj_conj_distrib sym=false goal=4
    #[5] ∀x. (∃S. S ∈ A ∧ x ∈ S) ∨ (∃S. S ∈ B ∧ x ∈ S) ⟷ (∃S. S ∈ A ∧ x ∈ S) ∨ (∃S. S ∈ B ∧ x ∈ S)
  ← intro x goal=5
    #[6] _VAR x
    #[7] (∃S. S ∈ A ∧ x ∈ S) ∨ (∃S. S ∈ B ∧ x ∈ S) ⟷ (∃S. S ∈ A ∧ x ∈ S) ∨ (∃S. S ∈ B ∧ x ∈ S)
  ← refl goal=7
qed

theorem cantor
  fixes f :: 'a => 'a set
  prop ?S. !x. ~(f x = S)
proof
  ← inst "{x. ¬(x ∈ f x)}" goal=0
    #[1] ∀x. ¬(f x = {x1. ¬(x1 ∈ f x1)})
  ← intro x goal=1
    #[2] _VAR x
    #[3] ¬(f x = {x1. ¬(x1 ∈ f x1)})
  ← rule negI goal=3
    #[4] f x = {x1. ¬(x1 ∈ f x1)} ⟶ false
  ← intro goal=4
    #[5] f x = {x1. ¬(x1 ∈ f x1)}
    #[6] false
  ← cases "x ∈ f x" goal=6
    #[7] x ∈ f x ⟶ false
    #[8] ¬(x ∈ f x) ⟶ false
  ← intro goal=7
    #[9] x ∈ f x
    #[10] false
  → rewrite target=fact source=prev goal=10 facts=[5,9]
    #[11] x ∈ {x1. ¬(x1 ∈ f x1)}
  → rewrite target=fact member_collect sym=false goal=10 facts=[11]
    #[12] ¬(x ∈ f x)
  ← rule negE goal=10 facts=[12,9]
  ← intro goal=8
    #[13] ¬(x ∈ f x)
    #[14] false
  → rewrite target=fact source=prev goal=14 facts=[5,13]
    #[15] ¬(x ∈ {x1. ¬(x1 ∈ f x1)})
  → rewrite target=fact member_collect sym=false goal=14 facts=[15]
    #[16] ¬¬(x ∈ f x)
  ← rule negE goal=14 facts=[16,13]
qed

theorem subset_antisym
  fixes A :: 'a set, B :: 'a set
  prop A Sub B --> B Sub A --> A = B
proof
  ← intro goal=0
    #[1] A ⊆ B
    #[2] B ⊆ A
    #[3] A = B
  ← rewrite set_equal_iff sym=false goal=3
    #[4] ∀x. x ∈ A ⟷ x ∈ B
  ← intro x goal=4
    #[5] _VAR x
    #[6] x ∈ A ⟷ x ∈ B
  ← rule iffI goal=6
    #[7] x ∈ A ⟶ x ∈ B
    #[8] x ∈ B ⟶ x ∈ A
  ← intro goal=7
    #[9] x ∈ A
    #[10] x ∈ B
  → forward subsetE goal=10 facts=[1,9]
    #[11] x ∈ B
  ← intro goal=8
    #[12] x ∈ B
    #[13] x ∈ A
  → forward subsetE goal=13 facts=[2,12]
    #[14] x ∈ A
qed

theorem lfp_lowerbound
  fixes h :: 'a set => 'a set, A :: 'a set
  prop h A Sub A --> lfp h Sub A
proof
  ← intro goal=0
  ← rewrite lfp_def sym=false goal=2
  ← rewrite subset_def sym=false goal=3
  ← intro x goal=4
  → rewrite target=fact member_Inter sym=false goal=7 facts=[6]
  → inst A goal=7 facts=[8]
  → rewrite target=fact member_collect sym=false goal=7 facts=[9]
  ← apply_prev goal=7 facts=[10,1]
qed

theorem lfp_greatest
  fixes h :: 'a set => 'a set, A :: 'a set
  prop (!X. h X Sub X --> A Sub X) --> A Sub lfp h
proof
  ← intro goal=0
  ← rewrite lfp_def sym=false goal=2
  ← rewrite subset_def sym=false goal=3
  ← intro x goal=4
  ← rewrite member_Inter sym=false goal=7
  ← intro S goal=8
  → rewrite target=fact member_collect sym=false goal=11 facts=[10]
  → inst S goal=11 facts=[1]
  → forward goal=11 facts=[13,12]
  ← rule subsetE goal=11 facts=[14,6]
qed

theorem lfp_fix_upper
  fixes h :: 'a set => 'a set
  prop bnd_mono h --> h (lfp h) Sub lfp h
proof
  ← intro goal=0
  ← rule lfp_greatest goal=2
  ← intro X goal=3
  → forward lfp_lowerbound param_h=h param_A=X goal=6 facts=[5]
  → rewrite target=fact bnd_mono_def sym=false goal=6 facts=[1]
  → inst "lfp h" goal=6 facts=[8]
  → inst X goal=6 facts=[9]
  → forward goal=6 facts=[10,7]
  ← rule subset_trans goal=6 facts=[11,5]
qed

theorem lfp_fix_lower
  fixes h :: 'a set => 'a set
  prop bnd_mono h --> lfp h Sub h (lfp h)
proof
  ← intro goal=0
  → forward lfp_fix_upper param_h=h goal=2 facts=[1]
  → rewrite target=fact bnd_mono_def sym=false goal=2 facts=[1]
  → inst "h (lfp h)" goal=2 facts=[4]
  → inst "lfp h" goal=2 facts=[5]
  → forward goal=2 facts=[6,3]
  ← rule lfp_lowerbound goal=2 facts=[7]
qed

theorem lfp_unfold
  fixes h :: 'a set => 'a set
  prop bnd_mono h --> h (lfp h) = lfp h
proof
  ← intro goal=0
    #[1] bnd_mono h
    #[2] h (lfp h) = lfp h
  ← rule subset_antisym goal=2
    #[3] h (lfp h) ⊆ lfp h
    #[4] lfp h ⊆ h (lfp h)
  ← rule lfp_fix_upper goal=3 facts=[1]
  ← rule lfp_fix_lower goal=4 facts=[1]
qed

