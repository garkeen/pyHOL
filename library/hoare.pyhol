theory hoare
imports function, int
description "Hoare logic"

header "Programs"

datatype com 'a =
  | Basic (f :: ('a ⇒ 'a)) :: 'a com
  | Seq (c1 :: 'a com) (c2 :: 'a com) :: 'a com
  | Cond (b :: ('a ⇒ bool)) (c1 :: 'a com) (c2 :: 'a com) :: 'a com
  | While (b :: ('a ⇒ bool)) (I :: ('a ⇒ bool)) (c :: 'a com) :: 'a com

inductive Sem :: 'a com ⇒ 'a ⇒ 'a ⇒ bool
  | Sem_basic: Sem (Basic f) s (f s)
  | Sem_seq: Sem c1 s s3 ⟶ Sem c2 s3 s2 ⟶ Sem (Seq c1 c2) s s2
  | Sem_if1: b s ⟶ Sem c1 s s2 ⟶ Sem (Cond b c1 c2) s s2
  | Sem_if2: ¬(b s) ⟶ Sem c2 s s2 ⟶ Sem (Cond b c1 c2) s s2
  | Sem_while_skip: ¬(b s) ⟶ Sem (While b I c) s s
  | Sem_while_loop: b s ⟶ Sem c s s3 ⟶ Sem (While b I c) s3 s2 ⟶ Sem (While b I c) s s2

theorem Sem_Seq_elim
  fixes c1 :: 'a com, c2 :: 'a com, s :: 'a, s2 :: 'a
  prop Sem (Seq c1 c2) s s2 ⟶ (∃s3. Sem c1 s s3 ∧ Sem c2 s3 s2)
  [hint_forward]
  proof
    1: apply_backward_step Sem_cases @0
    1: introduction f,s1
    1.5: rewrite_fact eq_sym_eq @1.2 sym=false
    1.6: apply_resolve_step com_Basic_Seq_neq @1.5
    2: introduction c11,s1,s3,c21,s21
    2.10: apply_forward_step com_Seq_inject @2.5
    2.11: apply_forward_step conjD1 @2.10
    2.12: rewrite_fact eq_sym_eq @2.11 sym=false
    2.13: rewrite_fact_with_prev @2.12,2.8
    2.14: apply_forward_step conjD2 @2.10
    2.15: rewrite_fact eq_sym_eq @2.14 sym=false
    2.16: rewrite_fact_with_prev @2.15,2.9
    2.17: rewrite_fact eq_sym_eq @2.6 sym=false
    2.18: rewrite_fact_with_prev @2.17,2.13
    2.19: rewrite_fact eq_sym_eq @2.7 sym=false
    2.20: rewrite_fact_with_prev @2.19,2.16
    2.21: inst_exists_goal s3
    2.21: apply_backward_step conjI
    2.21: apply_prev @2.18
    2.22: apply_prev @2.20
    3: introduction b,s1,c11,s21,c21
    3.10: apply_resolve_step com_Seq_Cond_neq @3.5
    4: introduction b,s1,c21,s21,c11
    4.10: apply_resolve_step com_Seq_Cond_neq @4.5
    5: introduction b,s1,I,c
    5.8: apply_resolve_step com_Seq_While_neq @5.4
    6: introduction b,s1,c,s3,I,s21
    6.12: apply_resolve_step com_Seq_While_neq @6.6
  qed

def Skip :: 'a com = Skip = Basic (λf::'a. f)

theorem Sem_Skip
  fixes s :: 'a
  prop Sem Skip s s
  proof
    0: rewrite_goal Skip_def sym=""
    0: apply_backward_step Sem_basic
  qed

def Assign :: 'a ⇒ (('a ⇒ 'b) ⇒ 'b) ⇒ ('a ⇒ 'b) com = Assign a b = Basic (λf. (f)(a := b f))

theorem Sem_Assign
  fixes a :: 'a, b :: ('a ⇒ 'b) ⇒ 'b, s :: 'a ⇒ 'b
  prop Sem (Assign a b) s ((s)(a := b s))
  proof
    0: rewrite_goal Assign_def sym=""
    0: apply_backward_step Sem_basic
  qed

theorem Sem_Assign_elim
  fixes a :: 'a, b :: ('a ⇒ 'b) ⇒ 'b, s :: 'a ⇒ 'b, s2 :: 'a ⇒ 'b
  prop Sem (Assign a b) s s2 ⟶ s2 = (s)(a := b s)
  [hint_forward]
  proof
    1: apply_backward_step Sem_cases @0
    1: introduction f,s1
    1.5: rewrite_fact Assign_def @1.2 sym=false
    1.6: apply_forward_step com_Basic_inject @1.5
    1.7: rewrite_goal_with_prev @1.4
    1.7: rewrite_goal_with_prev @1.3
    1.7: rewrite_fact eq_sym_eq @1.6 sym=false
    1.8: rewrite_goal_with_prev @1.7
    2: introduction c1,s1,s3,c2,s21
    2.10: rewrite_fact Assign_def @2.5 sym=false
    2.11: apply_resolve_step com_Basic_Seq_neq @2.10
    3: introduction b1,s1,c1,s21,c2
    3.10: rewrite_fact Assign_def @3.5 sym=false
    3.11: apply_resolve_step com_Basic_Cond_neq @3.10
    4: introduction b1,s1,c2,s21,c1
    4.10: rewrite_fact Assign_def @4.5 sym=false
    4.11: apply_resolve_step com_Basic_Cond_neq @4.10
    5: introduction b1,s1,I1,c1
    5.8: rewrite_fact Assign_def @5.4 sym=false
    5.9: apply_resolve_step com_Basic_While_neq @5.8
    6: introduction b1,s1,c1,s3,I1,s21
    6.12: rewrite_fact Assign_def @6.6 sym=false
    6.13: apply_resolve_step com_Basic_While_neq @6.12
  qed

def P1 :: (nat ⇒ nat) com = P1 = Seq (Assign 0 (λs. 1)) (Assign 1 (λs. 2))

theorem P1_test
  prop Sem P1 (λx. 0) ((λx. 0)(0 := 1, 1 := 2))
  proof
    0: rewrite_goal P1_def sym=""
    0: apply_backward_step Sem_seq param_s3="((λx. 0)((0::nat) := (1::nat)))"
    0: apply_backward_step Sem_Assign
    1: apply_backward_step Sem_Assign
  qed

def P2 :: (nat ⇒ nat) com = P2 = Seq (Assign 0 (λs. s 0 + 1)) (Assign 0 (λs. s 0 + 1))

theorem P2_test
  prop Sem P2 (λx. 0) ((λx. 0)(0 := 2))
  proof
    0: rewrite_goal P2_def sym=""
    0: eval_Sem
  qed

def P3 :: (nat ⇒ nat) com = P3 = While (λs. ¬(s 0 = 3)) (λs. true) (Assign 0 (λs. s 0 + 1))

theorem P3_test
  prop Sem P3 (λx. 0) ((λx. 0)(0 := 3))
  proof
    0: rewrite_goal P3_def sym=""
    0: eval_Sem
  qed

def Entail :: ('a ⇒ bool) ⇒ ('a ⇒ bool) ⇒ bool = Entail P Q ⟷ (∀s. P s ⟶ Q s) [hint_rewrite]

def Valid :: ('a ⇒ bool) ⇒ 'a com ⇒ ('a ⇒ bool) ⇒ bool = Valid P c Q ⟷ (∀s. ∀s2. P s ⟶ Sem c s s2 ⟶ Q s2) [hint_rewrite]

theorem pre_rule
  fixes P :: 'a ⇒ bool, Q :: 'a ⇒ bool, R :: 'a ⇒ bool, c :: 'a com
  prop Entail P Q ⟶ Valid Q c R ⟶ Valid P c R
  proof
    2: rewrite_goal Valid_def
    2: introduction "s, s2"
    2.4: rewrite_fact Entail_def @0
    2.5: rewrite_fact Valid_def @1
    2.6: apply_fact @2.4,2.2
    2.7: apply_prev @2.5,2.6
  qed

theorem skip_rule
  fixes P :: 'a ⇒ bool
  prop Valid P Skip P
  proof
    0: rewrite_goal Valid_def
    0: introduction s,s2
    0.4: rewrite_fact Skip_def @0.3 sym=false
    0.5: apply_backward_step Sem_cases @0.4
    0.5: introduction f,s1
    0.5.5: apply_forward_step com_Basic_inject @0.5.2
    0.5.6: rewrite_fact eq_sym_eq @0.5.5 sym=false
    0.5.7: rewrite_fact_with_prev @0.5.6,0.5.4
    0.5.8: rewrite_fact eq_sym_eq @0.5.3 sym=false
    0.5.9: rewrite_fact_with_prev @0.5.8,0.5.7
    0.5.10: rewrite_goal_with_prev @0.5.9
    0.5.11: apply_prev @0.3
    0.6: introduction c11,s1,s3,c21,s21
    0.6.10: apply_resolve_step com_Basic_Seq_neq @0.6.5
    0.7: introduction b,s1,c11,s21,c21
    0.7.10: apply_resolve_step com_Basic_Cond_neq @0.7.5
    0.8: introduction b,s1,c21,s21,c11
    0.8.10: apply_resolve_step com_Basic_Cond_neq @0.8.5
    0.9: introduction b,s1,I,c
    0.9.8: apply_resolve_step com_Basic_While_neq @0.9.4
    0.10: introduction b,s1,c,s3,I,s21
    0.10.12: apply_resolve_step com_Basic_While_neq @0.10.6
  qed

theorem assign_rule
  fixes P :: ('a ⇒ 'b) ⇒ bool, a :: 'a, b :: ('a ⇒ 'b) ⇒ 'b
  prop Valid (λs. P ((s)(a := b s))) (Assign a b) P
  proof
    0: rewrite_goal Valid_def
    0: introduction "s, s2"
    0.4: apply_forward_step Sem_Assign_elim @0.3
    0.5: rewrite_goal_with_prev @0.4
  qed

theorem seq_rule
  fixes P :: 'a ⇒ bool, Q :: 'a ⇒ bool, R :: 'a ⇒ bool, c1 :: 'a com, c2 :: 'a com
  prop Valid P c1 Q ⟶ Valid Q c2 R ⟶ Valid P (Seq c1 c2) R
  proof
    2: rewrite_goal Valid_def
    2: introduction s,s2
    2.4: apply_forward_step Sem_Seq_elim @2.3
    2.5: apply_backward_step exE @2.4
    2.5: introduction s3
    2.5.2: apply_forward_step conjD1 @2.5.1
    2.5.3: apply_forward_step conjD2 @2.5.1
    2.5.4: rewrite_fact Valid_def @0
    2.5.5: rewrite_fact Valid_def @1
    2.5.6: apply_fact @2.5.4,2.2,2.5.2
    2.5.7: apply_prev @2.5.5,2.5.6,2.5.3
  qed

theorem if_rule
  fixes P :: 'a ⇒ bool, Q :: 'a ⇒ bool, R :: 'a ⇒ bool, b :: 'a ⇒ bool, c1 :: 'a com, c2 :: 'a com
  prop Valid P c1 R ⟶ Valid Q c2 R ⟶ Valid (λs. if b s then P s else Q s) (Cond b c1 c2) R
  proof
    2: rewrite_goal Valid_def
    2: introduction s,s2
    2.4: apply_backward_step Sem_cases @2.3
    2.4: introduction f,s1
    2.4.5: rewrite_fact eq_sym_eq @2.4.2 sym=false
    2.4.6: apply_resolve_step com_Basic_Cond_neq @2.4.5
    2.5: introduction c11,s1,s3,c21,s21
    2.5.10: rewrite_fact eq_sym_eq @2.5.5 sym=false
    2.5.11: apply_resolve_step com_Seq_Cond_neq @2.5.10
    2.6: introduction b1,s1,c11,s21,c21
    2.6.10: apply_forward_step com_Cond_inject @2.6.5
    2.6.11: apply_forward_step conjD1 @2.6.10
    2.6.12: apply_forward_step conjD2 @2.6.10
    2.6.13: apply_forward_step conjD1 @2.6.12
    2.6.14: apply_forward_step conjD2 @2.6.12
    2.6.15: rewrite_fact eq_sym_eq @2.6.11 sym=false
    2.6.16: rewrite_fact eq_sym_eq @2.6.6 sym=false
    2.6.17: rewrite_fact eq_sym_eq @2.6.13 sym=false
    2.6.18: rewrite_fact eq_sym_eq @2.6.7 sym=false
    2.6.19: rewrite_fact eq_sym_eq @2.6.14 sym=false
    2.6.20: rewrite_fact_with_prev @2.6.17,2.6.9
    2.6.21: rewrite_fact_with_prev @2.6.16,2.6.20
    2.6.22: rewrite_fact_with_prev @2.6.18,2.6.21
    2.6.23: rewrite_fact_with_prev @2.6.15,2.6.8
    2.6.24: rewrite_fact_with_prev @2.6.16,2.6.23
    2.6.25: rewrite_fact if_P @2.2,2.6.24 sym=false
    2.6.26: rewrite_fact Valid_def @0
    2.6.27: apply_prev @2.6.26,2.6.25,2.6.22
    2.7: introduction b1,s1,c21,s21,c11
    2.7.10: apply_forward_step com_Cond_inject @2.7.5
    2.7.11: apply_forward_step conjD1 @2.7.10
    2.7.12: apply_forward_step conjD2 @2.7.10
    2.7.13: apply_forward_step conjD1 @2.7.12
    2.7.14: apply_forward_step conjD2 @2.7.12
    2.7.15: rewrite_fact eq_sym_eq @2.7.11 sym=false
    2.7.16: rewrite_fact eq_sym_eq @2.7.6 sym=false
    2.7.17: rewrite_fact eq_sym_eq @2.7.13 sym=false
    2.7.18: rewrite_fact eq_sym_eq @2.7.7 sym=false
    2.7.19: rewrite_fact eq_sym_eq @2.7.14 sym=false
    2.7.20: rewrite_fact_with_prev @2.7.19,2.7.9
    2.7.21: rewrite_fact_with_prev @2.7.16,2.7.20
    2.7.22: rewrite_fact_with_prev @2.7.18,2.7.21
    2.7.23: rewrite_fact_with_prev @2.7.15,2.7.8
    2.7.24: rewrite_fact_with_prev @2.7.16,2.7.23
    2.7.25: rewrite_fact if_not_P @2.2,2.7.24 sym=false
    2.7.26: rewrite_fact Valid_def @1
    2.7.27: apply_prev @2.7.26,2.7.25,2.7.22
    2.8: introduction b1,s1,I,c
    2.8.8: apply_resolve_step com_Cond_While_neq @2.8.4
    2.9: introduction b1,s1,c,s3,I,s21
    2.9.12: apply_resolve_step com_Cond_While_neq @2.9.6
  qed

theorem While_eq_refl
  fixes I :: 'a ⇒ bool, b :: 'a ⇒ bool, c :: 'a com
  prop While b I c = While b I c
  proof
    0: reflexive
  qed

theorem Sem_while_inv
  fixes I :: 'a ⇒ bool, Q :: 'a ⇒ bool, b :: 'a ⇒ bool, c :: 'a com
  prop Entail (λs. I s ∧ ¬(b s)) Q ⟶ Valid (λs. I s ∧ b s) c I ⟶ (∀d. ∀x. ∀y. Sem d x y ⟶ d = While b I c ⟶ I x ⟶ Q y)
  proof
    2: apply_backward_step Sem_induct
    2: introduction f,s
    2.4: apply_resolve_step com_Basic_While_neq @2.2
    3: introduction c1,s,s3,c2,s2
    3.11: apply_resolve_step com_Seq_While_neq @3.9
    4: introduction b1,s,c1,s2,c2
    4.10: apply_resolve_step com_Cond_While_neq @4.8
    5: introduction b1,s,c2,s2,c1
    5.10: apply_resolve_step com_Cond_While_neq @5.8
    6: introduction b1,s,I1,c1
    6.7: apply_forward_step com_While_inject @6.5
    6.8: apply_forward_step conjD1 @6.7
    6.9: rewrite_fact_with_prev @6.8,6.4
    6.10: apply_forward_step conjI @6.6,6.9
    6.11: rewrite_fact Entail_def @0
    6.12: apply_fact @6.11,6.10
    6.13: apply_prev @6.12
    7: introduction b1,s,c1,s3,I1,s2
    7.13: apply_forward_step com_While_inject @7.11
    7.14: apply_forward_step conjD1 @7.13
    7.15: apply_forward_step conjD2 @7.13
    7.16: apply_forward_step conjD1 @7.15
    7.17: apply_forward_step conjD2 @7.15
    7.18: rewrite_fact_with_prev @7.17,7.7
    7.19: rewrite_fact_with_prev @7.14,7.6
    7.20: apply_forward_step conjI @7.12,7.19
    7.21: rewrite_fact Valid_def @1
    7.22: apply_fact @7.21,7.20,7.18
    7.23: apply_fact @7.10,7.11,7.22
    7.24: apply_prev @7.23
  qed

theorem while_rule
  fixes I :: 'a ⇒ bool, Q :: 'a ⇒ bool, b :: 'a ⇒ bool, c :: 'a com
  prop Entail (λs. I s ∧ ¬(b s)) Q ⟶ Valid (λs. I s ∧ b s) c I ⟶ Valid I (While b I c) Q
  proof
    2: rewrite_goal Valid_def
    2: introduction "s, s2"
    2.4: apply_forward_step Sem_while_inv @0,1
    2.5: forall_elim "While b I c" @2.4
    2.6: forall_elim s @2.5
    2.7: forall_elim s2 @2.6
    2.8: apply_fact @2.7,2.3
    2.9: apply_forward_step While_eq_refl param_b=b param_I=I param_c=c
    2.10: apply_prev @2.8,2.9,2.2
  qed

theorem abs_test
  fixes a :: int
  prop true ⟶ (if 0 ≤ a then a = abs a else -a = abs a)
  proof
    1: rewrite_goal abs_def
    1: z3
  qed

theorem max_test
  fixes m :: int, n :: int
  prop true ⟶ (if m ≤ n then n = max m n else m = max m n)
  proof
    1: rewrite_goal max_def
    1: z3
  qed
