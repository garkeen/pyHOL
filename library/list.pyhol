theory list
imports set
description "Lists"

header "Basic definitions"

datatype list 'a =
  | nil :: 'a list
  | cons (x :: 'a) (xs :: 'a list) :: 'a list

fun length :: 'a list ⇒ nat
  | length ([]::'a list) = 0
  | length (x # xs) = Suc (length xs)

fun hd :: 'a list ⇒ 'a
  | hd (x # xs) = x

fun tl :: 'a list ⇒ 'a list
  | tl (x # xs) = xs

fun nth :: 'a list ⇒ nat ⇒ 'a
  | nth l 0 = hd l
  | nth l (Suc n) = nth (tl l) n

fun append :: 'a list ⇒ 'a list ⇒ 'a list
  | [] @ xs = xs
  | (x # xs) @ ys = x # xs @ ys

fun rev :: 'a list ⇒ 'a list
  | rev ([]::'a list) = []
  | rev (x # xs) = rev xs @ [x]

theorem nth_cons_zero
  fixes x :: 'a, xs :: 'a list
  prop nth (x # xs) 0 = x
  [hint_rewrite]
proof
  ← rewrite nth_def_1 goal=0
  ← rewrite hd_def_1 goal=1
qed

theorem nth_cons_suc
  fixes x :: 'a, xs :: 'a list, n :: nat
  prop nth (x # xs) (Suc n) = nth xs n
  [hint_rewrite]
proof
  ← rewrite nth_def_2 goal=0
  ← rewrite tl_def_1 goal=1
qed

theorem append_right_neutral
  fixes xs :: 'a list
  prop xs @ [] = xs
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] ([]::'a list) @ [] = []
    #[2] ∀x::'a. ∀xs. xs @ [] = xs ⟶ (x # xs) @ [] = x # xs
  ← rewrite append_def_1 goal=1
  ← intro x,xs goal=2
    #[3] _VAR x
    #[4] _VAR xs
    #[5] xs @ [] = xs
    #[6] (x # xs) @ [] = x # xs
  ← rewrite append_def_2 goal=6
    #[7] x # xs @ [] = x # xs
  ← rewrite source=prev goal=7 facts=[5]
qed

theorem append_assoc
  fixes x :: 'a, xs :: 'a list, ys :: 'a list, zs :: 'a list
  prop (xs @ ys) @ zs = xs @ ys @ zs
proof
  ← induct xs list_induct goal=0
    #[1] ([] @ ys) @ zs = [] @ ys @ zs
    #[2] ∀x. ∀xs. (xs @ ys) @ zs = xs @ ys @ zs ⟶ ((x # xs) @ ys) @ zs = (x # xs) @ ys @ zs
  ← rewrite append_def_1 goal=1
  ← intro x,xs goal=2
    #[3] _VAR x
    #[4] _VAR xs
    #[5] (xs @ ys) @ zs = xs @ ys @ zs
    #[6] ((x # xs) @ ys) @ zs = (x # xs) @ ys @ zs
  ← rewrite append_def_2 goal=6
    #[7] (x # xs @ ys) @ zs = x # xs @ ys @ zs
  ← rewrite append_def_2 goal=7
    #[8] x # (xs @ ys) @ zs = x # xs @ ys @ zs
  ← rewrite source=prev goal=8 facts=[5]
qed

theorem length_append
  fixes xs :: 'a list, ys :: 'a list
  prop length (xs @ ys) = length xs + length ys
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] length ([] @ ys) = length ([]::'a list) + length ys
    #[2] ∀x. ∀xs. length (xs @ ys) = length xs + length ys ⟶ length ((x # xs) @ ys) = length (x # xs) + length ys
  ← rewrite append_def_1 goal=1
    #[3] length ys = length ([]::'a list) + length ys
  ← rewrite length_def_1 goal=3
    #[4] length ys = 0 + length ys
  ← rewrite nat_plus_def_1 goal=4
  ← intro x,xs goal=2
    #[5] _VAR x
    #[6] _VAR xs
    #[7] length (xs @ ys) = length xs + length ys
    #[8] length ((x # xs) @ ys) = length (x # xs) + length ys
  ← rewrite append_def_2 goal=8
    #[9] length (x # xs @ ys) = length (x # xs) + length ys
  ← rewrite length_def_2 goal=9
    #[10] Suc (length (xs @ ys)) = Suc (length xs) + length ys
  ← rewrite source=prev goal=10 facts=[7]
    #[11] Suc (length xs + length ys) = Suc (length xs) + length ys
  ← rewrite nat_plus_def_2 goal=11
    #[12] Suc (length xs + length ys) = Suc (length xs) + length ys
qed

theorem rev_append
  fixes xs :: 'a list, ys :: 'a list
  prop rev (xs @ ys) = rev ys @ rev xs
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] rev ([] @ ys) = rev ys @ rev []
    #[2] ∀x. ∀xs. rev (xs @ ys) = rev ys @ rev xs ⟶ rev ((x # xs) @ ys) = rev ys @ rev (x # xs)
  ← rewrite append_def_1 goal=1
    #[3] rev ys = rev ys @ rev []
  ← rewrite rev_def_1 goal=3
    #[4] rev ys = rev ys @ []
  ← rewrite append_right_neutral goal=4
  ← intro x,xs goal=2
    #[5] _VAR x
    #[6] _VAR xs
    #[7] rev (xs @ ys) = rev ys @ rev xs
    #[8] rev ((x # xs) @ ys) = rev ys @ rev (x # xs)
  ← rewrite append_def_2 goal=8
    #[9] rev (x # xs @ ys) = rev ys @ rev (x # xs)
  ← rewrite rev_def_2 goal=9
    #[10] rev (xs @ ys) @ [x] = rev ys @ rev xs @ [x]
  ← rewrite source=prev goal=10 facts=[7]
    #[11] (rev ys @ rev xs) @ [x] = rev ys @ rev xs @ [x]
  ← rewrite append_assoc goal=11
    #[12] (rev ys @ rev xs) @ [x] = rev ys @ rev xs @ [x]
qed

theorem rev_rev
  fixes xs :: 'a list
  prop rev (rev xs) = xs
proof
  ← induct xs list_induct goal=0
    #[1] rev (rev ([]::'a list)) = []
    #[2] ∀x::'a. ∀xs. rev (rev xs) = xs ⟶ rev (rev (x # xs)) = x # xs
  ← rewrite rev_def_1 goal=1
    #[3] rev ([]::'a list) = []
  ← rewrite rev_def_1 goal=3
  ← intro x,xs goal=2
    #[4] _VAR x
    #[5] _VAR xs
    #[6] rev (rev xs) = xs
    #[7] rev (rev (x # xs)) = x # xs
  ← rewrite rev_def_2 goal=7
    #[8] rev (rev xs @ [x]) = x # xs
  ← rewrite rev_append goal=8
    #[9] rev [x] @ rev (rev xs) = x # xs
  ← rewrite rev_def_2 goal=9
    #[10] (rev [] @ [x]) @ rev (rev xs) = x # xs
  ← rewrite rev_def_1 goal=10
    #[11] ([] @ [x]) @ rev (rev xs) = x # xs
  ← rewrite append_def_1 goal=11
    #[12] [x] @ rev (rev xs) = x # xs
  ← rewrite append_def_2 goal=12
    #[13] x # [] @ rev (rev xs) = x # xs
  ← rewrite append_def_1 goal=13
    #[14] x # rev (rev xs) = x # xs
  ← rewrite source=prev goal=14 facts=[6]
qed

theorem rev_length
  fixes xs :: 'a list
  prop length (rev xs) = length xs
proof
  ← induct xs list_induct goal=0
    #[1] length (rev ([]::'a list)) = length ([]::'a list)
    #[2] ∀x::'a. ∀xs. length (rev xs) = length xs ⟶ length (rev (x # xs)) = length (x # xs)
  ← rewrite rev_def_1 goal=1
  ← intro x,xs goal=2
    #[3] _VAR x
    #[4] _VAR xs
    #[5] length (rev xs) = length xs
    #[6] length (rev (x # xs)) = length (x # xs)
  ← rewrite length_def_2 goal=6
    #[7] length (rev (x # xs)) = Suc (length xs)
  ← rewrite rev_def_2 goal=7
    #[8] length (rev xs @ [x]) = Suc (length xs)
  ← rewrite length_append goal=8
    #[9] length (rev xs) + length [x] = Suc (length xs)
  ← rewrite length_def_2 goal=9
    #[10] length (rev xs) + Suc (length ([]::'a list)) = Suc (length xs)
  ← rewrite length_def_1 goal=10
    #[11] length (rev xs) + Suc 0 = Suc (length xs)
  ← rewrite source=prev goal=11 facts=[5]
    #[12] length xs + Suc 0 = Suc (length xs)
  nat_norm goal=12
    #[13] length xs + Suc 0 = Suc (length xs)
qed

fun set :: 'a list ⇒ 'a set
  | set ([]::'a list) = ∅
  | set (x # xs) = insert x (set xs)

fun distinct :: 'a list ⇒ bool
  | distinct ([]::'a list) ⟷ true
  | distinct (x # xs) ⟷ ¬(x ∈ set xs) ∧ distinct xs

theorem not_member_nil
  fixes x :: 'a
  prop ~(x Mem set []) <--> true
proof
  ← rewrite set_def_1 sym=false goal=0
    #[1] ¬(x ∈ ∅) ⟷ true
  ← rewrite member_empty_simp sym=false goal=1
    #[2] ¬false ⟷ true
  ← rule iffI goal=2
    #[3] ¬false ⟶ true
    #[4] true ⟶ ¬false
  ← intro goal=3
    #[5] ¬false
    #[6] true
  ← rule trueI goal=6
    #[7] true
  ← intro goal=4
    #[8] true
    #[9] ¬false
  ← rule negI goal=9
    #[10] false ⟶ false
qed

theorem not_member_cons
  fixes x :: 'a, y :: 'a, ys :: 'a list
  prop ~(x Mem set (y # ys)) <--> ~(x = y) & ~(x Mem set ys)
proof
  ← rule iffI goal=0
    #[1] ¬(x ∈ set (y # ys)) ⟶ ¬(x = y) ∧ ¬(x ∈ set ys)
    #[2] ¬(x = y) ∧ ¬(x ∈ set ys) ⟶ ¬(x ∈ set (y # ys))
  ← intro goal=1
    #[3] ¬(x ∈ set (y # ys))
    #[4] ¬(x = y) ∧ ¬(x ∈ set ys)
  → rewrite target=fact set_def_2 sym=false goal=4 facts=[3]
    #[5] ¬(x ∈ insert y (set ys))
  → rewrite target=fact member_insert sym=false goal=4 facts=[5]
    #[6] ¬(x = y ∨ x ∈ set ys)
  → rewrite target=fact de_morgan_thm2 sym=false goal=4 facts=[6]
  ← intro goal=2
    #[7] ¬(x = y) ∧ ¬(x ∈ set ys)
    #[8] ¬(x ∈ set (y # ys))
  ← rewrite set_def_2 sym=false goal=8
    #[9] ¬(x ∈ insert y (set ys))
  ← rewrite member_insert sym=false goal=9
    #[10] ¬(x = y ∨ x ∈ set ys)
  ← rewrite de_morgan_thm2 sym=false goal=10
qed

