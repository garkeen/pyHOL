theory list
imports set, prod
description "Lists"

header "Basic definitions"

datatype list 'a =
  | nil :: 'a list
  | cons (x :: 'a) (xs :: 'a list) :: 'a list

-- The well-founded relation `fun` definitions recurse with: the tail of
-- a cons.  Proved straight from the datatype own induction principle, so
-- the definitions below can already use it (the size function `length`
-- is itself one of them, and cannot be used before it exists).
theorem list_wf_subterm
  prop wf (%xs::'a list. %ys::'a list. ?z::'a. ys = z # xs)
proof
  ← rewrite wf_def goal=0
  ← intro P goal=1
  ← intro a goal=4
  ← induct a list_induct goal=6
  ← inst "([]::'a list)" goal=7 facts=[3]
  cut "!y::'a list. (?z::'a. ([]::'a list) = z # y) --> P y" goal=7
    ← intro y goal=10
    elim z goal=13 facts=[12]
    → forward list_nil_cons_neq param_x=z param_xs=y goal=16
    ← rule negE_gen goal=16 facts=[17,15]
  ← apply_prev goal=7 facts=[9,10]
  ← intro "x, xs" goal=8
  → inst "(x # xs)" goal=22 facts=[3]
  cut "!y::'a list. (?z::'a. x # xs = z # y) --> P y" goal=22
    ← intro y goal=24
    elim z goal=26 facts=[25]
    → forward list_cons_inject param_x=x param_x1=z param_xs=xs param_xs1=y goal=28 facts=[27]
    → forward conjD2 goal=28 facts=[29]
    → rewrite target=fact goal=28 facts=[30,21]
  ← apply_prev goal=22 facts=[23,24]
qed

fun length :: 'a list ⇒ nat
  | length ([]::'a list) = 0
  | length (x # xs) = Suc (length xs)

fun hd :: 'a list ⇒ 'a
  | hd (x # xs) = x

fun tl :: 'a list ⇒ 'a list
  | tl (x # xs) = xs

fun nth :: 'a list ⇒ nat ⇒ 'a
  | nth l 0 = hd l
  | nth l (Suc n) = nth (tl l) n

fun append :: 'a list ⇒ 'a list ⇒ 'a list
  | [] @ xs = xs
  | (x # xs) @ ys = x # xs @ ys

fun rev :: 'a list ⇒ 'a list
  | rev ([]::'a list) = []
  | rev (x # xs) = rev xs @ [x]

theorem nth_cons_zero
  fixes x :: 'a, xs :: 'a list
  prop nth (x # xs) 0 = x
  [hint_rewrite]
proof
  ← rewrite nth_def_1 goal=0
  ← rewrite hd_def_1 goal=1
qed

theorem nth_cons_suc
  fixes x :: 'a, xs :: 'a list, n :: nat
  prop nth (x # xs) (Suc n) = nth xs n
  [hint_rewrite]
proof
  ← rewrite nth_def_2 goal=0
  ← rewrite tl_def_1 goal=1
qed

theorem append_right_neutral
  fixes xs :: 'a list
  prop xs @ [] = xs
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] ([]::'a list) @ [] = []
    #[2] ∀x::'a. ∀xs. xs @ [] = xs ⟶ (x # xs) @ [] = x # xs
  ← rewrite append_def_1 goal=1
  ← intro x,xs goal=2
    #[3] _VAR x
    #[4] _VAR xs
    #[5] xs @ [] = xs
    #[6] (x # xs) @ [] = x # xs
  ← rewrite append_def_2 goal=6
    #[7] x # xs @ [] = x # xs
  ← rewrite source=prev goal=7 facts=[5]
qed

theorem append_assoc
  fixes x :: 'a, xs :: 'a list, ys :: 'a list, zs :: 'a list
  prop (xs @ ys) @ zs = xs @ ys @ zs
proof
  ← induct xs list_induct goal=0
    #[1] ([] @ ys) @ zs = [] @ ys @ zs
    #[2] ∀x. ∀xs. (xs @ ys) @ zs = xs @ ys @ zs ⟶ ((x # xs) @ ys) @ zs = (x # xs) @ ys @ zs
  ← rewrite append_def_1 goal=1
  ← intro x,xs goal=2
    #[3] _VAR x
    #[4] _VAR xs
    #[5] (xs @ ys) @ zs = xs @ ys @ zs
    #[6] ((x # xs) @ ys) @ zs = (x # xs) @ ys @ zs
  ← rewrite append_def_2 goal=6
    #[7] (x # xs @ ys) @ zs = x # xs @ ys @ zs
  ← rewrite append_def_2 goal=7
    #[8] x # (xs @ ys) @ zs = x # xs @ ys @ zs
  ← rewrite source=prev goal=8 facts=[5]
qed

theorem length_append
  fixes xs :: 'a list, ys :: 'a list
  prop length (xs @ ys) = length xs + length ys
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] length ([] @ ys) = length ([]::'a list) + length ys
    #[2] ∀x. ∀xs. length (xs @ ys) = length xs + length ys ⟶ length ((x # xs) @ ys) = length (x # xs) + length ys
  ← rewrite append_def_1 goal=1
    #[3] length ys = length ([]::'a list) + length ys
  ← rewrite length_def_1 goal=3
    #[4] length ys = 0 + length ys
  ← rewrite nat_plus_def_1 goal=4
  ← intro x,xs goal=2
    #[5] _VAR x
    #[6] _VAR xs
    #[7] length (xs @ ys) = length xs + length ys
    #[8] length ((x # xs) @ ys) = length (x # xs) + length ys
  ← rewrite append_def_2 goal=8
    #[9] length (x # xs @ ys) = length (x # xs) + length ys
  ← rewrite length_def_2 goal=9
    #[10] Suc (length (xs @ ys)) = Suc (length xs) + length ys
  ← rewrite source=prev goal=10 facts=[7]
    #[11] Suc (length xs + length ys) = Suc (length xs) + length ys
  ← rewrite nat_plus_def_2 goal=11
    #[12] Suc (length xs + length ys) = Suc (length xs) + length ys
qed

theorem rev_append
  fixes xs :: 'a list, ys :: 'a list
  prop rev (xs @ ys) = rev ys @ rev xs
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] rev ([] @ ys) = rev ys @ rev []
    #[2] ∀x. ∀xs. rev (xs @ ys) = rev ys @ rev xs ⟶ rev ((x # xs) @ ys) = rev ys @ rev (x # xs)
  ← rewrite append_def_1 goal=1
    #[3] rev ys = rev ys @ rev []
  ← rewrite rev_def_1 goal=3
    #[4] rev ys = rev ys @ []
  ← rewrite append_right_neutral goal=4
  ← intro x,xs goal=2
    #[5] _VAR x
    #[6] _VAR xs
    #[7] rev (xs @ ys) = rev ys @ rev xs
    #[8] rev ((x # xs) @ ys) = rev ys @ rev (x # xs)
  ← rewrite append_def_2 goal=8
    #[9] rev (x # xs @ ys) = rev ys @ rev (x # xs)
  ← rewrite rev_def_2 goal=9
    #[10] rev (xs @ ys) @ [x] = rev ys @ rev xs @ [x]
  ← rewrite source=prev goal=10 facts=[7]
    #[11] (rev ys @ rev xs) @ [x] = rev ys @ rev xs @ [x]
  ← rewrite append_assoc goal=11
    #[12] (rev ys @ rev xs) @ [x] = rev ys @ rev xs @ [x]
qed

theorem rev_rev
  fixes xs :: 'a list
  prop rev (rev xs) = xs
proof
  ← induct xs list_induct goal=0
    #[1] rev (rev ([]::'a list)) = []
    #[2] ∀x::'a. ∀xs. rev (rev xs) = xs ⟶ rev (rev (x # xs)) = x # xs
  ← rewrite rev_def_1 goal=1
    #[3] rev ([]::'a list) = []
  ← rewrite rev_def_1 goal=3
  ← intro x,xs goal=2
    #[4] _VAR x
    #[5] _VAR xs
    #[6] rev (rev xs) = xs
    #[7] rev (rev (x # xs)) = x # xs
  ← rewrite rev_def_2 goal=7
    #[8] rev (rev xs @ [x]) = x # xs
  ← rewrite rev_append goal=8
    #[9] rev [x] @ rev (rev xs) = x # xs
  ← rewrite rev_def_2 goal=9
    #[10] (rev [] @ [x]) @ rev (rev xs) = x # xs
  ← rewrite rev_def_1 goal=10
    #[11] ([] @ [x]) @ rev (rev xs) = x # xs
  ← rewrite append_def_1 goal=11
    #[12] [x] @ rev (rev xs) = x # xs
  ← rewrite append_def_2 goal=12
    #[13] x # [] @ rev (rev xs) = x # xs
  ← rewrite append_def_1 goal=13
    #[14] x # rev (rev xs) = x # xs
  ← rewrite source=prev goal=14 facts=[6]
qed

theorem rev_length
  fixes xs :: 'a list
  prop length (rev xs) = length xs
proof
  ← induct xs list_induct goal=0
    #[1] length (rev ([]::'a list)) = length ([]::'a list)
    #[2] ∀x::'a. ∀xs. length (rev xs) = length xs ⟶ length (rev (x # xs)) = length (x # xs)
  ← rewrite rev_def_1 goal=1
  ← intro x,xs goal=2
    #[3] _VAR x
    #[4] _VAR xs
    #[5] length (rev xs) = length xs
    #[6] length (rev (x # xs)) = length (x # xs)
  ← rewrite length_def_2 goal=6
    #[7] length (rev (x # xs)) = Suc (length xs)
  ← rewrite rev_def_2 goal=7
    #[8] length (rev xs @ [x]) = Suc (length xs)
  ← rewrite length_append goal=8
    #[9] length (rev xs) + length [x] = Suc (length xs)
  ← rewrite length_def_2 goal=9
    #[10] length (rev xs) + Suc (length ([]::'a list)) = Suc (length xs)
  ← rewrite length_def_1 goal=10
    #[11] length (rev xs) + Suc 0 = Suc (length xs)
  ← rewrite source=prev goal=11 facts=[5]
    #[12] length xs + Suc 0 = Suc (length xs)
  nat_norm goal=12
    #[13] length xs + Suc 0 = Suc (length xs)
qed

fun set :: 'a list ⇒ 'a set
  | set ([]::'a list) = ∅
  | set (x # xs) = insert x (set xs)

fun distinct :: 'a list ⇒ bool
  | distinct ([]::'a list) ⟷ true
  | distinct (x # xs) ⟷ ¬(x ∈ set xs) ∧ distinct xs

theorem not_member_nil
  fixes x :: 'a
  prop ~(x Mem set []) <--> true
proof
  ← rewrite set_def_1 sym=false goal=0
    #[1] ¬(x ∈ ∅) ⟷ true
  ← rewrite member_empty_simp sym=false goal=1
    #[2] ¬false ⟷ true
  ← rule iffI goal=2
    #[3] ¬false ⟶ true
    #[4] true ⟶ ¬false
  ← intro goal=3
    #[5] ¬false
    #[6] true
  ← rule trueI goal=6
    #[7] true
  ← intro goal=4
    #[8] true
    #[9] ¬false
  ← rule negI goal=9
    #[10] false ⟶ false
qed

theorem not_member_cons
  fixes x :: 'a, y :: 'a, ys :: 'a list
  prop ~(x Mem set (y # ys)) <--> ~(x = y) & ~(x Mem set ys)
proof
  ← rule iffI goal=0
    #[1] ¬(x ∈ set (y # ys)) ⟶ ¬(x = y) ∧ ¬(x ∈ set ys)
    #[2] ¬(x = y) ∧ ¬(x ∈ set ys) ⟶ ¬(x ∈ set (y # ys))
  ← intro goal=1
    #[3] ¬(x ∈ set (y # ys))
    #[4] ¬(x = y) ∧ ¬(x ∈ set ys)
  → rewrite target=fact set_def_2 sym=false goal=4 facts=[3]
    #[5] ¬(x ∈ insert y (set ys))
  → rewrite target=fact member_insert sym=false goal=4 facts=[5]
    #[6] ¬(x = y ∨ x ∈ set ys)
  → rewrite target=fact de_morgan_thm2 sym=false goal=4 facts=[6]
  ← intro goal=2
    #[7] ¬(x = y) ∧ ¬(x ∈ set ys)
    #[8] ¬(x ∈ set (y # ys))
  ← rewrite set_def_2 sym=false goal=8
    #[9] ¬(x ∈ insert y (set ys))
  ← rewrite member_insert sym=false goal=9
    #[10] ¬(x = y ∨ x ∈ set ys)
  ← rewrite de_morgan_thm2 sym=false goal=10
qed

theorem set_append
  fixes xs :: 'a list, ys :: 'a list
  prop set (xs @ ys) = set xs Un set ys
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] set ([] @ ys) = set [] Un set ys
    #[2] !x. !xs. set (xs @ ys) = set xs Un set ys --> set ((x # xs) @ ys) = set (x # xs) Un set ys
  ← rewrite append_def_1 goal=1
    #[3] set ys = set [] Un set ys
  ← rewrite set_def_1 goal=3
    #[4] set ys = {} Un set ys
  ← rewrite union_comm goal=4
    #[5] set ys = set ys Un {}
  ← rewrite union_empty goal=5
  ← intro x,xs goal=2
    #[6] _VAR x
    #[7] _VAR xs
    #[8] set (xs @ ys) = set xs Un set ys
    #[9] set ((x # xs) @ ys) = set (x # xs) Un set ys
  ← rewrite append_def_2 goal=9
    #[10] set (x # xs @ ys) = set (x # xs) Un set ys
  ← rewrite set_def_2 goal=10
    #[11] insert x (set (xs @ ys)) = insert x (set xs) Un set ys
  ← rewrite source=prev goal=11 facts=[8]
    #[12] insert x (set xs Un set ys) = insert x (set xs) Un set ys
  ← rewrite insert_union goal=12
qed

theorem member_set_append
  fixes xs :: 'a list, ys :: 'a list, x :: 'a
  prop x Mem set (xs @ ys) <--> x Mem set xs | x Mem set ys
  [hint_rewrite]
proof
  ← rewrite set_append sym=false goal=0
    #[1] x Mem set xs Un set ys <--> x Mem set xs | x Mem set ys
  ← rewrite member_union_iff sym=false goal=1
qed

theorem member_set_cons
  fixes xs :: 'a list, x :: 'a, y :: 'a
  prop x Mem set (y # xs) <--> x = y | x Mem set xs
  [hint_rewrite]
proof
  ← rewrite set_def_2 sym=false goal=0
    #[1] x Mem insert y (set xs) <--> x = y | x Mem set xs
  ← rewrite member_insert sym=false goal=1
qed

-- Monotonicity of `set` under cons: the head and the tail are members of the
-- extended list.  Facts stated in this direction because rewriting can only
-- unfold a membership in a *goal*; a proof holding `Mem set xs` as a
-- hypothesis needs a fact to derive `Mem set (x # xs)` from.

theorem mem_set_cons_self
  fixes x :: 'a, xs :: 'a list
  prop x ∈ set (x # xs)
proof
  ← rewrite member_set_cons sym=false goal=0
    #[1] x = x | x Mem set xs
  ← rule disjI1 goal=1
    #[2] x = x
  ← refl goal=2
qed

theorem mem_set_cons_weak
  fixes z :: 'a, x :: 'a, xs :: 'a list
  prop z ∈ set xs ⟶ z ∈ set (x # xs)
proof
  ← intro goal=0
    #[1] z Mem set xs
    #[2] z Mem set (x # xs)
  ← rewrite member_set_cons sym=false goal=2
    #[3] z = x | z Mem set xs
  ← rule disjI2 goal=3
qed

theorem member_set_append_left
  fixes xs :: 'a list, ys :: 'a list, x :: 'a
  prop x Mem set xs ⟶ x Mem set (xs @ ys)
proof
  ← intro goal=0
    #[1] x Mem set xs
    #[2] x Mem set (xs @ ys)
  ← rewrite member_set_append sym=false goal=2
  ← rule disjI1 goal=3
qed

theorem member_set_append_right
  fixes xs :: 'a list, ys :: 'a list, x :: 'a
  prop x Mem set ys ⟶ x Mem set (xs @ ys)
proof
  ← intro goal=0
    #[1] x Mem set ys
    #[2] x Mem set (xs @ ys)
  ← rewrite member_set_append sym=false goal=2
  ← rule disjI2 goal=3
qed

header "Prefix and suffix"

fun take :: nat ⇒ 'a list ⇒ 'a list
  | take 0 xs = []
  | take (Suc n) xs = (if xs = [] then [] else hd xs # take n (tl xs))

fun drop :: nat ⇒ 'a list ⇒ 'a list
  | drop 0 xs = xs
  | drop (Suc n) xs = (if xs = [] then [] else drop n (tl xs))

def sublist :: nat ⇒ nat ⇒ 'a list ⇒ 'a list = sublist l r xs = drop l (take r xs) [hint_rewrite]

theorem take_nil
  fixes n :: nat
  prop take n ([]::'a list) = []
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] take 0 ([]::'a list) = []
    #[2] !n. take n ([]::'a list) = [] --> take (Suc n) ([]::'a list) = []
  ← rewrite take_def_1 goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] take n ([]::'a list) = []
    #[5] take (Suc n) ([]::'a list) = []
  ← rewrite take_def_2 goal=5
    #[6] (if ([]::'a list) = [] then ([]::'a list) else hd [] # take n (tl [])) = []
  cut "([]::'a list) = []" goal=6
    #[7] ([]::'a list) = []
  ← refl goal=7
    #[8] ([]::'a list) = []
  ← rewrite if_P goal=6 facts=[8]
qed

theorem take_cons
  fixes n :: nat, x :: 'a, xs :: 'a list
  prop take (Suc n) (x # xs) = x # take n xs
  [hint_rewrite]
proof
  ← rewrite take_def_2 goal=0
    #[1] (if x # xs = [] then [] else hd (x # xs) # take n (tl (x # xs))) = x # take n xs
  cut "~(x # xs = [])" goal=1
    #[2] ~(x # xs = [])
  ← rule ineq_sym goal=2
    #[3] ~([] = x # xs)
  ← rule list_nil_cons_neq goal=3
  ← rewrite if_not_P goal=1 facts=[2]
    #[4] hd (x # xs) # take n (tl (x # xs)) = x # take n xs
  ← rewrite hd_def_1 goal=4
    #[5] x # take n (tl (x # xs)) = x # take n xs
  ← rewrite tl_def_1 goal=5
qed

theorem drop_nil
  fixes n :: nat
  prop drop n ([]::'a list) = []
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] drop 0 ([]::'a list) = []
    #[2] !n. drop n ([]::'a list) = [] --> drop (Suc n) ([]::'a list) = []
  ← rewrite drop_def_1 goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] drop n ([]::'a list) = []
    #[5] drop (Suc n) ([]::'a list) = []
  ← rewrite drop_def_2 goal=5
    #[6] (if ([]::'a list) = [] then ([]::'a list) else drop n (tl [])) = []
  cut "([]::'a list) = []" goal=6
    #[7] ([]::'a list) = []
  ← refl goal=7
    #[8] ([]::'a list) = []
  ← rewrite if_P goal=6 facts=[8]
qed

theorem drop_cons
  fixes n :: nat, x :: 'a, xs :: 'a list
  prop drop (Suc n) (x # xs) = drop n xs
  [hint_rewrite]
proof
  ← rewrite drop_def_2 goal=0
    #[1] (if x # xs = [] then [] else drop n (tl (x # xs))) = drop n xs
  cut "~(x # xs = [])" goal=1
    #[2] ~(x # xs = [])
  ← rule ineq_sym goal=2
    #[3] ~([] = x # xs)
  ← rule list_nil_cons_neq goal=3
  ← rewrite if_not_P goal=1 facts=[2]
    #[4] drop n (tl (x # xs)) = drop n xs
  ← rewrite tl_def_1 goal=4
qed

theorem append_take_drop_id
  fixes n :: nat
  prop !xs::'a list. take n xs @ drop n xs = xs
proof
  ← induct n nat_induct goal=0
    #[1] !xs::'a list. take 0 xs @ drop 0 xs = xs
    #[2] !n. (!xs::'a list. take n xs @ drop n xs = xs) --> (!xs::'a list. take (Suc n) xs @ drop (Suc n) xs = xs)
  ← intro xs goal=1
    #[3] _VAR xs
    #[4] take 0 xs @ drop 0 xs = xs
  ← rewrite drop_def_1 goal=4
    #[5] take 0 xs @ xs = xs
  ← rewrite take_def_1 goal=5
    #[6] [] @ xs = xs
  ← rewrite append_def_1 goal=6
  ← intro ih goal=2
    #[7] _VAR ih
    #[8] !xs::'a list. take ih xs @ drop ih xs = xs
    #[9] !xs::'a list. take (Suc ih) xs @ drop (Suc ih) xs = xs
  ← intro xs goal=9
    #[10] take (Suc ih) xs @ drop (Suc ih) xs = xs
  ← type_cases xs goal=10
    #[11] take (Suc ih) ([]::'a list) @ drop (Suc ih) [] = []
    #[12] !x::'a. !xs. take (Suc ih) (x # xs) @ drop (Suc ih) (x # xs) = x # xs
  ← rewrite take_nil goal=11
    #[13] ([]::'a list) @ drop (Suc ih) [] = []
  ← rewrite drop_nil goal=13
    #[14] ([]::'a list) @ [] = []
  ← rewrite append_def_1 goal=14
  ← intro x,xs goal=12
    #[16] _VAR x
    #[17] take (Suc ih) (x # xs) @ drop (Suc ih) (x # xs) = x # xs
  ← rewrite take_cons goal=17
    #[18] (x # take ih xs) @ drop (Suc ih) (x # xs) = x # xs
  ← rewrite drop_cons goal=18
    #[19] (x # take ih xs) @ drop ih xs = x # xs
  ← rewrite append_def_2 goal=19
    #[20] x # take ih xs @ drop ih xs = x # xs
  → inst xs goal=20 facts=[8]
    #[21] take ih xs @ drop ih xs = xs
  ← rewrite source=prev goal=20 facts=[21]
qed

theorem append_singleton_neq_nil
  fixes xs :: 'a list, x :: 'a
  prop ~(xs @ [x] = [])
  [hint_rewrite]
proof
  type_cases xs goal=0
  ← rewrite append_def_1 sym=false goal=1
  ← rule ineq_sym goal=3
  ← rule list_nil_cons_neq goal=4
  ← intro x1,xs goal=2
  ← rewrite append_def_2 sym=false goal=7
  ← rule ineq_sym goal=8
  ← rule list_nil_cons_neq goal=9
qed

header "Last element"

fun last :: 'a list ⇒ 'a
  | last (x # xs) = (if xs = [] then x else last xs)

fun butlast :: 'a list ⇒ 'a list
  | butlast [] = []
  | butlast (x # xs) = (if xs = [] then [] else x # butlast xs)

theorem last_append
  fixes xs :: 'a list, x :: 'a
  prop last (xs @ [x]) = x
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
  ← rewrite append_def_1 sym=false goal=1
  ← rewrite last_def_1 sym=false goal=3
  cut "([]::'a list) = []" goal=4
  ← refl goal=5
  ← rewrite if_P goal=4 facts=[5]
  ← intro x1,xs goal=2
  ← rewrite append_def_2 sym=false goal=9
  ← rewrite last_def_1 sym=false goal=10
  cut "~(xs @ [x] = [])" goal=11
  → forward append_singleton_neq_nil param_x=x param_xs=xs goal=12
  ← rewrite if_not_P goal=11 facts=[13]
qed

theorem butlast_append
  fixes xs :: 'a list, x :: 'a
  prop butlast (xs @ [x]) = xs
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
  ← rewrite append_def_1 sym=false goal=1
  ← rewrite butlast_def_2 sym=false goal=3
  cut "([]::'a list) = []" goal=4
  ← refl goal=5
  ← rewrite if_P goal=4 facts=[5]
  ← intro x1,xs goal=2
  ← rewrite append_def_2 sym=false goal=9
  ← rewrite butlast_def_2 sym=false goal=10
  cut "~(xs @ [x] = [])" goal=11
  → forward append_singleton_neq_nil param_x=x param_xs=xs goal=12
  ← rewrite if_not_P goal=11 facts=[13]
  ← rewrite source=prev goal=14 facts=[8]
qed

header "Map, filter and folds"

fun map :: ('a ⇒ 'b) ⇒ 'a list ⇒ 'b list
  | map f [] = []
  | map f (x # xs) = f x # map f xs

fun filter :: ('a ⇒ bool) ⇒ 'a list ⇒ 'a list
  | filter P [] = []
  | filter P (x # xs) = (if P x then x # filter P xs else filter P xs)

fun foldr :: ('a ⇒ 'b ⇒ 'b) ⇒ 'b ⇒ 'a list ⇒ 'b
  | foldr f z [] = z
  | foldr f z (x # xs) = f x (foldr f z xs)

fun foldl :: ('a ⇒ 'b ⇒ 'a) ⇒ 'a ⇒ 'b list ⇒ 'a
  | foldl f z [] = z
  | foldl f z (x # xs) = foldl f (f z x) xs

fun concat :: 'a list list ⇒ 'a list
  | concat [] = []
  | concat (xs # xss) = xs @ concat xss

fun zip :: 'a list ⇒ 'b list ⇒ ('a × 'b) list
  | zip [] ys = []
  | zip (x # xs) ys = (if ys = [] then [] else (x, hd ys) # zip xs (tl ys))

theorem length_map
  fixes f :: 'a ⇒ 'b, xs :: 'a list
  prop length (map f xs) = length xs
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] length (map f []) = length ([]::'a list)
    #[2] !x. !xs. length (map f xs) = length xs --> length (map f (x # xs)) = length (x # xs)
  ← rewrite map_def_1 goal=1
    #[3] length ([]::'b list) = length ([]::'a list)
  ← intro x,xs goal=2
    #[4] _VAR x
    #[5] _VAR xs
    #[6] length (map f xs) = length xs
    #[7] length (map f (x # xs)) = length (x # xs)
  ← rewrite length_def_1 goal=3
  ← rewrite map_def_2 goal=7
    #[8] length (f x # map f xs) = length (x # xs)
  ← rewrite length_def_2 goal=8
    #[9] Suc (length (map f xs)) = Suc (length xs)
  ← rewrite source=prev goal=9 facts=[6]
qed

theorem map_append
  fixes f :: 'a ⇒ 'b, xs :: 'a list, ys :: 'a list
  prop map f (xs @ ys) = map f xs @ map f ys
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
    #[1] map f ([] @ ys) = map f [] @ map f ys
    #[2] !x. !xs. map f (xs @ ys) = map f xs @ map f ys --> map f ((x # xs) @ ys) = map f (x # xs) @ map f ys
  ← rewrite append_def_1 goal=1
    #[3] map f ys = map f [] @ map f ys
  ← rewrite map_def_1 goal=3
    #[4] map f ys = [] @ map f ys
  ← rewrite append_def_1 goal=4
  ← intro x,xs goal=2
    #[5] _VAR x
    #[6] _VAR xs
    #[7] map f (xs @ ys) = map f xs @ map f ys
    #[8] map f ((x # xs) @ ys) = map f (x # xs) @ map f ys
  ← rewrite map_def_2 goal=8
    #[9] map f ((x # xs) @ ys) = (f x # map f xs) @ map f ys
  ← rewrite append_def_2 goal=9
    #[10] map f (x # xs @ ys) = f x # map f xs @ map f ys
  ← rewrite map_def_2 goal=10
    #[11] f x # map f (xs @ ys) = f x # map f xs @ map f ys
  ← rewrite source=prev goal=11 facts=[7]
qed

theorem set_map
  fixes f :: 'a => 'b, xs :: 'a list
  prop set (map f xs) = image f (set xs)
  [hint_rewrite]
proof
  ← induct xs list_induct goal=0
  ← rewrite map_def_1 goal=1
  ← rewrite set_def_1 goal=3
  ← rewrite image_empty goal=4
  ← intro x,xs goal=2
  ← rewrite map_def_2 goal=8
  ← rewrite set_def_2 goal=9
  ← rewrite image_insert goal=10
  ← rewrite source=prev goal=11 facts=[7]
qed

header "Reverse by accumulation"

fun itrev :: 'a list ⇒ 'a list ⇒ 'a list
  | itrev [] ys = ys
  | itrev (x # xs) ys = itrev xs (x # ys)

theorem itrev_rev_gen
  fixes xs :: 'a list
  prop !ys::'a list. itrev xs ys = rev xs @ ys
proof
  ← induct xs list_induct goal=0
  ← intro ys goal=1
  ← rewrite itrev_def_1 goal=4
  ← rewrite rev_def_1 goal=5
  ← rewrite append_def_1 goal=6
  ← intro x,xs goal=2
  ← intro ys goal=10
  ← rewrite itrev_def_2 goal=11
  → inst "(x # ys)" goal=12 facts=[9]
  ← rewrite rev_def_2 sym=false goal=12
  ← rewrite append_assoc sym=false goal=14
  ← rewrite append_def_2 sym=false goal=15
  ← rewrite append_def_1 sym=false goal=16
qed

theorem itrev_eq_rev
  fixes xs :: 'a list
  prop itrev xs [] = rev xs
  [hint_rewrite]
proof
  cut "!ys::'a list. itrev xs ys = rev xs @ ys" goal=0
  accept itrev_rev_gen goal=1
  → inst "([]::'a list)" goal=0 facts=[1]
  ← rewrite source=prev goal=0 facts=[2]
  ← rewrite append_right_neutral sym=false goal=3
qed

header "Update and swap by index"

fun list_update :: 'a list ⇒ nat ⇒ 'a ⇒ 'a list
  | list_update xs 0 v = (if xs = [] then [] else v # tl xs)
  | list_update xs (Suc n) v = (if xs = [] then [] else hd xs # list_update (tl xs) n v)

def list_swap :: 'a list ⇒ nat ⇒ nat ⇒ 'a list = list_swap xs i j = list_update (list_update xs i (nth xs j)) j (nth xs i)

header "Removing duplicates"

fun remdups :: 'a list ⇒ 'a list
  | remdups [] = []
  | remdups (x # xs) = (if x Mem set xs then remdups xs else x # remdups xs)

header "Index lemmas"

theorem nth_append_lt
  fixes i :: nat, ys :: 'a list
  prop !xs::'a list. i < length xs --> nth (xs @ ys) i = nth xs i
proof
  ← induct i nat_induct goal=0
  ← intro xs goal=1
  cut "0 < length xs --> nth (xs @ ys) 0 = nth xs 0" goal=5
  ← type_cases xs goal=6
  ← rewrite length_def_1 goal=7
  ← rewrite nat_less_def_1 goal=9
  ← intro goal=10
  ← rule falseE goal=12 facts=[11]
  ← intro u,v goal=8
  ← rewrite append_def_2 goal=17
  ← rewrite nth_cons_zero goal=18
  ← apply_prev goal=5 facts=[6,4]
  ← intro n goal=2
  ← intro zs goal=22
  cut "Suc n < length zs --> nth (zs @ ys) (Suc n) = nth zs (Suc n)" goal=25
  ← type_cases zs goal=26
  ← rewrite length_def_1 goal=27
  ← rewrite nat_less_def_1 goal=29
  accept falseE goal=30
  ← intro u,v goal=28
  ← rewrite append_def_2 goal=33
  ← rewrite nth_cons_suc goal=34
  → rewrite length_def_2 target=fact goal=35 facts=[32]
  → rewrite less_Suc_lesseq target=fact goal=35 facts=[36]
  → rewrite lesseq_Suc_less target=fact goal=35 facts=[37]
  ← inst v goal=35 facts=[21]
  → forward goal=35 facts=[39,38]
  ← apply_prev goal=35 facts=[40]
  ← apply_prev goal=25 facts=[26,24]
qed

theorem nth_list_update_same
  fixes i :: nat, v :: 'a
  prop !xs::'a list. i < length xs --> nth (list_update xs i v) i = v
proof
  ← induct i nat_induct goal=0
  ← intro xs goal=1
  cut "0 < length xs --> nth (list_update xs 0 v) 0 = v" goal=5
  ← type_cases xs goal=6
  ← rewrite length_def_1 goal=7
  ← rewrite nat_less_def_1 goal=9
  accept falseE goal=10
  ← intro u,vv goal=8
  ← rewrite list_update_def_1 goal=15
  cut "~(u # vv = [])" goal=16
  ← rule ineq_sym goal=17
  ← rule list_nil_cons_neq goal=18
  ← rewrite if_not_P goal=16 facts=[17]
  ← rewrite nth_cons_zero goal=20
  ← apply_prev goal=5 facts=[6,4]
  ← intro n goal=2
  ← intro xs goal=24
  cut "Suc n < length xs --> nth (list_update xs (Suc n) v) (Suc n) = v" goal=26
  ← type_cases xs goal=27
  ← rewrite length_def_1 goal=28
  ← rewrite nat_less_def_1 goal=30
  accept falseE goal=31
  ← intro u,vv goal=29
  ← rewrite list_update_def_2 goal=34
  cut "~(u # vv = [])" goal=35
  ← rule ineq_sym goal=36
  ← rule list_nil_cons_neq goal=37
  ← rewrite if_not_P goal=35 facts=[36]
  ← rewrite hd_def_1 goal=38
  ← rewrite tl_def_1 goal=39
  ← rewrite nth_cons_suc goal=40
  → rewrite length_def_2 target=fact goal=41 facts=[33]
  → rewrite less_Suc_lesseq target=fact goal=41 facts=[42]
  → rewrite lesseq_Suc_less target=fact goal=41 facts=[43]
  ← inst vv goal=41 facts=[23]
  → forward goal=41 facts=[45,44]
  ← apply_prev goal=41 facts=[46]
  ← apply_prev goal=26 facts=[27,25]
qed

theorem list_update_nil
  fixes i :: nat, v :: 'a
  prop list_update ([]::'a list) i v = []
  [hint_rewrite]
proof
  cut "([]::'a list) = []" goal=0
  ← refl goal=1
  ← type_cases i goal=0
  ← rewrite list_update_def_1 goal=2
  ← rewrite if_P goal=4 facts=[1]
  ← intro n goal=3
  ← rewrite list_update_def_2 goal=6
  ← rewrite if_P goal=7 facts=[1]
qed

theorem list_update_zero
  fixes x :: 'a, xs :: 'a list, v :: 'a
  prop list_update (x # xs) 0 v = v # xs
  [hint_rewrite]
proof
  cut "~(x # xs = [])" goal=0
  ← rule ineq_sym goal=1
  ← rule list_nil_cons_neq goal=2
  ← rewrite list_update_def_1 goal=0
  ← rewrite tl_def_1 goal=3
  ← rewrite if_not_P goal=4 facts=[1]
qed

theorem list_update_cons
  fixes x :: 'a, xs :: 'a list, n :: nat, v :: 'a
  prop list_update (x # xs) (Suc n) v = x # list_update xs n v
  [hint_rewrite]
proof
  cut "~(x # xs = [])" goal=0
  ← rule ineq_sym goal=1
  ← rule list_nil_cons_neq goal=2
  ← rewrite list_update_def_2 goal=0
  ← rewrite if_not_P goal=3 facts=[1]
  ← rewrite hd_def_1 goal=4
  ← rewrite tl_def_1 goal=5
qed

-- Note: forall-form lemma.  A forall-form proposition is NOT a rewrite
-- rule in holpy; use it via `→ forward length_list_update param_i=.. param_v=..`
-- followed by `→ inst <list>` (fact mode) or `← apply_prev`.
theorem length_list_update
  fixes i :: nat, v :: 'a
  prop !xs::'a list. length (list_update xs i v) = length xs
proof
  ← induct i nat_induct goal=0
  ← intro xs goal=1
  ← type_cases xs goal=4
  ← rewrite list_update_nil goal=5
  ← intro u,vv goal=6
  ← rewrite length_def_2 goal=9
  ← rewrite list_update_zero goal=10
  ← rewrite length_def_2 goal=11
  ← intro n goal=2
  ← intro xs goal=14
  ← type_cases xs goal=15
  ← rewrite list_update_nil goal=16
  ← intro u,vv goal=17
  ← rewrite list_update_cons goal=19
  ← rewrite length_def_2 goal=20
  ← inst vv goal=21 facts=[13]
  ← rewrite source=prev goal=21 facts=[22]
qed

theorem length_list_swap
  fixes xs :: 'a list, i :: nat, j :: nat
  prop length (list_swap xs i j) = length xs
  [hint_rewrite]
proof
  ← rewrite list_swap_def goal=0
  → forward length_list_update param_i=j param_v="(nth xs i)" goal=1
  ← inst "list_update xs i (nth xs j)" goal=1 facts=[2]
  ← rewrite source=prev goal=1 facts=[3]
  → forward length_list_update param_i=i param_v="(nth xs j)" goal=4
  ← apply_prev goal=4 facts=[5]
qed

theorem sublist_0
  fixes l :: nat, xs :: 'a list
  prop sublist 0 l xs = take l xs
  [hint_rewrite]
proof
  ← rewrite sublist_def goal=0
  ← rewrite drop_def_1 goal=1
qed

theorem nth_map
  fixes i :: nat, f :: 'a ⇒ 'b
  prop !xs::'a list. i < length xs --> nth (map f xs) i = f (nth xs i)
proof
  ← induct i nat_induct goal=0
  ← intro xs goal=1
  cut "0 < length xs --> nth (map f xs) 0 = f (nth xs 0)" goal=4
  ← type_cases xs goal=6
  ← rewrite length_def_1 goal=7
  ← rewrite nat_less_def_1 goal=9
  accept falseE goal=10
  ← intro u,vv goal=8
  ← apply_prev goal=5 facts=[6,4]
  ← rewrite map_def_2 goal=15
  ← rewrite nth_cons_zero goal=16
  ← intro n goal=2
  ← intro xs goal=20
  cut "Suc n < length xs --> nth (map f xs) (Suc n) = f (nth xs (Suc n))" goal=22
  ← type_cases xs goal=23
  ← rewrite length_def_1 goal=24
  ← rewrite nat_less_def_1 goal=26
  accept falseE goal=27
  ← intro u,vv goal=25
  ← rewrite map_def_2 goal=30
  ← rewrite nth_cons_suc goal=31
  → rewrite length_def_2 target=fact goal=32 facts=[29]
  → rewrite less_Suc_lesseq target=fact goal=32 facts=[33]
  → rewrite lesseq_Suc_less target=fact goal=32 facts=[34]
  ← inst vv goal=32 facts=[19]
  → forward goal=32 facts=[36,35]
  ← apply_prev goal=32 facts=[37]
  ← apply_prev goal=22 facts=[23,21]
qed

header "Length of filter"

theorem length_filter_le
  fixes P :: 'a ⇒ bool, xs :: 'a list
  prop length (filter P xs) <= length xs
proof
  ← induct xs list_induct goal=0
  ← rewrite filter_def_1 goal=1
  ← rewrite length_def_1 goal=3
  ← rewrite nat_less_eq_def_1 goal=4
  ← intro x,xs goal=2
  cases "P x" goal=8
  ← intro goal=9
  ← rewrite filter_def_2 goal=12
  ← rewrite if_P goal=13 facts=[11]
  ← rewrite length_def_2 goal=14
  ← rewrite le_suc goal=15
  ← intro goal=10
  ← rewrite filter_def_2 goal=17
  ← rewrite if_not_P goal=18 facts=[16]
  ← rewrite length_def_2 goal=19
  ← rewrite nat_less_eq_def_2 goal=20
  ← rule disjI2 goal=21
qed

header "Length of take"

theorem length_take_le
  fixes n :: nat
  prop !xs::'a list. length (take n xs) <= n
proof
  ← induct n nat_induct goal=0
  ← intro xs goal=1
  ← rewrite take_def_1 goal=4
  ← rewrite length_def_1 goal=5
  ← rewrite nat_less_eq_def_1 goal=6
  ← intro n goal=2
  ← intro xs goal=9
  ← rewrite take_def_2 goal=10
  ← type_cases xs goal=11
  cut "([]::'a list) = []" goal=12
  ← refl goal=14
  ← rewrite if_P goal=12 facts=[15]
  ← rewrite length_def_1 goal=16
  ← rule lesseq_zero goal=17
  ← intro u,vv goal=13
  cut "~(u # vv = [])" goal=21
  ← rule ineq_sym goal=22
  ← rule list_nil_cons_neq goal=23
  ← rewrite if_not_P goal=21 facts=[22]
  ← rewrite tl_def_1 goal=25
  ← rewrite length_def_2 goal=26
  ← rewrite le_suc goal=27
  ← apply_prev goal=28 facts=[8]
qed

theorem length_take
  fixes r :: nat
  prop !xs::'a list. r <= length xs --> length (take r xs) = r
proof
  ← induct r nat_induct goal=0
  ← intro xs goal=1
  ← rewrite take_def_1 goal=5
  ← rewrite length_def_1 goal=6
  ← intro n goal=2
  ← intro xs goal=10
  cut "Suc n <= length xs --> length (take (Suc n) xs) = Suc n" goal=12
  ← type_cases xs goal=13
  ← rewrite length_def_1 goal=14
  ← rewrite nat_less_eq_def_1 goal=16
  ← intro goal=17
  → rewrite eq_sym_eq target=fact goal=19 facts=[18]
  ← resolve nat_zero_Suc_neq goal=19 facts=[20]
  ← intro u,vv goal=15
  cut "~(u # vv = [])" goal=25
  ← rule ineq_sym goal=26
  ← rule list_nil_cons_neq goal=27
  ← rewrite take_def_2 goal=25
  ← rewrite tl_def_1 goal=29
  ← rewrite if_not_P goal=30 facts=[26]
  ← rewrite length_def_2 goal=31
  → rewrite length_def_2 target=fact goal=32 facts=[24]
  → rewrite le_suc target=fact goal=32 facts=[33]
  ← inst vv goal=32 facts=[9]
  → forward goal=32 facts=[35,34]
  ← rewrite source=prev goal=32 facts=[36]
  ← apply_prev goal=12 facts=[13,11]
qed

theorem length_drop
  fixes l :: nat
  prop !ys::'a list. l <= length ys --> length (drop l ys) = length ys - l
proof
  ← induct l nat_induct goal=0
  ← intro ys goal=1
  ← rewrite drop_def_1 goal=5
  ← rewrite nat_minus_def_1 goal=6
  ← intro n goal=2
  ← intro ys goal=10
  cut "Suc n <= length ys --> length (drop (Suc n) ys) = length ys - Suc n" goal=12
  ← type_cases ys goal=13
  ← rewrite length_def_1 goal=14
  ← rewrite nat_less_eq_def_1 goal=16
  ← intro goal=17
  → rewrite eq_sym_eq target=fact goal=19 facts=[18]
  ← resolve nat_zero_Suc_neq goal=19 facts=[20]
  ← intro u,vv goal=15
  cut "~(u # vv = [])" goal=25
  ← rule ineq_sym goal=26
  ← rule list_nil_cons_neq goal=27
  ← rewrite drop_def_2 goal=25
  ← rewrite if_not_P goal=29 facts=[26]
  ← rewrite length_def_2 goal=30
  ← rewrite nat_minus_suc goal=31
  ← rewrite tl_def_1 goal=32
  → rewrite length_def_2 target=fact goal=33 facts=[24]
  → rewrite le_suc target=fact goal=33 facts=[34]
  ← inst vv goal=33 facts=[9]
  → forward goal=33 facts=[36,35]
  ← rewrite source=prev goal=33 facts=[37]
  ← apply_prev goal=12 facts=[13,11]
qed

-- length_sublist uses the forall-form lemmas length_take / length_drop by
-- `cut <their prop>` + `accept <thm>` to obtain the forall fact, then
-- `→ inst <term>` + `→ forward` (or `← apply_prev`).  All facts are built
-- BEFORE the goal is unfolded, or the linear proof order is illegal.
theorem length_sublist
  fixes l :: nat, r :: nat, xs :: 'a list
  prop l <= r --> r <= length xs --> length (sublist l r xs) = r - l
proof
  ← intro goal=0
  cut "!xs::'a list. r <= length xs --> length (take r xs) = r" goal=3
  accept length_take goal=4
  cut "length (take r xs) = r" goal=3
  ← apply_prev goal=6 facts=[5,2]
  cut "r = length (take r xs)" goal=3
  ← rewrite source=prev goal=8 facts=[7]
  → rewrite source=prev target=fact goal=3 facts=[9,1]
  cut "!ys::'a list. l <= length ys --> length (drop l ys) = length ys - l" goal=3
  accept length_drop goal=11
  ← inst "take r xs" goal=3 facts=[12]
  → forward goal=3 facts=[13,10]
  ← rewrite sublist_def goal=3
  ← rewrite source=prev goal=15 facts=[14]
  ← rewrite source=prev goal=16 facts=[7]
qed
