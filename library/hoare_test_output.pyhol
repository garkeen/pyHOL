theory hoare_test_output
imports hoare
description "Generated from test"

theorem eval0
  prop Sem (Seq (Assign (0::nat) (λs. (1::nat))) (Assign 1 (λs. 2))) (λx. 0) ((λx. 0)(0 := 1, 1 := 2))

theorem eval1
  prop Sem (While (λs. ¬(s (0::nat) = (3::nat))) (λs. true) (Seq (Assign 1 (λs. s 1 + 5)) (Assign 0 (λs. s 0 + 1)))) (λx. 0) ((λx. 0)(0 := 3, 1 := 15))

theorem vcg0
  fixes A :: nat, B :: nat
  prop Valid (λs. s (0::nat) = 0 ∧ s 1 = 0) (While (λs. ¬(s 0 = A)) (λs. s 1 = s 0 * B) (Seq (Assign 1 (λs. s 1 + B)) (Assign 0 (λs. s 0 + 1)))) (λs. s 1 = A * B)

theorem vcg1
  prop Valid (λs. true) (Cond (λs. ¬(s (0::nat) = (0::nat))) (Assign 0 (λs. 0)) Skip) (λs. s 0 = 0)

theorem vcg2
  prop Valid (λs::nat ⇒ nat. true) (Cond (λs. s (12::nat) ≤ s 13) (Assign 2 (λs. s 13)) (Assign 2 (λs. s 12))) (λs. s 2 = s 12 ∨ s 2 = s 13)
