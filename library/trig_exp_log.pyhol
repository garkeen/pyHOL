theorem log_poly_upper_bound
  fixes n :: nat, x :: real
  prop 0 ≤ x ⟶ x < 1 ⟶ even n ⟶ 0 < n ⟶ log (1 + x) ≤ x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k)
  [hint_backward,hint_backward1]
  proof
    4: cut "x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))"
    4: rewrite_goal sum_lmul sym=true
    4: cut "∀a::real. ∀b. ∀d. a * (b * d) = b * (a * d)"
    4: z3
    5: rewrite_goal_with_prev @4
    5: cut "∀k::nat. x * x ^ k = x ^ (k + 1)"
    5: introduction k
    5.1: rewrite_goal real_pow_add sym=false
    5.1: rewrite_goal real_pow_1 sym=false
    5.1: apply_backward_step real_mult_comm
    6: rewrite_goal_with_prev @5
    9: rewrite_goal_with_prev @8
    9: apply_forward_step alt_sign_upper_bound param_f="(λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))" param_k=n param_m="(0::nat)"
    10: apply_forward_step real_lt_imp_le @1
    11: apply_forward_step log_alt_sign_lemma @0,10
    12: apply_forward_step conjD1 @11
    13: apply_forward_step conjD2 @11
    14: cut "!k::nat. k+1+1= k+2"
    14: z3
    15: rewrite_fact_with_prev @14,9
    16: apply_fact @15,12,13,3
    17: cut "abs x < 1"
    17: z3 @1,0
    18: apply_forward_step log_infsum @17
    19: rewrite_fact_with_prev @18,16
    20: cut "Suc (n-1) = n"
    20: rewrite_goal add_1_right sym=true
    20: apply_backward_step sub_add
    20: z3 @3
    23: rewrite_fact eq_sym_eq @22 sym=false
    24: rewrite_goal_with_prev @23
    24: rewrite_goal sum_Suc_natseg sym=false
    24: cut "0 ≤ Suc (n - 1)"
    24: apply_backward_step le_0
    25: rewrite_goal if_P @24 sym=false
    25: rewrite_goal_with_prev @22
    25: cut "abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) = -1 ^ n / of_nat (n + 1) * x ^ (n + 1)" @19
    25: rewrite_goal abs_def sym=false
    25: apply_backward_step if_P1
    25: apply_backward_step real_le_mul
    25: rewrite_goal real_divide_def sym=false
    25: apply_backward_step real_le_mul
    25: rewrite_goal real_pow_neg sym=false
    25: rewrite_goal if_P @2 sym=false
    25: rewrite_goal real_pow_one sym=false
    25: z3
    29: apply_backward_step real_lt_imp_le
    29: apply_backward_step real_lt_inv
    29: rewrite_goal real_zero_def sym=false
    29: rewrite_goal real_of_nat_lt sym=false
    29: z3
    36: apply_backward_step real_pow_le
    40: rewrite_fact_with_prev @39,19
  qed

theorem log_poly_lower_bound
  fixes n :: nat, x :: real
  prop 0 ≤ x ⟶ x < 1 ⟶ odd n ⟶ x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) ≤ log (1 + x)
  [hint_backward,hint_backward1]
  proof
    3: rewrite_fact odd_exists @2 sym=false
    4: exists_elim m @3
    6: cut "x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))"
    6: rewrite_goal sum_lmul sym=true
    6: cut "!a::real. !b. !c. a * ( b * c) = b * (c * a)"
    6: z3
    7: rewrite_goal_with_prev @6
    7: rewrite_goal real_pow_add sym=false
    7: rewrite_goal real_pow_1 sym=false
    11: rewrite_goal_with_prev @10
    11: apply_forward_step alt_sign_lower_bound param_f="(λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))" param_k=n param_m="(0::nat)"
    12: cut "0 < n"
    12: rewrite_goal_with_prev @5
    12: rewrite_goal add_1_right sym=true
    12: z3
    15: apply_forward_step real_lt_imp_le @1
    16: apply_forward_step log_alt_sign_lemma @0,15
    17: apply_forward_step conjD1 @16
    18: apply_forward_step conjD2 @16
    19: cut "!k::nat. k+1+1=k+2"
    19: z3
    20: rewrite_fact_with_prev @19,11
    21: apply_fact @20,17,18,14
    22: cut "abs x < 1"
    22: z3 @0,1
    23: apply_forward_step log_infsum @22
    24: rewrite_fact_with_prev @23,21
    25: cut "Suc (n-1) = n"
    25: rewrite_goal add_1_right sym=true
    25: z3 @14
    27: rewrite_fact eq_sym_eq @26 sym=false
    28: rewrite_goal_with_prev @27
    28: rewrite_goal sum_Suc_natseg sym=false
    28: cut "0 ≤ Suc (n - 1)"
    28: apply_backward_step le_0
    29: rewrite_goal if_P @28 sym=false
    29: rewrite_goal_with_prev @26
    29: cut "abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) = -(-1 ^ n / of_nat (n + 1) * x ^ (n + 1))"
    29: cut "!x::real. 0 <= -x --> abs x = -x"
    29: z3
    30: apply_prev @29
    30: rewrite_goal real_mul_lneg sym=true
    30: apply_backward_step real_le_mul
    30: rewrite_goal real_divide_def sym=false
    30: rewrite_goal real_mul_lneg sym=true
    30: apply_backward_step real_le_mul
    30: rewrite_goal real_pow_neg sym=false
    30: rewrite_fact not_even @2 sym=true
    31: rewrite_goal if_not_P @30 sym=false
    31: rewrite_goal real_neg_neg sym=false
    31: rewrite_goal real_pow_one sym=false
    31: z3
    36: apply_backward_step real_lt_imp_le
    36: apply_backward_step real_lt_inv
    36: rewrite_goal real_zero_def sym=false
    36: rewrite_goal real_of_nat_lt sym=false
    36: z3
    44: apply_backward_step real_pow_le
    48: rewrite_fact_with_prev @47,24
    49: rewrite_fact real_minus_def @48 sym=false
    50: rewrite_fact real_neg_neg @49 sym=false
  qed

theorem log_reduce_pos_pow
  fixes k :: nat, y :: real
  prop 0 < y ⟶ log (2 ^ k * y) = of_nat k * log 2 + log y
  [hint_backward]
  proof
    1: apply_forward_step real_lt_pow2 param_n=k
    2: apply_forward_step log_mul @1,0
    3: rewrite_goal_with_prev @2
    3: rewrite_goal real_eq_add_rcancel sym=false
    3: apply_backward_step log_pow
    3: z3
  qed

theorem log_reduce_neg_pow
  fixes k :: nat, y :: real
  prop 0 < y ⟶ log (y / 2 ^ k) = log y - of_nat k * log 2
  [hint_backward]
  proof
    1: apply_forward_step real_lt_pow2 param_n=k
    2: apply_forward_step log_div @0,1
    3: rewrite_goal_with_prev @2
    3: cut "!a::real. !b. !c. b=c --> a-b=a-c"
    3: z3
    4: apply_prev @3
    4: apply_backward_step log_pow
    4: z3
  qed
