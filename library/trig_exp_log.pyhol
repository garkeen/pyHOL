theory trig_exp_log
imports trig_series
description "Formal inequalities for trig about exp and log series."

theorem exp_pos_poly_lower_bound
  fixes n :: nat, x :: real
  prop 0 ≤ x ⟶ sum ({0..n}) (λk. real_inverse (of_nat (fact k)) * x ^ k) ≤ exp x
  [hint_backward]
  proof
    1: rewrite_goal exp_infsum sym=true
    1: apply_forward_step real_infsum_offset param_f="(λk. 1 / of_nat (fact k) * x ^ k)" param_k=n param_m="(0::nat)"
    2: cut "real_summable (from 0) (λk. 1 / of_nat (fact k) * x ^ k)" @1
    2: apply_forward_step exp_series param_x=x
    3: rewrite_fact from_0 @2 sym=true
    4: rewrite_goal real_summable_def sym=false
    4: apply_backward_step exI @3
    6: cut "0 ≤ n"
    6: apply_backward_step le_0
    7: apply_fact @1,5,6
    8: rewrite_goal_with_prev @7
    8: rewrite_goal real_inverse_divide sym=false
    8: cut "!a::real. !b. a <= a + b <--> 0 <= b"
    8: z3
    9: rewrite_goal_with_prev @8
    9: apply_backward_step real_series_pos param_f="(λk. 1 / of_nat (fact k) * x ^ k)" param_s="from (n + 1)"
    9: rewrite_goal real_sums_infsum sym=false
    9: apply_backward_step real_summable_from_elsewhere param_m="(0::nat)"
    11: introduction i
    11.2: rewrite_goal real_inverse_divide sym=true
    11.2: apply_backward_step real_le_mul
    11.2: apply_backward_step real_lt_imp_le
    11.2: apply_backward_step real_lt_inv
    11.2: rewrite_goal real_zero_def sym=false
    11.2: rewrite_goal real_of_nat_lt sym=false
    11.2: apply_backward_step fact_lt
    11.7: apply_backward_step real_pow_le
  qed

theorem exp_ge1
  fixes x :: real
  prop 0 ≤ x ⟶ 1 ≤ exp x
  [hint_backward]
  proof
    1: apply_forward_step exp_pos_poly_lower_bound param_n="(0::nat)" param_x=x
    2: apply_fact @1,0
    3: rewrite_fact sum_sing_natseg @2 sym=false
    4: rewrite_fact fact_def_1 @3 sym=false
    5: rewrite_fact real_nat_power_def_1 @4 sym=false
    6: rewrite_fact real_one_def @5 sym=true
    7: rewrite_fact real_mul_rid @6 sym=false
    8: rewrite_fact real_inv_1 @7 sym=false
  qed

theorem neg_exp_le1
  fixes x :: real
  prop 0 ≤ x ⟶ exp (-x) ≤ 1
  [hint_backward]
  proof
    1: rewrite_goal real_exp_neg sym=false
    1: apply_backward_step real_inv_le_1
    1: apply_backward_step exp_ge1 @0
  qed

theorem neg_exp_series
  fixes x :: real
  prop real_sums (λk. -1 ^ k / of_nat (fact k) * x ^ k) (exp (-x)) (from 0)
  [hint_backward]
  proof
    0: apply_forward_step exp_series param_x=-x
    1: cut "!k. 1 / of_nat (fact k) * -x ^ k = -1 ^ k / of_nat (fact k) * x ^ k"
    1: introduction k
    1.1: cut "-x = -1 * x"
    1.1: real_norm
    1.2: rewrite_goal_with_prev @1.1
    1.2: rewrite_goal real_pow_mul sym=false
    1.2: rewrite_goal real_divide_def sym=false
    1.2: real_norm
    2: rewrite_fact_with_prev @1,0
    3: rewrite_goal from_0 sym=false
  qed

theorem neg_exp_infsum
  fixes x :: real
  prop real_infsum (from 0) (λk. -1 ^ k / of_nat (fact k) * x ^ k) = exp (-x)
  [hint_rewrite]
  proof
    0: apply_backward_step real_infsum_unique
    0: apply_backward_step neg_exp_series
  qed

theorem n_le_fact
  fixes n :: nat
  prop n ≤ fact n
  [hint_backward]
  proof
    0: induction n nat_induct
    0: apply_backward_step le_0
    1: introduction n
    1.2: rewrite_goal fact_def_2 sym=false
    1.2: cut "!a::nat. !b. a <= b <--> a * 1 <= b"
    1.2: z3
    1.3: rewrite_goal_with_prev @1.2
    1.3: apply_backward_step le_mult2
    1.3: apply_backward_step less_eq_refl
    1.4: apply_backward_step fact_le
  qed

theorem exp_alt_sign_lemma
  fixes x :: real
  prop 0 ≤ x ⟶ x ≤ 1 ⟶ (∀k. abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k) * x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0) ∧ tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially
  proof
    2: apply_backward_step conjI
    2: introduction k
    2.1: rewrite_goal real_abs_mul sym=false
    2.1: apply_backward_step conjI
    2.1: apply_backward_step real_le_mul2
    2.1: apply_backward_step real_abs_pos
    2.2: rewrite_goal real_divide_def sym=false
    2.2: rewrite_goal real_abs_mul sym=false
    2.2: apply_backward_step real_le_mul2
    2.2: apply_backward_step real_abs_pos
    2.3: rewrite_goal abs_neg_one_pow sym=false
    2.3: apply_backward_step real_le_refl
    2.5: apply_backward_step real_abs_pos
    2.6: rewrite_goal real_abs_inv sym=false
    2.6: rewrite_goal real_abs_nat sym=false
    2.6: apply_backward_step real_le_inv2
    2.6: rewrite_goal real_zero_def sym=false
    2.6: rewrite_goal real_of_nat_lt sym=false
    2.6: apply_backward_step fact_lt
    2.9: rewrite_goal real_of_nat_le sym=false
    2.9: apply_backward_step fact_mono
    2.9: apply_backward_step le_add
    2.18: apply_backward_step real_abs_pos
    2.19: rewrite_goal real_abs_pow sym=false
    2.19: apply_backward_step real_pow_mono_inv
    2.19: apply_backward_step real_abs_pos
    2.20: z3 @0,1
    2.24: cut "!a::real. !b. !c. !d. !r. !t. (a / b * r) * (c / d * t) <= 0 \n		 <--> 0 <= ((-1 ^ (1::nat) * a * c) * (r * t)) / b / d"
    2.24: rewrite_goal real_pow_1 sym=false
    2.24: rewrite_goal real_divide_def sym=false
    2.24: introduction a,b,c,d,r,t
    2.24.6: rewrite_goal real_divide_def sym=false
    2.24.6: z3
    2.27: rewrite_goal_with_prev @2.26
    2.27: rewrite_goal real_pow_add sym=true
    2.27: rewrite_goal real_pow_add sym=true
    2.27: rewrite_goal real_divide_def sym=false
    2.27: rewrite_goal real_divide_def sym=false
    2.27: apply_backward_step real_le_mul
    2.27: apply_backward_step real_le_mul
    2.27: apply_backward_step real_le_mul
    2.27: cut "1 + (k + 1) + k = 2 * (k+1)"
    2.27: nat_norm
    2.28: rewrite_goal_with_prev @2.27
    2.28: rewrite_goal real_pow_pow sym=true
    2.28: apply_backward_step real_pow_le
    2.28: apply_backward_step real_le_pow_2
    2.32: apply_backward_step real_pow_le
    2.34: apply_backward_step real_lt_imp_le
    2.34: apply_backward_step real_lt_inv
    2.34: rewrite_goal real_zero_def sym=false
    2.34: rewrite_goal real_of_nat_lt sym=false
    2.34: apply_backward_step fact_lt
    2.40: apply_backward_step real_lt_imp_le
    2.40: apply_backward_step real_lt_inv
    3: apply_backward_step reallim_null_comparison param_g="(%k. real_inverse (of_nat k))"
    3: rewrite_goal eventually_sequentially sym=false
    3: inst_exists_goal "(1::nat)"
    3: introduction n
    3.2: rewrite_goal real_divide_def sym=false
    3.2: rewrite_goal real_abs_mul sym=false
    3.2: cut "∀a::real. ∀b. a ≤ b ⟷ a ≤ b * 1"
    3.2: z3
    3.3: rewrite_goal_with_prev @3.2
    3.3: apply_backward_step real_le_mul2
    3.3: apply_backward_step real_abs_pos
    3.4: rewrite_goal real_abs_mul sym=false
    3.4: rewrite_goal abs_neg_one_pow sym=false
    3.4: rewrite_goal real_mul_lid sym=false
    3.4: rewrite_goal real_abs_inv sym=false
    3.4: rewrite_goal real_abs_nat sym=false
    3.4: apply_backward_step real_le_inv2
    3.4: rewrite_goal real_zero_def sym=false
    3.4: rewrite_goal real_of_nat_lt sym=false
    3.4: z3 @3.1
    3.7: rewrite_goal real_of_nat_le sym=false
    3.7: apply_backward_step n_le_fact
    3.15: apply_backward_step real_abs_pos
    3.16: rewrite_goal real_abs_pow sym=false
    3.16: apply_backward_step real_pow_1_le
    3.16: apply_backward_step real_abs_pos
    3.17: z3 @0,1
    6: apply_backward_step reallim_1_over_n
  qed

theorem exp_neg_poly_upper_bound
  fixes n :: nat, x :: real
  prop 0 ≤ x ⟶ x ≤ 1 ⟶ even n ⟶ exp (-x) ≤ sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  [hint_backward,hint_backward1]
  proof
    3: rewrite_fact even_exists @2 sym=false
    4: exists_elim m @3
    6: cases "n=0"
    6: introduction
    6.1: rewrite_goal_with_prev @6.0
    6.1: rewrite_goal sum_sing_natseg sym=false
    6.1: rewrite_goal real_nat_power_def_1 sym=false
    6.1: rewrite_goal real_mul_rid sym=false
    6.1: rewrite_goal fact_def_1 sym=false
    6.1: rewrite_goal real_one_def sym=true
    6.1: rewrite_goal real_div_1 sym=false
    6.1: apply_backward_step neg_exp_le1
    7: introduction
    7.1: apply_forward_step alt_sign_upper_bound param_f="(λk. -1 ^ k / of_nat (fact k) * x ^ k)" param_k=n param_m="(0::nat)"
    7.2: apply_forward_step le_1_1 @7.0
    7.3: apply_forward_step exp_alt_sign_lemma @0,1
    7.4: apply_forward_step conjD1 @7.3
    7.5: apply_forward_step conjD2 @7.3
    7.6: apply_fact @7.1,7.4,7.5,7.2
    7.7: rewrite_fact neg_exp_infsum @7.6 sym=false
    7.8: rewrite_goal_with_prev @5
    7.8: rewrite_fact_with_prev @5,7.7
    7.9: cut "Suc (2 * m - 1) = 2 * m"
    7.9: rewrite_goal add_1_right sym=true
    7.9: apply_backward_step sub_add
    7.9: apply_backward_step le_1_2
    7.9: rewrite_fact_with_prev @5,7.0
    7.13: rewrite_fact eq_sym_eq @7.12 sym=false
    7.14: rewrite_goal_with_prev @7.13
    7.14: rewrite_goal sum_Suc_natseg sym=false
    7.14: cut "0 ≤ Suc (2 * m - 1)"
    7.14: apply_backward_step le_0
    7.15: rewrite_goal if_P @7.14 sym=false
    7.15: rewrite_goal_with_prev @7.12
    7.15: cut "abs (-1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)) = -1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)"
    7.15: rewrite_goal abs_def sym=false
    7.15: apply_backward_step if_P1
    7.15: apply_backward_step real_le_mul
    7.15: rewrite_goal real_divide_def sym=false
    7.15: apply_backward_step real_le_mul
    7.15: rewrite_goal real_pow_pow sym=true
    7.15: apply_backward_step real_pow_le
    7.15: apply_backward_step real_le_pow_2
    7.18: apply_backward_step real_lt_imp_le
    7.18: apply_backward_step real_lt_inv
    7.18: rewrite_goal real_zero_def sym=false
    7.18: rewrite_goal real_of_nat_lt sym=false
    7.18: apply_backward_step fact_lt
    7.25: apply_backward_step real_pow_le
    7.29: rewrite_fact_with_prev @7.28,7.8
  qed

theorem exp_neg_poly_lower_bound
  fixes n :: nat, x :: real
  prop 0 ≤ x ⟶ x ≤ 1 ⟶ odd n ⟶ sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) ≤ exp (-x)
  [hint_backward,hint_backward1]
  proof
    3: apply_forward_step alt_sign_lower_bound param_f="(λk. -1 ^ k / of_nat (fact k) * x ^ k)" param_k=n param_m="(0::nat)"
    4: apply_forward_step exp_alt_sign_lemma @0,1
    5: cut "0 < n"
    5: rewrite_fact odd_exists @2 sym=false
    6: exists_elim m @5
    8: rewrite_goal_with_prev @7
    8: rewrite_goal less_Suc_lesseq sym=false
    8: apply_backward_step le_0
    11: apply_forward_step conjD1 @4
    12: apply_forward_step conjD2 @4
    13: apply_fact @3,11,12,10
    14: rewrite_fact neg_exp_infsum @13 sym=false
    15: cut "Suc (n - 1) = n"
    15: rewrite_goal add_1_right sym=true
    15: apply_backward_step sub_add
    15: z3 @10
    18: rewrite_fact eq_sym_eq @17 sym=false
    19: rewrite_goal_with_prev @18
    19: rewrite_goal sum_Suc_natseg sym=false
    19: cut "0 ≤ Suc (n - 1)"
    19: apply_backward_step le_0
    20: rewrite_goal if_P @19 sym=false
    20: rewrite_fact real_minus_def @14 sym=false
    21: rewrite_goal_with_prev @17
    21: cut "-(abs (-1 ^ n / of_nat (fact n) * x ^ n)) = -1 ^ n / of_nat (fact n) * x ^ n" @20
    21: cut "!x::real. x<= 0 --> -(abs x) = x"
    21: z3
    22: apply_prev @21
    22: rewrite_goal real_pow_neg sym=false
    22: rewrite_fact not_even @2 sym=true
    23: rewrite_goal if_not_P @22 sym=false
    23: rewrite_goal real_pow_one sym=false
    23: rewrite_goal real_divide_def sym=false
    23: rewrite_goal real_mul_lneg sym=false
    23: rewrite_goal real_mul_lid sym=false
    23: rewrite_goal real_mul_lneg sym=false
    23: cut "!x::real. 0<= x --> -x <= 0"
    23: z3
    24: apply_prev @23
    24: apply_backward_step real_le_mul
    24: apply_backward_step real_lt_imp_le
    24: apply_backward_step real_lt_inv
    24: rewrite_goal real_zero_def sym=false
    24: rewrite_goal real_of_nat_lt sym=false
    24: apply_backward_step fact_lt
    29: apply_backward_step real_pow_le
    40: rewrite_fact_with_prev @39,20
  qed

theorem exp_reduce
  fixes k :: nat, x :: real
  prop 0 < k ⟶ exp (x / of_nat k) ^ k = exp x
  [hint_backward]
  proof
    1: rewrite_goal real_exp_n sym=true
    1: cut "of_nat k * (x / of_nat k) = x * (of_nat k / of_nat k)"
    1: rewrite_goal real_divide_def sym=false
    1: real_norm
    3: rewrite_goal_with_prev @2
    3: cut "~(of_nat k = (0::real))"
    3: rewrite_goal real_zero_def sym=false
    3: rewrite_goal real_of_nat_eq sym=false
    3: z3 @0
    6: apply_forward_step real_div_refl @5
    7: rewrite_goal_with_prev @6
    7: rewrite_goal real_mul_rid sym=false
  qed

theorem exp_full_reduce
  fixes k :: nat, x :: real
  prop 0 < k ⟶ real_inverse (exp (-x / of_nat k) ^ k) = exp x
  [hint_backward]
  proof
    1: apply_forward_step exp_reduce @0 param_x=x
    2: rewrite_goal real_pow_inv sym=true
    2: rewrite_goal real_exp_neg sym=true
    2: rewrite_goal real_divide_def sym=false
    2: rewrite_goal real_mul_lneg sym=false
    2: rewrite_goal real_neg_neg sym=false
    2: rewrite_fact real_divide_def @1 sym=false
  qed

