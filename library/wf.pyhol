theory wf
imports nat, wf_base
description "Well-founded relations and general recursion (measure-based part; the nat-free core is wf_base)."

def measure :: ('a ⇒ nat) ⇒ 'a ⇒ 'a ⇒ bool = measure m = (%x. %y. m x < m y) [hint_rewrite]


theorem wf_measure
  fixes m :: 'a => nat
  prop wf (measure m)
proof
  ← rewrite measure_def goal=0
    #[1] wf (%x. %y. m x < m y)
  → forward wf_less_nat goal=1
    #[2] wf (%m::nat. %n. m < n)
  ← rule wf_measure_gen goal=1 facts=[2]
qed

header "Subrelations"


def mlex_prod :: ('a ⇒ nat) ⇒ ('a ⇒ 'a ⇒ bool) ⇒ 'a ⇒ 'a ⇒ bool = mlex_prod f R = (%x. %y. f x < f y | f x = f y & R x y) [hint_rewrite]


theorem wf_mlex
  fixes f :: 'a => nat, R :: 'a => 'a => bool
  prop wf R --> wf (mlex_prod f R)
proof
  ← intro goal=0
    #[1] wf R
    #[2] wf (mlex_prod f R)
  ← rewrite wf_def goal=2
    #[3] !P. (!x. (!y. mlex_prod f R y x --> P y) --> P x) --> (!x. P x)
  ← intro P goal=3
    #[4] _VAR P
    #[5] !x. (!y. mlex_prod f R y x --> P y) --> P x
    #[6] !x. P x
  ← intro x goal=6
    #[7] _VAR x
    #[8] P x
  cut "!n::nat. !y::'a. f y = n --> P y" goal=8
    #[9] !n. !y. f y = n --> P y
  ← rule nat_less_induct param_P="(%n::nat. !y::'a. f y = n --> P y)" goal=9
    #[10] !n. (!y. y < n --> (!y1. f y1 = y --> P y1)) --> (!y. f y = n --> P y)
  ← intro n goal=10
    #[11] _VAR n
    #[12] !y. y < n --> (!y1. f y1 = y --> P y1)
    #[13] !y. f y = n --> P y
  ← intro y goal=13
    #[14] _VAR y
    #[15] f y = n
    #[16] P y
  cut "!a::'a. f a = n --> P a" goal=16
    #[17] !a. f a = n --> P a
  ← rule wf_induct goal=17 facts=[1]
    #[18] !a. (!y. R y a --> f y = n --> P y) --> f a = n --> P a
  ← intro a goal=18
    #[19] _VAR a
    #[20] !y. R y a --> f y = n --> P y
    #[21] f a = n
    #[22] P a
  ← apply_prev goal=22 facts=[5]
    #[23] !y. mlex_prod f R y a --> P y
  ← intro z goal=23
    #[24] _VAR z
    #[25] mlex_prod f R z a
    #[26] P z
  → rewrite mlex_prod_def target=fact goal=26 facts=[25]
    #[27] f z < f a | f z = f a & R z a
  ← rule disjE goal=26 facts=[27]
    #[28] f z < f a --> P z
    #[29] f z = f a & R z a --> P z
  ← intro goal=28
    #[30] f z < f a
    #[31] P z
  → rewrite target=fact goal=31 facts=[21,30]
    #[32] f z < n
  ← inst "(f z)" goal=31 facts=[12]
    #[33] f z < n --> (!y. f y = f z --> P y)
  → forward goal=31 facts=[33,32]
    #[34] !y. f y = f z --> P y
  ← inst z goal=31 facts=[34]
    #[35] f z = f z --> P z
  ← apply_prev goal=31 facts=[35]
    #[36] f z = f z
  ← rule eq_refl goal=36
    #[37] f z = f z
  ← intro goal=29
    #[38] f z = f a & R z a
    #[39] P z
  ← inst z goal=39 facts=[20]
    #[40] R z a --> f z = n --> P z
  → rewrite target=fact goal=39 facts=[21,38]
    #[41] f z = n & R z a
  → forward conjD1 goal=39 facts=[41]
    #[42] f z = n
  → forward conjD2 goal=39 facts=[41]
    #[43] R z a
  → forward goal=39 facts=[40,43]
    #[44] f z = n --> P z
  ← apply_prev goal=39 facts=[44,42]
    #[45] P z
  ← inst y goal=16 facts=[17]
    #[46] f y = n --> P y
  ← apply_prev goal=16 facts=[46,15]
  ← inst "(f x)" goal=8 facts=[9]
    #[47] !y. f y = f x --> P y
  ← inst x goal=8 facts=[47]
    #[48] f x = f x --> P x
  ← apply_prev goal=8 facts=[48]
    #[49] f x = f x
  ← rule eq_refl goal=49
    #[50] f x = f x
qed

header "Well-founded recursion"
