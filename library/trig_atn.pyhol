theory trig_atn
imports trig_series
description "Formal inequalities for trig about atn series."

def halfatn :: real ⇒ real = halfatn x = x / (sqrt (1 + x ^ (2::nat)) + 1) [hint_rewrite]

def halfatn4 :: real ⇒ real = halfatn4 = halfatn ∘ halfatn ∘ halfatn ∘ halfatn [hint_rewrite]

theorem abs_lemma
  fixes a :: real
  prop 0 < a --> abs a = a
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < a
    #[2] abs a = a
  ← z3 goal=2 facts=[1]
qed

theorem pos_lemma
  fixes x :: real
  prop 0 < 1 + x ^ (2::nat)
  [hint_backward]
proof
  cut "∀a::real. 0 ≤ a ⟶ 0 < 1 + a " goal=0
    #[1] ∀a::real. 0 ≤ a ⟶ 0 < 1 + a
  ← z3 goal=1
  ← apply_prev goal=0 facts=[1]
    #[2] 0 ≤ x ^ (2::nat)
  ← rule real_le_pow_2 goal=2
qed

theorem pos_lemma2
  fixes x :: real
  prop 0 < sqrt (1 + x ^ (2::nat)) + 1
  [hint_backward]
proof
  cut "!a::real. 0 <= a --> 0 < a + 1" goal=0
    #[1] ∀a::real. 0 ≤ a ⟶ 0 < a + 1
  ← z3 goal=1
  ← apply_prev goal=0 facts=[1]
    #[2] 0 ≤ sqrt (1 + x ^ (2::nat))
  ← rewrite sqrt_le_0 sym=false goal=2
    #[3] 0 ≤ 1 + x ^ (2::nat)
  ← rule real_lt_imp_le goal=3
    #[4] 0 < 1 + x ^ (2::nat)
  ← rule pos_lemma goal=4
qed

theorem eq_lemma
  fixes x :: real
  prop 1 - halfatn x ^ (2::nat) = 2 / (sqrt (1 + x ^ (2::nat)) + 1)
  [hint_rewrite]
proof
  ← rewrite halfatn_def sym=false goal=0
    #[1] 1 - (x / (sqrt (1 + x ^ (2::nat)) + 1)) ^ (2::nat) = 2 / (sqrt (1 + x ^ (2::nat)) + 1)
  ← rewrite real_pow_div sym=false goal=1
    #[2] 1 - x ^ (2::nat) / (sqrt (1 + x ^ (2::nat)) + 1) ^ (2::nat) = 2 / (sqrt (1 + x ^ (2::nat)) + 1)
  cut "(sqrt (1 + x ^ (2::nat))) ^ (2::nat) = 1 + x ^ (2::nat)" goal=2
    #[3] sqrt (1 + x ^ (2::nat)) ^ (2::nat) = 1 + x ^ (2::nat)
  ← rewrite sqrt_pow2 sym=false goal=3
    #[4] 0 ≤ 1 + x ^ (2::nat)
  ← rule real_lt_imp_le goal=4
    #[5] 0 < 1 + x ^ (2::nat)
  ← rule pos_lemma goal=5
  → forward pos_lemma2 param_x=x goal=2
    #[6] 0 < sqrt (1 + x ^ (2::nat)) + 1
  cut "∀b. 0 < b + 1 ⟶ b ^ (2::nat) = 1 + x ^ (2::nat) ⟶ 1 - x ^ (2::nat) / (b + 1) ^ (2::nat) = 2 / (b + 1)" goal=2
    #[7] ∀b. 0 < b + 1 ⟶ b ^ (2::nat) = 1 + x ^ (2::nat) ⟶ 1 - x ^ (2::nat) / (b + 1) ^ (2::nat) = 2 / (b + 1)
  ← rewrite real_pow_2 sym=false goal=7
    #[8] ∀b. 0 < b + 1 ⟶ b * b = 1 + x * x ⟶ 1 - x * x / ((b + 1) * (b + 1)) = 2 / (b + 1)
  ← z3 goal=8
  ← apply_prev goal=2 facts=[7]
qed

theorem halfatn_bounds_abs
  fixes x :: real
  prop abs (halfatn x) < 1
  [hint_backward]
proof
  ← rewrite halfatn_def sym=false goal=0
    #[1] abs (x / (sqrt (1 + x ^ (2::nat)) + 1)) < 1
  ← rewrite real_abs_div sym=false goal=1
    #[2] abs x / abs (sqrt (1 + x ^ (2::nat)) + 1) < 1
  cut "0 < abs (sqrt (1 + x ^ (2::nat)) + 1)" goal=2
    #[3] 0 < abs (sqrt (1 + x ^ (2::nat)) + 1)
  cut "∀a::real. 0 < a ⟶ 0 < abs a" goal=3
    #[4] ∀a::real. 0 < a ⟶ 0 < abs a
  ← z3 goal=4
  ← apply_prev goal=3 facts=[4]
    #[5] 0 < sqrt (1 + x ^ (2::nat)) + 1
  ← rule pos_lemma2 goal=5
  → forward real_lt_ldiv_eq param_x="abs x" param_y="(1::real)" goal=2 facts=[3]
    #[6] abs x / abs (sqrt (1 + x ^ (2::nat)) + 1) < 1 ⟷ abs x < 1 * abs (sqrt (1 + x ^ (2::nat)) + 1)
  ← rewrite source=prev goal=2 facts=[6]
    #[7] abs x < 1 * abs (sqrt (1 + x ^ (2::nat)) + 1)
  → forward abs_lemma goal=7 facts=[5]
    #[8] abs (sqrt (1 + x ^ (2::nat)) + 1) = sqrt (1 + x ^ (2::nat)) + 1
  ← rewrite source=prev goal=7 facts=[8]
    #[9] abs x < 1 * (sqrt (1 + x ^ (2::nat)) + 1)
  cut "!x::real. !y. x < y --> x < 1 * (y + 1)" goal=9
    #[10] ∀x::real. ∀y. x < y ⟶ x < 1 * (y + 1)
  ← z3 goal=10
  ← apply_prev goal=9 facts=[10]
    #[11] abs x < sqrt (1 + x ^ (2::nat))
  ← rule real_lt_rsqrt goal=11
    #[12] abs x ^ (2::nat) < 1 + x ^ (2::nat)
  ← rewrite real_pow2_abs sym=false goal=12
    #[13] x ^ (2::nat) < 1 + x ^ (2::nat)
  ← rewrite real_pow_2 sym=false goal=13
    #[14] x * x < 1 + x * x
  ← z3 goal=14
qed

theorem halfatn_half
  fixes t :: real, x :: real
  prop abs x < t --> abs (halfatn x) < t / 2
  [hint_backward]
proof
  ← intro goal=0
    #[1] abs x < t
    #[2] abs (halfatn x) < t / 2
  ← rewrite halfatn_def sym=false goal=2
    #[3] abs (x / (sqrt (1 + x ^ (2::nat)) + 1)) < t / 2
  ← rewrite real_abs_div sym=false goal=3
    #[4] abs x / abs (sqrt (1 + x ^ (2::nat)) + 1) < t / 2
  → forward pos_lemma2 param_x=x goal=4
    #[5] 0 < sqrt (1 + x ^ (2::nat)) + 1
  → forward abs_lemma goal=4 facts=[5]
    #[6] abs (sqrt (1 + x ^ (2::nat)) + 1) = sqrt (1 + x ^ (2::nat)) + 1
  ← rewrite source=prev goal=4 facts=[6]
    #[7] abs x / (sqrt (1 + x ^ (2::nat)) + 1) < t / 2
  → forward real_lt_ldiv_eq param_x="abs x" param_y="t / 2" goal=7 facts=[5]
    #[8] abs x / (sqrt (1 + x ^ (2::nat)) + 1) < t / 2 ⟷ abs x < t / 2 * (sqrt (1 + x ^ (2::nat)) + 1)
  ← rewrite source=prev goal=7 facts=[8]
    #[9] abs x < t / 2 * (sqrt (1 + x ^ (2::nat)) + 1)
  ← rule real_lte_trans param_y=t goal=9
    #[10] t ≤ t / 2 * (sqrt (1 + x ^ (2::nat)) + 1)
  cut "!a::real. t / 2 * a = t * (a / 2)" goal=10
    #[11] ∀a. t / 2 * a = t * (a / 2)
  ← z3 goal=11
    #[12] ∀a. t / 2 * a = t * (a / 2)
  ← rewrite source=prev goal=10 facts=[12]
    #[13] t ≤ t * ((sqrt (1 + x ^ (2::nat)) + 1) / 2)
  cut "!a. t * (1 + 1) <= t * a --> t <= t * (a / 2)" goal=13
    #[14] ∀a. t * (1 + 1) ≤ t * a ⟶ t ≤ t * (a / 2)
  ← z3 goal=14
    #[15] ∀a. t * (1 + 1) ≤ t * a ⟶ t ≤ t * (a / 2)
  ← apply_prev goal=13 facts=[15]
    #[16] t * (1 + 1) ≤ t * (sqrt (1 + x ^ (2::nat)) + 1)
  ← rule real_le_lmul goal=16
    #[17] 0 ≤ t
    #[18] 1 + 1 ≤ sqrt (1 + x ^ (2::nat)) + 1
  ← z3 goal=17 facts=[1]
  cut "!a::real. 1 <= a --> 1+1<=a+1" goal=18
    #[19] ∀a::real. 1 ≤ a ⟶ 1 + 1 ≤ a + 1
  ← z3 goal=19
    #[20] ∀a::real. 1 ≤ a ⟶ 1 + 1 ≤ a + 1
  ← apply_prev goal=18 facts=[20]
    #[21] 1 ≤ sqrt (1 + x ^ (2::nat))
  ← rule real_le_rsqrt goal=21
    #[22] 1 ^ (2::nat) ≤ 1 + x ^ (2::nat)
  ← rewrite real_pow_one sym=false goal=22
    #[23] 1 ≤ 1 + x ^ (2::nat)
  ← rewrite real_pow_2 sym=false goal=23
    #[24] 1 ≤ 1 + x * x
  ← z3 goal=24
    #[25] 1 ≤ 1 + x * x
qed

theorem atn_half
  fixes x :: real
  prop atn x = 2 * atn (halfatn x)
  [hint_rewrite]
proof
  ← rewrite real_mul_2 sym=false goal=0
    #[1] atn x = atn (halfatn x) + atn (halfatn x)
  cut "abs (halfatn x * halfatn x) < 1" goal=1
    #[2] abs (halfatn x * halfatn x) < 1
  ← rewrite real_pow_2 sym=true goal=2
    #[3] abs (halfatn x ^ (2::nat)) < 1
  ← rewrite real_abs_pow sym=false goal=3
    #[4] abs (halfatn x) ^ (2::nat) < 1
  ← rewrite real_pow2_abs sym=false goal=4
    #[5] halfatn x ^ (2::nat) < 1
  ← rewrite abs_sqare_lt_1 sym=false goal=5
    #[6] abs (halfatn x) < 1
  ← rule halfatn_bounds_abs goal=6
  → forward atn_add_small goal=1 facts=[2]
    #[7] atn (halfatn x) + atn (halfatn x) = atn ((halfatn x + halfatn x) / (1 - halfatn x * halfatn x))
  ← rewrite source=prev goal=1 facts=[7]
    #[8] atn x = atn ((halfatn x + halfatn x) / (1 - halfatn x * halfatn x))
  ← rewrite real_mul_2 sym=true goal=8
    #[9] atn x = atn (2 * halfatn x / (1 - halfatn x * halfatn x))
  ← rewrite real_pow_2 sym=true goal=9
    #[10] atn x = atn (2 * halfatn x / (1 - halfatn x ^ (2::nat)))
  cut "x = (2 * halfatn x / (1 - halfatn x ^ (2::nat)))" goal=10
    #[11] x = 2 * halfatn x / (1 - halfatn x ^ (2::nat))
  ← rewrite eq_lemma sym=false goal=11
    #[12] x = 2 * halfatn x / (2 / (sqrt (1 + x ^ (2::nat)) + 1))
  ← rewrite halfatn_def sym=false goal=12
    #[13] x = 2 * (x / (sqrt (1 + x ^ (2::nat)) + 1)) / (2 / (sqrt (1 + x ^ (2::nat)) + 1))
  cut "!a. 0 < a --> x = 2 *(x/a)/(2/a)" goal=13
    #[14] ∀a. 0 < a ⟶ x = 2 * (x / a) / (2 / a)
  ← z3 goal=14
  ← apply_prev goal=13 facts=[14]
    #[15] 0 < sqrt (1 + x ^ (2::nat)) + 1
  ← rule pos_lemma2 goal=15
  → rewrite target=fact eq_sym_eq sym=false goal=10 facts=[11]
    #[16] 2 * halfatn x / (1 - halfatn x ^ (2::nat)) = x
  ← rewrite source=prev goal=10 facts=[16]
qed

theorem rat_lemma4_lt
  fixes x1 :: real, x2 :: real, y1 :: real, y2 :: real
  prop 0 < y1 --> 0 < y2 --> x1 / y1 < x2 / y2 <--> x1 * y2 < x2 * y1
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < y1
    #[2] 0 < y2
    #[3] x1 / y1 < x2 / y2 ⟷ x1 * y2 < x2 * y1
  ← z3 goal=3 facts=[1,2]
qed

theorem halfatn_odd
  fixes x :: real
  prop halfatn (-x) = -(halfatn x)
  [hint_rewrite]
proof
  ← rewrite halfatn_def sym=false goal=0
    #[1] -x / (sqrt (1 + -x ^ (2::nat)) + 1) = -(x / (sqrt (1 + x ^ (2::nat)) + 1))
  ← rewrite real_pow_neg sym=false goal=1
    #[2] -x / (sqrt (1 + (if even 2 then x ^ (2::nat) else -(x ^ (2::nat)))) + 1) = -(x / (sqrt (1 + x ^ (2::nat)) + 1))
  cut "even 2" goal=2
    #[3] even 2
  ← rewrite even_exists sym=false goal=3
    #[4] ∃m::nat. 2 = 2 * m
  ← inst "(1::nat)" goal=4
    #[5] (2::nat) = 2 * 1
  ← rewrite mult_1_right sym=false goal=5
  ← rewrite if_P sym=false goal=2 facts=[3]
    #[6] -x / (sqrt (1 + x ^ (2::nat)) + 1) = -(x / (sqrt (1 + x ^ (2::nat)) + 1))
  ← rewrite real_divide_def sym=false goal=6
    #[7] -x * real_inverse (sqrt (1 + x ^ (2::nat)) + 1) = -(x * real_inverse (sqrt (1 + x ^ (2::nat)) + 1))
  ← rewrite real_mul_lneg sym=false goal=7
qed

theorem halfatn_sgn
  fixes x :: real
  prop real_sgn (halfatn x) = real_sgn x
  [hint_rewrite]
proof
  ← rewrite halfatn_def sym=false goal=0
    #[1] real_sgn (x / (sqrt (1 + x ^ (2::nat)) + 1)) = real_sgn x
  ← rewrite real_sgn_div sym=false goal=1
    #[2] real_sgn x / real_sgn (sqrt (1 + x ^ (2::nat)) + 1) = real_sgn x
  cut "real_sgn (sqrt (1 + x ^ (2::nat)) + 1) = 1" goal=2
    #[3] real_sgn (sqrt (1 + x ^ (2::nat)) + 1) = 1
  ← rewrite real_sgn_def sym=false goal=3
    #[4] (if 0 < sqrt (1 + x ^ (2::nat)) + 1 then (1::real) else if sqrt (1 + x ^ (2::nat)) + 1 < 0 then -1 else 0) = 1
  ← rule if_P1 goal=4
    #[5] 0 < sqrt (1 + x ^ (2::nat)) + 1
  ← rule pos_lemma2 goal=5
  ← rewrite source=prev goal=2 facts=[3]
    #[6] real_sgn x / 1 = real_sgn x
  ← rewrite real_div_1 sym=false goal=6
qed

theorem halfatn_pos_eq
  fixes x :: real
  prop 0 <= halfatn x <--> 0 <= x
  [hint_rewrite]
proof
  ← rule real_sgn_eq_pos goal=0
    #[1] real_sgn (halfatn x) = real_sgn x
  ← rewrite halfatn_sgn sym=false goal=1
qed

theorem halfatn_pos_lt_eq
  fixes x :: real
  prop 0 < halfatn x <--> 0 < x
  [hint_rewrite]
proof
  ← rule real_sgn_eq_pos_lt goal=0
    #[1] real_sgn (halfatn x) = real_sgn x
  ← rewrite halfatn_sgn sym=false goal=1
qed

theorem halfatn_pos
  fixes x :: real
  prop 0 <= x --> 0 <= halfatn x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ halfatn x
  ← rewrite halfatn_pos_eq sym=false goal=2
qed

theorem halfatn_neg
  fixes x :: real
  prop x < 0 --> halfatn x < 0
  [hint_backward]
proof
  ← intro goal=0
    #[1] x < 0
    #[2] halfatn x < 0
  ← rewrite real_less_def sym=false goal=2
    #[3] ¬(0 ≤ halfatn x)
  ← rewrite halfatn_pos_eq sym=false goal=3
    #[4] ¬(0 ≤ x)
  ← rewrite real_not_lt sym=true goal=4
    #[5] ¬¬(x < 0)
  ← rewrite double_neg sym=false goal=5
qed

theorem halfatn4_pos
  fixes x :: real
  prop 0 <= x --> 0 <= halfatn4 x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ halfatn4 x
  ← rewrite halfatn4_def sym=false goal=2
    #[3] 0 ≤ (halfatn ∘ halfatn ∘ halfatn ∘ halfatn) x
  ← rewrite comp_fun_def sym=false goal=3
    #[4] 0 ≤ (halfatn ∘ halfatn ∘ halfatn) (halfatn x)
  ← rewrite comp_fun_def sym=false goal=4
    #[5] 0 ≤ (halfatn ∘ halfatn) (halfatn (halfatn x))
  ← rewrite comp_fun_def sym=false goal=5
    #[6] 0 ≤ halfatn (halfatn (halfatn (halfatn x)))
  ← rule halfatn_pos goal=6
    #[7] 0 ≤ halfatn (halfatn (halfatn x))
  ← rule halfatn_pos goal=7
    #[8] 0 ≤ halfatn (halfatn x)
  ← rule halfatn_pos goal=8
    #[9] 0 ≤ halfatn x
  ← rule halfatn_pos goal=9
qed

theorem halfatn4_pos_eq
  fixes x :: real
  prop 0 <= halfatn4 x <--> 0 <= x
  [hint_rewrite]
proof
  ← rewrite halfatn4_def sym=false goal=0
    #[1] 0 ≤ (halfatn ∘ halfatn ∘ halfatn ∘ halfatn) x ⟷ 0 ≤ x
  ← rewrite comp_fun_def sym=false goal=1
    #[2] 0 ≤ (halfatn ∘ halfatn ∘ halfatn) (halfatn x) ⟷ 0 ≤ x
  ← rewrite comp_fun_def sym=false goal=2
    #[3] 0 ≤ (halfatn ∘ halfatn) (halfatn (halfatn x)) ⟷ 0 ≤ x
  ← rewrite comp_fun_def sym=false goal=3
    #[4] 0 ≤ halfatn (halfatn (halfatn (halfatn x))) ⟷ 0 ≤ x
  ← rewrite halfatn_pos_eq sym=false goal=4
    #[5] 0 ≤ halfatn (halfatn (halfatn x)) ⟷ 0 ≤ x
  ← rewrite halfatn_pos_eq sym=false goal=5
    #[6] 0 ≤ halfatn (halfatn x) ⟷ 0 ≤ x
  ← rewrite halfatn_pos_eq sym=false goal=6
    #[7] 0 ≤ halfatn x ⟷ 0 ≤ x
  ← rewrite halfatn_pos_eq sym=false goal=7
qed

theorem halfatn4_pos_lt_eq
  fixes x :: real
  prop 0 < halfatn4 x <--> 0 < x
  [hint_rewrite]

theorem halfatn_mono_lt
  fixes x :: real, y :: real
  prop x < y --> halfatn x < halfatn y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x < y
    #[2] halfatn x < halfatn y
  cut "!x. !y. 0 <= x --> x < y --> halfatn x < halfatn y" goal=2
    #[3] ∀x. ∀y. 0 ≤ x ⟶ x < y ⟶ halfatn x < halfatn y
  ← intro a,b goal=3
    #[4] _VAR a
    #[5] _VAR b
    #[6] 0 ≤ a
    #[7] a < b
    #[8] halfatn a < halfatn b
  ← rewrite halfatn_def sym=false goal=8
    #[9] a / (sqrt (1 + a ^ (2::nat)) + 1) < b / (sqrt (1 + b ^ (2::nat)) + 1)
  → forward pos_lemma2 param_x=a goal=9
    #[10] 0 < sqrt (1 + a ^ (2::nat)) + 1
  → forward pos_lemma2 param_x=b goal=9
    #[11] 0 < sqrt (1 + b ^ (2::nat)) + 1
  → forward rat_lemma4_lt param_x1=a param_x2=b goal=9 facts=[10,11]
    #[12] a / (sqrt (1 + a ^ (2::nat)) + 1) < b / (sqrt (1 + b ^ (2::nat)) + 1) ⟷ a * (sqrt (1 + b ^ (2::nat)) + 1) < b * (sqrt (1 + a ^ (2::nat)) + 1)
  ← rewrite source=prev goal=9 facts=[12]
    #[13] a * (sqrt (1 + b ^ (2::nat)) + 1) < b * (sqrt (1 + a ^ (2::nat)) + 1)
  ← rewrite real_add_ldistrib sym=false goal=13
    #[14] a * sqrt (1 + b ^ (2::nat)) + a * 1 < b * sqrt (1 + a ^ (2::nat)) + b * 1
  ← rewrite real_mul_rid sym=false goal=14
    #[15] a * sqrt (1 + b ^ (2::nat)) + a < b * sqrt (1 + a ^ (2::nat)) + b
  ← rule real_let_add2 goal=15
    #[16] a * sqrt (1 + b ^ (2::nat)) ≤ b * sqrt (1 + a ^ (2::nat))
  cut "!c. sqrt (1 + c ^ (2::nat)) = abs (sqrt (1 + c^ (2::nat)))" goal=16
    #[17] ∀c. sqrt (1 + c ^ (2::nat)) = abs (sqrt (1 + c ^ (2::nat)))
  ← intro c goal=17
    #[18] _VAR c
    #[19] sqrt (1 + c ^ (2::nat)) = abs (sqrt (1 + c ^ (2::nat)))
  → forward pos_lemma param_x=c goal=19
    #[20] 0 < 1 + c ^ (2::nat)
  → forward sqrt_pos_lt goal=19 facts=[20]
    #[21] 0 < sqrt (1 + c ^ (2::nat))
  → forward abs_lemma goal=19 facts=[21]
    #[22] abs (sqrt (1 + c ^ (2::nat))) = sqrt (1 + c ^ (2::nat))
  ← rewrite source=prev goal=19 facts=[22]
    #[23] sqrt (1 + c ^ (2::nat)) = abs (sqrt (1 + c ^ (2::nat)))
  ← rewrite source=prev goal=16 facts=[17]
    #[24] a * abs (sqrt (1 + b ^ (2::nat))) ≤ b * abs (sqrt (1 + a ^ (2::nat)))
  cut "abs (a * sqrt (1 + b ^ (2::nat))) ≤ abs (b * sqrt (1 + a ^ (2::nat)))" goal=24
    #[25] abs (a * sqrt (1 + b ^ (2::nat))) ≤ abs (b * sqrt (1 + a ^ (2::nat)))
  ← rewrite real_le_square_abs sym=false goal=25
    #[26] (a * sqrt (1 + b ^ (2::nat))) ^ (2::nat) ≤ (b * sqrt (1 + a ^ (2::nat))) ^ (2::nat)
  ← rewrite real_pow_mul sym=false goal=26
    #[27] a ^ (2::nat) * sqrt (1 + b ^ (2::nat)) ^ (2::nat) ≤ b ^ (2::nat) * sqrt (1 + a ^ (2::nat)) ^ (2::nat)
  ← rewrite sqrt_works_gen_2 sym=false goal=27
    #[28] a ^ (2::nat) * abs (1 + b ^ (2::nat)) ≤ b ^ (2::nat) * abs (1 + a ^ (2::nat))
  cut "!c::real. abs (1 + c ^ (2::nat)) = 1 + c ^ (2::nat)" goal=28
    #[29] ∀c::real. abs (1 + c ^ (2::nat)) = 1 + c ^ (2::nat)
  ← intro c goal=29
    #[30] abs (1 + c ^ (2::nat)) = 1 + c ^ (2::nat)
  ← rule abs_lemma goal=30
    #[31] 0 < 1 + c ^ (2::nat)
  ← rule pos_lemma goal=31
  ← rewrite source=prev goal=28 facts=[29]
    #[32] a ^ (2::nat) * (1 + b ^ (2::nat)) ≤ b ^ (2::nat) * (1 + a ^ (2::nat))
  ← rewrite real_add_ldistrib sym=false goal=32
    #[33] a ^ (2::nat) * 1 + a ^ (2::nat) * b ^ (2::nat) ≤ b ^ (2::nat) * 1 + b ^ (2::nat) * a ^ (2::nat)
  ← rewrite real_mul_rid sym=false goal=33
    #[34] a ^ (2::nat) + a ^ (2::nat) * b ^ (2::nat) ≤ b ^ (2::nat) + b ^ (2::nat) * a ^ (2::nat)
  ← rule real_le_add2 goal=34
    #[35] a ^ (2::nat) ≤ b ^ (2::nat)
    #[36] a ^ (2::nat) * b ^ (2::nat) ≤ b ^ (2::nat) * a ^ (2::nat)
  ← rule real_pow_le2 goal=35
    #[37] a ≤ b
  ← rule real_lt_imp_le goal=37
  ← rewrite real_pow_2 sym=false goal=36
    #[38] a * a * (b * b) ≤ b * b * (a * a)
  ← z3 goal=38
    #[39] a * a * (b * b) ≤ b * b * (a * a)
  → rewrite target=fact real_abs_mul sym=false goal=24 facts=[25]
    #[40] abs a * abs (sqrt (1 + b ^ (2::nat))) ≤ abs b * abs (sqrt (1 + a ^ (2::nat)))
  cut "abs a =a" goal=24
    #[41] abs a = a
  ← z3 goal=41 facts=[6]
    #[42] abs a = a
  cut "abs b = b" goal=24
    #[43] abs b = b
  ← z3 goal=43 facts=[6,7]
    #[44] abs b = b
  → rewrite target=fact source=prev goal=24 facts=[42,40]
    #[45] a * abs (sqrt (1 + b ^ (2::nat))) ≤ abs b * abs (sqrt (1 + a ^ (2::nat)))
  → rewrite target=fact source=prev goal=24 facts=[44,45]
  ← cases "y < 0" goal=2
    #[46] y < 0 ⟶ halfatn x < halfatn y
    #[47] ¬(y < 0) ⟶ halfatn x < halfatn y
  ← intro goal=46
    #[48] y < 0
    #[49] halfatn x < halfatn y
  cut "!a::real. !b. a < b <--> -b < -a" goal=49
    #[50] ∀a::real. ∀b. a < b ⟷ -b < -a
  ← z3 goal=50
    #[51] ∀a::real. ∀b. a < b ⟷ -b < -a
  ← rewrite source=prev goal=49 facts=[51]
    #[52] -(halfatn y) < -(halfatn x)
  ← rewrite halfatn_odd sym=true goal=52
    #[53] halfatn (-y) < halfatn (-x)
  ← apply_prev goal=53 facts=[3]
    #[54] 0 ≤ -y
    #[55] -y < -x
  ← z3 goal=54 facts=[48]
    #[56] 0 ≤ -y
  → rewrite target=fact source=prev goal=55 facts=[51,1]
    #[57] -y < -x
  ← intro goal=47
    #[58] ¬(y < 0)
    #[59] halfatn x < halfatn y
  ← cases "x < 0" goal=59
    #[60] x < 0 ⟶ halfatn x < halfatn y
    #[61] ¬(x < 0) ⟶ halfatn x < halfatn y
  ← intro goal=60
    #[62] x < 0
    #[63] halfatn x < halfatn y
  ← rule real_lte_trans param_y="(0::real)" goal=63
    #[64] halfatn x < 0
    #[65] 0 ≤ halfatn y
  ← rule halfatn_neg goal=64
  ← rule halfatn_pos goal=65
    #[66] 0 ≤ y
  → rewrite target=fact real_not_lt sym=false goal=66 facts=[58]
    #[67] 0 ≤ y
  ← intro goal=61
    #[68] ¬(x < 0)
    #[69] halfatn x < halfatn y
  ← apply_prev goal=69 facts=[3]
    #[70] 0 ≤ x
  → rewrite target=fact real_not_lt sym=false goal=70 facts=[68]
    #[71] 0 ≤ x
qed

theorem halfatn_mono
  fixes x :: real, y :: real
  prop x <= y --> halfatn x <= halfatn y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x ≤ y
    #[2] halfatn x ≤ halfatn y
  → rewrite target=fact real_le_lt sym=false goal=2 facts=[1]
    #[3] x < y ∨ x = y
  ← rule disjE goal=2 facts=[3]
    #[4] x < y ⟶ halfatn x ≤ halfatn y
    #[5] x = y ⟶ halfatn x ≤ halfatn y
  ← intro goal=4
    #[6] x < y
    #[7] halfatn x ≤ halfatn y
  ← rule real_lt_imp_le goal=7
    #[8] halfatn x < halfatn y
  ← rule halfatn_mono_lt goal=8 facts=[6]
    #[9] halfatn x < halfatn y
  ← intro goal=5
    #[10] x = y
    #[11] halfatn x ≤ halfatn y
  ← rewrite source=prev goal=11 facts=[10]
    #[12] halfatn y ≤ halfatn y
  ← rule real_le_refl goal=12
    #[13] halfatn y ≤ halfatn y
qed

theorem atn_halfatn4
  fixes x :: real
  prop atn x = 16 * atn (halfatn4 x)
  [hint_rewrite]
proof
  cut "!a::real. 16 * a = 2 * (2 * (2 * (2 * a)))" goal=0
    #[1] ∀a::real. 16 * a = 2 * (2 * (2 * (2 * a)))
  ← z3 goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] atn x = 2 * (2 * (2 * (2 * atn (halfatn4 x))))
  ← rewrite halfatn4_def sym=false goal=2
    #[3] atn x = 2 * (2 * (2 * (2 * atn ((halfatn ∘ halfatn ∘ halfatn ∘ halfatn) x))))
  ← rewrite comp_fun_def sym=false goal=3
    #[4] atn x = 2 * (2 * (2 * (2 * atn ((halfatn ∘ halfatn ∘ halfatn) (halfatn x)))))
  ← rewrite comp_fun_def sym=false goal=4
    #[5] atn x = 2 * (2 * (2 * (2 * atn ((halfatn ∘ halfatn) (halfatn (halfatn x))))))
  ← rewrite comp_fun_def sym=false goal=5
    #[6] atn x = 2 * (2 * (2 * (2 * atn (halfatn (halfatn (halfatn (halfatn x)))))))
  ← rewrite atn_half sym=true goal=6
    #[7] atn x = 2 * (2 * (2 * atn (halfatn (halfatn (halfatn x)))))
  ← rewrite atn_half sym=true goal=7
    #[8] atn x = 2 * (2 * atn (halfatn (halfatn x)))
  ← rewrite atn_half sym=true goal=8
    #[9] atn x = 2 * atn (halfatn x)
  ← rewrite atn_half sym=true goal=9
qed

theorem halfatn4_bound
  fixes x :: real
  prop abs (halfatn4 x) < real_inverse 8
  [hint_backward]
proof
  ← rewrite halfatn4_def sym=false goal=0
    #[1] abs ((halfatn ∘ halfatn ∘ halfatn ∘ halfatn) x) < real_inverse 8
  ← rewrite comp_fun_def sym=false goal=1
    #[2] abs ((halfatn ∘ halfatn ∘ halfatn) (halfatn x)) < real_inverse 8
  ← rewrite comp_fun_def sym=false goal=2
    #[3] abs ((halfatn ∘ halfatn) (halfatn (halfatn x))) < real_inverse 8
  ← rewrite comp_fun_def sym=false goal=3
    #[4] abs (halfatn (halfatn (halfatn (halfatn x)))) < real_inverse 8
  cut "real_inverse 8 = 1/2/2/2" goal=4
    #[5] real_inverse 8 = 1 / 2 / 2 / 2
  ← rewrite real_inverse_divide sym=false goal=5
    #[6] 1 / 8 = 1 / 2 / 2 / 2
  real_norm goal=6
  ← rewrite source=prev goal=4 facts=[5]
    #[7] abs (halfatn (halfatn (halfatn (halfatn x)))) < 1 / 2 / 2 / 2
  ← rule halfatn_half goal=7
    #[8] abs (halfatn (halfatn (halfatn x))) < 1 / 2 / 2
  ← rule halfatn_half goal=8
    #[9] abs (halfatn (halfatn x)) < 1 / 2
  ← rule halfatn_half goal=9
    #[10] abs (halfatn x) < 1
  ← rule halfatn_bounds_abs goal=10
qed

theorem atn_series_alt_sign
  fixes x :: real
  prop abs x < 1 --> (!n. abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3)) <= abs (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) & -1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3) * (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) <= 0) & tendsto_real (%i. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) 0 sequentially
proof
  ← intro goal=0
    #[1] abs x < 1
    #[2] (∀n. abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3)) ≤ abs (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ∧ -1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3) * (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ≤ 0) ∧ tendsto_real (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) 0 sequentially
  ← rule conjI goal=2
    #[3] ∀n. abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3)) ≤ abs (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ∧ -1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3) * (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ≤ 0
    #[4] tendsto_real (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) 0 sequentially
  ← intro n goal=3
    #[5] _VAR n
    #[6] abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3)) ≤ abs (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ∧ -1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3) * (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ≤ 0
  ← rule conjI goal=6
    #[7] abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3)) ≤ abs (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1))
    #[8] -1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3) * (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ≤ 0
  ← rewrite real_abs_mul sym=false goal=7
    #[9] abs (-1 ^ (n + 1) / of_nat (2 * n + 3)) * abs (x ^ (2 * n + 3)) ≤ abs (-1 ^ n / of_nat (2 * n + 1)) * abs (x ^ (2 * n + 1))
  ← rule real_le_mul2 goal=9
    #[10] 0 ≤ abs (-1 ^ (n + 1) / of_nat (2 * n + 3))
    #[11] abs (-1 ^ (n + 1) / of_nat (2 * n + 3)) ≤ abs (-1 ^ n / of_nat (2 * n + 1))
    #[12] 0 ≤ abs (x ^ (2 * n + 3))
    #[13] abs (x ^ (2 * n + 3)) ≤ abs (x ^ (2 * n + 1))
  ← rule real_abs_pos goal=10
    #[14] 0 ≤ abs (-1 ^ (n + 1) / of_nat (2 * n + 3))
  ← rewrite real_abs_div sym=false goal=11
    #[15] abs (-1 ^ (n + 1)) / abs (of_nat (2 * n + 3)) ≤ abs (-1 ^ n) / abs (of_nat (2 * n + 1))
  ← rewrite abs_neg_one_pow sym=false goal=15
    #[16] 1 / abs (of_nat (2 * n + 3)) ≤ 1 / abs (of_nat (2 * n + 1))
  ← rewrite real_divide_def sym=false goal=16
    #[17] 1 * real_inverse (abs (of_nat (2 * n + 3))) ≤ 1 * real_inverse (abs (of_nat (2 * n + 1)))
  ← rewrite real_abs_nat sym=false goal=17
    #[18] 1 * real_inverse (of_nat (2 * n + 3)) ≤ 1 * real_inverse (of_nat (2 * n + 1))
  ← rewrite real_mul_lid sym=false goal=18
    #[19] real_inverse (of_nat (2 * n + 3)) ≤ real_inverse (of_nat (2 * n + 1))
  ← rule real_le_inv2 goal=19
    #[20] (0::real) < of_nat (2 * n + 1)
    #[21] (of_nat::nat ⇒ real) (2 * n + 1) ≤ of_nat (2 * n + 3)
  ← rewrite real_zero_def sym=false goal=20
    #[22] (of_nat::nat ⇒ real) 0 < of_nat (2 * n + 1)
  ← rewrite real_of_nat_lt sym=false goal=22
    #[23] 0 < 2 * n + 1
  ← z3 goal=23
    #[24] 0 < 2 * n + 1
  ← rewrite real_of_nat_le sym=false goal=21
    #[25] 2 * n + 1 ≤ 2 * n + 3
  ← z3 goal=25
    #[26] 2 * n + 1 ≤ 2 * n + 3
  ← rule real_abs_pos goal=12
    #[27] 0 ≤ abs (x ^ (2 * n + 3))
  ← rewrite real_abs_pow sym=false goal=13
    #[28] abs x ^ (2 * n + 3) ≤ abs x ^ (2 * n + 1)
  ← rule real_pow_mono_inv goal=28
    #[29] 0 ≤ abs x
    #[30] abs x ≤ 1
  ← rule real_abs_pos goal=29
    #[31] 0 ≤ abs x
  ← rule real_lt_imp_le goal=30
  cut "∀a. ∀b. ∀c. ∀d. ∀e. ∀f. a / b * c * ((d / e) * f) = a * d * (c * f) / b / e" goal=8
    #[32] ∀a. ∀b. ∀c. ∀d. ∀e. ∀f. a / b * c * (d / e * f) = a * d * (c * f) / b / e
  ← rewrite real_divide_def sym=false goal=32
    #[33] ∀a. ∀b. ∀c. ∀d. ∀e. ∀f. a * real_inverse b * c * (d * real_inverse e * f) = a * d * (c * f) / b * real_inverse e
  ← rewrite real_divide_def sym=false goal=33
    #[34] ∀a. ∀b. ∀c. ∀d. ∀e. ∀f. a * real_inverse b * c * (d * real_inverse e * f) = a * d * (c * f) * real_inverse b * real_inverse e
  ← z3 goal=34
    #[35] ∀a. ∀b. ∀c. ∀d. ∀e. ∀f. a * real_inverse b * c * (d * real_inverse e * f) = a * d * (c * f) * real_inverse b * real_inverse e
  ← rewrite source=prev goal=8 facts=[32]
    #[36] -1 ^ (n + 1) * -1 ^ n * (x ^ (2 * n + 3) * x ^ (2 * n + 1)) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  ← rewrite real_pow_add sym=true goal=36
    #[37] -1 ^ (n + 1 + n) * x ^ (2 * n + 3 + (2 * n + 1)) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  cut "n + 1 + n = 2 * n + 1" goal=37
    #[38] n + 1 + n = 2 * n + 1
  nat_norm goal=38
    #[39] n + 1 + n = 2 * n + 1
  ← rewrite source=prev goal=37 facts=[39]
    #[40] -1 ^ (2 * n + 1) * x ^ (2 * n + 3 + (2 * n + 1)) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  cut "2 * n + 3 + (2 * n + 1) = 2 * (2 * n + 2)" goal=40
    #[41] 2 * n + 3 + (2 * n + 1) = 2 * (2 * n + 2)
  nat_norm goal=41
    #[42] 2 * n + 3 + (2 * n + 1) = 2 * (2 * n + 2)
  ← rewrite source=prev goal=40 facts=[42]
    #[43] -1 ^ (2 * n + 1) * x ^ (2 * (2 * n + 2)) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  ← rewrite real_pow_add sym=false goal=43
    #[44] -1 ^ (2 * n) * -1 ^ (1::nat) * x ^ (2 * (2 * n + 2)) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  ← rewrite real_pow_pow sym=true goal=44
    #[45] -1 ^ (2::nat) ^ n * -1 ^ (1::nat) * x ^ (2::nat) ^ (2 * n + 2) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  ← rewrite real_pow_1 sym=false goal=45
    #[46] -1 ^ (2::nat) ^ n * -1 * x ^ (2::nat) ^ (2 * n + 2) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  ← rewrite real_pow_neg sym=false goal=46
    #[47] (if even 2 then 1 ^ (2::nat) else -(1 ^ (2::nat))) ^ n * -1 * x ^ (2::nat) ^ (2 * n + 2) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  cut "even 2" goal=47
    #[48] even 2
  ← rewrite even_exists sym=false goal=48
    #[49] ∃m::nat. 2 = 2 * m
  ← inst "(1::nat)" goal=49
    #[50] (2::nat) = 2 * 1
  ← rewrite mult_1_right sym=false goal=50
    #[51] (2::nat) = 2 * 1
  ← rewrite if_P sym=false goal=47 facts=[48]
    #[52] 1 ^ (2::nat) ^ n * -1 * x ^ (2::nat) ^ (2 * n + 2) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  ← rewrite real_pow_one sym=false goal=52
    #[53] 1 ^ n * -1 * x ^ (2::nat) ^ (2 * n + 2) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  ← rewrite real_pow_one sym=false goal=53
    #[54] 1 * -1 * x ^ (2::nat) ^ (2 * n + 2) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  ← rewrite real_mul_lid sym=false goal=54
    #[55] -1 * x ^ (2::nat) ^ (2 * n + 2) / of_nat (2 * n + 3) / of_nat (2 * n + 1) ≤ 0
  cut "!a::real. 0 <= a --> -1 * a <= 0" goal=55
    #[56] ∀a::real. 0 ≤ a ⟶ -1 * a ≤ 0
  ← z3 goal=56
    #[57] ∀a::real. 0 ≤ a ⟶ -1 * a ≤ 0
  ← rewrite real_divide_def sym=false goal=55
    #[58] -1 * x ^ (2::nat) ^ (2 * n + 2) / of_nat (2 * n + 3) * real_inverse (of_nat (2 * n + 1)) ≤ 0
  ← rewrite real_divide_def sym=false goal=58
    #[59] -1 * x ^ (2::nat) ^ (2 * n + 2) * real_inverse (of_nat (2 * n + 3)) * real_inverse (of_nat (2 * n + 1)) ≤ 0
  ← rewrite real_mult_assoc sym=true goal=59
    #[60] -1 * x ^ (2::nat) ^ (2 * n + 2) * (real_inverse (of_nat (2 * n + 3)) * real_inverse (of_nat (2 * n + 1))) ≤ 0
  ← rewrite real_mult_assoc sym=true goal=60
    #[61] -1 * (x ^ (2::nat) ^ (2 * n + 2) * (real_inverse (of_nat (2 * n + 3)) * real_inverse (of_nat (2 * n + 1)))) ≤ 0
  ← apply_prev goal=61 facts=[57]
    #[62] 0 ≤ x ^ (2::nat) ^ (2 * n + 2) * (real_inverse (of_nat (2 * n + 3)) * real_inverse (of_nat (2 * n + 1)))
  ← rule real_le_mul goal=62
    #[63] 0 ≤ x ^ (2::nat) ^ (2 * n + 2)
    #[64] 0 ≤ real_inverse (of_nat (2 * n + 3)) * real_inverse (of_nat (2 * n + 1))
  ← rule real_pow_le goal=63
    #[65] 0 ≤ x ^ (2::nat)
  ← rule real_le_pow_2 goal=65
    #[66] 0 ≤ x ^ (2::nat)
  ← rule real_le_mul goal=64
    #[67] 0 ≤ real_inverse (of_nat (2 * n + 3))
    #[68] 0 ≤ real_inverse (of_nat (2 * n + 1))
  ← rule real_lt_imp_le goal=67
    #[69] 0 < real_inverse (of_nat (2 * n + 3))
  ← rule real_lt_inv goal=69
    #[70] (0::real) < of_nat (2 * n + 3)
  ← rewrite real_zero_def sym=false goal=70
    #[71] (of_nat::nat ⇒ real) 0 < of_nat (2 * n + 3)
  ← rewrite real_of_nat_lt sym=false goal=71
    #[72] 0 < 2 * n + 3
  ← z3 goal=72
    #[73] 0 < 2 * n + 3
  ← rule real_lt_imp_le goal=68
    #[74] 0 < real_inverse (of_nat (2 * n + 1))
  ← rule real_lt_inv goal=74
  ← rule real_series_terms_tozero param_l="atn x" param_n="(0::nat)" goal=4
    #[75] real_sums (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) (atn x) (from 0)
  ← rewrite from_0 sym=false goal=75
    #[76] real_sums (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) (atn x) univ
  ← rule atn_series goal=76
qed

theorem atn_poly_bound
  fixes n :: nat, x :: real
  prop abs x < 1 --> abs (atn x - sum ({0..n}) (%i. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) <= abs x ^ (2 * n + 3) / of_nat (2 * n + 3)
  [hint_backward]
proof
  ← intro goal=0
    #[1] abs x < 1
    #[2] abs (atn x - sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs x ^ (2 * n + 3) / of_nat (2 * n + 3)
  → forward alt_sign_abs_bound param_f="(λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))" param_k=n+1 param_m="(0::nat)" goal=2
    #[3] (∀n1. abs (-1 ^ (n1 + 1) / of_nat (2 * (n1 + 1) + 1) * x ^ (2 * (n1 + 1) + 1)) ≤ abs (-1 ^ n1 / of_nat (2 * n1 + 1) * x ^ (2 * n1 + 1)) ∧ -1 ^ (n1 + 1) / of_nat (2 * (n1 + 1) + 1) * x ^ (2 * (n1 + 1) + 1) * (-1 ^ n1 / of_nat (2 * n1 + 1) * x ^ (2 * n1 + 1)) ≤ 0) ⟶ tendsto_real (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) 0 sequentially ⟶ 0 < n + 1 ⟶ abs (real_infsum (from 0) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) - sum ({0..n + 1 - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs (-1 ^ (n + 1) / of_nat (2 * (n + 1) + 1) * x ^ (2 * (n + 1) + 1))
  → forward atn_series_alt_sign goal=2 facts=[1]
    #[4] (∀n. abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3)) ≤ abs (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ∧ -1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3) * (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ≤ 0) ∧ tendsto_real (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) 0 sequentially
  → forward conjD1 goal=2 facts=[4]
    #[5] ∀n. abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3)) ≤ abs (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ∧ -1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3) * (-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)) ≤ 0
  → forward conjD2 goal=2 facts=[4]
    #[6] tendsto_real (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) 0 sequentially
  cut "!n::nat. 2 * (n + 1) + 1 = 2 * n + 3" goal=2
    #[7] ∀n::nat. 2 * (n + 1) + 1 = 2 * n + 3
  ← z3 goal=7
    #[8] ∀n::nat. 2 * (n + 1) + 1 = 2 * n + 3
  → rewrite target=fact source=prev goal=2 facts=[8,3]
    #[9] (∀n1. abs (-1 ^ (n1 + 1) / of_nat (2 * n1 + 3) * x ^ (2 * n1 + 3)) ≤ abs (-1 ^ n1 / of_nat (2 * n1 + 1) * x ^ (2 * n1 + 1)) ∧ -1 ^ (n1 + 1) / of_nat (2 * n1 + 3) * x ^ (2 * n1 + 3) * (-1 ^ n1 / of_nat (2 * n1 + 1) * x ^ (2 * n1 + 1)) ≤ 0) ⟶ tendsto_real (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) 0 sequentially ⟶ 0 < n + 1 ⟶ abs (real_infsum (from 0) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) - sum ({0..n + 1 - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3))
  cut "0 < n + 1" goal=2
    #[10] 0 < n + 1
  ← z3 goal=10
    #[11] 0 < n + 1
  → forward goal=2 facts=[9,5,6,11]
    #[12] abs (real_infsum (from 0) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) - sum ({0..n + 1 - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3))
  → forward atn_infsum goal=2 facts=[1]
    #[13] real_infsum (from 0) (λk. -1 ^ k / of_nat (2 * k + 1) * x ^ (2 * k + 1)) = atn x
  → rewrite target=fact source=prev goal=2 facts=[13,12]
    #[14] abs (atn x - sum ({0..n + 1 - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3))
  → rewrite target=fact nat_plus_minus sym=false goal=2 facts=[14]
    #[15] abs (atn x - sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs (-1 ^ (n + 1) / of_nat (2 * n + 3) * x ^ (2 * n + 3))
  → rewrite target=fact real_abs_mul sym=false goal=2 facts=[15]
    #[16] abs (atn x - sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs (-1 ^ (n + 1) / of_nat (2 * n + 3)) * abs (x ^ (2 * n + 3))
  → rewrite target=fact real_abs_div sym=false goal=2 facts=[16]
    #[17] abs (atn x - sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs (-1 ^ (n + 1)) / abs (of_nat (2 * n + 3)) * abs (x ^ (2 * n + 3))
  → rewrite target=fact abs_neg_one_pow sym=false goal=2 facts=[17]
    #[18] abs (atn x - sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ 1 / abs (of_nat (2 * n + 3)) * abs (x ^ (2 * n + 3))
  → rewrite target=fact real_abs_nat sym=false goal=2 facts=[18]
    #[19] abs (atn x - sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ 1 / of_nat (2 * n + 3) * abs (x ^ (2 * n + 3))
  → rewrite target=fact real_abs_pow sym=false goal=2 facts=[19]
    #[20] abs (atn x - sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ 1 / of_nat (2 * n + 3) * abs x ^ (2 * n + 3)
  cut "!a::real. !b. 1 / a * b = b / a" goal=2
    #[21] ∀a. ∀b. 1 / a * b = b / a
  ← rewrite real_divide_def sym=false goal=21
    #[22] ∀a. ∀b. 1 * real_inverse a * b = b * real_inverse a
  ← z3 goal=22
    #[23] ∀a. ∀b. 1 * real_inverse a * b = b * real_inverse a
  → rewrite target=fact source=prev goal=2 facts=[21,20]
qed

theorem atn_poly_pos_upper_bound
  fixes n :: nat, x :: real
  prop even n --> 0 <= x --> x < 1 --> atn x <= sum ({0..n}) (%i. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] even n
    #[2] 0 ≤ x
    #[3] x < 1
    #[4] atn x ≤ sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))
  cut "abs x < 1" goal=4
    #[5] abs x < 1
  ← z3 goal=5 facts=[2,3]
    #[6] abs x < 1
  ← cases "n=0" goal=4
    #[7] n = 0 ⟶ atn x ≤ sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))
    #[8] ¬(n = 0) ⟶ atn x ≤ sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))
  ← intro goal=7
    #[9] n = 0
    #[10] atn x ≤ sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))
  ← rewrite source=prev goal=10 facts=[9]
    #[11] atn x ≤ sum ({0..0}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))
  ← rewrite sum_sing_natseg sym=false goal=11
    #[12] atn x ≤ -1 ^ (0::nat) / of_nat (2 * 0 + 1) * x ^ ((2::nat) * 0 + 1)
  ← rewrite real_nat_power_def_1 sym=false goal=12
    #[13] atn x ≤ 1 / of_nat (2 * 0 + 1) * x ^ ((2::nat) * 0 + 1)
  ← rewrite mult_0_right sym=false goal=13
    #[14] atn x ≤ 1 / of_nat (0 + 1) * x ^ ((0::nat) + 1)
  ← rewrite nat_plus_def_1 sym=false goal=14
    #[15] atn x ≤ 1 / of_nat 1 * x ^ (1::nat)
  ← rewrite real_pow_1 sym=false goal=15
    #[16] atn x ≤ 1 / of_nat 1 * x
  ← rewrite real_one_def sym=true goal=16
    #[17] atn x ≤ 1 / 1 * x
  ← rewrite real_div_1 sym=false goal=17
    #[18] atn x ≤ 1 * x
  ← rewrite real_mul_lid sym=false goal=18
    #[19] atn x ≤ x
  ← rule atn_le_x goal=19
  ← intro goal=8
    #[20] ¬(n = 0)
    #[21] atn x ≤ sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))
  → forward atn_poly_bound param_n=n-1 param_x=x goal=21
    #[22] abs x < 1 ⟶ abs (atn x - sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  → forward goal=21 facts=[22,6]
    #[23] abs (atn x - sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  cut "0 < n" goal=21
    #[24] 0 < n
  ← rule le_1_1 goal=24 facts=[20]
    #[25] 0 < n
  → forward lt_imp_le goal=21 facts=[25]
    #[26] 0 ≤ n
  → forward sum_clauses_right param_f="(λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))" goal=21 facts=[25,26]
    #[27] sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) = sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) + -1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)
  ← rewrite source=prev goal=21 facts=[27]
    #[28] atn x ≤ sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) + -1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)
  cut "-1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1) = abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)" goal=28
    #[29] -1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1) = abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  ← rewrite real_pow_neg sym=false goal=29
    #[30] (if even n then 1 ^ n else -(1 ^ n)) / of_nat (2 * n + 1) * x ^ (2 * n + 1) = abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  ← rewrite if_P sym=false goal=30 facts=[1]
    #[31] 1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1) = abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  ← rewrite real_pow_one sym=false goal=31
    #[32] 1 / of_nat (2 * n + 1) * x ^ (2 * n + 1) = abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  cut "2 * (n - 1) + 3 = 2 * n + 1" goal=32
    #[33] 2 * (n - 1) + 3 = 2 * n + 1
  ← z3 goal=33 facts=[20]
    #[34] 2 * (n - 1) + 3 = 2 * n + 1
  ← rewrite source=prev goal=32 facts=[34]
    #[35] 1 / of_nat (2 * n + 1) * x ^ (2 * n + 1) = abs x ^ (2 * n + 1) / of_nat (2 * n + 1)
  cut "abs x = x" goal=35 facts=[2]
    #[36] abs x = x
  ← z3 goal=36 facts=[2]
    #[37] abs x = x
  ← rewrite source=prev goal=35 facts=[37]
    #[38] 1 / of_nat (2 * n + 1) * x ^ (2 * n + 1) = x ^ (2 * n + 1) / of_nat (2 * n + 1)
  ← rewrite real_divide_def sym=false goal=38
    #[39] 1 * real_inverse (of_nat (2 * n + 1)) * x ^ (2 * n + 1) = x ^ (2 * n + 1) * real_inverse (of_nat (2 * n + 1))
  real_norm goal=39
    #[40] 1 * real_inverse (of_nat (2 * n + 1)) * x ^ (2 * n + 1) = x ^ (2 * n + 1) * real_inverse (of_nat (2 * n + 1))
  ← rewrite source=prev goal=28 facts=[29]
    #[41] atn x ≤ sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) + abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  cut "∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ a ≤ b + c" goal=41
    #[42] ∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ a ≤ b + c
  ← z3 goal=42
    #[43] ∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ a ≤ b + c
  ← apply_prev goal=41 facts=[43]
qed

theorem atn_poly_pos_lower_bound
  fixes n :: nat, x :: real
  prop odd n --> 0 <= x --> x < 1 --> sum ({0..n}) (%i. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) <= atn x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] odd n
    #[2] 0 ≤ x
    #[3] x < 1
    #[4] sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) ≤ atn x
  cut "abs x < 1" goal=4
    #[5] abs x < 1
  ← z3 goal=5 facts=[2,3]
    #[6] abs x < 1
  cut "~(n=0)" goal=4
    #[7] ¬(n = 0)
  ← rule contrapositive goal=7 facts=[1]
    #[8] ¬¬(n = 0) ⟶ ¬(odd n)
  ← rewrite double_neg sym=false goal=8
    #[9] n = 0 ⟶ ¬(odd n)
  ← intro goal=9
    #[10] n = 0
    #[11] ¬(odd n)
  ← rewrite source=prev goal=11 facts=[10]
    #[12] ¬(odd 0)
  ← rewrite odd_def_1 sym=false goal=12
    #[13] ¬false
  ← z3 goal=13
    #[14] ¬false
  → forward atn_poly_bound param_n=n-1 param_x=x goal=4
    #[15] abs x < 1 ⟶ abs (atn x - sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  → forward goal=4 facts=[15,6]
    #[16] abs (atn x - sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))) ≤ abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)
  cut "0 < n" goal=4
    #[17] 0 < n
  ← rule le_1_1 goal=17 facts=[7]
  → forward lt_imp_le goal=4 facts=[17]
    #[18] 0 ≤ n
  → forward sum_clauses_right param_f="(λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1))" goal=4 facts=[17,18]
    #[19] sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) = sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) + -1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1)
  ← rewrite source=prev goal=4 facts=[19]
    #[20] sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) + -1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1) ≤ atn x
  cut "-1 ^ n / of_nat(2 * n + 1) * x ^ (2 * n + 1) = -(abs x ^ (2 * (n - 1) + 3) / of_nat(2 * (n - 1) + 3))" goal=20
    #[21] -1 ^ n / of_nat (2 * n + 1) * x ^ (2 * n + 1) = -(abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3))
  ← rewrite real_pow_neg sym=false goal=21
    #[22] (if even n then 1 ^ n else -(1 ^ n)) / of_nat (2 * n + 1) * x ^ (2 * n + 1) = -(abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3))
  → rewrite target=fact not_even sym=true goal=22 facts=[1]
    #[23] ¬(even n)
  ← rewrite if_not_P sym=false goal=22 facts=[23]
    #[24] -(1 ^ n) / of_nat (2 * n + 1) * x ^ (2 * n + 1) = -(abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3))
  ← rewrite real_pow_one sym=false goal=24
    #[25] -1 / of_nat (2 * n + 1) * x ^ (2 * n + 1) = -(abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3))
  cut "abs x = x" goal=25
    #[26] abs x = x
  ← z3 goal=26 facts=[2]
    #[27] abs x = x
  ← rewrite source=prev goal=25 facts=[27]
    #[28] -1 / of_nat (2 * n + 1) * x ^ (2 * n + 1) = -(x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3))
  cut "2 * (n - 1) + 3 = 2 * n + 1" goal=28
    #[29] 2 * (n - 1) + 3 = 2 * n + 1
  ← z3 goal=29 facts=[7]
  ← rewrite source=prev goal=28 facts=[29]
    #[30] -1 / of_nat (2 * n + 1) * x ^ (2 * n + 1) = -(x ^ (2 * n + 1) / of_nat (2 * n + 1))
  ← rewrite real_divide_def sym=false goal=30
    #[31] -1 * real_inverse (of_nat (2 * n + 1)) * x ^ (2 * n + 1) = -(x ^ (2 * n + 1) * real_inverse (of_nat (2 * n + 1)))
  real_norm goal=31
    #[32] -1 * real_inverse (of_nat (2 * n + 1)) * x ^ (2 * n + 1) = -(x ^ (2 * n + 1) * real_inverse (of_nat (2 * n + 1)))
  ← rewrite source=prev goal=20 facts=[21]
    #[33] sum ({0..n - 1}) (λi. -1 ^ i / of_nat (2 * i + 1) * x ^ (2 * i + 1)) + -(abs x ^ (2 * (n - 1) + 3) / of_nat (2 * (n - 1) + 3)) ≤ atn x
  cut "!a::real. !b. !c. abs (a-b)<= c --> b + -c <= a" goal=33
    #[34] ∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ b + -c ≤ a
  ← z3 goal=34
    #[35] ∀a::real. ∀b. ∀c. abs (a - b) ≤ c ⟶ b + -c ≤ a
  ← apply_prev goal=33 facts=[35]
qed

theorem atn_halfatn4_pos_upper_bound
  fixes n :: nat, x :: real
  prop even n --> 0 <= x --> atn (halfatn4 x) <= sum ({0..n}) (%i. -1 ^ i / of_nat (2 * i + 1) * halfatn4 x ^ (2 * i + 1))
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] even n
    #[2] 0 ≤ x
    #[3] atn (halfatn4 x) ≤ sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * halfatn4 x ^ (2 * i + 1))
  ← rule atn_poly_pos_upper_bound goal=3
    #[4] 0 ≤ halfatn4 x
    #[5] halfatn4 x < 1
  ← rule halfatn4_pos goal=4
  cut "!x. abs x < real_inverse 8 ⟶ x < 1" goal=5
    #[6] ∀x. abs x < real_inverse 8 ⟶ x < 1
  ← z3 goal=6
    #[7] ∀x. abs x < real_inverse 8 ⟶ x < 1
  ← apply_prev goal=5 facts=[7]
    #[8] abs (halfatn4 x) < real_inverse 8
  ← rule halfatn4_bound goal=8
    #[9] abs (halfatn4 x) < real_inverse 8
qed

theorem atn_halfatn4_pos_lower_bound
  fixes n :: nat, x :: real
  prop odd n --> 0 <= x --> sum ({0..n}) (%i. -1 ^ i / of_nat (2 * i + 1) * halfatn4 x ^ (2 * i + 1)) <= atn (halfatn4 x)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] odd n
    #[2] 0 ≤ x
    #[3] sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * halfatn4 x ^ (2 * i + 1)) ≤ atn (halfatn4 x)
  ← rule atn_poly_pos_lower_bound goal=3
    #[4] 0 ≤ halfatn4 x
    #[5] halfatn4 x < 1
  ← rule halfatn4_pos goal=4
  cut "!x. abs x < real_inverse (8) --> x < 1" goal=5
    #[6] ∀x. abs x < real_inverse 8 ⟶ x < 1
  ← z3 goal=6
    #[7] ∀x. abs x < real_inverse 8 ⟶ x < 1
  ← apply_prev goal=5 facts=[7]
    #[8] abs (halfatn4 x) < real_inverse 8
  ← rule halfatn4_bound goal=8
    #[9] abs (halfatn4 x) < real_inverse 8
qed

theorem real_taylor_atn_halfatn4
  fixes n :: nat, x :: real
  prop abs (atn (halfatn4 x) - sum ({0..n}) (%j. -1 ^ j * halfatn4 x ^ (2 * j + 1) / of_nat (2 * j + 1))) <= real_inverse (8 ^ (2 * n + 3) * of_nat (2 * n + 3))
  [hint_backward]
proof
  → forward halfatn4_bound param_x=x goal=0
    #[1] abs (halfatn4 x) < real_inverse 8
  ← rule real_le_trans param_y="abs (halfatn4 x) ^ (2 * n + 3) / of_nat(2 * n + 3)" goal=0
    #[2] abs (atn (halfatn4 x) - sum ({0..n}) (λj. -1 ^ j * halfatn4 x ^ (2 * j + 1) / of_nat (2 * j + 1))) ≤ abs (halfatn4 x) ^ (2 * n + 3) / of_nat (2 * n + 3)
    #[3] abs (halfatn4 x) ^ (2 * n + 3) / of_nat (2 * n + 3) ≤ real_inverse (8 ^ (2 * n + 3) * of_nat (2 * n + 3))
  cut "abs (halfatn4 x) < 1" goal=2
    #[4] abs (halfatn4 x) < 1
  ← rule real_lt_trans param_y="real_inverse 8" goal=4
    #[5] real_inverse 8 < 1
  ← z3 goal=5
  → forward atn_poly_bound param_n=n goal=2 facts=[4]
    #[6] abs (atn (halfatn4 x) - sum ({0..n}) (λi. -1 ^ i / of_nat (2 * i + 1) * halfatn4 x ^ (2 * i + 1))) ≤ abs (halfatn4 x) ^ (2 * n + 3) / of_nat (2 * n + 3)
  cut "!a::real. !b. !c. a * b / c = a / c * b" goal=2
    #[7] ∀a. ∀b. ∀c. a * b / c = a / c * b
  ← rewrite real_divide_def sym=false goal=7
    #[8] ∀a. ∀b. ∀c. a * b * real_inverse c = a * real_inverse c * b
  ← z3 goal=8
  ← rewrite source=prev goal=2 facts=[7]
  ← rewrite real_inv_mul sym=false goal=3
    #[9] abs (halfatn4 x) ^ (2 * n + 3) / of_nat (2 * n + 3) ≤ real_inverse (8 ^ (2 * n + 3)) * real_inverse (of_nat (2 * n + 3))
  ← rewrite real_divide_def sym=false goal=9
    #[10] abs (halfatn4 x) ^ (2 * n + 3) * real_inverse (of_nat (2 * n + 3)) ≤ real_inverse (8 ^ (2 * n + 3)) * real_inverse (of_nat (2 * n + 3))
  ← rewrite real_mult_comm sym=false goal=10
    #[11] real_inverse (of_nat (2 * n + 3)) * abs (halfatn4 x) ^ (2 * n + 3) ≤ real_inverse (of_nat (2 * n + 3)) * real_inverse (8 ^ (2 * n + 3))
  ← rule real_le_lmul goal=11
    #[12] 0 ≤ real_inverse (of_nat (2 * n + 3))
    #[13] abs (halfatn4 x) ^ (2 * n + 3) ≤ real_inverse (8 ^ (2 * n + 3))
  ← rule real_lt_imp_le goal=12
    #[14] 0 < real_inverse (of_nat (2 * n + 3))
  ← rule real_lt_inv goal=14
    #[15] (0::real) < of_nat (2 * n + 3)
  ← rewrite real_zero_def sym=false goal=15
    #[16] (of_nat::nat ⇒ real) 0 < of_nat (2 * n + 3)
  ← rewrite real_of_nat_lt sym=false goal=16
    #[17] 0 < 2 * n + 3
  ← z3 goal=17
  ← rewrite real_pow_inv sym=true goal=13
    #[18] abs (halfatn4 x) ^ (2 * n + 3) ≤ real_inverse 8 ^ (2 * n + 3)
  ← rule real_pow_le2 goal=18
    #[19] 0 ≤ abs (halfatn4 x)
    #[20] abs (halfatn4 x) ≤ real_inverse 8
  ← rule real_abs_pos goal=19
  ← rule real_lt_imp_le goal=20
qed

