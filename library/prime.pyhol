theorem prime_factorization
  fixes n :: nat
  prop ¬(n = 0) ⟶ nproduct ({p. prime p ∧ divides p n}) (λp. p ^ index p n) = n
  [hint_backward]
  proof
    1: apply_forward_step prime_factorization_alt @0
    2: cut "nproduct ({p. prime p}) (λp. p ^ index p n) = nproduct ({p. prime p ∧ divides p n}) (λp. p ^ index p n)"
    2: apply_backward_step nproduct_superset
    2: apply_backward_step subsetI
    2: rewrite_goal member_collect sym=false
    2: introduction p
    2.2: apply_backward_step conjD1 @2.1
    5: rewrite_goal member_collect sym=false
    5: introduction p
    5.3: rewrite_goal exp_eq_1 sym=false
    5.3: rewrite_goal index_eq_0 sym=false
    5.3: apply_backward_step disjI2
    5.3: apply_backward_step disjI2
    5.3: apply_backward_step disjI2
    5.3: apply_backward_step contrapositive @5.2
    5.3: rewrite_goal double_neg sym=false
    5.3: introduction
    5.3.1: apply_backward_step conjI
    8: rewrite_fact_with_prev @7,1
  qed

theorem induct_coprime
  fixes P :: nat ⇒ bool
  prop (∀a. ∀b. 1 < a ⟶ 1 < b ⟶ coprime a b ⟶ P a ⟶ P b ⟶ P (a * b)) ⟶ (∀p. ∀k::nat. prime p ⟶ P (p ^ k)) ⟶ (∀n. 1 < n ⟶ P n)
  [hint_backward,hint_backward1]
  proof
    2: apply_backward_step nat_WF
    2: introduction n
    2.3: cut "~(n=1)"
    2.3: z3 @2.2
    2.4: apply_forward_step prime_factor @2.3
    2.5: exists_elim p @2.4
    2.7: apply_forward_step conjD1 @2.6
    2.8: apply_forward_step conjD2 @2.6
    2.9: cut "~(n=0)"
    2.9: z3 @2.2
    2.10: apply_forward_step prime_ge_2 @2.7
    2.11: apply_forward_step factorization_index @2.9,2.10
    2.12: exists_elim k @2.11
    2.14: apply_forward_step conjD1 @2.13
    2.15: apply_forward_step conjD2 @2.13
    2.16: rewrite_fact divides_def @2.14 sym=false
    2.17: exists_elim m @2.16
    2.19: cases "m=1"
    2.19: introduction
    2.19.1: rewrite_fact_with_prev @2.19.0,2.18
    2.19.2: rewrite_fact mult_1_right @2.19.1 sym=false
    2.19.3: rewrite_goal_with_prev @2.19.2
    2.19.3: apply_prev @1
    2.20: introduction
    2.20.1: rewrite_goal_with_prev @2.18
    2.20.1: apply_prev @0
    2.20.1: cut "~(k=0)"
    2.20.1: apply_backward_step negI
    2.20.1: introduction
    2.20.1.1: rewrite_fact_with_prev @2.20.1.0,2.15
    2.20.1.2: forall_elim "(1::nat)" @2.20.1.1
    2.20.1.3: rewrite_fact exp_1 @2.20.1.2 sym=false
    2.20.1.4: apply_backward_step contrapositive @2.8
    2.20.1.4: introduction
    2.20.1.4.1: apply_prev @2.20.1.3
    2.20.1.4.1: z3
    2.20.3: rewrite_fact_with_prev @2.18,2.2
    2.20.4: cut "!x::nat. 1 < x <--> ~(x = 0) & ~(x = 1)"
    2.20.4: z3
    2.20.5: rewrite_fact_with_prev @2.20.4,2.20.3
    2.20.6: apply_forward_step conjD1 @2.20.5
    2.20.7: rewrite_fact mult_eq_0 @2.20.6 sym=false
    2.20.8: rewrite_fact de_morgan_thm2 @2.20.7 sym=false
    2.20.9: apply_forward_step conjD1 @2.20.8
    2.20.10: apply_forward_step conjD2 @2.20.8
    2.20.11: rewrite_goal_with_prev @2.20.4
    2.20.11: apply_backward_step conjI
    2.20.11: rewrite_goal exp_eq_1 sym=false
    2.20.11: rewrite_goal de_morgan_thm2 sym=false
    2.20.11: apply_backward_step conjI
    2.20.11: z3 @2.10
    2.20.17: rewrite_goal_with_prev @2.20.4
    2.20.17: apply_backward_step conjI
    2.20.19: rewrite_goal coprime_sym sym=false
    2.20.19: apply_backward_step coprime_exp
    2.20.19: apply_forward_step prime_coprime @2.7 param_n=m
    2.20.20: rewrite_goal coprime_sym sym=false
    2.20.20: apply_backward_step disjE @2.20.19
    2.20.20: introduction
    2.20.20.1: apply_backward_step negE_gen @2.20.0,2.20.20.0
    2.20.21: introduction
    2.20.21.1: apply_backward_step disjE @2.20.21.0
    2.20.21.1: introduction
    2.20.21.1.1: forall_elim k+1 @2.15
    2.20.21.1.2: cut "k < k + 1"
    2.20.21.1.2: z3
    2.20.21.1.3: apply_fact @2.20.21.1.1,2.20.21.1.2
    2.20.21.1.4: rewrite_fact nat_power_add @2.20.21.1.3 sym=false
    2.20.21.1.5: rewrite_fact exp_1 @2.20.21.1.4 sym=false
    2.20.21.1.6: apply_backward_step negE_gen @2.20.21.1.5
    2.20.21.1.6: rewrite_goal_with_prev @2.18
    2.20.21.1.6: apply_backward_step divides_mult_left @2.20.21.1.0
    2.20.26: apply_prev @1
    2.20.27: apply_prev @2.1
    2.20.27: rewrite_goal_with_prev @2.18
    2.20.27: apply_backward_step let_trans param_m="1 * m"
    2.20.27: rewrite_goal mult_1_left sym=false
    2.20.27: apply_backward_step less_eq_refl
    2.20.29: rewrite_goal lt_mult_rcancel sym=false
    2.20.29: apply_backward_step conjI
  qed

theorem induct_coprime_strong
  fixes P :: nat ⇒ bool
  prop (∀a. ∀b. 1 < a ⟶ 1 < b ⟶ coprime a b ⟶ P a ⟶ P b ⟶ P (a * b)) ⟶ (∀p. ∀k::nat. prime p ⟶ ¬(k = 0) ⟶ P (p ^ k)) ⟶ (∀n. 1 < n ⟶ P n)
  [hint_backward,hint_backward1]
  proof
    2: cut "∀n. 1 < n ⟶ 1 < n ⟶ P n"
    2: apply_backward_step induct_coprime
    2: introduction a,b
    2.8: apply_prev @0
    2.8: apply_prev @2.5
    2.9: apply_prev @2.6
    3: introduction p,k
    3.4: apply_prev @1
    3.4: apply_backward_step contrapositive @3.3
    3.4: rewrite_goal double_neg sym=false
    3.4: introduction
    3.4.1: rewrite_goal_with_prev @3.4.0
    3.4.1: rewrite_goal nat_nat_power_def_1 sym=false
    3.4.1: rewrite_goal not_lt sym=false
    3.4.1: apply_backward_step less_eq_refl
    5: introduction n
    5.2: apply_prev @4
  qed

theorem induct_coprime_alt
  fixes P :: nat ⇒ bool
  prop P 0 ⟶ (∀a. ∀b. 1 < a ⟶ 1 < b ⟶ coprime a b ⟶ P a ⟶ P b ⟶ P (a * b)) ⟶ (∀p. ∀k::nat. prime p ⟶ P (p ^ k)) ⟶ (∀n. P n)
  [hint_backward,hint_backward1]
  proof
    3: cut "(∀n. 1 < n ⟶ P n)"
    3: apply_backward_step induct_coprime
    4: cut "∀n. ~(1 < n) ⟶ P n"
    4: introduction n
    4.2: cut "n = 0 | n=1"
    4.2: z3 @4.1
    4.3: apply_backward_step disjE @4.2
    4.3: introduction
    4.3.1: rewrite_goal_with_prev @4.3.0
    4.4: introduction
    4.4.1: rewrite_goal_with_prev @4.4.0
    4.4.1: forall_elim "(2::nat)" @2
    4.4.2: forall_elim "(0::nat)" @4.4.1
    4.4.3: rewrite_fact nat_nat_power_def_1 @4.4.2 sym=false
    4.4.4: apply_prev @4.4.3
    4.4.4: apply_backward_step prime_2
    5: z3 @3,4
  qed
