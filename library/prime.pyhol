    7.13.2: introduction
    7.13.2.1: apply_forward_step conjD1 @7.13.2.0
    7.13.2.2: apply_forward_step conjD2 @7.13.2.0
    7.13.2.3: apply_forward_step conjD1 @7.13.2.1
    7.13.2.4: apply_backward_step conjI
    7.15: rewrite_goal_with_prev @7.14
    9: rewrite_goal_with_prev @8
    9: apply_forward_step nsum_swap param_f="(λj::nat. %i. if divides (p ^ j) i then (1::nat) else 0)" param_s="{j::nat. 1 ≤ j ∧ p ^ j ≤ n}" param_t={1..n}
    10: cut "finite ({j::nat. 1 ≤ j ∧ p ^ j ≤ n})"
    10: apply_backward_step finite_exp_le
