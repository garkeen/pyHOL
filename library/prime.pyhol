theorem prime_factorization_alt
  fixes n :: nat
  prop ¬(n = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p n) = n
  [hint_backward]
  proof
    1: cut "!n. ¬(n = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p n) = n"
    1: apply_backward_step complete_factor_induct
    1: introduction
    1.1: apply_backward_step negE_gen @1.0
    1.1: apply_backward_step eq_refl
    2: introduction
    2.1: rewrite_goal index_1 sym=false
    2.1: rewrite_goal nat_nat_power_def_1 sym=false
    2.1: rewrite_goal nproduct_one sym=false
    3: introduction p
    3.3: apply_forward_step index_prime @3.1 param_a=""
    3.4: rewrite_goal_with_prev @3.3
    3.4: cut "∀p1. p1 ^ (if p = p1 then (1::nat) else 0) = (if p1 = p then p else 1)"
    3.4: introduction x
    3.4.1: cases "p = x"
    3.4.1: introduction
    3.4.1.1: rewrite_goal if_P @3.4.1.0 sym=false
