    16.6: rewrite_goal mult_comm sym=false
    16.7: rewrite_goal mult_comm sym=false
    16.16: apply_backward_step divides_trans param_m=k2
    16.16: apply_backward_step gcd_divides2
    16.17: rewrite_goal_with_prev @8
    16.17: apply_backward_step divides_lmul
    16.17: apply_backward_step divides_self
    16.22: apply_backward_step gcd_is_max
    16.22: apply_backward_step divides_lmul
    16.22: apply_backward_step gcd_divide1
    16.24: apply_backward_step divides_cmul2 param_c="gcd a c"
