    3.14.3.5.3: rewrite_goal_with_prev @3.14.3.5.2
    3.14.3.6: introduction
    3.14.3.6.1: apply_prev @3.12
    3.15: introduction
    3.15.1: inst_exists_goal n1
    3.15.1: inst_exists_goal p*n2
    3.15.1: apply_backward_step conjI
    3.15.1: rewrite_fact eq_sym_eq @3.10 sym=false
