theorem primepow_factor
  fixes n :: nat
  prop 2 ≤ n ⟶ (∃p. ∃k::nat. ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m)
  [hint_backward,hint_backward1]
  proof
    1: apply_forward_step prime_factor param_n=n
    2: cut "¬(n = 1)"
    2: z3 @0
    3: apply_fact @1,2
    4: exists_elim p @3
    6: inst_exists_goal p
    6: apply_forward_step factorization_index param_n=n param_p=p
    7: cut "¬(n = 0)"
    7: z3 @0
    8: apply_fact @6,7
    9: apply_forward_step conjD1 @5
    10: apply_forward_step conjD2 @5
    11: apply_forward_step prime_ge_2 @9
    12: apply_fact @8,11
    13: exists_elim k @12
    15: inst_exists_goal k
    15: apply_forward_step conjD1 @14
    16: apply_forward_step conjD2 @14
    17: rewrite_fact divides_def @15 sym=false
    18: exists_elim m @17
    20: inst_exists_goal m
    20: apply_backward_step conjI
    20: apply_backward_step conjI
    20: forall_elim k+1 @16
    21: cut "k < k + 1"
    21: z3
    22: apply_fact @20,21
    23: rewrite_fact nat_power_add @22 sym=false
    24: rewrite_fact exp_1 @23 sym=false
    25: apply_backward_step le_1_2
    25: apply_backward_step contrapositive @24
    25: rewrite_goal double_neg sym=false
    25: introduction
    25.1: rewrite_goal_with_prev @25.0
    25.1: rewrite_goal nat_nat_power_def_1 sym=false
    25.1: rewrite_goal mult_1_left sym=false
    29: apply_backward_step conjI
    29: apply_forward_step prime_coprime_strong @9 param_n=m
    30: apply_backward_step disjE @29
    30: introduction
    30.1: rewrite_fact_with_prev @19,24
    30.2: apply_backward_step negE_gen @30.1
    30.2: apply_backward_step divides_mult_left
  qed

