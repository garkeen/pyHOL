theorem prime_power_mult
  fixes k :: nat, p :: nat, x :: nat, y :: nat
  prop prime p ⟶ x * y = p ^ k ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j)
  [hint_backward,hint_backward1]
  proof
    2: cut "!x. !y. x * y = p ^ k ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j)"
    2: induction k nat_induct
    2: introduction x1,y1
    2.3: rewrite_fact nat_nat_power_def_1 @2.2 sym=false
    2.4: rewrite_fact mult_eq_1 @2.3 sym=false
    2.5: inst_exists_goal "(0::nat)"
    2.5: inst_exists_goal "(0::nat)"
    2.5: rewrite_goal nat_nat_power_def_1 sym=false
    3: introduction k1
    3.2: introduction x1,y1
    3.2.3: rewrite_fact nat_nat_power_def_2 @3.2.2 sym=false
    3.2.4: cut "divides p x1 | divides p y1"
    3.2.4: apply_backward_step prime_divprod @0
    3.2.4: rewrite_goal_with_prev @3.2.3
    3.2.4: apply_backward_step divides_rmul
    3.2.4: apply_backward_step divides_self
    3.2.8: rewrite_fact divides_def @3.2.7 sym=false
    3.2.9: cut "~(p=0)"
    3.2.9: apply_backward_step prime_imp_nz
    3.2.10: apply_backward_step disjE @3.2.8
    3.2.10: introduction
    3.2.10.1: exists_elim d @3.2.10.0
    3.2.10.3: rewrite_fact_with_prev @3.2.10.2,3.2.3
    3.2.10.4: rewrite_fact mult_assoc @3.2.10.3 sym=false
    3.2.10.5: rewrite_fact eq_mult_lcancel @3.2.10.4 sym=false
    3.2.10.6: apply_backward_step disjE @3.2.10.5
    3.2.10.6: introduction
    3.2.10.6.1: apply_backward_step negE_gen @3.2.9,3.2.10.6.0
    3.2.10.7: introduction
    3.2.10.7.1: forall_elim d @3.1
    3.2.10.7.2: forall_elim y1 @3.2.10.7.1
    3.2.10.7.3: apply_fact @3.2.10.7.2,3.2.10.7.0
    3.2.10.7.4: exists_elim i,j @3.2.10.7.3
    3.2.10.7.7: apply_forward_step conjD1 @3.2.10.7.6
    3.2.10.7.8: apply_forward_step conjD2 @3.2.10.7.6
    3.2.10.7.9: rewrite_goal_with_prev @3.2.10.2
    3.2.10.7.9: inst_exists_goal "Suc i"
    3.2.10.7.9: inst_exists_goal j
    3.2.10.7.9: apply_backward_step conjI
    3.2.10.7.9: rewrite_goal_with_prev @3.2.10.7.7
    3.2.10.7.9: rewrite_goal nat_nat_power_def_2 sym=false
    3.2.11: introduction
    3.2.11.1: exists_elim d @3.2.11.0
    3.2.11.3: rewrite_fact_with_prev @3.2.11.2,3.2.3
    3.2.11.4: cut "x1 * (p * d) = p * (x1 * d)"
    3.2.11.4: nat_norm
    3.2.11.5: rewrite_fact_with_prev @3.2.11.4,3.2.11.3
    3.2.11.6: rewrite_fact eq_mult_lcancel @3.2.11.5 sym=false
    3.2.11.7: apply_backward_step disjE @3.2.11.6
    3.2.11.7: introduction
    3.2.11.7.1: apply_backward_step negE_gen @3.2.9,3.2.11.7.0
    3.2.11.8: introduction
    3.2.11.8.1: apply_fact @3.1,3.2.11.8.0
    3.2.11.8.2: exists_elim i,j @3.2.11.8.1
    3.2.11.8.5: apply_forward_step conjD1 @3.2.11.8.4
    3.2.11.8.6: apply_forward_step conjD2 @3.2.11.8.4
    3.2.11.8.7: inst_exists_goal i
    3.2.11.8.7: inst_exists_goal "Suc j"
    3.2.11.8.7: apply_backward_step conjI
    3.2.11.8.7: rewrite_goal_with_prev @3.2.11.2
    3.2.11.8.7: rewrite_goal_with_prev @3.2.11.8.6
    3.2.11.8.7: rewrite_goal nat_nat_power_def_2 sym=false
    5: apply_prev @4
  qed

theorem prime_power_exp
  fixes k :: nat, n :: nat, p :: nat, x :: nat
  prop prime p ⟶ ¬(n = 0) ⟶ x ^ n = p ^ k ⟶ (∃i::nat. x = p ^ i)
  [hint_backward,hint_backward1]
  proof
    3: revert_intro @2
    2: revert_intro @1
    1: induction n nat_induct
    1: introduction
    1.2: apply_backward_step negE_gen @1.0
    1.2: apply_backward_step eq_refl
    2: introduction n
    2.4: rewrite_fact nat_nat_power_def_2 @2.3 sym=false
    2.5: apply_forward_step prime_power_mult @0,2.4
    2.6: exists_elim i,j @2.5
    2.9: apply_forward_step conjD1 @2.8
    2.10: inst_exists_goal i
  qed

theorem divides_primepow
  fixes k :: nat, p :: nat
  prop prime p ⟶ (∀d. divides d (p ^ k) ⟷ (∃i. i ≤ k ∧ d = p ^ i))
  [hint_backward]
  proof
    1: introduction d
    1.1: apply_backward_step iffI
    1.1: introduction
    1.1.1: rewrite_fact divides_def @1.1.0 sym=false
    1.1.2: exists_elim e @1.1.1
    1.1.4: rewrite_fact eq_sym_eq @1.1.3 sym=false
    1.1.5: apply_forward_step prime_power_mult @0,1.1.4
    1.1.6: exists_elim i,j @1.1.5
    1.1.9: inst_exists_goal i
    1.1.9: apply_forward_step conjD1 @1.1.8
    1.1.10: apply_forward_step conjD2 @1.1.8
    1.1.11: apply_backward_step conjI
    1.1.11: cases "p=0"
    1.1.11: introduction
    1.1.11.1: rewrite_fact_with_prev @1.1.11.0,0
    1.1.11.2: apply_backward_step contrapositive @1.1.11.1
    1.1.11.2: introduction
    1.1.11.2.1: apply_backward_step prime_0
    1.1.12: introduction
    1.1.12.1: cases "p=1"
    1.1.12.1: introduction
    1.1.12.1.1: rewrite_fact_with_prev @1.1.12.1.0,0
    1.1.12.1.2: apply_backward_step contrapositive @1.1.12.1.1
    1.1.12.1.2: introduction
    1.1.12.1.2.1: apply_backward_step prime_1
    1.1.12.2: introduction
    1.1.12.2.1: cut "d * 1 <= d * e"
    1.1.12.2.1: apply_backward_step le_mult2
    1.1.12.2.1: apply_backward_step less_eq_refl
    1.1.12.2.2: rewrite_goal_with_prev @1.1.10
    1.1.12.2.2: apply_backward_step le_1_2
    1.1.12.2.2: rewrite_goal exp_eq_0 sym=false
    1.1.12.2.2: rewrite_goal de_morgan_thm1 sym=false
    1.1.12.2.2: apply_backward_step disjI1
    1.1.12.2.8: rewrite_fact mult_1_right @1.1.12.2.7 sym=false
    1.1.12.2.9: rewrite_fact_with_prev @1.1.4,1.1.12.2.8
    1.1.12.2.10: rewrite_fact_with_prev @1.1.9,1.1.12.2.9
    1.1.12.2.11: rewrite_fact le_exp @1.1.12.2.10 sym=false
    1.1.12.2.12: rewrite_fact if_not_P @1.1.12.2.11,1.1.12.0 sym=false
    1.1.12.2.13: apply_backward_step disjE @1.1.12.2.12
    1.2: introduction
    1.2.1: exists_elim i @1.2.0
    1.2.3: apply_forward_step conjD1 @1.2.2
    1.2.4: apply_forward_step conjD2 @1.2.2
    1.2.5: rewrite_fact less_eq_exist @1.2.3 sym=false
    1.2.6: exists_elim e @1.2.5
    1.2.8: rewrite_goal_with_prev @1.2.7
    1.2.8: rewrite_goal nat_power_add sym=false
    1.2.8: rewrite_goal_with_prev @1.2.4
    1.2.8: apply_backward_step divides_rmul
    1.2.8: apply_backward_step divides_self
  qed

theorem primepow_divides_prod
  fixes k :: nat, m :: nat, n :: nat, p :: nat
  prop prime p ⟶ divides (p ^ k) (m * n) ⟶ (∃i. ∃j. divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j)
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step division_decomp @1
    3: exists_elim b,c @2
    6: apply_forward_step divides_primepow @0 param_k=k
    7: apply_forward_step conjD1 @5
    8: forall_elim b @6
    9: cut "divides b (p ^ k)"
    9: rewrite_goal_with_prev @7
    9: apply_backward_step divides_rmul
    9: apply_backward_step divides_self
    12: rewrite_fact_with_prev @8,11
    13: forall_elim c @6
    14: cut "divides c (p ^ k)" @13
    14: rewrite_goal_with_prev @7
    14: apply_backward_step divides_lmul
    14: apply_backward_step divides_self
    17: rewrite_fact_with_prev @13,16
    18: exists_elim i @12
    20: exists_elim j @17
    22: inst_exists_goal i
    22: inst_exists_goal j
    22: apply_backward_step conjI
    22: apply_forward_step conjD2 @19
    23: rewrite_fact eq_sym_eq @22 sym=false
    24: rewrite_goal_with_prev @23
    24: apply_forward_step conjD2 @5
