theorem primepow_divisors_eq
  fixes m :: nat, n :: nat
  prop m = n ⟷ (∀p. ∀k::nat. prime p ⟶ divides (p ^ k) m ⟷ divides (p ^ k) n)
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: rewrite_goal_with_prev @0.0
    0.1: introduction p,k
    0.1.3: apply_backward_step eq_refl
    1: introduction
    1.1: apply_backward_step divides_antisym
    1.1: rewrite_goal primepow_divisors_divides sym=false
    1.1: introduction p,k
    1.1.4: apply_fact @1.0,1.1.2
    1.1.5: rewrite_fact_with_prev @1.1.4,1.1.3
    1.3: rewrite_goal primepow_divisors_divides sym=false
    1.3: introduction p,k
    1.3.4: apply_fact @1.0,1.3.2
    1.3.5: rewrite_goal_with_prev @1.3.4
  qed

theorem finite_exp_le
  fixes P :: nat ⇒ bool, n :: nat, p :: nat
  prop 2 ≤ p ⟶ finite ({j. P j ∧ p ^ j ≤ n})
  [hint_backward]
  proof
    1: apply_backward_step finite_subset param_t={0..n}
    1: apply_backward_step finite_natseg
    2: apply_backward_step subsetI
    2: rewrite_goal member_collect sym=false
    2: rewrite_goal member_numseg sym=false
    2: introduction x
    2.2: apply_backward_step conjI
    2.2: apply_backward_step le_0
    2.3: apply_forward_step conjD2 @2.1
    2.4: apply_backward_step less_eq_trans param_m="p ^ x"
    2.4: apply_backward_step less_eq_trans param_m="(2::nat) ^ x"
    2.4: apply_backward_step lt_imp_le
    2.4: apply_backward_step lt_pow2_refl
    2.6: apply_backward_step exp_mono_le_imp
  qed

theorem finite_indices
  fixes P :: nat ⇒ bool, n :: nat, p :: nat
  prop 2 ≤ p ⟶ ¬(n = 0) ⟶ finite ({j. P j ∧ divides (p ^ j) n})
  [hint_backward,hint_backward1]
  proof
    2: apply_backward_step finite_subset param_t="{j. P j ∧ p ^ j ≤ n}"
    2: apply_backward_step finite_exp_le @0
    3: apply_backward_step subsetI
    3: rewrite_goal member_collect sym=false
    3: introduction i
    3.2: apply_forward_step conjD1 @3.1
    3.3: apply_forward_step conjD2 @3.1
    3.4: apply_backward_step conjI
    3.4: apply_forward_step divides_le @3.3
    3.5: apply_backward_step disjE @3.4
    3.6: introduction
    3.6.1: apply_backward_step negE_gen @1,3.6.0
  qed

def index :: nat ⇒ nat ⇒ nat = index p n = (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) [hint_rewrite]

theorem index_0
  fixes p :: nat
  prop index p 0 = 0
  [hint_rewrite]
  proof
    0: rewrite_goal index_def sym=false
    0: cut "p ≤ 1 ∨ (0::nat) = 0"
    0: apply_backward_step disjI2
    0: apply_backward_step eq_refl
    2: rewrite_goal if_P @1 sym=false
  qed

