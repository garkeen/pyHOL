    3.4.1.2: rewrite_goal exp_1 sym=false
    3.4.2: introduction
    3.4.2.1: rewrite_goal if_not_P @3.4.2.0 sym=false
    3.4.2.1: rewrite_fact eq_sym_eq @3.4.2.0 sym=false
    3.4.2.2: rewrite_goal if_not_P @3.4.2.1 sym=false
    3.4.2.2: rewrite_goal nat_nat_power_def_1 sym=false
    3.5: rewrite_goal_with_prev @3.4
    3.5: rewrite_goal nproduct_delta sym=false
    3.5: rewrite_goal member_collect sym=false
    3.5: rewrite_goal if_P @3.1 sym=false
    4: introduction a,b
    4.5: rewrite_fact mult_eq_0 @4.4 sym=false
    4.6: rewrite_fact de_morgan_thm2 @4.5 sym=false
    4.7: apply_forward_step conjD1 @4.6
    4.8: apply_forward_step conjD2 @4.6
    4.9: apply_fact @4.2,4.7
    4.10: apply_fact @4.3,4.8
    4.11: cut "nproduct ({p. prime p}) (λp. p ^ (index p a + index p b)) = nproduct ({p. prime p}) (λp. p ^ index p a) * nproduct ({p. prime p}) (λp. p ^ index p b)"
    4.11: rewrite_goal nat_power_add sym=false
    4.11: apply_backward_step nproduct_mul_gen
    4.11: rewrite_goal member_collect sym=false
    4.11: rewrite_goal exp_eq_1 sym=false
    4.11: rewrite_goal index_eq_0 sym=false
    4.11: rewrite_goal de_morgan_thm2 sym=false
    4.11: rewrite_goal de_morgan_thm2 sym=false
    4.11: rewrite_goal de_morgan_thm2 sym=false
    4.11: rewrite_goal double_neg sym=false
    4.11: rewrite_goal conj_assoc sym=false
    4.11: rewrite_goal conj_assoc sym=false
    4.11: rewrite_goal conj_assoc sym=false
    4.11: apply_backward_step finite_special_divisors
    4.22: rewrite_goal exp_eq_1 sym=false
    4.22: rewrite_goal index_eq_0 sym=false
    4.22: rewrite_goal de_morgan_thm2 sym=false
    4.22: rewrite_goal de_morgan_thm2 sym=false
    4.22: rewrite_goal de_morgan_thm2 sym=false
    4.22: rewrite_goal double_neg sym=false
    4.22: rewrite_goal conj_assoc sym=false
    4.22: rewrite_goal conj_assoc sym=false
    4.22: rewrite_goal conj_assoc sym=false
    4.22: apply_backward_step finite_special_divisors
    4.34: cut "nproduct ({p. prime p}) (λp. p ^ index p (a * b)) = nproduct ({p. prime p}) (λp. p ^ (index p a + index p b))"
    4.34: apply_backward_step nproduct_eq
    4.34: introduction p
    4.34.2: rewrite_fact member_collect @4.34.1 sym=false
    4.34.3: cut "index p (a * b) = (index p a + index p b)"
    4.34.3: apply_backward_step index_mul
    4.34.4: rewrite_goal_with_prev @4.34.3
    4.36: rewrite_goal_with_prev @4.35
    4.36: rewrite_goal_with_prev @4.33
    4.36: rewrite_goal_with_prev @4.9
    4.36: rewrite_goal_with_prev @4.10
    6: apply_prev @5
