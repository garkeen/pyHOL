    1.3.3.3.7.2: apply_fact @1.3.3.3.5,1.3.3.3.7.1
    1.3.3.3.7.3: apply_backward_step disjE @1.3.3.3.7.2
    1.3.3.5: apply_fact @1.3.3.2,1.3.3.4
    1.3.3.6: cases "prime p"
    1.3.3.6: introduction
    1.3.3.6.1: apply_forward_step prime_imp_nz @1.3.3.6.0
    1.3.3.6.2: exists_elim n @1.3.3.5
    1.3.3.6.4: apply_forward_step conjD1 @1.3.3.6.3
    1.3.3.6.5: apply_forward_step conjD2 @1.3.3.6.3
    1.3.3.6.6: inst_exists_goal "p ^ (f p) * n"
