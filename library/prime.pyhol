    7.12: rewrite_fact eq_sym_eq @7.11 sym=false
    7.13: rewrite_goal_with_prev @7.12
    7.13: cut "{j::nat. 1 ≤ j ∧ divides (p ^ j) m} = {x::nat. (1 ≤ x ∧ p ^ x ≤ n) ∧ divides (p ^ x) m}"
