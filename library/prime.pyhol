theorem gcd_coprime_rmul
  fixes a :: nat, b :: nat, c :: nat
  prop coprime a b ⟶ gcd c (a * b) = gcd c a * gcd c b
  proof
    1: rewrite_goal gcd_comm sym=false
    1: apply_backward_step gcd_coprime_lmul @0
  qed

theorem chinese_reminder
  fixes a :: nat, b :: nat, u :: nat, v :: nat
  prop coprime a b ⟶ ¬(a = 0) ⟶ ¬(b = 0) ⟶ (∃x. ∃q1. ∃q2. x = u + q1 * a ∧ x = v + q2 * b)
  [hint_backward,hint_backward1]
  proof
    3: cut "!P::nat⇒nat⇒nat⇒bool. (?d. ?x. ?y. (d = 1) & P x y d) <--> (?x. ?y. P x y 1)"
    3: introduction P
    3.1: apply_backward_step iffI
    3.1: introduction
    3.1.1: exists_elim d,x,y @3.1.0
    3.1.5: apply_forward_step conjD1 @3.1.4
    3.1.6: apply_forward_step conjD2 @3.1.4
    3.1.7: rewrite_fact_with_prev @3.1.5,3.1.6
    3.1.8: inst_exists_goal x
    3.1.8: inst_exists_goal y
    3.2: introduction
    3.2.1: exists_elim x,y @3.2.0
    3.2.4: inst_exists_goal "(1::nat)"
    3.2.4: inst_exists_goal x
    3.2.4: inst_exists_goal y
    3.2.4: apply_backward_step conjI
    3.2.4: apply_backward_step eq_refl
    4: apply_forward_step bezout_add_strong param_a=b param_b=a
    5: apply_forward_step bezout_add_strong param_a=a param_b=b
    6: rewrite_fact coprime_def @0 sym=false
    7: apply_fact @5,1
    8: apply_fact @4,2
    9: rewrite_fact_with_prev @6,7
    10: rewrite_fact conj_comm @6 sym=false
    11: rewrite_fact_with_prev @10,8
    12: rewrite_fact_with_prev @3,9
    13: rewrite_fact_with_prev @3,11
    14: exists_elim x1,y1 @12
    17: exists_elim x2,y2 @13
    20: inst_exists_goal "v * a * x1 + u * b * x2"
    20: inst_exists_goal "v * x1 + u * y2"
    20: inst_exists_goal "v * y1 + u * x2"
    20: apply_backward_step conjI
    20: rewrite_goal mult_assoc sym=false
    20: rewrite_goal_with_prev @19
    20: nat_norm
    23: rewrite_goal mult_assoc sym=false
    23: rewrite_goal_with_prev @16
    23: nat_norm
  qed

def prime :: nat ⇒ bool = prime p ⟷ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p) [hint_rewrite]

theorem one_or_prime
  fixes p :: nat
  prop p = 1 ∨ prime p ⟷ (∀n. divides n p ⟶ n = 1 ∨ n = p)
  [hint_rewrite]
  proof
    0: rewrite_goal prime_def sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step disjE @0.0
    0.1: introduction
    0.1.1: introduction n
    0.1.1.2: rewrite_fact_with_prev @0.1.0,0.1.1.1
    0.1.1.3: rewrite_fact_with_prev @0.1.0,0.1.1.1
    0.1.1.4: rewrite_fact divides_one @0.1.1.3 sym=false
    0.1.1.5: apply_backward_step disjI1
    0.2: introduction
    0.2.1: apply_backward_step conjD2 @0.2.0
    1: introduction
    1.1: cases "p = 1"
    1.1: introduction
    1.1.1: apply_backward_step disjI1
    1.2: introduction
    1.2.1: apply_backward_step disjI2
    1.2.1: apply_backward_step conjI
  qed

