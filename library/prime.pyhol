theory prime
imports gcd
description "Basic theory of divisibility, gcd, coprimality and primality (over N)."

def coprime :: nat ⇒ nat ⇒ bool = coprime a b ⟷ (∀d. divides d a ∧ divides d b ⟷ d = 1) [hint_rewrite]

theorem coprime_gcd
  fixes a :: nat, b :: nat
  prop coprime a b ⟷ gcd a b = 1
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_def sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step gcd_equals
    0.1: apply_backward_step divides_1
    0.2: apply_backward_step divides_1
    0.3: introduction d
    0.3.3: apply_forward_step conjI @0.3.1,0.3.2
    0.3.4: rewrite_fact_with_prev @0.0,0.3.3
    0.3.5: rewrite_goal_with_prev @0.3.4
    0.3.5: rewrite_goal divides_one sym=false
    1: introduction
    1.1: introduction d
    1.1.1: apply_backward_step iffI
    1.1.1: introduction
    1.1.1.1: apply_forward_step conjD1 @1.1.1.0
    1.1.1.2: apply_forward_step conjD2 @1.1.1.0
    1.1.1.3: apply_forward_step gcd_is_max @1.1.1.1,1.1.1.2
    1.1.1.4: rewrite_fact_with_prev @1.0,1.1.1.3
    1.1.1.5: rewrite_fact divides_one @1.1.1.4 sym=false
    1.1.2: introduction
    1.1.2.1: rewrite_goal_with_prev @1.1.2.0
    1.1.2.1: apply_backward_step conjI
    1.1.2.1: apply_backward_step divides_1
    1.1.2.2: apply_backward_step divides_1
  qed

theorem coprime_sym
  fixes a :: nat, b :: nat
  prop coprime a b ⟷ coprime b a
  [hint_rewrite,hint_backward]
  proof
    0: rewrite_goal coprime_gcd sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: rewrite_goal gcd_comm sym=false
    1: introduction
    1.1: rewrite_goal gcd_comm sym=false
  qed

theorem coprime_bezout
  fixes a :: nat, b :: nat
  prop coprime a b ⟷ (∃x. ∃y. a * x - b * y = 1 ∨ b * x - a * y = 1)
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_gcd sym=false
    0: rewrite_goal gcd_bezout sym=false
    0: rewrite_goal divides_one sym=false
  qed

theorem coprime_divprod
  fixes a :: nat, b :: nat, d :: nat
  prop divides d (a * b) ⟶ coprime d a ⟶ divides d b
  [hint_backward,hint_backward1]
  proof
    2: rewrite_fact divides_lmul_gcd @0 sym=true
    3: rewrite_fact coprime_gcd @1 sym=false
    4: rewrite_fact_with_prev @3,2
    5: rewrite_fact mult_1_left @4 sym=false
  qed

theorem coprime_rmod
  fixes a :: nat, n :: nat
  prop coprime n (a MOD n) ⟷ coprime n a
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_gcd sym=false
    0: apply_forward_step division_simp1 param_m=a param_n=n
    1: rewrite_fact eq_sym_eq @0 sym=false
    2: rewrite_goal_with_prev @1
    2: cut "(a DIV n * n + a MOD n) MOD n = a MOD n"
    2: rewrite_goal division_simp1 sym=false
    3: rewrite_goal_with_prev @2
    3: rewrite_goal gcd_mod sym=false
  qed

theorem coprime_lmod
  fixes a :: nat, n :: nat
  prop coprime (a MOD n) n ⟷ coprime a n
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_sym sym=false
    0: rewrite_goal coprime_rmod sym=false
  qed

theorem gcd_mul_coprime_1
  fixes a :: nat, b :: nat, c :: nat
  prop coprime a b ⟶ gcd a (b * c) = gcd a c
  [hint_backward]
  proof
    1: apply_backward_step gcd_eq
    1: introduction d
    1.1: apply_backward_step iffI
    1.1: introduction
    1.1.1: apply_backward_step conjI
    1.1.1: apply_backward_step conjD1 @1.1.0
    1.1.2: apply_forward_step conjD2 @1.1.0
    1.1.3: apply_backward_step coprime_divprod @1.1.2
    1.1.3: rewrite_fact coprime_gcd @0 sym=false
    1.1.4: rewrite_goal coprime_gcd sym=false
    1.1.4: rewrite_fact divides_gcd_right @1.1.1 sym=false
    1.1.5: rewrite_fact eq_sym_eq @1.1.4 sym=false
    1.1.6: rewrite_goal_with_prev @1.1.5
    1.1.6: rewrite_goal gcd_comm sym=false
    1.1.6: rewrite_goal gcd_assoc sym=true
    1.1.6: rewrite_fact gcd_comm @1.1.3 sym=false
    1.1.7: rewrite_goal_with_prev @1.1.6
    1.1.7: rewrite_goal gcd_1_left sym=false
    1.2: introduction
    1.2.1: apply_backward_step conjI
    1.2.1: apply_backward_step conjD1 @1.2.0
    1.2.2: apply_backward_step divides_lmul
    1.2.2: apply_backward_step conjD2 @1.2.0
  qed

theorem gcd_mul_coprime_2
  fixes a :: nat, b :: nat, c :: nat
  prop coprime a c ⟶ gcd a (b * c) = gcd a b
  [hint_backward]
  proof
    1: rewrite_goal mult_comm sym=false
    1: apply_backward_step gcd_mul_coprime_1 @0
  qed

theorem coprime_1
  fixes a :: nat
  prop coprime a 1
  [hint_backward]
  proof
    0: rewrite_goal coprime_gcd sym=false
    0: rewrite_goal gcd_1_right sym=false
  qed

theorem gcd_coprime
  fixes a :: nat, b :: nat, c :: nat, d :: nat
  prop ¬(gcd a b = 0) ⟶ a = c * gcd a b ⟶ b = d * gcd a b ⟶ coprime c d
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal coprime_gcd sym=false
    3: apply_forward_step gcd_mult_right param_k="gcd a b" param_m=c param_n=d
    4: rewrite_fact eq_sym_eq @1 sym=false
    5: rewrite_fact eq_sym_eq @2 sym=false
    6: rewrite_fact_with_prev @4,3
    7: rewrite_fact_with_prev @5,6
    8: cut "gcd a b = gcd a b * 1" @7
    8: rewrite_goal mult_1_right sym=false
    9: rewrite_fact_with_prev @8,7
    10: rewrite_fact mult_assoc @9 sym=false
    11: rewrite_fact mult_1_left @10 sym=false
    12: rewrite_fact eq_mult_lcancel @11 sym=false
    13: apply_backward_step disjE @12
    13: introduction
    13.1: apply_backward_step negE_gen @0,13.0
    14: introduction
    14.1: rewrite_goal eq_sym_eq sym=false
  qed

theorem gcd_coprime_exists
  fixes a :: nat, b :: nat
  prop ∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d
  [hint_backward]
  proof
    0: cases "gcd a b = 0"
    0: introduction
    0.1: rewrite_fact gcd_zero @0.0 sym=false
    0.2: apply_forward_step conjD1 @0.1
    0.3: apply_forward_step conjD2 @0.1
    0.4: inst_exists_goal "(0::nat)"
    0.4: apply_backward_step exI param_a="(1::nat)"
    0.4: rewrite_goal_with_prev @0.2
    0.4: rewrite_goal_with_prev @0.3
    0.4: apply_backward_step conjI
    0.4: rewrite_goal nat_times_def_1 sym=false
    0.5: apply_backward_step conjI
    0.5: rewrite_goal gcd_refl sym=false
    0.5: rewrite_goal mult_0_right sym=false
    0.7: apply_backward_step coprime_1
    1: introduction
    1.1: apply_forward_step gcd_divide1 param_m=a param_n=b
    1.2: apply_forward_step gcd_divides2 param_m=a param_n=b
    1.3: rewrite_fact divides_def @1.1 sym=false
    1.4: rewrite_fact divides_def @1.2 sym=false
    1.5: exists_elim k1 @1.3
    1.7: exists_elim k2 @1.4
    1.9: inst_exists_goal k1
    1.9: inst_exists_goal k2
    1.9: apply_backward_step conjI
    1.9: rewrite_goal mult_comm sym=false
    1.10: apply_backward_step conjI
    1.10: rewrite_goal mult_comm sym=false
    1.11: apply_backward_step gcd_coprime param_a=a param_b=b
  qed

theorem coprime_0
  fixes d :: nat
  prop coprime d 0 ⟷ d = 1
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_gcd sym=false
    0: rewrite_goal gcd_zero_right sym=false
  qed

theorem coprime_mul
  fixes a :: nat, b :: nat, d :: nat
  prop coprime d a ⟶ coprime d b ⟶ coprime d (a * b)
  [hint_backward,hint_backward1]
  proof
    2: rewrite_goal coprime_gcd sym=false
    2: rewrite_fact coprime_gcd @0 sym=false
    3: rewrite_fact coprime_gcd @1 sym=false
    4: apply_forward_step gcd_mul_coprime_1 @0 param_c=b
    5: rewrite_fact_with_prev @3,4
  qed

theorem coprime_lmul2
  fixes a :: nat, b :: nat, d :: nat
  prop coprime d (a * b) ⟶ coprime d b
  [hint_backward]
  proof
    1: rewrite_fact coprime_gcd @0 sym=false
    2: rewrite_goal coprime_gcd sym=false
    2: rewrite_fact eq_sym_eq @1 sym=false
    3: apply_backward_step divides_antisym
    3: rewrite_goal_with_prev @2
    3: apply_backward_step gcd_is_max
    3: apply_backward_step gcd_divide1
    4: apply_backward_step divides_lmul
    4: apply_backward_step gcd_divides2
    8: apply_backward_step divides_1
  qed

theorem coprime_rmul2
  fixes a :: nat, b :: nat, d :: nat
  prop coprime d (a * b) ⟶ coprime d a
  [hint_backward]
  proof
    1: rewrite_fact mult_comm @0 sym=false
    2: apply_backward_step coprime_lmul2 @1
  qed

theorem coprime_rmul
  fixes a :: nat, b :: nat, d :: nat
  prop coprime d (a * b) ⟷ coprime d a ∧ coprime d b
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step conjI
    0.1: apply_backward_step coprime_rmul2 @0.0
    0.2: apply_backward_step coprime_lmul2 @0.0
    1: introduction
    1.1: apply_forward_step conjD1 @1.0
    1.2: apply_forward_step conjD2 @1.0
    1.3: apply_backward_step coprime_mul
  qed

theorem coprime_lmul
  fixes a :: nat, b :: nat, d :: nat
  prop coprime (a * b) d ⟷ coprime a d ∧ coprime b d
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_sym sym=false
    0: rewrite_goal coprime_rmul sym=false
  qed

theorem coprime_exp
  fixes a :: nat, d :: nat, n :: nat
  prop coprime d a ⟶ coprime d (a ^ n)
  [hint_backward]
  proof
    1: induction n nat_induct
    1: rewrite_goal nat_nat_power_def_1 sym=false
    1: apply_backward_step coprime_1
    3: introduction n
    3.2: rewrite_goal nat_nat_power_def_2 sym=false
    3.2: apply_backward_step coprime_mul
  qed

theorem coprime_exp_imp
  fixes a :: nat, b :: nat, n :: nat
  prop coprime a b ⟶ coprime (a ^ n) (b ^ n)
  [hint_backward]
  proof
    1: apply_backward_step coprime_exp
    1: rewrite_goal coprime_sym sym=false
    1: apply_backward_step coprime_exp
    1: rewrite_goal coprime_sym sym=false
  qed

theorem coprime_rexp
  fixes k :: nat, m :: nat, n :: nat
  prop coprime m (n ^ k) ⟷ coprime m n ∨ k = 0
  [hint_rewrite]
  proof
    0: induction k nat_induct
    0: rewrite_goal nat_nat_power_def_1 sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step disjI2
    0.1: apply_backward_step eq_refl
    1: introduction
    1.1: apply_backward_step coprime_1
    4: introduction n
    4.2: rewrite_goal nat_nat_power_def_2 sym=false
    4.2: rewrite_goal coprime_rmul sym=false
    4.2: rewrite_goal_with_prev @4.1
    4.2: apply_backward_step iffI
    4.2: introduction
    4.2.1: apply_backward_step disjI1
    4.2.1: apply_backward_step conjD1 @4.2.0
    4.3: introduction
    4.3.1: apply_backward_step disjE @4.3.0
    4.3.1: introduction
    4.3.1.1: apply_backward_step conjI
    4.3.1.1: apply_backward_step disjI1
    4.3.2: introduction
    4.3.2.1: apply_backward_step contrapositive @4.3.2.0
    4.3.2.1: introduction
    4.3.2.1.1: apply_backward_step ineq_sym
    4.3.2.1.1: apply_backward_step nat_zero_Suc_neq
  qed

theorem coprime_lexp
  fixes k :: nat, m :: nat, n :: nat
  prop coprime (m ^ k) n ⟷ coprime m n ∨ k = 0
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_sym sym=false
    0: rewrite_goal coprime_rexp sym=false
  qed

theorem coprime_exp2
  fixes k :: nat, m :: nat, n :: nat
  prop coprime (m ^ k) (n ^ k) ⟷ coprime m n ∨ k = 0
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_lexp sym=false
    0: rewrite_goal coprime_rexp sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step disjE @0.0
    0.2: introduction
    0.2.1: apply_backward_step disjI2
    1: introduction
    1.1: apply_backward_step disjI1
  qed

theorem coprime_exp2_suc
  fixes k :: nat, m :: nat, n :: nat
  prop coprime (m ^ Suc k) (n ^ Suc k) ⟷ coprime m n
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_exp2 sym=false
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_backward_step disjE @0.0
    0.2: introduction
    0.2.1: apply_backward_step contrapositive @0.2.0
    0.2.1: introduction
    0.2.1.1: apply_backward_step ineq_sym
    0.2.1.1: apply_backward_step nat_zero_Suc_neq
    1: introduction
    1.1: apply_backward_step disjI1
  qed

theorem coprime_refl
  fixes n :: nat
  prop coprime n n ⟷ n = 1
  [hint_rewrite]
  proof
    0: rewrite_goal coprime_gcd sym=false
    0: rewrite_goal gcd_refl sym=false
  qed

theorem coprime_plus1
  fixes n :: nat
  prop coprime (n + 1) n
  [hint_backward]
  proof
    0: rewrite_goal coprime_gcd sym=false
    0: rewrite_goal gcd_add_right sym=false
    0: rewrite_goal gcd_1_right sym=false
  qed

theorem coprime_minus1
  fixes n :: nat
  prop ¬(n = 0) ⟶ coprime (n - 1) n
  [hint_backward]
  proof
    1: rewrite_goal coprime_sym sym=false
    1: cut "coprime ((n - 1) + 1) (n - 1)"
    1: apply_backward_step coprime_plus1
    2: cut "n - 1 + 1 = n"
    2: apply_backward_step sub_add
    2: apply_backward_step le_1_2
    4: rewrite_fact_with_prev @3,1
  qed

theorem gcd_exp
  fixes k :: nat, m :: nat, n :: nat
  prop gcd (m ^ k) (n ^ k) = gcd m n ^ k
  [hint_rewrite]
  proof
    0: apply_forward_step gcd_coprime_exists param_a=m param_b=n
    1: exists_elim c,d @0
    4: apply_forward_step conjD1 @3
    5: apply_forward_step conjD2 @3
    6: apply_forward_step conjD1 @5
    7: apply_forward_step conjD2 @5
    8: rewrite_goal_with_prev @4
    8: cut "gcd ((c * gcd m n) ^ k) ((d * gcd m n) ^ k) = gcd (c * gcd m n) (d * gcd m n) ^ k"
    8: rewrite_goal mult_exp sym=false
    8: rewrite_goal gcd_mult_right sym=false
    8: rewrite_fact coprime_gcd @7 sym=false
    9: rewrite_goal_with_prev @8
    9: rewrite_goal mult_1_right sym=false
    9: cut "gcd m n ^ k = gcd m n ^ k * 1"
    9: rewrite_goal mult_1_right sym=false
    10: rewrite_goal_with_prev @9
    10: rewrite_goal mult_assoc sym=false
    10: rewrite_goal mult_1_left sym=false
    10: rewrite_goal eq_mult_lcancel sym=false
    10: apply_backward_step disjI2
    10: rewrite_goal coprime_gcd sym=true
    10: rewrite_goal coprime_exp2 sym=false
    10: apply_backward_step disjI1
    22: rewrite_fact eq_sym_eq @6 sym=false
    23: rewrite_fact_with_prev @22,21
  qed

theorem division_decomp
  fixes a :: nat, b :: nat, c :: nat
  prop divides a (b * c) ⟶ (∃b1. ∃c1. a = b1 * c1 ∧ divides b1 b ∧ divides c1 c)
  [hint_backward]
  proof
    1: inst_exists_goal "gcd a b"
    1: cases "gcd a b =0"
    1: introduction
    1.1: inst_exists_goal "(1::nat)"
    1.1: apply_backward_step conjI
    1.1: rewrite_goal_with_prev @1.0
    1.1: rewrite_fact gcd_zero @1.0 sym=false
    1.2: apply_forward_step conjD1 @1.1
    1.3: rewrite_goal_with_prev @1.2
    1.3: rewrite_goal mult_1_right sym=false
    1.6: apply_backward_step conjI
    1.6: apply_backward_step gcd_divides2
    1.7: apply_backward_step divides_1
    2: introduction
    2.1: apply_forward_step gcd_coprime_exists param_a=a param_b=b
    2.2: exists_elim e,f @2.1
    2.5: inst_exists_goal e
    2.5: apply_forward_step conjD1 @2.4
    2.6: apply_backward_step conjI
    2.6: rewrite_fact mult_comm @2.5 sym=false
    2.7: apply_backward_step conjI
    2.7: apply_backward_step gcd_divides2
    2.8: apply_forward_step conjD2 @2.4
    2.9: apply_forward_step conjD1 @2.8
    2.10: apply_forward_step conjD2 @2.8
    2.11: apply_backward_step coprime_divprod param_a=f
    2.11: apply_backward_step divides_cmul2 param_c="gcd a b"
    2.11: rewrite_fact eq_sym_eq @2.6 sym=false
    2.12: rewrite_fact mult_comm @2.9 sym=false
    2.13: rewrite_fact eq_sym_eq @2.12 sym=false
    2.14: rewrite_goal mult_assoc sym=true
    2.14: rewrite_goal_with_prev @2.11
    2.14: rewrite_goal_with_prev @2.13
  qed

theorem divides_exp2_rev
  fixes a :: nat, b :: nat, n :: nat
  prop divides (a ^ n) (b ^ n) ⟶ ¬(n = 0) ⟶ divides a b
  [hint_backward,hint_backward1]
  proof
    2: cases "gcd a b = 0"
    2: introduction
    2.1: rewrite_fact gcd_zero @2.0 sym=false
    2.2: apply_forward_step conjD1 @2.1
    2.3: apply_forward_step conjD2 @2.1
    2.4: rewrite_goal_with_prev @2.3
    2.4: apply_backward_step divides_zero
    3: introduction
    3.1: apply_forward_step gcd_coprime_exists param_a=a param_b=b
    3.2: exists_elim c,d @3.1
    3.5: apply_forward_step conjD1 @3.4
    3.6: apply_forward_step conjD2 @3.4
    3.7: apply_forward_step conjD2 @3.6
    3.8: apply_forward_step conjD1 @3.6
    3.9: rewrite_fact_with_prev @3.5,0
    3.10: cut "divides ((c * gcd a b) ^ n) ((d * gcd a b) ^ n)" @3.9
    3.10: rewrite_fact eq_sym_eq @3.8 sym=false
    3.11: rewrite_goal_with_prev @3.10
    3.12: rewrite_fact mult_exp @3.11 sym=false
    3.13: rewrite_fact mult_comm @3.12 sym=false
    3.14: apply_forward_step divides_cmul2 @3.13
    3.15: cut "¬(gcd a b ^ n = 0)"
    3.15: rewrite_goal exp_eq_0 sym=false
    3.15: rewrite_goal de_morgan_thm1 sym=false
    3.15: apply_backward_step disjI1
    3.18: apply_fact @3.14,3.17
    3.19: rewrite_goal_with_prev @3.5
    3.19: cut "divides (c * gcd a b) (d * gcd a b)"
    3.19: apply_backward_step divides_mult_right
    3.19: rewrite_fact divides_gcd_left @3.18 sym=false
    3.20: rewrite_fact gcd_exp @3.19 sym=false
    3.21: rewrite_fact coprime_gcd @3.7 sym=false
    3.22: rewrite_fact_with_prev @3.21,3.20
    3.23: rewrite_fact exp_mono_eq @3.22 sym=false
    3.24: apply_backward_step disjE @3.23
    3.24: introduction
    3.24.1: rewrite_fact eq_sym_eq @3.24.0 sym=false
    3.24.2: rewrite_goal_with_prev @3.24.1
    3.24.2: apply_backward_step divides_1
    3.25: introduction
    3.25.1: apply_backward_step negE_gen @1,3.25.0
    3.28: rewrite_fact_with_prev @3.10,3.27
  qed

theorem divides_exp2_eq
  fixes a :: nat, b :: nat, n :: nat
  prop ¬(n = 0) ⟶ divides (a ^ n) (b ^ n) ⟷ divides a b
  [hint_backward]
  proof
    1: apply_backward_step iffI
    1: introduction
    1.1: apply_backward_step divides_exp2_rev @1.0,0
    2: introduction
    2.1: apply_backward_step divides_exp @2.0
  qed

theorem divides_mul
  fixes m :: nat, n :: nat, r :: nat
  prop divides m r ⟶ divides n r ⟶ coprime m n ⟶ divides (m * n) r
  [hint_backward,hint_backward1]
  proof
    3: rewrite_fact divides_def @0 sym=false
    4: rewrite_fact divides_def @1 sym=false
    5: exists_elim k1 @3
    7: exists_elim k2 @4
    9: rewrite_goal_with_prev @6
    9: apply_backward_step divides_mult_left
    9: apply_backward_step coprime_divprod param_a=m
    9: rewrite_fact eq_sym_eq @6 sym=false
    10: rewrite_goal_with_prev @9
    11: rewrite_goal coprime_sym sym=false
  qed

theorem gcd_coprime_lmul
  fixes a :: nat, b :: nat, c :: nat
  prop coprime a b ⟶ gcd (a * b) c = gcd a c * gcd b c
  [hint_backward]
  proof
    1: apply_forward_step gcd_divide1 param_m=a param_n=c
    2: apply_forward_step gcd_divides2 param_m=a param_n=c
    3: rewrite_fact divides_def @1 sym=false
    4: rewrite_fact divides_def @2 sym=false
    5: exists_elim k1 @3
    7: exists_elim k2 @4
    9: cut "gcd (a * b) c = gcd (gcd a c * k1 * b) (gcd a c * k2) "
    9: rewrite_fact eq_sym_eq @6 sym=false
    10: rewrite_fact eq_sym_eq @8 sym=false
    11: rewrite_goal_with_prev @9
    11: rewrite_goal_with_prev @10
