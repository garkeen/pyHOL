theorem index_fact_prime_mult
  fixes n :: nat, p :: nat
  prop prime p ⟶ index p (fact (p * n)) = n + index p (fact n)
  [hint_backward]
  proof
    1: cases "n=0"
    1: introduction
    1.1: rewrite_goal_with_prev @1.0
    1.1: rewrite_goal mult_0_right sym=false
    1.1: rewrite_goal nat_plus_def_1 sym=false
    2: introduction
    2.1: apply_forward_step prime_imp_nz @0
    2.2: apply_forward_step index_fact @0 param_n="p * n"
    2.3: apply_forward_step index_fact @0 param_n=n
    2.4: rewrite_goal_with_prev @2.2
    2.4: rewrite_goal_with_prev @2.3
    2.4: cut "nsum ({1..p * n}) (λm. index p m) = nsum (image (%i. p * i) ({1..n})) (%m. index p m)"
    2.4: apply_backward_step nsum_superset
    2.4: apply_backward_step subsetI
    2.4: rewrite_goal in_image sym=false
    2.4: rewrite_goal member_natseg sym=false
    2.4: z3 @2.1
    2.8: rewrite_goal in_image sym=false
    2.8: rewrite_goal member_natseg sym=false
    2.8: introduction i
    2.8.3: apply_backward_step index_zero
    2.8.3: apply_backward_step contrapositive @2.8.2
    2.8.3: rewrite_goal double_neg sym=false
    2.8.3: introduction
    2.8.3.1: rewrite_fact divides_def @2.8.3.0 sym=false
    2.8.3.2: z3 @2.8.3.1,2.8.1
    2.12: rewrite_goal eta_conversion sym=false
    2.12: rewrite_goal_with_prev @2.11
    2.12: cut "nsum (image (λi. p * i) ({1..n})) (index p) = nsum ({1..n}) ((index p) O (λi. p * i))"
    2.12: apply_backward_step nsum_image
    2.12: introduction x,y
    2.12.5: rewrite_fact eq_mult_lcancel @2.12.4 sym=false
    2.12.6: apply_backward_step disjE @2.12.5
    2.12.6: introduction
    2.12.6.1: apply_backward_step negE_gen @2.1,2.12.6.0
    2.14: rewrite_goal_with_prev @2.13
    2.14: rewrite_goal comp_fun_def sym=false
    2.14: cut "nsum ({1..n}) (λx. index p (p * x)) = nsum ({1..n}) (λx. index p p + index p x)"
    2.14: apply_backward_step nsum_eq_natseg
    2.14: introduction i
    2.14.3: apply_backward_step index_mul
    2.14.3: z3 @2.14.1
    2.16: rewrite_goal_with_prev @2.15
    2.16: rewrite_goal nsum_add_natseg sym=false
    2.16: rewrite_goal nsum_const_natseg sym=false
    2.16: rewrite_goal nat_plus_minus sym=false
    2.16: rewrite_goal index_refl sym=false
    2.16: cut "~(p ≤ 1)"
    2.16: apply_forward_step prime_ge_2 @0
    2.17: z3 @2.16
    2.18: rewrite_goal if_not_P @2.17 sym=false
    2.18: rewrite_goal mult_1_right sym=false
  qed

theorem prime_factorization_index
  fixes k :: nat ⇒ nat
  prop finite ({p. prime p ∧ ¬(k p = 0)}) ⟶ (∃n. ¬(n = 0) ∧ (∀p. prime p ⟶ index p n = k p))
  [hint_backward]
  proof
    1: cut "!s. finite s\n       --> !k. {p. prime p & ~(k p = 0)} ⊆ s\n               --> ?n. ~(n = 0) & !p. prime p --> index p n = k p"
    1: introduction s
    1.2: apply_backward_step finite_induct_strong @1.1
    1.2: introduction f
    1.2.2: inst_exists_goal "(1::nat)"
    1.2.2: apply_backward_step conjI
    1.2.2: nat_const_ineq
