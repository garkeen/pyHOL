    1.2.3.4.2: apply_prev @1.2.3.4.1
    1.2.3.4.2: apply_backward_step conjI
    1.3: introduction p,s
    1.3.3: introduction f
    1.3.3.2: forall_elim "(%i. if i = p then 0 else f i)" @1.3.1
    1.3.3.3: cut "{p1. prime p1 ∧ ¬((if p1 = p then 0 else f p1) = 0)} ⊆ s"
    1.3.3.3: apply_backward_step subsetI
    1.3.3.3: introduction x
    1.3.3.3.2: rewrite_fact member_collect @1.3.3.3.1 sym=false
    1.3.3.3.3: apply_forward_step subsetE @1.3.3.1 param_x=x
    1.3.3.3.4: rewrite_fact member_insert @1.3.3.3.3 sym=false
    1.3.3.3.5: rewrite_fact member_collect @1.3.3.3.4 sym=false
    1.3.3.3.6: cases "x=p"
    1.3.3.3.6: introduction
