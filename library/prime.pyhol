theorem divides_exp_plus1
  fixes k :: nat, n :: nat
  prop odd k ⟶ divides (n + 1) (n ^ k + 1)
  proof
    1: rewrite_fact odd_exists @0 sym=false
    2: exists_elim m @1
    4: rewrite_goal_with_prev @3
    4: induction m nat_induct
    4: rewrite_goal mult_0_right sym=false
    4: rewrite_goal nat_nat_power_def_2 sym=false
    4: rewrite_goal nat_nat_power_def_1 sym=false
    4: rewrite_goal mult_1_right sym=false
    4: apply_backward_step divides_self
    9: introduction m1
    9.2: cut "Suc (2 * Suc m1) = Suc (2 * m1) + 2"
    9.2: nat_norm
    9.3: rewrite_goal_with_prev @9.2
    9.3: rewrite_goal nat_power_add sym=false
    9.3: rewrite_goal exp_2 sym=false
    9.3: rewrite_fact divides_def @9.1 sym=false
    9.4: exists_elim d @9.3
    9.6: cut "1 <= n ^ Suc (2 * m1) + 1" @9.5
    9.6: rewrite_goal add_comm sym=false
    9.6: apply_backward_step le_add
    9.8: cut "n ^ Suc (2 * m1) = (n + 1) * d - 1"
    9.8: rewrite_fact eq_sym_eq @9.5 sym=false
    9.9: rewrite_goal_with_prev @9.8
    9.9: rewrite_goal eq_sym_eq sym=false
    9.9: apply_backward_step nat_plus_minus
    9.12: rewrite_goal_with_prev @9.11
    9.12: rewrite_goal mult_comm sym=false
    9.12: rewrite_goal left_sub_distrib sym=false
    9.12: cut "∀x::nat. ∀y. ∀z. z ≤ y --> y <= x ⟶ x - y + z = x - (y - z)"
    9.12: z3
    9.13: rewrite_goal mult_1_right sym=false
    9.13: cases "n=0"
