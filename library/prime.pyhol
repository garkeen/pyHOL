    1.2.1.1.1.3: introduction
    1.2.1.1.1.3.1: apply_backward_step iffI
    1.2.1.1.1.3.1: introduction
    1.2.1.1.1.3.1.0: rewrite_fact coprime_def @1.2.1.1.1.3.0 sym=false
    1.2.1.1.1.3.1.1: forall_elim p @1.2.1.1.1.3.1.0
    1.2.1.1.1.3.1.2: apply_backward_step contrapositive @1.0
    1.2.1.1.1.3.1.2: rewrite_goal double_neg sym=false
    1.2.1.1.1.3.1.2: introduction
    1.2.1.1.1.3.1.2.1: rewrite_fact eq_sym_eq @1.2.1.1.1.3.1.1 sym=false
    1.2.1.1.1.3.1.2.2: rewrite_goal_with_prev @1.2.1.1.1.3.1.2.1
