    4.2.1: apply_backward_step nat_zero_Suc_neq
    4.2.3: rewrite_goal if_not_P @4.2.2 sym=false
    4.2.3: apply_backward_step iffI
    4.2.3: introduction
    4.2.3.1: apply_backward_step contrapositive @4.2.3.0
    4.2.3.1: introduction
    4.2.3.1.1: apply_backward_step prime_0
    4.2.4: introduction
    4.2.4.1: apply_backward_step conjD1 @4.2.4.0
    4.3: introduction
    4.3.1: induction n nat_induct
    4.3.1: rewrite_goal add_1_right sym=true
    4.3.1: rewrite_goal nat_plus_def_1 sym=false
    4.3.1: rewrite_goal exp_1 sym=false
    4.3.1: apply_backward_step iffI
    4.3.1: introduction
    4.3.1.1: apply_backward_step conjI
    4.3.1.1: apply_backward_step eq_refl
    4.3.2: introduction
    4.3.2.1: apply_backward_step conjD1 @4.3.2.0
    4.3.7: introduction m
    4.3.7.2: cases "p=1"
