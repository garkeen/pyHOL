theorem primepow_divides_fact
  fixes k :: nat, n :: nat, p :: nat
  prop prime p ⟶ divides (p ^ k) (fact n) ⟷ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  [hint_backward]
  proof
    1: rewrite_goal primepow_divides_index sym=false
    1: apply_forward_step index_fact_alt @0 param_n=n
    2: rewrite_goal_with_prev @1
    2: apply_backward_step iffI
