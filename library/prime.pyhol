theorem prime_exp
  fixes n :: nat, p :: nat
  prop prime (p ^ n) ⟷ prime p ∧ n = 1
  [hint_rewrite]
  proof
    0: induction n nat_induct
    0: rewrite_goal nat_nat_power_def_1 sym=false
