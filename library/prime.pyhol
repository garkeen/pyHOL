    2.2: apply_forward_step conjD1 @2.1
    2.3: apply_forward_step conjD2 @2.1
    2.4: apply_forward_step conjD2 @2.0
    2.5: apply_backward_step disjE @2.4
    2.5: introduction
    2.5.1: apply_backward_step negE_gen @2.2,2.5.0
    2.6: introduction
    2.6.1: apply_backward_step disjE @2.6.0
    2.6.1: introduction
    2.6.1.1: apply_backward_step negE_gen @2.3,2.6.1.0
  qed

