  ← rewrite member_singleton goal=64
    #[65] !y. y = x | y Mem set xs --> x1 < y
  ← intro y goal=65
    #[66] y = x | y Mem set xs
    #[67] x1 < y
  ← cases "y = x" goal=67
    #[68] y = x --> x1 < y
    #[69] ~(y = x) --> x1 < y
  ← intro goal=68
    #[70] y = x
    #[71] x1 < y
  ← rewrite source=prev goal=71 facts=[70]
