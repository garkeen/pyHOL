  ← rewrite insert_comm loc=0.1 goal=42
    #[43] insert x (insert x1 (set xs)) = insert x1 (insert x (set xs))
qed

theorem ordered_insert_sorted
  fixes x :: 'a::linorder, ys :: 'a::linorder list
  prop strict_sorted ys ⟶ strict_sorted (ordered_insert x ys)
proof
  ← induct ys list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ([]::'a list) --> strict_sorted (ordered_insert x [])
    #[2] !x1. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs --> strict_sorted (ordered_insert x xs)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (x1 # xs) --> strict_sorted (ordered_insert x (x1 # xs))
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[6] strict_sorted ([]::'a list)
    #[7] strict_sorted (ordered_insert x [])
  ← rewrite ordered_insert_def_1 goal=7
    #[8] strict_sorted [x]
  ← rewrite strict_sorted_def_2 sym=false goal=8
    #[9] (!y. y Mem set [] --> x < y) & strict_sorted ([]::'a list)
  ← rule conjI goal=9
    #[10] !y. y Mem set [] --> x < y
  ← rewrite set_def_1 goal=10
    #[11] !y. y Mem {} --> x < y
  ← rewrite member_empty_simp goal=11
    #[12] !y. false --> x < y
  ← intro y goal=12
    #[13] _VAR y
    #[14] false
    #[15] x < y
  ← rule falseE goal=15 facts=[14]
    #[16] x < y
  ← intro x1,xs goal=2
    #[17] _VAR x1
    #[18] _VAR xs
    #[19] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs --> strict_sorted (ordered_insert x xs)
    #[20] strict_sorted (x1 # xs)
    #[21] strict_sorted (ordered_insert x (x1 # xs))
  ← rewrite ordered_insert_def_2 goal=21
    #[22] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  → forward strict_sorted_cons_head param_x=x1 param_xs=xs goal=22 facts=[3,4,5,20]
    #[23] !y. y Mem set xs --> x1 < y
  → forward strict_sorted_cons_tail param_x=x1 param_xs=xs goal=22 facts=[3,4,5,20]
    #[24] strict_sorted xs
  → forward goal=22 facts=[19,3]
    #[25] linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs --> strict_sorted (ordered_insert x xs)
  → forward goal=22 facts=[25,4]
    #[26] linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs --> strict_sorted (ordered_insert x xs)
  → forward goal=22 facts=[26,5]
    #[27] strict_sorted xs --> strict_sorted (ordered_insert x xs)
  ← cases "x = x1" goal=22
    #[28] x = x1 --> strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
    #[29] ~(x = x1) --> strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← intro goal=28
    #[30] x = x1
    #[31] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_P goal=31 facts=[30]
  ← intro goal=29
    #[32] ~(x = x1)
    #[33] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← cases "x < x1" goal=33
    #[34] x < x1 --> strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
    #[35] ~(x < x1) --> strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← intro goal=34
    #[36] x < x1
    #[37] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_not_P goal=37 facts=[32]
