theory lists_ex
imports list, order
description "Lists, examples (auto2 Lists_Ex.thy): strict_sorted and ordered_insert."

-- Port of auto2's Lists_Ex.thy, the part that does not need Mapping_Str.  The
-- statement style follows auto2: the order constraint is written `'a::linorder`,
-- which the item layer turns into the two class premises (see
-- PROGRAM_VERIFICATION_PORT.md §11):
--
--     linorder (less_eq::'a ⇒ 'a ⇒ bool) ⟶
--     linorder_lt (less::'a ⇒ 'a ⇒ bool) ⟶ <prop>
--
-- so a proof about `<` uses `linorder_lt_*` (library/order.pyhol) and a use site
-- discharges both premises with `nat_linorder` / `nat_linorder_lt`.
--
-- auto2 defines `sorted`?  No -- the development only uses `strict_sorted` (the
-- plain `sorted` has zero uses in the ported manifest, see §8.1), so it is not
-- ported.

fun strict_sorted :: 'a list ⇒ bool
  | strict_sorted ([]::'a list) ⟷ true
  | strict_sorted (x # ys) ⟷ (∀y. y ∈ set ys ⟶ x < y) ∧ strict_sorted ys

theorem strict_sorted_appendE1
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted (xs @ ys) ⟶ strict_sorted xs ∧ strict_sorted ys
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ([] @ ys) --> strict_sorted ([]::'a list) & strict_sorted ys
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ((x # xs) @ ys) --> strict_sorted (x # xs) & strict_sorted ys
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] strict_sorted ([] @ ys)
    #[6] strict_sorted ([]::'a list) & strict_sorted ys
  ← rule conjI goal=6
    #[7] strict_sorted ([]::'a list)
    #[8] strict_sorted ys
  ← rewrite strict_sorted_def_1 goal=7
    #[9] true
  ← rule trueI goal=9
    #[10] true
  ← rewrite append_def_1 sym=true goal=8
  ← intro x,xs goal=2
    #[11] _VAR x
    #[12] _VAR xs
    #[13] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
    #[14] strict_sorted ((x # xs) @ ys)
    #[15] strict_sorted (x # xs) & strict_sorted ys
  → rewrite append_def_2 sym=false target=fact goal=15 facts=[14]
    #[16] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=15 facts=[16]
    #[17] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD1 goal=15 facts=[17]
    #[18] !y. y Mem set (xs @ ys) --> x < y
  → forward goal=15 facts=[13,3]
    #[19] linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
  → forward goal=15 facts=[19,4]
    #[20] strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
  → forward conjD2 goal=15 facts=[17]
    #[21] strict_sorted (xs @ ys)
  → forward goal=15 facts=[20,21]
    #[22] strict_sorted xs & strict_sorted ys
  → forward conjD1 goal=15 facts=[22]
    #[23] strict_sorted xs
  → forward conjD2 goal=15 facts=[22]
    #[24] strict_sorted ys
  ← rule conjI goal=15
    #[25] strict_sorted (x # xs)
  ← rewrite strict_sorted_def_2 sym=false goal=25
    #[26] (!y. y Mem set xs --> x < y) & strict_sorted xs
  ← rule conjI goal=26
    #[27] !y. y Mem set xs --> x < y
  ← intro y goal=27
    #[28] _VAR y
    #[29] y Mem set xs
    #[30] x < y
  → forward member_set_append_left param_x=y param_xs=xs param_ys=ys goal=30
    #[31] y Mem set xs --> y Mem set (xs @ ys)
  → forward goal=30 facts=[31,29]
    #[32] y Mem set (xs @ ys)
  ← rule all_mem_elim goal=30 facts=[18,32]
    #[33] x < y
qed

-- Destructors for a list whose head is followed by an append.  auto2 gets
-- these from its rewrite engine; here they are two lemmas, which also keeps
-- the two branches of an induction on `xs` from forging the *same*
-- intermediate propositions (stable IDs are assigned per proposition, so a
-- shared intermediate between two branches is only reachable from one).

theorem strict_sorted_append_head
  fixes x :: 'a::linorder, xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted ((x # xs) @ ys) ⟶ (∀y. y Mem set (xs @ ys) ⟶ x < y)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] strict_sorted ((x # xs) @ ys)
    #[4] !y. y Mem set (xs @ ys) --> x < y
  → rewrite append_def_2 sym=false target=fact goal=4 facts=[3]
    #[5] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=4 facts=[5]
    #[6] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD1 goal=4 facts=[6]
    #[7] !y. y Mem set (xs @ ys) --> x < y
qed

theorem strict_sorted_append_tail
  fixes x :: 'a::linorder, xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted ((x # xs) @ ys) ⟶ strict_sorted (xs @ ys)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] strict_sorted ((x # xs) @ ys)
    #[4] strict_sorted (xs @ ys)
  → rewrite append_def_2 sym=false target=fact goal=4 facts=[3]
    #[5] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=4 facts=[5]
    #[6] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD2 goal=4 facts=[6]
    #[7] strict_sorted (xs @ ys)
qed

theorem strict_sorted_appendE2
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list, x :: 'a
  prop strict_sorted (xs @ ys) ⟶ x Mem set xs ⟶ (∀y. y Mem set ys ⟶ x < y)
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ([] @ ys) --> x Mem set [] --> (!y. y Mem set ys --> x < y)
    #[2] !x1. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ((x1 # xs) @ ys) --> x Mem set (x1 # xs) --> (!y. y Mem set ys --> x < y)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] strict_sorted ([] @ ys)
    #[6] x Mem set []
    #[7] !y. y Mem set ys --> x < y
  → rewrite set_def_1 sym=false target=fact goal=7 facts=[6]
    #[8] x Mem {}
  → rewrite member_empty_simp sym=false target=fact goal=7 facts=[8]
    #[9] false
  ← rule falseE goal=7 facts=[9]
    #[10] !y. y Mem set ys --> x < y
  ← intro x1,xs goal=2
    #[11] _VAR x1
    #[12] _VAR xs
    #[13] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
    #[14] strict_sorted ((x1 # xs) @ ys)
    #[15] x Mem set (x1 # xs)
    #[16] !y. y Mem set ys --> x < y
  ← cases "x Mem set xs" goal=16
    #[17] x Mem set xs --> (!y. y Mem set ys --> x < y)
    #[18] ~(x Mem set xs) --> (!y. y Mem set ys --> x < y)
  ← intro goal=17
    #[19] x Mem set xs
    #[20] !y. y Mem set ys --> x < y
  → forward goal=20 facts=[13,3]
    #[21] linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
  → forward goal=20 facts=[21,4]
    #[22] strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
  → forward strict_sorted_append_tail param_x=x1 param_xs=xs param_ys=ys goal=20 facts=[3,4,14]
    #[23] strict_sorted (xs @ ys)
  → forward goal=20 facts=[22,23]
    #[24] x Mem set xs --> (!y. y Mem set ys --> x < y)
  ← apply_prev goal=20 facts=[24,19]
    #[25] !y. y Mem set ys --> x < y
  ← intro goal=18
    #[26] ~(x Mem set xs)
    #[27] !y. y Mem set ys --> x < y
  → forward strict_sorted_append_head param_x=x1 param_xs=xs param_ys=ys goal=27 facts=[3,4,14]
    #[28] !y. y Mem set (xs @ ys) --> x1 < y
  → rewrite member_set_cons sym=false target=fact goal=27 facts=[15]
    #[29] x = x1 | x Mem set xs
  → forward force_disj_true1 goal=27 facts=[29,26]
    #[30] x = x1
  ← intro y goal=27
    #[31] _VAR y
    #[32] y Mem set ys
    #[33] x < y
  ← rewrite source=prev goal=33 facts=[30]
    #[34] x1 < y
  → forward member_set_append_right param_x=y param_xs=xs param_ys=ys goal=34 facts=[32]
    #[35] y Mem set (xs @ ys)
  ← rule all_mem_elim goal=34 facts=[28,35]
    #[36] x1 < y
qed
