  → forward linorder_lt_trans goal=50 facts=[4,36,53]
    #[54] x < y
  ← intro goal=35
    #[55] ~(x < x1)
    #[56] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_not_P goal=56 facts=[32]
    #[57] strict_sorted (if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_not_P goal=57 facts=[55]
    #[58] strict_sorted (x1 # ordered_insert x xs)
  ← rewrite strict_sorted_def_2 sym=false goal=58
    #[59] (!y. y Mem set (ordered_insert x xs) --> x1 < y) & strict_sorted (ordered_insert x xs)
  ← rule conjI goal=59
    #[60] !y. y Mem set (ordered_insert x xs) --> x1 < y
    #[61] strict_sorted (ordered_insert x xs)
  ← apply_prev goal=61 facts=[27,24]
    #[62] strict_sorted (ordered_insert x xs)
  ← rewrite ordered_insert_set goal=60
    #[63] !y. y Mem {x} Un set xs --> x1 < y
  ← rewrite member_union_iff goal=63
