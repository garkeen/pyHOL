theory lists_ex
imports list, order
description "Lists, examples (auto2 Lists_Ex.thy): strict_sorted, ordered_insert, remove_elt_list, sorted."

-- Port of auto2's Lists_Ex.thy, the part that does not need Mapping_Str.  The
-- statement style follows auto2: the order constraint is written `'a::linorder`,
-- which the item layer turns into the class premises declared by the `class`
-- items in library/order.pyhol (see PROGRAM_VERIFICATION_PORT.md §11, §14):
--
--     linorder (less_eq::'a ⇒ 'a ⇒ bool) ⟶
--     linorder_lt (less::'a ⇒ 'a ⇒ bool) ⟶
--     linorder_lt_le (less_eq::'a ⇒ 'a ⇒ bool) (less::'a ⇒ 'a ⇒ bool) ⟶ <prop>
--
-- so a proof about `<` uses `linorder_lt_*`, a proof mixing `<` and `<=` uses
-- `linorder_lt_imp_le` (library/order.pyhol), and a use site discharges the
-- premises with `nat_linorder` / `nat_linorder_lt` / `nat_linorder_lt_le`.
--
-- auto2's Lists_Ex.thy defines `strict_sorted` only, but `sorted` (the `<=`
-- version, from Isabelle's List.thy) is ported here as well: auto2's
-- development uses it in Quicksort (4x), LinkedList (4x) and Rect_Intersect
-- (1x).  See PROGRAM_VERIFICATION_PORT.md §8.1.
--
-- Set difference can be written `A - B` here: `-` is the overloaded arithmetic
-- operator and library/set.pyhol gives it a set instance (`A - B = diff A B`,
-- theorem `fun_minus_def`), so auto2's statements transcribe literally.  See
-- PROGRAM_VERIFICATION_PORT.md §13.4 for the mechanism and its boundary.

fun strict_sorted :: 'a list ⇒ bool
  | strict_sorted ([]::'a list) ⟷ true
  | strict_sorted (x # ys) ⟷ (∀y. y ∈ set ys ⟶ x < y) ∧ strict_sorted ys

-- Destructors for the cons case.  auto2 unfolds the definition with its
-- rewrite engine; here each half is a lemma, which also keeps two branches of
-- one induction from deriving the *same* intermediate proposition (stable IDs
-- are assigned per proposition, so a shared intermediate is reachable from
-- only one branch -- see PROGRAM_VERIFICATION_PORT.md §12.1.1).

theorem strict_sorted_cons_head
  fixes x :: 'a::linorder, xs :: 'a::linorder list
  prop strict_sorted (x # xs) ⟶ (∀y. y ∈ set xs ⟶ x < y)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[4] strict_sorted (x # xs)
    #[5] !y. y Mem set xs --> x < y
  → rewrite strict_sorted_def_2 sym=false target=fact goal=5 facts=[4]
    #[6] (!y. y Mem set xs --> x < y) & strict_sorted xs
  → forward conjD1 goal=5 facts=[6]
    #[7] !y. y Mem set xs --> x < y
qed

theorem strict_sorted_cons_tail
  fixes x :: 'a::linorder, xs :: 'a::linorder list
  prop strict_sorted (x # xs) ⟶ strict_sorted xs
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[4] strict_sorted (x # xs)
    #[5] strict_sorted xs
  → rewrite strict_sorted_def_2 sym=false target=fact goal=5 facts=[4]
    #[6] (!y. y Mem set xs --> x < y) & strict_sorted xs
  → forward conjD2 goal=5 facts=[6]
    #[7] strict_sorted xs
qed

theorem strict_sorted_appendI
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted xs ∧ strict_sorted ys ∧ (∀a. a ∈ set xs ⟶ (∀b. b ∈ set ys ⟶ a < b)) ⟶ strict_sorted (xs @ ys)
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ([]::'a list) & strict_sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a < b)) --> strict_sorted ([] @ ys)
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (x # xs) & strict_sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a < b)) --> strict_sorted ((x # xs) @ ys)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[6] strict_sorted ([]::'a list) & strict_sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a < b))
    #[7] strict_sorted ([] @ ys)
  ← rewrite append_def_1 goal=7
    #[8] strict_sorted ys
  → forward conjD2 goal=8 facts=[6]
    #[9] strict_sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a < b))
  ← rule conjD1 goal=8 facts=[9]
    #[10] strict_sorted ys
  ← intro x,xs goal=2
    #[11] _VAR x
    #[12] _VAR xs
    #[13] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)
    #[14] strict_sorted (x # xs) & strict_sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a < b))
    #[15] strict_sorted ((x # xs) @ ys)
  → forward conjD1 goal=15 facts=[14]
    #[16] strict_sorted (x # xs)
  → forward conjD2 goal=15 facts=[14]
    #[17] strict_sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a < b))
  → forward conjD1 goal=15 facts=[17]
    #[18] strict_sorted ys
  → forward conjD2 goal=15 facts=[17]
    #[19] !a. a Mem set (x # xs) --> (!b. b Mem set ys --> a < b)
  → forward strict_sorted_cons_head param_x=x param_xs=xs goal=15 facts=[3,4,5,16]
    #[20] !y. y Mem set xs --> x < y
  → forward strict_sorted_cons_tail param_x=x param_xs=xs goal=15 facts=[3,4,5,16]
    #[21] strict_sorted xs
  → forward mem_set_cons_self param_x=x param_xs=xs goal=15
    #[22] x Mem set (x # xs)
  ← inst x goal=15 facts=[19]
    #[23] x Mem set (x # xs) --> (!b. b Mem set ys --> x < b)
  → forward goal=15 facts=[23,22]
    #[24] !b. b Mem set ys --> x < b
  cut "∀a. a ∈ set xs ⟶ (∀b. b ∈ set ys ⟶ a < b)" goal=15
    #[25] !a. a Mem set xs --> (!b. b Mem set ys --> a < b)
  ← intro a goal=25
    #[26] _VAR a
    #[27] a Mem set xs
    #[28] !b. b Mem set ys --> a < b
  ← intro b goal=28
    #[29] _VAR b
    #[30] b Mem set ys
    #[31] a < b
  → forward mem_set_cons_weak param_x=x param_xs=xs param_z=a goal=31 facts=[27]
    #[32] a Mem set (x # xs)
  ← inst a goal=31 facts=[19]
    #[33] a Mem set (x # xs) --> (!b. b Mem set ys --> a < b)
  → forward goal=31 facts=[33,32]
    #[34] !b. b Mem set ys --> a < b
  ← rule all_mem_elim goal=31 facts=[34,30]
    #[35] a < b
  → forward conjI goal=15 facts=[18,25]
    #[36] strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b))
  → forward conjI goal=15 facts=[21,36]
    #[37] strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b))
  → forward goal=15 facts=[13,3]
    #[38] linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)
  → forward goal=15 facts=[38,4]
    #[39] linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)
  → forward goal=15 facts=[39,5]
    #[40] strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)
  ← rewrite append_def_2 goal=15
    #[41] strict_sorted (x # xs @ ys)
  ← rewrite strict_sorted_def_2 sym=false goal=41
    #[42] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  ← rule conjI goal=42
    #[43] !y. y Mem set (xs @ ys) --> x < y
    #[44] strict_sorted (xs @ ys)
  ← apply_prev goal=44 facts=[40,37]
  ← rewrite member_set_append sym=false goal=43
    #[45] !y. y Mem set xs | y Mem set ys --> x < y
  ← intro y goal=45
    #[46] _VAR y
    #[47] y Mem set xs | y Mem set ys
    #[48] x < y
  ← cases "y ∈ set xs" goal=48
    #[49] y Mem set xs --> x < y
    #[50] ~(y Mem set xs) --> x < y
  ← intro goal=49
    #[51] y Mem set xs
    #[52] x < y
  ← rule all_mem_elim goal=52 facts=[20,51]
    #[53] x < y
  ← intro goal=50
    #[54] ~(y Mem set xs)
    #[55] x < y
  → rewrite disj_comm sym=false target=fact goal=55 facts=[47]
    #[56] y Mem set ys | y Mem set xs
  → forward force_disj_true1 goal=55 facts=[56,54]
    #[57] y Mem set ys
  ← rule all_mem_elim goal=55 facts=[24,57]
    #[58] x < y
qed

theorem strict_sorted_appendE1
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted (xs @ ys) ⟶ strict_sorted xs ∧ strict_sorted ys
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ([] @ ys) --> strict_sorted ([]::'a list) & strict_sorted ys
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ((x # xs) @ ys) --> strict_sorted (x # xs) & strict_sorted ys
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[6] strict_sorted ([] @ ys)
    #[7] strict_sorted ([]::'a list) & strict_sorted ys
  ← rule conjI goal=7
    #[8] strict_sorted ([]::'a list)
    #[9] strict_sorted ys
  ← rewrite strict_sorted_def_1 goal=8
    #[10] true
  ← rule trueI goal=10
    #[11] true
  ← rewrite append_def_1 sym=true goal=9
  ← intro x,xs goal=2
    #[12] _VAR x
    #[13] _VAR xs
    #[14] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
    #[15] strict_sorted ((x # xs) @ ys)
    #[16] strict_sorted (x # xs) & strict_sorted ys
  → rewrite append_def_2 sym=false target=fact goal=16 facts=[15]
    #[17] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=16 facts=[17]
    #[18] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD1 goal=16 facts=[18]
    #[19] !y. y Mem set (xs @ ys) --> x < y
  → forward goal=16 facts=[14,3]
    #[20] linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
  → forward goal=16 facts=[20,4]
    #[21] linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
  → forward goal=16 facts=[21,5]
    #[22] strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
  → forward conjD2 goal=16 facts=[18]
    #[23] strict_sorted (xs @ ys)
  → forward goal=16 facts=[22,23]
    #[24] strict_sorted xs & strict_sorted ys
  → forward conjD1 goal=16 facts=[24]
    #[25] strict_sorted xs
  → forward conjD2 goal=16 facts=[24]
    #[26] strict_sorted ys
  ← rule conjI goal=16
    #[27] strict_sorted (x # xs)
  ← rewrite strict_sorted_def_2 sym=false goal=27
    #[28] (!y. y Mem set xs --> x < y) & strict_sorted xs
  ← rule conjI goal=28
    #[29] !y. y Mem set xs --> x < y
  ← intro y goal=29
    #[30] _VAR y
    #[31] y Mem set xs
    #[32] x < y
  → forward member_set_append_left param_x=y param_xs=xs param_ys=ys goal=32
    #[33] y Mem set xs --> y Mem set (xs @ ys)
  → forward goal=32 facts=[33,31]
    #[34] y Mem set (xs @ ys)
  ← rule all_mem_elim goal=32 facts=[19,34]
    #[35] x < y
qed

-- Destructors for a list whose head is followed by an append.  auto2 gets
-- these from its rewrite engine; here they are two lemmas, which also keeps
-- the two branches of an induction on `xs` from forging the *same*
-- intermediate propositions (stable IDs are assigned per proposition, so a
-- shared intermediate between two branches is only reachable from one).

theorem strict_sorted_append_head
  fixes x :: 'a::linorder, xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted ((x # xs) @ ys) ⟶ (∀y. y ∈ set (xs @ ys) ⟶ x < y)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[4] strict_sorted ((x # xs) @ ys)
    #[5] !y. y Mem set (xs @ ys) --> x < y
  → rewrite append_def_2 sym=false target=fact goal=5 facts=[4]
    #[6] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=5 facts=[6]
    #[7] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD1 goal=5 facts=[7]
    #[8] !y. y Mem set (xs @ ys) --> x < y
qed

theorem strict_sorted_append_tail
  fixes x :: 'a::linorder, xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted ((x # xs) @ ys) ⟶ strict_sorted (xs @ ys)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[4] strict_sorted ((x # xs) @ ys)
    #[5] strict_sorted (xs @ ys)
  → rewrite append_def_2 sym=false target=fact goal=5 facts=[4]
    #[6] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=5 facts=[6]
    #[7] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD2 goal=5 facts=[7]
    #[8] strict_sorted (xs @ ys)
qed

theorem strict_sorted_appendE2
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list, x :: 'a
  prop strict_sorted (xs @ ys) ⟶ x ∈ set xs ⟶ (∀y. y ∈ set ys ⟶ x < y)
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ([] @ ys) --> x Mem set [] --> (!y. y Mem set ys --> x < y)
    #[2] !x1. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ((x1 # xs) @ ys) --> x Mem set (x1 # xs) --> (!y. y Mem set ys --> x < y)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[6] strict_sorted ([] @ ys)
    #[7] x Mem set []
    #[8] !y. y Mem set ys --> x < y
  → rewrite set_def_1 sym=false target=fact goal=8 facts=[7]
    #[9] x Mem {}
  → rewrite member_empty_simp sym=false target=fact goal=8 facts=[9]
    #[10] false
  ← rule falseE goal=8 facts=[10]
    #[11] !y. y Mem set ys --> x < y
  ← intro x1,xs goal=2
    #[12] _VAR x1
    #[13] _VAR xs
    #[14] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
    #[15] strict_sorted ((x1 # xs) @ ys)
    #[16] x Mem set (x1 # xs)
    #[17] !y. y Mem set ys --> x < y
  ← cases "x Mem set xs" goal=17
    #[18] x Mem set xs --> (!y. y Mem set ys --> x < y)
    #[19] ~(x Mem set xs) --> (!y. y Mem set ys --> x < y)
  ← intro goal=18
    #[20] x Mem set xs
    #[21] !y. y Mem set ys --> x < y
  → forward goal=21 facts=[14,3]
    #[22] linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
  → forward goal=21 facts=[22,4]
    #[23] linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
  → forward goal=21 facts=[23,5]
    #[24] strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
  → forward strict_sorted_append_tail param_x=x1 param_xs=xs param_ys=ys goal=21 facts=[3,4,5,15]
    #[25] strict_sorted (xs @ ys)
  → forward goal=21 facts=[24,25]
    #[26] x Mem set xs --> (!y. y Mem set ys --> x < y)
  ← apply_prev goal=21 facts=[26,20]
    #[27] !y. y Mem set ys --> x < y
  ← intro goal=19
    #[28] ~(x Mem set xs)
    #[29] !y. y Mem set ys --> x < y
  → forward strict_sorted_append_head param_x=x1 param_xs=xs param_ys=ys goal=29 facts=[3,4,5,15]
    #[30] !y. y Mem set (xs @ ys) --> x1 < y
  → rewrite member_set_cons sym=false target=fact goal=29 facts=[16]
    #[31] x = x1 | x Mem set xs
  → forward force_disj_true1 goal=29 facts=[31,28]
    #[32] x = x1
  ← intro y goal=29
    #[33] _VAR y
    #[34] y Mem set ys
    #[35] x < y
  ← rewrite source=prev goal=35 facts=[32]
    #[36] x1 < y
  → forward member_set_append_right param_x=y param_xs=xs param_ys=ys goal=36 facts=[34]
    #[37] y Mem set (xs @ ys)
  ← rule all_mem_elim goal=36 facts=[30,37]
    #[38] x1 < y
qed

theorem strict_sorted_distinct
  fixes l :: 'a::linorder list
  prop strict_sorted l ⟶ distinct l
proof
  ← induct l list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ([]::'a list) --> distinct ([]::'a list)
    #[2] !x::'a. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs --> distinct xs) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (x # xs) --> distinct (x # xs)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[6] strict_sorted ([]::'a list)
    #[7] distinct ([]::'a list)
  ← intro x,xs goal=2
    #[8] _VAR x
    #[9] _VAR xs
    #[10] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs --> distinct xs
    #[11] strict_sorted (x # xs)
    #[12] distinct (x # xs)
  ← rewrite distinct_def_1 goal=7
    #[13] true
  ← rule trueI goal=13
    #[14] true
  ← rewrite distinct_def_2 sym=false goal=12
    #[15] ~(x Mem set xs) & distinct xs
  → forward strict_sorted_cons_head param_x=x param_xs=xs goal=15 facts=[3,4,5,11]
    #[16] !y. y Mem set xs --> x < y
  → forward strict_sorted_cons_tail param_x=x param_xs=xs goal=15 facts=[3,4,5,11]
    #[17] strict_sorted xs
  → forward goal=15 facts=[10,3]
    #[18] linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs --> distinct xs
  → forward linorder_lt_irrefl param_x=x goal=15 facts=[4]
    #[19] ~(x < x)
  → forward goal=15 facts=[18,4,5]
    #[20] strict_sorted xs --> distinct xs
  ← rule conjI goal=15
    #[21] ~(x Mem set xs)
    #[22] distinct xs
  ← apply_prev goal=22 facts=[20,17]
  ← rule negI goal=21
    #[23] x Mem set xs --> false
  ← intro goal=23
    #[24] x Mem set xs
    #[25] false
  ← inst x goal=25 facts=[16]
    #[26] x Mem set xs --> x < x
  → forward goal=25 facts=[26,24]
    #[27] x < x
  ← rule negE_gen goal=25 facts=[19,27]
