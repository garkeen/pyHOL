theory lists_ex
imports list, order
description "Lists, examples (auto2 Lists_Ex.thy): strict_sorted, ordered_insert, remove_elt_list, sorted."

-- Port of auto2's Lists_Ex.thy, the part that does not need Mapping_Str.  The
-- statement style follows auto2: the order constraint is written `'a::linorder`,
-- which the item layer turns into the two class premises (see
-- PROGRAM_VERIFICATION_PORT.md §11):
--
--     linorder (less_eq::'a ⇒ 'a ⇒ bool) ⟶
--     linorder_lt (less::'a ⇒ 'a ⇒ bool) ⟶ <prop>
--
-- so a proof about `<` uses `linorder_lt_*` (library/order.pyhol) and a use site
-- discharges both premises with `nat_linorder` / `nat_linorder_lt`.
--
-- auto2's Lists_Ex.thy defines `strict_sorted` only, but `sorted` (the `<=`
-- version, from Isabelle's List.thy) is ported here as well: auto2's
-- development uses it in Quicksort (4x), LinkedList (4x) and Rect_Intersect
-- (1x).  See PROGRAM_VERIFICATION_PORT.md §8.1.
--
-- Set difference is spelled `diff A B` in holpy -- `-` parses as arithmetic
-- subtraction -- so auto2's `set ys - {x}` is `diff (set ys) {x}` here.

fun strict_sorted :: 'a list ⇒ bool
  | strict_sorted ([]::'a list) ⟷ true
  | strict_sorted (x # ys) ⟷ (∀y. y ∈ set ys ⟶ x < y) ∧ strict_sorted ys

-- Destructors for the cons case.  auto2 unfolds the definition with its
-- rewrite engine; here each half is a lemma, which also keeps two branches of
-- one induction from deriving the *same* intermediate proposition (stable IDs
-- are assigned per proposition, so a shared intermediate is reachable from
-- only one branch -- see PROGRAM_VERIFICATION_PORT.md §12.1.1).

theorem strict_sorted_cons_head
  fixes x :: 'a::linorder, xs :: 'a::linorder list
  prop strict_sorted (x # xs) ⟶ (∀y. y ∈ set xs ⟶ x < y)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] strict_sorted (x # xs)
    #[4] !y. y Mem set xs --> x < y
  → rewrite strict_sorted_def_2 sym=false target=fact goal=4 facts=[3]
    #[5] (!y. y Mem set xs --> x < y) & strict_sorted xs
  → forward conjD1 goal=4 facts=[5]
    #[6] !y. y Mem set xs --> x < y
qed

theorem strict_sorted_cons_tail
  fixes x :: 'a::linorder, xs :: 'a::linorder list
  prop strict_sorted (x # xs) ⟶ strict_sorted xs
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] strict_sorted (x # xs)
    #[4] strict_sorted xs
  → rewrite strict_sorted_def_2 sym=false target=fact goal=4 facts=[3]
    #[5] (!y. y Mem set xs --> x < y) & strict_sorted xs
  → forward conjD2 goal=4 facts=[5]
    #[6] strict_sorted xs
qed

theorem strict_sorted_appendI
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted xs ∧ strict_sorted ys ∧ (∀a. a ∈ set xs ⟶ (∀b. b ∈ set ys ⟶ a < b)) ⟶ strict_sorted (xs @ ys)
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ([]::'a list) & strict_sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a < b)) --> strict_sorted ([] @ ys)
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (x # xs) & strict_sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a < b)) --> strict_sorted ((x # xs) @ ys)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] strict_sorted ([]::'a list) & strict_sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a < b))
    #[6] strict_sorted ([] @ ys)
  ← rewrite append_def_1 goal=6
    #[7] strict_sorted ys
  → forward conjD2 goal=7 facts=[5]
    #[8] strict_sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a < b))
  ← rule conjD1 goal=7 facts=[8]
    #[9] strict_sorted ys
  ← intro x,xs goal=2
    #[10] _VAR x
    #[11] _VAR xs
    #[12] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)
    #[13] strict_sorted (x # xs) & strict_sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a < b))
    #[14] strict_sorted ((x # xs) @ ys)
  → forward conjD1 goal=14 facts=[13]
    #[15] strict_sorted (x # xs)
  → forward conjD2 goal=14 facts=[13]
    #[16] strict_sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a < b))
  → forward conjD1 goal=14 facts=[16]
    #[17] strict_sorted ys
  → forward conjD2 goal=14 facts=[16]
    #[18] !a. a Mem set (x # xs) --> (!b. b Mem set ys --> a < b)
  → forward strict_sorted_cons_head param_x=x param_xs=xs goal=14 facts=[3,4,15]
    #[19] !y. y Mem set xs --> x < y
  → forward strict_sorted_cons_tail param_x=x param_xs=xs goal=14 facts=[3,4,15]
    #[20] strict_sorted xs
  → forward mem_set_cons_self param_x=x param_xs=xs goal=14
    #[21] x Mem set (x # xs)
  ← inst x goal=14 facts=[18]
    #[22] x Mem set (x # xs) --> (!b. b Mem set ys --> x < b)
  → forward goal=14 facts=[22,21]
    #[23] !b. b Mem set ys --> x < b
  cut "∀a. a ∈ set xs ⟶ (∀b. b ∈ set ys ⟶ a < b)" goal=14
    #[24] !a. a Mem set xs --> (!b. b Mem set ys --> a < b)
  ← intro a goal=24
    #[25] _VAR a
    #[26] a Mem set xs
    #[27] !b. b Mem set ys --> a < b
  ← intro b goal=27
    #[28] _VAR b
    #[29] b Mem set ys
    #[30] a < b
  → forward mem_set_cons_weak param_x=x param_xs=xs param_z=a goal=30 facts=[26]
    #[31] a Mem set (x # xs)
  ← inst a goal=30 facts=[18]
    #[32] a Mem set (x # xs) --> (!b. b Mem set ys --> a < b)
  → forward goal=30 facts=[32,31]
    #[33] !b. b Mem set ys --> a < b
  ← rule all_mem_elim goal=30 facts=[33,29]
    #[34] a < b
  → forward conjI goal=14 facts=[17,24]
    #[35] strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b))
  → forward conjI goal=14 facts=[20,35]
    #[36] strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b))
  → forward goal=14 facts=[12,3]
    #[37] linorder_lt (less::'a => 'a => bool) --> strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)
  → forward goal=14 facts=[37,4]
    #[38] strict_sorted xs & strict_sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a < b)) --> strict_sorted (xs @ ys)
  ← rewrite append_def_2 goal=14
    #[39] strict_sorted (x # xs @ ys)
  ← rewrite strict_sorted_def_2 sym=false goal=39
    #[40] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  ← rule conjI goal=40
    #[41] !y. y Mem set (xs @ ys) --> x < y
    #[42] strict_sorted (xs @ ys)
  ← apply_prev goal=42 facts=[38,36]
  ← rewrite member_set_append sym=false goal=41
    #[43] !y. y Mem set xs | y Mem set ys --> x < y
  ← intro y goal=43
    #[44] _VAR y
    #[45] y Mem set xs | y Mem set ys
    #[46] x < y
  ← cases "y ∈ set xs" goal=46
    #[47] y Mem set xs --> x < y
    #[48] ~(y Mem set xs) --> x < y
  ← intro goal=47
    #[49] y Mem set xs
    #[50] x < y
  ← rule all_mem_elim goal=50 facts=[19,49]
    #[51] x < y
  ← intro goal=48
    #[52] ~(y Mem set xs)
    #[53] x < y
  → rewrite disj_comm sym=false target=fact goal=53 facts=[45]
    #[54] y Mem set ys | y Mem set xs
  → forward force_disj_true1 goal=53 facts=[54,52]
    #[55] y Mem set ys
  ← rule all_mem_elim goal=53 facts=[23,55]
    #[56] x < y
qed

theorem strict_sorted_appendE1
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted (xs @ ys) ⟶ strict_sorted xs ∧ strict_sorted ys
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ([] @ ys) --> strict_sorted ([]::'a list) & strict_sorted ys
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ((x # xs) @ ys) --> strict_sorted (x # xs) & strict_sorted ys
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] strict_sorted ([] @ ys)
    #[6] strict_sorted ([]::'a list) & strict_sorted ys
  ← rule conjI goal=6
    #[7] strict_sorted ([]::'a list)
    #[8] strict_sorted ys
  ← rewrite strict_sorted_def_1 goal=7
    #[9] true
  ← rule trueI goal=9
    #[10] true
  ← rewrite append_def_1 sym=true goal=8
  ← intro x,xs goal=2
    #[11] _VAR x
    #[12] _VAR xs
    #[13] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
    #[14] strict_sorted ((x # xs) @ ys)
    #[15] strict_sorted (x # xs) & strict_sorted ys
  → rewrite append_def_2 sym=false target=fact goal=15 facts=[14]
    #[16] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=15 facts=[16]
    #[17] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD1 goal=15 facts=[17]
    #[18] !y. y Mem set (xs @ ys) --> x < y
  → forward goal=15 facts=[13,3]
    #[19] linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
  → forward goal=15 facts=[19,4]
    #[20] strict_sorted (xs @ ys) --> strict_sorted xs & strict_sorted ys
  → forward conjD2 goal=15 facts=[17]
    #[21] strict_sorted (xs @ ys)
  → forward goal=15 facts=[20,21]
    #[22] strict_sorted xs & strict_sorted ys
  → forward conjD1 goal=15 facts=[22]
    #[23] strict_sorted xs
  → forward conjD2 goal=15 facts=[22]
    #[24] strict_sorted ys
  ← rule conjI goal=15
    #[25] strict_sorted (x # xs)
  ← rewrite strict_sorted_def_2 sym=false goal=25
    #[26] (!y. y Mem set xs --> x < y) & strict_sorted xs
  ← rule conjI goal=26
    #[27] !y. y Mem set xs --> x < y
  ← intro y goal=27
    #[28] _VAR y
    #[29] y Mem set xs
    #[30] x < y
  → forward member_set_append_left param_x=y param_xs=xs param_ys=ys goal=30
    #[31] y Mem set xs --> y Mem set (xs @ ys)
  → forward goal=30 facts=[31,29]
    #[32] y Mem set (xs @ ys)
  ← rule all_mem_elim goal=30 facts=[18,32]
    #[33] x < y
qed

-- Destructors for a list whose head is followed by an append.  auto2 gets
-- these from its rewrite engine; here they are two lemmas, which also keeps
-- the two branches of an induction on `xs` from forging the *same*
-- intermediate propositions (stable IDs are assigned per proposition, so a
-- shared intermediate between two branches is only reachable from one).

theorem strict_sorted_append_head
  fixes x :: 'a::linorder, xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted ((x # xs) @ ys) ⟶ (∀y. y Mem set (xs @ ys) ⟶ x < y)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] strict_sorted ((x # xs) @ ys)
    #[4] !y. y Mem set (xs @ ys) --> x < y
  → rewrite append_def_2 sym=false target=fact goal=4 facts=[3]
    #[5] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=4 facts=[5]
    #[6] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD1 goal=4 facts=[6]
    #[7] !y. y Mem set (xs @ ys) --> x < y
qed

theorem strict_sorted_append_tail
  fixes x :: 'a::linorder, xs :: 'a::linorder list, ys :: 'a::linorder list
  prop strict_sorted ((x # xs) @ ys) ⟶ strict_sorted (xs @ ys)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] strict_sorted ((x # xs) @ ys)
    #[4] strict_sorted (xs @ ys)
  → rewrite append_def_2 sym=false target=fact goal=4 facts=[3]
    #[5] strict_sorted (x # xs @ ys)
  → rewrite strict_sorted_def_2 sym=false target=fact goal=4 facts=[5]
    #[6] (!y. y Mem set (xs @ ys) --> x < y) & strict_sorted (xs @ ys)
  → forward conjD2 goal=4 facts=[6]
    #[7] strict_sorted (xs @ ys)
qed

theorem strict_sorted_appendE2
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list, x :: 'a
  prop strict_sorted (xs @ ys) ⟶ x Mem set xs ⟶ (∀y. y Mem set ys ⟶ x < y)
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ([] @ ys) --> x Mem set [] --> (!y. y Mem set ys --> x < y)
    #[2] !x1. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ((x1 # xs) @ ys) --> x Mem set (x1 # xs) --> (!y. y Mem set ys --> x < y)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] strict_sorted ([] @ ys)
    #[6] x Mem set []
    #[7] !y. y Mem set ys --> x < y
  → rewrite set_def_1 sym=false target=fact goal=7 facts=[6]
    #[8] x Mem {}
  → rewrite member_empty_simp sym=false target=fact goal=7 facts=[8]
    #[9] false
  ← rule falseE goal=7 facts=[9]
    #[10] !y. y Mem set ys --> x < y
  ← intro x1,xs goal=2
    #[11] _VAR x1
    #[12] _VAR xs
    #[13] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
    #[14] strict_sorted ((x1 # xs) @ ys)
    #[15] x Mem set (x1 # xs)
    #[16] !y. y Mem set ys --> x < y
  ← cases "x Mem set xs" goal=16
    #[17] x Mem set xs --> (!y. y Mem set ys --> x < y)
    #[18] ~(x Mem set xs) --> (!y. y Mem set ys --> x < y)
  ← intro goal=17
    #[19] x Mem set xs
    #[20] !y. y Mem set ys --> x < y
  → forward goal=20 facts=[13,3]
    #[21] linorder_lt (less::'a => 'a => bool) --> strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
  → forward goal=20 facts=[21,4]
    #[22] strict_sorted (xs @ ys) --> x Mem set xs --> (!y. y Mem set ys --> x < y)
  → forward strict_sorted_append_tail param_x=x1 param_xs=xs param_ys=ys goal=20 facts=[3,4,14]
    #[23] strict_sorted (xs @ ys)
  → forward goal=20 facts=[22,23]
    #[24] x Mem set xs --> (!y. y Mem set ys --> x < y)
  ← apply_prev goal=20 facts=[24,19]
    #[25] !y. y Mem set ys --> x < y
  ← intro goal=18
    #[26] ~(x Mem set xs)
    #[27] !y. y Mem set ys --> x < y
  → forward strict_sorted_append_head param_x=x1 param_xs=xs param_ys=ys goal=27 facts=[3,4,14]
    #[28] !y. y Mem set (xs @ ys) --> x1 < y
  → rewrite member_set_cons sym=false target=fact goal=27 facts=[15]
    #[29] x = x1 | x Mem set xs
  → forward force_disj_true1 goal=27 facts=[29,26]
    #[30] x = x1
  ← intro y goal=27
    #[31] _VAR y
    #[32] y Mem set ys
    #[33] x < y
  ← rewrite source=prev goal=33 facts=[30]
    #[34] x1 < y
  → forward member_set_append_right param_x=y param_xs=xs param_ys=ys goal=34 facts=[32]
    #[35] y Mem set (xs @ ys)
  ← rule all_mem_elim goal=34 facts=[28,35]
    #[36] x1 < y
qed

theorem strict_sorted_distinct
  fixes l :: 'a::linorder list
  prop strict_sorted l ⟶ distinct l
proof
  ← induct l list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ([]::'a list) --> distinct ([]::'a list)
    #[2] !x::'a. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted xs --> distinct xs) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (x # xs) --> distinct (x # xs)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] strict_sorted ([]::'a list)
    #[6] distinct ([]::'a list)
  ← intro x,xs goal=2
    #[7] _VAR x
    #[8] _VAR xs
    #[9] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted xs --> distinct xs
    #[10] strict_sorted (x # xs)
    #[11] distinct (x # xs)
  ← rewrite distinct_def_1 goal=6
    #[12] true
  ← rule trueI goal=12
    #[13] true
  ← rewrite distinct_def_2 sym=false goal=11
    #[14] ~(x Mem set xs) & distinct xs
  → forward strict_sorted_cons_head param_x=x param_xs=xs goal=14 facts=[3,4,10]
    #[15] !y. y Mem set xs --> x < y
  → forward strict_sorted_cons_tail param_x=x param_xs=xs goal=14 facts=[3,4,10]
    #[16] strict_sorted xs
  → forward goal=14 facts=[9,3]
    #[17] linorder_lt (less::'a => 'a => bool) --> strict_sorted xs --> distinct xs
  → forward linorder_lt_irrefl param_x=x goal=14 facts=[4]
    #[18] ~(x < x)
  → forward goal=14 facts=[17,4]
    #[19] strict_sorted xs --> distinct xs
  ← rule conjI goal=14
    #[20] ~(x Mem set xs)
    #[21] distinct xs
  ← apply_prev goal=21 facts=[19,16]
  ← rule negI goal=20
    #[22] x Mem set xs --> false
  ← intro goal=22
    #[23] x Mem set xs
    #[24] false
  ← inst x goal=24 facts=[15]
    #[25] x Mem set xs --> x < x
  → forward goal=24 facts=[25,23]
    #[26] x < x
  ← rule negE_gen goal=24 facts=[18,26]
    #[27] false
qed

header "Ordered insert"

-- auto2 states this at `'a::ord` (no laws, only `<` and `=`); in holpy the
-- annotation on a *definition* is a marker: the body's `<` is the generic
-- overloaded constant, so no premise is injected (see
-- PROGRAM_VERIFICATION_PORT.md §11.3).

fun ordered_insert :: 'a ⇒ 'a list ⇒ 'a list
  | ordered_insert x ([]::'a list) = [x]
  | ordered_insert x (y # ys) = (if x = y then (y # ys) else if x < y then x # (y # ys) else y # ordered_insert x ys)

theorem ordered_insert_set
  fixes x :: 'a, ys :: 'a list
  prop set (ordered_insert x ys) = {x} Un set ys
proof
  ← induct ys list_induct goal=0
    #[1] set (ordered_insert x []) = {x} Un set []
    #[2] !x1. !xs. set (ordered_insert x xs) = {x} Un set xs --> set (ordered_insert x (x1 # xs)) = {x} Un set (x1 # xs)
  ← rewrite ordered_insert_def_1 goal=1
    #[3] set [x] = {x} Un set []
  ← rewrite set_def_2 goal=3
    #[4] insert x (set []) = {x} Un set []
  ← rewrite set_def_1 goal=4
    #[5] {x} = {x} Un {}
  ← rewrite union_empty goal=5
  ← intro x1,xs goal=2
    #[6] _VAR x1
    #[7] _VAR xs
    #[8] set (ordered_insert x xs) = {x} Un set xs
    #[9] set (ordered_insert x (x1 # xs)) = {x} Un set (x1 # xs)
  ← rewrite ordered_insert_def_2 goal=9
    #[10] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← cases "x = x1" goal=10
    #[11] x = x1 --> set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
    #[12] ~(x = x1) --> set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← intro goal=11
    #[13] x = x1
    #[14] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← rewrite if_P goal=14 facts=[13]
    #[15] set (x1 # xs) = {x} Un set (x1 # xs)
  ← rewrite source=prev goal=15 facts=[13]
    #[16] set (x1 # xs) = {x1} Un set (x1 # xs)
  ← rewrite set_def_2 goal=16
    #[17] insert x1 (set xs) = {x1} Un insert x1 (set xs)
  ← rewrite insert_union goal=17
    #[18] insert x1 (set xs) = insert x1 ({} Un insert x1 (set xs))
  ← rewrite empty_union goal=18
    #[19] insert x1 (set xs) = insert x1 (insert x1 (set xs))
  ← rewrite insert_idem goal=19
    #[20] insert x1 (set xs) = insert x1 (insert x1 (set xs))
  ← intro goal=12
    #[21] ~(x = x1)
    #[22] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← cases "x < x1" goal=22
    #[23] x < x1 --> set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
    #[24] ~(x < x1) --> set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← intro goal=23
    #[25] x < x1
    #[26] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← rewrite if_not_P goal=26 facts=[21]
    #[27] set (if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← rewrite if_P goal=27 facts=[25]
    #[28] set (x # x1 # xs) = {x} Un set (x1 # xs)
  ← rewrite set_def_2 goal=28
    #[29] insert x (set (x1 # xs)) = {x} Un insert x1 (set xs)
  ← rewrite set_def_2 goal=29
    #[30] insert x (insert x1 (set xs)) = {x} Un insert x1 (set xs)
  ← rewrite insert_union goal=30
    #[31] insert x (insert x1 (set xs)) = insert x ({} Un insert x1 (set xs))
  ← rewrite empty_union goal=31
    #[32] insert x (insert x1 (set xs)) = insert x ({} Un insert x1 (set xs))
  ← intro goal=24
    #[33] ~(x < x1)
    #[34] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← rewrite set_def_2 goal=34
    #[35] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un insert x1 (set xs)
  ← rewrite if_not_P goal=35 facts=[21]
    #[36] set (if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un insert x1 (set xs)
  ← rewrite if_not_P goal=36 facts=[33]
    #[37] set (x1 # ordered_insert x xs) = {x} Un insert x1 (set xs)
  ← rewrite set_def_2 goal=37
    #[38] insert x1 (set (ordered_insert x xs)) = {x} Un insert x1 (set xs)
  ← rewrite source=prev goal=38 facts=[8]
    #[39] insert x1 ({x} Un set xs) = {x} Un insert x1 (set xs)
  ← rewrite insert_union goal=39
    #[40] insert x1 (insert x ({} Un set xs)) = insert x ({} Un insert x1 (set xs))
  ← rewrite empty_union goal=40
    #[41] insert x1 (insert x (set xs)) = insert x (insert x1 (set xs))
  ← rewrite insert_comm goal=41
    #[42] insert x (insert x1 (set xs)) = insert x1 (insert x (set xs))
  ← rewrite insert_comm loc=0.1 goal=42
    #[43] insert x (insert x1 (set xs)) = insert x1 (insert x (set xs))
qed

theorem ordered_insert_sorted
  fixes x :: 'a::linorder, ys :: 'a::linorder list
  prop strict_sorted ys ⟶ strict_sorted (ordered_insert x ys)
proof
  ← induct ys list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ([]::'a list) --> strict_sorted (ordered_insert x [])
    #[2] !x1. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted xs --> strict_sorted (ordered_insert x xs)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (x1 # xs) --> strict_sorted (ordered_insert x (x1 # xs))
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] strict_sorted ([]::'a list)
    #[6] strict_sorted (ordered_insert x [])
  ← rewrite ordered_insert_def_1 goal=6
    #[7] strict_sorted [x]
  ← rewrite strict_sorted_def_2 sym=false goal=7
    #[8] (!y. y Mem set [] --> x < y) & strict_sorted ([]::'a list)
  ← rule conjI goal=8
    #[9] !y. y Mem set [] --> x < y
  ← rewrite set_def_1 goal=9
    #[10] !y. y Mem {} --> x < y
  ← rewrite member_empty_simp goal=10
    #[11] !y. false --> x < y
  ← intro y goal=11
    #[12] _VAR y
    #[13] false
    #[14] x < y
  ← rule falseE goal=14 facts=[13]
    #[15] x < y
  ← intro x1,xs goal=2
    #[16] _VAR x1
    #[17] _VAR xs
    #[18] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted xs --> strict_sorted (ordered_insert x xs)
    #[19] strict_sorted (x1 # xs)
    #[20] strict_sorted (ordered_insert x (x1 # xs))
  ← rewrite ordered_insert_def_2 goal=20
    #[21] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  → forward strict_sorted_cons_head param_x=x1 param_xs=xs goal=21 facts=[3,4,19]
    #[22] !y. y Mem set xs --> x1 < y
  → forward strict_sorted_cons_tail param_x=x1 param_xs=xs goal=21 facts=[3,4,19]
    #[23] strict_sorted xs
  → forward goal=21 facts=[18,3]
    #[24] linorder_lt (less::'a => 'a => bool) --> strict_sorted xs --> strict_sorted (ordered_insert x xs)
  → forward goal=21 facts=[24,4]
    #[25] strict_sorted xs --> strict_sorted (ordered_insert x xs)
  ← cases "x = x1" goal=21
    #[26] x = x1 --> strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
    #[27] ~(x = x1) --> strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← intro goal=26
    #[28] x = x1
    #[29] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_P goal=29 facts=[28]
  ← intro goal=27
    #[30] ~(x = x1)
    #[31] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← cases "x < x1" goal=31
    #[32] x < x1 --> strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
    #[33] ~(x < x1) --> strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← intro goal=32
    #[34] x < x1
    #[35] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_not_P goal=35 facts=[30]
    #[36] strict_sorted (if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_P goal=36 facts=[34]
    #[37] strict_sorted (x # x1 # xs)
  ← rewrite strict_sorted_def_2 sym=false goal=37
    #[38] (!y. y Mem set (x1 # xs) --> x < y) & strict_sorted (x1 # xs)
  ← rule conjI goal=38
    #[39] !y. y Mem set (x1 # xs) --> x < y
  ← rewrite member_set_cons sym=false goal=39
    #[40] !y. y = x1 | y Mem set xs --> x < y
  ← intro y goal=40
    #[41] y = x1 | y Mem set xs
    #[42] x < y
  ← cases "y = x1" goal=42
    #[43] y = x1 --> x < y
    #[44] ~(y = x1) --> x < y
  ← intro goal=43
    #[45] y = x1
    #[46] x < y
  ← rewrite source=prev goal=46 facts=[45]
  ← intro goal=44
    #[47] ~(y = x1)
    #[48] x < y
  → rewrite disj_comm sym=false target=fact goal=48 facts=[41]
    #[49] y Mem set xs | y = x1
  → forward force_disj_true1 goal=48 facts=[49,47]
    #[50] y Mem set xs
  → forward all_mem_elim goal=48 facts=[22,50]
    #[51] x1 < y
  → forward linorder_lt_trans goal=48 facts=[4,34,51]
    #[52] x < y
  ← intro goal=33
    #[53] ~(x < x1)
    #[54] strict_sorted (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_not_P goal=54 facts=[30]
    #[55] strict_sorted (if x < x1 then x # x1 # xs else x1 # ordered_insert x xs)
  ← rewrite if_not_P goal=55 facts=[53]
    #[56] strict_sorted (x1 # ordered_insert x xs)
  ← rewrite strict_sorted_def_2 sym=false goal=56
    #[57] (!y. y Mem set (ordered_insert x xs) --> x1 < y) & strict_sorted (ordered_insert x xs)
  ← rule conjI goal=57
    #[58] !y. y Mem set (ordered_insert x xs) --> x1 < y
    #[59] strict_sorted (ordered_insert x xs)
  ← apply_prev goal=59 facts=[25,23]
    #[60] strict_sorted (ordered_insert x xs)
  ← rewrite ordered_insert_set goal=58
    #[61] !y. y Mem {x} Un set xs --> x1 < y
  ← rewrite member_union_iff goal=61
    #[62] !y. y Mem {x} | y Mem set xs --> x1 < y
  ← rewrite member_singleton goal=62
    #[63] !y. y = x | y Mem set xs --> x1 < y
  ← intro y goal=63
    #[64] y = x | y Mem set xs
    #[65] x1 < y
  ← cases "y = x" goal=65
    #[66] y = x --> x1 < y
    #[67] ~(y = x) --> x1 < y
  ← intro goal=66
    #[68] y = x
    #[69] x1 < y
  ← rewrite source=prev goal=69 facts=[68]
    #[70] x1 < x
  → forward linorder_lt_gt_of_not_lt goal=69 facts=[4,30,53]
    #[71] x1 < x
  → forward linorder_lt_gt_of_not_lt goal=70 facts=[4,30,53]
  ← intro goal=67
    #[72] ~(y = x)
    #[73] x1 < y
  → rewrite disj_comm sym=false target=fact goal=73 facts=[64]
    #[74] y Mem set xs | y = x
  → forward force_disj_true1 goal=73 facts=[74,72]
    #[75] y Mem set xs
  ← rule all_mem_elim goal=73 facts=[22,75]
    #[76] x1 < y
qed

header "Deleting an element"

fun remove_elt_list :: 'a ⇒ 'a list ⇒ 'a list
  | remove_elt_list x ([]::'a list) = []
  | remove_elt_list x (y # ys) = (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)

-- auto2 states the set equality directly.  Here the membership form comes
-- first: the induction step's `if`/`insert`/`delete` interaction is much
-- cheaper at the membership level, and `remove_elt_list_set` is then a
-- four-step corollary of it (set_equal_iff + member_diff + member_singleton).
-- It is stated with `diff` because holpy's `-` is arithmetic subtraction.

theorem remove_elt_list_mem
  fixes x :: 'a, ys :: 'a list, z :: 'a
  prop z ∈ set (remove_elt_list x ys) ⟷ z ∈ set ys ∧ ¬(z = x)
proof
  ← induct ys list_induct goal=0
    #[1] z Mem set (remove_elt_list x []) <--> z Mem set [] & ~(z = x)
    #[2] !x1. !xs. z Mem set (remove_elt_list x xs) <--> z Mem set xs & ~(z = x) --> z Mem set (remove_elt_list x (x1 # xs)) <--> z Mem set (x1 # xs) & ~(z = x)
  ← rewrite remove_elt_list_def_1 goal=1
    #[3] z Mem set [] <--> z Mem set [] & ~(z = x)
  ← rewrite set_def_1 goal=3
    #[4] z Mem {} <--> z Mem {} & ~(z = x)
  ← rewrite member_empty_simp goal=4
    #[5] false <--> false & ~(z = x)
  ← rewrite conj_false_right goal=5
  ← intro y,ys goal=2
    #[6] _VAR y
    #[7] _VAR ys
    #[8] z Mem set (remove_elt_list x ys) <--> z Mem set ys & ~(z = x)
    #[9] z Mem set (remove_elt_list x (y # ys)) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite remove_elt_list_def_2 goal=9
    #[10] z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← cases "y = x" goal=10
    #[11] y = x --> z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
    #[12] ~(y = x) --> z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← intro goal=11
    #[13] y = x
    #[14] z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite if_P goal=14 facts=[13]
    #[15] z Mem set (remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite source=prev goal=15 facts=[13]
    #[16] z Mem set (remove_elt_list x ys) <--> z Mem set (x # ys) & ~(z = x)
  ← rewrite source=prev goal=16 facts=[8]
    #[17] z Mem set ys & ~(z = x) <--> z Mem set (x # ys) & ~(z = x)
  ← rewrite member_set_cons sym=false goal=17
    #[18] z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
  ← cases "z = x" goal=18
    #[19] z = x --> z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
    #[20] ~(z = x) --> z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
  ← intro goal=19
    #[21] z = x
    #[22] z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
  ← rewrite source=prev goal=22 facts=[21]
    #[23] x Mem set ys & ~(x = x) <--> (x = x | x Mem set ys) & ~(x = x)
  ← rewrite eq_mean_true goal=23
    #[24] x Mem set ys & ~true <--> (true | x Mem set ys) & ~true
  ← rewrite not_true goal=24
    #[25] x Mem set ys & false <--> (true | x Mem set ys) & false
  ← rewrite conj_false_left goal=25
    #[26] x Mem set ys & false <--> (true | x Mem set ys) & false
  ← intro goal=20
    #[27] ~(z = x)
    #[28] z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
  → rewrite eq_false sym=false target=fact goal=28 facts=[27]
    #[29] z = x <--> false
  ← rewrite source=prev goal=28 facts=[29]
    #[30] z Mem set ys & ~false <--> (false | z Mem set ys) & ~false
  ← rewrite not_false goal=30
    #[31] z Mem set ys & true <--> (false | z Mem set ys) & true
  ← rewrite conj_true_right goal=31
    #[32] z Mem set ys <--> false | z Mem set ys
  ← rewrite disj_false_left goal=32
    #[33] z Mem set ys <--> false | z Mem set ys
  ← intro goal=12
    #[34] ~(y = x)
    #[35] z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite if_not_P goal=35 facts=[34]
    #[36] z Mem set (y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite member_set_cons sym=false goal=36
    #[37] z = y | z Mem set (remove_elt_list x ys) <--> (z = y | z Mem set ys) & ~(z = x)
  ← rewrite source=prev goal=37 facts=[8]
    #[38] z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
  ← cases "z = y" goal=38
    #[39] z = y --> z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
    #[40] ~(z = y) --> z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
  ← intro goal=39
    #[41] z = y
    #[42] z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
  ← rewrite source=prev goal=42 facts=[41]
    #[43] y = y | y Mem set ys & ~(y = x) <--> (y = y | y Mem set ys) & ~(y = x)
  ← rewrite eq_mean_true goal=43
    #[44] true | y Mem set ys & ~(y = x) <--> (true | y Mem set ys) & ~(y = x)
  ← rewrite disj_true_left goal=44
    #[45] true <--> true & ~(y = x)
  ← rewrite conj_true_left goal=45
    #[46] true <--> ~(y = x)
  → rewrite eq_false sym=false target=fact goal=46 facts=[34]
    #[47] y = x <--> false
  ← rewrite source=prev goal=46 facts=[47]
    #[48] true <--> ~false
  ← rewrite not_false goal=48
    #[49] true <--> ~false
  ← intro goal=40
    #[50] ~(z = y)
    #[51] z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
  → rewrite eq_false sym=false target=fact goal=51 facts=[50]
    #[52] z = y <--> false
  ← rewrite source=prev goal=51 facts=[52]
    #[53] false | z Mem set ys & ~(z = x) <--> (false | z Mem set ys) & ~(z = x)
  ← rewrite disj_false_left goal=53
    #[54] false | z Mem set ys & ~(z = x) <--> (false | z Mem set ys) & ~(z = x)
qed

theorem remove_elt_list_set
  fixes x :: 'a, ys :: 'a list
  prop set (remove_elt_list x ys) = diff (set ys) {x}
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] !x1. x1 Mem set (remove_elt_list x ys) <--> x1 Mem diff (set ys) ({x})
  ← intro z goal=1
    #[2] _VAR z
    #[3] z Mem set (remove_elt_list x ys) <--> z Mem diff (set ys) ({x})
  ← rewrite member_diff goal=3
    #[4] z Mem set (remove_elt_list x ys) <--> z Mem set ys & ~(z Mem {x})
  ← rewrite member_singleton goal=4
    #[5] z Mem set (remove_elt_list x ys) <--> z Mem set ys & ~(z = x)
  → forward remove_elt_list_mem param_x=x param_ys=ys param_z=z goal=5
qed

theorem remove_elt_list_sorted
  fixes x :: 'a::linorder, ys :: 'a::linorder list
  prop strict_sorted ys ⟶ strict_sorted (remove_elt_list x ys)
proof
  ← induct ys list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ([]::'a list) --> strict_sorted (remove_elt_list x [])
    #[2] !x1. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted xs --> strict_sorted (remove_elt_list x xs)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted (x1 # xs) --> strict_sorted (remove_elt_list x (x1 # xs))
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] strict_sorted ([]::'a list)
    #[6] strict_sorted (remove_elt_list x [])
  ← rewrite remove_elt_list_def_1 goal=6
  ← intro y,ys goal=2
    #[7] _VAR y
    #[8] _VAR ys
    #[9] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> strict_sorted ys --> strict_sorted (remove_elt_list x ys)
    #[10] strict_sorted (y # ys)
    #[11] strict_sorted (remove_elt_list x (y # ys))
  ← rewrite remove_elt_list_def_2 goal=11
    #[12] strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
  → forward strict_sorted_cons_head param_x=y param_xs=ys goal=12 facts=[3,4,10]
    #[13] !y1. y1 Mem set ys --> y < y1
  → forward strict_sorted_cons_tail param_x=y param_xs=ys goal=12 facts=[3,4,10]
    #[14] strict_sorted ys
  → forward goal=12 facts=[9,3]
    #[15] linorder_lt (less::'a => 'a => bool) --> strict_sorted ys --> strict_sorted (remove_elt_list x ys)
  → forward goal=12 facts=[15,4]
    #[16] strict_sorted ys --> strict_sorted (remove_elt_list x ys)
  ← cases "y = x" goal=12
    #[17] y = x --> strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
    #[18] ~(y = x) --> strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
  ← intro goal=17
    #[19] y = x
    #[20] strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
  ← rewrite if_P goal=20 facts=[19]
    #[21] strict_sorted (remove_elt_list x ys)
  ← apply_prev goal=21 facts=[16,14]
    #[22] strict_sorted (remove_elt_list x ys)
  ← intro goal=18
    #[23] ~(y = x)
    #[24] strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
  ← rewrite if_not_P goal=24 facts=[23]
    #[25] strict_sorted (y # remove_elt_list x ys)
  ← rewrite strict_sorted_def_2 sym=false goal=25
    #[26] (!y1. y1 Mem set (remove_elt_list x ys) --> y < y1) & strict_sorted (remove_elt_list x ys)
  ← rule conjI goal=26
    #[27] !y1. y1 Mem set (remove_elt_list x ys) --> y < y1
    #[28] strict_sorted (remove_elt_list x ys)
  ← apply_prev goal=28 facts=[16,14]
  ← rewrite remove_elt_list_set goal=27
    #[29] !y1. y1 Mem diff (set ys) ({x}) --> y < y1
  ← rewrite member_diff goal=29
    #[30] !y1. y1 Mem set ys & ~(y1 Mem {x}) --> y < y1
  ← intro z goal=30
    #[31] _VAR z
    #[32] z Mem set ys & ~(z Mem {x})
    #[33] y < z
  → forward conjD1 goal=33 facts=[32]
    #[34] z Mem set ys
  ← rule all_mem_elim goal=33 facts=[13,34]
    #[35] y < z
qed

theorem remove_elt_idem
  fixes x :: 'a, ys :: 'a list
  prop ¬(x ∈ set ys) ⟶ remove_elt_list x ys = ys
proof
  ← induct ys list_induct goal=0
    #[1] ~(x Mem set []) --> remove_elt_list x [] = []
    #[2] !x1. !xs. (~(x Mem set xs) --> remove_elt_list x xs = xs) --> ~(x Mem set (x1 # xs)) --> remove_elt_list x (x1 # xs) = x1 # xs
  ← intro goal=1
    #[3] ~(x Mem set [])
    #[4] remove_elt_list x [] = []
  ← rewrite remove_elt_list_def_1 goal=4
    #[5] remove_elt_list x [] = []
  ← intro y,ys goal=2
    #[6] _VAR y
    #[7] _VAR ys
    #[8] ~(x Mem set ys) --> remove_elt_list x ys = ys
    #[9] ~(x Mem set (y # ys))
    #[10] remove_elt_list x (y # ys) = y # ys
  ← rewrite remove_elt_list_def_2 goal=10
    #[11] (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) = y # ys
  → rewrite member_set_cons sym=false target=fact goal=11 facts=[9]
    #[12] ~(x = y | x Mem set ys)
  → rewrite de_morgan_thm2 sym=false target=fact goal=11 facts=[12]
    #[13] ~(x = y) & ~(x Mem set ys)
  → forward conjD1 goal=11 facts=[13]
    #[14] ~(x = y)
  → forward conjD2 goal=11 facts=[13]
    #[15] ~(x Mem set ys)
  → rewrite eq_sym_eq sym=false target=fact goal=11 facts=[14]
    #[16] ~(y = x)
  ← rewrite if_not_P goal=11 facts=[16]
    #[17] y # remove_elt_list x ys = y # ys
  → forward goal=17 facts=[8,15]
    #[18] remove_elt_list x ys = ys
  ← rewrite source=prev goal=17 facts=[18]
qed

header "Sorted (the non-strict version)"

-- Isabelle's `sorted` (`sorted_wrt (<=)`), which Quicksort/LinkedList/
-- Rect_Intersect need.  Like `strict_sorted` it is definition-only here: the
-- class constraint on a *definition* is a marker, so `<=` is the generic
-- overloaded constant.

fun sorted :: 'a list ⇒ bool
  | sorted ([]::'a list) ⟷ true
  | sorted (x # ys) ⟷ (∀y. y ∈ set ys ⟶ x ≤ y) ∧ sorted ys

-- Destructors for the cons case (same shape as the `strict_sorted` ones).

theorem sorted_cons_head
  fixes x :: 'a::linorder, xs :: 'a::linorder list
  prop sorted (x # xs) ⟶ (∀y. y ∈ set xs ⟶ x ≤ y)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] sorted (x # xs)
    #[4] !y. y Mem set xs --> x <= y
  → rewrite sorted_def_2 sym=false target=fact goal=4 facts=[3]
    #[5] (!y. y Mem set xs --> x <= y) & sorted xs
  → forward conjD1 goal=4 facts=[5]
    #[6] !y. y Mem set xs --> x <= y
qed

theorem sorted_cons_tail
  fixes x :: 'a::linorder, xs :: 'a::linorder list
  prop sorted (x # xs) ⟶ sorted xs
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] sorted (x # xs)
    #[4] sorted xs
  → rewrite sorted_def_2 sym=false target=fact goal=4 facts=[3]
    #[5] (!y. y Mem set xs --> x <= y) & sorted xs
  → forward conjD2 goal=4 facts=[5]
    #[6] sorted xs
qed

theorem sorted_appendI
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop sorted xs ∧ sorted ys ∧ (∀a. a ∈ set xs ⟶ (∀b. b ∈ set ys ⟶ a ≤ b)) ⟶ sorted (xs @ ys)
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> sorted ([]::'a list) & sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a <= b)) --> sorted ([] @ ys)
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> sorted (x # xs) & sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b)) --> sorted ((x # xs) @ ys)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] sorted ([]::'a list) & sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a <= b))
    #[6] sorted ([] @ ys)
  ← rewrite append_def_1 goal=6
    #[7] sorted ys
  → forward conjD2 goal=7 facts=[5]
    #[8] sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a <= b))
  ← rule conjD1 goal=7 facts=[8]
    #[9] sorted ys
  ← intro x,xs goal=2
    #[10] _VAR x
    #[11] _VAR xs
    #[12] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)
    #[13] sorted (x # xs) & sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b))
    #[14] sorted ((x # xs) @ ys)
  → forward conjD1 goal=14 facts=[13]
    #[15] sorted (x # xs)
  → forward conjD2 goal=14 facts=[13]
    #[16] sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b))
  → forward conjD1 goal=14 facts=[16]
    #[17] sorted ys
  → forward conjD2 goal=14 facts=[16]
    #[18] !a. a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b)
  → forward sorted_cons_head param_x=x param_xs=xs goal=14 facts=[3,4,15]
    #[19] !y. y Mem set xs --> x <= y
  → forward sorted_cons_tail param_x=x param_xs=xs goal=14 facts=[3,4,15]
    #[20] sorted xs
  → forward mem_set_cons_self param_x=x param_xs=xs goal=14
    #[21] x Mem set (x # xs)
  ← inst x goal=14 facts=[18]
    #[22] x Mem set (x # xs) --> (!b. b Mem set ys --> x <= b)
  → forward goal=14 facts=[22,21]
    #[23] !b. b Mem set ys --> x <= b
  cut "∀a. a ∈ set xs ⟶ (∀b. b ∈ set ys ⟶ a ≤ b)" goal=14
    #[24] !a. a Mem set xs --> (!b. b Mem set ys --> a <= b)
  ← intro a goal=24
    #[25] _VAR a
    #[26] a Mem set xs
    #[27] !b. b Mem set ys --> a <= b
  ← intro b goal=27
    #[28] _VAR b
    #[29] b Mem set ys
    #[30] a <= b
  → forward mem_set_cons_weak param_x=x param_xs=xs param_z=a goal=30 facts=[26]
    #[31] a Mem set (x # xs)
  ← inst a goal=30 facts=[18]
    #[32] a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b)
  → forward goal=30 facts=[32,31]
    #[33] !b. b Mem set ys --> a <= b
  ← rule all_mem_elim goal=30 facts=[33,29]
    #[34] a <= b
  → forward conjI goal=14 facts=[17,24]
    #[35] sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b))
  → forward conjI goal=14 facts=[20,35]
    #[36] sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b))
  → forward goal=14 facts=[12,3]
    #[37] linorder_lt (less::'a => 'a => bool) --> sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)
  → forward goal=14 facts=[37,4]
    #[38] sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)
  ← rewrite append_def_2 goal=14
    #[39] sorted (x # xs @ ys)
  ← rewrite sorted_def_2 sym=false goal=39
    #[40] (!y. y Mem set (xs @ ys) --> x <= y) & sorted (xs @ ys)
  ← rule conjI goal=40
    #[41] !y. y Mem set (xs @ ys) --> x <= y
    #[42] sorted (xs @ ys)
  ← apply_prev goal=42 facts=[38,36]
  ← rewrite member_set_append sym=false goal=41
    #[43] !y. y Mem set xs | y Mem set ys --> x <= y
  ← intro y goal=43
    #[44] _VAR y
    #[45] y Mem set xs | y Mem set ys
    #[46] x <= y
  ← cases "y ∈ set xs" goal=46
    #[47] y Mem set xs --> x <= y
    #[48] ~(y Mem set xs) --> x <= y
  ← intro goal=47
    #[49] y Mem set xs
    #[50] x <= y
  ← rule all_mem_elim goal=50 facts=[19,49]
    #[51] x <= y
  ← intro goal=48
    #[52] ~(y Mem set xs)
    #[53] x <= y
  → rewrite disj_comm sym=false target=fact goal=53 facts=[45]
    #[54] y Mem set ys | y Mem set xs
  → forward force_disj_true1 goal=53 facts=[54,52]
    #[55] y Mem set ys
  ← rule all_mem_elim goal=53 facts=[23,55]
    #[56] x <= y
qed

theorem sorted_appendE1
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop sorted (xs @ ys) ⟶ sorted xs ∧ sorted ys
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> sorted ([] @ ys) --> sorted ([]::'a list) & sorted ys
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> sorted (xs @ ys) --> sorted xs & sorted ys) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> sorted ((x # xs) @ ys) --> sorted (x # xs) & sorted ys
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] sorted ([] @ ys)
    #[6] sorted ([]::'a list) & sorted ys
  ← rule conjI goal=6
    #[7] sorted ([]::'a list)
    #[8] sorted ys
  ← rewrite sorted_def_1 goal=7
    #[9] true
  ← rule trueI goal=9
    #[10] true
  ← rewrite append_def_1 sym=true goal=8
  ← intro x,xs goal=2
    #[11] _VAR x
    #[12] _VAR xs
    #[13] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> sorted (xs @ ys) --> sorted xs & sorted ys
    #[14] sorted ((x # xs) @ ys)
    #[15] sorted (x # xs) & sorted ys
  → rewrite append_def_2 sym=false target=fact goal=15 facts=[14]
    #[16] sorted (x # xs @ ys)
  → rewrite sorted_def_2 sym=false target=fact goal=15 facts=[16]
    #[17] (!y. y Mem set (xs @ ys) --> x <= y) & sorted (xs @ ys)
  → forward conjD1 goal=15 facts=[17]
    #[18] !y. y Mem set (xs @ ys) --> x <= y
  → forward goal=15 facts=[13,3]
    #[19] linorder_lt (less::'a => 'a => bool) --> sorted (xs @ ys) --> sorted xs & sorted ys
  → forward goal=15 facts=[19,4]
    #[20] sorted (xs @ ys) --> sorted xs & sorted ys
  → forward conjD2 goal=15 facts=[17]
    #[21] sorted (xs @ ys)
  → forward goal=15 facts=[20,21]
    #[22] sorted xs & sorted ys
  → forward conjD1 goal=15 facts=[22]
    #[23] sorted xs
  → forward conjD2 goal=15 facts=[22]
    #[24] sorted ys
  ← rule conjI goal=15
    #[25] sorted (x # xs)
  ← rewrite sorted_def_2 sym=false goal=25
    #[26] (!y. y Mem set xs --> x <= y) & sorted xs
  ← rule conjI goal=26
    #[27] !y. y Mem set xs --> x <= y
  ← intro y goal=27
    #[28] _VAR y
    #[29] y Mem set xs
    #[30] x <= y
  → forward member_set_append_left param_x=y param_xs=xs param_ys=ys goal=30
    #[31] y Mem set xs --> y Mem set (xs @ ys)
  → forward goal=30 facts=[31,29]
    #[32] y Mem set (xs @ ys)
  ← rule all_mem_elim goal=30 facts=[18,32]
    #[33] x <= y
qed
