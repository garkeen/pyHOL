qed

header "Ordered insert"

-- auto2 states this at `'a::ord` (no laws, only `<` and `=`); in holpy the
-- annotation on a *definition* is a marker: the body's `<` is the generic
-- overloaded constant, so no premise is injected (see
-- PROGRAM_VERIFICATION_PORT.md §11.3).

fun ordered_insert :: 'a ⇒ 'a list ⇒ 'a list
  | ordered_insert x ([]::'a list) = [x]
  | ordered_insert x (y # ys) = (if x = y then (y # ys) else if x < y then x # (y # ys) else y # ordered_insert x ys)

theorem ordered_insert_set
  fixes x :: 'a, ys :: 'a list
  prop set (ordered_insert x ys) = {x} Un set ys
proof
  ← induct ys list_induct goal=0
    #[1] set (ordered_insert x []) = {x} Un set []
    #[2] !x1. !xs. set (ordered_insert x xs) = {x} Un set xs --> set (ordered_insert x (x1 # xs)) = {x} Un set (x1 # xs)
  ← rewrite ordered_insert_def_1 goal=1
    #[3] set [x] = {x} Un set []
  ← rewrite set_def_2 goal=3
    #[4] insert x (set []) = {x} Un set []
  ← rewrite set_def_1 goal=4
    #[5] {x} = {x} Un {}
  ← rewrite union_empty goal=5
  ← intro x1,xs goal=2
    #[6] _VAR x1
    #[7] _VAR xs
    #[8] set (ordered_insert x xs) = {x} Un set xs
    #[9] set (ordered_insert x (x1 # xs)) = {x} Un set (x1 # xs)
  ← rewrite ordered_insert_def_2 goal=9
    #[10] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← cases "x = x1" goal=10
    #[11] x = x1 --> set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
    #[12] ~(x = x1) --> set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← intro goal=11
    #[13] x = x1
    #[14] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← rewrite if_P goal=14 facts=[13]
    #[15] set (x1 # xs) = {x} Un set (x1 # xs)
  ← rewrite source=prev goal=15 facts=[13]
    #[16] set (x1 # xs) = {x1} Un set (x1 # xs)
  ← rewrite set_def_2 goal=16
    #[17] insert x1 (set xs) = {x1} Un insert x1 (set xs)
  ← rewrite insert_union goal=17
    #[18] insert x1 (set xs) = insert x1 ({} Un insert x1 (set xs))
  ← rewrite empty_union goal=18
    #[19] insert x1 (set xs) = insert x1 (insert x1 (set xs))
  ← rewrite insert_idem goal=19
    #[20] insert x1 (set xs) = insert x1 (insert x1 (set xs))
  ← intro goal=12
    #[21] ~(x = x1)
    #[22] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← cases "x < x1" goal=22
    #[23] x < x1 --> set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
    #[24] ~(x < x1) --> set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← intro goal=23
    #[25] x < x1
    #[26] set (if x = x1 then x1 # xs else if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← rewrite if_not_P goal=26 facts=[21]
    #[27] set (if x < x1 then x # x1 # xs else x1 # ordered_insert x xs) = {x} Un set (x1 # xs)
  ← rewrite if_P goal=27 facts=[25]
    #[28] set (x # x1 # xs) = {x} Un set (x1 # xs)
  ← rewrite set_def_2 goal=28
    #[29] insert x (set (x1 # xs)) = {x} Un insert x1 (set xs)
  ← rewrite set_def_2 goal=29
    #[30] insert x (insert x1 (set xs)) = {x} Un insert x1 (set xs)
  ← rewrite insert_union goal=30
    #[31] insert x (insert x1 (set xs)) = insert x ({} Un insert x1 (set xs))
  ← rewrite empty_union goal=31
