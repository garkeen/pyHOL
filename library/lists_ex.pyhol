header "Deleting an element"

fun remove_elt_list :: 'a ⇒ 'a list ⇒ 'a list
  | remove_elt_list x ([]::'a list) = []
  | remove_elt_list x (y # ys) = (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)

-- auto2 states the set equality directly.  Here the membership form comes
-- first: the induction step's `if`/`insert`/`delete` interaction is much
-- cheaper at the membership level, and `remove_elt_list_set` is then a
-- four-step corollary of it (set_equal_iff + member_diff + member_singleton).
-- It is stated with `diff` because holpy's `-` is arithmetic subtraction.

theorem remove_elt_list_mem
  fixes x :: 'a, ys :: 'a list, z :: 'a
  prop z ∈ set (remove_elt_list x ys) ⟷ z ∈ set ys ∧ ¬(z = x)
proof
  ← induct ys list_induct goal=0
    #[1] z Mem set (remove_elt_list x []) <--> z Mem set [] & ~(z = x)
    #[2] !x1. !xs. z Mem set (remove_elt_list x xs) <--> z Mem set xs & ~(z = x) --> z Mem set (remove_elt_list x (x1 # xs)) <--> z Mem set (x1 # xs) & ~(z = x)
  ← rewrite remove_elt_list_def_1 goal=1
    #[3] z Mem set [] <--> z Mem set [] & ~(z = x)
  ← rewrite set_def_1 goal=3
    #[4] z Mem {} <--> z Mem {} & ~(z = x)
  ← rewrite member_empty_simp goal=4
    #[5] false <--> false & ~(z = x)
  ← rewrite conj_false_right goal=5
  ← intro y,ys goal=2
    #[6] _VAR y
    #[7] _VAR ys
    #[8] z Mem set (remove_elt_list x ys) <--> z Mem set ys & ~(z = x)
    #[9] z Mem set (remove_elt_list x (y # ys)) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite remove_elt_list_def_2 goal=9
    #[10] z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← cases "y = x" goal=10
    #[11] y = x --> z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
    #[12] ~(y = x) --> z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← intro goal=11
    #[13] y = x
    #[14] z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite if_P goal=14 facts=[13]
    #[15] z Mem set (remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite source=prev goal=15 facts=[13]
    #[16] z Mem set (remove_elt_list x ys) <--> z Mem set (x # ys) & ~(z = x)
  ← rewrite source=prev goal=16 facts=[8]
    #[17] z Mem set ys & ~(z = x) <--> z Mem set (x # ys) & ~(z = x)
  ← rewrite member_set_cons sym=false goal=17
    #[18] z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
  ← cases "z = x" goal=18
    #[19] z = x --> z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
    #[20] ~(z = x) --> z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
  ← intro goal=19
    #[21] z = x
    #[22] z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
  ← rewrite source=prev goal=22 facts=[21]
    #[23] x Mem set ys & ~(x = x) <--> (x = x | x Mem set ys) & ~(x = x)
  ← rewrite eq_mean_true goal=23
    #[24] x Mem set ys & ~true <--> (true | x Mem set ys) & ~true
  ← rewrite not_true goal=24
    #[25] x Mem set ys & false <--> (true | x Mem set ys) & false
  ← rewrite conj_false_left goal=25
    #[26] x Mem set ys & false <--> (true | x Mem set ys) & false
  ← intro goal=20
    #[27] ~(z = x)
    #[28] z Mem set ys & ~(z = x) <--> (z = x | z Mem set ys) & ~(z = x)
  → rewrite eq_false sym=false target=fact goal=28 facts=[27]
    #[29] z = x <--> false
  ← rewrite source=prev goal=28 facts=[29]
    #[30] z Mem set ys & ~false <--> (false | z Mem set ys) & ~false
  ← rewrite not_false goal=30
    #[31] z Mem set ys & true <--> (false | z Mem set ys) & true
  ← rewrite conj_true_right goal=31
    #[32] z Mem set ys <--> false | z Mem set ys
  ← rewrite disj_false_left goal=32
    #[33] z Mem set ys <--> false | z Mem set ys
  ← intro goal=12
    #[34] ~(y = x)
    #[35] z Mem set (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite if_not_P goal=35 facts=[34]
    #[36] z Mem set (y # remove_elt_list x ys) <--> z Mem set (y # ys) & ~(z = x)
  ← rewrite member_set_cons sym=false goal=36
    #[37] z = y | z Mem set (remove_elt_list x ys) <--> (z = y | z Mem set ys) & ~(z = x)
  ← rewrite source=prev goal=37 facts=[8]
    #[38] z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
  ← cases "z = y" goal=38
    #[39] z = y --> z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
    #[40] ~(z = y) --> z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
  ← intro goal=39
    #[41] z = y
    #[42] z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
  ← rewrite source=prev goal=42 facts=[41]
    #[43] y = y | y Mem set ys & ~(y = x) <--> (y = y | y Mem set ys) & ~(y = x)
  ← rewrite eq_mean_true goal=43
    #[44] true | y Mem set ys & ~(y = x) <--> (true | y Mem set ys) & ~(y = x)
  ← rewrite disj_true_left goal=44
    #[45] true <--> true & ~(y = x)
  ← rewrite conj_true_left goal=45
    #[46] true <--> ~(y = x)
  → rewrite eq_false sym=false target=fact goal=46 facts=[34]
    #[47] y = x <--> false
  ← rewrite source=prev goal=46 facts=[47]
    #[48] true <--> ~false
  ← rewrite not_false goal=48
    #[49] true <--> ~false
  ← intro goal=40
    #[50] ~(z = y)
    #[51] z = y | z Mem set ys & ~(z = x) <--> (z = y | z Mem set ys) & ~(z = x)
  → rewrite eq_false sym=false target=fact goal=51 facts=[50]
    #[52] z = y <--> false
  ← rewrite source=prev goal=51 facts=[52]
    #[53] false | z Mem set ys & ~(z = x) <--> (false | z Mem set ys) & ~(z = x)
  ← rewrite disj_false_left goal=53
    #[54] false | z Mem set ys & ~(z = x) <--> (false | z Mem set ys) & ~(z = x)
qed

theorem remove_elt_list_set
  fixes x :: 'a, ys :: 'a list
  prop set (remove_elt_list x ys) = set ys - {x}
proof
  ← rewrite set_equal_iff sym=false goal=0
    #[1] !x1. x1 Mem set (remove_elt_list x ys) <--> x1 Mem set ys - {x}
  ← rewrite fun_minus_def goal=1
    #[2] !x1. x1 Mem set (remove_elt_list x ys) <--> x1 Mem diff (set ys) ({x})
  ← intro z goal=2
    #[3] _VAR z
    #[4] z Mem set (remove_elt_list x ys) <--> z Mem diff (set ys) ({x})
  ← rewrite member_diff goal=4
    #[5] z Mem set (remove_elt_list x ys) <--> z Mem set ys & ~(z Mem {x})
  ← rewrite member_singleton goal=5
    #[6] z Mem set (remove_elt_list x ys) <--> z Mem set ys & ~(z = x)
  → forward remove_elt_list_mem param_x=x param_ys=ys param_z=z goal=6
qed

theorem remove_elt_list_sorted
  fixes x :: 'a::linorder, ys :: 'a::linorder list
  prop strict_sorted ys ⟶ strict_sorted (remove_elt_list x ys)
proof
  ← induct ys list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ([]::'a list) --> strict_sorted (remove_elt_list x [])
    #[2] !x1. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted xs --> strict_sorted (remove_elt_list x xs)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted (x1 # xs) --> strict_sorted (remove_elt_list x (x1 # xs))
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[6] strict_sorted ([]::'a list)
    #[7] strict_sorted (remove_elt_list x [])
  ← rewrite remove_elt_list_def_1 goal=7
  ← intro y,ys goal=2
    #[8] _VAR y
    #[9] _VAR ys
    #[10] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ys --> strict_sorted (remove_elt_list x ys)
    #[11] strict_sorted (y # ys)
    #[12] strict_sorted (remove_elt_list x (y # ys))
  ← rewrite remove_elt_list_def_2 goal=12
    #[13] strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
  → forward strict_sorted_cons_head param_x=y param_xs=ys goal=13 facts=[3,4,5,11]
    #[14] !y1. y1 Mem set ys --> y < y1
  → forward strict_sorted_cons_tail param_x=y param_xs=ys goal=13 facts=[3,4,5,11]
    #[15] strict_sorted ys
  → forward goal=13 facts=[10,3]
    #[16] linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ys --> strict_sorted (remove_elt_list x ys)
  → forward goal=13 facts=[16,4]
    #[17] linorder_lt_le (less_eq::'a => 'a => bool) less --> strict_sorted ys --> strict_sorted (remove_elt_list x ys)
  → forward goal=13 facts=[17,5]
    #[18] strict_sorted ys --> strict_sorted (remove_elt_list x ys)
  ← cases "y = x" goal=13
    #[19] y = x --> strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
    #[20] ~(y = x) --> strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
  ← intro goal=19
    #[21] y = x
    #[22] strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
  ← rewrite if_P goal=22 facts=[21]
    #[23] strict_sorted (remove_elt_list x ys)
  ← apply_prev goal=23 facts=[18,15]
    #[24] strict_sorted (remove_elt_list x ys)
  ← intro goal=20
    #[25] ~(y = x)
    #[26] strict_sorted (if y = x then remove_elt_list x ys else y # remove_elt_list x ys)
  ← rewrite if_not_P goal=26 facts=[25]
    #[27] strict_sorted (y # remove_elt_list x ys)
  ← rewrite strict_sorted_def_2 sym=false goal=27
    #[28] (!y1. y1 Mem set (remove_elt_list x ys) --> y < y1) & strict_sorted (remove_elt_list x ys)
  ← rule conjI goal=28
    #[29] !y1. y1 Mem set (remove_elt_list x ys) --> y < y1
    #[30] strict_sorted (remove_elt_list x ys)
  ← apply_prev goal=30 facts=[18,15]
  ← rewrite remove_elt_list_set goal=29
    #[31] !y1. y1 Mem set ys - {x} --> y < y1
  ← rewrite fun_minus_def goal=31
    #[32] !y1. y1 Mem diff (set ys) ({x}) --> y < y1
  ← rewrite member_diff goal=32
    #[33] !y1. y1 Mem set ys & ~(y1 Mem {x}) --> y < y1
  ← intro z goal=33
    #[34] _VAR z
    #[35] z Mem set ys & ~(z Mem {x})
    #[36] y < z
  → forward conjD1 goal=36 facts=[35]
    #[37] z Mem set ys
  ← rule all_mem_elim goal=36 facts=[14,37]
    #[38] y < z
qed

theorem remove_elt_idem
  fixes x :: 'a, ys :: 'a list
  prop ¬(x ∈ set ys) ⟶ remove_elt_list x ys = ys
proof
  ← induct ys list_induct goal=0
    #[1] ~(x Mem set []) --> remove_elt_list x [] = []
    #[2] !x1. !xs. (~(x Mem set xs) --> remove_elt_list x xs = xs) --> ~(x Mem set (x1 # xs)) --> remove_elt_list x (x1 # xs) = x1 # xs
  ← intro goal=1
    #[3] ~(x Mem set [])
    #[4] remove_elt_list x [] = []
  ← rewrite remove_elt_list_def_1 goal=4
    #[5] remove_elt_list x [] = []
  ← intro y,ys goal=2
    #[6] _VAR y
    #[7] _VAR ys
    #[8] ~(x Mem set ys) --> remove_elt_list x ys = ys
    #[9] ~(x Mem set (y # ys))
    #[10] remove_elt_list x (y # ys) = y # ys
  ← rewrite remove_elt_list_def_2 goal=10
    #[11] (if y = x then remove_elt_list x ys else y # remove_elt_list x ys) = y # ys
  → rewrite member_set_cons sym=false target=fact goal=11 facts=[9]
    #[12] ~(x = y | x Mem set ys)
  → rewrite de_morgan_thm2 sym=false target=fact goal=11 facts=[12]
    #[13] ~(x = y) & ~(x Mem set ys)
  → forward conjD1 goal=11 facts=[13]
    #[14] ~(x = y)
  → forward conjD2 goal=11 facts=[13]
    #[15] ~(x Mem set ys)
  → rewrite eq_sym_eq sym=false target=fact goal=11 facts=[14]
    #[16] ~(y = x)
  ← rewrite if_not_P goal=11 facts=[16]
    #[17] y # remove_elt_list x ys = y # ys
  → forward goal=17 facts=[8,15]
    #[18] remove_elt_list x ys = ys
  ← rewrite source=prev goal=17 facts=[18]
qed

header "Sorted (the non-strict version)"

-- Isabelle's `sorted` (`sorted_wrt (<=)`), which Quicksort/LinkedList/
-- Rect_Intersect need.  Like `strict_sorted` it is definition-only here: the
-- class constraint on a *definition* is a marker, so `<=` is the generic
-- overloaded constant.

fun sorted :: 'a list ⇒ bool
  | sorted ([]::'a list) ⟷ true
  | sorted (x # ys) ⟷ (∀y. y ∈ set ys ⟶ x ≤ y) ∧ sorted ys

-- Destructors for the cons case (same shape as the `strict_sorted` ones).

theorem sorted_cons_head
  fixes x :: 'a::linorder, xs :: 'a::linorder list
  prop sorted (x # xs) ⟶ (∀y. y ∈ set xs ⟶ x ≤ y)
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[4] sorted (x # xs)
    #[5] !y. y Mem set xs --> x <= y
  → rewrite sorted_def_2 sym=false target=fact goal=5 facts=[4]
    #[6] (!y. y Mem set xs --> x <= y) & sorted xs
  → forward conjD1 goal=5 facts=[6]
    #[7] !y. y Mem set xs --> x <= y
qed

theorem sorted_cons_tail
  fixes x :: 'a::linorder, xs :: 'a::linorder list
  prop sorted (x # xs) ⟶ sorted xs
proof
  ← intro goal=0
    #[1] linorder (less_eq::'a => 'a => bool)
    #[2] linorder_lt (less::'a => 'a => bool)
    #[3] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[4] sorted (x # xs)
    #[5] sorted xs
  → rewrite sorted_def_2 sym=false target=fact goal=5 facts=[4]
    #[6] (!y. y Mem set xs --> x <= y) & sorted xs
  → forward conjD2 goal=5 facts=[6]
    #[7] sorted xs
qed

theorem sorted_appendI
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop sorted xs ∧ sorted ys ∧ (∀a. a ∈ set xs ⟶ (∀b. b ∈ set ys ⟶ a ≤ b)) ⟶ sorted (xs @ ys)
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted ([]::'a list) & sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a <= b)) --> sorted ([] @ ys)
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted (x # xs) & sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b)) --> sorted ((x # xs) @ ys)
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[6] sorted ([]::'a list) & sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a <= b))
    #[7] sorted ([] @ ys)
  ← rewrite append_def_1 goal=7
    #[8] sorted ys
  → forward conjD2 goal=8 facts=[6]
    #[9] sorted ys & (!a. a Mem set [] --> (!b. b Mem set ys --> a <= b))
  ← rule conjD1 goal=8 facts=[9]
    #[10] sorted ys
  ← intro x,xs goal=2
    #[11] _VAR x
    #[12] _VAR xs
    #[13] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)
    #[14] sorted (x # xs) & sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b))
    #[15] sorted ((x # xs) @ ys)
  → forward conjD1 goal=15 facts=[14]
    #[16] sorted (x # xs)
  → forward conjD2 goal=15 facts=[14]
    #[17] sorted ys & (!a. a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b))
  → forward conjD1 goal=15 facts=[17]
    #[18] sorted ys
  → forward conjD2 goal=15 facts=[17]
    #[19] !a. a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b)
  → forward sorted_cons_head param_x=x param_xs=xs goal=15 facts=[3,4,5,16]
    #[20] !y. y Mem set xs --> x <= y
  → forward sorted_cons_tail param_x=x param_xs=xs goal=15 facts=[3,4,5,16]
    #[21] sorted xs
  → forward mem_set_cons_self param_x=x param_xs=xs goal=15
    #[22] x Mem set (x # xs)
  ← inst x goal=15 facts=[19]
    #[23] x Mem set (x # xs) --> (!b. b Mem set ys --> x <= b)
  → forward goal=15 facts=[23,22]
    #[24] !b. b Mem set ys --> x <= b
  cut "∀a. a ∈ set xs ⟶ (∀b. b ∈ set ys ⟶ a ≤ b)" goal=15
    #[25] !a. a Mem set xs --> (!b. b Mem set ys --> a <= b)
  ← intro a goal=25
    #[26] _VAR a
    #[27] a Mem set xs
    #[28] !b. b Mem set ys --> a <= b
  ← intro b goal=28
    #[29] _VAR b
    #[30] b Mem set ys
    #[31] a <= b
  → forward mem_set_cons_weak param_x=x param_xs=xs param_z=a goal=31 facts=[27]
    #[32] a Mem set (x # xs)
  ← inst a goal=31 facts=[19]
    #[33] a Mem set (x # xs) --> (!b. b Mem set ys --> a <= b)
  → forward goal=31 facts=[33,32]
    #[34] !b. b Mem set ys --> a <= b
  ← rule all_mem_elim goal=31 facts=[34,30]
    #[35] a <= b
  → forward conjI goal=15 facts=[18,25]
    #[36] sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b))
  → forward conjI goal=15 facts=[21,36]
    #[37] sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b))
  → forward goal=15 facts=[13,3]
    #[38] linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)
  → forward goal=15 facts=[38,4]
    #[39] linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)
  → forward goal=15 facts=[39,5]
    #[40] sorted xs & sorted ys & (!a. a Mem set xs --> (!b. b Mem set ys --> a <= b)) --> sorted (xs @ ys)
  ← rewrite append_def_2 goal=15
    #[41] sorted (x # xs @ ys)
  ← rewrite sorted_def_2 sym=false goal=41
    #[42] (!y. y Mem set (xs @ ys) --> x <= y) & sorted (xs @ ys)
  ← rule conjI goal=42
    #[43] !y. y Mem set (xs @ ys) --> x <= y
    #[44] sorted (xs @ ys)
  ← apply_prev goal=44 facts=[40,37]
  ← rewrite member_set_append sym=false goal=43
    #[45] !y. y Mem set xs | y Mem set ys --> x <= y
  ← intro y goal=45
    #[46] _VAR y
    #[47] y Mem set xs | y Mem set ys
    #[48] x <= y
  ← cases "y ∈ set xs" goal=48
    #[49] y Mem set xs --> x <= y
    #[50] ~(y Mem set xs) --> x <= y
  ← intro goal=49
    #[51] y Mem set xs
    #[52] x <= y
  ← rule all_mem_elim goal=52 facts=[20,51]
    #[53] x <= y
  ← intro goal=50
    #[54] ~(y Mem set xs)
    #[55] x <= y
  → rewrite disj_comm sym=false target=fact goal=55 facts=[47]
    #[56] y Mem set ys | y Mem set xs
  → forward force_disj_true1 goal=55 facts=[56,54]
    #[57] y Mem set ys
  ← rule all_mem_elim goal=55 facts=[24,57]
    #[58] x <= y
qed

theorem sorted_appendE1
  fixes xs :: 'a::linorder list, ys :: 'a::linorder list
  prop sorted (xs @ ys) ⟶ sorted xs ∧ sorted ys
proof
  ← induct xs list_induct goal=0
    #[1] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted ([] @ ys) --> sorted ([]::'a list) & sorted ys
    #[2] !x. !xs. (linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted (xs @ ys) --> sorted xs & sorted ys) --> linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted ((x # xs) @ ys) --> sorted (x # xs) & sorted ys
  ← intro goal=1
    #[3] linorder (less_eq::'a => 'a => bool)
    #[4] linorder_lt (less::'a => 'a => bool)
    #[5] linorder_lt_le (less_eq::'a => 'a => bool) less
    #[6] sorted ([] @ ys)
    #[7] sorted ([]::'a list) & sorted ys
  ← rule conjI goal=7
    #[8] sorted ([]::'a list)
    #[9] sorted ys
  ← rewrite sorted_def_1 goal=8
    #[10] true
  ← rule trueI goal=10
    #[11] true
  ← rewrite append_def_1 sym=true goal=9
  ← intro x,xs goal=2
    #[12] _VAR x
    #[13] _VAR xs
    #[14] linorder (less_eq::'a => 'a => bool) --> linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted (xs @ ys) --> sorted xs & sorted ys
    #[15] sorted ((x # xs) @ ys)
    #[16] sorted (x # xs) & sorted ys
  → rewrite append_def_2 sym=false target=fact goal=16 facts=[15]
    #[17] sorted (x # xs @ ys)
  → rewrite sorted_def_2 sym=false target=fact goal=16 facts=[17]
    #[18] (!y. y Mem set (xs @ ys) --> x <= y) & sorted (xs @ ys)
  → forward conjD1 goal=16 facts=[18]
    #[19] !y. y Mem set (xs @ ys) --> x <= y
  → forward goal=16 facts=[14,3]
    #[20] linorder_lt (less::'a => 'a => bool) --> linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted (xs @ ys) --> sorted xs & sorted ys
  → forward goal=16 facts=[20,4]
    #[21] linorder_lt_le (less_eq::'a => 'a => bool) less --> sorted (xs @ ys) --> sorted xs & sorted ys
  → forward goal=16 facts=[21,5]
    #[22] sorted (xs @ ys) --> sorted xs & sorted ys
  → forward conjD2 goal=16 facts=[18]
    #[23] sorted (xs @ ys)
  → forward goal=16 facts=[22,23]
    #[24] sorted xs & sorted ys
  → forward conjD1 goal=16 facts=[24]
    #[25] sorted xs
  → forward conjD2 goal=16 facts=[24]
    #[26] sorted ys
  ← rule conjI goal=16
    #[27] sorted (x # xs)
  ← rewrite sorted_def_2 sym=false goal=27
    #[28] (!y. y Mem set xs --> x <= y) & sorted xs
  ← rule conjI goal=28
    #[29] !y. y Mem set xs --> x <= y
  ← intro y goal=29
    #[30] _VAR y
    #[31] y Mem set xs
    #[32] x <= y
  → forward member_set_append_left param_x=y param_xs=xs param_ys=ys goal=32
    #[33] y Mem set xs --> y Mem set (xs @ ys)
  → forward goal=32 facts=[33,31]
    #[34] y Mem set (xs @ ys)
  ← rule all_mem_elim goal=32 facts=[19,34]
    #[35] x <= y
qed
