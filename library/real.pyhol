theory real
imports rat
domains real
description "real numbers"

type real

const of_nat :: nat ⇒ real

const of_int :: int ⇒ real

def zero :: real = (0::real) = of_nat 0 [hint_rewrite,hint_rewrite_sym]

def one :: real = (1::real) = of_nat 1 [hint_rewrite,hint_rewrite_sym]

const plus :: real ⇒ real ⇒ real

def minus :: real ⇒ real ⇒ real = x - y = x + -y [hint_rewrite]

const times :: real ⇒ real ⇒ real

const real_inverse :: real ⇒ real

def real_divide :: real ⇒ real ⇒ real = x / y = x * real_inverse y [hint_rewrite]

fun power :: real ⇒ nat ⇒ real
  | x ^ (0::nat) = 1
  | x ^ Suc m = x * x ^ m

const less_eq :: real ⇒ real ⇒ bool

def less :: real ⇒ real ⇒ bool = x < y ⟷ ¬(y ≤ x) [hint_rewrite]

theorem real_add_assoc
  fixes x :: real, y :: real, z :: real
  prop x + (y + z) = x + y + z
  [hint_rewrite,hint_rewrite_sym]
proof
  ← z3 goal=0
qed

theorem real_add_comm
  fixes x :: real, y :: real
  prop x + y = y + x
  [hint_rewrite,hint_resolve]
proof
  ← z3 goal=0
qed

theorem real_add_lid
  fixes x :: real
  prop 0 + x = x
  [hint_rewrite]
proof
  ← z3 goal=0
qed

theorem real_add_rid
  fixes x :: real
  prop x + 0 = x
  [hint_rewrite]
proof
  ← rewrite real_add_comm sym=false goal=0
    #[1] 0 + x = x
  ← rewrite real_add_lid sym=false goal=1
qed

theorem real_add_linv
  fixes x :: real
  prop -x + x = 0
  [hint_rewrite]
proof
  ← z3 goal=0
qed

theorem real_mult_assoc
  fixes x :: real, y :: real, z :: real
  prop x * (y * z) = x * y * z
  [hint_rewrite,hint_rewrite_sym]
proof
  ← z3 goal=0
qed

theorem real_mult_comm
  fixes x :: real, y :: real
  prop x * y = y * x
  [hint_rewrite,hint_resolve,hint_backward]

theorem real_mul_lid
  fixes x :: real
  prop 1 * x = x
  [hint_rewrite]

theorem real_add_ldistrib
  fixes x :: real, y :: real, z :: real
  prop x * (y + z) = x * y + x * z
  [hint_rewrite]

theorem real_le_refl
  fixes x :: real
  prop x <= x
  [hint_resolve,hint_backward]
proof
  ← z3 goal=0
qed

theorem real_le_antisym
  fixes x :: real, y :: real
  prop x <= y & y <= x <--> x = y
  [hint_rewrite,hint_rewrite_sym]
proof
  ← z3 goal=0
qed

theorem real_le_trans
  fixes x :: real, y :: real, z :: real
  prop x <= y --> y <= z --> x <= z
  [hint_backward,hint_forward,hint_backward1]

theorem real_le_total
  fixes x :: real, y :: real
  prop x <= y | y <= x
  [hint_resolve,hint_backward]
proof
  ← z3 goal=0
qed

theorem real_le_ladd_imp
  fixes x :: real, y :: real, z :: real
  prop y <= z --> x + y <= x + z
  [hint_backward,hint_forward]

theorem real_le_mul
  fixes x :: real, y :: real
  prop 0 <= x --> 0 <= y --> 0 <= x * y
  [hint_forward,hint_backward,hint_backward1]

theorem real_ge_add
  fixes x :: real, y :: real
  prop x >= 0 --> y >= 0 --> x + y >= 0

theorem real_ge_mul
  fixes x :: real, y :: real
  prop x >= 0 --> y >= 0 --> x * y >= 0

theorem real_ge_divide
  fixes x :: real, y :: real
  prop x >= 0 --> y > 0 --> x / y >= 0

theorem real_gt_add
  fixes x :: real, y :: real
  prop x > 0 --> y > 0 --> x + y > 0

theorem real_gt_mul
  fixes x :: real, y :: real
  prop x > 0 --> y > 0 --> x * y > 0

theorem real_lt_neq
  fixes x :: real, y :: real
  prop x < y --> ~(x = y)

theorem real_gt_neq
  fixes x :: real, y :: real
  prop x > y --> ~(x = y)

theorem real_gt_to_neq
  fixes x :: real
  prop x > 0 --> ~(x = 0)

theorem real_lt_le
  fixes x :: real, y :: real
  prop x < y <--> x <= y & ~(x = y)
  [hint_rewrite]

theorem real_inv_0
  prop real_inverse 0 = 0
  [hint_rewrite]

theorem real_mul_linv
  fixes x :: real
  prop ~(x = 0) --> real_inverse x * x = 1
  [hint_backward,hint_forward]

theorem real_of_nat_eq
  fixes m :: nat, n :: nat
  prop (of_nat::nat => real) m = of_nat n <--> m = n
  [hint_rewrite]

theorem real_of_nat_id
  fixes n :: nat
  prop (of_nat::nat => real) (of_nat n) = of_nat n
  [hint_rewrite]
proof
  ← rewrite real_of_nat_eq sym=false goal=0
    #[1] of_nat n = n
  ← rewrite nat_of_nat_def sym="" goal=1
qed

theorem real_of_nat_le
  fixes m :: nat, n :: nat
  prop (of_nat::nat => real) m <= of_nat n <--> m <= n
  [hint_rewrite]

theorem real_of_nat_lt
  fixes m :: nat, n :: nat
  prop (of_nat::nat => real) m < of_nat n <--> m < n
  [hint_rewrite]

theorem real_of_nat_add
  fixes m :: nat, n :: nat
  prop (of_nat::nat => real) m + of_nat n = of_nat (m + n)
  [hint_rewrite,hint_rewrite_sym]

theorem real_of_nat_minus
  fixes m :: nat, n :: nat
  prop of_nat (m - n) = (if m >= n then of_nat m - of_nat n else (0::real))
  [hint_rewrite]

theorem real_of_nat_mul
  fixes m :: nat, n :: nat
  prop (of_nat::nat => real) m * of_nat n = of_nat (m * n)
  [hint_rewrite]

theorem real_add_ac3
  fixes x :: real, y :: real, z :: real
  prop x + (y + z) = y + (x + z)
  [hint_rewrite]
proof
  ← rewrite real_add_assoc goal=0
    #[1] x + y + z = y + x + z
  ← rewrite real_add_comm goal=1
    #[2] z + (x + y) = z + (y + x)
  → forward real_add_comm param_x=x param_y=y goal=2
    #[3] x + y = y + x
  ← rewrite source=prev goal=2 facts=[3]
qed

theorem real_add_rinv
  fixes x :: real
  prop x + -x = 0
  [hint_rewrite]
proof
  ← rewrite real_add_comm goal=0
    #[1] -x + x = 0
  ← rewrite real_add_linv goal=1
qed

theorem real_eq_add_lcancel
  fixes x :: real, y :: real, z :: real
  prop x + y = x + z <--> y = z
  [hint_rewrite,hint_resolve,hint_rewrite_sym]
proof
  ← rule iffI goal=0
    #[1] x + y = x + z ⟶ y = z
    #[2] y = z ⟶ x + y = x + z
  ← intro goal=1
    #[3] x + y = x + z
    #[4] y = z
  cut "-x + (x + y) = -x + (x + z)" goal=4
    #[5] -x + (x + y) = -x + (x + z)
  ← rewrite source=prev goal=5 facts=[3]
  → rewrite target=fact real_add_assoc goal=4 facts=[5]
    #[6] -x + x + y = -x + x + z
  → rewrite target=fact real_add_linv goal=4 facts=[6]
    #[7] 0 + y = 0 + z
  → rewrite target=fact real_add_lid goal=4 facts=[7]
  ← intro goal=2
    #[8] y = z
    #[9] x + y = x + z
  ← rewrite source=prev goal=9 facts=[8]
qed

theorem real_eq_add_rcancel
  fixes x :: real, y :: real, z :: real
  prop x + z = y + z <--> x = y
  [hint_rewrite]
proof
  ← rewrite real_add_comm goal=0
    #[1] z + x = z + y ⟷ x = y
  ← rewrite real_eq_add_lcancel goal=1
qed

theorem real_mul_rzero
  fixes x :: real
  prop x * 0 = 0
  [hint_rewrite]
proof
  cut "x * (0 + 1) = 0 + x * 1" goal=0
    #[1] x * (0 + 1) = 0 + x * 1
  ← rewrite real_add_lid goal=1
  → rewrite target=fact real_add_ldistrib goal=0 facts=[1]
    #[2] x * 0 + x * 1 = 0 + x * 1
  → rewrite target=fact real_eq_add_rcancel goal=0 facts=[2]
qed

theorem real_mul_lzero
  fixes x :: real
  prop 0 * x = 0
  [hint_rewrite]
proof
  ← rewrite real_mult_comm goal=0
    #[1] x * 0 = 0
  ← rewrite real_mul_rzero goal=1
qed

theorem real_neg_neg
  fixes x :: real
  prop --x = x
  [hint_rewrite]
proof
  cut "--x + -x = x + -x" goal=0
    #[1] --x + -x = x + -x
  ← rewrite real_add_linv goal=1
    #[2] 0 = x + -x
  ← rewrite real_add_rinv goal=2
  → rewrite target=fact real_eq_add_rcancel goal=0 facts=[1]
qed

theorem real_mul_rneg
  fixes x :: real, y :: real
  prop x * -y = -(x * y)
  [hint_rewrite,hint_rewrite_sym]
proof
  cut "x * (-y + y) = -(x * y) + (x * y)" goal=0
    #[1] x * (-y + y) = -(x * y) + x * y
  ← rewrite real_add_linv goal=1
    #[2] x * 0 = 0
  ← rewrite real_mul_rzero goal=2
  → rewrite target=fact real_add_ldistrib goal=0 facts=[1]
    #[3] x * -y + x * y = -(x * y) + x * y
  → rewrite target=fact real_eq_add_rcancel goal=0 facts=[3]
qed

theorem real_mul_lneg
  fixes x :: real, y :: real
  prop -x * y = -(x * y)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_mult_comm goal=0
    #[1] y * -x = -(y * x)
  ← rewrite real_mul_rneg goal=1
qed

theorem real_lt_add2
  fixes w :: real, x :: real, y :: real, z :: real
  prop w < x --> y < z --> w + y < x + z
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] w < x
    #[2] y < z
    #[3] w + y < x + z
  ← z3 goal=3 facts=[2,1]
qed

theorem real_le_add2
  fixes w :: real, x :: real, y :: real, z :: real
  prop w <= x --> y <= z --> w + y <= x + z
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] w ≤ x
    #[2] y ≤ z
    #[3] w + y ≤ x + z
  ← z3 goal=3 facts=[1,2]
qed

theorem real_neg_add
  fixes x :: real, y :: real
  prop -(x + y) = -x + -y
  [hint_rewrite]
proof
  cut "-(x+y) + (x +y) = -x + -y + (x + y)" goal=0
    #[1] -(x + y) + (x + y) = -x + -y + (x + y)
  ← rewrite real_add_linv goal=1
    #[2] 0 = -x + -y + (x + y)
  ← rewrite real_add_ac3 sym=false goal=2
    #[3] 0 = x + (-x + -y + y)
  ← rewrite real_add_assoc sym=true goal=3
    #[4] 0 = x + (-x + (-y + y))
  ← rewrite real_add_linv sym=false goal=4
    #[5] 0 = x + (-x + 0)
  ← rewrite real_add_rid sym=false goal=5
    #[6] 0 = x + -x
  ← rewrite real_add_rinv sym=false goal=6
  → rewrite target=fact real_eq_add_rcancel sym=false goal=0 facts=[1]
qed

theorem real_neg_0
  prop -(0::real) = 0
  [hint_rewrite]
proof
  cut "-(0::real) + 0 = 0 + 0" goal=0
    #[1] -(0::real) + 0 = 0 + 0
  ← rewrite real_add_linv goal=1
    #[2] (0::real) = 0 + 0
  ← rewrite real_add_rid goal=2
  → rewrite target=fact real_eq_add_rcancel goal=0 facts=[1]
qed

theorem real_le_lneg
  fixes x :: real, y :: real
  prop -x <= y <--> 0 <= x + y
  [hint_rewrite]

theorem real_le_lneg2
  fixes x :: real, y :: real
  prop -x <= -y <--> y <= x
  [hint_rewrite]
proof
  cut "-x <= -y <--> --y <= x" goal=0
    #[1] -x ≤ -y ⟷ --y ≤ x
  ← rewrite real_le_lneg goal=1
    #[2] 0 ≤ x + -y ⟷ 0 ≤ -y + x
  ← rule iffI goal=2
    #[3] 0 ≤ x + -y ⟶ 0 ≤ -y + x
    #[4] 0 ≤ -y + x ⟶ 0 ≤ x + -y
  ← intro goal=3
    #[5] 0 ≤ x + -y
    #[6] 0 ≤ -y + x
  ← rewrite real_add_comm goal=6
  ← intro goal=4
    #[7] 0 ≤ -y + x
    #[8] 0 ≤ x + -y
  ← rewrite real_add_comm goal=8
  ← rewrite source=prev goal=0 facts=[1]
    #[9] --y ≤ x ⟷ y ≤ x
  ← rewrite real_neg_neg goal=9
qed

theorem real_le_rneg
  fixes x :: real, y :: real
  prop x <= -y <--> x + y <= 0
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] x ≤ -y ⟶ x + y ≤ 0
    #[2] x + y ≤ 0 ⟶ x ≤ -y
  ← intro goal=1
    #[3] x ≤ -y
    #[4] x + y ≤ 0
  → forward real_le_ladd_imp param_x=y goal=4 facts=[3]
    #[5] y + x ≤ y + -y
  → rewrite target=fact real_add_rinv goal=4 facts=[5]
    #[6] y + x ≤ 0
  ← rewrite real_add_comm goal=4
  ← intro goal=2
    #[7] x + y ≤ 0
    #[8] x ≤ -y
  → forward real_le_ladd_imp param_x=-y goal=8 facts=[7]
    #[9] -y + (x + y) ≤ -y + 0
  → rewrite target=fact real_add_ac3 goal=8 facts=[9]
    #[10] x + (-y + y) ≤ -y + 0
  → rewrite target=fact real_add_linv goal=8 facts=[10]
    #[11] x + 0 ≤ -y + 0
  → rewrite target=fact real_add_rid goal=8 facts=[11]
qed

theorem real_entire
  fixes x :: real, y :: real
  prop x * y = 0 <--> x = 0 | y = 0
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] x * y = 0 ⟶ x = 0 ∨ y = 0
    #[2] x = 0 ∨ y = 0 ⟶ x * y = 0
  ← cases "x = 0" goal=1
    #[3] x = 0 ⟶ x * y = 0 ⟶ x = 0 ∨ y = 0
    #[4] ¬(x = 0) ⟶ x * y = 0 ⟶ x = 0 ∨ y = 0
  ← intro goal=3
    #[5] x = 0
    #[6] x * y = 0
    #[7] x = 0 ∨ y = 0
  ← rule disjI1 goal=7
  ← intro goal=4
    #[8] ¬(x = 0)
    #[9] x = 0 ∨ y = 0
  ← rule disjI2 goal=9
    #[10] y = 0
  cut "real_inverse x * x * y = y" goal=10
    #[11] real_inverse x * x * y = y
  → forward real_mul_linv goal=11 facts=[8]
    #[12] real_inverse x * x = 1
  ← rewrite source=prev goal=11 facts=[12]
    #[13] 1 * y = y
  ← rewrite real_mul_lid sym=false goal=13
    #[14] 1 * y = y
  → rewrite target=fact real_mult_assoc sym=true goal=10 facts=[11]
    #[15] real_inverse x * (x * y) = y
  → rewrite target=fact source=prev goal=10 facts=[6,15]
    #[16] real_inverse x * 0 = y
  → rewrite target=fact real_mul_rzero sym=false goal=10 facts=[16]
    #[17] 0 = y
  ← rewrite eq_sym_eq sym=false goal=10
  ← intro goal=2
    #[18] x = 0 ∨ y = 0
    #[19] x * y = 0
  ← rule disjE goal=19 facts=[18]
    #[20] x = 0 ⟶ x * y = 0
    #[21] y = 0 ⟶ x * y = 0
  ← intro goal=20
    #[22] x * y = 0
  ← rewrite source=prev goal=22 facts=[5]
    #[23] 0 * y = 0
  ← rewrite real_mul_lzero sym=false goal=23
    #[24] 0 * y = 0
  ← intro goal=21
    #[25] y = 0
    #[26] x * y = 0
  ← rewrite source=prev goal=26 facts=[25]
    #[27] x * 0 = 0
  ← rewrite real_mul_rzero sym=false goal=27
    #[28] x * 0 = 0
qed

theorem real_le_negtotal
  fixes x :: real
  prop 0 <= x | 0 <= -x
  [hint_backward]
proof
  ← rewrite real_le_rneg sym=false goal=0
    #[1] 0 ≤ x ∨ 0 + x ≤ 0
  ← rewrite real_add_lid sym=false goal=1
    #[2] 0 ≤ x ∨ x ≤ 0
  ← rule real_le_total goal=2
qed

theorem real_le_square
  fixes x :: real
  prop 0 <= x * x
  [hint_backward]
proof
  → forward real_le_negtotal param_x=x goal=0
    #[1] 0 ≤ x ∨ 0 ≤ -x
  ← rule disjE goal=0 facts=[1]
    #[2] 0 ≤ x ⟶ 0 ≤ x * x
    #[3] 0 ≤ -x ⟶ 0 ≤ x * x
  ← intro goal=2
    #[4] 0 ≤ x
    #[5] 0 ≤ x * x
  ← rule real_le_mul goal=5
  ← intro goal=3
    #[6] 0 ≤ -x
    #[7] 0 ≤ x * x
  → forward real_le_mul param_y=-x goal=7 facts=[6]
    #[8] 0 ≤ -x ⟶ 0 ≤ -x * -x
  → forward goal=7 facts=[8,6]
    #[9] 0 ≤ -x * -x
  → rewrite target=fact real_mul_rneg sym=false goal=7 facts=[9]
    #[10] 0 ≤ -(-x * x)
  → rewrite target=fact real_mul_lneg sym=false goal=7 facts=[10]
    #[11] 0 ≤ --(x * x)
  → rewrite target=fact real_neg_neg sym=false goal=7 facts=[11]
qed

theorem real_mul_rid
  fixes x :: real
  prop x * 1 = x
  [hint_rewrite]
proof
  ← rewrite real_mult_comm sym=false goal=0
    #[1] 1 * x = x
  ← rewrite real_mul_lid sym=false goal=1
qed

theorem real_pow_2
  fixes x :: real
  prop x ^ (2::nat) = x * x
  [hint_rewrite]
proof
  cut "(2::nat) = Suc 1" goal=0
    #[1] 2 = Suc 1
  nat_norm goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] x ^ Suc 1 = x * x
  ← rewrite real_nat_power_def_2 sym=false goal=2
    #[3] x * x ^ (1::nat) = x * x
  ← rewrite nat_one_def sym=false goal=3
    #[4] x * x ^ Suc 0 = x * x
  ← rewrite real_nat_power_def_2 sym=false goal=4
    #[5] x * (x * x ^ (0::nat)) = x * x
  ← rewrite real_nat_power_def_1 sym=false goal=5
    #[6] x * (x * 1) = x * x
  ← rewrite real_mult_comm sym=false goal=6
    #[7] x * 1 * x = x * x
  ← rewrite real_mult_assoc sym=true goal=7
    #[8] x * (1 * x) = x * x
  ← rewrite real_mul_lid sym=false goal=8
qed

theorem real_pow_3
  fixes x :: real
  prop x ^ (3::nat) = x * x * x

theorem real_pos
  fixes n :: nat
  prop (0::real) <= of_nat n
  [hint_backward]
proof
  ← rewrite real_zero_def sym=false goal=0
    #[1] (of_nat::nat ⇒ real) 0 ≤ of_nat n
  ← rewrite real_of_nat_le sym=false goal=1
    #[2] 0 ≤ n
  ← rule le_0 goal=2
qed

theorem real_of_nat_pow
  fixes n :: nat, x :: nat
  prop (of_nat::nat => real) x ^ n = of_nat (x ^ n)
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] (of_nat::nat ⇒ real) x ^ (0::nat) = of_nat (x ^ (0::nat))
    #[2] ∀n. (of_nat::nat ⇒ real) x ^ n = of_nat (x ^ n) ⟶ (of_nat::nat ⇒ real) x ^ Suc n = of_nat (x ^ Suc n)
  ← rewrite nat_nat_power_def_1 goal=1
    #[3] (of_nat::nat ⇒ real) x ^ (0::nat) = of_nat 1
  ← rewrite real_nat_power_def_1 goal=3
    #[4] (1::real) = of_nat 1
  ← rewrite real_one_def goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] (of_nat::nat ⇒ real) x ^ n = of_nat (x ^ n)
    #[7] (of_nat::nat ⇒ real) x ^ Suc n = of_nat (x ^ Suc n)
  ← rewrite nat_nat_power_def_2 goal=7
    #[8] (of_nat::nat ⇒ real) x ^ Suc n = of_nat (x * x ^ n)
  ← rewrite real_nat_power_def_2 goal=8
    #[9] (of_nat::nat ⇒ real) x * of_nat x ^ n = of_nat (x * x ^ n)
  ← rewrite source=prev goal=9 facts=[6]
    #[10] (of_nat::nat ⇒ real) x * of_nat (x ^ n) = of_nat (x * x ^ n)
  ← rewrite real_of_nat_mul goal=10
    #[11] (of_nat::nat ⇒ real) x * of_nat (x ^ n) = of_nat (x * x ^ n)
qed

theorem real_pow_neg
  fixes n :: nat, x :: real
  prop -x ^ n = (if even n then x ^ n else -(x ^ n))
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] -x ^ (0::nat) = (if even 0 then x ^ (0::nat) else -(x ^ (0::nat)))
    #[2] ∀n. -x ^ n = (if even n then x ^ n else -(x ^ n)) ⟶ -x ^ Suc n = (if even (Suc n) then x ^ Suc n else -(x ^ Suc n))
  ← rewrite real_nat_power_def_1 goal=1
    #[3] (1::real) = (if even 0 then 1 else -1)
  ← rewrite even_def_1 goal=3
    #[4] (1::real) = (if true then 1 else -1)
  ← rewrite if_true sym=false goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] -x ^ n = (if even n then x ^ n else -(x ^ n))
    #[7] -x ^ Suc n = (if even (Suc n) then x ^ Suc n else -(x ^ Suc n))
  ← rewrite even_def_2 goal=7
    #[8] -x ^ Suc n = (if ¬(even n) then x ^ Suc n else -(x ^ Suc n))
  ← rewrite real_nat_power_def_2 goal=8
    #[9] -x * -x ^ n = (if ¬(even n) then x * x ^ n else -(x * x ^ n))
  ← rewrite source=prev goal=9 facts=[6]
    #[10] -x * (if even n then x ^ n else -(x ^ n)) = (if ¬(even n) then x * x ^ n else -(x * x ^ n))
  ← cases "even n" goal=10
    #[11] even n ⟶ -x * (if even n then x ^ n else -(x ^ n)) = (if ¬(even n) then x * x ^ n else -(x * x ^ n))
    #[12] ¬(even n) ⟶ -x * (if even n then x ^ n else -(x ^ n)) = (if ¬(even n) then x * x ^ n else -(x * x ^ n))
  ← intro goal=11
    #[13] even n
    #[14] -x * (if even n then x ^ n else -(x ^ n)) = (if ¬(even n) then x * x ^ n else -(x * x ^ n))
  ← rewrite if_P sym=false goal=14 facts=[13]
    #[15] -x * x ^ n = (if ¬(even n) then x * x ^ n else -(x * x ^ n))
  → rewrite target=fact double_neg sym=true goal=15 facts=[13]
    #[16] ¬¬(even n)
  ← rewrite if_not_P sym=false goal=15 facts=[16]
    #[17] -x * x ^ n = -(x * x ^ n)
  ← rewrite real_mul_lneg sym=false goal=17
    #[18] -x * x ^ n = -(x * x ^ n)
  ← intro goal=12
    #[19] ¬(even n)
    #[20] -x * (if even n then x ^ n else -(x ^ n)) = (if ¬(even n) then x * x ^ n else -(x * x ^ n))
  ← rewrite if_not_P sym=false goal=20 facts=[19]
    #[21] -x * -(x ^ n) = (if ¬(even n) then x * x ^ n else -(x * x ^ n))
  ← rewrite if_P sym=false goal=21 facts=[19]
    #[22] -x * -(x ^ n) = x * x ^ n
  ← rewrite real_mul_rneg sym=false goal=22
    #[23] -(-x * x ^ n) = x * x ^ n
  ← rewrite real_mul_lneg sym=false goal=23
    #[24] --(x * x ^ n) = x * x ^ n
  ← rewrite real_neg_neg sym=false goal=24
    #[25] --(x * x ^ n) = x * x ^ n
qed

theorem real_abs_nat
  fixes n :: nat
  prop (abs::real => real) (of_nat n) = of_nat n
  [hint_rewrite]
proof
  ← rewrite abs_def goal=0
    #[1] (if (0::real) ≤ of_nat n then (of_nat::nat ⇒ real) n else -(of_nat n)) = of_nat n
  ← rewrite real_zero_def goal=1
    #[2] (if (of_nat::nat ⇒ real) 0 ≤ of_nat n then (of_nat::nat ⇒ real) n else -(of_nat n)) = of_nat n
  ← rewrite real_of_nat_le goal=2
    #[3] (if 0 ≤ n then (of_nat::nat ⇒ real) n else -(of_nat n)) = of_nat n
  cut "0 <= n" goal=3
    #[4] 0 ≤ n
  ← rule le_0 goal=4
  ← rewrite if_P sym=false goal=3 facts=[4]
qed

theorem real_abs_neg
  fixes x :: real
  prop abs (-x) = abs x
  [hint_rewrite]
proof
  ← z3 goal=0
qed

theorem real_eqI_from_lt_gt
  fixes x :: real, y :: real
  prop (x < y --> false) --> (y < x --> false) --> x = y
  [hint_backward]

theorem real_lt_mul
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> 0 < x * y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] 0 < x * y
  ← rewrite real_lt_le sym=false goal=3
    #[4] 0 ≤ x * y ∧ ¬(0 = x * y)
  → rewrite target=fact real_lt_le sym=false goal=4 facts=[1]
    #[5] 0 ≤ x ∧ ¬(0 = x)
  → rewrite target=fact real_lt_le sym=false goal=4 facts=[2]
    #[6] 0 ≤ y ∧ ¬(0 = y)
  ← rule conjI goal=4
    #[7] 0 ≤ x * y
    #[8] ¬(0 = x * y)
  ← rule real_le_mul goal=7
    #[9] 0 ≤ x
    #[10] 0 ≤ y
  ← rule conjD1 goal=9 facts=[5]
    #[11] 0 ≤ x
  ← rule conjD1 goal=10 facts=[6]
    #[12] 0 ≤ y
  ← rewrite eq_sym_eq sym=false goal=8
    #[13] ¬(x * y = 0)
  ← rewrite real_entire sym=false goal=13
    #[14] ¬(x = 0 ∨ y = 0)
  ← rewrite de_morgan_thm2 sym=false goal=14
    #[15] ¬(x = 0) ∧ ¬(y = 0)
  ← rule conjI goal=15
    #[16] ¬(x = 0)
    #[17] ¬(y = 0)
  ← rewrite eq_sym_eq sym=false goal=16
    #[18] ¬(0 = x)
  ← rule conjD2 goal=18 facts=[5]
    #[19] ¬(0 = x)
  ← rewrite eq_sym_eq sym=false goal=17
    #[20] ¬(0 = y)
  ← rule conjD2 goal=20 facts=[6]
    #[21] ¬(0 = y)
qed

theorem real_lte_total
  fixes x :: real, y :: real
  prop x < y | y <= x
  [hint_resolve]
proof
  ← rewrite real_less_def goal=0
    #[1] ¬(y ≤ x) ∨ y ≤ x
  ← cases "y <= x" goal=1
    #[2] y ≤ x ⟶ ¬(y ≤ x) ∨ y ≤ x
    #[3] ¬(y ≤ x) ⟶ ¬(y ≤ x) ∨ y ≤ x
  ← intro goal=2
    #[4] y ≤ x
    #[5] ¬(y ≤ x) ∨ y ≤ x
  ← rule disjI2 goal=5 facts=[4]
  ← intro goal=3
    #[6] ¬(y ≤ x)
    #[7] ¬(y ≤ x) ∨ y ≤ x
  ← rule disjI1 goal=7 facts=[6]
qed

theorem real_lt_imp_le
  fixes x :: real, y :: real
  prop x < y --> x <= y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x < y
    #[2] x ≤ y
  → rewrite target=fact real_less_def goal=2 facts=[1]
    #[3] ¬(y ≤ x)
  cut "x <=y | y <= x" goal=2
    #[4] x ≤ y ∨ y ≤ x
  ← rule real_le_total goal=4
    #[5] x ≤ y ∨ y ≤ x
  ← rule disjE goal=2 facts=[5]
    #[6] x ≤ y ⟶ x ≤ y
    #[7] y ≤ x ⟶ x ≤ y
  ← intro goal=7
    #[8] y ≤ x
    #[9] x ≤ y
  ← rule negE_gen goal=9 facts=[3]
qed

theorem real_lte_trans
  fixes x :: real, y :: real, z :: real
  prop x < y --> y <= z --> x < z
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] x < y
    #[2] y ≤ z
    #[3] x < z
  ← rewrite real_less_def sym=false goal=3
    #[4] ¬(z ≤ x)
  → rewrite target=fact real_less_def sym=false goal=4 facts=[1]
    #[5] ¬(y ≤ x)
  ← rule negI goal=4
    #[6] z ≤ x ⟶ false
  ← intro goal=6 facts=[2]
    #[7] z ≤ x
    #[8] false
  → forward real_le_trans goal=8 facts=[2,7]
    #[9] y ≤ x
  ← rule negE goal=8 facts=[5,9]
qed

theorem real_let_trans
  fixes x :: real, y :: real, z :: real
  prop x <= y --> y < z --> x < z
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] x ≤ y
    #[2] y < z
    #[3] x < z
  → rewrite target=fact real_less_def sym=false goal=3 facts=[2]
    #[4] ¬(z ≤ y)
  ← rewrite real_less_def sym=false goal=3
    #[5] ¬(z ≤ x)
  ← rule negI goal=5
    #[6] z ≤ x ⟶ false
  ← intro goal=6
    #[7] z ≤ x
    #[8] false
  → forward real_le_trans goal=8 facts=[7,1]
    #[9] z ≤ y
  ← rule negE goal=8 facts=[4,9]
qed

theorem real_lt_trans
  fixes x :: real, y :: real, z :: real
  prop x < y --> y < z --> x < z
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] x < y
    #[2] y < z
    #[3] x < z
  ← rule real_lte_trans param_y=y goal=3
    #[4] y ≤ z
  ← rule real_lt_imp_le goal=4
qed

theorem real_geq_trans
  fixes x :: real, y :: real, z :: real
  prop x >= y --> y >= z --> x >= z

theorem real_le_add
  fixes x :: real, y :: real
  prop 0 <= x --> 0 <= y --> 0 <= x + y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ y
    #[3] 0 ≤ x + y
  ← rule real_le_trans param_y="x + 0" goal=3
    #[4] 0 ≤ x + 0
    #[5] x + 0 ≤ x + y
  ← rewrite real_add_rid sym=false goal=4
  ← rule real_le_ladd_imp goal=5
qed

theorem real_lte_antisym
  fixes x :: real, y :: real
  prop ~(x < y & y <= x)
  [hint_backward,hint_resolve]
proof
  ← rewrite real_less_def goal=0
    #[1] ¬(¬(y ≤ x) ∧ y ≤ x)
  ← rule negI goal=1
    #[2] ¬(y ≤ x) ∧ y ≤ x ⟶ false
  ← intro goal=2
    #[3] ¬(y ≤ x) ∧ y ≤ x
    #[4] false
  → forward conjD1 goal=4 facts=[3]
    #[5] ¬(y ≤ x)
  → forward conjD2 goal=4 facts=[3]
    #[6] y ≤ x
  ← rule negE goal=4 facts=[5]
qed

theorem real_sub_le
  fixes x :: real, y :: real
  prop 0 <= x - y <--> y <= x
  [hint_rewrite]
proof
  cut "--y <= x <--> y <= x" goal=0
    #[1] --y ≤ x ⟷ y ≤ x
  ← rewrite real_neg_neg goal=1
  → rewrite target=fact real_le_lneg goal=0 facts=[1]
    #[2] 0 ≤ -y + x ⟷ y ≤ x
  ← rewrite real_minus_def goal=0
    #[3] 0 ≤ x + -y ⟷ y ≤ x
  ← rewrite real_add_comm goal=3
qed

theorem real_neg_sub
  fixes x :: real, y :: real
  prop -(x - y) = y - x
  [hint_rewrite]

theorem real_le_lt
  fixes x :: real, y :: real
  prop x <= y <--> x < y | x = y
  [hint_rewrite]

theorem real_sub_lt
  fixes x :: real, y :: real
  prop 0 < x - y <--> y < x
  [hint_rewrite]
proof
  ← rewrite real_less_def goal=0
    #[1] ¬(x - y ≤ 0) ⟷ ¬(x ≤ y)
  cut "x - y = -(y - x)" goal=1
    #[2] x - y = -(y - x)
  ← rewrite real_neg_sub goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] ¬(-(y - x) ≤ 0) ⟷ ¬(x ≤ y)
  ← rewrite real_le_lneg goal=3
    #[4] ¬(0 ≤ y - x + 0) ⟷ ¬(x ≤ y)
qed

theorem real_not_lt
  fixes x :: real, y :: real
  prop ~(x < y) <--> y <= x
  [hint_rewrite,hint_rewrite_sym]

theorem real_sub_0
  fixes x :: real, y :: real
  prop x - y = 0 <--> x = y
  [hint_rewrite]
proof
  cut "x - y = 0 <--> x - y <= 0 & 0 <= x - y" goal=0
    #[1] x - y = 0 ⟷ x - y ≤ 0 ∧ 0 ≤ x - y
  ← rewrite real_le_antisym goal=1
  ← rewrite source=prev goal=0 facts=[1]
    #[2] x - y ≤ 0 ∧ 0 ≤ x - y ⟷ x = y
  ← rewrite real_sub_le goal=2
    #[3] x - y ≤ 0 ∧ y ≤ x ⟷ x = y
  cut "x - y <= 0 <--> ~(0 < x - y)" goal=3
    #[4] x - y ≤ 0 ⟷ ¬(0 < x - y)
  ← rewrite real_not_lt goal=4
  ← rewrite source=prev goal=3 facts=[4]
    #[5] ¬(0 < x - y) ∧ y ≤ x ⟷ x = y
  ← rewrite real_sub_lt goal=5
    #[6] ¬(y < x) ∧ y ≤ x ⟷ x = y
  ← rewrite real_not_lt goal=6
    #[7] x ≤ y ∧ y ≤ x ⟷ x = y
  ← rewrite real_le_antisym goal=7
qed

theorem real_poly_neg1
