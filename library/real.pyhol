    5: apply_backward_step conjD1 @3
    7: rewrite_goal eq_sym_eq sym=false
    7: rewrite_goal real_entire sym=false
    7: rewrite_goal de_morgan_thm2 sym=false
    7: apply_backward_step conjI
    7: rewrite_goal eq_sym_eq sym=false
    7: apply_backward_step conjD2 @2
    9: rewrite_goal eq_sym_eq sym=false
    9: apply_backward_step conjD2 @3
  qed

