theorem real_abs_mul
  fixes x :: real, y :: real
  prop abs (x * y) = abs x * abs y
  [hint_rewrite,hint_rewrite_sym]
proof
  ← cases "0 <= x" goal=0
    #[1] 0 ≤ x ⟶ abs (x * y) = abs x * abs y
    #[2] ¬(0 ≤ x) ⟶ abs (x * y) = abs x * abs y
  ← intro goal=1
    #[3] 0 ≤ x
    #[4] abs (x * y) = abs x * abs y
  ← rewrite abs_def goal=4
    #[5] (if 0 ≤ x * y then x * y else -(x * y)) = (if 0 ≤ x then x else -x) * (if 0 ≤ y then y else -y)
  ← z3 goal=5
    #[6] (if 0 ≤ x * y then x * y else -(x * y)) = (if 0 ≤ x then x else -x) * (if 0 ≤ y then y else -y)
  ← z3 goal=2
qed

