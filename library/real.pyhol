  prop x > y --> min x y = y
proof
  ← intro goal=0
    #[1] x > y
    #[2] min x y = y
  ← rewrite min_def sym=false goal=2
    #[3] (if x ≤ y then x else y) = y
  ← rule if_not_P1 goal=3
    #[4] ¬(x ≤ y)
  ← z3 goal=4 facts=[1]
qed

