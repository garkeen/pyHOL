theorem real_inc_lower_bound1
  fixes l :: real, u :: real, v :: real, x :: real
  prop x ≥ u + l ⟶ x ≥ v + l ⟶ u ≥ v ⟶ x ≥ u + l

theorem real_inc_lower_bound2
  fixes l :: real, u :: real, v :: real, x :: real
  prop x ≥ u + l ⟶ x ≥ v ⟶ u ≥ v ⟶ x ≥ u + l

theorem real_inc_lower_bound3
  fixes l :: real, u :: real, v :: real, x :: real
  prop x ≥ u ⟶ x ≥ v + l ⟶ u ≥ v ⟶ x ≥ u

theorem real_less_to_leq
  fixes l :: real, u :: real, x :: real
  prop x < u ⟶ (∃l. x ≤ u - l)

theorem real_greater_to_geq
  fixes l :: real, u :: real, x :: real
  prop x > l ⟶ (∃u. x ≥ l + u)

theorem real_leq_conj_exists
  fixes Q :: real ⇒ bool, u :: real, x :: real
  prop x ≤ u ⟶ (∃t. Q t) ⟶ (∃t1. x ≤ u ∧ Q t1)

theorem real_geq_refl
  fixes x :: real
  prop x ≥ x

theorem real_leq_or_not_less
  fixes b :: real, x :: real
  prop x ≥ b ∨ ¬(x > b)

theorem real_geq_or_not_gt
  fixes b :: real, x :: real
  prop x ≤ b ∨ ¬(x < b)

theorem real_geq_sym
  fixes x :: real, y :: real
  prop x ≥ y ∨ y ≥ x

theorem real_leq_sym
  fixes x :: real, y :: real
  prop x ≤ y ∨ y ≤ x

theorem real_gt_neg_lt
  fixes x :: real, y :: real
  prop x > y ⟷ ¬(x < y)

theorem real_not_geq
  fixes x :: real, y :: real
  prop ¬(x ≥ y) ⟷ x < y

theorem real_simplex_delta1
  fixes delta :: real, x :: real
  prop delta > 0 ⟶ x ≤ 0 ⟶ delta > x

theorem real_simplex_delta2
  fixes x :: real, y :: real, z :: real
  prop x - y < z ⟷ y > x - z

theorem real_simplex_delta3
  fixes c :: real, x :: real, y :: real
  prop c > 0 ⟶ c * x > y ⟷ x > 1 / c * y

theorem real_not_gt
  fixes x :: real, y :: real
  prop ¬(x > y) ⟷ x ≤ y

theorem real_neg_lt
  fixes x :: real, y :: real
  prop ¬(x < y) ⟷ x ≥ y

theorem real_divides_larger_1
  fixes x :: real, y :: real
  prop y ≥ 1 ⟶ x > 0 ⟶ x ≥ x / y

theorem min_greater_0
  fixes x :: real, y :: real
  prop x > 0 ⟶ y > 0 ⟶ min x y > 0

theorem both_geq_min
  fixes x :: real, y :: real, z :: real
  prop min x y ≥ z ⟶ x ≥ z ∧ y ≥ z

theorem max_less_0
  fixes x :: real, y :: real
  prop x < 0 ⟶ y < 0 ⟶ max x y < 0

theorem real_neg_divides_larger_1
  fixes x :: real, y :: real
  prop y ≥ 1 ⟶ x < 0 ⟶ x ≤ x / y

theorem both_leq_max
  fixes x :: real, y :: real, z :: real
  prop max x y ≤ z ⟶ x ≤ z ∧ y ≤ z

theorem real_neg_div_pos
  fixes x :: real, y :: real
  prop x < 0 ⟶ y > 0 ⟶ x / y < 0

theorem real_greater_min
  fixes x :: real, y :: real
  prop x ≥ min x y

theorem max_min
  fixes x :: real, y :: real
  prop max (-y) (-x) = -(min x y)

theorem real_less_max
  fixes x :: real, y :: real
  prop x ≤ max x y

theorem min_pos
  fixes x :: real, y :: real
  prop x > 0 ⟶ y > 0 ⟶ min x y > 0

theorem real_zero_minus
  fixes x :: real
  prop 0 - x = -x
