theorem real_abs_bounds
  fixes k :: real, x :: real
  prop abs x <= k <--> -k <= x & x <= k
  [hint_rewrite]
proof
  ← rewrite abs_def goal=0
    #[1] (if 0 ≤ x then x else -x) ≤ k ⟷ -k ≤ x ∧ x ≤ k
  ← cases "0 ≤ x" goal=1
    #[2] 0 ≤ x ⟶ (if 0 ≤ x then x else -x) ≤ k ⟷ -k ≤ x ∧ x ≤ k
    #[3] ¬(0 ≤ x) ⟶ (if 0 ≤ x then x else -x) ≤ k ⟷ -k ≤ x ∧ x ≤ k
  ← intro goal=2
    #[4] 0 ≤ x
    #[5] (if 0 ≤ x then x else -x) ≤ k ⟷ -k ≤ x ∧ x ≤ k
  ← rewrite if_P sym=false goal=5 facts=[4]
    #[6] x ≤ k ⟷ -k ≤ x ∧ x ≤ k
  ← rule iffI goal=6
    #[7] x ≤ k ⟶ -k ≤ x ∧ x ≤ k
    #[8] -k ≤ x ∧ x ≤ k ⟶ x ≤ k
  ← intro goal=7
    #[9] x ≤ k
    #[10] -k ≤ x ∧ x ≤ k
  ← rule conjI goal=10
    #[11] -k ≤ x
  ← rule real_le_trans param_y="(0::real)" goal=11
    #[12] -k ≤ 0
  ← rewrite real_le_lneg sym=false goal=12
    #[13] 0 ≤ k + 0
  ← rewrite real_add_rid sym=false goal=13
    #[14] 0 ≤ k
  ← rule real_le_trans goal=14 facts=[4,9]
  ← intro goal=8
    #[15] -k ≤ x ∧ x ≤ k
    #[16] x ≤ k
  ← rule conjD2 goal=16 facts=[15]
    #[17] x ≤ k
  ← intro goal=3
    #[18] ¬(0 ≤ x)
    #[19] (if 0 ≤ x then x else -x) ≤ k ⟷ -k ≤ x ∧ x ≤ k
  ← rewrite if_not_P sym=false goal=19 facts=[18]
    #[20] -x ≤ k ⟷ -k ≤ x ∧ x ≤ k
  ← rule iffI goal=20
    #[21] -x ≤ k ⟶ -k ≤ x ∧ x ≤ k
    #[22] -k ≤ x ∧ x ≤ k ⟶ -x ≤ k
  ← intro goal=21
    #[23] -x ≤ k
    #[24] -k ≤ x ∧ x ≤ k
  ← rule conjI goal=24
    #[25] -k ≤ x
    #[26] x ≤ k
  ← rewrite real_le_lneg sym=false goal=25
    #[27] 0 ≤ k + x
  → rewrite target=fact real_le_lneg sym=false goal=27 facts=[23]
    #[28] 0 ≤ x + k
  ← rewrite real_add_comm sym=false goal=27
  ← rule real_le_trans param_y=-x goal=26
    #[29] x ≤ -x
  ← z3 goal=29 facts=[18]
    #[30] x ≤ -x
  ← intro goal=22
    #[31] -x ≤ k
  ← rewrite real_le_lneg sym=false goal=31
    #[32] 0 ≤ x + k
  → rewrite target=fact real_le_lneg sym=false goal=32 facts=[15]
    #[33] 0 ≤ k + x ∧ x ≤ k
  ← rewrite real_add_comm sym=false goal=32
    #[34] 0 ≤ k + x
  ← rule conjD1 goal=34 facts=[33]
    #[35] 0 ≤ k + x
qed

theorem real_abs_lt
  fixes k :: real, x :: real
  prop abs x < k <--> -k < x & x < k
  [hint_rewrite]
proof
  ← z3 goal=0
