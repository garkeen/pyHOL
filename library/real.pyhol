theory real
imports rat
domains real
description "real numbers"

type real

const of_nat :: nat ⇒ real

const of_int :: int ⇒ real

def zero :: real = (0::real) = of_nat 0 [hint_rewrite,hint_rewrite_sym]

def one :: real = (1::real) = of_nat 1 [hint_rewrite,hint_rewrite_sym]

const plus :: real ⇒ real ⇒ real

def minus :: real ⇒ real ⇒ real = x - y = x + -y [hint_rewrite]

const times :: real ⇒ real ⇒ real

const real_inverse :: real ⇒ real

def real_divide :: real ⇒ real ⇒ real = x / y = x * real_inverse y [hint_rewrite]

fun power :: real ⇒ nat ⇒ real
  | x ^ (0::nat) = 1
  | x ^ Suc m = x * x ^ m

const less_eq :: real ⇒ real ⇒ bool

def less :: real ⇒ real ⇒ bool = x < y ⟷ ¬(y ≤ x) [hint_rewrite]

theorem real_add_assoc
  fixes x :: real, y :: real, z :: real
  prop x + (y + z) = x + y + z
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: z3
  qed

theorem real_add_comm
  fixes x :: real, y :: real
  prop x + y = y + x
  [hint_rewrite,hint_resolve]
  proof
    0: z3
  qed

theorem real_add_lid
  fixes x :: real
  prop 0 + x = x
  [hint_rewrite]
  proof
    0: z3
  qed

theorem real_add_rid
  fixes x :: real
  prop x + 0 = x
  [hint_rewrite]
  proof
    0: rewrite_goal real_add_comm sym=false
    0: rewrite_goal real_add_lid sym=false
  qed

theorem real_add_linv
  fixes x :: real
  prop -x + x = 0
  [hint_rewrite]
  proof
    0: z3
  qed

theorem real_mult_assoc
  fixes x :: real, y :: real, z :: real
  prop x * (y * z) = x * y * z
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: z3
  qed

theorem real_mult_comm
  fixes x :: real, y :: real
  prop x * y = y * x
  [hint_rewrite,hint_resolve,hint_backward]

theorem real_mul_lid
  fixes x :: real
  prop 1 * x = x
  [hint_rewrite]

theorem real_add_ldistrib
  fixes x :: real, y :: real, z :: real
  prop x * (y + z) = x * y + x * z
  [hint_rewrite]

theorem real_le_refl
  fixes x :: real
  prop x ≤ x
  [hint_resolve,hint_backward]
  proof
    0: z3
  qed

theorem real_le_antisym
  fixes x :: real, y :: real
  prop x ≤ y ∧ y ≤ x ⟷ x = y
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: z3
  qed

theorem real_le_trans
  fixes x :: real, y :: real, z :: real
  prop x ≤ y ⟶ y ≤ z ⟶ x ≤ z
  [hint_backward,hint_forward,hint_backward1]

theorem real_le_total
  fixes x :: real, y :: real
  prop x ≤ y ∨ y ≤ x
  [hint_resolve,hint_backward]
  proof
    0: z3
  qed

theorem real_le_ladd_imp
  fixes x :: real, y :: real, z :: real
  prop y ≤ z ⟶ x + y ≤ x + z
  [hint_backward,hint_forward]

theorem real_le_mul
  fixes x :: real, y :: real
  prop 0 ≤ x ⟶ 0 ≤ y ⟶ 0 ≤ x * y
  [hint_forward,hint_backward,hint_backward1]

theorem real_ge_add
  fixes x :: real, y :: real
  prop x ≥ 0 ⟶ y ≥ 0 ⟶ x + y ≥ 0

theorem real_ge_mul
  fixes x :: real, y :: real
  prop x ≥ 0 ⟶ y ≥ 0 ⟶ x * y ≥ 0

theorem real_ge_divide
  fixes x :: real, y :: real
  prop x ≥ 0 ⟶ y > 0 ⟶ x / y ≥ 0

theorem real_gt_add
  fixes x :: real, y :: real
  prop x > 0 ⟶ y > 0 ⟶ x + y > 0

theorem real_gt_mul
  fixes x :: real, y :: real
  prop x > 0 ⟶ y > 0 ⟶ x * y > 0

theorem real_lt_neq
  fixes x :: real, y :: real
  prop x < y ⟶ ¬(x = y)

theorem real_gt_neq
  fixes x :: real, y :: real
  prop x > y ⟶ ¬(x = y)

theorem real_gt_to_neq
  fixes x :: real
  prop x > 0 ⟶ ¬(x = 0)

theorem real_lt_le
  fixes x :: real, y :: real
  prop x < y ⟷ x ≤ y ∧ ¬(x = y)
  [hint_rewrite]

theorem real_inv_0
  prop real_inverse 0 = 0
  [hint_rewrite]

theorem real_mul_linv
  fixes x :: real
  prop ¬(x = 0) ⟶ real_inverse x * x = 1
  [hint_backward,hint_forward]

theorem real_of_nat_eq
  fixes m :: nat, n :: nat
  prop (of_nat::nat ⇒ real) m = of_nat n ⟷ m = n
  [hint_rewrite]

theorem real_of_nat_id
  fixes n :: nat
  prop (of_nat::nat ⇒ real) (of_nat n) = of_nat n
  [hint_rewrite]
  proof
    0: rewrite_goal real_of_nat_eq sym=false
    0: rewrite_goal nat_of_nat_def sym=""
  qed

theorem real_of_nat_le
  fixes m :: nat, n :: nat
  prop (of_nat::nat ⇒ real) m ≤ of_nat n ⟷ m ≤ n
  [hint_rewrite]

theorem real_of_nat_lt
  fixes m :: nat, n :: nat
  prop (of_nat::nat ⇒ real) m < of_nat n ⟷ m < n
  [hint_rewrite]

theorem real_of_nat_add
  fixes m :: nat, n :: nat
  prop (of_nat::nat ⇒ real) m + of_nat n = of_nat (m + n)
  [hint_rewrite,hint_rewrite_sym]

theorem real_of_nat_minus
  fixes m :: nat, n :: nat
  prop of_nat (m - n) = (if m ≥ n then of_nat m - of_nat n else (0::real))
  [hint_rewrite]

theorem real_of_nat_mul
  fixes m :: nat, n :: nat
  prop (of_nat::nat ⇒ real) m * of_nat n = of_nat (m * n)
  [hint_rewrite]

theorem real_add_ac3
  fixes x :: real, y :: real, z :: real
  prop x + (y + z) = y + (x + z)
  [hint_rewrite]
  proof
    0: rewrite_goal real_add_assoc
    0: rewrite_goal real_add_comm
    0: apply_forward_step real_add_comm param_x=x param_y=y
    1: rewrite_goal_with_prev @0
  qed

theorem real_add_rinv
  fixes x :: real
  prop x + -x = 0
  [hint_rewrite]
  proof
    0: rewrite_goal real_add_comm
    0: rewrite_goal real_add_linv
  qed

theorem real_eq_add_lcancel
  fixes x :: real, y :: real, z :: real
  prop x + y = x + z ⟷ y = z
  [hint_rewrite,hint_resolve,hint_rewrite_sym]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: cut "-x + (x + y) = -x + (x + z)"
    0.1: rewrite_goal_with_prev @0.0
    0.2: rewrite_fact real_add_assoc @0.1
    0.3: rewrite_fact real_add_linv @0.2
    0.4: rewrite_fact real_add_lid @0.3
    1: introduction
    1.1: rewrite_goal_with_prev @1.0
  qed

theorem real_eq_add_rcancel
  fixes x :: real, y :: real, z :: real
  prop x + z = y + z ⟷ x = y
  [hint_rewrite]
  proof
    0: rewrite_goal real_add_comm
    0: rewrite_goal real_eq_add_lcancel
  qed

theorem real_mul_rzero
  fixes x :: real
  prop x * 0 = 0
  [hint_rewrite]
  proof
    0: cut "x * (0 + 1) = 0 + x * 1"
    0: rewrite_goal real_add_lid
    1: rewrite_fact real_add_ldistrib @0
    2: rewrite_fact real_eq_add_rcancel @1
  qed

theorem real_mul_lzero
  fixes x :: real
  prop 0 * x = 0
  [hint_rewrite]
  proof
    0: rewrite_goal real_mult_comm
    0: rewrite_goal real_mul_rzero
  qed

theorem real_neg_neg
  fixes x :: real
  prop --x = x
  [hint_rewrite]
  proof
    0: cut "--x + -x = x + -x"
    0: rewrite_goal real_add_linv
    0: rewrite_goal real_add_rinv
    2: rewrite_fact real_eq_add_rcancel @1
  qed

theorem real_mul_rneg
  fixes x :: real, y :: real
  prop x * -y = -(x * y)
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: cut "x * (-y + y) = -(x * y) + (x * y)"
    0: rewrite_goal real_add_linv
    0: rewrite_goal real_mul_rzero
    2: rewrite_fact real_add_ldistrib @1
    3: rewrite_fact real_eq_add_rcancel @2
  qed

theorem real_mul_lneg
  fixes x :: real, y :: real
  prop -x * y = -(x * y)
  [hint_rewrite,hint_rewrite_sym]
  proof
    0: rewrite_goal real_mult_comm
    0: rewrite_goal real_mul_rneg
  qed

theorem real_lt_add2
  fixes w :: real, x :: real, y :: real, z :: real
  prop w < x ⟶ y < z ⟶ w + y < x + z
  [hint_backward,hint_backward1]
  proof
    2: z3 @1,0
  qed

theorem real_le_add2
  fixes w :: real, x :: real, y :: real, z :: real
  prop w ≤ x ⟶ y ≤ z ⟶ w + y ≤ x + z
  [hint_backward,hint_backward1]
  proof
    2: z3 @0,1
  qed

theorem real_neg_add
  fixes x :: real, y :: real
  prop -(x + y) = -x + -y
  [hint_rewrite]
  proof
    0: cut "-(x+y) + (x +y) = -x + -y + (x + y)"
    0: rewrite_goal real_add_linv
    0: rewrite_goal real_add_ac3 sym=false
    0: rewrite_goal real_add_assoc sym=true
    0: rewrite_goal real_add_linv sym=false
    0: rewrite_goal real_add_rid sym=false
    0: rewrite_goal real_add_rinv sym=false
    6: rewrite_fact real_eq_add_rcancel @5 sym=false
  qed

theorem real_neg_0
  prop -(0::real) = 0
  [hint_rewrite]
  proof
    0: cut "-(0::real) + 0 = 0 + 0"
    0: rewrite_goal real_add_linv
    0: rewrite_goal real_add_rid
    2: rewrite_fact real_eq_add_rcancel @1
  qed

theorem real_le_lneg
  fixes x :: real, y :: real
  prop -x ≤ y ⟷ 0 ≤ x + y
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_forward_step real_le_ladd_imp @0.0 param_x=x
    0.2: rewrite_fact real_add_rinv @0.1
    0.3: rewrite_fact real_zero_def @0.2
    1: introduction
    1.1: apply_forward_step real_le_ladd_imp @1.0 param_x=-x
    1.2: rewrite_fact real_add_assoc @1.1
    1.3: rewrite_fact real_add_linv @1.2
    1.4: rewrite_fact real_add_lid @1.3
    1.5: rewrite_fact real_add_rid @1.4
  qed

theorem real_le_lneg2
  fixes x :: real, y :: real
  prop -x ≤ -y ⟷ y ≤ x
  [hint_rewrite]
  proof
    0: cut "-x <= -y <--> --y <= x"
    0: rewrite_goal real_le_lneg
    0: apply_backward_step iffI
    0: introduction
    0.1: rewrite_goal real_add_comm
    1: introduction
    1.1: rewrite_goal real_add_comm
    4: rewrite_goal_with_prev @3
    4: rewrite_goal real_neg_neg
  qed

theorem real_le_rneg
  fixes x :: real, y :: real
  prop x ≤ -y ⟷ x + y ≤ 0
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: apply_forward_step real_le_ladd_imp @0.0 param_x=y
    0.2: rewrite_fact real_add_rinv @0.1
    0.3: rewrite_goal real_add_comm
    1: introduction
    1.1: apply_forward_step real_le_ladd_imp @1.0 param_x=-y
    1.2: rewrite_fact real_add_ac3 @1.1
    1.3: rewrite_fact real_add_linv @1.2
    1.4: rewrite_fact real_add_rid @1.3
  qed

theorem real_entire
  fixes x :: real, y :: real
  prop x * y = 0 ⟷ x = 0 ∨ y = 0
  [hint_rewrite]
  proof
    0: apply_backward_step iffI
    0: cases "x = 0"
    0: introduction
    0.2: apply_backward_step disjI1
    1: introduction
    1.2: apply_backward_step disjI2
    1.2: cut "real_inverse x * x * y = y"
    1.2: apply_forward_step real_mul_linv @1.0
    1.3: rewrite_goal_with_prev @1.2
    1.3: rewrite_goal real_mul_lid sym=false
    1.5: rewrite_fact real_mult_assoc @1.4 sym=true
    1.6: rewrite_fact_with_prev @1.1,1.5
    1.7: rewrite_fact real_mul_rzero @1.6 sym=false
    1.8: rewrite_goal eq_sym_eq sym=false
    3: introduction
    3.1: apply_backward_step disjE @3.0
    3.1: introduction
    3.1.1: rewrite_goal_with_prev @3.1.0
    3.1.1: rewrite_goal real_mul_lzero sym=false
    3.2: introduction
    3.2.1: rewrite_goal_with_prev @3.2.0
    3.2.1: rewrite_goal real_mul_rzero sym=false
  qed

theorem real_le_negtotal
  fixes x :: real
  prop 0 ≤ x ∨ 0 ≤ -x
  [hint_backward]
  proof
    0: rewrite_goal real_le_rneg sym=false
    0: rewrite_goal real_add_lid sym=false
    0: apply_backward_step real_le_total
  qed

theorem real_le_square
  fixes x :: real
  prop 0 ≤ x * x
  [hint_backward]
  proof
    0: apply_forward_step real_le_negtotal param_x=x
    1: apply_backward_step disjE @0
    1: introduction
    1.1: apply_backward_step real_le_mul
    2: introduction
    2.1: apply_forward_step real_le_mul @2.0 param_y=-x
    2.2: apply_fact @2.1,2.0
    2.3: rewrite_fact real_mul_rneg @2.2 sym=false
    2.4: rewrite_fact real_mul_lneg @2.3 sym=false
    2.5: rewrite_fact real_neg_neg @2.4 sym=false
  qed

theorem real_mul_rid
  fixes x :: real
  prop x * 1 = x
  [hint_rewrite]
  proof
    0: rewrite_goal real_mult_comm sym=false
    0: rewrite_goal real_mul_lid sym=false
  qed

theorem real_pow_2
  fixes x :: real
  prop x ^ (2::nat) = x * x
  [hint_rewrite]
  proof
    0: cut "(2::nat) = Suc 1"
    0: nat_norm
    1: rewrite_goal_with_prev @0
    1: rewrite_goal real_nat_power_def_2 sym=false
    1: rewrite_goal nat_one_def sym=false
    1: rewrite_goal real_nat_power_def_2 sym=false
    1: rewrite_goal real_nat_power_def_1 sym=false
    1: rewrite_goal real_mult_comm sym=false
    1: rewrite_goal real_mult_assoc sym=true
    1: rewrite_goal real_mul_lid sym=false
  qed

theorem real_pow_3
  fixes x :: real
  prop x ^ (3::nat) = x * x * x

theorem real_pos
  fixes n :: nat
  prop (0::real) ≤ of_nat n
  [hint_backward]
  proof
    0: rewrite_goal real_zero_def sym=false
    0: rewrite_goal real_of_nat_le sym=false
    0: apply_backward_step le_0
  qed

theorem real_of_nat_pow
  fixes n :: nat, x :: nat
  prop (of_nat::nat ⇒ real) x ^ n = of_nat (x ^ n)
  [hint_rewrite]
  proof
    0: induction n nat_induct
    0: rewrite_goal nat_nat_power_def_1
    0: rewrite_goal real_nat_power_def_1
    0: rewrite_goal real_one_def
    3: introduction n
    3.2: rewrite_goal nat_nat_power_def_2
    3.2: rewrite_goal real_nat_power_def_2
    3.2: rewrite_goal_with_prev @3.1
    3.2: rewrite_goal real_of_nat_mul
  qed

theorem real_pow_neg
  fixes n :: nat, x :: real
  prop -x ^ n = (if even n then x ^ n else -(x ^ n))
  [hint_rewrite]
  proof
    0: induction n nat_induct
    0: rewrite_goal real_nat_power_def_1
    0: rewrite_goal even_def_1
    0: rewrite_goal if_true sym=false
    3: introduction n
    3.2: rewrite_goal even_def_2
    3.2: rewrite_goal real_nat_power_def_2
    3.2: rewrite_goal_with_prev @3.1
    3.2: cases "even n"
    3.2: introduction
    3.2.1: rewrite_goal if_P @3.2.0 sym=false
    3.2.1: rewrite_fact double_neg @3.2.0 sym=true
    3.2.2: rewrite_goal if_not_P @3.2.1 sym=false
    3.2.2: rewrite_goal real_mul_lneg sym=false
    3.3: introduction
    3.3.1: rewrite_goal if_not_P @3.3.0 sym=false
    3.3.1: rewrite_goal if_P @3.3.0 sym=false
    3.3.1: rewrite_goal real_mul_rneg sym=false
    3.3.1: rewrite_goal real_mul_lneg sym=false
    3.3.1: rewrite_goal real_neg_neg sym=false
  qed

theorem real_abs_nat
  fixes n :: nat
  prop (abs::real ⇒ real) (of_nat n) = of_nat n
  [hint_rewrite]
