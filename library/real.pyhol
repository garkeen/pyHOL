theorem real_eqI_from_lt_gt
  fixes x :: real, y :: real
  prop (x < y ⟶ false) ⟶ (y < x ⟶ false) ⟶ x = y
  [hint_backward]

theorem real_lt_mul
  fixes x :: real, y :: real
  prop 0 < x ⟶ 0 < y ⟶ 0 < x * y
