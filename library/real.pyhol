theorem real_min_eq_left
  fixes x :: real, y :: real
  prop x <= y --> min x y = x
proof
  ← intro goal=0
    #[1] x ≤ y
    #[2] min x y = x
  ← rewrite min_def sym=false goal=2
    #[3] (if x ≤ y then x else y) = x
  ← rewrite if_P sym=false goal=3 facts=[1]
qed

theorem real_min_eq_right
