theorem real_pow_le
  fixes n :: nat, x :: real
  prop 0 <= x --> 0 <= x ^ n
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ x ^ n
  ← induct n nat_induct goal=2
    #[3] 0 ≤ x ^ (0::nat)
    #[4] ∀n. 0 ≤ x ^ n ⟶ 0 ≤ x ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=3
    #[5] (0::real) ≤ 1
  ← z3 goal=5
    #[6] (0::real) ≤ 1
  ← intro n goal=4
    #[7] _VAR n
    #[8] 0 ≤ x ^ n
    #[9] 0 ≤ x ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=9
    #[10] 0 ≤ x * x ^ n
  ← rule real_le_mul goal=10
qed

theorem real_pow_lt
  fixes n :: nat, x :: real
  prop 0 < x --> 0 < x ^ n
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < x ^ n
  ← induct n nat_induct goal=2
    #[3] 0 < x ^ (0::nat)
    #[4] ∀n. 0 < x ^ n ⟶ 0 < x ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=3
    #[5] (0::real) < 1
  ← z3 goal=5
    #[6] (0::real) < 1
  ← intro n goal=4
    #[7] _VAR n
    #[8] 0 < x ^ n
    #[9] 0 < x ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=9
    #[10] 0 < x * x ^ n
  ← rule real_lt_mul goal=10
qed

theorem real_abs_pow
  fixes n :: nat, x :: real
  prop abs (x ^ n) = abs x ^ n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct n nat_induct goal=0
    #[1] abs (x ^ (0::nat)) = abs x ^ (0::nat)
    #[2] ∀n. abs (x ^ n) = abs x ^ n ⟶ abs (x ^ Suc n) = abs x ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] abs (1::real) = 1
  ← rewrite real_one_def sym=false goal=3
    #[4] (abs::real ⇒ real) of_nat 1 = of_nat 1
  ← rewrite real_abs_nat sym=false goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] abs (x ^ n) = abs x ^ n
    #[7] abs (x ^ Suc n) = abs x ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=7
    #[8] abs (x * x ^ n) = abs x * abs x ^ n
  ← rewrite real_abs_mul sym=false goal=8
    #[9] abs x * abs (x ^ n) = abs x * abs x ^ n
  ← rewrite source=prev goal=9 facts=[6]
qed

theorem real_le_lmul
  fixes x :: real, y :: real, z :: real
  prop 0 <= x --> y <= z --> x * y <= x * z
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] y ≤ z
    #[3] x * y ≤ x * z
  ← z3 goal=3 facts=[1,2]
qed

theorem real_lt_lmul:
  fixes x :: real, y :: real, z :: real
  prop 0 < x --> y < z --> x * y < x * z
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] y < z
    #[3] x * y < x * z
  ← z3 goal=3 facts=[2,1]
qed

theorem real_inverse_divide
  fixes x :: real
  prop real_inverse x = 1 / x
  [hint_rewrite]
proof
  ← rewrite real_divide_def sym=false goal=0
    #[1] real_inverse x = 1 * real_inverse x
  ← rewrite real_mul_lid sym=false goal=1
qed

theorem real_mul_linv_uniq
  fixes x :: real, y :: real
  prop x * y = 1 --> real_inverse y = x
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] x * y = 1
    #[2] real_inverse y = x
  ← z3 goal=2 facts=[1]
qed

theorem real_inv_inv
  fixes x :: real
  prop real_inverse (real_inverse x) = x
  [hint_rewrite]
proof
  ← cases "x=0" goal=0
    #[1] x = 0 ⟶ real_inverse (real_inverse x) = x
    #[2] ¬(x = 0) ⟶ real_inverse (real_inverse x) = x
  ← intro goal=1
    #[3] x = 0
    #[4] real_inverse (real_inverse x) = x
  ← rewrite source=prev goal=4 facts=[3]
    #[5] real_inverse (real_inverse 0) = 0
  ← rewrite real_inv_0 sym=false goal=5
    #[6] real_inverse 0 = 0
  ← rewrite real_inv_0 sym=false goal=6
    #[7] real_inverse 0 = 0
  ← intro goal=2
    #[8] ¬(x = 0)
    #[9] real_inverse (real_inverse x) = x
  ← rule real_mul_linv_uniq goal=9
    #[10] x * real_inverse x = 1
  ← rewrite real_mult_comm sym=false goal=10
    #[11] real_inverse x * x = 1
  ← rule real_mul_linv goal=11
qed

theorem real_eq_inv2
  fixes x :: real, y :: real
  prop real_inverse x = real_inverse y <--> x = y
  [hint_rewrite]

theorem real_inv_eq_0
  fixes x :: real
  prop real_inverse x = 0 <--> x = 0
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] real_inverse x = 0 ⟶ x = 0
    #[2] x = 0 ⟶ real_inverse x = 0
  ← intro goal=1
    #[3] real_inverse x = 0
    #[4] x = 0
  ← rewrite real_inv_inv sym=true goal=4
    #[5] real_inverse (real_inverse x) = real_inverse (real_inverse 0)
  ← rewrite source=prev goal=5 facts=[3]
    #[6] real_inverse 0 = real_inverse (real_inverse 0)
  ← rewrite real_inv_0 sym=false goal=6
    #[7] 0 = real_inverse 0
  ← rewrite real_inv_0 sym=false goal=7
    #[8] 0 = real_inverse 0
  ← intro goal=2
    #[9] x = 0
    #[10] real_inverse x = 0
  ← rewrite source=prev goal=10 facts=[9]
    #[11] real_inverse 0 = 0
  ← rewrite real_inv_0 sym=false goal=11
    #[12] real_inverse 0 = 0
qed

theorem real_lt_inv
  fixes x :: real
  prop 0 < x --> 0 < real_inverse x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < real_inverse x
  ← z3 goal=2 facts=[1]
qed

theorem real_lt_inv_eq
  fixes x :: real
  prop 0 < real_inverse x <--> 0 < x
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] 0 < real_inverse x ⟶ 0 < x
    #[2] 0 < x ⟶ 0 < real_inverse x
  ← intro goal=1
    #[3] 0 < real_inverse x
    #[4] 0 < x
  ← rewrite real_inv_inv sym=true goal=4
    #[5] real_inverse (real_inverse 0) < real_inverse (real_inverse x)
  ← rewrite real_inv_0 sym=false goal=5
    #[6] real_inverse 0 < real_inverse (real_inverse x)
  ← rewrite real_inv_0 sym=false goal=6
    #[7] 0 < real_inverse (real_inverse x)
  ← rule real_lt_inv goal=7 facts=[3]
  ← intro goal=2
    #[8] 0 < x
    #[9] 0 < real_inverse x
  ← rule real_lt_inv goal=9 facts=[8]
qed

theorem real_lt_div
  fixes x :: real, y :: real
  prop 0 < x --> 0 < y --> 0 < x / y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < y
    #[3] 0 < x / y
  ← rewrite real_divide_def sym=false goal=3
    #[4] 0 < x * real_inverse y
  ← rule real_lt_mul goal=4
    #[5] 0 < real_inverse y
  ← rewrite real_lt_inv_eq sym=false goal=5
qed

theorem real_inv_neg
  fixes x :: real
  prop real_inverse (-x) = -(real_inverse x)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← cases "x = 0" goal=0
    #[1] x = 0 ⟶ real_inverse (-x) = -(real_inverse x)
    #[2] ¬(x = 0) ⟶ real_inverse (-x) = -(real_inverse x)
  ← intro goal=1
    #[3] x = 0
    #[4] real_inverse (-x) = -(real_inverse x)
  ← rewrite source=prev goal=4 facts=[3]
    #[5] real_inverse (-0) = -(real_inverse 0)
  ← rewrite real_neg_0 sym=false goal=5
    #[6] real_inverse 0 = -(real_inverse 0)
  ← rewrite real_inv_0 sym=false goal=6
    #[7] (0::real) = -0
  ← rewrite real_neg_0 sym=false goal=7
    #[8] (0::real) = -0
  ← z3 goal=2
qed

theorem real_inv_1
  prop real_inverse 1 = 1
  [hint_rewrite]
proof
  ← z3 goal=0
qed

theorem real_inv_eq_1
  fixes x :: real
  prop real_inverse x = 1 <--> x = 1
  [hint_rewrite]
proof
  → forward real_inv_inv param_x=x goal=0
    #[1] real_inverse (real_inverse x) = x
  ← rule iffI goal=0
    #[2] real_inverse x = 1 ⟶ x = 1
    #[3] x = 1 ⟶ real_inverse x = 1
  ← intro goal=2
    #[4] real_inverse x = 1
    #[5] x = 1
  → rewrite target=fact eq_sym_eq sym=false goal=5 facts=[1]
    #[6] x = real_inverse (real_inverse x)
  ← rewrite source=prev goal=5 facts=[6]
    #[7] real_inverse (real_inverse x) = 1
  ← rewrite source=prev goal=7 facts=[4]
    #[8] real_inverse 1 = 1
  ← rewrite real_inv_1 sym=false goal=8
    #[9] real_inverse 1 = 1
  ← intro goal=3
    #[10] x = 1
    #[11] real_inverse x = 1
  ← rewrite source=prev goal=11 facts=[10]
    #[12] real_inverse 1 = 1
  ← rewrite real_inv_1 sym=false goal=12
qed

theorem real_div_1
  fixes x :: real
  prop x / 1 = x
  [hint_rewrite]
proof
  real_norm goal=0
qed

theorem real_div_refl
  fixes x :: real
  prop ~(x = 0) --> x / x = 1
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(x = 0)
    #[2] x / x = 1
  ← rewrite real_divide_def sym=false goal=2
    #[3] x * real_inverse x = 1
  ← rewrite real_mult_comm sym=false goal=3
    #[4] real_inverse x * x = 1
  ← rule real_mul_linv goal=4 facts=[1]
qed

theorem real_div_rmul
  fixes x :: real, y :: real
  prop ~(y = 0) --> x / y * y = x
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(y = 0)
    #[2] x / y * y = x
  ← rewrite real_divide_def sym=false goal=2
    #[3] x * real_inverse y * y = x
  ← rewrite real_mult_assoc sym=true goal=3
    #[4] x * (real_inverse y * y) = x
  → forward real_mul_linv goal=4 facts=[1]
    #[5] real_inverse y * y = 1
  ← rewrite source=prev goal=4 facts=[5]
    #[6] x * 1 = x
  ← rewrite real_mul_rid sym=false goal=6
    #[7] x * 1 = x
qed

theorem real_div_lmul
  fixes x :: real, y :: real
  prop ~(y = 0) --> y * (x / y) = x
  [hint_backward]
proof
  ← intro goal=0
    #[1] ¬(y = 0)
    #[2] y * (x / y) = x
  ← rewrite real_mult_comm sym=false goal=2
    #[3] x / y * y = x
  ← rule real_div_rmul goal=3
qed

theorem real_abs_inv
  fixes x :: real
  prop abs (real_inverse x) = real_inverse (abs x)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← cases "x = 0" goal=0
    #[1] x = 0 ⟶ abs (real_inverse x) = real_inverse (abs x)
    #[2] ¬(x = 0) ⟶ abs (real_inverse x) = real_inverse (abs x)
  ← intro goal=1
    #[3] x = 0
    #[4] abs (real_inverse x) = real_inverse (abs x)
  ← rewrite source=prev goal=4 facts=[3]
    #[5] abs (real_inverse 0) = real_inverse (abs 0)
  ← rewrite real_abs_0 sym=false goal=5
    #[6] abs (real_inverse 0) = real_inverse 0
  ← rewrite real_inv_0 sym=false goal=6
    #[7] abs (0::real) = 0
  ← rewrite real_abs_0 sym=false goal=7
    #[8] abs (0::real) = 0
  ← z3 goal=2
qed

theorem real_abs_div
  fixes x :: real, y :: real
  prop abs (x / y) = abs x / abs y
  [hint_rewrite]
proof
  ← rewrite real_divide_def sym=false goal=0
    #[1] abs (x * real_inverse y) = abs x * real_inverse (abs y)
  ← rewrite real_abs_mul sym=false goal=1
    #[2] abs x * abs (real_inverse y) = abs x * real_inverse (abs y)
  ← rewrite real_abs_inv sym=false goal=2
qed

theorem real_inv_mul
  fixes x :: real, y :: real
  prop real_inverse (x * y) = real_inverse x * real_inverse y
  [hint_rewrite]
proof
  ← cases "x=0" goal=0
    #[1] x = 0 ⟶ real_inverse (x * y) = real_inverse x * real_inverse y
    #[2] ¬(x = 0) ⟶ real_inverse (x * y) = real_inverse x * real_inverse y
  ← intro goal=1
    #[3] x = 0
    #[4] real_inverse (x * y) = real_inverse x * real_inverse y
  ← rewrite source=prev goal=4 facts=[3]
    #[5] real_inverse (0 * y) = real_inverse 0 * real_inverse y
  ← rewrite real_mul_lzero sym=false goal=5
    #[6] real_inverse 0 = real_inverse 0 * real_inverse y
  ← rewrite real_inv_0 sym=false goal=6
    #[7] 0 = 0 * real_inverse y
  ← rewrite real_mul_lzero sym=false goal=7
    #[8] 0 = 0 * real_inverse y
  ← intro goal=2
    #[9] ¬(x = 0)
    #[10] real_inverse (x * y) = real_inverse x * real_inverse y
  ← cases "y=0" goal=10
    #[11] y = 0 ⟶ real_inverse (x * y) = real_inverse x * real_inverse y
    #[12] ¬(y = 0) ⟶ real_inverse (x * y) = real_inverse x * real_inverse y
  ← intro goal=11
    #[13] y = 0
    #[14] real_inverse (x * y) = real_inverse x * real_inverse y
  ← rewrite source=prev goal=14 facts=[13]
    #[15] real_inverse (x * 0) = real_inverse x * real_inverse 0
  ← rewrite real_mul_rzero sym=false goal=15
    #[16] real_inverse 0 = real_inverse x * real_inverse 0
  ← rewrite real_inv_0 sym=false goal=16
    #[17] 0 = real_inverse x * 0
  ← rewrite real_mul_rzero sym=false goal=17
    #[18] 0 = real_inverse x * 0
  ← intro goal=12
    #[19] ¬(y = 0)
    #[20] real_inverse (x * y) = real_inverse x * real_inverse y
  ← z3 goal=20 facts=[19,9]
qed

theorem real_pow_mul
  fixes n :: nat, x :: real, y :: real
  prop (x * y) ^ n = x ^ n * y ^ n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] (x * y) ^ (0::nat) = x ^ (0::nat) * y ^ (0::nat)
    #[2] ∀n. (x * y) ^ n = x ^ n * y ^ n ⟶ (x * y) ^ Suc n = x ^ Suc n * y ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] (1::real) = 1 * 1
  ← rewrite real_mul_lid sym=false goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] (x * y) ^ n = x ^ n * y ^ n
    #[6] (x * y) ^ Suc n = x ^ Suc n * y ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=6
    #[7] x * y * (x * y) ^ n = x * x ^ n * (y * y ^ n)
  ← rewrite source=prev goal=7 facts=[5]
    #[8] x * y * (x ^ n * y ^ n) = x * x ^ n * (y * y ^ n)
  cut "!a::real. !b. !c. !d. a*b*(c*d)=a*c*(b*d)" goal=8
    #[9] ∀a::real. ∀b. ∀c. ∀d. a * b * (c * d) = a * c * (b * d)
  ← z3 goal=9
    #[10] ∀a::real. ∀b. ∀c. ∀d. a * b * (c * d) = a * c * (b * d)
  ← apply_prev goal=8 facts=[10]
    #[11] ∀b. ∀c. ∀d. x * b * (c * d) = x * c * (b * d)
    #[12] ∀c. ∀d. x * y * (c * d) = x * c * (y * d)
    #[13] ∀d. x * y * (x ^ n * d) = x * x ^ n * (y * d)
    #[14] x * y * (x ^ n * y ^ n) = x * x ^ n * (y * y ^ n)
qed

theorem real_pow_inv
  fixes n :: nat, x :: real
  prop real_inverse x ^ n = real_inverse (x ^ n)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct n nat_induct goal=0
    #[1] real_inverse x ^ (0::nat) = real_inverse (x ^ (0::nat))
    #[2] ∀n. real_inverse x ^ n = real_inverse (x ^ n) ⟶ real_inverse x ^ Suc n = real_inverse (x ^ Suc n)
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] 1 = real_inverse 1
  ← z3 goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] real_inverse x ^ n = real_inverse (x ^ n)
    #[6] real_inverse x ^ Suc n = real_inverse (x ^ Suc n)
  ← rewrite real_nat_power_def_2 sym=false goal=6
    #[7] real_inverse x * real_inverse x ^ n = real_inverse (x * x ^ n)
  ← rewrite source=prev goal=7 facts=[5]
    #[8] real_inverse x * real_inverse (x ^ n) = real_inverse (x * x ^ n)
  ← rewrite real_inv_mul sym=false goal=8
    #[9] real_inverse x * real_inverse (x ^ n) = real_inverse (x * x ^ n)
qed

theorem real_pow_div
  fixes n :: nat, x :: real, y :: real
  prop (x / y) ^ n = x ^ n / y ^ n
  [hint_rewrite]
proof
  ← rewrite real_divide_def sym=false goal=0
    #[1] (x * real_inverse y) ^ n = x ^ n * real_inverse (y ^ n)
  ← rewrite real_pow_mul sym=false goal=1
    #[2] x ^ n * real_inverse y ^ n = x ^ n * real_inverse (y ^ n)
  ← rewrite real_pow_inv sym=false goal=2
qed

theorem real_div_eq_0
  fixes x :: real, y :: real
  prop x / y = 0 <--> x = 0 | y = 0
  [hint_rewrite]
proof
  ← rewrite real_divide_def sym=false goal=0
    #[1] x * real_inverse y = 0 ⟷ x = 0 ∨ y = 0
  ← rewrite real_entire sym=false goal=1
    #[2] x = 0 ∨ real_inverse y = 0 ⟷ x = 0 ∨ y = 0
  ← rewrite real_inv_eq_0 sym=false goal=2
qed

theorem real_pow_add
  fixes m :: nat, n :: nat, x :: real
  prop x ^ (m + n) = x ^ m * x ^ n
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] x ^ (m + 0) = x ^ m * x ^ (0::nat)
    #[2] ∀n. x ^ (m + n) = x ^ m * x ^ n ⟶ x ^ (m + Suc n) = x ^ m * x ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] x ^ (m + 0) = x ^ m * 1
  ← rewrite add_0_right sym=false goal=3
    #[4] x ^ m = x ^ m * 1
  ← rewrite real_mult_comm sym=false goal=4
    #[5] x ^ m = 1 * x ^ m
  ← rewrite real_mul_lid sym=false goal=5
  ← intro n goal=2
    #[6] _VAR n
    #[7] x ^ (m + n) = x ^ m * x ^ n
    #[8] x ^ (m + Suc n) = x ^ m * x ^ Suc n
  ← rewrite add_Suc_right sym=false goal=8
    #[9] x ^ Suc (m + n) = x ^ m * x ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=9
    #[10] x * x ^ (m + n) = x ^ m * (x * x ^ n)
  ← rewrite source=prev goal=10 facts=[7]
    #[11] x * (x ^ m * x ^ n) = x ^ m * (x * x ^ n)
  cut "!a::real. !b. !c. a*(b*c)=b*(a*c)" goal=11
    #[12] ∀a::real. ∀b. ∀c. a * (b * c) = b * (a * c)
  ← z3 goal=12
    #[13] ∀a::real. ∀b. ∀c. a * (b * c) = b * (a * c)
  ← apply_prev goal=11 facts=[13]
    #[14] ∀b. ∀c. x * (b * c) = b * (x * c)
    #[15] ∀c. x * (x ^ m * c) = x ^ m * (x * c)
    #[16] x * (x ^ m * x ^ n) = x ^ m * (x * x ^ n)
qed

theorem real_pow_nz
  fixes n :: nat, x :: real
  prop ~(x = 0) --> ~(x ^ n = 0)
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(x = 0)
    #[2] ¬(x ^ n = 0)
  ← induct n nat_induct goal=2
    #[3] ¬(x ^ (0::nat) = 0)
    #[4] ∀n. ¬(x ^ n = 0) ⟶ ¬(x ^ Suc n = 0)
  ← rewrite real_nat_power_def_1 sym=false goal=3
    #[5] ¬((1::real) = 0)
  ← z3 goal=5
    #[6] ¬((1::real) = 0)
  ← intro n goal=4
    #[7] _VAR n
    #[8] ¬(x ^ n = 0)
    #[9] ¬(x ^ Suc n = 0)
  ← rewrite real_nat_power_def_2 sym=false goal=9
    #[10] ¬(x * x ^ n = 0)
  ← rewrite real_entire sym=false goal=10
    #[11] ¬(x = 0 ∨ x ^ n = 0)
  ← rewrite de_morgan_thm2 sym=false goal=11
    #[12] ¬(x = 0) ∧ ¬(x ^ n = 0)
  ← rule conjI goal=12 facts=[1,8]
qed

theorem real_pow_sub
  fixes m :: nat, n :: nat, x :: real
  prop ~(x = 0) --> m <= n --> x ^ (n - m) = x ^ n / x ^ m
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(x = 0)
    #[2] m ≤ n
    #[3] x ^ (n - m) = x ^ n / x ^ m
  → rewrite target=fact less_eq_exist sym=false goal=3 facts=[2]
    #[4] ∃p. n = m + p
  elim p goal=3 facts=[4]
    #[5] _VAR p
    #[6] n = m + p
    #[7] x ^ (n - m) = x ^ n / x ^ m
  ← rewrite source=prev goal=7 facts=[6]
    #[8] x ^ (m + p - m) = x ^ (m + p) / x ^ m
  ← rewrite nat_plus_minus_2 sym=false goal=8
    #[9] x ^ p = x ^ (m + p) / x ^ m
  ← rewrite real_pow_add sym=false goal=9
    #[10] x ^ p = x ^ m * x ^ p / x ^ m
  ← rewrite real_divide_def sym=false goal=10
    #[11] x ^ p = x ^ m * x ^ p * real_inverse (x ^ m)
  ← rewrite real_mult_comm sym=false goal=11
    #[12] x ^ p = real_inverse (x ^ m) * (x ^ m * x ^ p)
  ← rewrite real_mult_assoc sym=false goal=12
    #[13] x ^ p = real_inverse (x ^ m) * x ^ m * x ^ p
  → forward real_pow_nz param_n=m goal=13 facts=[1]
    #[14] ¬(x ^ m = 0)
  → forward real_mul_linv goal=13 facts=[14]
    #[15] real_inverse (x ^ m) * x ^ m = 1
  ← rewrite source=prev goal=13 facts=[15]
    #[16] x ^ p = 1 * x ^ p
  ← rewrite real_mul_lid sym=false goal=16
    #[17] x ^ p = 1 * x ^ p
qed

theorem real_le_rcancel_imp
  fixes x :: real, y :: real, z :: real
  prop 0 < z --> x * z <= y * z --> x <= y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < z
    #[2] x * z ≤ y * z
    #[3] x ≤ y
  ← z3 goal=3 facts=[1,2]
qed

theorem real_eq_lcancel
  fixes x :: real, y :: real, z :: real
  prop ~(x = 0) --> x * y = x * z --> y = z
proof
  ← intro goal=0
    #[1] ¬(x = 0)
    #[2] x * y = x * z
    #[3] y = z
  ← z3 goal=3 facts=[2,1]
qed

theorem real_le_ldiv_eq
  fixes x :: real, y :: real, z :: real
  prop 0 < z --> x / z <= y <--> x <= y * z
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < z
    #[2] x / z ≤ y ⟷ x ≤ y * z
  ← z3 goal=2 facts=[1]
qed

theorem real_lt_ldiv_eq
  fixes x :: real, y :: real, z :: real
  prop 0 < z --> x / z < y <--> x < y * z
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < z
    #[2] x / z < y ⟷ x < y * z
  ← z3 goal=2 facts=[1]
qed

theorem real_le_rdiv_eq
  fixes x :: real, y :: real, z :: real
  prop 0 < z --> x <= y / z <--> x * z <= y
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < z
    #[2] x ≤ y / z ⟷ x * z ≤ y
  ← z3 goal=2 facts=[1]
qed

theorem real_lt_rdiv_eq
  fixes x :: real, y :: real, z :: real
  prop 0 < z --> x < y / z <--> x * z < y
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < z
    #[2] x < y / z ⟷ x * z < y
  ← z3 goal=2 facts=[1]
qed

theorem real_eq_rdiv_eq
  fixes x :: real, y :: real, z :: real
  prop 0 < z --> x = y / z <--> x * z = y
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < z
    #[2] x = y / z ⟷ x * z = y
  ← z3 goal=2 facts=[1]
qed

theorem real_mul_2
  fixes x :: real
  prop 2 * x = x + x
  [hint_rewrite]
proof
  ← z3 goal=0
qed

theorem real_pow_eq_0
  fixes n :: nat, x :: real
  prop x ^ n = 0 <--> x = 0 & ~(n = 0)
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] x ^ (0::nat) = 0 ⟷ x = 0 ∧ ¬((0::nat) = 0)
    #[2] ∀n. x ^ n = 0 ⟷ x = 0 ∧ ¬(n = 0) ⟶ x ^ Suc n = 0 ⟷ x = 0 ∧ ¬(Suc n = 0)
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] (1::real) = 0 ⟷ x = 0 ∧ ¬((0::nat) = 0)
  ← z3 goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] x ^ n = 0 ⟷ x = 0 ∧ ¬(n = 0)
    #[6] x ^ Suc n = 0 ⟷ x = 0 ∧ ¬(Suc n = 0)
  ← rewrite real_nat_power_def_2 sym=false goal=6
    #[7] x * x ^ n = 0 ⟷ x = 0 ∧ ¬(Suc n = 0)
  ← rule iffI goal=7
    #[8] x * x ^ n = 0 ⟶ x = 0 ∧ ¬(Suc n = 0)
    #[9] x = 0 ∧ ¬(Suc n = 0) ⟶ x * x ^ n = 0
  ← intro goal=8
    #[10] x * x ^ n = 0
    #[11] x = 0 ∧ ¬(Suc n = 0)
  ← rule conjI goal=11
    #[12] x = 0
    #[13] ¬(Suc n = 0)
  ← rule ineq_sym goal=13
    #[14] ¬(0 = Suc n)
  ← rule nat_zero_Suc_neq goal=14
    #[15] ¬(0 = Suc n)
  → rewrite target=fact real_entire sym=false goal=12 facts=[10]
    #[16] x = 0 ∨ x ^ n = 0
  ← rule disjE goal=12 facts=[16]
    #[17] x = 0 ⟶ x = 0
    #[18] x ^ n = 0 ⟶ x = 0
  ← intro goal=18
    #[19] x ^ n = 0
    #[20] x = 0
  → rewrite target=fact source=prev goal=20 facts=[5,19]
    #[21] x = 0 ∧ ¬(n = 0)
  ← rule conjD1 goal=20 facts=[21]
    #[22] x = 0
  ← intro goal=9
    #[23] x = 0 ∧ ¬(Suc n = 0)
    #[24] x * x ^ n = 0
  ← rewrite real_entire sym=false goal=24
    #[25] x = 0 ∨ x ^ n = 0
  ← rule disjI1 goal=25
    #[26] x = 0
  ← rule conjD1 goal=26 facts=[23]
    #[27] x = 0
qed

theorem real_le_mul2
  fixes w :: real, x :: real, y :: real, z :: real
  prop 0 <= w --> w <= x --> 0 <= y --> y <= z --> w * y <= x * z
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ w
    #[2] w ≤ x
    #[3] 0 ≤ y
    #[4] y ≤ z
    #[5] w * y ≤ x * z
  ← rule real_le_trans param_y="w * z" goal=5
    #[6] w * y ≤ w * z
    #[7] w * z ≤ x * z
  ← rule real_le_lmul goal=6
  ← rewrite real_mult_comm sym=false goal=7
    #[8] z * w ≤ z * x
  ← rule real_le_lmul goal=8
    #[9] 0 ≤ z
  ← rule real_le_trans param_y=y goal=9
qed

theorem real_lt_mul2
  fixes w :: real, x :: real, y :: real, z :: real
  prop 0 <= w --> w < x --> 0 <= y --> y < z --> w * y < x * z
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ w
    #[2] w < x
    #[3] 0 ≤ y
    #[4] y < z
    #[5] w * y < x * z
  ← rule real_let_trans param_y=w*z goal=5
    #[6] w * y ≤ w * z
    #[7] w * z < x * z
  ← rule real_le_lmul goal=6
    #[8] y ≤ z
  ← rule real_lt_imp_le goal=8
  ← rewrite real_mult_comm sym=false goal=7
    #[9] z * w < z * x
  ← rule real_lt_lmul: goal=9
    #[10] 0 < z
  ← rule real_let_trans param_y=y goal=10
qed

theorem real_lt_square
  fixes x :: real
  prop 0 < x * x <--> ~(x = 0)
  [hint_rewrite]
proof
  ← z3 goal=0
qed

theorem real_divide_1
  fixes x :: real
  prop x = x / 1

theorem real_divide_eq
  fixes a :: real, b :: real, c :: real, d :: real
  prop ~(b = 0) --> ~(d = 0) --> a * d = b * c --> a / b = c / d

theorem real_divide_add
  fixes a :: real, b :: real, c :: real, d :: real
  prop ~(b = 0) --> ~(d = 0) --> a / b + c / d = (a * d + b * c) / (b * d)

theorem real_divide_add_same
  fixes a :: real, b :: real, c :: real
  prop ~(c = 0) --> a / c + b / c = (a + b) / c

theorem real_divide_mult
  fixes a :: real, b :: real, c :: real, d :: real
  prop ~(b = 0) --> ~(d = 0) --> a / b * (c / d) = a * c / (b * d)

theorem real_pow_1
  fixes x :: real
  prop x ^ (1::nat) = x
  [hint_rewrite]
proof
  ← rewrite nat_one_def sym=false goal=0
    #[1] x ^ Suc 0 = x
  ← rewrite real_nat_power_def_2 sym=false goal=1
    #[2] x * x ^ (0::nat) = x
  ← rewrite real_nat_power_def_1 sym=false goal=2
    #[3] x * 1 = x
  ← rewrite real_mult_comm sym=false goal=3
    #[4] 1 * x = x
  ← rewrite real_mul_lid sym=false goal=4
qed

theorem real_pow_one
  fixes n :: nat
  prop (1::real) ^ n = 1
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] (1::real) ^ (0::nat) = 1
    #[2] ∀n. (1::real) ^ n = 1 ⟶ (1::real) ^ Suc n = 1
  ← rewrite real_nat_power_def_1 sym=false goal=1
  ← intro n goal=2
    #[3] _VAR n
    #[4] (1::real) ^ n = 1
    #[5] (1::real) ^ Suc n = 1
  ← rewrite real_nat_power_def_2 sym=false goal=5
    #[6] (1::real) * 1 ^ n = 1
  ← rewrite real_mul_lid sym=false goal=6
qed

theorem real_lt_inv2
  fixes x :: real, y :: real
  prop 0 < x --> x < y --> real_inverse y < real_inverse x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x < y
    #[3] real_inverse y < real_inverse x
  ← z3 goal=3 facts=[2,1]
qed

theorem real_le_inv2
  fixes x :: real, y :: real
  prop 0 < x --> x <= y --> real_inverse y <= real_inverse x
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x ≤ y
    #[3] real_inverse y ≤ real_inverse x
  ← z3 goal=3 facts=[1,2]
qed

theorem real_inv_le_1
  fixes x :: real
  prop 1 <= x --> real_inverse x <= 1
  [hint_backward]
proof
  ← intro goal=0
    #[1] 1 ≤ x
    #[2] real_inverse x ≤ 1
  ← rewrite real_inv_1 sym=true goal=2
    #[3] real_inverse x ≤ real_inverse 1
  ← rule real_le_inv2 goal=3
    #[4] (0::real) < 1
  ← z3 goal=4
    #[5] (0::real) < 1
qed

theorem real_inv_1_le
  fixes x :: real
  prop 0 < x --> x <= 1 --> 1 <= real_inverse x
  [hint_backward1,hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] x ≤ 1
    #[3] 1 ≤ real_inverse x
  ← z3 goal=3 facts=[1,2]
qed

theorem real_down
  fixes d :: real
  prop 0 < d --> (?e. 0 < e & e < d)
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < d
    #[2] ∃e. 0 < e ∧ e < d
  ← z3 goal=2 facts=[1]
qed

theorem real_down2
  fixes d1 :: real, d2 :: real
  prop 0 < d1 --> 0 < d2 --> (?e. 0 < e & e < d1 & e < d2)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < d1
    #[2] 0 < d2
    #[3] ∃e. 0 < e ∧ e < d1 ∧ e < d2
  → forward real_down goal=3 facts=[1]
    #[4] ∃e. 0 < e ∧ e < d1
  → forward real_down goal=4 facts=[2]
    #[5] ∃e. 0 < e ∧ e < d2
  ← z3 goal=3 facts=[5,4]
qed

theorem real_pow_le2
  fixes n :: nat, x :: real, y :: real
  prop 0 <= x --> x <= y --> x ^ n <= y ^ n
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ y
    #[3] x ^ n ≤ y ^ n
  ← induct n nat_induct goal=3
    #[4] x ^ (0::nat) ≤ y ^ (0::nat)
    #[5] ∀n. x ^ n ≤ y ^ n ⟶ x ^ Suc n ≤ y ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=4
    #[6] (1::real) ≤ 1
  ← rule real_le_refl goal=6
    #[7] (1::real) ≤ 1
  ← intro n goal=5
    #[8] _VAR n
    #[9] x ^ n ≤ y ^ n
    #[10] x ^ Suc n ≤ y ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=10
    #[11] x * x ^ n ≤ y * y ^ n
  ← rule real_le_mul2 goal=11
    #[12] 0 ≤ x ^ n
  ← rule real_pow_le goal=12
qed

theorem real_pow_le_1
  fixes n :: nat, x :: real
  prop 1 <= x --> 1 <= x ^ n
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 1 ≤ x
    #[2] 1 ≤ x ^ n
  → forward real_pow_le2 param_n=n param_x="(1::real)" param_y=x goal=2
    #[3] (0::real) ≤ 1 ⟶ 1 ≤ x ⟶ 1 ^ n ≤ x ^ n
  → rewrite target=fact real_pow_one sym=false goal=2 facts=[3]
    #[4] (0::real) ≤ 1 ⟶ 1 ≤ x ⟶ 1 ≤ x ^ n
  ← apply_prev goal=2 facts=[4]
    #[5] (0::real) ≤ 1
  ← z3 goal=5
    #[6] (0::real) ≤ 1
qed

theorem real_pow_1_le
  fixes n :: nat, x :: real
  prop 0 <= x --> x <= 1 --> x ^ n <= 1
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ 1
    #[3] x ^ n ≤ 1
  → forward real_pow_le2 param_n=n goal=3 facts=[1,2]
    #[4] x ^ n ≤ 1 ^ n
  → rewrite target=fact real_pow_one sym=false goal=3 facts=[4]
  → forward real_pow_le2 param_n=n param_x=x param_y="(1::real)" goal=2
    #[5] 0 ≤ x ⟶ x ≤ 1 ⟶ x ^ n ≤ 1 ^ n
qed

theorem real_pow_mono
  fixes m :: nat, n :: nat, x :: real
  prop 1 <= x --> m <= n --> x ^ m <= x ^ n
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 1 ≤ x
    #[2] m ≤ n
    #[3] x ^ m ≤ x ^ n
  → rewrite target=fact less_eq_exist sym=false goal=3 facts=[2]
    #[4] ∃p. n = m + p
  elim p goal=3 facts=[4]
    #[5] _VAR p
    #[6] n = m + p
    #[7] x ^ m ≤ x ^ n
  ← rewrite source=prev goal=7 facts=[6]
    #[8] x ^ m ≤ x ^ (m + p)
  ← rewrite real_pow_add sym=false goal=8
    #[9] x ^ m ≤ x ^ m * x ^ p
  cut "x ^ m * 1 ≤ x ^ m * x ^ p" goal=9
    #[10] x ^ m * 1 ≤ x ^ m * x ^ p
  ← rule real_le_lmul goal=10
    #[11] 0 ≤ x ^ m
    #[12] 1 ≤ x ^ p
  ← rule real_pow_le goal=11
    #[13] 0 ≤ x
  ← rule real_le_trans param_y="(1::real)" goal=13
    #[14] (0::real) ≤ 1
  ← z3 goal=14
    #[15] (0::real) ≤ 1
  ← rule real_pow_le_1 goal=12
  → rewrite target=fact real_mult_comm sym=false goal=9 facts=[10]
    #[16] 1 * x ^ m ≤ x ^ p * x ^ m
  → rewrite target=fact real_mul_lid sym=false goal=9 facts=[16]
    #[17] x ^ m ≤ x ^ p * x ^ m
  ← rewrite real_mult_comm sym=false goal=9
qed

theorem real_pow_lt2
  fixes n :: nat, x :: real, y :: real
  prop 0 <= x --> x < y --> ~(n = 0) --> x ^ n < y ^ n
  [hint_backward,hint_backward1,hint_forward]

theorem real_pow_lt_1
  fixes n :: nat, x :: real
  prop ~(n = 0) --> 1 < x --> 1 < x ^ n
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 1 < x
    #[3] 1 < x ^ n
  → forward real_pow_lt2 param_n=n param_x="(1::real)" param_y=x goal=3
    #[4] (0::real) ≤ 1 ⟶ 1 < x ⟶ ¬(n = 0) ⟶ 1 ^ n < x ^ n
  → rewrite target=fact real_pow_one sym=false goal=3 facts=[4]
    #[5] (0::real) ≤ 1 ⟶ 1 < x ⟶ ¬(n = 0) ⟶ 1 < x ^ n
  ← apply_prev goal=3 facts=[5]
    #[6] (0::real) ≤ 1
  ← z3 goal=6
    #[7] (0::real) ≤ 1
  → rewrite target=fact real_pow_one sym=false goal=5 facts=[4]
qed

theorem real_pow_1_lt
  fixes n :: nat, x :: real
  prop ~(n = 0) --> 0 <= x --> x < 1 --> x ^ n < 1
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 ≤ x
    #[3] x < 1
    #[4] x ^ n < 1
  → forward real_pow_lt2 param_n=n param_x=x param_y="(1::real)" goal=4
    #[5] 0 ≤ x ⟶ x < 1 ⟶ ¬(n = 0) ⟶ x ^ n < 1 ^ n
  → rewrite target=fact real_pow_one sym=false goal=4 facts=[5]
    #[6] 0 ≤ x ⟶ x < 1 ⟶ ¬(n = 0) ⟶ x ^ n < 1
  ← apply_prev goal=4 facts=[6]
qed

theorem real_pow_mono_lt
  fixes m :: nat, n :: nat, x :: real
  prop 1 < x --> m < n --> x ^ m < x ^ n
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] m < n
    #[3] x ^ m < x ^ n
  → rewrite target=fact less_exist sym=false goal=3 facts=[2]
    #[4] ∃d. n = m + Suc d
  elim d goal=3 facts=[4]
    #[5] _VAR d
    #[6] n = m + Suc d
    #[7] x ^ m < x ^ n
  ← rewrite source=prev goal=7 facts=[6]
    #[8] x ^ m < x ^ (m + Suc d)
  ← rewrite real_pow_add sym=false goal=8
    #[9] x ^ m < x ^ m * x ^ Suc d
  cut "x ^ m * 1 < x ^ m * x ^ Suc d" goal=9
    #[10] x ^ m * 1 < x ^ m * x ^ Suc d
  ← rule real_lt_lmul: goal=10
    #[11] 0 < x ^ m
    #[12] 1 < x ^ Suc d
  ← rule real_pow_lt goal=11
    #[13] 0 < x
  ← rule real_lt_trans param_y="(1::real)" goal=13
    #[14] (0::real) < 1
  ← z3 goal=14
    #[15] (0::real) < 1
  ← rule real_pow_lt_1 goal=12
    #[16] ¬(Suc d = 0)
  ← rewrite eq_sym_eq sym=false goal=16
    #[17] ¬(0 = Suc d)
  ← rule nat_zero_Suc_neq goal=17
    #[18] ¬(0 = Suc d)
  → rewrite target=fact real_mult_comm sym=false goal=9 facts=[10]
    #[19] 1 * x ^ m < x ^ Suc d * x ^ m
  → rewrite target=fact real_mul_lid sym=false goal=9 facts=[19]
    #[20] x ^ m < x ^ Suc d * x ^ m
  ← rewrite real_mult_comm sym=false goal=9
qed

theorem real_pow_pow
  fixes m :: nat, n :: nat, x :: real
  prop x ^ m ^ n = x ^ (m * n)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct n nat_induct goal=0
    #[1] x ^ m ^ (0::nat) = x ^ (m * 0)
    #[2] ∀n. x ^ m ^ n = x ^ (m * n) ⟶ x ^ m ^ Suc n = x ^ (m * Suc n)
  ← rewrite mult_0_right sym=false goal=1
    #[3] x ^ m ^ (0::nat) = x ^ (0::nat)
  ← rewrite real_nat_power_def_1 sym=false goal=3
  ← intro n goal=2
    #[4] _VAR n
    #[5] x ^ m ^ n = x ^ (m * n)
    #[6] x ^ m ^ Suc n = x ^ (m * Suc n)
  ← rewrite mult_Suc_right sym=false goal=6
    #[7] x ^ m ^ Suc n = x ^ (m + m * n)
  ← rewrite real_pow_add sym=false goal=7
    #[8] x ^ m ^ Suc n = x ^ m * x ^ (m * n)
  ← rewrite real_nat_power_def_2 sym=false goal=8
    #[9] x ^ m * x ^ m ^ n = x ^ m * x ^ (m * n)
  ← rewrite source=prev goal=9 facts=[5]
qed

theorem real_div_pow2
  fixes m :: nat, n :: nat, x :: real
  prop ~(x = 0) --> x ^ m / x ^ n = (if n <= m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(x = 0)
    #[2] x ^ m / x ^ n = (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← cases "n ≤ m" goal=2
    #[3] n ≤ m ⟶ x ^ m / x ^ n = (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m)))
    #[4] ¬(n ≤ m) ⟶ x ^ m / x ^ n = (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← intro goal=3
    #[5] n ≤ m
    #[6] x ^ m / x ^ n = (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← rewrite if_P sym=false goal=6 facts=[5]
    #[7] x ^ m / x ^ n = x ^ (m - n)
  → forward real_pow_sub goal=7 facts=[1,5]
    #[8] x ^ (m - n) = x ^ m / x ^ n
  ← rewrite source=prev goal=7 facts=[8]
  ← intro goal=4
    #[9] ¬(n ≤ m)
    #[10] x ^ m / x ^ n = (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← rewrite if_not_P sym=false goal=10 facts=[9]
    #[11] x ^ m / x ^ n = real_inverse (x ^ (n - m))
  → rewrite target=fact not_le sym=false goal=11 facts=[9]
    #[12] m < n
  → forward lt_imp_le goal=11 facts=[12]
    #[13] m ≤ n
  → forward real_pow_sub goal=11 facts=[1,13]
    #[14] x ^ (n - m) = x ^ n / x ^ m
  ← rewrite source=prev goal=11 facts=[14]
    #[15] x ^ m / x ^ n = real_inverse (x ^ n / x ^ m)
  ← rewrite real_divide_def sym=false goal=15
    #[16] x ^ m * real_inverse (x ^ n) = real_inverse (x ^ n * real_inverse (x ^ m))
  ← rewrite real_inv_mul sym=false goal=16
    #[17] x ^ m * real_inverse (x ^ n) = real_inverse (x ^ n) * real_inverse (real_inverse (x ^ m))
  ← rewrite real_inv_inv sym=false goal=17
    #[18] x ^ m * real_inverse (x ^ n) = real_inverse (x ^ n) * x ^ m
  ← rule real_mult_comm goal=18
    #[19] x ^ m * real_inverse (x ^ n) = real_inverse (x ^ n) * x ^ m
qed

theorem real_div_pow2_lt
  fixes m :: nat, n :: nat, x :: real
  prop ~(x = 0) --> x ^ m / x ^ n = (if n < m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(x = 0)
    #[2] x ^ m / x ^ n = (if n < m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  → forward real_div_pow2 param_m=m param_n=n goal=2 facts=[1]
    #[3] x ^ m / x ^ n = (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← rewrite source=prev goal=2 facts=[3]
    #[4] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = (if n < m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← cases "n < m" goal=4
    #[5] n < m ⟶ (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = (if n < m then x ^ (m - n) else real_inverse (x ^ (n - m)))
    #[6] ¬(n < m) ⟶ (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = (if n < m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← intro goal=5
    #[7] n < m
    #[8] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = (if n < m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← rewrite if_P sym=false goal=8 facts=[7]
    #[9] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = x ^ (m - n)
  → forward lt_imp_le goal=9 facts=[7]
    #[10] n ≤ m
  ← rewrite if_P sym=false goal=9 facts=[10]
    #[11] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = x ^ (m - n)
  ← intro goal=6
    #[12] ¬(n < m)
    #[13] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = (if n < m then x ^ (m - n) else real_inverse (x ^ (n - m)))
  ← rewrite if_not_P sym=false goal=13 facts=[12]
    #[14] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = real_inverse (x ^ (n - m))
  → rewrite target=fact not_le sym=true goal=14 facts=[12]
    #[15] ¬¬(m ≤ n)
  → rewrite target=fact double_neg sym=false goal=14 facts=[15]
    #[16] m ≤ n
  ← cases "n ≤ m" goal=14
    #[17] n ≤ m ⟶ (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = real_inverse (x ^ (n - m))
    #[18] ¬(n ≤ m) ⟶ (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = real_inverse (x ^ (n - m))
  ← intro goal=17
    #[19] n ≤ m
    #[20] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = real_inverse (x ^ (n - m))
  ← rewrite if_P sym=false goal=20 facts=[19]
    #[21] x ^ (m - n) = real_inverse (x ^ (n - m))
  → rewrite target=fact sub_eq_0 sym=true goal=21 facts=[16]
    #[22] m - n = 0
  → rewrite target=fact sub_eq_0 sym=true goal=21 facts=[19]
    #[23] n - m = 0
  ← rewrite source=prev goal=21 facts=[22]
    #[24] x ^ (0::nat) = real_inverse (x ^ (n - m))
  ← rewrite source=prev goal=24 facts=[23]
    #[25] x ^ (0::nat) = real_inverse (x ^ (0::nat))
  ← rewrite real_nat_power_def_1 sym=false goal=25
    #[26] 1 = real_inverse 1
  ← z3 goal=26
    #[27] 1 = real_inverse 1
  ← intro goal=18
    #[28] ¬(n ≤ m)
    #[29] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = real_inverse (x ^ (n - m))
  ← rewrite if_not_P sym=false goal=29 facts=[28]
    #[30] (if n ≤ m then x ^ (m - n) else real_inverse (x ^ (n - m))) = real_inverse (x ^ (n - m))
qed

theorem real_lt_pow2
  fixes n :: nat
  prop (0::real) < 2 ^ n
  [hint_backward]
proof
  ← rule real_pow_lt goal=0
    #[1] (0::real) < 2
  ← z3 goal=1
qed

theorem real_le_pow2
  fixes n :: nat
  prop (1::real) <= 2 ^ n
  [hint_backward]
proof
  ← rule real_le_trans param_y="(2::real) ^ (0::nat)" goal=0
    #[1] (1::real) ≤ 2 ^ (0::nat)
    #[2] (2::real) ^ (0::nat) ≤ 2 ^ n
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] (1::real) ≤ 1
  ← rule real_le_refl goal=3
  ← rule real_pow_mono goal=2
    #[4] (1::real) ≤ 2
    #[5] 0 ≤ n
  ← z3 goal=4
  ← rule le_0 goal=5
qed

theorem real_pow2_abs
  fixes x :: real
  prop abs x ^ (2::nat) = x ^ (2::nat)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite abs_def sym=false goal=0
    #[1] (if 0 ≤ x then x else -x) ^ (2::nat) = x ^ (2::nat)
  ← cases "0 ≤ x" goal=1
    #[2] 0 ≤ x ⟶ (if 0 ≤ x then x else -x) ^ (2::nat) = x ^ (2::nat)
    #[3] ¬(0 ≤ x) ⟶ (if 0 ≤ x then x else -x) ^ (2::nat) = x ^ (2::nat)
  ← intro goal=2
    #[4] 0 ≤ x
    #[5] (if 0 ≤ x then x else -x) ^ (2::nat) = x ^ (2::nat)
  ← rewrite if_P sym=false goal=5 facts=[4]
  ← intro goal=3
    #[6] ¬(0 ≤ x)
    #[7] (if 0 ≤ x then x else -x) ^ (2::nat) = x ^ (2::nat)
  ← rewrite if_not_P sym=false goal=7 facts=[6]
    #[8] -x ^ (2::nat) = x ^ (2::nat)
  ← rewrite real_pow_neg sym=false goal=8
    #[9] (if even 2 then x ^ (2::nat) else -(x ^ (2::nat))) = x ^ (2::nat)
  cut "even 2" goal=9
    #[10] even 2
  ← rewrite mult_1_right sym=true goal=10
    #[11] even (2 * 1)
  ← rule even_double goal=11
    #[12] even (2 * 1)
  ← rewrite if_P sym=false goal=9 facts=[10]
qed

theorem real_le_square_abs
  fixes x :: real, y :: real
  prop abs x <= abs y <--> x ^ (2::nat) <= y ^ (2::nat)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_pow2_abs sym=true goal=0
    #[1] abs x ≤ abs y ⟷ abs x ^ (2::nat) ≤ abs y ^ (2::nat)
  ← rule iffI goal=1
    #[2] abs x ≤ abs y ⟶ abs x ^ (2::nat) ≤ abs y ^ (2::nat)
    #[3] abs x ^ (2::nat) ≤ abs y ^ (2::nat) ⟶ abs x ≤ abs y
  ← intro goal=2
    #[4] abs x ≤ abs y
    #[5] abs x ^ (2::nat) ≤ abs y ^ (2::nat)
  ← rule real_pow_le2 goal=5
    #[6] 0 ≤ abs x
  ← z3 goal=6
    #[7] 0 ≤ abs x
  ← intro goal=3
    #[8] abs x ^ (2::nat) ≤ abs y ^ (2::nat)
    #[9] abs x ≤ abs y
  ← rule contrapositive goal=9 facts=[8]
    #[10] ¬(abs x ≤ abs y) ⟶ ¬(abs x ^ (2::nat) ≤ abs y ^ (2::nat))
  ← intro goal=10
    #[11] ¬(abs x ≤ abs y)
    #[12] ¬(abs x ^ (2::nat) ≤ abs y ^ (2::nat))
  ← rewrite real_not_lt sym=true goal=12
    #[13] ¬¬(abs y ^ (2::nat) < abs x ^ (2::nat))
  → rewrite target=fact real_not_lt sym=true goal=13 facts=[11]
    #[14] ¬¬(abs y < abs x)
  → rewrite target=fact double_neg sym=false goal=13 facts=[14]
    #[15] abs y < abs x
  ← rewrite double_neg sym=false goal=13
    #[16] abs y ^ (2::nat) < abs x ^ (2::nat)
  ← rule real_pow_lt2 goal=16
    #[17] 0 ≤ abs y
    #[18] ¬((2::nat) = 0)
  ← z3 goal=17
    #[19] 0 ≤ abs y
  nat_const_ineq goal=18
    #[20] ¬((2::nat) = 0)
qed

theorem real_lt_square_abs
  fixes x :: real, y :: real
  prop abs x < abs y <--> x ^ (2::nat) < y ^ (2::nat)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_less_def sym=false goal=0
    #[1] ¬(abs y ≤ abs x) ⟷ ¬(y ^ (2::nat) ≤ x ^ (2::nat))
  ← rewrite real_le_square_abs sym=false goal=1
qed

theorem real_eq_square_abs
  fixes x :: real, y :: real
  prop abs x = abs y <--> x ^ (2::nat) = y ^ (2::nat)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_le_antisym sym=true goal=0
    #[1] abs x ≤ abs y ∧ abs y ≤ abs x ⟷ x ^ (2::nat) ≤ y ^ (2::nat) ∧ y ^ (2::nat) ≤ x ^ (2::nat)
  ← rewrite real_le_square_abs sym=false goal=1
qed

theorem real_le_pow_2
  fixes x :: real
  prop 0 <= x ^ (2::nat)
  [hint_backward]
proof
  ← rewrite real_pow_2 sym=false goal=0
    #[1] 0 ≤ x * x
  ← z3 goal=1
qed

theorem real_lt_pow_2
  fixes x :: real
  prop 0 < x ^ (2::nat) <--> ~(x = 0)
  [hint_rewrite]
proof
  ← rewrite real_lt_le sym=false goal=0
    #[1] 0 ≤ x ^ (2::nat) ∧ ¬(0 = x ^ (2::nat)) ⟷ ¬(x = 0)
  ← rule iffI goal=1
    #[2] 0 ≤ x ^ (2::nat) ∧ ¬(0 = x ^ (2::nat)) ⟶ ¬(x = 0)
    #[3] ¬(x = 0) ⟶ 0 ≤ x ^ (2::nat) ∧ ¬(0 = x ^ (2::nat))
  ← intro goal=2
    #[4] 0 ≤ x ^ (2::nat) ∧ ¬(0 = x ^ (2::nat))
    #[5] ¬(x = 0)
  → forward conjD2 goal=5 facts=[4]
    #[6] ¬(0 = x ^ (2::nat))
  → rewrite target=fact eq_sym_eq sym=false goal=5 facts=[6]
    #[7] ¬(x ^ (2::nat) = 0)
  → rewrite target=fact real_pow_eq_0 sym=false goal=5 facts=[7]
    #[8] ¬(x = 0 ∧ ¬((2::nat) = 0))
  → rewrite target=fact de_morgan_thm1 sym=false goal=5 facts=[8]
    #[9] ¬(x = 0) ∨ ¬¬((2::nat) = 0)
  ← rule disjE goal=5 facts=[9]
    #[10] ¬(x = 0) ⟶ ¬(x = 0)
    #[11] ¬¬((2::nat) = 0) ⟶ ¬(x = 0)
  ← intro goal=11
    #[12] ¬¬((2::nat) = 0)
    #[13] ¬(x = 0)
  → rewrite target=fact double_neg sym=false goal=13 facts=[12]
    #[14] (2::nat) = 0
  ← rule contrapositive goal=13 facts=[14]
    #[15] ¬¬(x = 0) ⟶ ¬((2::nat) = 0)
  ← intro goal=15
    #[16] ¬¬(x = 0)
    #[17] ¬((2::nat) = 0)
  nat_const_ineq goal=17
    #[18] ¬((2::nat) = 0)
  ← intro goal=3
    #[19] ¬(x = 0)
    #[20] 0 ≤ x ^ (2::nat) ∧ ¬(0 = x ^ (2::nat))
  ← rule conjI goal=20
    #[21] 0 ≤ x ^ (2::nat)
    #[22] ¬(0 = x ^ (2::nat))
  ← rule real_le_pow_2 goal=21
    #[23] 0 ≤ x ^ (2::nat)
  ← rewrite eq_sym_eq sym=false goal=22
    #[24] ¬(x ^ (2::nat) = 0)
  ← rule real_pow_nz goal=24 facts=[19]
qed

theorem real_sos_eq_0
  fixes x :: real, y :: real
  prop x ^ (2::nat) + y ^ (2::nat) = 0 <--> x = 0 & y = 0
  [hint_rewrite]
proof
  ← rewrite real_pow_2 sym=false goal=0
    #[1] x * x + y * y = 0 ⟷ x = 0 ∧ y = 0
  ← z3 goal=1
qed

theorem real_pow_zero
  fixes n :: nat
  prop (0::real) ^ n = (if n = 0 then 1 else 0)
  [hint_rewrite]
proof
  ← induct n nat_induct goal=0
    #[1] (0::real) ^ (0::nat) = (if (0::nat) = 0 then 1 else 0)
    #[2] ∀n. (0::real) ^ n = (if n = 0 then 1 else 0) ⟶ (0::real) ^ Suc n = (if Suc n = 0 then 1 else 0)
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] (1::real) = (if (0::nat) = 0 then 1 else 0)
  cut "(0::nat) = 0" goal=3
    #[4] (0::nat) = 0
  ← rule eq_refl goal=4
  ← rewrite if_P sym=false goal=3 facts=[4]
  ← intro n goal=2
    #[5] _VAR n
    #[6] (0::real) ^ n = (if n = 0 then 1 else 0)
    #[7] (0::real) ^ Suc n = (if Suc n = 0 then 1 else 0)
  ← rewrite real_nat_power_def_2 sym=false goal=7
    #[8] (0::real) * 0 ^ n = (if Suc n = 0 then 1 else 0)
  ← rewrite source=prev goal=8 facts=[6]
    #[9] (0::real) * (if n = 0 then 1 else 0) = (if Suc n = 0 then 1 else 0)
  ← rewrite real_mul_lzero sym=false goal=9
    #[10] (0::real) = (if Suc n = 0 then 1 else 0)
  cut "~(Suc n = 0)" goal=10
    #[11] ¬(Suc n = 0)
  ← rewrite eq_sym_eq sym=false goal=11
    #[12] ¬(0 = Suc n)
  ← rule nat_zero_Suc_neq goal=12
    #[13] ¬(0 = Suc n)
  ← rewrite if_not_P sym=false goal=10 facts=[11]
qed

theorem real_pow_mono_inv
  fixes m :: nat, n :: nat, x :: real
  prop 0 <= x --> x <= 1 --> n <= m --> x ^ m <= x ^ n
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] x ≤ 1
    #[3] n ≤ m
    #[4] x ^ m ≤ x ^ n
  ← cases "x = 0" goal=4
    #[5] x = 0 ⟶ x ^ m ≤ x ^ n
    #[6] ¬(x = 0) ⟶ x ^ m ≤ x ^ n
  ← intro goal=5
    #[7] x = 0
    #[8] x ^ m ≤ x ^ n
  ← rewrite source=prev goal=8 facts=[7]
    #[9] (0::real) ^ m ≤ 0 ^ n
  ← rewrite real_pow_zero sym=false goal=9
    #[10] (if m = 0 then (1::real) else 0) ≤ (if n = 0 then 1 else 0)
  ← cases "m = 0" goal=10
    #[11] m = 0 ⟶ (if m = 0 then (1::real) else 0) ≤ (if n = 0 then 1 else 0)
    #[12] ¬(m = 0) ⟶ (if m = 0 then (1::real) else 0) ≤ (if n = 0 then 1 else 0)
  ← intro goal=11
    #[13] m = 0
    #[14] (if m = 0 then (1::real) else 0) ≤ (if n = 0 then 1 else 0)
  ← rewrite if_P sym=false goal=14 facts=[13]
    #[15] (1::real) ≤ (if n = 0 then 1 else 0)
  → rewrite target=fact source=prev goal=15 facts=[13,3]
    #[16] n ≤ 0
  → forward nat_le_zero goal=15 facts=[16]
    #[17] n = 0
  ← rewrite if_P sym=false goal=15 facts=[17]
    #[18] (1::real) ≤ 1
  ← rule real_le_refl goal=18
    #[19] (1::real) ≤ 1
  ← intro goal=12
    #[20] ¬(m = 0)
    #[21] (if m = 0 then (1::real) else 0) ≤ (if n = 0 then 1 else 0)
  ← rewrite if_not_P sym=false goal=21 facts=[20]
    #[22] (0::real) ≤ (if n = 0 then 1 else 0)
  ← z3 goal=22
    #[23] (0::real) ≤ (if n = 0 then 1 else 0)
  ← intro goal=6
    #[24] ¬(x = 0)
    #[25] x ^ m ≤ x ^ n
  ← rewrite real_inv_inv sym=true goal=25
    #[26] real_inverse (real_inverse (x ^ m)) ≤ real_inverse (real_inverse (x ^ n))
  ← rule real_le_inv2 goal=26
    #[27] 0 < real_inverse (x ^ n)
    #[28] real_inverse (x ^ n) ≤ real_inverse (x ^ m)
  ← rewrite real_pow_inv sym=true goal=27
    #[29] 0 < real_inverse x ^ n
  ← rule real_pow_lt goal=29
    #[30] 0 < real_inverse x
  ← z3 goal=30 facts=[24,1]
    #[31] 0 < real_inverse x
  ← rewrite real_pow_inv sym=true goal=28
    #[32] real_inverse x ^ n ≤ real_inverse x ^ m
  ← rule real_pow_mono goal=32
    #[33] 1 ≤ real_inverse x
  ← rule real_inv_1_le goal=33
    #[34] 0 < x
  ← z3 goal=34 facts=[24,1]
    #[35] 0 < x
qed

theorem real_pow_le2_rev
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> 0 <= y --> x ^ n <= y ^ n --> x <= y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 ≤ y
    #[3] x ^ n ≤ y ^ n
    #[4] x ≤ y
  ← rule contrapositive goal=4 facts=[3]
    #[5] ¬(x ≤ y) ⟶ ¬(x ^ n ≤ y ^ n)
  ← intro goal=5
    #[6] ¬(x ≤ y)
    #[7] ¬(x ^ n ≤ y ^ n)
  ← rewrite real_not_lt sym=true goal=7
    #[8] ¬¬(y ^ n < x ^ n)
  ← rewrite double_neg sym=false goal=8
    #[9] y ^ n < x ^ n
  → rewrite target=fact real_not_lt sym=true goal=9 facts=[6]
    #[10] ¬¬(y < x)
  → rewrite target=fact double_neg sym=false goal=9 facts=[10]
    #[11] y < x
  ← rule real_pow_lt2 goal=9
qed

theorem real_pow_lt2_rev
  fixes n :: nat, x :: real, y :: real
  prop 0 <= y --> x ^ n < y ^ n --> x < y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ y
    #[2] x ^ n < y ^ n
    #[3] x < y
  ← rule contrapositive goal=3 facts=[2]
    #[4] ¬(x < y) ⟶ ¬(x ^ n < y ^ n)
  ← intro goal=4
    #[5] ¬(x < y)
    #[6] ¬(x ^ n < y ^ n)
  ← rewrite real_not_lt sym=false goal=6
    #[7] y ^ n ≤ x ^ n
  → rewrite target=fact real_not_lt sym=false goal=7 facts=[5]
    #[8] y ≤ x
  ← rule real_pow_le2 goal=7
qed

theorem real_pow_eq
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> 0 <= x --> 0 <= y --> x ^ n = y ^ n --> x = y
  [hint_forward,hint_backward1]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] 0 ≤ x
    #[3] 0 ≤ y
    #[4] x ^ n = y ^ n
    #[5] x = y
  ← rewrite real_le_antisym sym=true goal=5
    #[6] x ≤ y ∧ y ≤ x
  ← rule conjI goal=6
    #[7] x ≤ y
    #[8] y ≤ x
  → rewrite target=fact real_le_antisym sym=true goal=7 facts=[4]
    #[9] x ^ n ≤ y ^ n ∧ y ^ n ≤ x ^ n
  → forward conjD1 goal=7 facts=[9]
    #[10] x ^ n ≤ y ^ n
  → forward conjD2 goal=7 facts=[9]
    #[11] y ^ n ≤ x ^ n
  ← rule real_pow_le2_rev param_n=n goal=7
  ← rule real_pow_le2_rev param_n=n goal=8
qed

theorem real_pow_eq_abs
  fixes n :: nat, x :: real, y :: real
  prop ~(n = 0) --> x ^ n = y ^ n --> abs x = abs y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] x ^ n = y ^ n
    #[3] abs x = abs y
  ← rule real_pow_eq goal=3 facts=[1]
    #[4] 0 ≤ abs x
    #[5] 0 ≤ abs y
    #[6] abs x ^ n = abs y ^ n
  ← z3 goal=4
    #[7] 0 ≤ abs x
  ← z3 goal=5
    #[8] 0 ≤ abs y
  ← rewrite real_abs_pow sym=true goal=6
    #[9] abs (x ^ n) = abs (y ^ n)
  ← rewrite source=prev goal=9 facts=[2]
    #[10] abs (x ^ n) = abs (y ^ n)
qed

theorem real_pow_eq_1_imp
  fixes n :: nat, x :: real
  prop ~(n = 0) --> x ^ n = 1 --> abs x = 1
  [hint_backward1,hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] ¬(n = 0)
    #[2] x ^ n = 1
    #[3] abs x = 1
  ← rewrite real_one_def sym=false goal=3
    #[4] abs x = of_nat 1
  ← rewrite real_abs_nat sym=true goal=4
    #[5] abs x = abs of_nat 1
  ← rule real_pow_eq_abs goal=5 facts=[1]
    #[6] x ^ n = of_nat 1 ^ n
  ← rewrite real_one_def sym=true goal=6
    #[7] x ^ n = 1 ^ n
  ← rewrite real_pow_one sym=false goal=7
qed

theorem real_pow_eq_1
  fixes n :: nat, x :: real
  prop x ^ n = 1 <--> abs x = 1 & (x < 0 --> even n) | n = 0
  [hint_rewrite,hint_rewrite_sym]
proof
  ← cases "n = 0" goal=0
    #[1] n = 0 ⟶ x ^ n = 1 ⟷ abs x = 1 ∧ (x < 0 ⟶ even n) ∨ n = 0
    #[2] ¬(n = 0) ⟶ x ^ n = 1 ⟷ abs x = 1 ∧ (x < 0 ⟶ even n) ∨ n = 0
  ← intro goal=1
    #[3] n = 0
    #[4] x ^ n = 1 ⟷ abs x = 1 ∧ (x < 0 ⟶ even n) ∨ n = 0
  ← rewrite source=prev goal=4 facts=[3]
    #[5] x ^ (0::nat) = 1 ⟷ abs x = 1 ∧ (x < 0 ⟶ even 0) ∨ (0::nat) = 0
  ← rewrite real_nat_power_def_1 sym=false goal=5
    #[6] (1::real) = 1 ⟷ abs x = 1 ∧ (x < 0 ⟶ even 0) ∨ (0::nat) = 0
  ← rule iffI goal=6
    #[7] (1::real) = 1 ⟶ abs x = 1 ∧ (x < 0 ⟶ even 0) ∨ (0::nat) = 0
    #[8] abs x = 1 ∧ (x < 0 ⟶ even 0) ∨ (0::nat) = 0 ⟶ (1::real) = 1
  ← intro goal=7
    #[9] (1::real) = 1
    #[10] abs x = 1 ∧ (x < 0 ⟶ even 0) ∨ (0::nat) = 0
  ← rule disjI2 goal=10
    #[11] (0::nat) = 0
  ← rule eq_refl goal=11
    #[12] (0::nat) = 0
  ← intro goal=8
    #[13] abs x = 1 ∧ (x < 0 ⟶ even 0) ∨ (0::nat) = 0
    #[14] (1::real) = 1
  ← rule eq_refl goal=14
    #[15] (1::real) = 1
  ← intro goal=2
    #[16] ¬(n = 0)
    #[17] x ^ n = 1 ⟷ abs x = 1 ∧ (x < 0 ⟶ even n) ∨ n = 0
  cut "abs x = 1 --> x = 1 | x = -1" goal=17
    #[18] abs x = 1 ⟶ x = 1 ∨ x = -1
  ← z3 goal=18
    #[19] abs x = 1 ⟶ x = 1 ∨ x = -1
  ← rule iffI goal=17
    #[20] x ^ n = 1 ⟶ abs x = 1 ∧ (x < 0 ⟶ even n) ∨ n = 0
    #[21] abs x = 1 ∧ (x < 0 ⟶ even n) ∨ n = 0 ⟶ x ^ n = 1
  ← intro goal=20
    #[22] x ^ n = 1
    #[23] abs x = 1 ∧ (x < 0 ⟶ even n) ∨ n = 0
  ← rule disjI1 goal=23
    #[24] abs x = 1 ∧ (x < 0 ⟶ even n)
  ← rule conjI goal=24
    #[25] abs x = 1
    #[26] x < 0 ⟶ even n
  ← rule real_pow_eq_1_imp goal=25 facts=[16,22]
  ← intro goal=26
    #[27] x < 0
    #[28] even n
  → forward goal=28 facts=[19,25]
    #[29] x = 1 ∨ x = -1
  ← rule disjE goal=28 facts=[29]
    #[30] x = 1 ⟶ even n
    #[31] x = -1 ⟶ even n
  ← intro goal=30
    #[32] x = 1
    #[33] even n
  ← z3 goal=33 facts=[32,27]
    #[34] even n
  ← intro goal=31
    #[35] x = -1
    #[36] even n
  → rewrite target=fact source=prev goal=36 facts=[35,22]
    #[37] -(1::real) ^ n = 1
  → rewrite target=fact real_pow_neg sym=false goal=36 facts=[37]
    #[38] (if even n then (1::real) ^ n else -(1 ^ n)) = 1
  → rewrite target=fact real_pow_one sym=false goal=36 facts=[38]
    #[39] (if even n then (1::real) else -1) = 1
  ← rule contrapositive goal=36 facts=[39]
    #[40] ¬(even n) ⟶ ¬((if even n then (1::real) else -1) = 1)
  ← intro goal=40
    #[41] ¬(even n)
    #[42] ¬((if even n then (1::real) else -1) = 1)
  ← rewrite if_not_P sym=false goal=42 facts=[41]
    #[43] ¬(-(1::real) = 1)
  ← z3 goal=43
    #[44] ¬(-(1::real) = 1)
  ← intro goal=21
    #[45] abs x = 1 ∧ (x < 0 ⟶ even n) ∨ n = 0
    #[46] x ^ n = 1
  ← rule disjE goal=46 facts=[45]
    #[47] abs x = 1 ∧ (x < 0 ⟶ even n) ⟶ x ^ n = 1
    #[48] n = 0 ⟶ x ^ n = 1
  ← intro goal=47
    #[49] abs x = 1 ∧ (x < 0 ⟶ even n)
    #[50] x ^ n = 1
  → forward conjD1 goal=50 facts=[49]
    #[51] abs x = 1
  → forward goal=50 facts=[19,51]
    #[52] x = 1 ∨ x = -1
  ← rule disjE goal=50 facts=[52]
    #[53] x = 1 ⟶ x ^ n = 1
    #[54] x = -1 ⟶ x ^ n = 1
  ← intro goal=53
    #[55] x ^ n = 1
  ← rewrite source=prev goal=55 facts=[32]
    #[56] (1::real) ^ n = 1
  ← rewrite real_pow_one sym=false goal=56
    #[57] (1::real) ^ n = 1
  ← intro goal=54
    #[58] x ^ n = 1
  → forward conjD2 goal=58 facts=[49]
    #[59] x < 0 ⟶ even n
  cut "x < 0" goal=58
    #[60] x < 0
  ← z3 goal=60 facts=[35]
    #[61] x < 0
  → forward goal=58 facts=[59,61]
    #[62] even n
  ← rewrite source=prev goal=58 facts=[35]
    #[63] -(1::real) ^ n = 1
  ← rewrite real_pow_neg sym=false goal=63
    #[64] (if even n then (1::real) ^ n else -(1 ^ n)) = 1
  ← rewrite if_P sym=false goal=64 facts=[62]
    #[65] (1::real) ^ n = 1
  ← rewrite real_pow_one sym=false goal=65
  ← intro goal=48
    #[66] x ^ n = 1
  ← z3 goal=66 facts=[3,16]
    #[67] x ^ n = 1
qed

theorem real_pow_lt2_odd
  fixes n :: nat, x :: real, y :: real
  prop x < y --> odd n --> x ^ n < y ^ n
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] x < y
    #[2] odd n
    #[3] x ^ n < y ^ n
  ← cases "n =0" goal=3
    #[4] n = 0 ⟶ x ^ n < y ^ n
    #[5] ¬(n = 0) ⟶ x ^ n < y ^ n
  ← intro goal=4
    #[6] n = 0
    #[7] x ^ n < y ^ n
  → rewrite target=fact source=prev goal=7 facts=[6,2]
    #[8] odd 0
  → rewrite target=fact odd_def_1 sym=false goal=7 facts=[8]
    #[9] false
  ← resolve not_false_res goal=7 facts=[9]
    #[10] x ^ n < y ^ n
  ← intro goal=5
    #[11] ¬(n = 0)
    #[12] x ^ n < y ^ n
  cut "0 <= y | 0 <= -y" goal=12
    #[13] 0 ≤ y ∨ 0 ≤ -y
  ← z3 goal=13
    #[14] 0 ≤ y ∨ 0 ≤ -y
  cut "0 ≤ x ∨ 0 < -x" goal=12
    #[15] 0 ≤ x ∨ 0 < -x
  ← z3 goal=15
    #[16] 0 ≤ x ∨ 0 < -x
  cut "!x::real. !y. -x < -y <--> y < x" goal=12 facts=[14]
    #[17] ∀x::real. ∀y. -x < -y ⟷ y < x
  ← z3 goal=17
    #[18] ∀x::real. ∀y. -x < -y ⟷ y < x
  ← rule disjE goal=12 facts=[14]
    #[19] 0 ≤ y ⟶ x ^ n < y ^ n
    #[20] 0 ≤ -y ⟶ x ^ n < y ^ n
  ← rule disjE goal=19 facts=[16]
    #[21] 0 ≤ x ⟶ 0 ≤ y ⟶ x ^ n < y ^ n
    #[22] 0 < -x ⟶ 0 ≤ y ⟶ x ^ n < y ^ n
  ← intro goal=21
    #[23] 0 ≤ x
    #[24] 0 ≤ y
    #[25] x ^ n < y ^ n
  ← rule real_pow_lt2 goal=25 facts=[23,1,11]
    #[26] x ^ n < y ^ n
  ← intro goal=22
    #[27] 0 < -x
    #[28] x ^ n < y ^ n
  → forward real_pow_lt param_n=n goal=28 facts=[27]
    #[29] 0 < -x ^ n
  → rewrite target=fact real_pow_neg sym=false goal=28 facts=[29]
    #[30] 0 < (if even n then x ^ n else -(x ^ n))
  → rewrite target=fact not_odd sym=true goal=28 facts=[30]
    #[31] 0 < (if ¬(odd n) then x ^ n else -(x ^ n))
  → rewrite target=fact if_not_P2 sym=false goal=28 facts=[31,2]
    #[32] 0 < -(x ^ n)
  → rewrite target=fact real_neg_0 sym=true goal=28 facts=[32]
    #[33] -0 < -(x ^ n)
  → rewrite target=fact source=prev goal=28 facts=[18,33]
    #[34] x ^ n < 0
  ← rule real_lte_trans goal=28 facts=[34]
    #[35] 0 ≤ y ^ n
  ← rule real_pow_le goal=35
  ← rule disjE goal=20 facts=[16]
    #[36] 0 ≤ x ⟶ 0 ≤ -y ⟶ x ^ n < y ^ n
    #[37] 0 < -x ⟶ 0 ≤ -y ⟶ x ^ n < y ^ n
  ← intro goal=36
    #[38] 0 ≤ -y
    #[39] x ^ n < y ^ n
  ← z3 goal=39 facts=[38,23,1]
    #[40] x ^ n < y ^ n
  ← intro goal=37
    #[41] x ^ n < y ^ n
  → forward real_pow_lt2 param_n=n param_y=-x goal=41 facts=[38]
    #[42] -y < -x ⟶ ¬(n = 0) ⟶ -y ^ n < -x ^ n
  → rewrite target=fact real_pow_neg sym=false goal=41 facts=[42]
    #[43] -y < -x ⟶ ¬(n = 0) ⟶ (if even n then y ^ n else -(y ^ n)) < (if even n then x ^ n else -(x ^ n))
  → rewrite target=fact not_odd sym=true goal=41 facts=[43]
    #[44] -y < -x ⟶ ¬(n = 0) ⟶ (if ¬(odd n) then y ^ n else -(y ^ n)) < (if ¬(odd n) then x ^ n else -(x ^ n))
  → rewrite target=fact if_not_P2 sym=false goal=41 facts=[44,2]
    #[45] -y < -x ⟶ ¬(n = 0) ⟶ -(y ^ n) < -(x ^ n)
  → rewrite target=fact source=prev goal=41 facts=[18,45]
    #[46] x < y ⟶ ¬(n = 0) ⟶ x ^ n < y ^ n
  ← apply_prev goal=41 facts=[46]
qed

theorem real_pow_eq_odd_eq
  fixes n :: nat, x :: real, y :: real
  prop odd n --> x ^ n = y ^ n <--> x = y
  [hint_backward]

theorem real_pow_eq_eq
  fixes n :: nat, x :: real, y :: real
  prop x ^ n = y ^ n <--> (if even n then n = 0 | abs x = abs y else x = y)
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ x ^ n = y ^ n ⟷ (if even n then n = 0 ∨ abs x = abs y else x = y)
    #[2] ¬(n = 0) ⟶ x ^ n = y ^ n ⟷ (if even n then n = 0 ∨ abs x = abs y else x = y)
  ← intro goal=1
    #[3] n = 0
    #[4] x ^ n = y ^ n ⟷ (if even n then n = 0 ∨ abs x = abs y else x = y)
  cut "even n" goal=4
    #[5] even n
  ← rewrite source=prev goal=5 facts=[3]
    #[6] even 0
  ← rewrite even_def_1 sym=false goal=6
    #[7] true
  ← rule trueI goal=7
    #[8] true
  ← rewrite if_P sym=false goal=4 facts=[5]
    #[9] x ^ n = y ^ n ⟷ n = 0 ∨ abs x = abs y
  ← rule iffI goal=9
    #[10] x ^ n = y ^ n ⟶ n = 0 ∨ abs x = abs y
    #[11] n = 0 ∨ abs x = abs y ⟶ x ^ n = y ^ n
  ← intro goal=10
    #[12] x ^ n = y ^ n
    #[13] n = 0 ∨ abs x = abs y
  ← rule disjI1 goal=13
  ← intro goal=11
    #[14] n = 0 ∨ abs x = abs y
    #[15] x ^ n = y ^ n
  ← rewrite source=prev goal=15 facts=[3]
    #[16] x ^ (0::nat) = y ^ (0::nat)
  ← rewrite real_nat_power_def_1 sym=false goal=16
    #[17] x ^ (0::nat) = y ^ (0::nat)
  ← intro goal=2
    #[18] ¬(n = 0)
    #[19] x ^ n = y ^ n ⟷ (if even n then n = 0 ∨ abs x = abs y else x = y)
  ← cases "even n" goal=19
    #[20] even n ⟶ x ^ n = y ^ n ⟷ (if even n then n = 0 ∨ abs x = abs y else x = y)
    #[21] ¬(even n) ⟶ x ^ n = y ^ n ⟷ (if even n then n = 0 ∨ abs x = abs y else x = y)
  ← intro goal=20
    #[22] even n
    #[23] x ^ n = y ^ n ⟷ (if even n then n = 0 ∨ abs x = abs y else x = y)
  ← rewrite if_P sym=false goal=23 facts=[22]
    #[24] x ^ n = y ^ n ⟷ n = 0 ∨ abs x = abs y
  ← rule iffI goal=24
    #[25] x ^ n = y ^ n ⟶ n = 0 ∨ abs x = abs y
    #[26] n = 0 ∨ abs x = abs y ⟶ x ^ n = y ^ n
  ← intro goal=25
    #[27] n = 0 ∨ abs x = abs y
  ← rule disjI2 goal=27
    #[28] abs x = abs y
  ← rule real_pow_eq_abs param_n=n goal=28
  ← intro goal=26
    #[29] x ^ n = y ^ n
  ← rule disjE goal=29 facts=[14]
    #[30] n = 0 ⟶ x ^ n = y ^ n
    #[31] abs x = abs y ⟶ x ^ n = y ^ n
  ← intro goal=30
    #[32] x ^ n = y ^ n
  ← rule negE_gen goal=32 facts=[18,3]
    #[33] x ^ n = y ^ n
  ← intro goal=31
    #[34] abs x = abs y
    #[35] x ^ n = y ^ n
  → rewrite target=fact real_eq_square_abs sym=false goal=35 facts=[34]
    #[36] x ^ (2::nat) = y ^ (2::nat)
  → rewrite target=fact even_exists sym=false goal=35 facts=[22]
    #[37] ∃m. n = 2 * m
  elim m goal=35 facts=[37]
    #[38] _VAR m
    #[39] n = 2 * m
    #[40] x ^ n = y ^ n
  ← rewrite source=prev goal=40 facts=[39]
    #[41] x ^ (2 * m) = y ^ (2 * m)
  ← rewrite real_pow_pow sym=true goal=41
    #[42] x ^ (2::nat) ^ m = y ^ (2::nat) ^ m
  ← rewrite source=prev goal=42 facts=[36]
    #[43] x ^ (2::nat) ^ m = y ^ (2::nat) ^ m
  ← intro goal=21
    #[44] ¬(even n)
    #[45] x ^ n = y ^ n ⟷ (if even n then n = 0 ∨ abs x = abs y else x = y)
  ← rewrite if_not_P sym=false goal=45 facts=[44]
    #[46] x ^ n = y ^ n ⟷ x = y
  ← rule real_pow_eq_odd_eq goal=46
    #[47] odd n
  ← rewrite not_even sym=true goal=47
qed

theorem real_arch_simple
  fixes x :: real
  prop ?n. x <= of_nat n
  [hint_backward]

theorem real_arch_lt
  fixes x :: real
  prop ?n. x < of_nat n
  [hint_backward]
proof
  → forward real_arch_simple param_x=x goal=0
    #[1] ∃n. x ≤ of_nat n
  elim n goal=0 facts=[1]
    #[2] _VAR n
    #[3] x ≤ of_nat n
    #[4] ∃n. x < of_nat n
  ← inst "n + 1" goal=4
    #[5] x < of_nat (n + 1)
  ← z3 goal=5 facts=[3]
qed

theorem real_arch
  fixes x :: real
  prop 0 < x --> (!y. ?n. y < of_nat n * x)
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] ∀y. ∃n. y < of_nat n * x
  ← intro y goal=2
    #[3] _VAR y
    #[4] ∃n. y < of_nat n * x
  → forward real_arch_lt param_x="y / x" goal=4
    #[5] ∃n. y / x < of_nat n
  elim n goal=4 facts=[5]
    #[6] _VAR n
    #[7] y / x < of_nat n
    #[8] ∃n. y < of_nat n * x
  ← inst n goal=8
    #[9] y < of_nat n * x
  ← z3 goal=9 facts=[7,1]
qed

theorem real_arch_inv
  fixes e :: real
  prop 0 < e <--> (?n. ~(n = 0) & 0 < real_inverse (of_nat n) & real_inverse (of_nat n) < e)
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] 0 < e ⟶ (∃n. ¬(n = 0) ∧ 0 < real_inverse (of_nat n) ∧ real_inverse (of_nat n) < e)
    #[2] (∃n. ¬(n = 0) ∧ 0 < real_inverse (of_nat n) ∧ real_inverse (of_nat n) < e) ⟶ 0 < e
  ← intro goal=1
    #[3] 0 < e
    #[4] ∃n. ¬(n = 0) ∧ 0 < real_inverse (of_nat n) ∧ real_inverse (of_nat n) < e
  → forward real_arch_lt param_x="real_inverse e" goal=4
    #[5] ∃n. real_inverse e < of_nat n
  elim n goal=4 facts=[5]
    #[6] _VAR n
    #[7] real_inverse e < of_nat n
    #[8] ∃n. ¬(n = 0) ∧ 0 < real_inverse (of_nat n) ∧ real_inverse (of_nat n) < e
  ← inst n goal=8
    #[9] ¬(n = 0) ∧ 0 < real_inverse (of_nat n) ∧ real_inverse (of_nat n) < e
  ← rule conjI goal=9
    #[10] ¬(n = 0)
    #[11] 0 < real_inverse (of_nat n) ∧ real_inverse (of_nat n) < e
  ← rule negI goal=10
    #[12] n = 0 ⟶ false
  ← intro goal=12
    #[13] n = 0
    #[14] false
  → rewrite target=fact source=prev goal=14 facts=[13,7]
    #[15] real_inverse e < of_nat 0
  → rewrite target=fact real_zero_def sym=true goal=14 facts=[15]
    #[16] real_inverse e < 0
  ← z3 goal=14 facts=[16,3]
  ← rule conjI goal=11
    #[17] 0 < real_inverse (of_nat n)
    #[18] real_inverse (of_nat n) < e
  ← z3 goal=17 facts=[7,3]
  ← z3 goal=18 facts=[7,3]
  ← z3 goal=2
qed

theorem real_pow_lbound
  fixes n :: nat, x :: real
  prop 0 <= x --> 1 + of_nat n * x <= (1 + x) ^ n
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 1 + of_nat n * x ≤ (1 + x) ^ n
  ← induct n nat_induct goal=2
    #[3] 1 + of_nat 0 * x ≤ (1 + x) ^ (0::nat)
    #[4] ∀n. 1 + of_nat n * x ≤ (1 + x) ^ n ⟶ 1 + of_nat (Suc n) * x ≤ (1 + x) ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=3
    #[5] 1 + of_nat 0 * x ≤ 1
  ← rewrite real_zero_def sym=true goal=5
    #[6] 1 + 0 * x ≤ 1
  ← rewrite real_mul_lzero sym=false goal=6
    #[7] (1::real) + 0 ≤ 1
  ← rewrite real_add_rid sym=false goal=7
    #[8] (1::real) ≤ 1
  ← rule real_le_refl goal=8
    #[9] (1::real) ≤ 1
  ← intro n goal=4
    #[10] _VAR n
    #[11] 1 + of_nat n * x ≤ (1 + x) ^ n
    #[12] 1 + of_nat (Suc n) * x ≤ (1 + x) ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=12
    #[13] 1 + of_nat (Suc n) * x ≤ (1 + x) * (1 + x) ^ n
  ← rewrite add_1_right sym=true goal=13
    #[14] 1 + of_nat (n + 1) * x ≤ (1 + x) * (1 + x) ^ n
  ← rewrite real_of_nat_add sym=true goal=14
    #[15] 1 + (of_nat n + of_nat 1) * x ≤ (1 + x) * (1 + x) ^ n
  ← rewrite real_one_def sym=true goal=15
    #[16] 1 + (of_nat n + 1) * x ≤ (1 + x) * (1 + x) ^ n
  ← rule real_le_trans param_y="(1 + x) * (1 + of_nat n * x)" goal=16
    #[17] 1 + (of_nat n + 1) * x ≤ (1 + x) * (1 + of_nat n * x)
    #[18] (1 + x) * (1 + of_nat n * x) ≤ (1 + x) * (1 + x) ^ n
  ← z3 goal=17 facts=[1]
    #[19] 1 + (of_nat n + 1) * x ≤ (1 + x) * (1 + of_nat n * x)
  ← rule real_le_lmul goal=18
    #[20] 0 ≤ 1 + x
  ← z3 goal=20 facts=[1]
    #[21] 0 ≤ 1 + x
qed

theorem real_arch_pow
  fixes x :: real, y :: real
  prop 1 < x --> (?n::nat. y < x ^ n)
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 1 < x
    #[2] ∃n::nat. y < x ^ n
  → forward real_arch param_x=x-1 goal=2
    #[3] 0 < x - 1 ⟶ (∀y. ∃n. y < of_nat n * (x - 1))
  cut "0 < x - 1" goal=2
    #[4] 0 < x - 1
  ← z3 goal=4 facts=[1]
  → forward goal=2 facts=[3,4]
    #[5] ∀y. ∃n. y < of_nat n * (x - 1)
  → inst target=fact y goal=2 facts=[5]
    #[6] ∃n. y < of_nat n * (x - 1)
  elim n goal=2 facts=[6]
    #[7] _VAR n
    #[8] y < of_nat n * (x - 1)
    #[9] ∃n::nat. y < x ^ n
  ← inst n goal=9
    #[10] y < x ^ n
  ← rule real_lte_trans param_y="1+ (of_nat n) * (x - 1)" goal=10
    #[11] y < 1 + of_nat n * (x - 1)
    #[12] 1 + of_nat n * (x - 1) ≤ x ^ n
  ← z3 goal=11 facts=[8]
    #[13] y < 1 + of_nat n * (x - 1)
  → forward real_lt_imp_le goal=12 facts=[4]
    #[14] 0 ≤ x - 1
  → forward real_pow_lbound param_n=n goal=12 facts=[14]
    #[15] 1 + of_nat n * (x - 1) ≤ (1 + (x - 1)) ^ n
  cut "1+(x-1)=x" goal=12
    #[16] 1 + (x - 1) = x
  real_norm goal=16
    #[17] 1 + (x - 1) = x
  → rewrite target=fact source=prev goal=12 facts=[17,15]
    #[18] 1 + of_nat n * (x - 1) ≤ x ^ n
qed

theorem real_arch_pow2
  fixes x :: real
  prop ?n::nat. x < 2 ^ n
  [hint_backward]
proof
  ← rule real_arch_pow goal=0
    #[1] (1::real) < 2
  ← z3 goal=1
qed

theorem real_arch_pow_inv
  fixes x :: real, y :: real
  prop 0 < y --> x < 1 --> (?n::nat. x ^ n < y)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 < y
    #[2] x < 1
    #[3] ∃n::nat. x ^ n < y
  ← cases "0 < x" goal=3
    #[4] 0 < x ⟶ (∃n::nat. x ^ n < y)
    #[5] ¬(0 < x) ⟶ (∃n::nat. x ^ n < y)
  ← intro goal=4
    #[6] 0 < x
    #[7] ∃n::nat. x ^ n < y
  cut "real_inverse 1 < real_inverse x" goal=7
    #[8] real_inverse 1 < real_inverse x
  ← rule real_lt_inv2 goal=8
  → rewrite target=fact real_inv_1 sym=false goal=7 facts=[8]
    #[9] 1 < real_inverse x
  → forward real_arch_pow param_y="real_inverse y" goal=7 facts=[9]
    #[10] ∃n::nat. real_inverse y < real_inverse x ^ n
  elim n goal=7 facts=[10]
    #[11] _VAR n
    #[12] real_inverse y < real_inverse x ^ n
    #[13] ∃n::nat. x ^ n < y
  ← inst n goal=13
    #[14] x ^ n < y
  ← rewrite real_inv_inv sym=true goal=14
    #[15] real_inverse (real_inverse (x ^ n)) < real_inverse (real_inverse y)
  ← rule real_lt_inv2 goal=15
    #[16] 0 < real_inverse y
    #[17] real_inverse y < real_inverse (x ^ n)
  ← rule real_lt_inv goal=16
  ← rewrite real_pow_inv sym=true goal=17
  ← intro goal=5
    #[18] ¬(0 < x)
    #[19] ∃n::nat. x ^ n < y
  → rewrite target=fact real_not_lt sym=false goal=19 facts=[18]
    #[20] x ≤ 0
  ← inst "(1::nat)" goal=19
    #[21] x ^ (1::nat) < y
  ← rewrite real_pow_1 sym=false goal=21
    #[22] x < y
  ← rule real_let_trans goal=22 facts=[20,1]
    #[23] x < y
qed

def real_sgn :: real ⇒ real = real_sgn x = (if 0 < x then 1 else if x < 0 then -1 else 0) [hint_rewrite]

theorem real_sgn_0
  prop real_sgn 0 = 0
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if (0::real) < 0 then (1::real) else if (0::real) < 0 then -1 else 0) = 0
  ← z3 goal=1
qed

theorem real_sgn_neg
  fixes x :: real
  prop real_sgn (-x) = -(real_sgn x)
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < -x then (1::real) else if -x < 0 then -1 else 0) = -(if 0 < x then 1 else if x < 0 then -1 else 0)
  ← z3 goal=1
qed

theorem real_sgn_abs
  fixes x :: real
  prop real_sgn x * abs x = x
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < x then 1 else if x < 0 then -1 else 0) * abs x = x
  ← z3 goal=1
qed

theorem real_sgn_abs_alt
  fixes x :: real
  prop real_sgn x * x = abs x
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < x then 1 else if x < 0 then -1 else 0) * x = abs x
  ← z3 goal=1
qed

theorem real_eq_sgn_abs
  fixes x :: real, y :: real
  prop x = y <--> real_sgn x = real_sgn y & abs x = abs y
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] x = y ⟶ real_sgn x = real_sgn y ∧ abs x = abs y
    #[2] real_sgn x = real_sgn y ∧ abs x = abs y ⟶ x = y
  ← intro goal=1
    #[3] x = y
    #[4] real_sgn x = real_sgn y ∧ abs x = abs y
  ← rewrite source=prev goal=4 facts=[3]
    #[5] real_sgn y = real_sgn y ∧ abs y = abs y
  ← rule conjI goal=5
    #[6] real_sgn y = real_sgn y
    #[7] abs y = abs y
  ← rule eq_refl goal=6
    #[8] real_sgn y = real_sgn y
  ← rule eq_refl goal=7
    #[9] abs y = abs y
  ← intro goal=2
    #[10] real_sgn x = real_sgn y ∧ abs x = abs y
    #[11] x = y
  → forward conjD1 goal=11 facts=[10]
    #[12] real_sgn x = real_sgn y
  → forward conjD2 goal=11 facts=[10]
    #[13] abs x = abs y
  ← rewrite real_sgn_abs sym=true goal=11
    #[14] real_sgn x * abs x = real_sgn y * abs y
  ← rewrite source=prev goal=14 facts=[12]
    #[15] real_sgn y * abs x = real_sgn y * abs y
  ← rewrite source=prev goal=15 facts=[13]
qed

theorem real_abs_sgn
  fixes x :: real
  prop abs (real_sgn x) = real_sgn (abs x)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] abs (if 0 < x then (1::real) else if x < 0 then -1 else 0) = (if 0 < abs x then 1 else if abs x < 0 then -1 else 0)
  ← z3 goal=1
qed

theorem real_sgn
  fixes x :: real
  prop real_sgn x = x / abs x
  [hint_rewrite,hint_rewrite_sym]
proof
  ← cases "x = 0" goal=0
    #[1] x = 0 ⟶ real_sgn x = x / abs x
    #[2] ¬(x = 0) ⟶ real_sgn x = x / abs x
  ← intro goal=1
    #[3] x = 0
    #[4] real_sgn x = x / abs x
  ← rewrite source=prev goal=4 facts=[3]
    #[5] real_sgn 0 = 0 / abs 0
  ← rewrite real_sgn_0 sym=false goal=5
    #[6] 0 = 0 / abs 0
  ← rewrite real_divide_def sym=false goal=6
    #[7] 0 = 0 * real_inverse (abs 0)
  ← rewrite real_mul_lzero sym=false goal=7
    #[8] 0 = 0 * real_inverse (abs 0)
  ← intro goal=2
    #[9] ¬(x = 0)
    #[10] real_sgn x = x / abs x
  ← rewrite real_divide_def sym=false goal=10
    #[11] real_sgn x = x * real_inverse (abs x)
  cut "real_sgn x = real_sgn x * abs x * real_inverse (abs x)" goal=11
    #[12] real_sgn x = real_sgn x * abs x * real_inverse (abs x)
  ← rewrite real_mult_assoc sym=true goal=12
    #[13] real_sgn x = real_sgn x * (abs x * real_inverse (abs x))
  → rewrite target=fact real_abs_zero sym=true goal=13 facts=[9]
    #[14] ¬(abs x = 0)
  → forward real_mul_linv goal=13 facts=[14]
    #[15] real_inverse (abs x) * abs x = 1
  → rewrite target=fact real_mult_comm sym=false goal=13 facts=[15]
    #[16] abs x * real_inverse (abs x) = 1
  ← rewrite source=prev goal=13 facts=[16]
    #[17] real_sgn x = real_sgn x * 1
  ← rewrite real_mul_rid sym=false goal=17
    #[18] real_sgn x = real_sgn x * 1
  → rewrite target=fact real_sgn_abs sym=false goal=11 facts=[12]
qed

theorem real_sgn_mul
  fixes x :: real, y :: real
  prop real_sgn (x * y) = real_sgn x * real_sgn y
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_sgn sym=false goal=0
    #[1] x * y / abs (x * y) = x / abs x * (y / abs y)
  ← rewrite real_abs_mul sym=false goal=1
    #[2] x * y / (abs x * abs y) = x / abs x * (y / abs y)
  ← cases "x = 0" goal=2
    #[3] x = 0 ⟶ x * y / (abs x * abs y) = x / abs x * (y / abs y)
    #[4] ¬(x = 0) ⟶ x * y / (abs x * abs y) = x / abs x * (y / abs y)
  ← intro goal=3
    #[5] x = 0
    #[6] x * y / (abs x * abs y) = x / abs x * (y / abs y)
  ← rewrite source=prev goal=6 facts=[5]
    #[7] 0 * y / (abs 0 * abs y) = 0 / abs 0 * (y / abs y)
  ← rewrite real_abs_0 sym=false goal=7
    #[8] 0 * y / (0 * abs y) = 0 / 0 * (y / abs y)
  ← rewrite real_mul_lzero sym=false goal=8
    #[9] 0 / 0 = 0 / 0 * (y / abs y)
  ← rewrite real_divide_def sym=false goal=9
    #[10] 0 * real_inverse 0 = 0 * real_inverse 0 * (y * real_inverse (abs y))
  ← rewrite real_inv_0 sym=false goal=10
    #[11] 0 * 0 = 0 * 0 * (y * real_inverse (abs y))
  real_norm goal=11
    #[12] 0 * 0 = 0 * 0 * (y * real_inverse (abs y))
  ← intro goal=4
    #[13] ¬(x = 0)
    #[14] x * y / (abs x * abs y) = x / abs x * (y / abs y)
  ← cases "y = 0" goal=14
    #[15] y = 0 ⟶ x * y / (abs x * abs y) = x / abs x * (y / abs y)
    #[16] ¬(y = 0) ⟶ x * y / (abs x * abs y) = x / abs x * (y / abs y)
  ← intro goal=15
    #[17] y = 0
    #[18] x * y / (abs x * abs y) = x / abs x * (y / abs y)
  ← rewrite source=prev goal=18 facts=[17]
    #[19] x * 0 / (abs x * abs 0) = x / abs x * (0 / abs 0)
  ← rewrite real_abs_0 sym=false goal=19
    #[20] x * 0 / (abs x * 0) = x / abs x * (0 / 0)
  ← rewrite real_mul_rzero sym=false goal=20
    #[21] 0 / 0 = x / abs x * (0 / 0)
  ← rewrite real_divide_def sym=false goal=21
    #[22] 0 * real_inverse 0 = x * real_inverse (abs x) * (0 * real_inverse 0)
  ← rewrite real_inv_0 sym=false goal=22
    #[23] 0 * 0 = x * real_inverse (abs x) * (0 * 0)
  real_norm goal=23
    #[24] 0 * 0 = x * real_inverse (abs x) * (0 * 0)
  ← z3 goal=16 facts=[13]
qed

theorem real_sgn_inv
  fixes x :: real
  prop real_sgn (real_inverse x) = real_sgn x
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < real_inverse x then (1::real) else if real_inverse x < 0 then -1 else 0) = (if 0 < x then 1 else if x < 0 then -1 else 0)
  cut "!x::real. x < 0 <--> 0 < -x" goal=1
    #[2] ∀x::real. x < 0 ⟷ 0 < -x
  ← z3 goal=2
  ← rewrite source=prev goal=1 facts=[2]
    #[3] (if 0 < real_inverse x then (1::real) else if 0 < -(real_inverse x) then -1 else 0) = (if 0 < x then 1 else if 0 < -x then -1 else 0)
  ← rewrite real_inv_neg sym=true goal=3
    #[4] (if 0 < real_inverse x then (1::real) else if 0 < real_inverse (-x) then -1 else 0) = (if 0 < x then 1 else if 0 < -x then -1 else 0)
  ← rewrite real_lt_inv_eq sym=false goal=4
qed

theorem real_sgn_div
  fixes x :: real, y :: real
  prop real_sgn (x / y) = real_sgn x / real_sgn y
  [hint_rewrite,hint_rewrite_sym]
proof
  ← cases "y = 0" goal=0
    #[1] y = 0 ⟶ real_sgn (x / y) = real_sgn x / real_sgn y
    #[2] ¬(y = 0) ⟶ real_sgn (x / y) = real_sgn x / real_sgn y
  ← intro goal=1
    #[3] y = 0
    #[4] real_sgn (x / y) = real_sgn x / real_sgn y
  ← rewrite source=prev goal=4 facts=[3]
    #[5] real_sgn (x / 0) = real_sgn x / real_sgn 0
  ← rewrite real_sgn_0 sym=false goal=5
    #[6] real_sgn (x / 0) = real_sgn x / 0
  ← rewrite real_divide_def sym=false goal=6
    #[7] real_sgn (x * real_inverse 0) = real_sgn x * real_inverse 0
  ← rewrite real_inv_0 sym=false goal=7
    #[8] real_sgn (x * 0) = real_sgn x * 0
  ← rewrite real_mul_rzero sym=false goal=8
    #[9] real_sgn 0 = 0
  ← rewrite real_sgn_0 sym=false goal=9
    #[10] real_sgn 0 = 0
  ← intro goal=2
    #[11] ¬(y = 0)
    #[12] real_sgn (x / y) = real_sgn x / real_sgn y
  ← rewrite real_sgn_def sym=false goal=12
    #[13] (if 0 < x / y then 1 else if x / y < 0 then -1 else 0) = (if 0 < x then 1 else if x < 0 then -1 else 0) / (if 0 < y then 1 else if y < 0 then -1 else 0)
  ← z3 goal=13 facts=[11]
qed

theorem real_sgn_eq_0
  fixes x :: real
  prop real_sgn x = 0 <--> x = 0
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < x then (1::real) else if x < 0 then -1 else 0) = 0 ⟷ x = 0
  ← z3 goal=1
qed

theorem real_sgn_eq_1
  fixes x :: real
  prop real_sgn x = 1 <--> 0 < x
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < x then (1::real) else if x < 0 then -1 else 0) = 1 ⟷ 0 < x
  ← z3 goal=1
qed

theorem real_sgn_eq_neg1
  fixes x :: real
  prop real_sgn x = -1 <--> x < 0
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < x then (1::real) else if x < 0 then -1 else 0) = -1 ⟷ x < 0
  ← z3 goal=1
qed

theorem real_sgn_cases
  fixes x :: real
  prop real_sgn x = 0 | real_sgn x = 1 | real_sgn x = -1
  [hint_backward]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < x then (1::real) else if x < 0 then -1 else 0) = 0 ∨ (if 0 < x then (1::real) else if x < 0 then -1 else 0) = 1 ∨ (if 0 < x then (1::real) else if x < 0 then -1 else 0) = -1
  ← z3 goal=1
qed

theorem real_sgn_pow
  fixes n :: nat, x :: real
  prop real_sgn (x ^ n) = real_sgn x ^ n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← induct n nat_induct goal=0
    #[1] real_sgn (x ^ (0::nat)) = real_sgn x ^ (0::nat)
    #[2] ∀n. real_sgn (x ^ n) = real_sgn x ^ n ⟶ real_sgn (x ^ Suc n) = real_sgn x ^ Suc n
  ← rewrite real_nat_power_def_1 sym=false goal=1
    #[3] real_sgn 1 = 1
  ← rewrite real_sgn_def sym=false goal=3
    #[4] (if (0::real) < 1 then (1::real) else if (1::real) < 0 then -1 else 0) = 1
  ← z3 goal=4
  ← intro n goal=2
    #[5] _VAR n
    #[6] real_sgn (x ^ n) = real_sgn x ^ n
    #[7] real_sgn (x ^ Suc n) = real_sgn x ^ Suc n
  ← rewrite real_nat_power_def_2 sym=false goal=7
    #[8] real_sgn (x * x ^ n) = real_sgn x * real_sgn x ^ n
  ← rewrite real_sgn_mul sym=false goal=8
    #[9] real_sgn x * real_sgn (x ^ n) = real_sgn x * real_sgn x ^ n
  ← rewrite source=prev goal=9 facts=[6]
qed

theorem real_sgn_pow_2
  fixes x :: real
  prop real_sgn (x ^ (2::nat)) = real_sgn (abs x)
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < x ^ (2::nat) then (1::real) else if x ^ (2::nat) < 0 then -1 else 0) = (if 0 < abs x then 1 else if abs x < 0 then -1 else 0)
  ← rewrite real_less_def sym=false goal=1
    #[2] (if ¬(x ^ (2::nat) ≤ 0) then (1::real) else if ¬(0 ≤ x ^ (2::nat)) then -1 else 0) = (if ¬(abs x ≤ 0) then 1 else if ¬(0 ≤ abs x) then -1 else 0)
  → forward real_abs_pos param_x=x goal=2
    #[3] 0 ≤ abs x
  ← rewrite if_not_P2 sym=false goal=2 facts=[3]
    #[4] (if ¬(x ^ (2::nat) ≤ 0) then (1::real) else if ¬(0 ≤ x ^ (2::nat)) then -1 else 0) = (if ¬(abs x ≤ 0) then 1 else 0)
  → forward real_le_pow_2 param_x=x goal=4
    #[5] 0 ≤ x ^ (2::nat)
  ← rewrite if_not_P2 sym=false goal=4 facts=[5]
    #[6] (if ¬(x ^ (2::nat) ≤ 0) then (1::real) else 0) = (if ¬(abs x ≤ 0) then 1 else 0)
  cut "!x::real. 0 <= x --> (x <= 0 <--> x = 0)" goal=6
    #[7] ∀x::real. 0 ≤ x ⟶ x ≤ 0 ⟷ x = 0
  ← z3 goal=7
  → forward goal=6 facts=[7,3]
    #[8] abs x ≤ 0 ⟷ abs x = 0
  ← rewrite source=prev goal=6 facts=[8]
    #[9] (if ¬(x ^ (2::nat) ≤ 0) then (1::real) else 0) = (if ¬(abs x = 0) then 1 else 0)
  → forward goal=9 facts=[7,5]
    #[10] x ^ (2::nat) ≤ 0 ⟷ x ^ (2::nat) = 0
  ← rewrite source=prev goal=9 facts=[10]
    #[11] (if ¬(x ^ (2::nat) = 0) then (1::real) else 0) = (if ¬(abs x = 0) then 1 else 0)
  ← rewrite real_abs_zero sym=false goal=11
    #[12] (if ¬(x ^ (2::nat) = 0) then (1::real) else 0) = (if ¬(x = 0) then 1 else 0)
  ← rewrite real_pow_eq_0 sym=false goal=12
    #[13] (if ¬(x = 0 ∧ ¬((2::nat) = 0)) then (1::real) else 0) = (if ¬(x = 0) then 1 else 0)
  ← z3 goal=13
qed

theorem real_sgn_real_sgn
  fixes x :: real
  prop real_sgn (real_sgn x) = real_sgn x
  [hint_rewrite]
proof
  ← rewrite real_sgn_def sym=false goal=0
    #[1] (if 0 < real_sgn x then (1::real) else if real_sgn x < 0 then -1 else 0) = (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← rewrite real_sgn_def sym=false goal=1
    #[2] (if (0::real) < (if 0 < x then 1 else if x < 0 then -1 else 0) then (1::real) else if (if 0 < x then (1::real) else if x < 0 then -1 else 0) < 0 then -1 else 0) = (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← z3 goal=2
qed

theorem real_inv_sgn
  fixes x :: real
  prop real_inverse (real_sgn x) = real_sgn x
  [hint_rewrite]
proof
  ← rewrite eq_sym_eq sym=false goal=0
    #[1] real_sgn x = real_inverse (real_sgn x)
  ← rewrite real_sgn_def sym=false goal=1
    #[2] (if 0 < x then 1 else if x < 0 then -1 else 0) = real_inverse (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← cases "0 < x" goal=2
    #[3] 0 < x ⟶ (if 0 < x then 1 else if x < 0 then -1 else 0) = real_inverse (if 0 < x then 1 else if x < 0 then -1 else 0)
    #[4] ¬(0 < x) ⟶ (if 0 < x then 1 else if x < 0 then -1 else 0) = real_inverse (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← intro goal=3
    #[5] 0 < x
    #[6] (if 0 < x then 1 else if x < 0 then -1 else 0) = real_inverse (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← rewrite if_P sym=false goal=6 facts=[5]
    #[7] 1 = real_inverse 1
  ← rewrite real_inv_1 sym=false goal=7
    #[8] 1 = real_inverse 1
  ← intro goal=4
    #[9] ¬(0 < x)
    #[10] (if 0 < x then 1 else if x < 0 then -1 else 0) = real_inverse (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← rewrite if_not_P sym=false goal=10 facts=[9]
    #[11] (if x < 0 then -1 else 0) = real_inverse (if x < 0 then -1 else 0)
  ← cases "x < 0" goal=11
    #[12] x < 0 ⟶ (if x < 0 then -1 else 0) = real_inverse (if x < 0 then -1 else 0)
    #[13] ¬(x < 0) ⟶ (if x < 0 then -1 else 0) = real_inverse (if x < 0 then -1 else 0)
  ← intro goal=12
    #[14] x < 0
    #[15] (if x < 0 then -1 else 0) = real_inverse (if x < 0 then -1 else 0)
  ← rewrite if_P sym=false goal=15 facts=[14]
    #[16] -1 = real_inverse (-1)
  ← rewrite real_inverse_divide sym=false goal=16
    #[17] -1 = 1 / -1
  ← z3 goal=17
    #[18] -1 = 1 / -1
  ← intro goal=13
    #[19] ¬(x < 0)
    #[20] (if x < 0 then -1 else 0) = real_inverse (if x < 0 then -1 else 0)
  ← rewrite if_not_P sym=false goal=20 facts=[19]
    #[21] 0 = real_inverse 0
  ← rewrite real_inv_0 sym=false goal=21
    #[22] 0 = real_inverse 0
qed

theorem real_sgn_imp_pos
  fixes x :: real
  prop 0 < x --> real_sgn x = 1
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] real_sgn x = 1
  ← rewrite real_sgn_def sym=false goal=2
    #[3] (if 0 < x then (1::real) else if x < 0 then -1 else 0) = 1
  ← rewrite if_P sym=false goal=3 facts=[1]
qed

theorem real_sgn_eq_pos
  fixes a :: real, b :: real
  prop real_sgn a = real_sgn b --> 0 <= a <--> 0 <= b
  [hint_backward]
proof
  ← intro goal=0
    #[1] real_sgn a = real_sgn b
    #[2] 0 ≤ a ⟷ 0 ≤ b
  → rewrite target=fact real_sgn_def sym=false goal=2 facts=[1]
    #[3] (if 0 < a then (1::real) else if a < 0 then -1 else 0) = (if 0 < b then 1 else if b < 0 then -1 else 0)
  ← z3 goal=2 facts=[3]
qed

theorem real_sgn_eq_pos_lt
  fixes a :: real, b :: real
  prop real_sgn a = real_sgn b --> 0 < a <--> 0 < b
  [hint_backward]
proof
  ← intro goal=0
    #[1] real_sgn a = real_sgn b
    #[2] 0 < a ⟷ 0 < b
  → rewrite target=fact real_sgn_def sym=false goal=2 facts=[1]
    #[3] (if 0 < a then (1::real) else if a < 0 then -1 else 0) = (if 0 < b then 1 else if b < 0 then -1 else 0)
  ← z3 goal=2 facts=[3]
qed

theorem real_wlog_le
  fixes P :: real => real => bool
  prop (!x. !y. P x y <--> P y x) --> (!x. !y. x <= y --> P x y) --> (!x. !y. P x y)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ∀x. ∀y. P x y ⟷ P y x
    #[2] ∀x. ∀y. x ≤ y ⟶ P x y
    #[3] ∀x. ∀y. P x y
  ← intro x,y goal=3
    #[4] _VAR x
    #[5] _VAR y
    #[6] P x y
  → forward real_le_total param_x=x param_y=y goal=6
    #[7] x ≤ y ∨ y ≤ x
  ← rule disjE goal=6 facts=[7]
    #[8] x ≤ y ⟶ P x y
    #[9] y ≤ x ⟶ P x y
  ← intro goal=8
    #[10] x ≤ y
    #[11] P x y
  ← apply_prev goal=11 facts=[2]
  ← intro goal=9
    #[12] y ≤ x
    #[13] P x y
  ← rewrite source=prev goal=13 facts=[1]
    #[14] P y x
  ← apply_prev goal=14 facts=[2]
qed

theorem real_wlog_lt
  fixes P :: real => real => bool
  prop (!x. P x x) --> (!x. !y. P x y <--> P y x) --> (!x. !y. x < y --> P x y) --> (!x. !y. P x y)
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] ∀x. P x x
    #[2] ∀x. ∀y. P x y ⟷ P y x
    #[3] ∀x. ∀y. x < y ⟶ P x y
    #[4] ∀x. ∀y. P x y
  ← intro x,y goal=4
    #[5] _VAR x
    #[6] _VAR y
    #[7] P x y
  cut "x < y | x=y | y < x" goal=7
    #[8] x < y ∨ x = y ∨ y < x
  ← z3 goal=8
    #[9] x < y ∨ x = y ∨ y < x
  ← rule disjE goal=7 facts=[9]
    #[10] x < y ⟶ P x y
    #[11] x = y ∨ y < x ⟶ P x y
  ← intro goal=10
    #[12] x < y
    #[13] P x y
  ← apply_prev goal=13 facts=[3]
  ← intro goal=11
    #[14] x = y ∨ y < x
    #[15] P x y
  ← rule disjE goal=15 facts=[14]
    #[16] x = y ⟶ P x y
    #[17] y < x ⟶ P x y
  ← intro goal=16
    #[18] x = y
    #[19] P x y
  ← rewrite source=prev goal=19 facts=[18]
    #[20] P y y
  ← apply_prev goal=20 facts=[1]
    #[21] P y y
  ← intro goal=17
    #[22] y < x
    #[23] P x y
  ← rewrite source=prev goal=23 facts=[2]
    #[24] P y x
  ← apply_prev goal=24 facts=[3]
qed

def sqrt :: real ⇒ real = sqrt x = (SOME y. real_sgn y = real_sgn x ∧ y ^ (2::nat) = abs x) [hint_rewrite]

theorem sqrt_unique
  fixes x :: real, y :: real
  prop 0 <= y --> y ^ (2::nat) = x --> sqrt x = y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ y
    #[2] y ^ (2::nat) = x
    #[3] sqrt x = y
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[2]
    #[4] x = y ^ (2::nat)
  ← rewrite sqrt_def sym=false goal=3
    #[5] (SOME y1. real_sgn y1 = real_sgn x ∧ y1 ^ (2::nat) = abs x) = y
  ← rule some_unique goal=5
    #[6] ∀y1. real_sgn y1 = real_sgn x ∧ y1 ^ (2::nat) = abs x ⟷ y1 = y
  ← intro z goal=6
    #[7] _VAR z
    #[8] real_sgn z = real_sgn x ∧ z ^ (2::nat) = abs x ⟷ z = y
  ← rule iffI goal=8
    #[9] real_sgn z = real_sgn x ∧ z ^ (2::nat) = abs x ⟶ z = y
    #[10] z = y ⟶ real_sgn z = real_sgn x ∧ z ^ (2::nat) = abs x
  ← intro goal=9
    #[11] real_sgn z = real_sgn x ∧ z ^ (2::nat) = abs x
    #[12] z = y
  → forward conjD1 goal=12 facts=[11]
    #[13] real_sgn z = real_sgn x
  → forward conjD2 goal=12 facts=[11]
    #[14] z ^ (2::nat) = abs x
  ← rewrite real_eq_sgn_abs sym=false goal=12
    #[15] real_sgn z = real_sgn y ∧ abs z = abs y
  ← rule conjI goal=15
    #[16] real_sgn z = real_sgn y
    #[17] abs z = abs y
  ← rewrite source=prev goal=16 facts=[13]
    #[18] real_sgn x = real_sgn y
  → rewrite target=fact real_le_lt sym=false goal=18 facts=[1]
    #[19] 0 < y ∨ 0 = y
  ← rule disjE goal=18 facts=[19]
    #[20] 0 < y ⟶ real_sgn x = real_sgn y
    #[21] 0 = y ⟶ real_sgn x = real_sgn y
  ← intro goal=20
    #[22] 0 < y
    #[23] real_sgn x = real_sgn y
  ← rewrite real_sgn_def sym=false goal=23
    #[24] (if 0 < x then (1::real) else if x < 0 then -1 else 0) = (if 0 < y then 1 else if y < 0 then -1 else 0)
  ← rewrite if_P sym=false goal=24 facts=[22]
    #[25] (if 0 < x then (1::real) else if x < 0 then -1 else 0) = 1
  ← rule if_P1 goal=25
    #[26] 0 < x
  ← rewrite source=prev goal=26 facts=[4]
    #[27] 0 < y ^ (2::nat)
  ← rewrite real_lt_pow_2 sym=false goal=27
    #[28] ¬(y = 0)
  → rewrite target=fact real_lt_le sym=false goal=28 facts=[22]
    #[29] 0 ≤ y ∧ ¬(0 = y)
  → forward conjD2 goal=28 facts=[29]
    #[30] ¬(0 = y)
  ← rule ineq_sym goal=28 facts=[30]
    #[31] ¬(y = 0)
  ← intro goal=21
    #[32] 0 = y
    #[33] real_sgn x = real_sgn y
  → rewrite target=fact eq_sym_eq sym=false goal=33 facts=[32]
    #[34] y = 0
  ← rewrite source=prev goal=33 facts=[34]
    #[35] real_sgn x = real_sgn 0
  ← rewrite real_sgn_0 sym=false goal=35
    #[36] real_sgn x = 0
  ← rewrite real_sgn_eq_0 sym=false goal=36
    #[37] x = 0
  ← rewrite source=prev goal=37 facts=[4]
    #[38] y ^ (2::nat) = 0
  ← rewrite source=prev goal=38 facts=[34]
    #[39] (0::real) ^ (2::nat) = 0
  real_norm goal=39
    #[40] (0::real) ^ (2::nat) = 0
  ← rewrite real_eq_square_abs sym=false goal=17
    #[41] z ^ (2::nat) = y ^ (2::nat)
  ← rewrite source=prev goal=41 facts=[2]
    #[42] z ^ (2::nat) = x
  ← rewrite source=prev goal=42 facts=[14]
    #[43] abs x = x
  ← rewrite abs_def sym=false goal=43
    #[44] (if 0 ≤ x then x else -x) = x
  ← rule if_P1 goal=44
    #[45] 0 ≤ x
  ← rewrite source=prev goal=45 facts=[4]
    #[46] 0 ≤ y ^ (2::nat)
  ← rule real_le_pow_2 goal=46
    #[47] 0 ≤ y ^ (2::nat)
  ← intro goal=10
    #[48] z = y
    #[49] real_sgn z = real_sgn x ∧ z ^ (2::nat) = abs x
  ← rewrite source=prev goal=49 facts=[48]
    #[50] real_sgn y = real_sgn x ∧ y ^ (2::nat) = abs x
  ← rule conjI goal=50
    #[51] real_sgn y = real_sgn x
    #[52] y ^ (2::nat) = abs x
  → rewrite target=fact real_le_lt sym=false goal=51 facts=[1]
  ← rule disjE goal=51 facts=[19]
    #[53] 0 < y ⟶ real_sgn y = real_sgn x
    #[54] 0 = y ⟶ real_sgn y = real_sgn x
  ← intro goal=53
    #[55] real_sgn y = real_sgn x
  ← rewrite real_sgn_def sym=false goal=55
    #[56] (if 0 < y then (1::real) else if y < 0 then -1 else 0) = (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← rewrite if_P sym=false goal=56 facts=[22]
    #[57] (1::real) = (if 0 < x then 1 else if x < 0 then -1 else 0)
  ← rewrite eq_sym_eq sym=false goal=57
    #[58] (if 0 < x then (1::real) else if x < 0 then -1 else 0) = 1
  ← rule if_P1 goal=58
    #[59] 0 < x
  ← rewrite source=prev goal=59 facts=[4]
    #[60] 0 < y ^ (2::nat)
  ← rewrite real_lt_pow_2 sym=false goal=60
    #[61] ¬(y = 0)
  → rewrite target=fact real_lt_le sym=false goal=61 facts=[22]
  → forward conjD2 goal=61 facts=[29]
  ← rule ineq_sym goal=61 facts=[30]
  ← intro goal=54
    #[62] real_sgn y = real_sgn x
  → rewrite target=fact eq_sym_eq sym=false goal=62 facts=[32]
  ← rewrite source=prev goal=62 facts=[34]
    #[63] real_sgn 0 = real_sgn x
  ← rewrite real_sgn_0 sym=false goal=63
    #[64] 0 = real_sgn x
  ← rewrite eq_sym_eq sym=false goal=64
    #[65] real_sgn x = 0
  ← rewrite real_sgn_eq_0 sym=false goal=65
    #[66] x = 0
  ← rewrite source=prev goal=66 facts=[4]
    #[67] y ^ (2::nat) = 0
  ← rewrite source=prev goal=67 facts=[34]
    #[68] (0::real) ^ (2::nat) = 0
  real_norm goal=68
  ← rewrite source=prev goal=52 facts=[4]
    #[69] y ^ (2::nat) = abs (y ^ (2::nat))
  ← rewrite eq_sym_eq sym=false goal=69
    #[70] abs (y ^ (2::nat)) = y ^ (2::nat)
  ← rewrite abs_def sym=false goal=70
    #[71] (if 0 ≤ y ^ (2::nat) then y ^ (2::nat) else -(y ^ (2::nat))) = y ^ (2::nat)
  ← rule if_P1 goal=71
    #[72] 0 ≤ y ^ (2::nat)
  ← rule real_le_pow_2 goal=72
qed

theorem pow_2_sqrt
  fixes x :: real
  prop 0 <= x --> sqrt (x ^ (2::nat)) = x
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] sqrt (x ^ (2::nat)) = x
  ← rule sqrt_unique goal=2
    #[3] x ^ (2::nat) = x ^ (2::nat)
  ← rule eq_refl goal=3
    #[4] x ^ (2::nat) = x ^ (2::nat)
qed

theorem sqrt_0
  prop sqrt 0 = 0
  [hint_rewrite]
proof
  ← rule sqrt_unique goal=0
    #[1] (0::real) ≤ 0
    #[2] (0::real) ^ (2::nat) = 0
  ← rule real_le_refl goal=1
  ← rewrite real_pow_2 sym=false goal=2
    #[3] (0::real) * 0 = 0
  ← rewrite real_mul_lzero sym=false goal=3
qed

theorem sqrt_1
  prop sqrt 1 = 1
  [hint_rewrite]
proof
  ← rule sqrt_unique goal=0
    #[1] (0::real) ≤ 1
    #[2] (1::real) ^ (2::nat) = 1
  ← z3 goal=1
  ← rewrite real_pow_one sym=false goal=2
qed

theorem pow_2_sqrt_abs
  fixes x :: real
  prop sqrt (x ^ (2::nat)) = abs x
  [hint_rewrite]
proof
  ← rule sqrt_unique goal=0
    #[1] 0 ≤ abs x
    #[2] abs x ^ (2::nat) = x ^ (2::nat)
  ← z3 goal=1
  ← rewrite real_pow2_abs sym=false goal=2
qed

theorem pow_2_sqrt_abs_alt
  fixes x :: real
  prop x ^ (2::nat) ^ (1 / 2) = abs x

theorem real_sgn_sqrt
  fixes x :: real
  prop real_sgn (sqrt x) = real_sgn x
  [hint_rewrite]

theorem sqrt_works_gen_2
  fixes x :: real
  prop sqrt x ^ (2::nat) = abs x
  [hint_rewrite]

theorem sqrt_unique_gen
  fixes x :: real, y :: real
  prop real_sgn y = real_sgn x --> y ^ (2::nat) = abs x --> sqrt x = y
  [hint_backward,hint_backward1,hint_forward]
proof
  ← intro goal=0
    #[1] real_sgn y = real_sgn x
    #[2] y ^ (2::nat) = abs x
    #[3] sqrt x = y
  → forward real_sgn_sqrt param_x=x goal=3
    #[4] real_sgn (sqrt x) = real_sgn x
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] real_sgn x = real_sgn (sqrt x)
  → rewrite target=fact source=prev goal=3 facts=[5,1]
    #[6] real_sgn y = real_sgn (sqrt x)
  → forward sqrt_works_gen_2 param_x=x goal=3
    #[7] sqrt x ^ (2::nat) = abs x
  → rewrite target=fact eq_sym_eq sym=false goal=3 facts=[7]
    #[8] abs x = sqrt x ^ (2::nat)
  → rewrite target=fact source=prev goal=3 facts=[8,2]
    #[9] y ^ (2::nat) = sqrt x ^ (2::nat)
  → rewrite target=fact real_pow_2 sym=false goal=3 facts=[9]
    #[10] y * y = sqrt x * sqrt x
  cut "!x::real. !y. x * x = y * y <--> (x - y) * ( x - (-y)) = 0" goal=3
    #[11] ∀x::real. ∀y. x * x = y * y ⟷ (x - y) * (x - -y) = 0
  ← z3 goal=11
    #[12] ∀x::real. ∀y. x * x = y * y ⟷ (x - y) * (x - -y) = 0
  → rewrite target=fact source=prev goal=3 facts=[12,10]
    #[13] (y - sqrt x) * (y - -(sqrt x)) = 0
  → rewrite target=fact real_entire sym=false goal=3 facts=[13]
    #[14] y - sqrt x = 0 ∨ y - -(sqrt x) = 0
  ← rule disjE goal=3 facts=[14]
    #[15] y - sqrt x = 0 ⟶ sqrt x = y
    #[16] y - -(sqrt x) = 0 ⟶ sqrt x = y
  ← intro goal=15
    #[17] y - sqrt x = 0
    #[18] sqrt x = y
  → rewrite target=fact real_sub_0 sym=false goal=18 facts=[17]
    #[19] y = sqrt x
  ← rewrite eq_sym_eq sym=false goal=18
  ← intro goal=16
    #[20] y - -(sqrt x) = 0
    #[21] sqrt x = y
  → rewrite target=fact real_sub_0 sym=false goal=21 facts=[20]
    #[22] y = -(sqrt x)
  → rewrite target=fact source=prev goal=21 facts=[22,6]
    #[23] real_sgn (-(sqrt x)) = real_sgn (sqrt x)
  → rewrite target=fact real_sgn_neg sym=false goal=21 facts=[23]
    #[24] -(real_sgn (sqrt x)) = real_sgn (sqrt x)
  cut "∀x::real. -x = x ⟷ x = 0" goal=21
    #[25] ∀x::real. -x = x ⟷ x = 0
  ← z3 goal=25
    #[26] ∀x::real. -x = x ⟷ x = 0
  → rewrite target=fact source=prev goal=21 facts=[26,24]
    #[27] real_sgn (sqrt x) = 0
  → rewrite target=fact real_sgn_eq_0 sym=false goal=21 facts=[27]
    #[28] sqrt x = 0
  → rewrite target=fact source=prev goal=21 facts=[28,22]
    #[29] y = -0
  ← rewrite source=prev goal=21 facts=[28]
    #[30] 0 = y
  → rewrite target=fact real_neg_0 sym=false goal=30 facts=[29]
    #[31] y = 0
  ← rewrite eq_sym_eq sym=false goal=30
qed

theorem sqrt_neg
  fixes x :: real
  prop sqrt (-x) = -(sqrt x)
  [hint_rewrite]
proof
  ← rule sqrt_unique_gen goal=0
    #[1] real_sgn (-(sqrt x)) = real_sgn (-x)
    #[2] -(sqrt x) ^ (2::nat) = abs (-x)
  ← rewrite real_sgn_neg sym=false goal=1
    #[3] -(real_sgn (sqrt x)) = -(real_sgn x)
  ← rewrite real_sgn_sqrt sym=false goal=3
  ← rewrite real_pow_neg sym=false goal=2
    #[4] (if even 2 then sqrt x ^ (2::nat) else -(sqrt x ^ (2::nat))) = abs (-x)
  ← rewrite real_abs_neg sym=false goal=4
    #[5] (if even 2 then sqrt x ^ (2::nat) else -(sqrt x ^ (2::nat))) = abs x
  cut "even 2" goal=5
    #[6] even 2
  cut "2 = 2 * (1::nat)" goal=6
    #[7] (2::nat) = 2 * 1
  ← rewrite mult_1_right sym=false goal=7
  ← rewrite source=prev goal=6 facts=[7]
    #[8] even (2 * 1)
  ← rule even_double goal=8
  ← rewrite if_P sym=false goal=5 facts=[6]
    #[9] sqrt x ^ (2::nat) = abs x
  ← rewrite sqrt_works_gen_2 sym=false goal=9
qed

theorem sqrt_pos_le
  fixes x :: real
  prop 0 <= x --> 0 <= sqrt x
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] 0 ≤ sqrt x
  → forward real_sgn_sqrt param_x=x goal=2
    #[3] real_sgn (sqrt x) = real_sgn x
  → rewrite target=fact real_sgn_def sym=false goal=2 facts=[3]
    #[4] (if 0 < sqrt x then (1::real) else if sqrt x < 0 then -1 else 0) = (if 0 < x then 1 else if x < 0 then -1 else 0)
  → rewrite target=fact real_le_lt sym=false goal=2 facts=[1]
    #[5] 0 < x ∨ 0 = x
  ← rule disjE goal=2 facts=[5]
    #[6] 0 < x ⟶ 0 ≤ sqrt x
    #[7] 0 = x ⟶ 0 ≤ sqrt x
  ← intro goal=6
    #[8] 0 < x
    #[9] 0 ≤ sqrt x
  → rewrite target=fact if_P sym=false goal=9 facts=[4,8]
    #[10] (if 0 < sqrt x then (1::real) else if sqrt x < 0 then -1 else 0) = 1
  ← rule contrapositive goal=9 facts=[10]
    #[11] ¬(0 ≤ sqrt x) ⟶ ¬((if 0 < sqrt x then (1::real) else if sqrt x < 0 then -1 else 0) = 1)
  ← intro goal=11
    #[12] ¬(0 ≤ sqrt x)
    #[13] ¬((if 0 < sqrt x then (1::real) else if sqrt x < 0 then -1 else 0) = 1)
  → rewrite target=fact real_not_lt sym=true goal=13 facts=[12]
    #[14] ¬¬(sqrt x < 0)
  → rewrite target=fact double_neg sym=false goal=13 facts=[14]
    #[15] sqrt x < 0
  ← rewrite if_P sym=false goal=13 facts=[15]
    #[16] ¬((if 0 < sqrt x then (1::real) else -1) = 1)
  cut "!x::real. x < 0 --> ~(0 < x)" goal=16
    #[17] ∀x::real. x < 0 ⟶ ¬(0 < x)
  ← z3 goal=17
    #[18] ∀x::real. x < 0 ⟶ ¬(0 < x)
  → forward goal=16 facts=[18,15]
    #[19] ¬(0 < sqrt x)
  ← rewrite if_not_P sym=false goal=16 facts=[19]
    #[20] ¬(-(1::real) = 1)
  ← z3 goal=20
    #[21] ¬(-(1::real) = 1)
  ← intro goal=7
    #[22] 0 = x
    #[23] 0 ≤ sqrt x
  → rewrite target=fact eq_sym_eq sym=false goal=23 facts=[22]
    #[24] x = 0
  ← rewrite source=prev goal=23 facts=[24]
    #[25] 0 ≤ sqrt 0
  ← rewrite sqrt_0 sym=false goal=25
    #[26] (0::real) ≤ 0
  ← rule real_le_refl goal=26
    #[27] (0::real) ≤ 0
qed

theorem sqrt_pow_2
  fixes x :: real
  prop 0 <= x --> sqrt x ^ (2::nat) = x
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] sqrt x ^ (2::nat) = x
  → forward sqrt_works_gen_2 param_x=x goal=2
    #[3] sqrt x ^ (2::nat) = abs x
  ← rewrite source=prev goal=2 facts=[3]
    #[4] abs x = x
  ← z3 goal=4 facts=[1]
qed

theorem real_pos_eq_square
  fixes x :: real
  prop 0 <= x --> (?y. y ^ (2::nat) = x)
  [hint_backward,hint_forward]
proof
  ← intro goal=0
    #[1] 0 ≤ x
    #[2] ∃y. y ^ (2::nat) = x
  ← inst "sqrt x" goal=2
    #[3] sqrt x ^ (2::nat) = x
  ← rule sqrt_pow_2 goal=3 facts=[1]
qed

theorem sqrt_pow2
  fixes x :: real
  prop sqrt x ^ (2::nat) = x <--> 0 <= x
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] sqrt x ^ (2::nat) = x ⟶ 0 ≤ x
    #[2] 0 ≤ x ⟶ sqrt x ^ (2::nat) = x
  ← intro goal=1
    #[3] sqrt x ^ (2::nat) = x
    #[4] 0 ≤ x
  → rewrite target=fact real_pow_2 sym=false goal=4 facts=[3]
    #[5] sqrt x * sqrt x = x
  → rewrite target=fact eq_sym_eq sym=false goal=4 facts=[5]
    #[6] x = sqrt x * sqrt x
  ← rewrite source=prev goal=4 facts=[6]
    #[7] 0 ≤ sqrt x * sqrt x
  ← rule real_le_square goal=7
    #[8] 0 ≤ sqrt x * sqrt x
  ← intro goal=2
    #[9] 0 ≤ x
    #[10] sqrt x ^ (2::nat) = x
  ← rule sqrt_pow_2 goal=10 facts=[9]
qed

theorem sqrt_mul
  fixes x :: real, y :: real
  prop sqrt (x * y) = sqrt x * sqrt y
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rule sqrt_unique_gen goal=0
    #[1] real_sgn (sqrt x * sqrt y) = real_sgn (x * y)
    #[2] (sqrt x * sqrt y) ^ (2::nat) = abs (x * y)
  ← rewrite real_sgn_mul sym=false goal=1
    #[3] real_sgn (sqrt x) * real_sgn (sqrt y) = real_sgn x * real_sgn y
  ← rewrite real_sgn_sqrt sym=false goal=3
  ← rewrite real_pow_mul sym=false goal=2
    #[4] sqrt x ^ (2::nat) * sqrt y ^ (2::nat) = abs (x * y)
  ← rewrite sqrt_works_gen_2 sym=false goal=4
    #[5] abs x * abs y = abs (x * y)
  ← rewrite real_abs_mul sym=false goal=5
qed

theorem sqrt_inv
  fixes x :: real
  prop sqrt (real_inverse x) = real_inverse (sqrt x)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rule sqrt_unique_gen goal=0
    #[1] real_sgn (real_inverse (sqrt x)) = real_sgn (real_inverse x)
    #[2] real_inverse (sqrt x) ^ (2::nat) = abs (real_inverse x)
  ← rewrite real_sgn_inv sym=false goal=1
    #[3] real_sgn (sqrt x) = real_sgn x
  ← rewrite real_sgn_sqrt sym=false goal=3
  ← rewrite real_pow_inv sym=false goal=2
    #[4] real_inverse (sqrt x ^ (2::nat)) = abs (real_inverse x)
  ← rewrite real_abs_inv sym=false goal=4
    #[5] real_inverse (sqrt x ^ (2::nat)) = real_inverse (abs x)
  ← rewrite sqrt_works_gen_2 sym=false goal=5
qed

theorem sqrt_div
  fixes x :: real, y :: real
  prop sqrt (x / y) = sqrt x / sqrt y
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite real_divide_def sym=false goal=0
    #[1] sqrt (x * real_inverse y) = sqrt x * real_inverse (sqrt y)
  ← rewrite sqrt_mul sym=false goal=1
    #[2] sqrt x * sqrt (real_inverse y) = sqrt x * real_inverse (sqrt y)
  ← rewrite sqrt_inv sym=false goal=2
qed

theorem sqrt_lt_0
  fixes x :: real
  prop 0 < sqrt x <--> 0 < x
  [hint_rewrite]
proof
  ← rewrite real_sgn_eq_1 sym=true goal=0
    #[1] real_sgn (sqrt x) = 1 ⟷ real_sgn x = 1
  ← rewrite real_sgn_sqrt sym=false goal=1
qed

theorem sqrt_eq_0
  fixes x :: real
  prop sqrt x = 0 <--> x = 0
  [hint_rewrite]
proof
  ← rewrite real_sgn_eq_0 sym=true goal=0
    #[1] real_sgn (sqrt x) = 0 ⟷ real_sgn x = 0
  ← rewrite real_sgn_sqrt sym=false goal=1
qed

theorem sqrt_le_0
  fixes x :: real
  prop 0 <= sqrt x <--> 0 <= x
  [hint_rewrite]
proof
  ← rewrite real_le_lt sym=false goal=0
    #[1] 0 < sqrt x ∨ 0 = sqrt x ⟷ 0 < x ∨ 0 = x
  ← rewrite sqrt_lt_0 sym=false goal=1
    #[2] 0 < x ∨ 0 = sqrt x ⟷ 0 < x ∨ 0 = x
  ← rule iffI goal=2
    #[3] 0 < x ∨ 0 = sqrt x ⟶ 0 < x ∨ 0 = x
    #[4] 0 < x ∨ 0 = x ⟶ 0 < x ∨ 0 = sqrt x
  ← intro goal=3
    #[5] 0 < x ∨ 0 = sqrt x
    #[6] 0 < x ∨ 0 = x
  ← rule disjE goal=6 facts=[5]
    #[7] 0 < x ⟶ 0 < x ∨ 0 = x
    #[8] 0 = sqrt x ⟶ 0 < x ∨ 0 = x
  ← intro goal=7
    #[9] 0 < x
    #[10] 0 < x ∨ 0 = x
  ← rule disjI1 goal=10
  ← intro goal=8
    #[11] 0 = sqrt x
    #[12] 0 < x ∨ 0 = x
  ← rule disjI2 goal=12
    #[13] 0 = x
  ← rewrite eq_sym_eq sym=false goal=13
    #[14] x = 0
  → rewrite target=fact eq_sym_eq sym=false goal=14 facts=[11]
    #[15] sqrt x = 0
  → rewrite target=fact sqrt_eq_0 sym=false goal=14 facts=[15]
    #[16] x = 0
  ← intro goal=4
    #[17] 0 < x ∨ 0 = x
    #[18] 0 < x ∨ 0 = sqrt x
  ← rule disjE goal=18 facts=[17]
    #[19] 0 < x ⟶ 0 < x ∨ 0 = sqrt x
    #[20] 0 = x ⟶ 0 < x ∨ 0 = sqrt x
  ← intro goal=19
    #[21] 0 < x ∨ 0 = sqrt x
  ← rule disjI1 goal=21
  ← intro goal=20
    #[22] 0 = x
    #[23] 0 < x ∨ 0 = sqrt x
  ← rule disjI2 goal=23
    #[24] 0 = sqrt x
  → rewrite target=fact eq_sym_eq sym=false goal=24 facts=[22]
    #[25] x = 0
  ← rewrite source=prev goal=24 facts=[25]
    #[26] 0 = sqrt 0
  ← rewrite sqrt_0 sym=false goal=26
    #[27] 0 = sqrt 0
qed

theorem real_abs_sqrt
  fixes x :: real
  prop abs (sqrt x) = sqrt (abs x)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite abs_def sym=false goal=0
    #[1] (if 0 ≤ sqrt x then sqrt x else -(sqrt x)) = sqrt (if 0 ≤ x then x else -x)
  ← rewrite sqrt_le_0 sym=false goal=1
    #[2] (if 0 ≤ x then sqrt x else -(sqrt x)) = sqrt (if 0 ≤ x then x else -x)
  ← cases "0 ≤ x" goal=2
    #[3] 0 ≤ x ⟶ (if 0 ≤ x then sqrt x else -(sqrt x)) = sqrt (if 0 ≤ x then x else -x)
    #[4] ¬(0 ≤ x) ⟶ (if 0 ≤ x then sqrt x else -(sqrt x)) = sqrt (if 0 ≤ x then x else -x)
  ← intro goal=3
    #[5] 0 ≤ x
    #[6] (if 0 ≤ x then sqrt x else -(sqrt x)) = sqrt (if 0 ≤ x then x else -x)
  ← rewrite if_P sym=false goal=6 facts=[5]
  ← intro goal=4
    #[7] ¬(0 ≤ x)
    #[8] (if 0 ≤ x then sqrt x else -(sqrt x)) = sqrt (if 0 ≤ x then x else -x)
  ← rewrite if_not_P sym=false goal=8 facts=[7]
    #[9] -(sqrt x) = sqrt (-x)
  ← rewrite sqrt_neg sym=false goal=9
    #[10] -(sqrt x) = sqrt (-x)
qed

theorem sqrt_mono_lt
  fixes x :: real, y :: real
  prop x < y --> sqrt x < sqrt y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x < y
    #[2] sqrt x < sqrt y
  cut "∀x. ∀y. 0 <= x --> x < y ⟶ sqrt x < sqrt y" goal=2
    #[3] ∀x. ∀y. 0 ≤ x ⟶ x < y ⟶ sqrt x < sqrt y
  ← intro a,b goal=3
    #[4] _VAR a
    #[5] _VAR b
    #[6] 0 ≤ a
    #[7] a < b
    #[8] sqrt a < sqrt b
  ← rule real_pow_lt2_rev param_n="(2::nat)" goal=8
    #[9] 0 ≤ sqrt b
    #[10] sqrt a ^ (2::nat) < sqrt b ^ (2::nat)
  ← rule sqrt_pos_le goal=9
    #[11] 0 ≤ b
  → forward real_let_trans goal=11 facts=[6,7]
    #[12] 0 < b
  ← rule real_lt_imp_le goal=11 facts=[12]
    #[13] 0 ≤ b
  ← rewrite sqrt_works_gen_2 sym=false goal=10
    #[14] abs a < abs b
  ← z3 goal=14 facts=[7,6]
    #[15] abs a < abs b
  ← cases "0 ≤ x" goal=2
    #[16] 0 ≤ x ⟶ sqrt x < sqrt y
    #[17] ¬(0 ≤ x) ⟶ sqrt x < sqrt y
  ← intro goal=16
    #[18] 0 ≤ x
    #[19] sqrt x < sqrt y
  ← apply_prev goal=19 facts=[3,18,1]
  ← intro goal=17
    #[20] ¬(0 ≤ x)
    #[21] sqrt x < sqrt y
  ← cases "0 ≤ y" goal=21
    #[22] 0 ≤ y ⟶ sqrt x < sqrt y
    #[23] ¬(0 ≤ y) ⟶ sqrt x < sqrt y
  ← intro goal=22
    #[24] 0 ≤ y
    #[25] sqrt x < sqrt y
  ← rule real_lte_trans param_y="(0::real)" goal=25
    #[26] sqrt x < 0
    #[27] 0 ≤ sqrt y
  ← rewrite real_less_def sym=false goal=26
    #[28] ¬(0 ≤ sqrt x)
  ← rewrite sqrt_le_0 sym=false goal=28
  ← rewrite sqrt_le_0 sym=false goal=27
  ← intro goal=23
    #[29] ¬(0 ≤ y)
    #[30] sqrt x < sqrt y
  → inst target=fact -y goal=30 facts=[3]
    #[31] ∀y1. 0 ≤ -y ⟶ -y < y1 ⟶ sqrt (-y) < sqrt y1
  → inst target=fact -x goal=30 facts=[31]
    #[32] 0 ≤ -y ⟶ -y < -x ⟶ sqrt (-y) < sqrt (-x)
  → rewrite target=fact sqrt_neg sym=false goal=30 facts=[32]
    #[33] 0 ≤ -y ⟶ -y < -x ⟶ -(sqrt y) < -(sqrt x)
  cut "!x::real. !y. -y < -x <--> x < y" goal=30
    #[34] ∀x::real. ∀y. -y < -x ⟷ x < y
  ← z3 goal=34
    #[35] ∀x::real. ∀y. -y < -x ⟷ x < y
  → rewrite target=fact source=prev goal=30 facts=[35,33]
    #[36] 0 ≤ -y ⟶ x < y ⟶ sqrt x < sqrt y
  ← apply_prev goal=30 facts=[36]
    #[37] 0 ≤ -y
  ← z3 goal=37 facts=[29]
    #[38] 0 ≤ -y
qed

theorem sqrt_mono_le
  fixes x :: real, y :: real
  prop x <= y --> sqrt x <= sqrt y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x ≤ y
    #[2] sqrt x ≤ sqrt y
  ← rewrite real_le_lt sym=false goal=2
    #[3] sqrt x < sqrt y ∨ sqrt x = sqrt y
  → rewrite target=fact real_le_lt sym=false goal=3 facts=[1]
    #[4] x < y ∨ x = y
  ← rule disjE goal=3 facts=[4]
    #[5] x < y ⟶ sqrt x < sqrt y ∨ sqrt x = sqrt y
    #[6] x = y ⟶ sqrt x < sqrt y ∨ sqrt x = sqrt y
  ← intro goal=5
    #[7] x < y
    #[8] sqrt x < sqrt y ∨ sqrt x = sqrt y
  ← rule disjI1 goal=8
    #[9] sqrt x < sqrt y
  ← rule sqrt_mono_lt goal=9 facts=[7]
    #[10] sqrt x < sqrt y
  ← intro goal=6
    #[11] x = y
    #[12] sqrt x < sqrt y ∨ sqrt x = sqrt y
  ← rule disjI2 goal=12
    #[13] sqrt x = sqrt y
  ← rewrite source=prev goal=13 facts=[11]
    #[14] sqrt x = sqrt y
qed

theorem sqrt_mono_lt_eq
  fixes x :: real, y :: real
  prop sqrt x < sqrt y <--> x < y
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] sqrt x < sqrt y ⟶ x < y
    #[2] x < y ⟶ sqrt x < sqrt y
  ← intro goal=1
    #[3] sqrt x < sqrt y
    #[4] x < y
  ← rewrite real_less_def sym=false goal=4
    #[5] ¬(y ≤ x)
  → rewrite target=fact real_less_def sym=false goal=5 facts=[3]
    #[6] ¬(sqrt y ≤ sqrt x)
  ← rule contrapositive goal=5 facts=[6]
    #[7] ¬¬(y ≤ x) ⟶ ¬¬(sqrt y ≤ sqrt x)
  ← intro goal=7
    #[8] ¬¬(y ≤ x)
    #[9] ¬¬(sqrt y ≤ sqrt x)
  ← rewrite double_neg sym=false goal=9
    #[10] sqrt y ≤ sqrt x
  → rewrite target=fact double_neg sym=false goal=10 facts=[8]
    #[11] y ≤ x
  ← rule sqrt_mono_le goal=10 facts=[11]
    #[12] sqrt y ≤ sqrt x
  ← intro goal=2
    #[13] x < y
    #[14] sqrt x < sqrt y
  ← rule sqrt_mono_lt goal=14 facts=[13]
qed

theorem sqrt_mono_le_eq
  fixes x :: real, y :: real
  prop sqrt x <= sqrt y <--> x <= y
  [hint_rewrite]
proof
  ← rewrite real_not_lt sym=true goal=0
    #[1] ¬(sqrt y < sqrt x) ⟷ ¬(y < x)
  ← rewrite sqrt_mono_lt_eq sym=false goal=1
qed

theorem sqrt_inj
  fixes x :: real, y :: real
  prop sqrt x = sqrt y <--> x = y
  [hint_rewrite]
proof
  ← rewrite real_le_antisym sym=true goal=0
    #[1] sqrt x ≤ sqrt y ∧ sqrt y ≤ sqrt x ⟷ x ≤ y ∧ y ≤ x
  ← rewrite sqrt_mono_le_eq sym=false goal=1
qed

theorem sqrt_eq_1
  fixes x :: real
  prop sqrt x = 1 <--> x = 1
  [hint_rewrite]
proof
  ← rule iffI goal=0
    #[1] sqrt x = 1 ⟶ x = 1
    #[2] x = 1 ⟶ sqrt x = 1
  ← intro goal=1
    #[3] sqrt x = 1
    #[4] x = 1
  ← rewrite sqrt_inj sym=true goal=4
    #[5] sqrt x = sqrt 1
  ← rewrite sqrt_1 sym=false goal=5
  ← intro goal=2
    #[6] x = 1
    #[7] sqrt x = 1
  ← rewrite source=prev goal=7 facts=[6]
    #[8] sqrt 1 = 1
  ← rewrite sqrt_1 sym=false goal=8
    #[9] sqrt 1 = 1
qed

theorem sqrt_pos_lt
  fixes x :: real
  prop 0 < x --> 0 < sqrt x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] 0 < sqrt x
  ← rewrite real_lt_le sym=false goal=2
    #[3] 0 ≤ sqrt x ∧ ¬(0 = sqrt x)
  ← rule conjI goal=3
    #[4] 0 ≤ sqrt x
    #[5] ¬(0 = sqrt x)
  ← rule sqrt_pos_le goal=4
    #[6] 0 ≤ x
  ← rule real_lt_imp_le goal=6
  ← rewrite eq_sym_eq sym=false goal=5
    #[7] ¬(sqrt x = 0)
  ← rewrite sqrt_eq_0 sym=false goal=7
    #[8] ¬(x = 0)
  ← z3 goal=8 facts=[1]
qed

theorem real_le_lsqrt
  fixes x :: real, y :: real
  prop 0 <= y --> x <= y ^ (2::nat) --> sqrt x <= y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ y
    #[2] x ≤ y ^ (2::nat)
    #[3] sqrt x ≤ y
  → forward sqrt_mono_le goal=3 facts=[2]
    #[4] sqrt x ≤ sqrt (y ^ (2::nat))
  → forward pow_2_sqrt goal=3 facts=[1]
    #[5] sqrt (y ^ (2::nat)) = y
  → rewrite target=fact source=prev goal=3 facts=[5,4]
qed

theorem real_le_rsqrt
  fixes x :: real, y :: real
  prop x ^ (2::nat) <= y --> x <= sqrt y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x ^ (2::nat) ≤ y
    #[2] x ≤ sqrt y
  → forward sqrt_mono_le goal=2 facts=[1]
    #[3] sqrt (x ^ (2::nat)) ≤ sqrt y
  cut "!a::real. !b. abs a <= b --> a <= b" goal=2
    #[4] ∀a::real. ∀b. abs a ≤ b ⟶ a ≤ b
  ← z3 goal=4
    #[5] ∀a::real. ∀b. abs a ≤ b ⟶ a ≤ b
  ← apply_prev goal=2 facts=[5]
    #[6] abs x ≤ sqrt y
  → rewrite target=fact pow_2_sqrt_abs sym=false goal=6 facts=[3]
qed

theorem real_lt_lsqrt
  fixes x :: real, y :: real
  prop 0 <= y --> x < y ^ (2::nat) --> sqrt x < y
  [hint_backward,hint_backward1]
proof
  ← intro goal=0
    #[1] 0 ≤ y
    #[2] x < y ^ (2::nat)
    #[3] sqrt x < y
  → forward sqrt_mono_lt goal=3 facts=[2]
    #[4] sqrt x < sqrt (y ^ (2::nat))
  → forward pow_2_sqrt goal=3 facts=[1]
    #[5] sqrt (y ^ (2::nat)) = y
  → rewrite target=fact source=prev goal=3 facts=[5,4]
qed

theorem real_lt_rsqrt
  fixes x :: real, y :: real
  prop x ^ (2::nat) < y --> x < sqrt y
  [hint_backward]
proof
  ← intro goal=0
    #[1] x ^ (2::nat) < y
    #[2] x < sqrt y
  → forward sqrt_mono_lt goal=2 facts=[1]
    #[3] sqrt (x ^ (2::nat)) < sqrt y
  cut "!x::real. !a. abs x < a --> x < a" goal=2
    #[4] ∀x::real. ∀a. abs x < a ⟶ x < a
  ← z3 goal=4
    #[5] ∀x::real. ∀a. abs x < a ⟶ x < a
  ← apply_prev goal=2 facts=[5]
    #[6] abs x < sqrt y
  → rewrite target=fact pow_2_sqrt_abs sym=false goal=6 facts=[3]
qed

