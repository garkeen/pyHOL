theory mutual_example
imports either
description "A mutual block: the group is encoded into one function over the sum of the argument tuples, and each function gets its equations and the mutual induction rule back."

-- `fun ... and ...`: the two functions are defined together.  What
-- justifies the recursion is the sum encoding -- one function over
-- `(nat, nat) either`, whose descent is measured, not structural: a call
-- that crosses the group is not a subterm of anything.

fun even2 :: nat ⇒ bool
  | even2 0 = true
  | even2 (Suc n) = odd2 n
and odd2 :: nat ⇒ bool
  | odd2 0 = false
  | odd2 (Suc n) = even2 n

-- The mutual induction rule, used once: every number is even or odd, and
-- neither proof stands alone -- each side's step needs the other side's
-- predicate, which is exactly what the rule's shared premises are for.

theorem even2_or_odd2
  prop (!n::nat. even2 n ∨ odd2 n)
proof
  ← rule even2_induct param_P1="(%n. even2 n ∨ odd2 n)" param_P2="(%n. odd2 n ∨ even2 n)" goal=0
    #[1] even2 0 | odd2 0
    #[2] !n. odd2 n | even2 n --> even2 (Suc n) | odd2 (Suc n)
    #[3] odd2 0 | even2 0
    #[4] !n. even2 n | odd2 n --> odd2 (Suc n) | even2 (Suc n)
  ← rule disjI1 goal=1
    #[5] even2 0
  ← rewrite even2_def_1 goal=5
    #[6] true
  ← rule trueI goal=6
  ← intro n goal=2
    #[7] _VAR n
    #[8] odd2 n | even2 n
    #[9] even2 (Suc n) | odd2 (Suc n)
  ← rule disjE goal=9 facts=[8]
    #[10] odd2 n --> even2 (Suc n) | odd2 (Suc n)
    #[11] even2 n --> even2 (Suc n) | odd2 (Suc n)
  ← intro goal=10
    #[12] odd2 n
    #[13] even2 (Suc n) | odd2 (Suc n)
  ← rewrite even2_def_2 goal=13
    #[14] odd2 n | odd2 (Suc n)
  ← rule disjI1 goal=14
  ← intro goal=11
    #[15] even2 n
    #[16] even2 (Suc n) | odd2 (Suc n)
  ← rewrite odd2_def_2 goal=16
    #[17] even2 (Suc n) | even2 n
  ← rule disjI2 goal=17
  ← rule disjI2 goal=3
  ← intro n goal=4
    #[18] even2 n | odd2 n
    #[19] odd2 (Suc n) | even2 (Suc n)
  ← rule disjE goal=19 facts=[18]
    #[20] even2 n --> odd2 (Suc n) | even2 (Suc n)
    #[21] odd2 n --> odd2 (Suc n) | even2 (Suc n)
  ← intro goal=20
    #[22] odd2 (Suc n) | even2 (Suc n)
  ← rewrite odd2_def_2 goal=22
    #[23] even2 n | even2 (Suc n)
  ← rule disjI1 goal=23
  ← intro goal=21
    #[24] odd2 (Suc n) | even2 (Suc n)
  ← rewrite even2_def_2 goal=24
    #[25] odd2 (Suc n) | odd2 n
  ← rule disjI2 goal=25
qed
