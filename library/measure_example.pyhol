theory measure_example
imports nat, wf
description "Samples for the measure engine (fun's relation inference): self-written definitions whose decrease is a measure, not the datatype's subterm relation."

-- The four nat comparisons the measure engine closes its cells with,
-- and the mlex rules themselves, now live in nat: every file that can
-- see nat can see them, so `fun` uses the measure relation wherever it
-- applies.  This file only keeps the samples.

header "Samples"

-- The measure is the argument itself: the call is on the predecessor.

fun wfgen :: nat ⇒ nat ⇒ nat
  | wfgen 0 n = n
  | wfgen (Suc m) n = Suc (wfgen m n)

-- Not structural: the call is two constructors down, so the subterm
-- relation does not apply and the measure has to cover the gap.  The cell
-- is `n <= Suc n` after the peel (`less_Suc_lesseq` then `le_suc_right`).

fun dbl :: nat ⇒ nat
  | dbl 0 = 0
  | dbl (Suc (Suc n)) = Suc (dbl n)

-- A datatype of the file's own: the descent is measured by the generated
-- size function, so the cell is a size comparison.

datatype tri =
  | TriZ :: tri
  | TriS (t :: tri) :: tri

fun tsum :: tri ⇒ nat
  | tsum TriZ = 0
  | tsum (TriS t) = Suc (tsum t)

-- Two columns: the first equation decreases the first argument, the
-- third keeps it (only `<=` there) and decreases the second, so no single
-- measure works and the relation is a two-column `mlex_prod` chain.

fun lexnat :: nat ⇒ nat ⇒ nat
  | lexnat 0 n = n
  | lexnat (Suc m) 0 = lexnat m 0
  | lexnat (Suc m) (Suc n) = lexnat (Suc m) n

-- A constructor that recurses more than once.  Isabelle's datatype
-- package gives `T3S` the size `1 + size x + size y + size z`, and that
-- size is what definitions over the datatype descend through -- the
-- subterm relation is never consulted for them.  The size function's own
-- recursion is the one that is: its relation is the datatype's subterm
-- relation, a disjunction over the recursive arguments, so its first call
-- reaches its disjunct with `disjI1` and each later one with a `disjI2`
-- per level of the right-nested chain.

datatype tri3 =
  | T3Z :: tri3
  | T3S (x :: tri3) (y :: tri3) (z :: tri3) :: tri3

-- The measure is that size, so the two calls of the second equation are
-- discharged by a strict size comparison.

fun t3count :: tri3 ⇒ nat
  | t3count T3Z = 0
  | t3count (T3S x y z) = Suc (t3count x + t3count y)

-- The recursive call is two constructors down: `n` is not a direct
-- argument of the pattern `Suc (Suc n)`, so the structural check that
-- guards the axiomatized path refuses this definition -- and without a
-- clause that check is what decides, before any inference runs.  With a
-- measure the descent is *proved* rather than assumed: the obligation is
-- `n < Suc (Suc n)`, which the emitter closes like any other cell.

fun drop2 :: nat ⇒ nat
  measure "%p. p"
  | drop2 0 = 0
  | drop2 (Suc (Suc n)) = drop2 n


-- A relation of the file's own, with its own well-foundedness and its own
-- descent lemmas: the general case.  The emitter knows the *shape* of the
-- obligation -- the relation applied to the call and to the pattern -- but
-- nothing about the relation, so the file states both and the definition
-- is proved from them.  The relation is written over the two *tupled*
-- arguments (`p` and `q`), because that is the relation the recursion
-- combinator uses, and the descent lemmas state exactly the obligation it
-- produces.

theorem ex_less_wf
  prop wf (%p::nat. %q::nat. p < q)
proof
  ← rewrite measure_def sym=true goal=0
  ← rule wf_measure goal=1
qed

theorem ex_drop_dec
  fixes n :: nat
  prop n < Suc (Suc n)
proof
  ← rewrite less_Suc_lesseq goal=0
  ← rule le_suc_right goal=1
  ← rule lesseq_refl goal=2
qed

fun exdrop :: nat ⇒ nat
  relation "%p q. p < q"
  wf "ex_less_wf"
  descent "ex_drop_dec"
  | exdrop 0 = 0
  | exdrop (Suc (Suc n)) = exdrop n

header "Arithmetic measures"

-- The measure is a literal coefficient of the argument.  The cell is a
-- comparison of two products, which the engine distributes and then
-- compares additively: `3 * n` is `n + n + n`, and `3 * Suc n` is three
-- successors over that same sum, so the descent is strict.  Nothing
-- about multiplication is needed at the comparison itself.

fun qdbl :: nat ⇒ nat
  measure "%p. 3 * p"
  | qdbl 0 = 0
  | qdbl (Suc n) = qdbl n

-- The measure is the sum of the two arguments and the call swaps them.
-- The two sides only meet because the sums are sorted first: the call's
-- measure `n + m` becomes `m + n`, which is the pattern's measure with
-- one `Suc` over it.

fun swapdec :: nat ⇒ nat ⇒ nat
  measure "%m n. m + n"
  | swapdec 0 n = n
  | swapdec (Suc m) n = swapdec n m
