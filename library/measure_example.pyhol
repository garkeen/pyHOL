theory measure_example
imports nat, wf
description "Samples for the measure engine (fun's relation inference): self-written definitions whose decrease is a measure, not the datatype's subterm relation."

-- The four nat comparisons the measure engine closes its cells with,
-- and the mlex rules themselves, now live in nat: every file that can
-- see nat can see them, so `fun` uses the measure relation wherever it
-- applies.  This file only keeps the samples.

header "Samples"

-- The measure is the argument itself: the call is on the predecessor.

fun wfgen :: nat ⇒ nat ⇒ nat
  | wfgen 0 n = n
  | wfgen (Suc m) n = Suc (wfgen m n)

-- The bare "two constructors down" sample (dbl with the pattern
-- `Suc (Suc n)`) is left out on purpose: its cell (`n < Suc (Suc n)`, the
-- two-`Suc` peel) is covered by core/tests/measure_test.py, but the item
-- cannot be replayed yet -- the branch negation of a *nested* pattern
-- instantiates the distinctness axiom with the pattern's variables, not
-- with the pattern's argument terms, so `if_not_P` never fires.  That is
-- the emitter's nested-pattern gap, not the measure engine's.

-- A datatype of the file's own: the descent is measured by the generated
-- size function, so the cell is a size comparison.

datatype tri =
  | TriZ :: tri
  | TriS (t :: tri) :: tri

fun tsum :: tri ⇒ nat
  | tsum TriZ = 0
  | tsum (TriS t) = Suc (tsum t)
