theory mem
imports nat, function
description "Heap memory model: null, linked list (ll) and reachability (reached) predicates over the heap function h :: nat => nat"

header "Basic definitions"

def null :: nat = null = 0 [hint_rewrite]

inductive ll :: nat ⇒ (nat ⇒ nat) ⇒ bool
  | ll_null: ll null s
  | ll_step: ¬(p = null) ⟶ ll (s p) s ⟶ ll p s

inductive reached :: (nat ⇒ nat) ⇒ nat ⇒ nat ⇒ bool
  | r_self: reached s x x
  | r_step: ¬(x = null) ⟶ reached s (s x) y ⟶ reached s x y

header "Properties of ll"

theorem ll_fwd
  fixes p :: nat, s :: nat ⇒ nat
  prop ∀x. ∀s. ll x s ⟶ (x = null ∨ (¬(x = null) ∧ ll (s x) s))
  proof
    0: apply_backward_step ll_induct
    0: introduction s
    0.1: apply_backward_step disjI1
    0.1: reflexive
    1: introduction p,s
    1.5: apply_backward_step disjI2
    1.5: apply_backward_step conjI
    1.5: apply_prev @1.2
    1.6: apply_prev @1.3
  qed

theorem reached_self_neq
  fixes p :: nat, q :: nat, s :: nat ⇒ nat
  prop ¬(reached s p q) ⟶ ¬(p = q)
  proof
    1: apply_backward_step negI
    1: introduction
    1.1: cut "reached s p q"
    1.1: rewrite_goal_with_prev @1.0
    1.1: apply_backward_step r_self
    1.3: apply_forward_step negE @0,1.2
  qed

theorem reached_next_neq
  fixes p :: nat, q :: nat, s :: nat ⇒ nat
  prop ¬(p = null) ⟶ ¬(reached s p q) ⟶ ¬(reached s (s p) q)
  proof
    2: apply_backward_step negI
    2: introduction
    2.1: apply_forward_step r_step @0,2.0
    2.2: apply_forward_step negE @1,2.1
  qed

theorem ll_update_unreached
  fixes q :: nat, v :: nat
  prop ∀x. ∀s. ll x s ⟶ ¬(reached s x q) ⟶ ll x ((s)(q := v))
  proof
    0: apply_backward_step ll_induct
    0: introduction s
    0.2: apply_backward_step ll_null
    1: introduction p,s
    1.6: apply_backward_step ll_step
    1.6: apply_forward_step reached_self_neq @1.5
    1.7: rewrite_goal fun_upd_other @1.6
    1.7: apply_forward_step reached_next_neq @1.2,1.5
    1.8: apply_fact @1.4,1.7
    1.9: apply_prev @1.8
  qed
