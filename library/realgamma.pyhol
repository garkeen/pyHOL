theory realgamma
imports realintegral
description "Real gamma functions and Euler_Mascheroni const. Refer to gamma.ml from HOL light"

def euler_mascheroni :: real = euler_mascheroni = reallim sequentially (λn. sum ({1..n}) (λk. real_inverse (of_nat k)) - log (of_nat n)) [hint_rewrite]

theorem euler_mascheroni
  prop tendsto_real (%n. sum ({1..n}) (%k. real_inverse (of_nat k)) - log (of_nat n)) euler_mascheroni sequentially
  [hint_backward]

def gamma :: real ⇒ real = gamma x = reallim sequentially (λn. of_nat n ^ x * of_nat (fact n) / product ({0..n}) (λm. x + of_nat m)) [hint_rewrite]

theorem gamma
  fixes x :: real
  prop tendsto_real (%n. of_nat n ^ x * of_nat (fact n) / product ({0..n}) (%m. x + of_nat m)) (gamma x) sequentially
  [hint_backward]

theorem gamma_eq_0
  fixes x :: real
  prop gamma x = 0 <--> (?n. x + of_nat n = 0)
  [hint_rewrite]

theorem real_differentiable_at_gamma
  fixes x :: real
  prop (!n. ~(x + of_nat n = 0)) --> real_differentiable gamma (atreal x)
  [hint_backward]

theorem real_differentiable_within_gamma
  fixes s :: real set, x :: real
  prop (!n. ~(x + of_nat n = 0)) --> real_differentiable gamma (within (atreal x) s)
  [hint_backward]
proof
  ← intro goal=0
    #[1] ∀n. ¬(x + of_nat n = 0)
    #[2] real_differentiable gamma (within (atreal x) s)
  ← rule real_differentiable_atreal_within goal=2
    #[3] real_differentiable gamma (atreal x)
  ← rule real_differentiable_at_gamma goal=3
qed

theorem real_differentiable_on_gamma
  fixes s :: real set
  prop s Sub {x. !n. ~(x + of_nat n = 0)} --> real_differentiable_on gamma s
  [hint_backward]
proof
  ← intro goal=0
    #[1] s ⊆ {x. ∀n. ¬(x + of_nat n = 0)}
    #[2] real_differentiable_on gamma s
  ← rewrite real_differentiable_on_differentiable sym=false goal=2
    #[3] ∀x. x ∈ s ⟶ real_differentiable gamma (within (atreal x) s)
  ← intro x goal=3
    #[4] _VAR x
    #[5] x ∈ s
    #[6] real_differentiable gamma (within (atreal x) s)
  → forward subsetE param_x=x goal=6 facts=[1]
    #[7] x ∈ s ⟶ x ∈ {x1. ∀n. ¬(x1 + of_nat n = 0)}
  → rewrite target=fact member_collect sym=false goal=6 facts=[7]
    #[8] x ∈ s ⟶ (∀n. ¬(x + of_nat n = 0))
  ← rule real_differentiable_within_gamma goal=6
    #[9] ∀n. ¬(x + of_nat n = 0)
  ← apply_prev goal=9 facts=[8]
qed

theorem real_continuous_atreal_gamma
  fixes x :: real
  prop (!n. ~(x + of_nat n = 0)) --> real_continuous gamma (atreal x)
  [hint_backward]

theorem real_continuous_within_gamma
  fixes s :: real set, x :: real
  prop (!n. ~(x + of_nat n = 0)) --> real_continuous gamma (within (atreal x) s)
  [hint_backward]
proof
  ← intro goal=0
    #[1] ∀n. ¬(x + of_nat n = 0)
    #[2] real_continuous gamma (within (atreal x) s)
  ← rule real_continuous_atreal_withinreal goal=2
    #[3] real_continuous gamma (atreal x)
  ← rule real_continuous_atreal_gamma goal=3
qed

theorem real_continuous_on_gamma
  fixes s :: real set
  prop s Sub {x. !n. ~(x + of_nat n = 0)} --> real_continuous_on gamma s
  [hint_backward]
proof
  ← intro goal=0
    #[1] s ⊆ {x. ∀n. ¬(x + of_nat n = 0)}
    #[2] real_continuous_on gamma s
  ← rewrite real_continuous_on_eq_continuous_within sym=false goal=2
    #[3] ∀x. x ∈ s ⟶ real_continuous gamma (within (atreal x) s)
  ← intro x goal=3
    #[4] _VAR x
    #[5] x ∈ s
    #[6] real_continuous gamma (within (atreal x) s)
  ← rule real_continuous_within_gamma goal=6
    #[7] ∀n. ¬(x + of_nat n = 0)
  → forward subsetE param_x=x goal=7 facts=[1]
    #[8] x ∈ s ⟶ x ∈ {x1. ∀n. ¬(x1 + of_nat n = 0)}
  → rewrite target=fact member_collect sym=false goal=7 facts=[8]
    #[9] x ∈ s ⟶ (∀n. ¬(x + of_nat n = 0))
  ← apply_prev goal=7 facts=[9]
qed

theorem real_differentiable_atreal_recip_gamma
  fixes x :: real
  prop real_differentiable (real_inverse O gamma) (atreal x)
  [hint_backward]

theorem real_differentiable_within_recip_gamma
  fixes s :: real set, x :: real
  prop real_differentiable (real_inverse O gamma) (within (atreal x) s)
  [hint_backward]
proof
  ← rule real_differentiable_atreal_within goal=0
    #[1] real_differentiable (real_inverse ∘ gamma) (atreal x)
  ← rule real_differentiable_atreal_recip_gamma goal=1
qed

theorem real_differentiable_on_recip_gamma
  fixes s :: real set
  prop real_differentiable_on (real_inverse O gamma) s
  [hint_backward]
proof
  ← rewrite real_differentiable_on_differentiable sym=false goal=0
    #[1] ∀x. x ∈ s ⟶ real_differentiable (real_inverse ∘ gamma) (within (atreal x) s)
  ← intro x goal=1
    #[2] _VAR x
    #[3] x ∈ s
    #[4] real_differentiable (real_inverse ∘ gamma) (within (atreal x) s)
  ← rule real_differentiable_within_recip_gamma goal=4
    #[5] real_differentiable (real_inverse ∘ gamma) (within (atreal x) s)
qed

theorem real_continuous_atreal_recip_gamma:
  fixes x :: real
  prop real_continuous (real_inverse O gamma) (atreal x)
  [hint_backward]
proof
  ← rule real_differentiable_imp_continuous_atreal goal=0
    #[1] real_differentiable (real_inverse ∘ gamma) (atreal x)
  ← rule real_differentiable_atreal_recip_gamma goal=1
qed

theorem real_continuous_withinreal_recip_gamm
  fixes s :: real set, x :: real
  prop real_continuous (real_inverse O gamma) (within (atreal x) s)
  [hint_backward]
proof
  ← rule real_continuous_atreal_withinreal goal=0
    #[1] real_continuous (real_inverse ∘ gamma) (atreal x)
  ← rule real_continuous_atreal_recip_gamma: goal=1
qed

theorem real_continuous_on_recip_gamm
  fixes s :: real set
  prop real_continuous_on (real_inverse O gamma) s
  [hint_backward]
proof
  ← rewrite real_continuous_on_eq_continuous_within sym=false goal=0
    #[1] ∀x. x ∈ s ⟶ real_continuous (real_inverse ∘ gamma) (within (atreal x) s)
  ← intro x goal=1
    #[2] _VAR x
    #[3] x ∈ s
    #[4] real_continuous (real_inverse ∘ gamma) (within (atreal x) s)
  ← rule real_continuous_withinreal_recip_gamm goal=4
    #[5] real_continuous (real_inverse ∘ gamma) (within (atreal x) s)
qed

theorem gamma_recurrence_alt
  fixes x :: real
  prop gamma x = gamma (x + 1) / x
  [hint_rewrite]

theorem gamma_1
  prop gamma 1 = 1
  [hint_rewrite]

theorem gamma_recurrence
  fixes x :: real
  prop gamma (x + 1) = (if x = 0 then 1 else x * gamma x)
  [hint_rewrite]

theorem gamma_fact
  fixes n :: nat
  prop gamma (of_nat (n + 1)) = of_nat (fact n)
  [hint_rewrite]

theorem gamma_poles
  fixes n :: nat
  prop gamma (-(of_nat n)) = 0
  [hint_rewrite]

theorem gamma_simple_poles
  fixes n :: nat
  prop tendsto_real (%x. (x + of_nat n) * gamma x) (-1 ^ n / of_nat (fact n)) (atreal (-(of_nat n)))
  [hint_backward]

theorem gamma_pos_le
  fixes x :: real
  prop 0 <= x --> 0 <= gamma x
  [hint_backward]

theorem gamma_pos_lt
  fixes x :: real
  prop 0 < x --> 0 < gamma x
  [hint_backward]

theorem gamma_legendre_lt
  fixes x :: real
  prop gamma x * gamma (x + 1 / 2) = 2 ^ (1 - 2 * x) * gamma (1 / 2) * gamma (2 * x)
  [hint_rewrite]

theorem gamma_reflection
  fixes x :: real
  prop gamma x * gamma (1 - x) = pi / sin (pi * x)
  [hint_rewrite]

theorem gamma_half
  fixes x :: real
  prop gamma (1 / 2) = sqrt pi
  [hint_rewrite]

theorem gamma_legendre
  fixes x :: real
  prop gamma x * gamma (x + 1 / 2) = 2 ^ (1 - 2 * x) * sqrt pi * gamma (2 * x)
  [hint_rewrite]
proof
  ← rewrite gamma_legendre_lt sym=false goal=0
    #[1] 2 ^ (1 - 2 * x) * gamma (1 / 2) * gamma (2 * x) = 2 ^ (1 - 2 * x) * sqrt pi * gamma (2 * x)
  ← rewrite gamma_half sym=false goal=1
qed

theorem gamma_weierstrass
  fixes x :: real
  prop tendsto_real (%n. exp (-euler_mascheroni * x) / x * product ({1..n}) (%k. exp (x / of_nat k) / (1 + x / of_nat k))) (gamma x) sequentially
  [hint_backward]

theorem real_log_convex_gamma
  fixes s :: real set
  prop (!x. x Mem s --> 0 < x) --> real_log_convex_on gamma s
  [hint_backward]

theorem gamma_real_log_convex_unique
  fixes f :: real => real
  prop f 1 = 1 --> (!x. 0 < x --> f (x + 1) = x * f x) --> (!x. 0 < x --> 0 < f x) --> real_log_convex_on f ({x. 0 < x}) --> (!x. 0 < x --> f x = gamma x)
  [hint_backward,hint_backward1]

theorem euler_has_real_integral_gamma
  fixes x :: real
  prop 0 < x --> has_real_integral (%t. t ^ (x - 1) / exp t) (gamma x) ({t. 0 <= t})
  [hint_backward]

theorem euler_real_integral
  fixes x :: real
  prop 0 < x --> real_integral ({t. 0 <= t}) (%t. t ^ (x - 1) / exp t) = gamma x
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] real_integral ({t. 0 ≤ t}) (λt. t ^ (x - 1) / exp t) = gamma x
  ← rule real_integral_unique goal=2
    #[3] has_real_integral (λt. t ^ (x - 1) / exp t) (gamma x) ({t. 0 ≤ t})
  ← rule euler_has_real_integral_gamma goal=3
qed

theorem euler_real_integrable
  fixes x :: real
  prop 0 < x --> real_integrable_on (%t. t ^ (x - 1) / exp t) ({t. 0 <= t})
  [hint_backward]
proof
  ← intro goal=0
    #[1] 0 < x
    #[2] real_integrable_on (λt. t ^ (x - 1) / exp t) ({t. 0 ≤ t})
  ← rewrite real_integrable_on_def sym=false goal=2
    #[3] ∃y. has_real_integral (λt. t ^ (x - 1) / exp t) y ({t. 0 ≤ t})
  ← inst "gamma x" goal=3
    #[4] has_real_integral (λt. t ^ (x - 1) / exp t) (gamma x) ({t. 0 ≤ t})
  ← rule euler_has_real_integral_gamma goal=4 facts=[1]
qed

theorem euler_original_real_integrable
  fixes x :: real
  prop 0 < x --> real_integrable_on (%t. -(log t) ^ (x - 1)) (real_closed_interval 0 1)
  [hint_backward]

theorem euler_original_has_real_integral_gamma
  fixes x :: real
  prop 0 < x --> has_real_integral (%t. -(log t) ^ (x - 1)) (gamma x) (real_closed_interval 0 1)
  [hint_backward]

theorem euler_original_real_integral
  fixes x :: real
  prop 0 < x --> real_integral (real_closed_interval 0 1) (%t. -(log t) ^ (x - 1)) = gamma x
  [hint_backward]

theorem sin_product
  fixes x :: real
  prop tendsto_real (%n. x * product ({1..n}) (%m. 1 - (x / (pi * of_nat m)) ^ (2::nat))) (sin x) sequentially
  [hint_backward]

theorem wallis_alt
  prop tendsto_real (%n. product ({1..n}) (%k. 2 * of_nat k / (2 * of_nat k - 1) * (2 * of_nat k) / (2 * of_nat k + 1))) (pi / 2) sequentially
  [hint_backward]

theorem wallis
  prop tendsto_real (%n. (2 ^ n * of_nat (fact n)) ^ (4::nat) / (of_nat (fact (2 * n)) * of_nat (fact (2 * n + 1)))) (pi / 2) sequentially
  [hint_backward]

theorem gaussian_has_real_integral
  prop has_real_integral (%x. exp (-(x ^ (2::nat)))) (sqrt pi) univ
  [hint_backward]

