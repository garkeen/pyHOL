theory rules_example
imports nat
description "Samples for the rules a `fun` expansion emits (case and elimination), in shapes the other theories do not carry."

-- The expansion emits the coverage theorem, the case rule, the
-- elimination rule and the induction rule for every definition.  The
-- library's own definitions exercise most of their shapes; the three
-- below are the ones nothing else reaches, and each of them is a place
-- the emitted proofs could go wrong on their own:
--
--   * two clauses with no pattern variable *before* one with a variable.
--     The elimination rule's branches then repeat their propositions
--     (nothing about them names the branch) and a step whose proposition
--     is already an item lays out no line at all -- so the literal IDs
--     after it are the ones to get wrong.
--   * two arguments and three clauses, one of which keeps the second
--     argument: the clauses do not all consume the same position, so the
--     relation is a two-column chain and the rules have to follow it.
--   * a boolean-valued definition, whose right hand sides are booleans:
--     the propositions print with `⟷` and are read back as equalities.

fun gz :: nat ⇒ nat
  | gz 0 = 0
  | gz (Suc 0) = 1
  | gz (Suc (Suc n)) = n

fun gr :: nat ⇒ nat ⇒ nat
  | gr 0 n = n
  | gr (Suc m) 0 = m
  | gr (Suc m) (Suc n) = gr m n

fun gb :: nat ⇒ bool
  | gb 0 ⟷ true
  | gb (Suc n) ⟷ false

-- The elimination rule, used: `rule <c>_elims facts=[<the equation>]` is
-- the whole of it.  A proof that holds `f x̄ = y` gets one subgoal per
-- clause, each carrying that clause's argument shape and right hand side
-- as hypotheses -- which is what Isabelle's `fun_cases` command builds a
-- rule for, and what holpy does not need a command for, since `rule`
-- takes the equation straight.  What it buys over `type_cases` is the
-- clause structure itself: `gz (Suc 0)` is a branch here, and the third
-- branch knows its value is the pattern's own variable.

theorem gz_value_shape
  fixes n :: nat, y :: nat
  prop gz n = y ⟶ y = 0 ∨ y = 1 ∨ n = Suc (Suc y)
proof
  ← intro goal=0
    #[1] gz n = y
    #[2] y = 0 | y = 1 | n = Suc (Suc y)
  ← rule gz_elims goal=2 facts=[1]
    #[3] n = 0 --> y = 0 --> y = 0 | y = 1 | n = Suc (Suc y)
    #[4] n = Suc 0 --> y = 1 --> y = 0 | y = 1 | n = Suc (Suc y)
    #[5] !n1. n = Suc (Suc n1) --> y = n1 --> y = 0 | y = 1 | n = Suc (Suc y)
  ← intro goal=3
    #[6] n = 0
    #[7] y = 0
    #[8] y = 0 | y = 1 | n = Suc (Suc y)
  ← rule disjI1 goal=8
  ← intro goal=4
    #[9] n = Suc 0
    #[10] y = 1
    #[11] y = 0 | y = 1 | n = Suc (Suc y)
  ← rule disjI2 goal=11
    #[12] y = 1 | n = Suc (Suc y)
  ← rule disjI1 goal=12
  ← intro n1 goal=5
    #[13] _VAR n1
    #[14] n = Suc (Suc n1)
    #[15] y = n1
    #[16] y = 0 | y = 1 | n = Suc (Suc y)
  ← rule disjI2 goal=16
    #[17] y = 1 | n = Suc (Suc y)
  ← rule disjI2 goal=17
    #[18] n = Suc (Suc y)
  ← rewrite source=prev goal=18 facts=[15]
qed
