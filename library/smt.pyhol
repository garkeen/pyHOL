theory smt
imports logic_base, int, real, sat, function
description "Used for z3 rule rewrite, th-lemma and def-axiom."

theorem r001
  fixes x :: 'a, y :: 'a
  prop x = y <--> y = x
proof
  ← rule iffI goal=0
    #[1] x = y ⟶ y = x
    #[2] y = x ⟶ x = y
  ← intro goal=1
    #[3] x = y
    #[4] y = x
  ← rewrite eq_sym_eq sym=false goal=4
  ← intro goal=2
    #[5] y = x
    #[6] x = y
  ← rewrite eq_sym_eq sym=false goal=6
qed

theorem r002
  fixes x :: 'a
  prop x = x <--> true
proof
  ← rule iffI goal=0
    #[1] x = x ⟶ true
    #[2] true ⟶ x = x
  ← intro goal=1
    #[3] x = x
    #[4] true
  ← rule trueI goal=4
    #[5] true
  ← intro goal=2
    #[6] true
    #[7] x = x
  ← rule eq_refl goal=7
    #[8] x = x
qed

theorem r003
  fixes p :: bool
  prop (p <--> true) <--> p
proof
  ← rewrite eq_true sym=true goal=0
qed

theorem r004
  fixes p :: bool
  prop (true <--> p) <--> p
proof
  ← rewrite r001 sym=false goal=0 loc=0.1
  ← rewrite eq_true sym=true goal=1
qed

theorem r005
  fixes p :: bool
  prop (p <--> false) <--> ~p
proof
  ← rewrite eq_false sym=true goal=0
qed

theorem r006
  fixes p :: bool
  prop (false <--> p) <--> ~p
proof
  ← rewrite r001 sym=false goal=0 loc=0.1
  ← rewrite eq_false sym=true goal=1
qed

theorem r038
  prop ~true <--> false
proof
  ← rule iffI goal=0
    #[1] ¬true ⟶ false
    #[2] false ⟶ ¬true
  ← intro goal=1
    #[3] ¬true
    #[4] false
  ← rule negE param_A=true goal=4
    #[5] true
  ← rule trueI goal=5
    #[6] true
  ← intro goal=2
    #[7] false
    #[8] ¬true
  ← rule negI goal=8
    #[9] true ⟶ false
  ← intro goal=9
    #[10] true
qed

theorem r065
  fixes x :: int, y :: int
  prop x = y <--> x + -1 * y = 0

theorem r007
  fixes p :: bool, q :: bool
  prop (~p <--> ~q) <--> p <--> q
proof
  ← rewrite neg_iff_both_sides sym=true goal=0
qed

theorem r008
  fixes p :: bool, q :: bool
  prop ~(p <--> ~q) <--> p <--> q
proof
  ← rewrite neg_iff sym=false goal=0
  ← rewrite neg_iff_both_sides sym=true goal=1
qed

theorem r009
  fixes p :: bool, q :: bool
  prop ~(~p <--> q) <--> p <--> q
proof
  ← rewrite neg_iff sym=false goal=0
  ← rewrite double_neg sym=false goal=1
qed

theorem r010
