header "Schematic rules for Z3 rewrite: idempotence and annihilation"

theorem r136
  fixes p :: bool
  prop p & p <--> p
proof
  ← rule conj_same_atom goal=0
qed

theorem r137
  fixes p :: bool
  prop p | p <--> p
proof
  ← rule disj_same_atom goal=0
qed

