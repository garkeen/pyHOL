header "Schematic rules for Z3 rewrite: boolean literal folding"

theorem r155
  fixes A :: bool
  prop (A <--> true) <--> A
proof
  ← rewrite eq_true sym=true goal=0
qed

theorem r156
  fixes A :: bool
  prop (A <--> false) <--> ~A
proof
  ← rewrite eq_false sym=true goal=0
qed
