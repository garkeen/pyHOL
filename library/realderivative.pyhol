    2.4.2.2.21.2.10: rewrite_goal not_imp sym=false
    2.4.2.2.21.2.10: apply_backward_step conjI
    2.4.2.2.21.2.10: introduction y
    2.4.2.2.21.2.10.2: forall_elim y @2.4.2.2.18
    2.4.2.2.21.2.10.3: rewrite_fact_with_prev @2.4.2.2.21.0,2.4.2.2.21.2.10.2
    2.4.2.2.21.2.10.4: apply_prev @2.4.2.2.21.2.10.3
    2.4.2.2.21.2.10.4: apply_backward_step conjD1 @2.4.2.2.21.2.10.1
    2.4.2.2.21.2.11: rewrite_goal_with_prev @2.4.2.2.21.0
    2.4.2.2.21.2.11: z3 @2.4.2.2.2,2.4.2.2.21.2.0,2.4.2.2.21.0
    2.4.2.2.22: cases "x = b"
    2.4.2.2.22: introduction
    2.4.2.2.22.2: apply_forward_step real_derivative_neg_right_minimum @2.4.2.2.1 param_e="(1::real)" param_f="(%x. f x - t * x)" param_f1="f1 b - t"
    2.4.2.2.22.3: apply_backward_step contrapositive @2.4.2.2.22.2
    2.4.2.2.22.3: introduction
    2.4.2.2.22.3.1: rewrite_goal_with_prev @2.4.2.2.22.0
    2.4.2.2.22.3.1: rewrite_goal not_imp sym=false
    2.4.2.2.22.3.1: apply_backward_step conjI
    2.4.2.2.22.3.1: z3
    2.4.2.2.22.3.2: rewrite_goal not_imp sym=false
