    6.10.2: cut "¬(x1 = c)"
    6.10.2: z3 @6.10.1
    6.10.3: rewrite_goal if_not_P @6.10.2 sym=false
    7: cut "c = c"
    7: apply_backward_step eq_refl
    8: rewrite_goal if_P @7 sym=false
    9: rewrite_goal if_P @7 sym=false
    10: rewrite_goal reallim_atreal sym=false
    10: rewrite_fact reallim_atreal @2 sym=false
    11: introduction e
