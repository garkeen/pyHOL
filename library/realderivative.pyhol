    2.4.2.2.22.3.5: apply_backward_step has_real_derivative_lmul_within
    2.4.2.2.22.3.5: apply_backward_step has_real_derivative_id
    2.4.2.2.22.3.7: rewrite_fact real_mul_rid @2.4.2.2.22.3.6 sym=false
    2.4.2.2.22.3.9: rewrite_goal not_imp sym=false
    2.4.2.2.22.3.9: apply_backward_step conjI
    2.4.2.2.22.3.9: introduction y
    2.4.2.2.22.3.9.2: rewrite_fact_with_prev @2.4.2.2.22.0,2.4.2.2.18
    2.4.2.2.22.3.9.3: apply_prev @2.4.2.2.22.3.9.2
    2.4.2.2.22.3.9.3: apply_backward_step conjD1 @2.4.2.2.22.3.9.1
    2.4.2.2.22.3.10: z3 @2.4.2.2.3,2.4.2.2.22.3.0
