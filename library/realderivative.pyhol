theorem lhospital
  fixes c :: real, d :: real, f :: real ⇒ real, f1 :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real, l :: real
  prop 0 < d ⟶ (∀x. 0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x) ∧ ¬(g1 x = 0)) ⟶ tendsto_real f 0 (atreal c) ⟶ tendsto_real g 0 (atreal c) ⟶ tendsto_real (λx. f1 x / g1 x) l (atreal c) ⟶ tendsto_real (λx. f x / g x) l (atreal c)
  [hint_backward,hint_backward1]
  proof
    5: cut "tendsto_real (λx. (if x = c then 0 else f x) / (if x = c then 0 else g  x)) l (atreal c) ⟶ tendsto_real (λx. f x / g x) l (atreal c)"
    5: introduction
    5.1: rewrite_goal reallim_atreal sym=false
    5.1: rewrite_fact reallim_atreal @5.0 sym=false
    5.2: introduction e
    5.2.2: apply_fact @5.1,5.2.1
