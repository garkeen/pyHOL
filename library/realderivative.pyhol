    5.2.5: inst_exists_goal d1
    5.2.5: apply_backward_step conjI
    5.2.5: apply_backward_step conjD1 @5.2.4
    5.2.6: apply_forward_step conjD2 @5.2.4
    5.2.7: introduction x
    5.2.7.3: apply_fact @5.2.6,5.2.7.1,5.2.7.2
    5.2.7.4: cut "~(x = c)"
    5.2.7.4: z3 @5.2.7.1
    5.2.7.5: rewrite_fact if_not_P @5.2.7.3,5.2.7.4 sym=false
    6: apply_prev @5
    6: apply_backward_step lhospital_lemma param_d=d param_f1=f1 param_g1=g1
    6: introduction x
    6.3: apply_backward_step conjI
    6.3: apply_fact @1,6.1,6.2
    6.4: apply_forward_step conjD1 @6.3
    6.5: apply_forward_step conjD2 @6.3
    6.6: apply_forward_step conjD1 @6.5
    6.7: apply_forward_step conjD2 @6.5
    6.8: apply_backward_step has_real_derivative_transform_atreal param_d="abs (x - c)" param_f=f
    6.8: introduction x1
    6.8.2: cut "~(x1 = c)"
    6.8.2: z3 @6.8.1
    6.8.3: rewrite_goal if_not_P @6.8.2 sym=false
    6.10: apply_backward_step conjI
    6.10: apply_backward_step has_real_derivative_transform_atreal param_d="abs (x - c)" param_f=g
