    6: rewrite_goal real_pow_2 sym=false
    6: rewrite_fact real_pow_2 @5 sym=false
    7: cut "(f x * (-g1 * real_inverse (g x * g x)) + f1 * real_inverse (g x)) = ((f1 * g x - f x * g1) * real_inverse (g x * g x))" @6
    7: z3 @2
    8: rewrite_fact_with_prev @7,6
  qed

theorem has_real_derivative_div_atreal
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ has_real_derivative g g1 (atreal x) ⟶ ¬(g x = 0) ⟶ has_real_derivative (λx1. f x1 / g x1) ((f1 * g x - f x * g1) / g x ^ (2::nat)) (atreal x)
