theorem real_derivative_ivt_increasing
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real
  prop a ≤ b ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) ⟶ (∀t. f1 a ≤ t ⟶ t ≤ f1 b ⟶ (∃x. x ∈ real_closed_interval a b ∧ f1 x = t))
  [hint_backward,hint_backward1]
  proof
    2: introduction t
    2.3: cases "f1 a = t"
    2.3: introduction
    2.3.1: inst_exists_goal a
    2.3.1: apply_backward_step conjI
    2.3.1: rewrite_goal real_closed_interval_def sym=false
    2.3.1: rewrite_goal member_collect sym=false
    2.3.1: z3 @0
    2.4: introduction
    2.4.1: cases "f1 b = t"
    2.4.1: introduction
    2.4.1.1: inst_exists_goal b
    2.4.1.1: apply_backward_step conjI
    2.4.1.1: rewrite_goal real_closed_interval_def sym=false
    2.4.1.1: rewrite_goal member_collect sym=false
    2.4.1.1: apply_backward_step conjI
    2.4.1.1: apply_backward_step real_le_refl
    2.4.2: introduction
    2.4.2.1: cases "b = a"
    2.4.2.1: introduction
    2.4.2.1.1: rewrite_goal_with_prev @2.4.2.1.0
    2.4.2.1.1: rewrite_fact real_le_antisym @2.4.0 sym=true
    2.4.2.1.2: apply_backward_step negE_gen @2.4.2.1.1
    2.4.2.1.2: apply_backward_step conjI
    2.4.2.1.2: rewrite_fact_with_prev @2.4.2.1.0,2.2
    2.4.2.2: introduction
    2.4.2.2.1: cut "a < b"
    2.4.2.2.1: z3 @2.4.2.2.0,0
    2.4.2.2.2: cut "f1 a < t"
    2.4.2.2.2: z3 @2.4.0,2.1
    2.4.2.2.3: cut "t < f1 b"
    2.4.2.2.3: z3 @2.4.2.0,2.2
    2.4.2.2.4: apply_forward_step real_continuous_attains_inf param_f="(%x. f x - t * x)" param_s="real_closed_interval a b"
    2.4.2.2.5: cut "(∃x. x ∈ real_closed_interval a b ∧ (∀y. y ∈ real_closed_interval a b ⟶ f x - t * x ≤ f y - t * y))"
    2.4.2.2.5: apply_prev @2.4.2.2.4
    2.4.2.2.5: apply_backward_step real_compact_interval
    2.4.2.2.6: rewrite_goal real_closed_interval_ne_empty sym=false
    2.4.2.2.7: apply_backward_step real_differentiable_on_imp_real_continuous_on
    2.4.2.2.7: apply_backward_step real_differentiable_on_sub
    2.4.2.2.7: rewrite_goal real_differentiable_on_def sym=false
    2.4.2.2.7: introduction x
    2.4.2.2.7.2: apply_fact @1,2.4.2.2.7.1
    2.4.2.2.7.3: apply_backward_step exI @2.4.2.2.7.2
    2.4.2.2.9: apply_backward_step real_differentiable_on_mul
    2.4.2.2.9: apply_backward_step real_differentiable_on_const
    2.4.2.2.10: apply_backward_step real_differentiable_on_id
    2.4.2.2.15: exists_elim x @2.4.2.2.14
    2.4.2.2.17: inst_exists_goal x
    2.4.2.2.17: apply_backward_step conjI
    2.4.2.2.17: apply_backward_step conjD1 @2.4.2.2.16
    2.4.2.2.18: apply_forward_step conjD2 @2.4.2.2.16
    2.4.2.2.19: apply_forward_step real_derivative_zero_maxmin param_f="(%x. f x - t * x)" param_f1="f1 x - t" param_s="real_open_interval a b" param_x=x
    2.4.2.2.20: rewrite_fact real_sub_0 @2.4.2.2.19 sym=false
    2.4.2.2.21: cases "x = a"
    2.4.2.2.21: introduction
    2.4.2.2.21.1: apply_forward_step real_derivative_pos_left_minimum @2.4.2.2.1 param_e="(1::real)" param_f="(%x. f x - t * x)" param_f1="f1 x - t"
    2.4.2.2.21.2: apply_backward_step contrapositive @2.4.2.2.21.1
