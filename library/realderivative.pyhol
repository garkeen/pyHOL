theory realderivative
imports realanalysis, transcendentals, misc
description "Some analytic concepts for real."

def has_real_derivative :: (real ⇒ real) ⇒ real ⇒ real net ⇒ bool = has_real_derivative f f1 net ⟷ tendsto_real (λx. real_inverse (x - netlimit net) * (f x - (f (netlimit net) + f1 * (x - netlimit net)))) 0 net [hint_rewrite]

def real_differentiable :: (real ⇒ real) ⇒ real net ⇒ bool = real_differentiable f net ⟷ (∃f1. has_real_derivative f f1 net) [hint_rewrite]

def real_derivative :: (real ⇒ real) ⇒ real ⇒ real = real_derivative f x = (THE f1. has_real_derivative f f1 (atreal x)) [hint_rewrite]

fun higher_real_derivative :: nat ⇒ (real ⇒ real) ⇒ real ⇒ real
  | higher_real_derivative 0 f = f
  | higher_real_derivative (Suc n) f = real_derivative (higher_real_derivative n f)

def real_differentiable_on :: (real ⇒ real) ⇒ real set ⇒ bool = real_differentiable_on f s ⟷ (∀x. x ∈ s ⟶ (∃f1. has_real_derivative f f1 (within (atreal x) s))) [hint_rewrite]

theorem has_real_derivative_withinreal
  fixes a :: real, f :: real ⇒ real, f1 :: real, s :: real set
  prop has_real_derivative f f1 (within (atreal a) s) ⟷ tendsto_real (λx. (f x - f a) / (x - a)) f1 (within (atreal a) s)
  [hint_rewrite]

theorem has_real_derivative_atreal
  fixes a :: real, f :: real ⇒ real, f1 :: real
  prop has_real_derivative f f1 (atreal a) ⟷ tendsto_real (λx. (f x - f a) / (x - a)) f1 (atreal a)
  [hint_rewrite]

theorem real_differentiable_on_differentiable
  fixes f :: real ⇒ real, s :: real set
  prop real_differentiable_on f s ⟷ (∀x. x ∈ s ⟶ real_differentiable f (within (atreal x) s))
  [hint_rewrite]

theorem real_differentiable_on_real_open
  fixes f :: real ⇒ real, s :: real set
  prop real_open s ⟶ real_differentiable_on f s ⟷ (∀x. x ∈ s ⟶ (∃f1. has_real_derivative f f1 (atreal x)))

theorem real_differentiable_on_imp_differentiable_within
  fixes f :: real ⇒ real, s :: real set, x :: real
  prop real_differentiable_on f s ⟶ x ∈ s ⟶ real_differentiable f (within (atreal x) s)

theorem real_differentiable_on_imp_differentiable_atreal
  fixes f :: real ⇒ real, s :: real set, x :: real
  prop real_differentiable_on f s ⟶ real_open s ⟶ x ∈ s ⟶ real_differentiable f (atreal x)

theorem has_real_derivative_caratheodory_atreal
  fixes a :: real, f :: real ⇒ real, f1 :: real
  prop has_real_derivative f f1 (atreal a) ⟷ (∃g. (∀b. f b - f a = g b * (b - a)) ∧ real_continuous g (atreal a) ∧ g a = f1)

theorem has_real_derivative_caratheodory_withinreal
  fixes a :: real, f :: real ⇒ real, f1 :: real, s :: real set
  prop has_real_derivative f f1 (within (atreal a) s) ⟷ (∃g. (∀b. f b - f a = g b * (b - a)) ∧ real_continuous g (within (atreal a) s) ∧ g a = f1)

theorem real_differentiable_caratheodory_atreal
  fixes a :: real, f :: real ⇒ real
  prop real_differentiable f (atreal a) ⟷ (∃g. (∀b. f b - f a = g b * (b - a)) ∧ real_continuous g (atreal a))

theorem real_differentiable_caratheodory_withinreal
  fixes a :: real, f :: real ⇒ real, s :: real set
  prop real_differentiable f (within (atreal a) s) ⟷ (∃g. (∀b. f b - f a = g b * (b - a)) ∧ real_continuous g (within (atreal a) s))

theorem trivial_limit_within_realinterval
  fixes s :: real set, x :: real
  prop is_realinterval s ⟶ x ∈ s ⟶ trivial_limit (within (atreal x) s) ⟷ s = {x}

theorem is_real_interval_cases
  fixes s :: real set
  prop is_realinterval s ⟷ s = ∅ ∨ s = univ ∨ (∃a. s = {x. a < x}) ∨ (∃a. s = {x. a ≤ x}) ∨ (∃b. s = {x. x < b}) ∨ (∃b. s = {x. x ≤ b}) ∨ (∃a. ∃b. s = {x. a < x ∧ x < b}) ∨ (∃a. ∃b. s = {x. a < x ∧ x ≤ b}) ∨ (∃a. ∃b. s = {x. a ≤ x ∧ x < b}) ∨ (∃a. ∃b. s = {x. a ≤ x ∧ x ≤ b})

theorem is_realinterval_clauses_1
  fixes a :: real
  prop is_realinterval ({x. a < x})
  [hint_backward]

theorem is_realinterval_clauses_2
  fixes a :: real
  prop is_realinterval ({x. a ≤ x})
  [hint_backward]

theorem is_realinterval_clauses_3
  fixes a :: real
  prop is_realinterval ({x. x < a})
  [hint_backward]

theorem is_realinterval_clauses_4
  fixes a :: real
  prop is_realinterval ({x. x ≤ a})
  [hint_backward]

theorem is_realinterval_clauses_5
  fixes a :: real, b :: real
  prop is_realinterval ({x. a < x ∧ x < b})
  [hint_backward]

theorem is_realinterval_clauses_6
  fixes a :: real, b :: real
  prop is_realinterval ({x. a < x ∧ x ≤ b})
  [hint_backward]

theorem is_realinterval_clauses_7
  fixes a :: real, b :: real
  prop is_realinterval ({x. a ≤ x ∧ x < b})
  [hint_backward]

theorem is_realinterval_clauses_8
  fixes a :: real, b :: real
  prop is_realinterval ({x. a ≤ x ∧ x ≤ b})
  [hint_backward]

theorem real_convex
  fixes s :: real set
  prop is_realinterval s ⟷ (∀x. ∀y. ∀u. ∀v. x ∈ s ⟶ y ∈ s ⟶ 0 ≤ u ⟶ 0 ≤ v ⟶ u + v = 1 ⟶ u * x + v * y ∈ s)
  [hint_rewrite]

theorem real_convex_alt
  fixes s :: real set
  prop is_realinterval s ⟷ (∀x. ∀y. ∀u. x ∈ s ⟶ y ∈ s ⟶ 0 ≤ u ⟶ u ≤ 1 ⟶ (1 - u) * x + u * y ∈ s)
  [hint_rewrite]

theorem real_midpoint_in_convex
  fixes s :: real set, x :: real, y :: real
  prop is_realinterval s ⟶ x ∈ s ⟶ y ∈ s ⟶ (x + y) / 2 ∈ s
  [hint_backward,hint_backward1,hint_forward]

theorem image_affinity_real_interval
  fixes a :: real, b :: real, c :: real, m :: real
  prop image (λx. m * x + c) (real_closed_interval a b) = (if real_closed_interval a b = ∅ then ∅ else if 0 ≤ m then real_closed_interval (m * a + c) (m * b + c) else real_closed_interval (m * b + c) (m * a + c))

theorem image_stretch_real_interval
  fixes a :: real, b :: real, m :: real
  prop image (λx. m * x) (real_closed_interval a b) = (if real_closed_interval a b = ∅ then ∅ else if 0 ≤ m then real_closed_interval (m * a) (m * b) else real_closed_interval (m * b) (m * a))
  [hint_rewrite]

theorem real_closed_interval_translation
  fixes a :: real, b :: real, c :: real
  prop real_closed_interval (c + a) (c + b) = image (λx. c + x) (real_closed_interval a b)
  [hint_rewrite]

theorem real_open_interval_translation
  fixes a :: real, b :: real, c :: real
  prop real_open_interval (c + a) (c + b) = image (λx. c + x) (real_open_interval a b)
  [hint_rewrite]

theorem real_differentiable_imp_continuous_withinreal
  fixes f :: real ⇒ real, s :: real set, x :: real
  prop real_differentiable f (within (atreal x) s) ⟶ real_continuous f (within (atreal x) s)
  [hint_backward,hint_forward]

theorem real_differentiable_imp_continuous_atreal
  fixes f :: real ⇒ real, x :: real
  prop real_differentiable f (atreal x) ⟶ real_continuous f (atreal x)
  [hint_backward,hint_forward]

theorem has_real_derivative_imp_continuous_withinreal
  fixes f :: real ⇒ real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ real_continuous f (within (atreal x) s)
  [hint_backward,hint_forward]

theorem has_real_derivative_imp_continuous_atreal
  fixes f :: real ⇒ real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ real_continuous f (atreal x)
  [hint_backward,hint_forward]

theorem real_differentiable_on_imp_real_continuous_on
  fixes f :: real ⇒ real, s :: real set
  prop real_differentiable_on f s ⟶ real_continuous_on f s
  [hint_backward,hint_forward]

theorem real_continuous_transform_withinreal_set_imp
  fixes a :: real, f :: real ⇒ real, s :: real set, t :: real set
  prop eventually (λx. x ∈ t ⟶ x ∈ s) (atreal a) ⟶ real_continuous f (within (atreal a) s) ⟶ real_continuous f (within (atreal a) t)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_derivative_within_subset
  fixes f :: real ⇒ real, f1 :: real, s :: real set, t :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ t ⊆ s ⟶ has_real_derivative f f1 (within (atreal x) t)
  [hint_backward,hint_forward,hint_backward1]

theorem real_differentiable_on_subset
  fixes f :: real ⇒ real, s :: real set, t :: real set
  prop real_differentiable_on f s ⟶ t ⊆ s ⟶ real_differentiable_on f t
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal real_differentiable_on_def sym=false
    2: rewrite_fact real_differentiable_on_def @0 sym=false
    3: introduction x
    3.2: forall_elim x @2
    3.3: apply_forward_step subsetE @1,3.1
    3.4: apply_fact @3.2,3.3
    3.5: exists_elim f1 @3.4
    3.7: inst_exists_goal f1
    3.7: apply_backward_step has_real_derivative_within_subset @3.6,1
  qed

theorem real_differentiable_within_subset
  fixes f :: real ⇒ real, s :: real set, t :: real set, x :: real
  prop real_differentiable f (within (atreal x) s) ⟶ t ⊆ s ⟶ real_differentiable f (within (atreal x) t)
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal real_differentiable_def sym=false
    2: rewrite_fact real_differentiable_def @0 sym=false
    3: exists_elim f1 @2
    5: inst_exists_goal f1
    5: apply_backward_step has_real_derivative_within_subset @4,1
  qed

theorem has_real_derivative_atreal_within
  fixes f :: real ⇒ real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ has_real_derivative f f1 (within (atreal x) s)
  [hint_backward,hint_forward]

theorem has_real_derivative_within_real_open
  fixes a :: real, f :: real ⇒ real, f1 :: real, s :: real set
  prop a ∈ s ⟶ real_open s ⟶ has_real_derivative f f1 (within (atreal a) s) ⟷ has_real_derivative f f1 (atreal a)
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal has_real_derivative_atreal sym=false
    2: rewrite_goal has_real_derivative_withinreal sym=false
    2: apply_backward_step reallim_within_real_open
  qed

theorem real_differentiable_atreal_within
  fixes f :: real ⇒ real, s :: real set, x :: real
  prop real_differentiable f (atreal x) ⟶ real_differentiable f (within (atreal x) s)
  [hint_backward,hint_forward]
  proof
    1: rewrite_goal real_differentiable_def sym=false
    1: rewrite_fact real_differentiable_def @0 sym=false
    2: exists_elim f1 @1
    4: inst_exists_goal f1
    4: apply_backward_step has_real_derivative_atreal_within
  qed

theorem has_real_derivative_transform_within
  fixes d :: real, f :: real ⇒ real, f1 :: real, g :: real ⇒ real, s :: real set, x :: real
  prop 0 < d ⟶ x ∈ s ⟶ (∀x1. x1 ∈ s ⟶ abs (x1 - x) < d ⟶ f x1 = g x1) ⟶ has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative g f1 (within (atreal x) s)
  [hint_backward,hint_backward1]

theorem has_real_derivative_transform_atreal
  fixes d :: real, f :: real ⇒ real, f1 :: real, g :: real ⇒ real, s :: real set, x :: real
  prop 0 < d ⟶ (∀x1. abs (x1 - x) < d ⟶ f x1 = g x1) ⟶ has_real_derivative f f1 (atreal x) ⟶ has_real_derivative g f1 (atreal x)
  [hint_backward,hint_backward1]
  proof
    3: rewrite_goal withinreal_univ sym=true
    3: rewrite_fact withinreal_univ @2 sym=true
    4: apply_backward_step has_real_derivative_transform_within @0 param_f=f
    4: apply_backward_step member_univ
    5: introduction x1
    5.3: apply_prev @1
  qed

theorem has_real_derivative_zero_constant
  fixes f :: real ⇒ real, s :: real set
  prop is_realinterval s ⟶ (∀x. x ∈ s ⟶ has_real_derivative f 0 (within (atreal x) s)) ⟶ (∃c. ∀x. x ∈ s ⟶ f x = c)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_derivative_zero_unique
  fixes a :: real, c :: real, f :: real ⇒ real, s :: real set
  prop is_realinterval s ⟶ a ∈ s ⟶ f a = c ⟶ (∀x. x ∈ s ⟶ has_real_derivative f 0 (within (atreal x) s)) ⟶ (∀x. x ∈ s ⟶ f x = c)
  [hint_backward,hint_backward1]
  proof
    4: apply_forward_step has_real_derivative_zero_constant @0,3
    5: z3 @4,1,2
  qed

theorem real_diff_chain_within
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative g g1 (within (atreal (f x)) (image f s)) ⟶ has_real_derivative (λx1. g (f x1)) (g1 * f1) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]

theorem real_diff_chain_atreal
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ has_real_derivative g g1 (atreal (f x)) ⟶ has_real_derivative (λx1. g (f x1)) (g1 * f1) (atreal x)
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal withinreal_univ sym=true
    2: rewrite_fact withinreal_univ @1 sym=true
    3: rewrite_fact withinreal_univ @0 sym=true
    4: apply_backward_step real_diff_chain_within
    4: apply_backward_step has_real_derivative_within_subset param_s="(univ::real set)"
    4: apply_backward_step subset_univ
  qed

theorem has_real_derivative_chain
  fixes P :: real ⇒ bool, f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real ⇒ real
  prop (∀x. P x ⟶ has_real_derivative g (g1 x) (atreal x)) ⟶ (∀x. ∀s. has_real_derivative f f1 (within (atreal x) s) ⟶ P (f x) ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)) ∧ (∀x. has_real_derivative f f1 (atreal x) ⟶ P (f x) ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x))
  [hint_backward,hint_forward]

theorem has_real_derivative_chain_univ
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real ⇒ real
  prop (∀x. has_real_derivative g (g1 x) (atreal x)) ⟶ (∀x. ∀s. has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)) ∧ (∀x. has_real_derivative f f1 (atreal x) ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x))
  proof
    1: apply_forward_step has_real_derivative_chain param_P="(%x::real. true)" param_f=f param_f1=f1 param_g=g param_g1=g1
    2: cut "(∀x. has_real_derivative g (g1 x) (atreal x)) <--> (∀x. true ⟶ has_real_derivative g (g1 x) (atreal x))" @0
    2: apply_backward_step iffI
    2: introduction
    2.0: introduction x
    2.0.2: apply_prev @0
    3: introduction
    5: rewrite_fact eq_sym_eq @4 sym=false
    6: rewrite_fact_with_prev @5,1
    7: apply_fact @6,0
    8: apply_backward_step conjI
    8: apply_forward_step conjD1 @7
    9: apply_forward_step conjD2 @7
    10: introduction x,s
    10.3: apply_prev @8
    10.3: apply_backward_step trueI
    11: introduction x
    11.2: apply_prev @9
    11.2: apply_backward_step trueI
  qed

theorem real_derivative_unique_atreal
  fixes f :: real ⇒ real, f1 :: real, f2 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ has_real_derivative f f2 (atreal x) ⟶ f1 = f2
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_derivative_derivative
  fixes f :: real ⇒ real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ real_derivative f x = f1
  [hint_backward]
  proof
    1: rewrite_goal real_derivative_def sym=false
    1: apply_forward_step theI param_P="(%f11. has_real_derivative f f11 (atreal x))" param_a=f1
    2: apply_fact @1,0
    3: cut "(∀x1. has_real_derivative f x1 (atreal x) ⟶ x1 = f1)"
    3: introduction g
    3.2: apply_backward_step real_derivative_unique_atreal @3.1,0
    4: apply_prev @3
    4: apply_prev @2
  qed

theorem has_real_derivative_differentiable
  fixes f :: real ⇒ real, x :: real
  prop has_real_derivative f (real_derivative f x) (atreal x) ⟷ real_differentiable f (atreal x)
  proof
    0: apply_backward_step iffI
    0: introduction
    0.1: rewrite_goal real_differentiable_def sym=false
    0.1: apply_backward_step exI @0.0
    1: introduction
    1.1: rewrite_fact real_differentiable_def @1.0 sym=false
    1.2: exists_elim f1 @1.1
    1.4: apply_forward_step has_real_derivative_derivative @1.3
    1.5: rewrite_goal_with_prev @1.4
  qed

theorem has_real_derivative_lmul_within
  fixes c :: real, f :: real ⇒ real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative (λx1. c * f x1) (c * f1) (within (atreal x) s)
  [hint_backward]

theorem has_real_derivative_rmul_within
  fixes c :: real, f :: real ⇒ real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative (λx1. f x1 * c) (f1 * c) (within (atreal x) s)
  [hint_backward]
  proof
    1: rewrite_goal real_mult_comm sym=false
    1: apply_backward_step has_real_derivative_lmul_within
  qed

theorem has_real_derivative_lmul_atreal
  fixes c :: real, f :: real ⇒ real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ has_real_derivative (λx1. c * f x1) (c * f1) (atreal x)
  [hint_backward]
  proof
    1: rewrite_goal withinreal_univ sym=true
    1: rewrite_fact withinreal_univ @0 sym=true
    2: apply_backward_step has_real_derivative_lmul_within
  qed

theorem has_real_derivative_rmul_atreal
  fixes c :: real, f :: real ⇒ real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ has_real_derivative (λx1. f x1 * c) (f1 * c) (atreal x)
  [hint_backward]
  proof
    1: rewrite_goal real_mult_comm sym=false
    1: apply_backward_step has_real_derivative_lmul_atreal
  qed

theorem has_real_derivative_cdiv_within
  fixes c :: real, f :: real ⇒ real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative (λx1. f x1 / c) (f1 / c) (within (atreal x) s)
  [hint_backward]
  proof
    1: rewrite_goal real_divide_def sym=false
    1: apply_backward_step has_real_derivative_rmul_within
  qed

theorem has_real_derivative_cdiv_atreal
  fixes c :: real, f :: real ⇒ real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ has_real_derivative (λx1. f x1 / c) (f1 / c) (atreal x)
  [hint_backward]
  proof
    1: rewrite_goal real_divide_def sym=false
    1: apply_backward_step has_real_derivative_rmul_atreal
  qed

theorem has_real_derivative_id
  fixes net :: real net
  prop has_real_derivative (λx. x) 1 net
  [hint_backward]
  proof
    0: rewrite_goal has_real_derivative_def sym=false
    0: rewrite_goal real_mul_lid sym=false
    0: cut "!x::real. !a. x-(a+(x-a))=0"
    0: z3
    1: rewrite_goal_with_prev @0
    1: rewrite_goal real_mul_rzero sym=false
    1: apply_backward_step reallim_const
  qed

theorem real_derivative_id
  fixes x :: real
  prop real_derivative (λx1. x1) x = 1
  [hint_rewrite]
  proof
    0: apply_backward_step has_real_derivative_derivative
    0: apply_backward_step has_real_derivative_id
  qed

theorem has_real_derivative_const
  fixes c :: real, net :: real net
  prop has_real_derivative (λx. c) 0 net
  [hint_backward]
  proof
    0: rewrite_goal has_real_derivative_def sym=false
    0: rewrite_goal real_mul_lzero sym=false
    0: rewrite_goal real_add_rid sym=false
    0: rewrite_goal real_minus_def sym=false
    0: rewrite_goal real_add_rinv sym=false
    0: rewrite_goal real_mul_rzero sym=false
    0: apply_backward_step reallim_const
  qed

theorem real_derivative_const
  fixes c :: real, x :: real
  prop real_derivative (λx1. c) x = 0
  [hint_rewrite]
  proof
    0: apply_backward_step has_real_derivative_derivative
    0: apply_backward_step has_real_derivative_const
  qed

theorem has_real_derivative_neg
  fixes f :: real ⇒ real, f1 :: real, net :: real net
  prop has_real_derivative f f1 net ⟶ has_real_derivative (λx. -(f x)) (-f1) net
  [hint_backward]
  proof
    1: rewrite_goal has_real_derivative_def sym=false
    1: rewrite_fact has_real_derivative_def @0 sym=false
    2: rewrite_fact reallim_neg_eq @1 sym=true
    3: cut "!a::real. !b. !c. !d. !e. a * (-b - (-c + -d * e)) = -(a * (b - (c + d * e)))"
    3: z3
    4: rewrite_goal_with_prev @3
    4: rewrite_fact real_neg_0 @2 sym=false
  qed

theorem real_derivative_neg
  fixes f :: real ⇒ real, x :: real
  prop real_differentiable f (atreal x) ⟶ real_derivative (λx1. -(f x1)) x = -(real_derivative f x)

theorem real_derivative_uminus
  fixes x :: real
  prop real_derivative uminus x = -1

theorem has_real_derivative_add
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real, net :: real net
  prop has_real_derivative f f1 net ⟶ has_real_derivative g g1 net ⟶ has_real_derivative (λx. f x + g x) (f1 + g1) net
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal has_real_derivative_def sym=false
    2: rewrite_fact has_real_derivative_def @0 sym=false
    3: rewrite_fact has_real_derivative_def @1 sym=false
    4: apply_forward_step reallim_add @2,3
    5: cut "!a::real. !b. !c. !d. !e. !f. !g. !h. (a-(b+c*(d-e)))+(f-(g+h*(d-e)))=(a+f)-((b+g)+(c +h) *(d-e))"
    5: z3
    6: rewrite_fact real_add_ldistrib @4 sym=true
    7: rewrite_fact_with_prev @5,6
    8: rewrite_fact real_add_lid @7 sym=false
  qed

theorem real_derivative_add
  fixes f :: real ⇒ real, g :: real ⇒ real, x :: real
  prop real_differentiable f (atreal x) ⟶ real_differentiable g (atreal x) ⟶ real_derivative (λx1. f x1 + g x1) x = real_derivative f x + real_derivative g x

theorem has_real_derivative_sub
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real, net :: real net
  prop has_real_derivative f f1 net ⟶ has_real_derivative g g1 net ⟶ has_real_derivative (λx. f x - g x) (f1 - g1) net
