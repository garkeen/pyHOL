  fixes f :: real ⇒ real, g :: real ⇒ real, x :: real
  prop real_differentiable f (atreal x) ⟶ real_differentiable g (atreal x) ⟶ ¬(g x = 0) ⟶ real_derivative (λx1. f x1 / g x1) x = (real_derivative f x * g x - f x * real_derivative g x) / g x ^ (2::nat)

