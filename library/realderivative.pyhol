  qed

theorem real_mvt_cauchy
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real, g :: real ⇒ real, g1 :: real ⇒ real
  prop a < b ⟶ real_continuous_on f (real_closed_interval a b) ⟶ real_continuous_on g (real_closed_interval a b) ⟶ (∀x. x ∈ real_open_interval a b ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)) ⟶ (∃x. x ∈ real_open_interval a b ∧ (f b - f a) * g1 x = (g b - g a) * f1 x)
  [hint_backward,hint_backward1]
  proof
    4: apply_forward_step real_mvt @0 param_f="(%x. f x * (g b - g a) - g x * (f b - f a))" param_f1="(%x. f1 x * (g b - g a) - g1 x * (f b - f a))"
    5: cut "real_continuous_on (λx. f x * (g b - g a) - g x * (f b - f a)) (real_closed_interval a b)"
    5: apply_backward_step real_continuous_on_sub
    5: apply_backward_step real_continuous_on_rmul
    6: apply_backward_step real_continuous_on_rmul
    8: apply_fact @4,7
