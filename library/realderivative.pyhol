    5.3: apply_forward_step has_real_derivative_within_real_open @5.1,5.2 param_f=f param_f1="f1 x"
    5.4: rewrite_fact eq_sym_eq @5.3 sym=false
    5.5: rewrite_goal_with_prev @5.4
    5.5: apply_backward_step has_real_derivative_within_subset param_s="(real_closed_interval a b)"
    5.5: apply_prev @1
    5.5: cut "real_open_interval a b ⊆ real_closed_interval a b"
    5.5: apply_backward_step real_interval_open_subset_closed
    5.6: apply_backward_step subsetE @5.5
    5.8: apply_backward_step real_interval_open_subset_closed
  qed

theorem real_mvt_very_simple
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real
  prop a ≤ b ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) ⟶ (∃x. x ∈ real_closed_interval a b ∧ f b - f a = f1 x * (b - a))
