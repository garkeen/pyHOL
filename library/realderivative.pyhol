theorem real_derivative_ivt_decreasing
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real
  prop a ≤ b ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) ⟶ (∀t. f1 b ≤ t ⟶ t ≤ f1 a ⟶ (∃x. x ∈ real_closed_interval a b ∧ f1 x = t))
  [hint_backward,hint_backward1]
  proof
    2: apply_forward_step real_derivative_ivt_increasing @0 param_f="(%x. -f x)" param_f1="(%x. -f1 x)"
    3: cut "(∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative (λx1. -(f x1)) (-(f1 x)) (within (atreal x) (real_closed_interval a b)))"
    3: introduction x
    3.2: apply_backward_step has_real_derivative_neg
    3.2: apply_prev @1
    4: apply_fact @2,3
    5: introduction t
    5.3: forall_elim -t @4
    5.4: rewrite_fact real_eq_neg2 @5.3 sym=false
    5.5: rewrite_fact real_le_lneg2 @5.4 sym=false
    5.6: apply_prev @5.5
  qed

theorem has_real_derivative_inverse_basic
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, t :: real set, y :: real
  prop has_real_derivative f f1 (atreal (g y)) ⟶ ¬(f1 = 0) ⟶ real_continuous g (atreal y) ⟶ real_open t ⟶ y ∈ t ⟶ (∀z. z ∈ t ⟶ f (g z) = z) ⟶ has_real_derivative g (real_inverse f1) (atreal y)
  [hint_backward,hint_backward1]
  proof
    6: rewrite_goal has_real_derivative_def sym=false
    6: rewrite_fact has_real_derivative_def @0 sym=false
  qed

theorem has_real_derivative_inverse_strong
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, s :: real set, x :: real
  prop real_open s ⟶ x ∈ s ⟶ real_continuous_on f s ⟶ (∀x1. x1 ∈ s ⟶ g (f x1) = x1) ⟶ has_real_derivative f f1 (atreal x) ⟶ ¬(f1 = 0) ⟶ has_real_derivative g (real_inverse f1) (atreal (f x))
  [hint_backward,hint_backward1]

theorem has_real_derivative_inverse_strong_x
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, s :: real set, y :: real
  prop real_open s ⟶ g y ∈ s ⟶ real_continuous_on f s ⟶ (∀x. x ∈ s ⟶ g (f x) = x) ⟶ has_real_derivative f f1 (atreal (g y)) ⟶ ¬(f1 = 0) ⟶ f (g y) = y ⟶ has_real_derivative g (real_inverse f1) (atreal y)
  [hint_backward,hint_backward1]
