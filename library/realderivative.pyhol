    0.2: cut "(0::real) < of_nat n"
    0.2: rewrite_goal real_less_def sym=false
    0.2: rewrite_goal real_zero_def sym=false
    0.2: rewrite_goal real_of_nat_le sym=false
    0.2: rewrite_goal nat_less_eq_def_1 sym=false
    0.2: z3 @0.1
    0.7: rewrite_goal if_P @0.6 sym=false
    0.7: rewrite_goal real_abs_nat sym=false
    0.7: rewrite_goal real_mul_lid sym=false
    3: rewrite_goal real_exp_0 sym=true
    3: apply_backward_step reallim_real_continuous_function
