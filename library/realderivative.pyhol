theorem has_real_derivative_div_within
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative g g1 (within (atreal x) s) ⟶ ¬(g x = 0) ⟶ has_real_derivative (λx1. f x1 / g x1) ((f1 * g x - f x * g1) / g x ^ (2::nat)) (within (atreal x) s)
