theorem real_mvt_simple
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real
  prop a < b ⟶ (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) ⟶ (∃x. x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a))
