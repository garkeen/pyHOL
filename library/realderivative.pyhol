theorem has_real_derivative_inv_atreal
  fixes f :: real ⇒ real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ ¬(f x = 0) ⟶ has_real_derivative (λx1. real_inverse (f x1)) (-f1 / f x ^ (2::nat)) (atreal x)
