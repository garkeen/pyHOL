theorem real_ivt_increasing
  fixes a :: real, b :: real, f :: real ⇒ real, y :: real
  prop a ≤ b ⟶ real_continuous_on f (real_closed_interval a b) ⟶ f a ≤ y ⟶ y ≤ f b ⟶ (∃x. x ∈ real_closed_interval a b ∧ f x = y)
  [hint_backward,hint_backward1]

theorem real_ivt_decreasing
  fixes a :: real, b :: real, f :: real ⇒ real, y :: real
  prop a ≤ b ⟶ real_continuous_on f (real_closed_interval a b) ⟶ f b ≤ y ⟶ y ≤ f a ⟶ (∃x. x ∈ real_closed_interval a b ∧ f x = y)
  [hint_backward,hint_backward1]

theorem is_realinterval_continuous_image
  fixes f :: real ⇒ real, s :: real set
  prop real_continuous_on f s ⟶ is_realinterval s ⟶ is_realinterval (image f s)
  [hint_backward,hint_backward1]

theorem real_derivative_pos_left_minimum
  fixes a :: real, b :: real, e :: real, f :: real ⇒ real, f1 :: real
  prop a < b ⟶ 0 < e ⟶ has_real_derivative f f1 (within (atreal a) (real_closed_interval a b)) ⟶ (∀x. x ∈ real_closed_interval a b ∧ abs (x - a) < e ⟶ f a ≤ f x) ⟶ 0 ≤ f1
  [hint_backward,hint_backward1]

theorem real_derivative_neg_left_maximum
  fixes a :: real, b :: real, e :: real, f :: real ⇒ real, f1 :: real
  prop a < b ⟶ 0 < e ⟶ has_real_derivative f f1 (within (atreal a) (real_closed_interval a b)) ⟶ (∀x. x ∈ real_closed_interval a b ∧ abs (x - a) < e ⟶ f x ≤ f a) ⟶ f1 ≤ 0
  [hint_backward,hint_backward1]

theorem real_derivative_pos_right_maximum
  fixes a :: real, b :: real, e :: real, f :: real ⇒ real, f1 :: real
  prop a < b ⟶ 0 < e ⟶ has_real_derivative f f1 (within (atreal b) (real_closed_interval a b)) ⟶ (∀x. x ∈ real_closed_interval a b ∧ abs (x - b) < e ⟶ f x ≤ f b) ⟶ 0 ≤ f1
  [hint_backward,hint_backward1]

theorem real_derivative_neg_right_minimum
  fixes a :: real, b :: real, e :: real, f :: real ⇒ real, f1 :: real
  prop a < b ⟶ 0 < e ⟶ has_real_derivative f f1 (within (atreal b) (real_closed_interval a b)) ⟶ (∀x. x ∈ real_closed_interval a b ∧ abs (x - b) < e ⟶ f b ≤ f x) ⟶ f1 ≤ 0
  [hint_backward,hint_backward1]

theorem real_derivative_zero_maxmin
  fixes f :: real ⇒ real, f1 :: real, s :: real set, x :: real
  prop x ∈ s ⟶ real_open s ⟶ has_real_derivative f f1 (atreal x) ⟶ (∀y. y ∈ s ⟶ f y ≤ f x) ∨ (∀y. y ∈ s ⟶ f x ≤ f y) ⟶ f1 = 0
  [hint_backward,hint_backward1]

theorem real_rolle
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real
  prop a < b ⟶ f a = f b ⟶ real_continuous_on f (real_closed_interval a b) ⟶ (∀x. x ∈ real_open_interval a b ⟶ has_real_derivative f (f1 x) (atreal x)) ⟶ (∃x. x ∈ real_open_interval a b ∧ f1 x = 0)
  [hint_backward,hint_backward1]

theorem real_mvt
  fixes a :: real, b :: real, f :: real ⇒ real, f1 :: real ⇒ real
  prop a < b ⟶ real_continuous_on f (real_closed_interval a b) ⟶ (∀x. x ∈ real_open_interval a b ⟶ has_real_derivative f (f1 x) (atreal x)) ⟶ (∃x. x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a))
  [hint_backward,hint_backward1]
  proof
    3: apply_forward_step real_rolle param_a=a param_b=b param_f="(%x. f x - (f b - f a) / (b - a) * x)" param_f1="(%x. f1 x - (f b - f a) / (b - a))"
    4: apply_fact @3,0
    5: cut "!fx. a < b --> fx - (f b - f a) / (b - a) = 0 <--> (f b - f a) = fx * (b - a)" @4
    5: z3
    6: apply_fact @5,0
    7: rewrite_fact_with_prev @6,4
    8: apply_prev @7
    8: z3
    9: apply_backward_step real_continuous_on_sub
    9: apply_backward_step real_continuous_on_lmul
    9: apply_backward_step real_continuous_on_id
    12: introduction x
    12.2: apply_backward_step has_real_derivative_sub
    12.2: apply_prev @2
