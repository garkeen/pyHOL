    2: rewrite_goal real_minus_def sym=false
    2: apply_backward_step has_real_derivative_add
    2: apply_backward_step has_real_derivative_neg
  qed

theorem real_derivative_sub
  fixes f :: real ⇒ real, g :: real ⇒ real, x :: real
  prop real_differentiable f (atreal x) ⟶ real_differentiable g (atreal x) ⟶ real_derivative (λx1. f x1 - g x1) x = real_derivative f x - real_derivative g x

theorem has_real_derivative_mul_within
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative g g1 (within (atreal x) s) ⟶ has_real_derivative (λx1. f x1 * g x1) (f x * g1 + f1 * g x) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_derivative_mul_atreal
  fixes f :: real ⇒ real, f1 :: real, g :: real ⇒ real, g1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) ⟶ has_real_derivative g g1 (atreal x) ⟶ has_real_derivative (λx1. f x1 * g x1) (f x * g1 + f1 * g x) (atreal x)
  [hint_backward,hint_backward1,hint_forward]
  proof
    2: rewrite_goal withinreal_univ sym=true
    2: rewrite_fact withinreal_univ @0 sym=true
    3: rewrite_fact withinreal_univ @1 sym=true
    4: apply_backward_step has_real_derivative_mul_within @2,3
  qed

theorem real_derivative_mul
  fixes f :: real ⇒ real, g :: real ⇒ real, x :: real
  prop real_differentiable f (atreal x) ⟶ real_differentiable g (atreal x) ⟶ real_derivative (λx1. f x1 * g x1) x = f x * real_derivative g x + real_derivative f x * g x

theorem has_real_derivative_pow_within
  fixes f :: real ⇒ real, f1 :: real, n :: nat, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative (λx1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (within (atreal x) s)
  [hint_backward]
  proof
    1: induction n nat_induct
    1: rewrite_goal real_zero_def sym=true
    1: rewrite_goal real_mul_lzero sym=false
    1: rewrite_goal real_mul_lzero sym=false
    1: rewrite_goal real_nat_power_def_1 sym=false
    1: apply_backward_step has_real_derivative_const
    6: introduction n
    6.2: rewrite_goal real_nat_power_def_2 sym=false
    6.2: apply_forward_step has_real_derivative_mul_within @0,6.1
    6.3: rewrite_goal suc_sub1 sym=false
    6.3: cut "!a::real. !b. !c. !d. a * (b * c *d) = b * (a * c) * d"
    6.3: z3
    6.4: rewrite_fact_with_prev @6.3,6.2
    6.5: rewrite_fact real_nat_power_def_2 @6.4 sym=true
    6.6: cases "n=0"
    6.6: introduction
    6.6.1: rewrite_goal_with_prev @6.6.0
    6.6.1: rewrite_goal real_nat_power_def_1 sym=false
    6.6.1: rewrite_goal nat_one_def sym=true
    6.6.1: rewrite_goal real_one_def sym=true
    6.6.1: rewrite_goal real_mul_lid sym=false
    6.6.1: rewrite_goal real_mul_lid sym=false
    6.6.1: rewrite_goal real_mult_comm sym=false
    6.6.1: rewrite_goal real_mul_lid sym=false
    6.6.1: rewrite_goal eta_conversion sym=false
    6.7: introduction
    6.7.1: cut "Suc (n-1) = n"
    6.7.1: rewrite_goal add_1_right sym=true
    6.7.1: apply_backward_step sub_add
    6.7.1: apply_backward_step le_1_2
    6.7.4: rewrite_fact_with_prev @6.7.3,6.5
    6.7.5: cut "!a::real. !b. !c. a * b * c + c * b = (a +1) * b * c"
    6.7.5: z3
    6.7.6: rewrite_fact_with_prev @6.7.5,6.7.4
    6.7.7: rewrite_fact real_one_def @6.7.6 sym=false
    6.7.8: rewrite_goal add_1_right sym=true
    6.7.8: rewrite_fact real_of_nat_add @6.7.7 sym=false
    6.7.9: rewrite_fact real_nat_power_def_2 @6.7.8 sym=false
  qed

