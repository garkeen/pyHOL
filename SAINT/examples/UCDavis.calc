theory  The Calculus Page Problems List (by D. A. Kouba)
imports  base

header  "L'Hopital's rule"  level = 1
calculation  "Problem 1"
  goal  LIM {x -> 1}. (x^2 - 1) / (x^2 + 3*x - 4)
calculation  "Problem 2"
  goal  LIM {x -> 4}. (x - 4) / (sqrt(x) - 2)
calculation  "Problem 3"
  goal  LIM {x -> 0}. sin(x) / x
calculation  "Problem 4"
  goal  LIM {x -> 0}. (3^x - 2^x) / (x^2 - x)
calculation  "Problem 5"
  goal  LIM {x -> 3}. (1/x - 1/3) / (x^2 - 9)
calculation  "Problem 6"
  goal  LIM {x -> 0}. x * tan(x) / sin(3*x)
header  "Exponential functions"  level = 1
calculation  "Problem 7"
  goal  (INT x:[0,1]. (3^x + 4^x) / 5^x) = (-2/5 / log(3/5) + -1/5 / log(4/5))
calculation  "Problem 8"
  goal  (INT x. 30 * exp(-3*x) * (1 + 3 * exp(-x)) ^ 5) = (-5/36)*(1 + 3*exp(-x))^8 + (20/63)*(1 + 3*exp(-x))^7 + (-5/27)*(1+3*exp(-x))^6 + SKOLEM_CONST(C)
calculation  "Problem 9"
  goal  (INT x. 8*exp(x)*(3+exp(x)) / sqrt(exp(2*x) + 6*exp(x) + 1)) = 8 * sqrt(exp(2 * x) + 6 * exp(x) + 1) + SKOLEM_CONST(C)
calculation  "Problem 10"
  goal  (INT x. (27*exp(9*x) + exp(12*x)) ^ (1/3)) = 1/4 * (27 + exp(3 * x)) ^ (4/3) + SKOLEM_CONST(C)
