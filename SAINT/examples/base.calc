theory  base

header  "Common integrals"  level = 1
theorem  "(INT x. c) = c * x + SKOLEM_CONST(C)"
theorem  "(INT x. x) = x ^ 2 / 2 + SKOLEM_CONST(C)"
theorem  "(INT x. 1 / x) = log(abs(x)) + SKOLEM_CONST(C)"
theorem  "(INT x. x ^ n) = x ^ (n + 1) / (n + 1) + SKOLEM_CONST(C)"  conds = [n != -1]
theorem  "(INT x. 1 / x ^ n) = 1 / (-((n - 1) * (x ^ (n - 1)))) + SKOLEM_CONST(C)"  conds = [n = 1]
theorem  "(INT x. sqrt(x)) = 2/3 * x ^ (3/2) + SKOLEM_CONST(C)"
theorem  "(INT x. 1 / sqrt(x)) = 2 * sqrt(x) + SKOLEM_CONST(C)"
theorem  "(INT x. exp(x)) = exp(x) + SKOLEM_CONST(C)"
theorem  "(INT x. exp(-x)) = -exp(-x) + SKOLEM_CONST(C)"
theorem  "(INT x. sin(x)) = -cos(x) + SKOLEM_CONST(C)"
theorem  "(INT x. cos(x)) = sin(x) + SKOLEM_CONST(C)"
theorem  "(INT x. 1 / (x^2 + 1)) = atan(x) + SKOLEM_CONST(C)"
theorem  "(INT x. sec(x)^2) = tan(x) + SKOLEM_CONST(C)"
theorem  "(INT x. csc(x)^2) = -cot(x) + SKOLEM_CONST(C)"
header  "Common series expansion"  level = 1
theorem  "exp(x) = SUM(n, 0, oo, x ^ n / factorial(n))"
theorem  "sin(x) = SUM(n, 0, oo, (-1)^n * x^(2*n+1) / factorial(2*n+1))"
theorem  "cos(x) = SUM(n, 0, oo, (-1)^n * x^(2*n) / factorial(2*n))"
theorem  "atan(x) = SUM(n, 0, oo, (-1)^n * x^(2*n+1) / (2*n+1))"  conds = [abs(x) <= 1]
theorem  "(1 + x) ^ -1 = SUM(n, 0, oo, (-1)^n * x ^ n)"  conds = [abs(x) < 1]
theorem  "log(1 + x) = SUM(n, 0, oo, (-1)^n * x ^ (n+1) / (n + 1))"  conds = [x > -1; x <= 1]
theorem  "log(1 - x) = SUM(n, 0, oo, (-1)^n * (-x)^(n+1) / (n + 1))"  conds = [x >= -1; x < 1]
header  "Common series evaluations"  level = 1
theorem  "SUM(n, 0, oo, 1 / (n+1)^2) = (pi^2) / 6"
theorem  "SUM(n, 0, oo, (-1)^n / (n+1)^2) = (pi^2) / 12"
header  "Common identities"  level = 1
header  "Absolute value"  level = 2
theorem  "abs(x) = x"  conds = [x >= 0]
theorem  "abs(x) = -x"  conds = [x <= 0]
header  "Hyperbolic functions"  level = 2
definition  "cosh(x) = (exp(x) + exp(-x)) / 2"
definition  "sinh(x) = (exp(x) - exp(-x)) / 2"
header  "Power identities"  level = 2
theorem  "(a * b) ^ k = a ^ k * b ^ k"  category = power
theorem  "a ^ x ^ y = a ^ (x*y)"  category = power
theorem  "x^a * x^b = x^(a+b)"  category = power
theorem  "(a / b) ^ k = a ^ k / b ^ k"  category = power
header  "Exp-log identities"  level = 2
theorem  "exp(a + b) = exp(a) * exp(b)"  category = exp-log
theorem  "exp(a - b) = exp(a) * exp(-b)"  category = exp-log
theorem  "log(a * b) = log(a) + log(b)"  category = exp-log
theorem  "exp(a) ^ b = exp(a*b)"  category = exp-log
theorem  "log(exp(x)) = x"  category = exp-log
theorem  "log(a / b) = log(a) - log(b)"  category = exp-log
theorem  "log(x ^ a) = a * log(x)"  category = exp-log
header  "Table of trigonometric values"  level = 2
table  sin
  "0" = "0"
  "-(2 * pi)" = "0"
  "-(pi / 2)" = "-1"
  "2 * pi / 3" = "sqrt(3) / 2"
  "3 * pi / 4" = "sqrt(2) / 2"
  "5 * pi / 6" = "1/2"
  "pi" = "0"
  "pi / 2" = "1"
  "pi / 3" = "sqrt(3) / 2"
  "pi / 4" = "sqrt(2) / 2"
  "pi / 6" = "1/2"
endtable
table  cos
  "0" = "1"
  "-(pi / 2)" = "0"
  "2 * pi / 3" = "-1/2"
  "3 * pi / 4" = "-(sqrt(2) / 2)"
  "5 * pi / 6" = "-(sqrt(3) / 2)"
  "pi" = "-1"
  "pi / 2" = "0"
  "pi / 3" = "1/2"
  "pi / 4" = "sqrt(2) / 2"
  "pi / 6" = "sqrt(3) / 2"
endtable
table  tan
  "0" = "0"
  "2 * pi / 3" = "-sqrt(3)"
  "3 * pi / 4" = "-1"
  "5 * pi / 6" = "-(sqrt(3) / 3)"
  "pi" = "0"
  "pi / 3" = "sqrt(3)"
  "pi / 4" = "1"
  "pi / 6" = "sqrt(3) / 3"
endtable
table  cot
  "2 * pi / 3" = "-(sqrt(3) / 3)"
  "3 * pi / 4" = "-1"
  "5 * pi / 6" = "-sqrt(3)"
  "pi / 2" = "0"
  "pi / 3" = "sqrt(3) / 3"
  "pi / 4" = "1"
  "pi / 6" = "sqrt(3)"
endtable
table  csc
  "2 * pi / 3" = "2 * sqrt(3) / 3"
  "3 * pi / 4" = "sqrt(2)"
  "5 * pi / 6" = "2"
  "pi / 2" = "1"
  "pi / 3" = "2 * sqrt(3) / 3"
  "pi / 4" = "sqrt(2)"
  "pi / 6" = "2"
endtable
table  sec
  "0" = "1"
  "2 * pi / 3" = "-2"
  "3 * pi / 4" = "-sqrt(2)"
  "5 * pi / 6" = "-(2 * sqrt(3) / 3)"
  "pi" = "-1"
  "pi / 3" = "2"
  "pi / 4" = "sqrt(2)"
  "pi / 6" = "2 * sqrt(3) / 3"
endtable
table  asin
  "0" = "0"
  "1" = "pi / 2"
  "-(sqrt(2) / 2)" = "-(pi / 4)"
  "-(sqrt(3) / 2)" = "-(pi / 3)"
  "-1" = "-(pi / 2)"
  "-1/2" = "-(pi / 6)"
  "1/2" = "pi / 6"
  "sqrt(2) / 2" = "pi / 4"
  "sqrt(3) / 2" = "pi / 3"
endtable
table  acos
  "0" = "pi / 2"
  "1" = "0"
  "-(sqrt(2) / 2)" = "3 * pi / 4"
  "-(sqrt(3) / 2)" = "5 * pi / 6"
  "-1" = "pi"
  "-1/2" = "2 * pi / 3"
  "1/2" = "pi / 3"
  "sqrt(2) / 2" = "pi / 4"
  "sqrt(3) / 2" = "pi / 6"
endtable
table  atan
  "0" = "0"
  "1" = "pi / 4"
  "-(sqrt(3) / 3)" = "-(pi / 6)"
  "-1" = "-(pi / 4)"
  "-sqrt(3)" = "-(pi / 3)"
  "sqrt(3)" = "pi / 3"
  "sqrt(3) / 3" = "pi / 6"
endtable
table  acot
  "0" = "pi / 2"
  "1" = "pi / 4"
  "-(sqrt(3) / 3)" = "2 * pi / 3"
  "-1" = "3 * pi / 4"
  "-sqrt(3)" = "5 * pi / 6"
  "sqrt(3)" = "pi / 6"
  "sqrt(3) / 3" = "pi / 3"
endtable
table  acsc
  "1" = "pi / 2"
  "2" = "pi / 6"
  "-(2 * sqrt(3) / 3)" = "-(pi / 3)"
  "-1" = "-(pi / 2)"
  "-2" = "-(pi / 6)"
  "-sqrt(2)" = "-(pi / 4)"
  "2 * sqrt(3) / 3" = "pi / 3"
  "sqrt(2)" = "pi / 4"
endtable
table  asec
  "1" = "0"
  "2" = "pi / 3"
  "-(2 * sqrt(3) / 3)" = "5 * pi / 6"
  "-1" = "pi"
  "-2" = "2 * pi / 3"
  "-sqrt(2)" = "3 * pi / 4"
  "2 * sqrt(3) / 3" = "pi / 6"
  "sqrt(2)" = "pi / 4"
endtable
header  "Trigonometric identities"  level = 2
theorem  "sin(-u) = -sin(u)"  category = trigonometric
theorem  "tan(x) = sin(x) / cos(x)"  category = trigonometric
theorem  "cos(-u) = cos(u)"  category = trigonometric
theorem  "sin(pi / 2 - u) = cos(u)"  category = trigonometric
theorem  "cos(pi / 2 - u) = sin(u)"  category = trigonometric
theorem  "sec(x)^2 = tan(x)^2 + 1"  category = trigonometric
theorem  "tan(a - b) = (tan(a) - tan(b)) / (1 + tan(a) * tan(b))"  category = trigonometric
theorem  "cos(pi - u) = -cos(u)"  category = trigonometric
theorem  "cos(2 * atan(z)) = (1 - z^2) / (1 + z^2)"  conds = [z>0; z<1]  category = trigonometric
theorem  "sin(2 * atan(z)) = (2 * z) / (1 + z^2)"  conds = [z>0; z<1]  category = trigonometric
theorem  "sin(pi - u) = sin(u)"  category = trigonometric
theorem  "cot(x) = cos(x) / sin(x)"  category = trigonometric
theorem  "1 / sin(x) ^ n = csc(x) ^ n"  conds = [n != 0]  category = trigonometric
theorem  "sin(x) ^ n = csc(x) ^ (-n)"  conds = [n != 0]  category = trigonometric
theorem  "sin(x)^2 = 1 - cos(x)^2"  category = trigonometric
theorem  "cos(x)^2 = 1 - sin(x)^2"  category = trigonometric
theorem  "cos(x)^2 = (1 + cos(2*x)) / 2"  category = trigonometric
theorem  "sin(x)^2 = (1 - cos(2*x)) / 2"  category = trigonometric
theorem  "cos(2*x) = 2 * cos(x)^2 - 1"  category = trigonometric
theorem  "cos(2*x) = 1 - 2 * sin(x) ^ 2"  category = trigonometric
theorem  "sin(2*x) = 2 * sin(x) * cos(x)"  category = trigonometric
theorem  "sin(a + b) = sin(a) * cos(b) + cos(a) * sin(b)"  category = trigonometric
theorem  "sin(a - b) = sin(a) * cos(b) - cos(a) * sin(b)"  category = trigonometric
theorem  "cos(a + b) = cos(a) * cos(b) - sin(a) * sin(b)"  category = trigonometric
theorem  "cos(a - b) = cos(a) * cos(b) + sin(a) * sin(b)"  category = trigonometric
theorem  "sin(a) + sin(b) = 2 * sin((a + b) / 2) * cos((a - b) / 2)"  category = trigonometric
theorem  "sin(a) - sin(b) = 2 * cos((a + b) / 2) * sin((a - b) / 2)"  category = trigonometric
theorem  "cos(a) + cos(b) = 2 * cos((a + b) / 2) * cos((a - b) / 2)"  category = trigonometric
theorem  "cos(a) - cos(b) = -2 * sin((a + b) / 2) * sin((a - b) / 2)"  category = trigonometric
theorem  "cos(a) * sin(b) = (1 / 2) * (sin(a + b) - sin(a - b))"  category = trigonometric
theorem  "sin(a) * cos(b) = (1 / 2) * (sin(a + b) + sin(a - b))"  category = trigonometric
theorem  "cos(a) * cos(b) = (1 / 2) * (cos(a - b) + cos(a + b))"  category = trigonometric
theorem  "sin(a) * sin(b) = -(1 / 2) * (cos(a - b) - cos(a + b))"  category = trigonometric
theorem  "sin(x)^2 = 1/2 - cos(2*x)/2"  category = trigonometric
theorem  "cos(x)^2 = 1/2 + cos(2*x)/2"  category = trigonometric
theorem  "atan(x ^ -1) = pi/2 - atan(x)"  category = trigonometric
theorem  "sin(acos(x)) = sqrt(1-x^2)"  category = trigonometric
header  "Factorial and binomial coefficient"  level = 2
theorem  "(m + 1) * factorial(m) = factorial(m + 1)"  category = factorial
theorem  "m * factorial(m - 1) = factorial(m)"  category = factorial
theorem  "binom(2*k+2, k+1) = 2 * binom(2*k, k) * ((2*k+1) / (k+1))"  category = binomial
header  "Derived integrals"  level = 1
theorem  "(INT x. 1 / (x + a)) = log(abs(x + a)) + SKOLEM_CONST(C)"
theorem  "(INT x. 1 / (a * x + b)) = log(abs(a * x + b)) / a + SKOLEM_CONST(C)"  conds = [a != 0]
theorem  "(INT x. x / (a * x ^ 2 + b)) = log(a * x ^ 2 + b) / (2 * a) + SKOLEM_CONST(C)"  conds = [a != 0]
theorem  "(INT x. exp(a * x)) = exp(a * x) / a + SKOLEM_CONST(C)"  conds = [a != 0]
theorem  "(INT x. sin(a * x)) = - (cos(a * x) / a) + SKOLEM_CONST(C)"  conds = [a != 0]
theorem  "(INT x. cos(a * x)) = sin(a * x) / a + SKOLEM_CONST(C)"  conds = [a != 0]
theorem  "(INT x. 1 / (a ^ 2 + x ^ 2)) = (1 / a) * atan(x / a) + SKOLEM_CONST(C)"  conds = [a != 0]
theorem  "(INT x. x ^ k * log(x)) = x ^ (k + 1) * log(x) / (k + 1) - x ^ (k + 1) / (k + 1) ^ 2 + SKOLEM_CONST(C)"  conds = [x > 0]
theorem  "(INT x:[0,1]. x ^ m * log(x) ^ n) = (-1)^n * factorial(n) / (m+1) ^ (n+1)"  conds = [m >= 0; n >= 0]
theorem  "(INT x:[0,oo]. exp(-(x * y)) * sin(a * x)) = a / (a ^ 2 + y ^ 2)"  conds = [y > 0]
theorem  "(INT x. a ^ x) = a ^ x / log(a) + SKOLEM_CONST(C)"
theorem  "(INT x. cos(x) ^ 2) = 1/4 * sin(2 * x) + 1/2 * x + SKOLEM_CONST(C)"
header  "Results from contour integration"  level = 1
theorem  "(INT x:[0, oo]. sin(m * x) / (x * (a ^ 2 + x ^ 2))) = (pi * (1 - exp(-a * m))) / (2 * a ^ 2)"  conds = [a > 0; m > 0]
theorem  "(INT x:[0, oo]. cos(a * x) / (x ^ 2 + b ^ 2)) = (pi / (2 * b)) * exp(-a * b)"  conds = [a > 0; b > 0]
theorem  "(INT x:[0, oo]. x ^ (m - 1) / (x + 1)) = pi / sin(m * pi)"
header  "Gamma and Beta function"  level = 1
theorem  "B(m,n) = Gamma(m) * Gamma(n) / Gamma(m+n)"  category = gamma-beta
theorem  "sec(x) = 1 / cos(x)"  category = trigonometric
theorem  "csc(x) = 1 / sin(x)"  category = trigonometric
theorem  "sec(x) ^ n = cos(x) ^ (-n)"  conds = [n != 0]  category = trigonometric
theorem  "csc(x) ^ n = sin(x) ^ (-n)"  conds = [n != 0]  category = trigonometric
theorem  "tan(x) ^ n = sin(x) ^ n / cos(x) ^ n"  conds = [n != 0]  category = trigonometric
theorem  "cot(x) ^ n = cos(x) ^ n / sin(x) ^ n"  conds = [n != 0]  category = trigonometric
theorem  "n = n * (sin(x)^2 + cos(x)^2)"  category = trigonometric
theorem  "sin(x) + cos(x) = sqrt(2) * sin(x + pi / 4)"  category = trigonometric
theorem  "sin(x) - cos(x) = -sqrt(2) * cos(x + pi / 4)"  category = trigonometric
theorem  "cos(2*x) = cos(x)^2 - sin(x)^2"  category = trigonometric
theorem  "1 / cos(x) ^ n = sec(x) ^ n"  conds = [n != 0]  category = trigonometric
theorem  "cos(x) ^ n = sec(x) ^ (-n)"  conds = [n != 0]  category = trigonometric
theorem  "1 + tan(x)^2 = sec(x)^2"  category = trigonometric
theorem  "1 + cot(x)^2 = csc(x)^2"  category = trigonometric
theorem  "tan(x)^2 = sec(x)^2 - 1"  category = trigonometric
theorem  "cot(x)^2 = csc(x)^2 - 1"  category = trigonometric