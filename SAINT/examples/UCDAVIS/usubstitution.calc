
calculation  "Exercise 1"
  goal  INT x:[0, 1]. (2*x + 5)*(x^2+5*x)^7
  calc
    substitute  f = u ^ 7, g = x ^ 2 + 5 * x, var_name = u
    simplify
  qed

calculation  "Exercise 2"
  goal  INT x:[0, 1]. (3 - x)^10
  calc
    substitute  f = -(u ^ 10), g = 3 - x, var_name = u
    simplify
  qed

calculation  "Exercise 3"
  goal  INT x:[0, 1]. sqrt(7*x+9)
  calc
    simplify
    substitute  f = sqrt(9 + 7 * (u / 7 - 9/7)) * (1/7), g = 9 + 7 * x, var_name = u
    simplify
  qed

calculation  "Exercise 4"
  goal  INT x:[0, 1]. x^3/(1+x^4)^(1/4)
  calc
    simplify
    substitute  f = 1 / (4 * (u + 1) ^ (1/4)), g = x ^ 4, var_name = u
    simplify
    substitute  f = (1 + (v - 1)) ^ (-1/4) * 1, g = 1 + u, var_name = v, at 1
    simplify  at 1
    simplify
  qed

calculation  "Exercise 5"
  goal  INT x:[0, 1].exp(5*x+2)
  calc
    simplify
    substitute  f = exp(2 + 5 * (u / 5 - 2/5)) * (1/5), g = 2 + 5 * x, var_name = u
    simplify
  qed

calculation  "Exercise 6"
  goal  INT x:[0, pi/6]. 4*cos(3*x)
  calc
    simplify
  qed

calculation  "Exercise 7"
  goal  INT x:[1, exp(2*pi)]. sin(log(x)) / x
  calc
    simplify
    substitute  f = sin(u), g = log(x), var_name = u
    simplify
  qed

calculation  "Exercise 8"
  goal  INT x:[1, 2]. (3*x+6)/(x^2 + 4 * x - 3)
  calc
    rewrite  rhs = (x+2)*(x+2)-7, at 0.1
    substitute  f = ((3 * (u - 2) + 6) / (((u - 2) + 2) * ((u - 2) + 2) - 7)) * 1, g = x + 2, var_name = u
    substitute  f = 3 * sqrt(v + 7) * (-7 + sqrt(v + 7) ^ 2) ^ -1 * (1/2 * (7 + v) ^ (-1/2)), g = -7 + u ^ 2, var_name = v
    simplify
  qed

calculation  "Exercise 9"
  goal  INT x:[0, 1]. x*3^(x^2 + 1)
  calc
  qed

calculation  "Exercise 10"
  goal  INT x:[exp(1), exp(2)]. 3/(x*log(x))
  calc
    simplify
    substitute  f = 1 / u, g = log(x), var_name = u, at 1
    simplify  at 1
  qed

calculation  "Exercise 11"
  goal  INT x:[0, pi/10]. cos(5*x)/exp(sin(5*x))
  calc
    substitute  f = exp(-u) / 5, g = sin(5 * x), var_name = u
    simplify
  qed

calculation  "Exercise 12"
  goal  INT x:[0, sqrt(pi)]. x * sin(x^2)
  calc
    substitute  f = sin(u) / 2, g = x ^ 2, var_name = u
    simplify
  qed

calculation  "Exercise 13"
  goal  INT x:[0, 1]. (x + 3) * (x - 1) ^ 5
  calc
    substitute  f = (u + 1 + 3) * ((u + 1) - 1) ^ 5 * 1, g = x - 1, var_name = u
    simplify
  qed

calculation  "Exercise 14"
  goal  INT x:[0, 4].x*sqrt(4-x)
  calc
    substitute  f = (4 - u) * sqrt(4 - (4 - u)) * -1, g = 4 - x, var_name = u
    simplify
  qed

calculation  "Exercise 15"
  goal  INT x:[0, 1]. (x+5)/(2*x + 3)
  calc
    rewrite_fraction  rhs = 1/2 + 7 / (2 * (2 * x + 3)), at 0
    simplify
  qed

calculation  "Exercise 16"
  goal  INT x:[0, 1]. (x^2+4)/(x+2)
  calc
    rewrite_fraction  denom = x + 2, rhs = (x - 2) + 8 / (x + 2), at 0
    simplify
  qed

calculation  "Exercise 17"
  goal  INT x:[1, exp(2)]. ((3+log(x))^2 * (2 - log(x)))/(4 * x)
  calc
    substitute  f = ((2 - u) * (u + 3) ^ 2) / 4, g = log(x), var_name = u
    unfold_power  at 0.0.1
    unfold_power  at 0.1.1
    simplify
  qed

calculation  "Exercise 18"
  goal  INT x:[0, 9]. sqrt(4 - sqrt(x))
  calc
    substitute  f = 2 * u * sqrt(4 - u), g = sqrt(x), var_name = u
    substitute  f = 2 * (4 - v) * sqrt(4 + -(4 - v)) * -1, g = 4 + -u, var_name = v
    simplify
  qed
