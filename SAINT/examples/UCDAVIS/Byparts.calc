
calculation  "Exercise 1"
  goal  INT x:[0, 1]. x*exp(x)
  calc
    integrate_by_parts  parts_u = x, parts_v = exp(x)
    simplify
  qed

calculation  "Exercise 2"
  goal  INT x:[0, pi/2]. x * sin(x)
  calc
    integrate_by_parts  parts_u = x, parts_v = -cos(x)
    simplify
  qed

calculation  "Exercise 3"
  goal  INT x:[1, exp(1)]. x * log(x)
  calc
    integrate_by_parts  parts_u = log(x)/2, parts_v = x^2
    simplify
  qed

calculation  "Exercise 4"
  goal  INT x:[0, pi/4]. x * cos(3*x)
  calc
    substitute  f = (u / 3) * cos(3 * (u / 3)) * (3 / 9), g = 3 * x, var_name = u
    simplify
    integrate_by_parts  parts_u = u, parts_v = sin(u), at 1
    simplify
  qed

calculation  "Exercise 5"
  goal  INT x:[1, exp(1)]. log(x)/x^5
  calc
    integrate_by_parts  parts_u = log(x), parts_v = -1/(4 * x^4)
    simplify
  qed

calculation  "Exercise 6"
  goal  INT x:[0, 1/3]. asin(3*x)
  calc
  qed

calculation  "Exercise 7"
  goal  INT x:[1, exp(1)]. log(x)
  calc
    integrate_by_parts  parts_u = log(x), parts_v = x
    simplify
  qed

calculation  "Exercise 8"
  goal  INT x:[0, 1]. 2*x*atan(x)
  calc
    integrate_by_parts  parts_u = atan(x), parts_v = x^2
    simplify
  qed

calculation  "Exercise 9"
  goal  INT x:[1, 2]. x^2*exp(3*x)
  calc
    integrate_by_parts  parts_u = x^2/3, parts_v = exp(3*x)
    simplify
    integrate_by_parts  parts_u = x/3, parts_v = exp(3*x), at 1.1
    simplify
  qed

calculation  "Exercise 10"
  goal  INT x:[1, exp(1)]. x^3*log(5*x)
  calc
    integrate_by_parts  parts_u = log(5*x)/4, parts_v = x ^ 4
    simplify
  qed

calculation  "Exercise 11"
  goal  INT x:[1, exp(1)]. log(x) ^ 2
  calc
    integrate_by_parts  parts_u = log(x)^2, parts_v = x
    simplify
    integrate_by_parts  parts_u = log(x), parts_v = x, at 1.1
    simplify
  qed

calculation  "Exercise 12"
  goal  INT x:[1, exp(1)]. log(x) ^ 3
  calc
    integrate_by_parts  parts_u = log(x)^3, parts_v = x
    integrate_by_parts  parts_u = 3 * log(x) ^ 2, parts_v = x, at 1
    integrate_by_parts  parts_u = 6 * log(x), parts_v = x, at 1.1
    simplify
  qed

calculation  "Exercise 13"
  goal  INT x:[-2, 1]. x * sqrt(x + 3)
  calc
    integrate_by_parts  parts_u = x, parts_v = 2/3 * (x + 3) ^ (3/2)
    simplify
    substitute  f = (3 + (u - 3)) ^ (3/2) * 1, g = 3 + x, var_name = u, at 1.1
    simplify
  qed

calculation  "Exercise 14"
  goal  INT x:[0, pi/4]. x * sin(x) * cos(x)
  calc
    integrate_by_parts  parts_u = x, parts_v = 1/2 * sin(x) ^ 2
    simplify
    rewrite_trigonometric  rule = TR8, at 1.1.0
    simplify
    substitute  f = cos(u) / 2, g = 2 * x, var_name = u, at 1
    simplify
  qed

calculation  "Exercise 15"
  goal  INT x:[1, exp(1)]. (log(x)/x)^2
  calc
    simplify
    integrate_by_parts  parts_u = log(x)^2, parts_v = -1/x
    simplify
    integrate_by_parts  parts_u = log(x), parts_v = -1/x, at 1.1
    simplify
  qed

calculation  "Exercise 16"
  goal  INT x:[0, 1]. x ^ 5 * exp(x ^ 3)
  calc
    integrate_by_parts  parts_u = x ^ 3, parts_v = exp(x ^ 3)/3
    simplify
    substitute  f = exp(u) / 3, g = x ^ 3, var_name = u, at 1.0
    simplify
  qed

calculation  "Exercise 17"
  goal  INT x:[0, pi/4]. x ^ 3 * cos(x ^ 2)
  calc
    integrate_by_parts  parts_u = x ^ 2, parts_v = sin(x ^ 2)/2
    simplify
    substitute  f = sin(u) / 2, g = x ^ 2, var_name = u, at 1.0
    simplify
  qed

calculation  "Exercise 18"
  goal  INT x:[0, 1]. x ^ 7 * sqrt(5 + 3 * x ^ 4)
  calc
    integrate_by_parts  parts_u = x ^ 4, parts_v = (1/18)*(5 + 3*x^4)^(3/2)
    simplify
    substitute  f = u ^ (3/2) / 12, g = 3 * x ^ 4 + 5, var_name = u, at 1.1
    simplify
  qed

calculation  "Exercise 19"
  goal  INT x:[1, 2]. x ^ 3 / (x ^ 2 + 5) ^ 2
  calc
    integrate_by_parts  parts_u = x^2/2, parts_v = -1/(x^2+5)
    simplify
    substitute  f = 1 / (2 * u), g = x ^ 2 + 5, var_name = u, at 1
    simplify
  qed

calculation  "Exercise 20"
  goal  INT x:[0, 1]. exp(6 * x) * sin(exp(3 * x))
  calc
    integrate_by_parts  parts_u = exp(3*x), parts_v = -cos(exp(3*x))/3
    simplify
    substitute  f = cos(u) / 3, g = exp(3 * x), var_name = u, at 1
    simplify
  qed

calculation  "Exercise 21"
  goal  INT x:[0, 1]. (x ^ 3 * exp(x^2))/(x^2 + 1) ^ 2
  calc
    integrate_by_parts  parts_u = x^2*exp(x^2)/2, parts_v = -1/(x^2+1)
    rewrite  rhs = -x*exp(x^2), at 1.0
    substitute  f = -exp(u) / 2, g = x ^ 2, var_name = u, at 1
    simplify
  qed

calculation  "Exercise 22"
  goal  INT x:[0, 1]. exp(x) * cos(x)
  calc
    integrate_by_parts  parts_u = exp(x), parts_v = sin(x)
    simplify
    integrate_by_parts  parts_u = exp(x), parts_v = -cos(x), at 1.0
    simplify
    solve_equation  factor = 1, prev_id = 0
  qed

calculation  "Exercise 23"
  goal  INT x:[0, pi/4]. sin(3*x)*cos(5*x)
  calc
    rewrite_trigonometric  rule = TR8, at 0
    simplify
    substitute  f = sin(u) / 2, g = 2 * x, var_name = u, at 0.1
    substitute  f = sin(u) / 8, g = 8 * x, var_name = u, at 1.1
    simplify
  qed
