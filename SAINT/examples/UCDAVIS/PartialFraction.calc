
calculation  "Exercise 1"
  goal  INT x:[3, 4]. 1 / (x ^ 2 - 4)
  calc
    rewrite_fraction  rhs = -1 / (4 * (x + 2)) + 1 / (4 * (x - 2)), at 0
    simplify
  qed

calculation  "Exercise 2"
  goal  INT x:[1, 2]. (2 * x + 3) / (x ^ 2 - 9)
  calc
    rewrite_fraction  rhs = 1 / (2 * (x + 3)) + 3 / (2 * (x - 3)), at 0
    simplify
  qed

calculation  "Exercise 3"
  goal  INT x:[1, 2]. (2 - x) / (x ^ 2 + 5 * x)
  calc
    rewrite_fraction  rhs = -7 / (5 * (x + 5)) + 2 / (5 * x), at 0
    simplify
  qed

calculation  "Exercise 4"
  goal  INT x:[1, 2]. (x^2 - 1) / (x^2 - 16)
  calc
    rewrite_fraction  rhs = (1 - 15 / (8 * (x + 4))) + 15 / (8 * (x - 4)), at 0
    simplify
  qed

calculation  "Exercise 5"
  goal  INT x:[3, 4]. (x^4 + x^3 + x^2 + 1)/(x^2 + x - 2)
  calc
    rewrite_fraction  rhs = ((x ^ 2 + 3) - 13 / (3 * (x + 2))) + 4 / (3 * (x - 1)), at 0
    simplify
  qed

calculation  "Exercise 6"
  goal  INT x:[2, 4]. (x^2 + x - 1) / (x * (x^2 - 1))
  calc
    rewrite_fraction  denom = x * (x ^ 2 - 1), rhs = -1 / (2 * (x + 1)) + 1 / (2 * (x - 1)) + 1 / x, at 0
    simplify
  qed

calculation  "Exercise 7"
  goal  INT x:[2, 4]. (x + 7) / (x ^ 2 * (x + 2))
  calc
    rewrite_fraction  denom = x ^ 2 * (x + 2), rhs = (5 / (4 * (x + 2)) - 5 / (4 * x)) + 7 / (2 * x ^ 2), at 0
    simplify
  qed

calculation  "Exercise 8"
  goal  INT x:[2, 4]. (x^5 + 1) / (x ^ 3 * (x + 2))
  calc
    rewrite_fraction  denom = x ^ 3 * (x + 2), rhs = (((x - 2) + 31 / (8 * (x + 2)) + 1 / (8 * x)) - 1 / (4 * x ^ 2)) + 1 / (2 * x ^ 3), at 0
    simplify
  qed

calculation  "Exercise 9"
  goal  INT x:[0, 1]. (x ^ 2 - x + 1) / (x + 1)^3
  calc
    rewrite_fraction  rhs = (1 / (x + 1) - 3 / (x + 1) ^ 2) + 3 / (x + 1) ^ 3, at 0
    substitute  f = (1 / u - 3 / u ^ 2) + 3 / u ^ 3, g = x + 1, var_name = u
    simplify
  qed

calculation  "Exercise 10"
  goal  INT x:[2, 3]. (x^3 + 4) / ((x ^ 2 - 1) * (x ^ 2 + 3 * x + 2))
  calc
    rewrite_fraction  rhs = (4 / (3 * (x + 2)) - 3 / (4 * (x + 1)) - 3 / (2 * (x + 1) ^ 2)) + 5 / (12 * (x - 1)), at 0
    simplify
    substitute  f = (1 + (u - 1)) ^ -2 * 1, g = 1 + x, var_name = u, at 0.0.0.1
    substitute  f = (-12 + 12 * (u / 12 + 1)) ^ -1 * (1/12), g = -12 + 12 * x, var_name = u, at 0.0.1.1
    substitute  f = (4 + 4 * (u / 4 - 1)) ^ -1 * (1/4), g = 4 + 4 * x, var_name = u, at 0.1.1
    substitute  f = (6 + 3 * (u / 3 - 2)) ^ -1 * (1/3), g = 6 + 3 * x, var_name = u, at 1.1
    simplify
  qed

calculation  "Exercise 11"
  goal  INT x:[3, 4]. (x ^ 3 + 2 * x - 1) / (x ^ 2 - x - 2) ^ 2
  calc
    rewrite_fraction  rhs = (7 / (27 * (x + 1)) - 4 / (9 * (x + 1) ^ 2)) + 20 / (27 * (x - 2)) + 11 / (9 * (x - 2) ^ 2), at 0
    simplify
    substitute  f = u ^ -2, g = x - 2, var_name = u, at 0.0.0.1
    substitute  f = (1 + (u - 1)) ^ -2 * 1, g = 1 + x, var_name = u, at 0.0.1.1
    substitute  f = (27 + 27 * (u / 27 - 1)) ^ -1 * (1/27), g = 27 + 27 * x, var_name = u, at 1.1
    substitute  f = (-54 + 27 * (u / 27 + 2)) ^ -1 * (1/27), g = -54 + 27 * x, var_name = u, at 0.1.1
    simplify
  qed

calculation  "Exercise 12"
  goal  INT x:[pi/12, pi/6]. sec(x) ^ 2 / (tan(x) ^ 3 - tan(x) ^ 2)
  calc
    substitute  f = 1 / (u ^ 3 - u ^ 2), g = tan(x), var_name = u
    rewrite  rhs = 1/(u-1) - 1/u - 1/u^2, at 0
    simplify
    substitute  f = 1 / v, g = u - 1, var_name = v, at 1
    simplify
  qed

calculation  "Exercise 13"
  goal  INT x:[3, 4]. (x ^ 3 + 8) / ((x ^ 2 - 1) * (x - 2))
  calc
    rewrite_fraction  rhs = ((1 + 7 / (6 * (x + 1))) - 9 / (2 * (x - 1))) + 16 / (3 * (x - 2)), at 0
    simplify
    substitute  f = (-6 + 3 * (u / 3 + 2)) ^ -1 * (1/3), g = -6 + 3 * x, var_name = u, at 0.0.1.1
    substitute  f = (-2 + 2 * (u / 2 + 1)) ^ -1 * (1/2), g = -2 + 2 * x, var_name = u, at 0.1.1
    substitute  f = (6 + 6 * (u / 6 - 1)) ^ -1 * (1/6), g = 6 + 6 * x, var_name = u, at 1.1
    simplify
  qed

calculation  "Exercise 14"
  goal  INT x:[1, 2]. exp(x) / ((exp(x) - 1) * (exp(x) + 3))
  calc
    substitute  f = 1 / ((u - 1) * (u + 3)), g = exp(x), var_name = u
    rewrite  rhs = (u+1)*(u+1)-4, at 0.0
    substitute  f = 1 / (v ^ 2 - 4), g = u + 1, var_name = v
    rewrite  rhs = 1/(4*v-8) - 1/(4*v+8), at 0
    simplify
    substitute  f = (-8 + 4 * (u / 4 + 2)) ^ -1 * (1/4), g = -8 + 4 * v, var_name = u, at 0
    substitute  f = (8 + 4 * (u / 4 - 2)) ^ -1 * (1/4), g = 8 + 4 * v, var_name = u, at 1.0
    simplify
  qed

calculation  "Exercise 15"
  goal  INT x:[0, 1]. 1 / (exp(x) + 1)
  calc
    rewrite  denom = exp(x) + 1, rhs = exp(x) / (exp(x) * (exp(x)+1)), at 0
    substitute  f = (exp(log(u)) / (exp(log(u)) * (exp(log(u)) + 1))) * u ^ -1, g = exp(x), var_name = u
    rewrite  rhs = 1/u - 1/(u+1), at 0
    simplify
    substitute  f = (1 + (v - 1)) ^ -1 * 1, g = 1 + u, var_name = v, at 1.0
    simplify
  qed

calculation  "Exercise 16"
  goal  INT x:[1, 2]. (3 - x) / (x * (x ^2 + 1))
  calc
    rewrite_fraction  rhs = -(3 * x + 1) / (x ^ 2 + 1) + 3 / x, at 0
    simplify
    substitute  f = 1 / (2 * u), g = x ^ 2 + 1, var_name = u, at 1.1
    simplify
  qed

calculation  "Exercise 17"
  goal  INT x:[1, 2]. (3 * x + 1) / (x ^ 2 * (x ^ 2 + 25))
  calc
    rewrite_fraction  rhs = -(3 * x + 1) / (25 * (x ^ 2 + 25)) + 3 / (25 * x) + 1 / (25 * x ^ 2), at 0
    simplify
    substitute  f = 1 / (50 * u), g = 25 * x ^ 2 + 625, var_name = u, at 1.1
    simplify
    substitute  f = (625 + 25 * (5 * u) ^ 2) ^ -1 * 5, g = x / 5, var_name = u, at 1.0
    rewrite  denom = (625 + 625 * u ^ 2) ^ -1, rhs = 1/125 * (1/(1+u^2)), at 1.0.0
    simplify
  qed

calculation  "Exercise 18"
  goal  INT x:[0, 1]. 1 / (x ^ 4 - 16)
  calc
    rewrite_fraction  rhs = (-1 / (8 * (x ^ 2 + 4)) - 1 / (32 * (x + 2))) + 1 / (32 * (x - 2)), at 0
    simplify
    substitute  f = (-64 + 32 * (u / 32 + 2)) ^ -1 * (1/32), g = -64 + 32 * x, var_name = u, at 0.0
    substitute  f = (64 + 32 * (u / 32 - 2)) ^ -1 * (1/32), g = 64 + 32 * x, var_name = u, at 0.1.0
    substitute  f = (32 + 8 * (2 * u) ^ 2) ^ -1 * 2, g = x / 2, var_name = u, at 1.0
    simplify
    rewrite  rhs = 1/32 * (1/(1+u^2)), at 1.1.0
    simplify
  qed

calculation  "Exercise 19"
  goal  INT x:[pi/6, pi/3]. cos(x) / (sin(x) ^ 3 + sin(x))
  calc
    substitute  f = 1 / (u ^ 3 + u), g = sin(x), var_name = u
    rewrite  rhs = -u/(u^2+1) + 1/u, at 0
    simplify
    substitute  f = 1 / (2 * v), g = u ^ 2 + 1, var_name = v, at 1.0
    simplify
  qed

calculation  "Exercise 20"
  goal  INT x:[0, 1]. 1 / (x ^ 4 + 4)
  calc
    rewrite_fraction  rhs = (x ^ 2 + 2) ^ 2 - 4 * x ^ 2, at 0.1
    rewrite_fraction  rhs = -(x - 2) / (8 * ((x ^ 2 - 2 * x) + 2)) + (x + 2) / (8 * (x ^ 2 + 2 * x + 2)), at 0
    simplify
    rewrite  rhs = 8*((x-1)*(x-1)+1), at 0.0.0.1.0.0
    substitute  f = 1 / (8 * u ^ 2 + 8), g = x - 1, var_name = u, at 0.0.0.1
  qed
