
problem  "Exercise 1"
  goal  INT x:[1, 2]. (3 + x^2)/x
  calc
    rewrite_fraction  denom = x, rhs = x + 3 / x, at 0
    simplify
  qed

problem  "Exercise 2"
  goal  INT x:[0, 1]. 7/(x + 5)
  calc
    substitute  f = 7 / u, g = x + 5, var_name = u
    simplify
  qed

problem  "Exercise 3"
  goal  INT x:[-1, 1]. 3/(x^2 + 4)
  calc
    substitute  f = (3 / ((2 * u) ^ 2 + 4)) * 2, g = x / 2, var_name = u
    simplify
    rewrite  rhs = 1/4 * (1 / (1 + u^2)), at 1.0
    simplify
  qed

problem  "Exercise 4"
  goal  INT x:[-1, 0]. x/(x^2 + 4)
  calc
    substitute  f = 1 / (2 * u), g = x ^ 2 + 4, var_name = u
    simplify
  qed

problem  "Exercise 5"
  goal  INT x:[-1, 1].  x^3/(x + 2)
  calc
    rewrite_fraction  rhs = ((x ^ 2 - 2 * x) + 4) - 8 / (x + 2), at 0
    simplify
  qed

problem  "Exercise 6"
  goal  INT x:[-1, 1]. (x^4 + x^3)/(x^2 + 1)
  calc
    rewrite_fraction  rhs = (x ^ 2 + x) - (x - 1) / (x ^ 2 + 1) - 1, at 0
    simplify
    split_region  c = 0, at 1.0
    substitute  f = 1 / (2 * u), g = x ^ 2 + 1, var_name = u, at 1.0.0
    substitute  f = 1 / (2 * u), g = x ^ 2 + 1, var_name = u, at 1.0.1
    simplify
  qed

problem  "Exercise 7"
  goal  INT x:[1, exp(1)]. 1 / (x * (3 + log(x)))
  calc
    substitute  f = 1 / u, g = log(x) + 3, var_name = u
    simplify
  qed

problem  "Exercise 8"
  goal  INT x:[1, exp(1)]. (7 - log(x))/(x * (3 + log(x)))
  calc
    substitute  f = (7 - u) / (u + 3), g = log(x), var_name = u
    simplify
  qed

problem  "Exercise 9"
  goal  INT x:[0, 1]. 1 / (x^2 + 4 * x + 5)
  calc
    rewrite  rhs = (x+2)*(x+2)+1, at 0.1
    substitute  f = 1 / (u ^ 2 + 1), g = x + 2, var_name = u
    simplify
  qed

problem  "Exercise 10"
  goal  INT x:[1, 2]. 1 / (2*x^2 + 12*x + 68)
  calc
    rewrite  rhs = 2 * (x + 3) * (x + 3) + 50, at 0.1
    substitute  f = (1 / (2 * ((u - 3) + 3) * ((u - 3) + 3) + 50)) * 1, g = x + 3, var_name = u
    substitute  f = (50 + 2 * (5 * v) ^ 2) ^ -1 * 5, g = u / 5, var_name = v
    rewrite  denom = (50 + 50 * v ^ 2) ^ -1, rhs = 1/10 * 1 / (1 + v^2), at 0
    simplify
  qed

problem  "Exercise 11"
  goal  INT x:[9, 16]. 1 / (sqrt(x) * (x + 9))
  calc
    substitute  f = (1 / (sqrt(u ^ 2) * (u ^ 2 + 9))) * (2 * u), g = sqrt(x), var_name = u
    simplify
    elim_abs  at 1
    simplify
    rewrite_fraction  rhs = 1 / (u ^ 2 + 9), at 1.0
    substitute  f = (1 / ((3 * v) ^ 2 + 9)) * 3, g = u / 3, var_name = v, at 1
    rewrite  denom = (9 + 9 * v ^ 2) ^ -1, rhs = 1/3 * (1 / (1 + v^2)), at 1.0
    simplify
  qed

problem  "Exercise 12"
  goal  INT x:[0, pi/4]. sin(2*x)/(1 + cos(2*x))
  calc
    substitute  f = -1 / (2 * u), g = cos(2 * x) + 1, var_name = u
    simplify
  qed

problem  "Exercise 13"
  goal  INT x:[0, pi/2]. cos(x) / (1 + sin(x) ^ 2)
  calc
    substitute  f = 1 / (u ^ 2 + 1), g = sin(x), var_name = u
    simplify
  qed

problem  "Exercise 14"
  goal  INT x:[0, 1]. exp(2*x)/(1 + exp(2*x))
  calc
    substitute  f = 1 / (2 * (u + 1)), g = exp(2 * x), var_name = u
    substitute  f = (2 + 2 * (v / 2 - 1)) ^ -1 * (1/2), g = 2 + 2 * u, var_name = v
    simplify
  qed

problem  "Exercise 15"
  goal  INT x:[0, 1]. exp(x)/(1 + exp(2*x))
  calc
    rewrite  rhs = exp(x)*exp(x), at 0.1.1
    substitute  f = (exp(log(u)) / (1 + exp(log(u)) * exp(log(u)))) * u ^ -1, g = exp(x), var_name = u
    simplify
  qed

problem  "Exercise 16"
  goal  INT x:[0, 1]. exp(4*x)/(1 + exp(2*x))
  calc
    substitute  f = u / (2 * (u + 1)), g = exp(2 * x), var_name = u
    rewrite_fraction  rhs = 1/2 - 1 / (2 * (u + 1)), at 0
    simplify
  qed

problem  "Exercise 17"
  goal  INT x:[0, 1]. x / (x^2 + 2 * x + 1)
  calc
    rewrite  rhs = (x+1)*(x+1), at 0.1
    substitute  f = ((u - 1) / (((u - 1) + 1) * ((u - 1) + 1))) * 1, g = x + 1, var_name = u
    simplify
  qed

problem  "Exercise 18"
  goal  INT x:[0, 1]. x / (x ^ 2 + 2 * x + 5)
  calc
    rewrite  rhs = (x+1)*(x+1)+4, at 0.1
    substitute  f = ((u - 1) / (((u - 1) + 1) * ((u - 1) + 1) + 4)) * 1, g = x + 1, var_name = u
    simplify
    substitute  f = 1 / (2 * v), g = u ^ 2 + 4, var_name = v, at 1
    substitute  f = (4 + (2 * v) ^ 2) ^ -1 * 2, g = u / 2, var_name = v, at 0.0
    rewrite  denom = (4 + 4 * v ^ 2) ^ -1, rhs = 1/2 * (1/(1+v^2)), at 0.0.0
    simplify
  qed

problem  "Exercise 19"
  goal  INT x:[-1, 1]. (7 * x - 2)/(2*x^2 - 16 * x + 42)
  calc
    rewrite  rhs = 2*(x-4)*(x-4)+10, at 0.1
    substitute  f = ((7 * (u + 4) - 2) / (2 * ((u + 4) - 4) * ((u + 4) - 4) + 10)) * 1, g = x - 4, var_name = u
    simplify
    substitute  f = 1 / (4 * v), g = 2 * u ^ 2 + 10, var_name = v, at 1.1
    simplify
    substitute  f = (10 + 2 * (sqrt(5) * v) ^ 2) ^ -1 * sqrt(5), g = u / sqrt(5), var_name = v, at 1.1
    rewrite  denom = (10 + 10 * v ^ 2) ^ -1, rhs = sqrt(5)/10 * (1/(1+v^2)), at 1.1.0
    simplify
  qed

problem  "Exercise 20"
  goal  INT x:[0, 1]. 1 / (1 + exp(2*x))
  calc
    rewrite  denom = 1 + exp(2 * x), rhs = exp(-2*x)/(exp(-2*x)+1), at 0
    substitute  f = -1 / (2 * u), g = 1 + exp(-2 * x), var_name = u
    simplify
  qed

problem  "Exercise 21"
  goal  INT x:[0, 1]. exp(3*x)/(1 + exp(2*x))
  calc
    rewrite  denom = 1 + exp(2 * x), rhs = exp(x)*exp(x)*exp(x) / (1+exp(x)*exp(x)), at 0
    substitute  f = ((exp(log(u)) * exp(log(u)) * exp(log(u))) / (1 + exp(log(u)) * exp(log(u)))) * u ^ -1, g = exp(x), var_name = u
    rewrite_fraction  rhs = 1 - 1 / (u ^ 2 + 1), at 0
    simplify
  qed

problem  "Exercise 22"
  goal  INT x:[1, 4]. (9 + 6*sqrt(x) + x)/(4*sqrt(x) + x)
  calc
    rewrite_fraction  rhs = sqrt(x) * (4 + sqrt(x)), at 0.1
    substitute_inverse  a = 3, b = 2, g = (u - 4) ^ 2, var_name = u
    substitute  f = (2 * t * (t ^ 2 + 6 * sqrt(t ^ 2) + 9)) / ((sqrt(t ^ 2) + 4) * sqrt(t ^ 2)), g = u - 4, var_name = t
    simplify
    substitute  f = -1 / y, g = 4 - t, var_name = y, at 0.0.1
    substitute  f = (y - 4) / y, g = 4 - t, var_name = y, at 0.1.1
    substitute  f = -(4 - y) ^ 2 / y, g = 4 - t, var_name = y, at 1.1
    simplify
    unfold_power  at 1.1.0.1
    simplify
  qed
