
problem  "Exercise 1"
  goal  INT x:[0, pi/2]. sin(3*x)
  calc
    substitute  f = sin(u) / 3, g = 3 * x, var_name = u
    simplify
  qed

problem  "Exercise 2"
  goal  INT x:[0, pi/20]. tan(5*x)
  calc
    substitute  f = tan(u) / 5, g = 5 * x, var_name = u
    simplify
    rewrite_trigonometric  rule = TR2, at 1.0
    substitute  f = -1 / v, g = cos(u), var_name = v, at 1
    simplify
  qed

problem  "Exercise 3"
  goal  INT x:[0, pi/12]. 5 * sec(4*x) * tan(4*x)
  calc
    simplify
    substitute  f = 1/4, g = sec(4 * x), var_name = u, at 1
    simplify  at 1
    simplify
  qed

problem  "Exercise 4"
  goal  INT x:[0, pi/2]. (sin(x) + cos(x)) ^ 2
  calc
    rewrite_trigonometric  rule = TR10i, at 0.0
    simplify
    substitute  f = sin(1/4 * pi + (u - pi / 4)) ^ 2 * 1, g = 1/4 * pi + x, var_name = u, at 1
    rewrite_trigonometric  rule = TR8, at 1.0
    simplify
  qed

problem  "Exercise 5"
  goal  INT x:[0, pi/2]. 3 * cos(5 * x) ^ 2
  calc
    simplify
    substitute  f = cos(u) ^ 2 / 5, g = 5 * x, var_name = u, at 1
    simplify
  qed

problem  "Exercise 6"
  goal  INT x:[0, pi/4]. (2 + tan(x)) ^ 2
  calc
    unfold_power  at 0
    simplify
    rewrite_trigonometric  rule = TR2, at 0.1.1.0
    substitute  f = -1 / u, g = cos(x), var_name = u, at 0.1.1
    rewrite_trigonometric  rule = TR22, at 1.0
    simplify
  qed

problem  "Exercise 7"
  goal  INT x:[0, pi/2]. sin(x) ^ 3
  calc
    rewrite  rhs = sin(x)*sin(x)^2, at 0
    rewrite_trigonometric  rule = TR5, at 0.1
    simplify
    substitute  f = -(u ^ 2), g = cos(x), var_name = u, at 1.0
    simplify
  qed

problem  "Exercise 8"
  goal  INT x:[0, pi/10]. cos(5 * x)/ (3 + sin(5 * x))
  calc
    substitute  f = 1 / (5 * (u + 3)), g = sin(5 * x), var_name = u
    substitute  f = (15 + 5 * (v / 5 - 3)) ^ -1 * (1/5), g = 15 + 5 * u, var_name = v
    simplify
  qed

problem  "Exercise 9"
  goal  INT x:[0, pi]. cos(x) ^ 2/(1 + sin(x))
  calc
    rewrite_trigonometric  rule = TR6, at 0.0
    rewrite_fraction  denom = 1 + sin(x), rhs = 1 - sin(x), at 0
    simplify
  qed

problem  "Exercise 10"
  goal  INT x:[0, pi/4]. sin(x) / (1 + sin(x))
  calc
    rewrite  denom = 1 + sin(x), rhs = sin(x)*(1-sin(x))/(1-sin(x)^2), at 0
    rewrite_trigonometric  rule = TR5, at 0.1
    simplify
    substitute  f = -1 / u ^ 2, g = cos(x), var_name = u, at 0
    simplify
    rewrite_trigonometric  rule = TR5, at 1.0.0.1
    simplify
    rewrite_trigonometric  rule = TR111, at 1.0.0
    simplify
  qed

problem  "Exercise 11"
  goal  INT x:[pi/6, pi/4]. (csc(3*x)  + cot(3*x)) ^ 2
  calc
    unfold_power  at 0
    substitute  f = cot(u) ^ 2 / 3 + (2 * cot(u) * csc(u)) / 3 + csc(u) ^ 2 / 3, g = 3 * x, var_name = u
    simplify
    rewrite_trigonometric  rule = TR22, at 0.1.1.0
    simplify
    rewrite_trigonometric  rule = TR1, at 1.1.0
    rewrite_trigonometric  rule = TR2, at 1.1.0
    substitute  f = v ^ -2, g = sin(u), var_name = v, at 1.1
    simplify
  qed

problem  "Exercise 12"
  goal  INT x:[-pi/4, pi/4].(sec(x) ^ 2)*sqrt(5 + tan(x))
  calc
    substitute  f = sqrt(u), g = tan(x) + 5, var_name = u
    simplify
  qed

problem  "Exercise 13"
  goal  INT x:[0, pi/4]. tan(x) ^ 5
  calc
    rewrite  rhs = tan(x)^2*tan(x)^3, at 0
    rewrite_trigonometric  rule = TR22, at 0.0
    simplify
    substitute  f = u ^ 3, g = tan(x), var_name = u, at 1
    simplify
    rewrite  rhs = tan(x)*tan(x)^2, at 1.0.0
    rewrite_trigonometric  rule = TR22, at 1.0.0.1
    simplify
    substitute  f = u, g = tan(x), var_name = u, at 1.0
    rewrite_trigonometric  rule = TR2, at 0.1.0
    substitute  f = -1 / u, g = cos(x), var_name = u, at 0.1
    simplify
  qed

problem  "Exercise 14"
  goal  INT x:[0, pi/4]. (sin(x) - cos(x))*(sin(x) + cos(x)) ^ 5
  calc
    substitute  f = -u ^ 5, g = sin(x) + cos(x), var_name = u
    simplify
  qed

problem  "Exercise 15"
  goal  INT x:[0, pi/2]. cos(x) * exp(4+sin(x))
  calc
    substitute  f = exp(u), g = sin(x) + 4, var_name = u
    simplify
  qed

problem  "Exercise 16"
  goal  INT x:[0, pi/3]. sin(3*x)*sin(cos(3*x))
  calc
    substitute  f = -sin(u) / 3, g = cos(3 * x), var_name = u
    simplify
  qed

problem  "Exercise 17"
  goal  INT x:[pi/6, pi/4]. cos(x) * log(sin(x)) /  sin(x)
  calc
    substitute  f = log(u) / u, g = sin(x), var_name = u
    substitute  f = v, g = log(u), var_name = v
    simplify
  qed

problem  "Exercise 18"
  goal  INT x:[0, pi/4]. sec(x) * tan(x) * sqrt(4 + 3*sec(x))
  calc
    substitute  f = sqrt(u) / 3, g = 3 * sec(x) + 4, var_name = u
    simplify
  qed

problem  "Exercise 19"
  goal  INT x:[log(pi/6), log(pi/4)]. exp(x) * cos(exp(x))
  calc
    substitute  f = cos(u), g = exp(x), var_name = u
    simplify
  qed

problem  "Exercise 20"
  goal  INT x:[0, pi/2]. x * sin(3*x)
  calc
    substitute  f = (u / 3) * sin(3 * (u / 3)) * (3 / 9), g = 3 * x, var_name = u
    simplify
    integrate_by_parts  parts_u = u, parts_v = -cos(u), at 1
    simplify
  qed

problem  "Exercise 21"
  goal  INT x:[0, pi/2]. x ^ 2 * cos(x)
  calc
    integrate_by_parts  parts_u = x^2, parts_v = sin(x)
    simplify
    integrate_by_parts  parts_u = x, parts_v = -cos(x), at 1.1
    simplify
  qed

problem  "Exercise 22"
  goal  INT x:[0, pi/4]. sin(x) * cos(x) * exp(sin(x))
  calc
    substitute  f = exp(u) * u, g = sin(x), var_name = u
    integrate_by_parts  parts_u = u, parts_v = exp(u)
    simplify
  qed

problem  "Exercise 23"
  goal  INT x:[0, pi/2]. exp(x) * sin(x)
  calc
    integrate_by_parts  parts_u = exp(x), parts_v = -cos(x)
    simplify
    integrate_by_parts  parts_u = exp(x), parts_v = sin(x), at 1
    simplify
    solve_equation  factor = 1, prev_id = 0
  qed

problem  "Exercise 24"
  goal  INT x:[0, pi/2].sin(3*x)*cos(4*x)
  calc
    rewrite_trigonometric  rule = TR8, at 0
    simplify
    substitute  f = sin(u) / 7, g = 7 * x, var_name = u, at 1.1
    simplify
  qed

problem  "Exercise 25"
  goal  INT x:[0, pi/4]. sec(x) * sqrt(sec(x) + tan(x))
  calc
    substitute  f = u ^ ((-1/2)), g = sec(x) + tan(x), var_name = u
    simplify
  qed

problem  "Exercise 26"
  goal  INT x:[0, pi/8]. (sin(2*x) - cos(2*x))/(sin(2*x) + cos(2*x))
  calc
    rewrite_trigonometric  rule = TR10i, at 0
    substitute  f = -1 / (2 * u), g = sin(2 * x + pi / 4), var_name = u
    simplify
  qed

problem  "Exercise 27"
  goal  INT x:[0, pi/2]. (sin(x) + cos(x))/(exp(-x) + sin(x))
  calc
    rewrite  denom = exp(-x) + sin(x), rhs = (exp(x)*(sin(x)+cos(x))/(1+exp(x)*sin(x))), at 0
    substitute  f = u ^ -1, g = 1 + exp(x) * sin(x), var_name = u
    simplify
  qed
