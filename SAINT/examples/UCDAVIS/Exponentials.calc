
problem  "Exercise 1"
  goal  INT x:[0, 1].5*exp(x)
  calc
    simplify
  qed

problem  "Exercise 2"
  goal  INT x:[0, 1]. 2 - 3*exp(x)
  calc
    simplify
  qed

problem  "Exercise 3"
  goal  INT x:[0, (1/7)*log(2)]. 14*exp(7*x)
  calc
    substitute  f = 2 * exp(u), g = 7 * x, var_name = u
    simplify
  qed

problem  "Exercise 5"
  goal  INT x:[0, 1].exp(5*x)*(exp(2*x)/7 + 3/exp(3*x))
  calc
    simplify
  qed

problem  "Exercise 6"
  goal  INT x:[0, 1]. exp(x)*(1 + 2*exp(x))^4
  calc
    substitute  f = (2 * u + 1) ^ 4, g = exp(x), var_name = u
    substitute  f = (1 + 2 * (v / 2 - 1/2)) ^ 4 * (1/2), g = 1 + 2 * u, var_name = v
    simplify
  qed

problem  "Exercise 7"
  goal  INT x:[0, 1].(exp(4*x) - exp(-4*x))^2
  calc
    unfold_power  at 0
    simplify
  qed

problem  "Exercise 8"
  goal  INT x:[0, 1].exp(x)*(1-exp(x))*(1+exp(x))
  calc
    simplify
  qed

problem  "Exercise 10"
  goal  INT x:[0, 1].30*exp(-3*x)*(1 + 3*exp(-x))^5
  calc
    substitute  f = (10 * u ^ 5 * (u - 1) ^ 3 * (-u / ((u ^ 2 - 2 * u) + 1) + 1 / ((u ^ 2 - 2 * u) + 1))) / 9, g = 1 + 3 * exp(-x), var_name = u
    rewrite_fraction  rhs = -10/9*u^5*(u-1) + 10/9*u^6*(u-1), at 0
    simplify
  qed

problem  "Exercise 11"
  goal  INT x:[0, 1]. (8 * exp(x) * (3 + exp(x)))/sqrt(exp(2*x) + 6 * exp(x) + 1)
  calc
    rewrite_fraction  rhs = 4 * (6 * exp(x) + 2* exp(2*x)), at 0.0
    substitute  f = 4 * u ^ ((-1/2)), g = exp(2 * x) + 6 * exp(x) + 1, var_name = u
    simplify
  qed

problem  "Exercise 12"
  goal  INT x:[0, 1].(27*exp(9*x) + exp(12*x))^(1/3)
  calc
    rewrite_fraction  rhs = exp(9*x) * (27 + exp(3*x)), at 0.0
    simplify
    substitute  f = u ^ (1/3) / 3, g = exp(3 * x) + 27, var_name = u
    simplify
  qed
