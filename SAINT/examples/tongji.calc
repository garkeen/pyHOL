theory  Tongji 7'th Edition
imports  base

header  "Definite Integrals"  level = 1
calculation  "Problem 1"
  goal  INT x:[2,3]. 2 * x + x ^ 2
calculation  "Problem 2"
  goal  INT x:[0,1]. (3 * x + 1) ^ (-2)
calculation  "Problem 3"
  goal  INT x:[0,1]. exp(6 * x)
calculation  "Problem 4"
  goal  INT x:[-1,2]. x * exp(x)
calculation  "Problem 5"
  goal  INT x:[0,pi/4]. sin(x)
calculation  "Problem 6"
  goal  INT x:[0,1]. 3*x^2 - x + 1
calculation  "Problem 7"
  goal  INT x:[1,2]. x^2 + 1/x^4
calculation  "Problem 8"
  goal  INT x:[pi/3, pi]. sin(2*x + pi/3)
calculation  "Problem 9"
  goal  INT x:[4, 9]. x ^ (1 / 3) * (x ^ (1 / 2) + 1)
calculation  "Problem 10"
  goal  INT x:[-1, 0]. (3 * x ^ 4 + 3 * x ^ 2 + 1) / (x ^ 2 + 1)
calculation  "Problem 11"
  goal  INT x:[4, exp(1) + 3]. (x ^ 3 - 12 * x ^ 2 - 42) / (x - 3)
calculation  "Problem 12"
  goal  INT x:[0, pi / 2]. sin(x) * cos(x) ^ 3
calculation  "Problem 13"
  goal  INT x:[0, pi]. (1 - sin(x)^3)
calculation  "Problem 14"
  goal  INT x:[pi/6, pi/2]. cos(x) ^ 2
calculation  "Problem 15"
  goal  INT x:[0, 1]. (1 - x^2) ^ (1/2)
calculation  "Problem 16"
  goal  INT x:[0, sqrt(2)]. sqrt(2 - x^2)
calculation  "Problem 17"
  goal  INT y:[-sqrt(2), sqrt(2)]. sqrt(8 - 2*y^2)
calculation  "Problem 18"
  goal  INT x:[1/sqrt(2), 1]. sqrt(1 - x^2) / x ^ 2
calculation  "Problem 19"
  goal  INT x:[-1, 1]. x / sqrt(5 - 4 * x)
calculation  "Problem 20"
  goal  INT x:[1,4]. 1 / (1 + sqrt(x))
calculation  "Problem 21"
  goal  INT x:[3/4, 1]. 1 / (sqrt(1-x) - 1)
calculation  "Problem 22"
  goal  INT t:[0, 1]. t * exp(-t ^ 2 / 2)
calculation  "Problem 23"
  goal  INT x:[1, exp(2)]. 1 / (x*sqrt(1+log(x)))
calculation  "Problem 24"
  goal  INT x:[-2, 0]. (x + 2)/(x^2 + 2*x + 2)
calculation  "Problem 25"
  goal  INT x:[-pi/2,pi/2]. cos(x)^4
calculation  "Problem 26"
  goal  INT x:[-pi/2, pi/2]. sqrt(cos(x) - cos(x)^3)
calculation  "Problem 27"
  goal  INT x:[0, pi]. sqrt(1 + cos(2*x))
calculation  "Problem 28"
  goal  INT x:[0, 1].x * exp(-x)
calculation  "Problem 29"
  goal  INT x:[1, exp(1)]. x * log(x)
calculation  "Problem 30"
  goal  INT x:[pi/4, pi/3]. x / sin(x)^2
calculation  "Problem 31"
  goal  INT x:[1, 4]. log(x) / sqrt(x)
calculation  "Problem 32"
  goal  INT x:[0, 1]. x * atan(x)
calculation  "Problem 33"
  goal  INT x:[0, pi/2]. exp(2*x)*cos(x)
calculation  "Problem 34"
  goal  INT x:[0,pi]. (x * sin(x))^2
calculation  "Problem 35"
  goal  INT x:[1, exp(1)]. sin(log(x))
calculation  "Problem 36"
  goal  INT x:[1/exp(1), exp(1)]. abs(log(x))
