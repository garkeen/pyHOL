
calculation  "Exercise 1"
  goal  INT x:[1, exp(1)]. log(x^2) - 2*log(2*x)
  calc
    simplify
    substitute  f = log(u) / 2, g = 2 * x, var_name = u, at 1.1
    simplify
    integrate_by_parts  parts_u = log(x), parts_v = x, at 0.1
    integrate_by_parts  parts_u = log(u), parts_v = u, at 1.0
    simplify
  qed

calculation  "Exercise 2"
  goal  INT x:[-1, 3].exp(abs(x))
  calc
    elim_abs  c = 0
    substitute  f = -exp(u), g = -x, var_name = u, at 1
    simplify
  qed

calculation  "Exercise 3"
  goal  INT x:[exp(1), exp(2)].((log(x) * cos(x)) - (sin(x)*(1/x)))/log(x)^2
  calc
    simplify
    integrate_by_parts  parts_u = 1/log(x), parts_v = sin(x), at 0
    simplify
  qed

calculation  "Exercise 4"
  goal  INT x:[1, 11].x^3 - 3*x^2 + 3*x - 1
  calc
    simplify
  qed

calculation  "Exercise 5"
  goal  INT x:[0, 2].sqrt(12 - 3 * x^2)
  calc
    substitute_inverse  a = 0, b = pi / 2, g = 2 * sin(u), var_name = u
    simplify
    rewrite_trigonometric  rule = TR5, at 1.0.1.0
    simplify
    elim_abs  at 1
    simplify
  qed

calculation  "Exercise 6"
  goal  INT x:[0, 6].x+(x - 3)^7 + sin(x - 3)
  calc
    substitute  f = (u + 3 + ((u + 3) - 3) ^ 7 + sin((u + 3) - 3)) * 1, g = x - 3, var_name = u
    simplify
  qed

calculation  "Exercise 7"
  goal  INT x:[0, pi/3].sin(x)*sqrt(1 + tan(x) ^ 2)
  calc
    rewrite_trigonometric  rule = TR22, at 0.1.0
    simplify
    elim_abs
    rewrite_trigonometric  rule = TR1, at 0.1
    substitute  f = -1 / u, g = cos(x), var_name = u
    simplify
  qed

calculation  "Exercise 8"
  goal  INT x:[1, 2].(x^5 - x^3 + x^2 - 1) / (x^4 - x^3 + x - 1)
  calc
    rewrite_fraction  denom = ((x ^ 4 - x ^ 3) + x) - 1, rhs = x + 1, at 0
    simplify
  qed

calculation  "Exercise 9"
  goal  INT x:[0, 1]. log(x)
  calc
    integrate_by_parts  parts_u = log(x), parts_v = x
    simplify
  qed

calculation  "Exercise 10"
  goal  INT x:[1, 2]. 1 / (1 - exp(-x))
  calc
    rewrite  denom = 1 - exp(-x), rhs = 1 + exp(-x) / (1 - exp(-x)), at 0
    simplify
    substitute  f = -1 / (1 - u), g = exp(-x), var_name = u, at 1
    substitute  f = (1 + -(1 - v)) ^ -1 * -1, g = 1 + -u, var_name = v, at 1
    simplify
  qed

calculation  "Exercise 11"
  goal  INT x:[0, pi].sin(x)^2*cos(x)^2
  calc
    rewrite_trigonometric  rule = TR5, at 0.0
    rewrite_trigonometric  rule = TR7, at 0
    simplify
    rewrite_trigonometric  rule = TR7, at 1.1.0
    simplify
  qed

calculation  "Exercise 12"
  goal  INT x:[0, 441]. (pi * sin(pi*sqrt(x))) / sqrt(x)
  calc
    substitute  f = 2 * sin(u), g = pi * sqrt(x), var_name = u
    simplify
  qed

calculation  "Exercise 13"
  goal  INT x:[0, pi/4]. tan(x) ^ 2
  calc
    rewrite_trigonometric  rule = TR22, at 0
    simplify
  qed

calculation  "Exercise 15"
  goal  INT x:[0, 1].exp(x ^ (1/4))
  calc
    substitute  f = 4 * u ^ 3 * exp(u), g = x ^ (1/4), var_name = u
    integrate_by_parts  parts_u = 4*u^3, parts_v = exp(u)
    simplify
    integrate_by_parts  parts_u = u^2, parts_v = exp(u), at 1.1
    simplify
    integrate_by_parts  parts_u = u, parts_v = exp(u), at 1.1
    simplify
  qed

calculation  "Exercise 16"
  goal  INT x:[pi/3, pi/2]. cos(x) * cot(x)
  calc
    rewrite_trigonometric  rule = TR2, at 0
    rewrite_trigonometric  rule = TR6, at 0.0
    simplify
    substitute  f = sin(2 * u) ^ -1 * 2, g = x / 2, var_name = u, at 1
    rewrite_trigonometric  rule = TR0, at 1.0.0
    rewrite_trigonometric  rule = TR11, at 1.0.1.0
    simplify
    substitute  f = 1 / v, g = sin(u), var_name = v, at 0.1
    substitute  f = -1 / v, g = cos(u), var_name = v, at 1
    simplify
  qed

calculation  "Exercise 17"
  goal  INT x:[1, exp(1)]. 2*log(x) + log(x) ^ 2
  calc
    simplify
    integrate_by_parts  parts_u = log(x)^2, parts_v = x, at 1
    simplify
  qed

calculation  "Exercise 18"
  goal  INT x:[0, 1]. x^3/(1 + x^2)
  calc
    rewrite_fraction  rhs = x - x / (x ^ 2 + 1), at 0
    simplify
  qed

calculation  "Exercise 19"
  goal  INT x:[0, 1].1/(2 - 2*x + x^2)
  calc
    rewrite  rhs = (x-1)*(x-1)+1, at 0.1
    substitute  f = 1 / (u ^ 2 + 1), g = x - 1, var_name = u
    simplify
  qed

calculation  "Exercise 20"
  goal  INT x:[pi/3, (2/3)*pi]. sin(x)*log(sin(x))
  calc
    integrate_by_parts  parts_u = log(sin(x)), parts_v = -cos(x)
    simplify
    rewrite_trigonometric  rule = TR6, at 1.0
    simplify
    rewrite_trigonometric  rule = TR1, at 1.0
    substitute  f = 2 / sin(2 * u), g = x / 2, var_name = u, at 1
    simplify
    rewrite_trigonometric  rule = TR1, at 1.1.0
    rewrite_trigonometric  rule = TR11, at 1.1.0.1
    rewrite_trigonometric  rule = TR0, at 1.1.0.0
    simplify
    rewrite_trigonometric  rule = TR1, at 0.1.0.1
    rewrite_trigonometric  rule = TR1, at 1.0.0
    substitute  f = 1 / t, g = sin(u), var_name = t, at 0.1
    substitute  f = -1 / t, g = cos(u), var_name = t, at 1
    simplify
  qed

calculation  "Exercise 21"
  goal  INT x:[1/3, 1/2].x/(1 - x^4)
  calc
    rewrite_fraction  rhs = x / (2 * (x ^ 2 + 1)) - 1 / (4 * (x + 1)) - 1 / (4 * (x - 1)), at 0
    simplify
  qed

calculation  "Exercise 22"
  goal  INT x:[0, 1].sqrt(12 - 3 * x^2)
  calc
    substitute_inverse  a = 0, b = pi / 6, g = 2 * sin(u), var_name = u
    simplify
    rewrite_trigonometric  rule = TR5, at 1.0.1.0
    simplify
    elim_abs  at 1
    simplify
  qed

calculation  "Exercise 23"
  goal  INT x:[0,pi/3]. sec(x)^5 * tan(x)^3
  calc
    rewrite_trigonometric  rule = TR1, at 0
    rewrite_trigonometric  rule = TR2, at 0
    rewrite  rhs = sin(x) * sin(x)^2, at 0.0
    rewrite_trigonometric  rule = TR5, at 0.0.1
    simplify
    substitute  f = -1 / u ^ 8, g = cos(x), var_name = u, at 0
    substitute  f = -1 / u ^ 6, g = cos(x), var_name = u, at 1.0
    simplify
  qed

calculation  "Exercise 24"
  goal  INT x:[-pi/4, pi/4]. 1 / (1 - sin(x))
  calc
    rewrite  denom = 1 - sin(x), rhs = (1+sin(x))/(1-sin(x)^2), at 0
    rewrite_trigonometric  rule = TR5, at 0.1
    simplify
    rewrite_trigonometric  rule = TR111, at 0.0
    simplify
    split_region  c = 0, at 1
    substitute  f = -1 / u ^ 2, g = cos(x), var_name = u, at 1.0
    substitute  f = -1 / u ^ 2, g = cos(x), var_name = u, at 1.1
    simplify
  qed

calculation  "Exercise 25"
  goal  INT x:[2,3]. 1/(x*sqrt(x^2-2))
  calc
    substitute  f = -1 / (u ^ 3 * (2 + u ^ -2) * sqrt(u ^ -2)), g = 1 / sqrt(x ^ 2 - 2), var_name = u
    simplify
    rewrite_fraction  denom = (2 + u ^ -2) ^ -1, rhs = 1/(2*u^2+1), at 0
    substitute  f = sqrt(2) / (2 * (v ^ 2 + 1)), g = sqrt(2) * u, var_name = v
    rewrite_fraction  denom = 2 * (v ^ 2 + 1), rhs = (sqrt(2)/2) * (1/(v^2+1)), at 0
    simplify
  qed
