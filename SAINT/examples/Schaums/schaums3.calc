
calculation  "Exercise 1"
  goal  INT x:[0,1]. 1/((3*x+4)*(5*x+6))
  calc
    rewrite_fraction  rhs = 5 / (2 * (5 * x + 6)) - 3 / (2 * (3 * x + 4)), at 0
    simplify
    substitute  f = (8 + 6 * (u / 6 - 4/3)) ^ -1 * (1/6), g = 8 + 6 * x, var_name = u, at 0.1
    substitute  f = (12 + 10 * (u / 10 - 6/5)) ^ -1 * (1/10), g = 12 + 10 * x, var_name = u, at 1.1
    simplify
  qed

calculation  "Exercise 2"
  goal  INT x:[0,1]. x/((3*x+4)*(5*x+6))
  calc
    rewrite_fraction  rhs = -3 / (5 * x + 6) + 2 / (3 * x + 4), at 0
    simplify
    substitute  f = (4 + 3 * (u / 3 - 4/3)) ^ -1 * (1/3), g = 4 + 3 * x, var_name = u, at 0.1
    substitute  f = (6 + 5 * (u / 5 - 6/5)) ^ -1 * (1/5), g = 6 + 5 * x, var_name = u, at 1.1
    simplify
  qed

calculation  "Exercise 3"
  goal  INT x:[0,1]. 1/((3*x+4)^2*(5*x+6))
  calc
    rewrite_fraction  rhs = 25 / (4 * (5 * x + 6)) - 15 / (4 * (3 * x + 4)) - 3 / (2 * (3 * x + 4) ^ 2), at 0
  qed
