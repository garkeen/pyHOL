
calculation  "Exercise 1"
  goal  INT x:[0,1]. 1/sqrt(3*x+4)
  calc
    substitute  f = 1 / (3 * sqrt(u)), g = 3 * x + 4, var_name = u
    simplify
  qed

calculation  "Exercise 2"
  goal  INT x:[0,1]. x/sqrt(3*x+4)
  calc
    substitute  f = ((u / 3 - 4/3) / sqrt(3 * (u / 3 - 4/3) + 4)) * (1/3), g = 3 * x + 4, var_name = u
    simplify
  qed

calculation  "Exercise 3"
  goal  INT x:[0,1]. x^2/sqrt(3*x+4)
  calc
    substitute  f = ((u / 3 - 4/3) ^ 2 / sqrt(3 * (u / 3 - 4/3) + 4)) * (1/3), g = 3 * x + 4, var_name = u
    simplify
  qed
