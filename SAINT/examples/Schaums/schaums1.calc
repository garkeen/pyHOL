
problem  "Exercise 1"
  goal  INT x:[0,1]. 1/(3*x+4)
  calc
    substitute  f = 1 / (3 * u), g = 3 * x + 4, var_name = u
    simplify
  qed

problem  "Exercise 2"
  goal  INT x:[0,1]. x/(3*x+4)
  calc
    substitute  f = ((u / 3 - 4/3) / (3 * (u / 3 - 4/3) + 4)) * (1/3), g = 3 * x + 4, var_name = u
    simplify
  qed

problem  "Exercise 3"
  goal  INT x:[0,1]. x^2/(3*x+4)
  calc
    rewrite_fraction  rhs = (x / 3 - 4/9) + 16 / (9 * (3 * x + 4)), at 0
    simplify
    substitute  f = (36 + 27 * (u / 27 - 4/3)) ^ -1 * (1/27), g = 36 + 27 * x, var_name = u, at 1.1
    simplify
  qed

problem  "Exercise 4"
  goal  INT x:[0,1]. x^3/(3*x+4)
  calc
    rewrite_fraction  rhs = ((x ^ 2 / 3 - (4 * x) / 9) + 16/27) - 64 / (27 * (3 * x + 4)), at 0
    simplify
    substitute  f = (108 + 81 * (u / 81 - 4/3)) ^ -1 * (1/81), g = 108 + 81 * x, var_name = u, at 1.1
    simplify
  qed

problem  "Exercise 5"
  goal  INT x:[1,2]. 1/(x*(3*x+4))
  calc
    rewrite_fraction  rhs = -3 / (4 * (3 * x + 4)) + 1 / (4 * x), at 0
    simplify
    substitute  f = (16 + 12 * (u / 12 - 4/3)) ^ -1 * (1/12), g = 16 + 12 * x, var_name = u, at 1.1
    simplify
  qed

problem  "Exercise 6"
  goal  INT x:[1,2]. 1/(x^2*(3*x+4))
  calc
    rewrite_fraction  rhs = (9 / (16 * (3 * x + 4)) - 3 / (16 * x)) + 1 / (4 * x ^ 2), at 0
    simplify
    substitute  f = (64 + 48 * (u / 48 - 4/3)) ^ -1 * (1/48), g = 64 + 48 * x, var_name = u, at 1.1
    simplify
  qed
