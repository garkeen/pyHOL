theory array_demo
imports hoare
description "translated from .imp"

theorem init_array_vc_0
  fixes i :: nat
  prop ∀s::nat ⇒ nat. i = 0 ⟶ (if (0::nat) ≤ 0 ∧ (0::nat) < 3 then if (0::nat) ≤ 1 ∧ (1::nat) < 3 then if (0::nat) ≤ 2 ∧ (2::nat) < 3 then (0::nat) = 0 ∧ (0::nat) = 0 ∧ (0::nat) = 0 else false else false else false)
  proof
    0: z3
  qed

theorem init_array_vc_1
  fixes i :: nat
  prop ∀s. false ∧ ¬true ⟶ (if (0::nat) ≤ 1 ∧ (1::nat) < 3 then if (0::nat) ≤ 2 ∧ (2::nat) < 3 then s (0::nat) = (0::nat) ∧ (0::nat) = 0 ∧ (0::nat) = 0 else false else false)
  proof
    0: z3
  qed

theorem init_array_vc_2
  fixes i :: nat
  prop ∀s::nat ⇒ nat. false ∧ true ⟶ false
  proof
    0: z3
  qed

theorem init_array_vc_3
  fixes i :: nat
  prop ∀s. false ∧ ¬true ⟶ (if (0::nat) ≤ 2 ∧ (2::nat) < 3 then s (0::nat) = (0::nat) ∧ s 1 = 0 ∧ (0::nat) = 0 else false)
  proof
    0: z3
  qed

theorem init_array_vc_4
  fixes i :: nat
  prop ∀s. false ∧ ¬true ⟶ s (0::nat) = (0::nat) ∧ s 1 = 0 ∧ s 2 = 0
  proof
    0: z3
  qed

theorem init_array
  fixes i :: nat
  prop Valid (λs. i = 0) (Seq (Cond (λs. (0::nat) ≤ 0 ∧ (0::nat) < 3) (Assign (0::nat) (λs. (0::nat))) (While (λs. true) (λs. false) Skip)) (Seq (Cond (λs. (0::nat) ≤ 1 ∧ (1::nat) < 3) (Assign 1 (λs. 0)) (While (λs. true) (λs. false) Skip)) (Cond (λs. (0::nat) ≤ 2 ∧ (2::nat) < 3) (Assign 2 (λs. 0)) (While (λs. true) (λs. false) Skip)))) (λs. s 0 = 0 ∧ s 1 = 0 ∧ s 2 = 0)
  proof
    0: vcg
    0: apply_backward_step init_array_vc_0
    1: apply_backward_step init_array_vc_1
    2: apply_backward_step init_array_vc_2
    3: apply_backward_step init_array_vc_3
    4: apply_backward_step init_array_vc_4
  qed

theorem swap_vc_0
  prop ∀s. s (0::nat) = (1::nat) ∧ s 1 = 2 ⟶ (if (0::nat) ≤ 0 ∧ (0::nat) < 3 then if (0::nat) ≤ 1 ∧ (1::nat) < 3 then (s)(3 := s 0) 1 = 2 ∧ (s)(3 := s 0, 0 := s 1) 3 = 1 else false else false)
  proof
    0: z3
  qed

theorem swap_vc_1
  prop ∀s. false ∧ ¬true ⟶ (if (0::nat) ≤ 1 ∧ (1::nat) < 3 then s (0::nat) = (2::nat) ∧ s 3 = 1 else false)
  proof
    0: z3
  qed

theorem swap_vc_2
  prop ∀s::nat ⇒ nat. false ∧ true ⟶ false
  proof
    0: z3
  qed

theorem swap_vc_3
  prop ∀s. false ∧ ¬true ⟶ s (0::nat) = (2::nat) ∧ s 1 = 1
  proof
    0: z3
  qed

theorem swap
  prop Valid (λs. s (0::nat) = (1::nat) ∧ s 1 = 2) (Seq (Assign 3 (λs. s 0)) (Seq (Cond (λs. (0::nat) ≤ 0 ∧ (0::nat) < 3) (Assign 0 (λs. s 1)) (While (λs. true) (λs. false) Skip)) (Cond (λs. (0::nat) ≤ 1 ∧ (1::nat) < 3) (Assign 1 (λs. s 3)) (While (λs. true) (λs. false) Skip)))) (λs. s 0 = 2 ∧ s 1 = 1)
  proof
    0: vcg
    0: apply_backward_step swap_vc_0
    1: apply_backward_step swap_vc_1
    2: apply_backward_step swap_vc_2
    3: apply_backward_step swap_vc_3
  qed

theorem find_max_vc_0
  prop ∀s. s (0::nat) = (3::nat) ∧ s 1 = 1 ∧ s 2 = 2 ⟶ (if s 0 < s 1 then s 0 ≤ (s)(3 := s 0) 1 ∧ s 1 ≤ (s)(3 := s 0) 1 ∧ s 2 ≤ (s)(3 := s 0) 1 else if s 0 < s 2 then s 0 ≤ (s)(3 := s 0) 2 ∧ s 1 ≤ (s)(3 := s 0) 2 ∧ s 2 ≤ (s)(3 := s 0) 2 else s 0 ≤ s 0 ∧ s 1 ≤ s 0 ∧ s 2 ≤ s 0)
  proof
    0: z3
  qed

theorem find_max
  prop Valid (λs. s (0::nat) = (3::nat) ∧ s 1 = 1 ∧ s 2 = 2) (Seq (Assign 3 (λs. s 0)) (Cond (λs. s 3 < s 1) (Assign 3 (λs. s 1)) (Seq Skip (Cond (λs. s 3 < s 2) (Assign 3 (λs. s 2)) Skip)))) (λs. s 0 ≤ s 3 ∧ s 1 ≤ s 3 ∧ s 2 ≤ s 3)
  proof
    0: vcg
    0: apply_backward_step find_max_vc_0
  qed
