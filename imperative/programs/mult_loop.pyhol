theory mult_loop
imports hoare
description "translated from mult_loop.imp"

theorem vc_0
  fixes A :: nat, B :: nat
  prop ∀s. s (0::nat) = 0 ∧ s 1 = 0 ⟶ s 1 = s 0 * B
  proof
    0: z3
  qed

theorem vc_1
  fixes A :: nat, B :: nat
  prop ∀s. s (1::nat) = s 0 * B ∧ ¬¬(s 0 = A) ⟶ s 1 = A * B
  proof
    0: z3
  qed

theorem vc_2
  fixes A :: nat, B :: nat
  prop ∀s. s (1::nat) = s 0 * B ∧ ¬(s 0 = A) ⟶ s 1 + B = (s 0 + 1) * B
  proof
    0: z3
  qed
