theory call_demo
imports hoare
description "translated from .imp"

theorem double_vc_0
  fixes x :: nat
  prop ∀s::nat ⇒ nat. true ⟶ x + x = x * 2
  proof
    0: z3
  qed

theorem double
  fixes x :: nat
  prop Valid (λs. true) (Assign (0::nat) (λs. x + x)) (λs. s 0 = x * 2)
  proof
    0: vcg
    0: apply_backward_step double_vc_0
  qed

theorem inc_vc_0
  fixes x :: nat
  prop ∀s::nat ⇒ nat. true ⟶ x + 1 = x + 1
  proof
    0: z3
  qed

theorem inc
  fixes x :: nat
  prop Valid (λs. true) (Assign (0::nat) (λs. x + 1)) (λs. s 0 = x + 1)
  proof
    0: vcg
    0: apply_backward_step inc_vc_0
  qed

theorem main_vc_0
  fixes a :: nat
  prop ∀s::nat ⇒ nat. a = 3 ⟶ (if true then if a * 2 = 6 then if true then a * 2 + 1 = 7 else false else false else false)
  proof
    0: z3
  qed

theorem main_vc_1
  fixes a :: nat
  prop ∀s. false ∧ ¬true ⟶ (if s (0::nat) = (6::nat) then if true then s 0 + 1 = 7 else false else false)
  proof
    0: z3
  qed

theorem main_vc_2
  fixes a :: nat
  prop ∀s::nat ⇒ nat. false ∧ true ⟶ false
  proof
    0: z3
  qed

theorem main_vc_3
  fixes a :: nat
  prop ∀s. false ∧ ¬true ⟶ (if true then s (0::nat) + (1::nat) = 7 else false)
  proof
    0: z3
  qed

theorem main_vc_4
  fixes a :: nat
  prop ∀s. false ∧ ¬true ⟶ s (1::nat) = (7::nat)
  proof
    0: z3
  qed

theorem main
  fixes a :: nat
  prop Valid (λs. a = 3) (Seq (Cond (λs. true) (Assign (0::nat) (λs. a * 2)) (While (λs. true) (λs. false) Skip)) (Seq (Cond (λs. s 0 = 6) Skip (While (λs. true) (λs. false) Skip)) (Cond (λs. true) (Assign 1 (λs. s 0 + 1)) (While (λs. true) (λs. false) Skip)))) (λs. s 1 = 7)
  proof
    0: vcg
    0: apply_backward_step main_vc_0
    1: apply_backward_step main_vc_1
    2: apply_backward_step main_vc_2
    3: apply_backward_step main_vc_3
    4: apply_backward_step main_vc_4
  qed
