theory array_demo
imports hoare

program init_array
  vars: a: nat[3], i: nat
  pre: i == 0
  post: a[0] == 0 & a[1] == 0 & a[2] == 0
  body:
    a[0] := 0;
    a[1] := 0;
    a[2] := 0

program swap
  vars: a: nat[3], tmp: nat
  pre: a[0] == 1 & a[1] == 2
  post: a[0] == 2 & a[1] == 1
  body:
    tmp := a[0];
    a[0] := a[1];
    a[1] := tmp

program find_max
  vars: a: nat[3], m: nat
  pre: a[0] == 3 & a[1] == 1 & a[2] == 2
  post: m >= a[0] & m >= a[1] & m >= a[2]
  body:
    m := a[0];
    if (a[1] > m) then m := a[1] else skip;
    if (a[2] > m) then m := a[2] else skip
