theory zero_out
imports hoare
description "translated from .imp"

theorem zero_out_vc_0
  prop ∀s. true ⟶ (if ¬(s (0::nat) = (0::nat)) then (0::nat) = 0 else s 0 = 0)
  proof
    0: z3
  qed

theorem zero_out
  prop Valid (λs. true) (Cond (λs. ¬(s (0::nat) = (0::nat))) (Assign 0 (λs. 0)) Skip) (λs. s 0 = 0)
  proof
    0: vcg
    0: apply_backward_step zero_out_vc_0
  qed
