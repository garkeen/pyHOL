theory max_demo
imports hoare
description "translated from .imp"

theorem max_demo_vc_0
  fixes m :: nat, n :: nat
  prop ∀s::nat ⇒ nat. true ⟶ (if m ≤ n then n = m ∨ n = n else m = m ∨ m = n)
  proof
    0: z3
  qed

theorem max_demo
  fixes m :: nat, n :: nat
  prop Valid (λs. true) (Cond (λs. m ≤ n) (Assign (0::nat) (λs. n)) (Assign 0 (λs. m))) (λs. s 0 = m ∨ s 0 = n)
  proof
    0: vcg
    0: apply_backward_step max_demo_vc_0
  qed
