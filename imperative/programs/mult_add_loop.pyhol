theory mult_add_loop
imports hoare
description "compiled from mult_add_loop.imp"

theorem mult_add_loop
  fixes A :: nat, B :: nat
  prop Valid (λs. s (0::nat) = 0 ∧ s 1 = 0) (While (λs. ¬(s 0 = A)) (λs. s 1 = s 0 * B) (Seq (Assign 1 (λs. s 1 + B)) (Assign 0 (λs. s 0 + 1)))) (λs. s 1 = A * B)
  proof
    0: vcg
    0: z3
    1: z3
    2: z3
  qed
