theory if_demo
imports hoare
description "translated from .imp"

theorem if_demo_vc_0
  fixes n :: nat
  prop ∀s. true ⟶ (if ¬(reg s 0 = n) then reg (Pair ((reg s)(0 := n)) (heap s)) 0 = n else reg s 0 = n)
  proof
    0: z3
  qed

theorem if_demo
  fixes n :: nat
  prop Valid (λst. true) (Cond (λst. ¬(reg st 0 = n)) (AssignV (λst. 0) (λst. n)) Skip) (λst. reg st 0 = n)
  proof
    0: vcg
    0: apply_backward_step if_demo_vc_0
  qed
