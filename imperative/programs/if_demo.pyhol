theory if_demo
imports hoare
description "translated from .imp"

theorem if_demo_vc_0
  fixes n :: nat
  prop ∀s. true ⟶ (if ¬(s (0::nat) = n) then n = n else s 0 = n)
  proof
    0: z3
  qed

theorem if_demo
  fixes n :: nat
  prop Valid (λs. true) (Cond (λs. ¬(s (0::nat) = n)) (Assign 0 (λs. n)) Skip) (λs. s 0 = n)
  proof
    0: vcg
    0: apply_backward_step if_demo_vc_0
  qed
