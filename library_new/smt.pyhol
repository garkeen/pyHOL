theorem r038
  prop ~true <--> false
proof
  ← apply_backward_step iffI goal=0
    #[1] ¬true ⟶ false
    #[2] false ⟶ ¬true
  ← introduction goal=1
    #[3] ¬true
    #[4] false
  ← apply_backward_step negE param_A=true goal=4
    #[5] true
  ← apply_backward_step trueI goal=5
    #[6] true
  ← introduction goal=2
    #[7] false
    #[8] ¬true
  ← apply_backward_step negI goal=8
    #[9] true ⟶ false
  ← introduction goal=9
    #[10] true
qed

