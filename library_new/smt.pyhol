theory smt
imports logic_base, int, real, sat
description "Used for z3 rule rewrite, th-lemma and def-axiom."

theorem r001
  fixes x :: 'a, y :: 'a
  prop x = y <--> y = x
proof
  ← apply_backward_step iffI goal=0
    #[1] x = y ⟶ y = x
    #[2] y = x ⟶ x = y
  ← introduction goal=1
    #[3] x = y
    #[4] y = x
  ← rewrite_goal eq_sym_eq sym=false goal=4
  ← introduction goal=2
    #[5] y = x
    #[6] x = y
  ← rewrite_goal eq_sym_eq sym=false goal=6
qed

theorem r002
  fixes x :: 'a
  prop x = x <--> true
proof
  ← apply_backward_step iffI goal=0
    #[1] x = x ⟶ true
    #[2] true ⟶ x = x
  ← introduction goal=1
    #[3] x = x
    #[4] true
  ← apply_backward_step trueI goal=4
    #[5] true
  ← introduction goal=2
    #[6] true
    #[7] x = x
  ← apply_backward_step eq_refl goal=7
    #[8] x = x
qed

theorem r003
