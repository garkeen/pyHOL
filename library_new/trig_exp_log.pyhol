theorem log_poly_upper_bound
  fixes n :: nat, x :: real
  prop 0 <= x --> x < 1 --> even n --> 0 < n --> log (1 + x) <= x * sum ({0..n}) (%k. -1 ^ k / of_nat (k + 1) * x ^ k)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] x < 1
    #[3] even n
    #[4] 0 < n
    #[5] log (1 + x) ≤ x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k)
  cut "x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))" goal=5
    #[6] x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  ← rewrite_goal sum_lmul sym=true goal=6
    #[7] sum ({0..n}) (λx1. x * (-1 ^ x1 / of_nat (x1 + 1) * x ^ x1)) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  cut "∀a::real. ∀b. ∀d. a * (b * d) = b * (a * d)" goal=7
    #[8] ∀a::real. ∀b. ∀c. a * (b * c) = b * (a * c)
  ← z3 goal=8
    #[9] ∀a::real. ∀b. ∀c. a * (b * c) = b * (a * c)
  ← rewrite_goal_with_prev goal=7 facts=[9]
    #[10] sum ({0..n}) (λx1. -1 ^ x1 / of_nat (x1 + 1) * (x * x ^ x1)) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  cut "∀k::nat. x * x ^ k = x ^ (k + 1)" goal=10
    #[11] ∀k::nat. x * x ^ k = x ^ (k + 1)
  ← introduction k goal=11
    #[12] _VAR k
    #[13] x * x ^ k = x ^ (k + 1)
  ← rewrite_goal real_pow_add sym=false goal=13
    #[14] x * x ^ k = x ^ k * x ^ (1::nat)
  ← rewrite_goal real_pow_1 sym=false goal=14
    #[15] x * x ^ k = x ^ k * x
  ← apply_backward_step real_mult_comm goal=15
    #[16] x * x ^ k = x ^ k * x
  ← rewrite_goal_with_prev goal=10 facts=[11]
  ← rewrite_goal_with_prev goal=5 facts=[6]
    #[17] log (1 + x) ≤ sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  -> apply_forward_step alt_sign_upper_bound param_f="(λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))" param_k=n param_m="(0::nat)" goal=17
    #[18] (∀n1. abs (-1 ^ (n1 + 1) / of_nat (n1 + 1 + 1) * x ^ (n1 + 1 + 1)) ≤ abs (-1 ^ n1 / of_nat (n1 + 1) * x ^ (n1 + 1)) ∧ -1 ^ (n1 + 1) / of_nat (n1 + 1 + 1) * x ^ (n1 + 1 + 1) * (-1 ^ n1 / of_nat (n1 + 1) * x ^ (n1 + 1)) ≤ 0) ⟶ tendsto_real (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially ⟶ 0 < n ⟶ real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1))
  -> apply_forward_step real_lt_imp_le goal=17 facts=[2]
    #[19] x ≤ 1
  -> apply_forward_step log_alt_sign_lemma goal=17 facts=[1,19]
    #[20] (∀k. abs (-1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2)) ≤ abs (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ∧ -1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2) * (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ 0) ∧ tendsto_real (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially
  -> apply_forward_step conjD1 goal=17 facts=[20]
    #[21] ∀k. abs (-1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2)) ≤ abs (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ∧ -1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2) * (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ 0
  -> apply_forward_step conjD2 goal=17 facts=[20]
    #[22] tendsto_real (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially
  cut "!k::nat. k+1+1= k+2" goal=17
    #[23] ∀k::nat. k + 1 + 1 = k + 2
  ← z3 goal=23
    #[24] ∀k::nat. k + 1 + 1 = k + 2
  -> rewrite_fact_with_prev goal=17 facts=[24,18]
    #[25] (∀n1. abs (-1 ^ (n1 + 1) / of_nat (n1 + 2) * x ^ (n1 + 2)) ≤ abs (-1 ^ n1 / of_nat (n1 + 1) * x ^ (n1 + 1)) ∧ -1 ^ (n1 + 1) / of_nat (n1 + 2) * x ^ (n1 + 2) * (-1 ^ n1 / of_nat (n1 + 1) * x ^ (n1 + 1)) ≤ 0) ⟶ tendsto_real (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially ⟶ 0 < n ⟶ real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1))
  -> apply_fact goal=17 facts=[25,21,22,4]
    #[26] real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1))
  cut "abs x < 1" goal=17
    #[27] abs x < 1
  ← z3 goal=27 facts=[2,1]
    #[28] abs x < 1
  -> apply_forward_step log_infsum goal=17 facts=[28]
    #[29] real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) = log (1 + x)
  -> rewrite_fact_with_prev goal=17 facts=[29,26]
    #[30] log (1 + x) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1))
  cut "Suc (n-1) = n" goal=17
    #[31] Suc (n - 1) = n
  ← rewrite_goal add_1_right sym=true goal=31
    #[32] n - 1 + 1 = n
  ← apply_backward_step sub_add goal=32
    #[33] 1 ≤ n
  ← z3 goal=33 facts=[4]
    #[34] 1 ≤ n
  -> rewrite_fact eq_sym_eq sym=false goal=17 facts=[31]
    #[35] n = Suc (n - 1)
  ← rewrite_goal_with_prev goal=17 facts=[35]
    #[36] log (1 + x) ≤ sum ({0..Suc (n - 1)}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  ← rewrite_goal sum_Suc_natseg sym=false goal=36
    #[37] log (1 + x) ≤ (if 0 ≤ Suc (n - 1) then sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + -1 ^ Suc (n - 1) / of_nat (Suc (n - 1) + 1) * x ^ (Suc (n - 1) + 1) else sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)))
  cut "0 ≤ Suc (n - 1)" goal=37
    #[38] 0 ≤ Suc (n - 1)
  ← apply_backward_step le_0 goal=38
    #[39] 0 ≤ Suc (n - 1)
  ← rewrite_goal if_P sym=false goal=37 facts=[39]
    #[40] log (1 + x) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + -1 ^ Suc (n - 1) / of_nat (Suc (n - 1) + 1) * x ^ (Suc (n - 1) + 1)
  ← rewrite_goal_with_prev goal=40 facts=[31]
    #[41] log (1 + x) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + -1 ^ n / of_nat (n + 1) * x ^ (n + 1)
  cut "abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) = -1 ^ n / of_nat (n + 1) * x ^ (n + 1)" goal=41 facts=[30]
    #[42] abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) = -1 ^ n / of_nat (n + 1) * x ^ (n + 1)
  ← rewrite_goal abs_def sym=false goal=42
    #[43] (if 0 ≤ -1 ^ n / of_nat (n + 1) * x ^ (n + 1) then -1 ^ n / of_nat (n + 1) * x ^ (n + 1) else -(-1 ^ n / of_nat (n + 1) * x ^ (n + 1))) = -1 ^ n / of_nat (n + 1) * x ^ (n + 1)
  ← apply_backward_step if_P1 goal=43
    #[44] 0 ≤ -1 ^ n / of_nat (n + 1) * x ^ (n + 1)
  ← apply_backward_step real_le_mul goal=44
    #[45] 0 ≤ -1 ^ n / of_nat (n + 1)
    #[46] 0 ≤ x ^ (n + 1)
  ← rewrite_goal real_divide_def sym=false goal=45
    #[47] 0 ≤ -1 ^ n * real_inverse (of_nat (n + 1))
  ← apply_backward_step real_le_mul goal=47
    #[48] (0::real) ≤ -1 ^ n
    #[49] 0 ≤ real_inverse (of_nat (n + 1))
  ← rewrite_goal real_pow_neg sym=false goal=48
    #[50] (0::real) ≤ (if even n then 1 ^ n else -(1 ^ n))
  ← rewrite_goal if_P sym=false goal=50 facts=[3]
    #[51] (0::real) ≤ 1 ^ n
  ← rewrite_goal real_pow_one sym=false goal=51
    #[52] (0::real) ≤ 1
  ← z3 goal=52
    #[53] (0::real) ≤ 1
  ← apply_backward_step real_lt_imp_le goal=49
    #[54] 0 < real_inverse (of_nat (n + 1))
  ← apply_backward_step real_lt_inv goal=54
    #[55] (0::real) < of_nat (n + 1)
  ← rewrite_goal real_zero_def sym=false goal=55
    #[56] (of_nat::nat ⇒ real) 0 < of_nat (n + 1)
  ← rewrite_goal real_of_nat_lt sym=false goal=56
    #[57] 0 < n + 1
  ← z3 goal=57
    #[58] 0 < n + 1
  ← apply_backward_step real_pow_le goal=46
  -> rewrite_fact_with_prev goal=41 facts=[42,30]
qed

theorem log_poly_lower_bound
  fixes n :: nat, x :: real
  prop 0 <= x --> x < 1 --> odd n --> x * sum ({0..n}) (%k. -1 ^ k / of_nat (k + 1) * x ^ k) <= log (1 + x)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] x < 1
    #[3] odd n
    #[4] x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) ≤ log (1 + x)
  -> rewrite_fact odd_exists sym=false goal=4 facts=[3]
    #[5] ∃m. n = Suc (2 * m)
  exists_elim m goal=4 facts=[5]
    #[6] _VAR m
    #[7] n = Suc (2 * m)
    #[8] x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) ≤ log (1 + x)
  cut "x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))" goal=8
    #[9] x * sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ k) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  ← rewrite_goal sum_lmul sym=true goal=9
    #[10] sum ({0..n}) (λx1. x * (-1 ^ x1 / of_nat (x1 + 1) * x ^ x1)) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  cut "!a::real. !b. !c. a * ( b * c) = b * (c * a)" goal=10
    #[11] ∀a::real. ∀b. ∀c. a * (b * c) = b * (c * a)
  ← z3 goal=11
    #[12] ∀a::real. ∀b. ∀c. a * (b * c) = b * (c * a)
  ← rewrite_goal_with_prev goal=10 facts=[12]
    #[13] sum ({0..n}) (λx1. -1 ^ x1 / of_nat (x1 + 1) * (x ^ x1 * x)) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  ← rewrite_goal real_pow_add sym=false goal=13
    #[14] sum ({0..n}) (λx1. -1 ^ x1 / of_nat (x1 + 1) * (x ^ x1 * x)) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * (x ^ k * x ^ (1::nat)))
  ← rewrite_goal real_pow_1 sym=false goal=14
    #[15] sum ({0..n}) (λx1. -1 ^ x1 / of_nat (x1 + 1) * (x ^ x1 * x)) = sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * (x ^ k * x ^ (1::nat)))
  ← rewrite_goal_with_prev goal=8 facts=[9]
    #[16] sum ({0..n}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ log (1 + x)
  -> apply_forward_step alt_sign_lower_bound param_f="(λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))" param_k=n param_m="(0::nat)" goal=16
    #[17] (∀n1. abs (-1 ^ (n1 + 1) / of_nat (n1 + 1 + 1) * x ^ (n1 + 1 + 1)) ≤ abs (-1 ^ n1 / of_nat (n1 + 1) * x ^ (n1 + 1)) ∧ -1 ^ (n1 + 1) / of_nat (n1 + 1 + 1) * x ^ (n1 + 1 + 1) * (-1 ^ n1 / of_nat (n1 + 1) * x ^ (n1 + 1)) ≤ 0) ⟶ tendsto_real (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially ⟶ 0 < n ⟶ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) - abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) ≤ real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  cut "0 < n" goal=16
    #[18] 0 < n
  ← rewrite_goal_with_prev goal=18 facts=[7]
    #[19] 0 < Suc (2 * m)
  ← rewrite_goal add_1_right sym=true goal=19
    #[20] 0 < 2 * m + 1
  ← z3 goal=20
    #[21] 0 < 2 * m + 1
  -> apply_forward_step real_lt_imp_le goal=16 facts=[2]
    #[22] x ≤ 1
  -> apply_forward_step log_alt_sign_lemma goal=16 facts=[1,22]
    #[23] (∀k. abs (-1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2)) ≤ abs (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ∧ -1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2) * (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ 0) ∧ tendsto_real (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially
  -> apply_forward_step conjD1 goal=16 facts=[23]
    #[24] ∀k. abs (-1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2)) ≤ abs (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ∧ -1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2) * (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ 0
  -> apply_forward_step conjD2 goal=16 facts=[23]
    #[25] tendsto_real (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially
  cut "!k::nat. k+1+1=k+2" goal=16
    #[26] ∀k::nat. k + 1 + 1 = k + 2
  ← z3 goal=26
    #[27] ∀k::nat. k + 1 + 1 = k + 2
  -> rewrite_fact_with_prev goal=16 facts=[27,17]
    #[28] (∀n1. abs (-1 ^ (n1 + 1) / of_nat (n1 + 2) * x ^ (n1 + 2)) ≤ abs (-1 ^ n1 / of_nat (n1 + 1) * x ^ (n1 + 1)) ∧ -1 ^ (n1 + 1) / of_nat (n1 + 2) * x ^ (n1 + 2) * (-1 ^ n1 / of_nat (n1 + 1) * x ^ (n1 + 1)) ≤ 0) ⟶ tendsto_real (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially ⟶ 0 < n ⟶ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) - abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) ≤ real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  -> apply_fact goal=16 facts=[28,24,25,18]
    #[29] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) - abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) ≤ real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))
  cut "abs x < 1" goal=16
    #[30] abs x < 1
  ← z3 goal=30 facts=[1,2]
    #[31] abs x < 1
  -> apply_forward_step log_infsum goal=16 facts=[31]
    #[32] real_infsum (from 0) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) = log (1 + x)
  -> rewrite_fact_with_prev goal=16 facts=[32,29]
    #[33] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) - abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) ≤ log (1 + x)
  cut "Suc (n-1) = n" goal=16
    #[34] Suc (n - 1) = n
  ← rewrite_goal add_1_right sym=true goal=34
    #[35] n - 1 + 1 = n
  ← z3 goal=35 facts=[18]
  -> rewrite_fact eq_sym_eq sym=false goal=16 facts=[34]
    #[36] n = Suc (n - 1)
  ← rewrite_goal_with_prev goal=16 facts=[36]
    #[37] sum ({0..Suc (n - 1)}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) ≤ log (1 + x)
  ← rewrite_goal sum_Suc_natseg sym=false goal=37
    #[38] (if 0 ≤ Suc (n - 1) then sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + -1 ^ Suc (n - 1) / of_nat (Suc (n - 1) + 1) * x ^ (Suc (n - 1) + 1) else sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1))) ≤ log (1 + x)
  cut "0 ≤ Suc (n - 1)" goal=38
    #[39] 0 ≤ Suc (n - 1)
  ← apply_backward_step le_0 goal=39
    #[40] 0 ≤ Suc (n - 1)
  ← rewrite_goal if_P sym=false goal=38 facts=[40]
    #[41] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + -1 ^ Suc (n - 1) / of_nat (Suc (n - 1) + 1) * x ^ (Suc (n - 1) + 1) ≤ log (1 + x)
  ← rewrite_goal_with_prev goal=41 facts=[34]
    #[42] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + -1 ^ n / of_nat (n + 1) * x ^ (n + 1) ≤ log (1 + x)
  cut "abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) = -(-1 ^ n / of_nat (n + 1) * x ^ (n + 1))" goal=42
    #[43] abs (-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) = -(-1 ^ n / of_nat (n + 1) * x ^ (n + 1))
  cut "!x::real. 0 <= -x --> abs x = -x" goal=43
    #[44] ∀x::real. 0 ≤ -x ⟶ abs x = -x
  ← z3 goal=44
    #[45] ∀x::real. 0 ≤ -x ⟶ abs x = -x
  ← apply_prev goal=43 facts=[45]
    #[46] 0 ≤ -(-1 ^ n / of_nat (n + 1) * x ^ (n + 1))
  ← rewrite_goal real_mul_lneg sym=true goal=46
    #[47] 0 ≤ -(-1 ^ n / of_nat (n + 1)) * x ^ (n + 1)
  ← apply_backward_step real_le_mul goal=47
    #[48] 0 ≤ -(-1 ^ n / of_nat (n + 1))
    #[49] 0 ≤ x ^ (n + 1)
  ← rewrite_goal real_divide_def sym=false goal=48
    #[50] 0 ≤ -(-1 ^ n * real_inverse (of_nat (n + 1)))
  ← rewrite_goal real_mul_lneg sym=true goal=50
    #[51] 0 ≤ -(-1 ^ n) * real_inverse (of_nat (n + 1))
  ← apply_backward_step real_le_mul goal=51
    #[52] (0::real) ≤ -(-1 ^ n)
    #[53] 0 ≤ real_inverse (of_nat (n + 1))
  ← rewrite_goal real_pow_neg sym=false goal=52
    #[54] (0::real) ≤ -(if even n then 1 ^ n else -(1 ^ n))
  -> rewrite_fact not_even sym=true goal=54 facts=[3]
    #[55] ¬(even n)
  ← rewrite_goal if_not_P sym=false goal=54 facts=[55]
    #[56] (0::real) ≤ --(1 ^ n)
  ← rewrite_goal real_neg_neg sym=false goal=56
    #[57] (0::real) ≤ 1 ^ n
  ← rewrite_goal real_pow_one sym=false goal=57
    #[58] (0::real) ≤ 1
  ← z3 goal=58
    #[59] (0::real) ≤ 1
  ← apply_backward_step real_lt_imp_le goal=53
    #[60] 0 < real_inverse (of_nat (n + 1))
  ← apply_backward_step real_lt_inv goal=60
    #[61] (0::real) < of_nat (n + 1)
  ← rewrite_goal real_zero_def sym=false goal=61
    #[62] (of_nat::nat ⇒ real) 0 < of_nat (n + 1)
  ← rewrite_goal real_of_nat_lt sym=false goal=62
    #[63] 0 < n + 1
  ← z3 goal=63
    #[64] 0 < n + 1
  ← apply_backward_step real_pow_le goal=49
  -> rewrite_fact_with_prev goal=42 facts=[43,33]
    #[65] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) - -(-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) ≤ log (1 + x)
  -> rewrite_fact real_minus_def sym=false goal=42 facts=[65]
    #[66] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) + --(-1 ^ n / of_nat (n + 1) * x ^ (n + 1)) ≤ log (1 + x)
  -> rewrite_fact real_neg_neg sym=false goal=42 facts=[66]
qed

theorem log_reduce_pos_pow
  fixes k :: nat, y :: real
  prop 0 < y --> log (2 ^ k * y) = of_nat k * log 2 + log y
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 < y
    #[2] log (2 ^ k * y) = of_nat k * log 2 + log y
  -> apply_forward_step real_lt_pow2 param_n=k goal=2
    #[3] (0::real) < 2 ^ k
  -> apply_forward_step log_mul goal=2 facts=[3,1]
    #[4] log (2 ^ k * y) = log (2 ^ k) + log y
  ← rewrite_goal_with_prev goal=2 facts=[4]
    #[5] log (2 ^ k) + log y = of_nat k * log 2 + log y
  ← rewrite_goal real_eq_add_rcancel sym=false goal=5
    #[6] log (2 ^ k) = of_nat k * log 2
  ← apply_backward_step log_pow goal=6
    #[7] (0::real) < 2
  ← z3 goal=7
    #[8] (0::real) < 2
qed

theorem log_reduce_neg_pow
  fixes k :: nat, y :: real
  prop 0 < y --> log (y / 2 ^ k) = log y - of_nat k * log 2
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 < y
    #[2] log (y / 2 ^ k) = log y - of_nat k * log 2
  -> apply_forward_step real_lt_pow2 param_n=k goal=2
    #[3] (0::real) < 2 ^ k
  -> apply_forward_step log_div goal=2 facts=[1,3]
    #[4] log (y / 2 ^ k) = log y - log (2 ^ k)
  ← rewrite_goal_with_prev goal=2 facts=[4]
    #[5] log y - log (2 ^ k) = log y - of_nat k * log 2
  cut "!a::real. !b. !c. b=c --> a-b=a-c" goal=5
    #[6] ∀a::real. ∀b. ∀c. b = c ⟶ a - b = a - c
  ← z3 goal=6
    #[7] ∀a::real. ∀b. ∀c. b = c ⟶ a - b = a - c
  ← apply_prev goal=5 facts=[7]
    #[8] log (2 ^ k) = of_nat k * log 2
  ← apply_backward_step log_pow goal=8
    #[9] (0::real) < 2
  ← z3 goal=9
    #[10] (0::real) < 2
qed

