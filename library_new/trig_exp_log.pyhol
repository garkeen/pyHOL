theory trig_exp_log
imports trig_series
description "Formal inequalities for trig about exp and log series."

theorem exp_pos_poly_lower_bound
  fixes n :: nat, x :: real
  prop 0 <= x --> sum ({0..n}) (%k. real_inverse (of_nat (fact k)) * x ^ k) <= exp x
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] sum ({0..n}) (λk. real_inverse (of_nat (fact k)) * x ^ k) ≤ exp x
  ← rewrite_goal exp_infsum sym=true goal=2
    #[3] sum ({0..n}) (λk. real_inverse (of_nat (fact k)) * x ^ k) ≤ real_infsum (from 0) (λk. 1 / of_nat (fact k) * x ^ k)
  -> apply_forward_step real_infsum_offset param_f="(λk. 1 / of_nat (fact k) * x ^ k)" param_k=n param_m="(0::nat)" goal=3
    #[4] real_summable (from 0) (λk. 1 / of_nat (fact k) * x ^ k) ⟶ 0 ≤ n ⟶ real_infsum (from 0) (λk. 1 / of_nat (fact k) * x ^ k) = sum ({0..n}) (λk. 1 / of_nat (fact k) * x ^ k) + real_infsum (from (n + 1)) (λk. 1 / of_nat (fact k) * x ^ k)
  cut "real_summable (from 0) (λk. 1 / of_nat (fact k) * x ^ k)" goal=3 facts=[4]
    #[5] real_summable (from 0) (λk. 1 / of_nat (fact k) * x ^ k)
  -> apply_forward_step exp_series param_x=x goal=5
    #[6] real_sums (λk. 1 / of_nat (fact k) * x ^ k) (exp x) univ
  -> rewrite_fact from_0 sym=true goal=5 facts=[6]
    #[7] real_sums (λk. 1 / of_nat (fact k) * x ^ k) (exp x) (from 0)
  ← rewrite_goal real_summable_def sym=false goal=5
    #[8] ∃l. real_sums (λk. 1 / of_nat (fact k) * x ^ k) l (from 0)
  ← apply_backward_step exI goal=8 facts=[7]
    #[9] ∃l. real_sums (λk. 1 / of_nat (fact k) * x ^ k) l (from 0)
  cut "0 ≤ n" goal=3
    #[10] 0 ≤ n
  ← apply_backward_step le_0 goal=10
    #[11] 0 ≤ n
  -> apply_fact goal=3 facts=[4,5,11]
    #[12] real_infsum (from 0) (λk. 1 / of_nat (fact k) * x ^ k) = sum ({0..n}) (λk. 1 / of_nat (fact k) * x ^ k) + real_infsum (from (n + 1)) (λk. 1 / of_nat (fact k) * x ^ k)
  ← rewrite_goal_with_prev goal=3 facts=[12]
    #[13] sum ({0..n}) (λk. real_inverse (of_nat (fact k)) * x ^ k) ≤ sum ({0..n}) (λk. 1 / of_nat (fact k) * x ^ k) + real_infsum (from (n + 1)) (λk. 1 / of_nat (fact k) * x ^ k)
  ← rewrite_goal real_inverse_divide sym=false goal=13
    #[14] sum ({0..n}) (λk. 1 / of_nat (fact k) * x ^ k) ≤ sum ({0..n}) (λk. 1 / of_nat (fact k) * x ^ k) + real_infsum (from (n + 1)) (λk. 1 / of_nat (fact k) * x ^ k)
  cut "!a::real. !b. a <= a + b <--> 0 <= b" goal=14
    #[15] ∀a::real. ∀b. a ≤ a + b ⟷ 0 ≤ b
  ← z3 goal=15
    #[16] ∀a::real. ∀b. a ≤ a + b ⟷ 0 ≤ b
  ← rewrite_goal_with_prev goal=14 facts=[16]
    #[17] 0 ≤ real_infsum (from (n + 1)) (λk. 1 / of_nat (fact k) * x ^ k)
  ← apply_backward_step real_series_pos param_f="(λk. 1 / of_nat (fact k) * x ^ k)" param_s="from (n + 1)" goal=17
    #[18] real_sums (λk. 1 / of_nat (fact k) * x ^ k) (real_infsum (from (n + 1)) (λk. 1 / of_nat (fact k) * x ^ k)) (from (n + 1))
    #[19] ∀i. i ∈ from (n + 1) ⟶ 0 ≤ 1 / of_nat (fact i) * x ^ i
  ← rewrite_goal real_sums_infsum sym=false goal=18
    #[20] real_summable (from (n + 1)) (λk. 1 / of_nat (fact k) * x ^ k)
  ← apply_backward_step real_summable_from_elsewhere param_m="(0::nat)" goal=20
  ← introduction i goal=19
    #[21] _VAR i
    #[22] i ∈ from (n + 1)
    #[23] 0 ≤ 1 / of_nat (fact i) * x ^ i
  ← rewrite_goal real_inverse_divide sym=true goal=23
    #[24] 0 ≤ real_inverse (of_nat (fact i)) * x ^ i
  ← apply_backward_step real_le_mul goal=24
    #[25] 0 ≤ real_inverse (of_nat (fact i))
    #[26] 0 ≤ x ^ i
  ← apply_backward_step real_lt_imp_le goal=25
    #[27] 0 < real_inverse (of_nat (fact i))
  ← apply_backward_step real_lt_inv goal=27
    #[28] (0::real) < of_nat (fact i)
  ← rewrite_goal real_zero_def sym=false goal=28
    #[29] (of_nat::nat ⇒ real) 0 < of_nat (fact i)
  ← rewrite_goal real_of_nat_lt sym=false goal=29
    #[30] 0 < fact i
  ← apply_backward_step fact_lt goal=30
    #[31] 0 < fact i
  ← apply_backward_step real_pow_le goal=26
qed

theorem exp_ge1
  fixes x :: real
  prop 0 <= x --> 1 <= exp x
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] 1 ≤ exp x
  -> apply_forward_step exp_pos_poly_lower_bound param_n="(0::nat)" param_x=x goal=2
    #[3] 0 ≤ x ⟶ sum ({0..0}) (λk. real_inverse (of_nat (fact k)) * x ^ k) ≤ exp x
  -> apply_fact goal=2 facts=[3,1]
    #[4] sum ({0..0}) (λk. real_inverse (of_nat (fact k)) * x ^ k) ≤ exp x
  -> rewrite_fact sum_sing_natseg sym=false goal=2 facts=[4]
    #[5] real_inverse (of_nat (fact 0)) * x ^ (0::nat) ≤ exp x
  -> rewrite_fact fact_def_1 sym=false goal=2 facts=[5]
    #[6] real_inverse of_nat 1 * x ^ (0::nat) ≤ exp x
  -> rewrite_fact real_nat_power_def_1 sym=false goal=2 facts=[6]
    #[7] real_inverse of_nat 1 * 1 ≤ exp x
  -> rewrite_fact real_one_def sym=true goal=2 facts=[7]
    #[8] real_inverse 1 * 1 ≤ exp x
  -> rewrite_fact real_mul_rid sym=false goal=2 facts=[8]
    #[9] real_inverse 1 ≤ exp x
  -> rewrite_fact real_inv_1 sym=false goal=2 facts=[9]
qed

theorem neg_exp_le1
  fixes x :: real
  prop 0 <= x --> exp (-x) <= 1
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] exp (-x) ≤ 1
  ← rewrite_goal real_exp_neg sym=false goal=2
    #[3] real_inverse (exp x) ≤ 1
  ← apply_backward_step real_inv_le_1 goal=3
    #[4] 1 ≤ exp x
  ← apply_backward_step exp_ge1 goal=4 facts=[1]
qed

theorem neg_exp_series
  fixes x :: real
  prop real_sums (%k. -1 ^ k / of_nat (fact k) * x ^ k) (exp (-x)) (from 0)
  [hint_backward]
proof
  -> apply_forward_step exp_series param_x=-x goal=0
    #[1] real_sums (λk. 1 / of_nat (fact k) * -x ^ k) (exp (-x)) univ
  cut "!k. 1 / of_nat (fact k) * -x ^ k = -1 ^ k / of_nat (fact k) * x ^ k" goal=0
    #[2] ∀k. 1 / of_nat (fact k) * -x ^ k = -1 ^ k / of_nat (fact k) * x ^ k
  ← introduction k goal=2
    #[3] _VAR k
    #[4] 1 / of_nat (fact k) * -x ^ k = -1 ^ k / of_nat (fact k) * x ^ k
  cut "-x = -1 * x" goal=4
    #[5] -x = -1 * x
  real_norm goal=5
  ← rewrite_goal_with_prev goal=4 facts=[5]
    #[6] 1 / of_nat (fact k) * (-1 * x) ^ k = -1 ^ k / of_nat (fact k) * x ^ k
  ← rewrite_goal real_pow_mul sym=false goal=6
    #[7] 1 / of_nat (fact k) * (-1 ^ k * x ^ k) = -1 ^ k / of_nat (fact k) * x ^ k
  ← rewrite_goal real_divide_def sym=false goal=7
    #[8] 1 * real_inverse (of_nat (fact k)) * (-1 ^ k * x ^ k) = -1 ^ k * real_inverse (of_nat (fact k)) * x ^ k
  real_norm goal=8
  -> rewrite_fact_with_prev goal=0 facts=[2,1]
    #[9] real_sums (λk. -1 ^ k / of_nat (fact k) * x ^ k) (exp (-x)) univ
  ← rewrite_goal from_0 sym=false goal=0
qed

theorem neg_exp_infsum
  fixes x :: real
  prop real_infsum (from 0) (%k. -1 ^ k / of_nat (fact k) * x ^ k) = exp (-x)
  [hint_rewrite]
proof
  ← apply_backward_step real_infsum_unique goal=0
    #[1] real_sums (λk. -1 ^ k / of_nat (fact k) * x ^ k) (exp (-x)) (from 0)
  ← apply_backward_step neg_exp_series goal=1
qed

theorem n_le_fact
  fixes n :: nat
  prop n <= fact n
  [hint_backward]
proof
  ← induction n nat_induct goal=0
    #[1] 0 ≤ fact 0
    #[2] ∀n. n ≤ fact n ⟶ Suc n ≤ fact (Suc n)
  ← apply_backward_step le_0 goal=1
  ← introduction n goal=2
    #[3] _VAR n
    #[4] n ≤ fact n
    #[5] Suc n ≤ fact (Suc n)
  ← rewrite_goal fact_def_2 sym=false goal=5
    #[6] Suc n ≤ Suc n * fact n
  cut "!a::nat. !b. a <= b <--> a * 1 <= b" goal=6
    #[7] ∀a::nat. ∀b. a ≤ b ⟷ a * 1 ≤ b
  ← z3 goal=7
    #[8] ∀a::nat. ∀b. a ≤ b ⟷ a * 1 ≤ b
  ← rewrite_goal_with_prev goal=6 facts=[8]
    #[9] Suc n * 1 ≤ Suc n * fact n
  ← apply_backward_step le_mult2 goal=9
    #[10] Suc n ≤ Suc n
    #[11] 1 ≤ fact n
  ← apply_backward_step less_eq_refl goal=10
    #[12] Suc n ≤ Suc n
  ← apply_backward_step fact_le goal=11
    #[13] 1 ≤ fact n
qed

theorem exp_alt_sign_lemma
  fixes x :: real
  prop 0 <= x --> x <= 1 --> (!k. abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) <= abs (-1 ^ k / of_nat (fact k) * x ^ k) & -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) <= 0) & tendsto_real (%k. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] x ≤ 1
    #[3] (∀k. abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k) * x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0) ∧ tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially
  ← apply_backward_step conjI goal=3
    #[4] ∀k. abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k) * x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0
    #[5] tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially
  ← introduction k goal=4
    #[6] _VAR k
    #[7] abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k) * x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0
  ← rewrite_goal real_abs_mul sym=false goal=7
    #[8] abs (-1 ^ (k + 1) / of_nat (fact (k + 1))) * abs (x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k)) * abs (x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0
  ← apply_backward_step conjI goal=8
    #[9] abs (-1 ^ (k + 1) / of_nat (fact (k + 1))) * abs (x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k)) * abs (x ^ k)
    #[10] -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0
  ← apply_backward_step real_le_mul2 goal=9
    #[11] 0 ≤ abs (-1 ^ (k + 1) / of_nat (fact (k + 1)))
    #[12] abs (-1 ^ (k + 1) / of_nat (fact (k + 1))) ≤ abs (-1 ^ k / of_nat (fact k))
    #[13] 0 ≤ abs (x ^ (k + 1))
    #[14] abs (x ^ (k + 1)) ≤ abs (x ^ k)
  ← apply_backward_step real_abs_pos goal=11
    #[15] 0 ≤ abs (-1 ^ (k + 1) / of_nat (fact (k + 1)))
  ← rewrite_goal real_divide_def sym=false goal=12
    #[16] abs (-1 ^ (k + 1) * real_inverse (of_nat (fact (k + 1)))) ≤ abs (-1 ^ k * real_inverse (of_nat (fact k)))
  ← rewrite_goal real_abs_mul sym=false goal=16
    #[17] abs (-1 ^ (k + 1)) * abs (real_inverse (of_nat (fact (k + 1)))) ≤ abs (-1 ^ k) * abs (real_inverse (of_nat (fact k)))
  ← apply_backward_step real_le_mul2 goal=17
    #[18] (0::real) ≤ abs (-1 ^ (k + 1))
    #[19] abs (-(1::real) ^ (k + 1)) ≤ abs (-1 ^ k)
    #[20] 0 ≤ abs (real_inverse (of_nat (fact (k + 1))))
    #[21] abs (real_inverse (of_nat (fact (k + 1)))) ≤ abs (real_inverse (of_nat (fact k)))
  ← apply_backward_step real_abs_pos goal=18
    #[22] (0::real) ≤ abs (-1 ^ (k + 1))
  ← rewrite_goal abs_neg_one_pow sym=false goal=19
    #[23] (1::real) ≤ 1
  ← apply_backward_step real_le_refl goal=23
    #[24] (1::real) ≤ 1
  ← apply_backward_step real_abs_pos goal=20
    #[25] 0 ≤ abs (real_inverse (of_nat (fact (k + 1))))
  ← rewrite_goal real_abs_inv sym=false goal=21
    #[26] real_inverse (abs (of_nat (fact (k + 1)))) ≤ real_inverse (abs (of_nat (fact k)))
  ← rewrite_goal real_abs_nat sym=false goal=26
    #[27] real_inverse (of_nat (fact (k + 1))) ≤ real_inverse (of_nat (fact k))
  ← apply_backward_step real_le_inv2 goal=27
    #[28] (0::real) < of_nat (fact k)
    #[29] (of_nat::nat ⇒ real) (fact k) ≤ of_nat (fact (k + 1))
  ← rewrite_goal real_zero_def sym=false goal=28
    #[30] (of_nat::nat ⇒ real) 0 < of_nat (fact k)
  ← rewrite_goal real_of_nat_lt sym=false goal=30
    #[31] 0 < fact k
  ← apply_backward_step fact_lt goal=31
    #[32] 0 < fact k
  ← rewrite_goal real_of_nat_le sym=false goal=29
    #[33] fact k ≤ fact (k + 1)
  ← apply_backward_step fact_mono goal=33
    #[34] k ≤ k + 1
  ← apply_backward_step le_add goal=34
    #[35] k ≤ k + 1
  ← apply_backward_step real_abs_pos goal=13
    #[36] 0 ≤ abs (x ^ (k + 1))
  ← rewrite_goal real_abs_pow sym=false goal=14
    #[37] abs x ^ (k + 1) ≤ abs x ^ k
  ← apply_backward_step real_pow_mono_inv goal=37
    #[38] 0 ≤ abs x
    #[39] abs x ≤ 1
  ← apply_backward_step real_abs_pos goal=38
    #[40] 0 ≤ abs x
  ← z3 goal=39 facts=[1,2]
  cut "!a::real. !b. !c. !d. !r. !t. (a / b * r) * (c / d * t) <= 0 \n		 <--> 0 <= ((-1 ^ (1::nat) * a * c) * (r * t)) / b / d" goal=10
    #[41] ∀a. ∀b. ∀c. ∀d. ∀r. ∀t. a / b * r * (c / d * t) ≤ 0 ⟷ 0 ≤ -1 ^ (1::nat) * a * c * (r * t) / b / d
  ← rewrite_goal real_pow_1 sym=false goal=41
    #[42] ∀a. ∀b. ∀c. ∀d. ∀r. ∀t. a / b * r * (c / d * t) ≤ 0 ⟷ 0 ≤ -1 * a * c * (r * t) / b / d
  ← rewrite_goal real_divide_def sym=false goal=42
    #[43] ∀a. ∀b. ∀c. ∀d. ∀r. ∀t. a * real_inverse b * r * (c * real_inverse d * t) ≤ 0 ⟷ 0 ≤ -1 * a * c * (r * t) / b * real_inverse d
  ← introduction a,b,c,d,r,t goal=43
    #[44] _VAR a
    #[45] _VAR b
    #[46] _VAR c
    #[47] _VAR d
    #[48] _VAR r
    #[49] _VAR t
    #[50] a * real_inverse b * r * (c * real_inverse d * t) ≤ 0 ⟷ 0 ≤ -1 * a * c * (r * t) / b * real_inverse d
  ← rewrite_goal real_divide_def sym=false goal=50
    #[51] a * real_inverse b * r * (c * real_inverse d * t) ≤ 0 ⟷ 0 ≤ -1 * a * c * (r * t) * real_inverse b * real_inverse d
  ← z3 goal=51
    #[52] a * real_inverse b * r * (c * real_inverse d * t) ≤ 0 ⟷ 0 ≤ -1 * a * c * (r * t) * real_inverse b * real_inverse d
  ← rewrite_goal_with_prev goal=10 facts=[41]
    #[53] 0 ≤ -1 ^ (1::nat) * -1 ^ (k + 1) * -1 ^ k * (x ^ (k + 1) * x ^ k) / of_nat (fact (k + 1)) / of_nat (fact k)
  ← rewrite_goal real_pow_add sym=true goal=53
    #[54] 0 ≤ -1 ^ (1 + (k + 1)) * -1 ^ k * x ^ (k + 1 + k) / of_nat (fact (k + 1)) / of_nat (fact k)
  ← rewrite_goal real_pow_add sym=true goal=54
    #[55] 0 ≤ -1 ^ (1 + (k + 1) + k) * x ^ (k + 1 + k) / of_nat (fact (k + 1)) / of_nat (fact k)
  ← rewrite_goal real_divide_def sym=false goal=55
    #[56] 0 ≤ -1 ^ (1 + (k + 1) + k) * x ^ (k + 1 + k) / of_nat (fact (k + 1)) * real_inverse (of_nat (fact k))
  ← rewrite_goal real_divide_def sym=false goal=56
    #[57] 0 ≤ -1 ^ (1 + (k + 1) + k) * x ^ (k + 1 + k) * real_inverse (of_nat (fact (k + 1))) * real_inverse (of_nat (fact k))
  ← apply_backward_step real_le_mul goal=57
    #[58] 0 ≤ -1 ^ (1 + (k + 1) + k) * x ^ (k + 1 + k) * real_inverse (of_nat (fact (k + 1)))
    #[59] 0 ≤ real_inverse (of_nat (fact k))
  ← apply_backward_step real_le_mul goal=58
    #[60] 0 ≤ -1 ^ (1 + (k + 1) + k) * x ^ (k + 1 + k)
    #[61] 0 ≤ real_inverse (of_nat (fact (k + 1)))
  ← apply_backward_step real_le_mul goal=60
    #[62] (0::real) ≤ -1 ^ (1 + (k + 1) + k)
    #[63] 0 ≤ x ^ (k + 1 + k)
  cut "1 + (k + 1) + k = 2 * (k+1)" goal=62
    #[64] 1 + (k + 1) + k = 2 * (k + 1)
  nat_norm goal=64
    #[65] 1 + (k + 1) + k = 2 * (k + 1)
  ← rewrite_goal_with_prev goal=62 facts=[65]
    #[66] (0::real) ≤ -1 ^ (2 * (k + 1))
  ← rewrite_goal real_pow_pow sym=true goal=66
    #[67] (0::real) ≤ -1 ^ (2::nat) ^ (k + 1)
  ← apply_backward_step real_pow_le goal=67
    #[68] (0::real) ≤ -1 ^ (2::nat)
  ← apply_backward_step real_le_pow_2 goal=68
    #[69] (0::real) ≤ -1 ^ (2::nat)
  ← apply_backward_step real_pow_le goal=63
  ← apply_backward_step real_lt_imp_le goal=61
    #[70] 0 < real_inverse (of_nat (fact (k + 1)))
  ← apply_backward_step real_lt_inv goal=70
    #[71] (0::real) < of_nat (fact (k + 1))
  ← rewrite_goal real_zero_def sym=false goal=71
    #[72] (of_nat::nat ⇒ real) 0 < of_nat (fact (k + 1))
  ← rewrite_goal real_of_nat_lt sym=false goal=72
    #[73] 0 < fact (k + 1)
  ← apply_backward_step fact_lt goal=73
    #[74] 0 < fact (k + 1)
  ← apply_backward_step real_lt_imp_le goal=59
    #[75] 0 < real_inverse (of_nat (fact k))
  ← apply_backward_step real_lt_inv goal=75
  ← apply_backward_step reallim_null_comparison param_g="(%k. real_inverse (of_nat k))" goal=5
    #[76] eventually (λx1. abs (-1 ^ x1 / of_nat (fact x1) * x ^ x1) ≤ real_inverse (of_nat x1)) sequentially
    #[77] tendsto_real (λk. real_inverse (of_nat k)) 0 sequentially
  ← rewrite_goal eventually_sequentially sym=false goal=76
    #[78] ∃N. ∀n. N ≤ n ⟶ abs (-1 ^ n / of_nat (fact n) * x ^ n) ≤ real_inverse (of_nat n)
  ← inst_exists_goal "(1::nat)" goal=78
    #[79] ∀n. 1 ≤ n ⟶ abs (-1 ^ n / of_nat (fact n) * x ^ n) ≤ real_inverse (of_nat n)
  ← introduction n goal=79
    #[80] _VAR n
    #[81] 1 ≤ n
    #[82] abs (-1 ^ n / of_nat (fact n) * x ^ n) ≤ real_inverse (of_nat n)
  ← rewrite_goal real_divide_def sym=false goal=82
    #[83] abs (-1 ^ n * real_inverse (of_nat (fact n)) * x ^ n) ≤ real_inverse (of_nat n)
  ← rewrite_goal real_abs_mul sym=false goal=83
    #[84] abs (-1 ^ n * real_inverse (of_nat (fact n))) * abs (x ^ n) ≤ real_inverse (of_nat n)
  cut "∀a::real. ∀b. a ≤ b ⟷ a ≤ b * 1" goal=84
    #[85] ∀a::real. ∀b. a ≤ b ⟷ a ≤ b * 1
  ← z3 goal=85
    #[86] ∀a::real. ∀b. a ≤ b ⟷ a ≤ b * 1
  ← rewrite_goal_with_prev goal=84 facts=[86]
    #[87] abs (-1 ^ n * real_inverse (of_nat (fact n))) * abs (x ^ n) ≤ real_inverse (of_nat n) * 1
  ← apply_backward_step real_le_mul2 goal=87
    #[88] 0 ≤ abs (-1 ^ n * real_inverse (of_nat (fact n)))
    #[89] abs (-1 ^ n * real_inverse (of_nat (fact n))) ≤ real_inverse (of_nat n)
    #[90] 0 ≤ abs (x ^ n)
    #[91] abs (x ^ n) ≤ 1
  ← apply_backward_step real_abs_pos goal=88
    #[92] 0 ≤ abs (-1 ^ n * real_inverse (of_nat (fact n)))
  ← rewrite_goal real_abs_mul sym=false goal=89
    #[93] abs (-1 ^ n) * abs (real_inverse (of_nat (fact n))) ≤ real_inverse (of_nat n)
  ← rewrite_goal abs_neg_one_pow sym=false goal=93
    #[94] 1 * abs (real_inverse (of_nat (fact n))) ≤ real_inverse (of_nat n)
  ← rewrite_goal real_mul_lid sym=false goal=94
    #[95] abs (real_inverse (of_nat (fact n))) ≤ real_inverse (of_nat n)
  ← rewrite_goal real_abs_inv sym=false goal=95
    #[96] real_inverse (abs (of_nat (fact n))) ≤ real_inverse (of_nat n)
  ← rewrite_goal real_abs_nat sym=false goal=96
    #[97] real_inverse (of_nat (fact n)) ≤ real_inverse (of_nat n)
  ← apply_backward_step real_le_inv2 goal=97
    #[98] (0::real) < of_nat n
    #[99] (of_nat::nat ⇒ real) n ≤ of_nat (fact n)
  ← rewrite_goal real_zero_def sym=false goal=98
    #[100] (of_nat::nat ⇒ real) 0 < of_nat n
  ← rewrite_goal real_of_nat_lt sym=false goal=100
    #[101] 0 < n
  ← z3 goal=101 facts=[81]
    #[102] 0 < n
  ← rewrite_goal real_of_nat_le sym=false goal=99
    #[103] n ≤ fact n
  ← apply_backward_step n_le_fact goal=103
    #[104] n ≤ fact n
  ← apply_backward_step real_abs_pos goal=90
    #[105] 0 ≤ abs (x ^ n)
  ← rewrite_goal real_abs_pow sym=false goal=91
    #[106] abs x ^ n ≤ 1
  ← apply_backward_step real_pow_1_le goal=106
    #[107] 0 ≤ abs x
    #[108] abs x ≤ 1
  ← apply_backward_step real_abs_pos goal=107
  ← z3 goal=108 facts=[1,2]
  ← apply_backward_step reallim_1_over_n goal=77
    #[109] tendsto_real (λn. real_inverse (of_nat n)) 0 sequentially
qed

theorem exp_neg_poly_upper_bound
  fixes n :: nat, x :: real
  prop 0 <= x --> x <= 1 --> even n --> exp (-x) <= sum ({0..n}) (%k. -1 ^ k / of_nat (fact k) * x ^ k)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] x ≤ 1
    #[3] even n
    #[4] exp (-x) ≤ sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  -> rewrite_fact even_exists sym=false goal=4 facts=[3]
    #[5] ∃m. n = 2 * m
  exists_elim m goal=4 facts=[5]
    #[6] _VAR m
    #[7] n = 2 * m
    #[8] exp (-x) ≤ sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  ← cases "n=0" goal=8
    #[9] n = 0 ⟶ exp (-x) ≤ sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
    #[10] ¬(n = 0) ⟶ exp (-x) ≤ sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  ← introduction goal=9
    #[11] n = 0
    #[12] exp (-x) ≤ sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  ← rewrite_goal_with_prev goal=12 facts=[11]
    #[13] exp (-x) ≤ sum ({0..0}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  ← rewrite_goal sum_sing_natseg sym=false goal=13
    #[14] exp (-x) ≤ -1 ^ (0::nat) / of_nat (fact 0) * x ^ (0::nat)
  ← rewrite_goal real_nat_power_def_1 sym=false goal=14
    #[15] exp (-x) ≤ 1 / of_nat (fact 0) * 1
  ← rewrite_goal real_mul_rid sym=false goal=15
    #[16] exp (-x) ≤ 1 / of_nat (fact 0)
  ← rewrite_goal fact_def_1 sym=false goal=16
    #[17] exp (-x) ≤ 1 / of_nat 1
  ← rewrite_goal real_one_def sym=true goal=17
    #[18] exp (-x) ≤ 1 / 1
  ← rewrite_goal real_div_1 sym=false goal=18
    #[19] exp (-x) ≤ 1
  ← apply_backward_step neg_exp_le1 goal=19
  ← introduction goal=10
    #[20] ¬(n = 0)
    #[21] exp (-x) ≤ sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  -> apply_forward_step alt_sign_upper_bound param_f="(λk. -1 ^ k / of_nat (fact k) * x ^ k)" param_k=n param_m="(0::nat)" goal=21
    #[22] (∀n1. abs (-1 ^ (n1 + 1) / of_nat (fact (n1 + 1)) * x ^ (n1 + 1)) ≤ abs (-1 ^ n1 / of_nat (fact n1) * x ^ n1) ∧ -1 ^ (n1 + 1) / of_nat (fact (n1 + 1)) * x ^ (n1 + 1) * (-1 ^ n1 / of_nat (fact n1) * x ^ n1) ≤ 0) ⟶ tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially ⟶ 0 < n ⟶ real_infsum (from 0) (λk. -1 ^ k / of_nat (fact k) * x ^ k) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + abs (-1 ^ n / of_nat (fact n) * x ^ n)
  -> apply_forward_step le_1_1 goal=21 facts=[20]
    #[23] 0 < n
  -> apply_forward_step exp_alt_sign_lemma goal=21 facts=[1,2]
    #[24] (∀k. abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k) * x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0) ∧ tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially
  -> apply_forward_step conjD1 goal=21 facts=[24]
    #[25] ∀k. abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k) * x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0
  -> apply_forward_step conjD2 goal=21 facts=[24]
    #[26] tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially
  -> apply_fact goal=21 facts=[22,25,26,23]
    #[27] real_infsum (from 0) (λk. -1 ^ k / of_nat (fact k) * x ^ k) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + abs (-1 ^ n / of_nat (fact n) * x ^ n)
  -> rewrite_fact neg_exp_infsum sym=false goal=21 facts=[27]
    #[28] exp (-x) ≤ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + abs (-1 ^ n / of_nat (fact n) * x ^ n)
  ← rewrite_goal_with_prev goal=21 facts=[7]
    #[29] exp (-x) ≤ sum ({0..2 * m}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  -> rewrite_fact_with_prev goal=29 facts=[7,28]
    #[30] exp (-x) ≤ sum ({0..2 * m - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + abs (-1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m))
  cut "Suc (2 * m - 1) = 2 * m" goal=29
    #[31] Suc (2 * m - 1) = 2 * m
  ← rewrite_goal add_1_right sym=true goal=31
    #[32] 2 * m - 1 + 1 = 2 * m
  ← apply_backward_step sub_add goal=32
    #[33] 1 ≤ 2 * m
  ← apply_backward_step le_1_2 goal=33
    #[34] ¬(2 * m = 0)
  -> rewrite_fact_with_prev goal=34 facts=[7,20]
    #[35] ¬(2 * m = 0)
  -> rewrite_fact eq_sym_eq sym=false goal=29 facts=[31]
    #[36] 2 * m = Suc (2 * m - 1)
  ← rewrite_goal_with_prev goal=29 facts=[36]
    #[37] exp (-x) ≤ sum ({0..Suc (2 * m - 1)}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  ← rewrite_goal sum_Suc_natseg sym=false goal=37
    #[38] exp (-x) ≤ (if 0 ≤ Suc (2 * m - 1) then sum ({0..2 * m - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + -1 ^ Suc (2 * m - 1) / of_nat (fact (Suc (2 * m - 1))) * x ^ Suc (2 * m - 1) else sum ({0..2 * m - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k))
  cut "0 ≤ Suc (2 * m - 1)" goal=38
    #[39] 0 ≤ Suc (2 * m - 1)
  ← apply_backward_step le_0 goal=39
    #[40] 0 ≤ Suc (2 * m - 1)
  ← rewrite_goal if_P sym=false goal=38 facts=[40]
    #[41] exp (-x) ≤ sum ({0..2 * m - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + -1 ^ Suc (2 * m - 1) / of_nat (fact (Suc (2 * m - 1))) * x ^ Suc (2 * m - 1)
  ← rewrite_goal_with_prev goal=41 facts=[31]
    #[42] exp (-x) ≤ sum ({0..2 * m - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + -1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)
  cut "abs (-1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)) = -1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)" goal=42
    #[43] abs (-1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)) = -1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)
  ← rewrite_goal abs_def sym=false goal=43
    #[44] (if 0 ≤ -1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m) then -1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m) else -(-1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m))) = -1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)
  ← apply_backward_step if_P1 goal=44
    #[45] 0 ≤ -1 ^ (2 * m) / of_nat (fact (2 * m)) * x ^ (2 * m)
  ← apply_backward_step real_le_mul goal=45
    #[46] 0 ≤ -1 ^ (2 * m) / of_nat (fact (2 * m))
    #[47] 0 ≤ x ^ (2 * m)
  ← rewrite_goal real_divide_def sym=false goal=46
    #[48] 0 ≤ -1 ^ (2 * m) * real_inverse (of_nat (fact (2 * m)))
  ← apply_backward_step real_le_mul goal=48
    #[49] (0::real) ≤ -1 ^ (2 * m)
    #[50] 0 ≤ real_inverse (of_nat (fact (2 * m)))
  ← rewrite_goal real_pow_pow sym=true goal=49
    #[51] (0::real) ≤ -1 ^ (2::nat) ^ m
  ← apply_backward_step real_pow_le goal=51
    #[52] (0::real) ≤ -1 ^ (2::nat)
  ← apply_backward_step real_le_pow_2 goal=52
    #[53] (0::real) ≤ -1 ^ (2::nat)
  ← apply_backward_step real_lt_imp_le goal=50
    #[54] 0 < real_inverse (of_nat (fact (2 * m)))
  ← apply_backward_step real_lt_inv goal=54
    #[55] (0::real) < of_nat (fact (2 * m))
  ← rewrite_goal real_zero_def sym=false goal=55
    #[56] (of_nat::nat ⇒ real) 0 < of_nat (fact (2 * m))
  ← rewrite_goal real_of_nat_lt sym=false goal=56
    #[57] 0 < fact (2 * m)
  ← apply_backward_step fact_lt goal=57
    #[58] 0 < fact (2 * m)
  ← apply_backward_step real_pow_le goal=47
  -> rewrite_fact_with_prev goal=42 facts=[43,30]
qed

theorem exp_neg_poly_lower_bound
  fixes n :: nat, x :: real
  prop 0 <= x --> x <= 1 --> odd n --> sum ({0..n}) (%k. -1 ^ k / of_nat (fact k) * x ^ k) <= exp (-x)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] x ≤ 1
    #[3] odd n
    #[4] sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) ≤ exp (-x)
  -> apply_forward_step alt_sign_lower_bound param_f="(λk. -1 ^ k / of_nat (fact k) * x ^ k)" param_k=n param_m="(0::nat)" goal=4
    #[5] (∀n1. abs (-1 ^ (n1 + 1) / of_nat (fact (n1 + 1)) * x ^ (n1 + 1)) ≤ abs (-1 ^ n1 / of_nat (fact n1) * x ^ n1) ∧ -1 ^ (n1 + 1) / of_nat (fact (n1 + 1)) * x ^ (n1 + 1) * (-1 ^ n1 / of_nat (fact n1) * x ^ n1) ≤ 0) ⟶ tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially ⟶ 0 < n ⟶ sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) - abs (-1 ^ n / of_nat (fact n) * x ^ n) ≤ real_infsum (from 0) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  -> apply_forward_step exp_alt_sign_lemma goal=4 facts=[1,2]
    #[6] (∀k. abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k) * x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0) ∧ tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially
  cut "0 < n" goal=4
    #[7] 0 < n
  -> rewrite_fact odd_exists sym=false goal=7 facts=[3]
    #[8] ∃m. n = Suc (2 * m)
  exists_elim m goal=7 facts=[8]
    #[9] _VAR m
    #[10] n = Suc (2 * m)
    #[11] 0 < n
    #[12] sum ({0..n}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) ≤ exp (-x)
  ← rewrite_goal_with_prev goal=11 facts=[10]
    #[13] 0 < Suc (2 * m)
  ← rewrite_goal less_Suc_lesseq sym=false goal=13
    #[14] 0 ≤ 2 * m
  ← apply_backward_step le_0 goal=14
    #[15] 0 ≤ 2 * m
  -> apply_forward_step conjD1 goal=12 facts=[6]
    #[16] ∀k. abs (-1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1)) ≤ abs (-1 ^ k / of_nat (fact k) * x ^ k) ∧ -1 ^ (k + 1) / of_nat (fact (k + 1)) * x ^ (k + 1) * (-1 ^ k / of_nat (fact k) * x ^ k) ≤ 0
  -> apply_forward_step conjD2 goal=12 facts=[6]
    #[17] tendsto_real (λk. -1 ^ k / of_nat (fact k) * x ^ k) 0 sequentially
  -> apply_fact goal=12 facts=[5,16,17,11]
    #[18] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) - abs (-1 ^ n / of_nat (fact n) * x ^ n) ≤ real_infsum (from 0) (λk. -1 ^ k / of_nat (fact k) * x ^ k)
  -> rewrite_fact neg_exp_infsum sym=false goal=12 facts=[18]
    #[19] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) - abs (-1 ^ n / of_nat (fact n) * x ^ n) ≤ exp (-x)
  cut "Suc (n - 1) = n" goal=12
    #[20] Suc (n - 1) = n
  ← rewrite_goal add_1_right sym=true goal=20
    #[21] n - 1 + 1 = n
  ← apply_backward_step sub_add goal=21
    #[22] 1 ≤ n
  ← z3 goal=22 facts=[11]
  -> rewrite_fact eq_sym_eq sym=false goal=12 facts=[20]
    #[23] n = Suc (n - 1)
  ← rewrite_goal_with_prev goal=12 facts=[23]
    #[24] sum ({0..Suc (n - 1)}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) ≤ exp (-x)
  ← rewrite_goal sum_Suc_natseg sym=false goal=24
    #[25] (if 0 ≤ Suc (n - 1) then sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + -1 ^ Suc (n - 1) / of_nat (fact (Suc (n - 1))) * x ^ Suc (n - 1) else sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k)) ≤ exp (-x)
  cut "0 ≤ Suc (n - 1)" goal=25
    #[26] 0 ≤ Suc (n - 1)
  ← apply_backward_step le_0 goal=26
    #[27] 0 ≤ Suc (n - 1)
  ← rewrite_goal if_P sym=false goal=25 facts=[27]
    #[28] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + -1 ^ Suc (n - 1) / of_nat (fact (Suc (n - 1))) * x ^ Suc (n - 1) ≤ exp (-x)
  -> rewrite_fact real_minus_def sym=false goal=28 facts=[19]
    #[29] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + -(abs (-1 ^ n / of_nat (fact n) * x ^ n)) ≤ exp (-x)
  ← rewrite_goal_with_prev goal=28 facts=[20]
    #[30] sum ({0..n - 1}) (λk. -1 ^ k / of_nat (fact k) * x ^ k) + -1 ^ n / of_nat (fact n) * x ^ n ≤ exp (-x)
  cut "-(abs (-1 ^ n / of_nat (fact n) * x ^ n)) = -1 ^ n / of_nat (fact n) * x ^ n" goal=30 facts=[29]
    #[31] -(abs (-1 ^ n / of_nat (fact n) * x ^ n)) = -1 ^ n / of_nat (fact n) * x ^ n
  cut "!x::real. x<= 0 --> -(abs x) = x" goal=31
    #[32] ∀x::real. x ≤ 0 ⟶ -(abs x) = x
  ← z3 goal=32
    #[33] ∀x::real. x ≤ 0 ⟶ -(abs x) = x
  ← apply_prev goal=31 facts=[33]
    #[34] -1 ^ n / of_nat (fact n) * x ^ n ≤ 0
  ← rewrite_goal real_pow_neg sym=false goal=34
    #[35] (if even n then 1 ^ n else -(1 ^ n)) / of_nat (fact n) * x ^ n ≤ 0
  -> rewrite_fact not_even sym=true goal=35 facts=[3]
    #[36] ¬(even n)
  ← rewrite_goal if_not_P sym=false goal=35 facts=[36]
    #[37] -(1 ^ n) / of_nat (fact n) * x ^ n ≤ 0
  ← rewrite_goal real_pow_one sym=false goal=37
    #[38] -1 / of_nat (fact n) * x ^ n ≤ 0
  ← rewrite_goal real_divide_def sym=false goal=38
    #[39] -1 * real_inverse (of_nat (fact n)) * x ^ n ≤ 0
  ← rewrite_goal real_mul_lneg sym=false goal=39
    #[40] -(1 * real_inverse (of_nat (fact n))) * x ^ n ≤ 0
  ← rewrite_goal real_mul_lid sym=false goal=40
    #[41] -(real_inverse (of_nat (fact n))) * x ^ n ≤ 0
  ← rewrite_goal real_mul_lneg sym=false goal=41
    #[42] -(real_inverse (of_nat (fact n)) * x ^ n) ≤ 0
  cut "!x::real. 0<= x --> -x <= 0" goal=42
    #[43] ∀x::real. 0 ≤ x ⟶ -x ≤ 0
  ← z3 goal=43
    #[44] ∀x::real. 0 ≤ x ⟶ -x ≤ 0
  ← apply_prev goal=42 facts=[44]
    #[45] 0 ≤ real_inverse (of_nat (fact n)) * x ^ n
  ← apply_backward_step real_le_mul goal=45
    #[46] 0 ≤ real_inverse (of_nat (fact n))
    #[47] 0 ≤ x ^ n
  ← apply_backward_step real_lt_imp_le goal=46
    #[48] 0 < real_inverse (of_nat (fact n))
  ← apply_backward_step real_lt_inv goal=48
    #[49] (0::real) < of_nat (fact n)
  ← rewrite_goal real_zero_def sym=false goal=49
    #[50] (of_nat::nat ⇒ real) 0 < of_nat (fact n)
  ← rewrite_goal real_of_nat_lt sym=false goal=50
    #[51] 0 < fact n
  ← apply_backward_step fact_lt goal=51
    #[52] 0 < fact n
  ← apply_backward_step real_pow_le goal=47
  -> rewrite_fact_with_prev goal=30 facts=[31,29]
qed

theorem exp_reduce
  fixes k :: nat, x :: real
  prop 0 < k --> exp (x / of_nat k) ^ k = exp x
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 < k
    #[2] exp (x / of_nat k) ^ k = exp x
  ← rewrite_goal real_exp_n sym=true goal=2
    #[3] exp (of_nat k * (x / of_nat k)) = exp x
  cut "of_nat k * (x / of_nat k) = x * (of_nat k / of_nat k)" goal=3
    #[4] of_nat k * (x / of_nat k) = x * (of_nat k / of_nat k)
  ← rewrite_goal real_divide_def sym=false goal=4
    #[5] of_nat k * (x * real_inverse (of_nat k)) = x * (of_nat k * real_inverse (of_nat k))
  real_norm goal=5
    #[6] of_nat k * (x * real_inverse (of_nat k)) = x * (of_nat k * real_inverse (of_nat k))
  ← rewrite_goal_with_prev goal=3 facts=[4]
    #[7] exp (x * (of_nat k / of_nat k)) = exp x
  cut "~(of_nat k = (0::real))" goal=7
    #[8] ¬(of_nat k = (0::real))
  ← rewrite_goal real_zero_def sym=false goal=8
    #[9] ¬((of_nat::nat ⇒ real) k = of_nat 0)
  ← rewrite_goal real_of_nat_eq sym=false goal=9
    #[10] ¬(k = 0)
  ← z3 goal=10 facts=[1]
  -> apply_forward_step real_div_refl goal=7 facts=[8]
    #[11] of_nat k / of_nat k = 1
  ← rewrite_goal_with_prev goal=7 facts=[11]
    #[12] exp (x * 1) = exp x
  ← rewrite_goal real_mul_rid sym=false goal=12
    #[13] exp (x * 1) = exp x
qed

theorem exp_full_reduce
  fixes k :: nat, x :: real
  prop 0 < k --> real_inverse (exp (-x / of_nat k) ^ k) = exp x
  [hint_backward]
proof
  ← introduction goal=0
    #[1] 0 < k
    #[2] real_inverse (exp (-x / of_nat k) ^ k) = exp x
  -> apply_forward_step exp_reduce param_x=x goal=2 facts=[1]
    #[3] exp (x / of_nat k) ^ k = exp x
  ← rewrite_goal real_pow_inv sym=true goal=2
    #[4] real_inverse (exp (-x / of_nat k)) ^ k = exp x
  ← rewrite_goal real_exp_neg sym=true goal=4
    #[5] exp (-(-x / of_nat k)) ^ k = exp x
  ← rewrite_goal real_divide_def sym=false goal=5
    #[6] exp (-(-x * real_inverse (of_nat k))) ^ k = exp x
  ← rewrite_goal real_mul_lneg sym=false goal=6
    #[7] exp (--(x * real_inverse (of_nat k))) ^ k = exp x
  ← rewrite_goal real_neg_neg sym=false goal=7
    #[8] exp (x * real_inverse (of_nat k)) ^ k = exp x
  -> rewrite_fact real_divide_def sym=false goal=8 facts=[3]
qed

theorem log_alt_sign_lemma
  fixes x :: real
  prop 0 <= x --> x <= 1 --> (!k. abs (-1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2)) <= abs (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) & -1 ^ (k + 1) / of_nat (k + 2) * x ^ (k + 2) * (-1 ^ k / of_nat (k + 1) * x ^ (k + 1)) <= 0) & tendsto_real (%k. -1 ^ k / of_nat (k + 1) * x ^ (k + 1)) 0 sequentially
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] 0 ≤ x
    #[2] x ≤ 1
