theory interval_arith
imports realgamma
description "Theoretical results for interval arithmetic."

def interval_arith :: real ⇒ real ⇒ real ⇒ bool = interval_arith x lo hi ⟷ lo ≤ x ∧ x ≤ hi [hint_rewrite]

def iabs :: real ⇒ real ⇒ real = iabs x_lo x_hi = max x_hi (-x_lo) [hint_rewrite]

def interval_not_zero :: real ⇒ real ⇒ bool = interval_not_zero lo hi ⟷ 0 < lo ∨ hi < 0 [hint_rewrite]

def interval_pos :: real ⇒ real ⇒ bool = interval_pos lo hi ⟷ 0 < lo [hint_rewrite]

def interval_neg :: real ⇒ real ⇒ bool = interval_neg lo hi ⟷ hi < 0 [hint_rewrite]

def interval_gt :: real ⇒ real ⇒ real ⇒ bool = interval_gt f lo hi ⟷ f < lo [hint_rewrite]

theorem const_interval
  fixes x :: real
  prop x Mem real_closed_interval x x
  [hint_backward]

theorem add_interval_closed
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop x Mem real_closed_interval a b --> y Mem real_closed_interval c d --> x + y Mem real_closed_interval (a + c) (b + d)

theorem add_interval_open
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop x Mem real_open_interval a b --> y Mem real_open_interval c d --> x + y Mem real_open_interval (a + c) (b + d)

theorem add_interval_open_closed
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop x Mem real_open_interval a b --> y Mem real_closed_interval c d --> x + y Mem real_open_interval (a + c) (b + d)

theorem add_interval_closed_open
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop x Mem real_closed_interval a b --> y Mem real_open_interval c d --> x + y Mem real_open_interval (a + c) (b + d)

theorem add_interval_closed_lopen
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop x Mem real_closed_interval a b --> y Mem real_lopen_interval c d --> x + y Mem real_lopen_interval (a + c) (b + d)

theorem add_interval_closed_ropen
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop x Mem real_closed_interval a b --> y Mem real_ropen_interval c d --> x + y Mem real_ropen_interval (a + c) (b + d)

theorem neg_interval_closed
  fixes a :: real, b :: real, x :: real
  prop x Mem real_closed_interval a b --> -x Mem real_closed_interval (-b) (-a)
proof
  ← introduction goal=0
    #[1] x ∈ real_closed_interval a b
    #[2] -x ∈ real_closed_interval (-b) (-a)
  ← rewrite_goal in_real_closed_interval sym=false goal=2
    #[3] -b ≤ -x ∧ -x ≤ -a
  ← apply_backward_step conjI goal=3
    #[4] -b ≤ -x
    #[5] -x ≤ -a
  ← rewrite_goal real_le_lneg2 sym=false goal=4
    #[6] x ≤ b
  → rewrite_fact in_real_closed_interval sym=false goal=6 facts=[1]
    #[7] a ≤ x ∧ x ≤ b
  ← apply_backward_step conjD2 goal=6 facts=[7]
  ← rewrite_goal real_le_lneg2 sym=false goal=5
    #[8] a ≤ x
  ← apply_backward_step conjD1 goal=8 facts=[7]
qed

theorem neg_interval_open
  fixes a :: real, b :: real, x :: real
  prop x Mem real_open_interval a b --> -x Mem real_open_interval (-b) (-a)

theorem inverse_interval_pos_closed
  fixes a :: real, b :: real, x :: real
  prop a > 0 --> x Mem real_closed_interval a b --> real_inverse x Mem real_closed_interval (real_inverse b) (real_inverse a)

theorem inverse_interval_neg_closed
  fixes a :: real, b :: real, x :: real
  prop b < 0 --> x Mem real_closed_interval a b --> real_inverse x Mem real_closed_interval (real_inverse b) (real_inverse a)

theorem inverse_interval_pos_open
  fixes a :: real, b :: real, x :: real
  prop a > 0 --> x Mem real_open_interval a b --> real_inverse x Mem real_open_interval (real_inverse b) (real_inverse a)

theorem inverse_interval_neg_open
  fixes a :: real, b :: real, x :: real
  prop b < 0 --> x Mem real_open_interval a b --> real_inverse x Mem real_open_interval (real_inverse b) (real_inverse a)

theorem mult_interval_pos_pos_open
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop a >= 0 --> c >= 0 --> x Mem real_open_interval a b --> y Mem real_open_interval c d --> x * y Mem real_open_interval (a * c) (b * d)

theorem mult_interval_pos_pos_closed
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop a >= 0 --> c >= 0 --> x Mem real_closed_interval a b --> y Mem real_closed_interval c d --> x * y Mem real_closed_interval (a * c) (b * d)

theorem mult_interval_pos_pos_lopen_ropen
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop a >= 0 --> c >= 0 --> x Mem real_lopen_interval a b --> y Mem real_ropen_interval c d --> x * y Mem real_open_interval (a * c) (b * d)

theorem mult_interval_neg_pos_open
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop b <= 0 --> c >= 0 --> x Mem real_open_interval a b --> y Mem real_open_interval c d --> x * y Mem real_open_interval (a * d) (b * c)

theorem mult_interval_pos_closed
  fixes a :: real, b :: real, c :: real, x :: real
  prop c >= 0 --> x Mem real_closed_interval a b --> c * x Mem real_closed_interval (c * a) (c * b)

theorem mult_interval_pos_open
  fixes a :: real, b :: real, c :: real, d :: real, x :: real, y :: real
  prop c >= 0 --> x Mem real_open_interval a b --> c * x Mem real_open_interval (c * a) (c * b)

theorem mult_interval_pos_lopen
  fixes a :: real, b :: real, c :: real, x :: real
  prop c >= 0 --> x Mem real_lopen_interval a b --> c * x Mem real_lopen_interval (c * a) (c * b)

theorem mult_interval_pos_ropen
  fixes a :: real, b :: real, c :: real, x :: real
  prop c >= 0 --> x Mem real_ropen_interval a b --> c * x Mem real_ropen_interval (c * a) (c * b)

theorem mult_interval_neg_closed
  fixes a :: real, b :: real, c :: real, x :: real
  prop c < 0 --> x Mem real_closed_interval a b --> c * x Mem real_closed_interval (c * b) (c * a)

theorem mult_interval_neg_open
  fixes a :: real, b :: real, c :: real, x :: real
  prop c < 0 --> x Mem real_open_interval a b --> c * x Mem real_open_interval (c * b) (c * a)

theorem mult_interval_neg_lopen
  fixes a :: real, b :: real, c :: real, x :: real
  prop c < 0 --> x Mem real_lopen_interval a b --> c * x Mem real_ropen_interval (c * b) (c * a)

theorem mult_interval_neg_ropen
  fixes a :: real, b :: real, c :: real, x :: real
  prop c < 0 --> x Mem real_ropen_interval a b --> c * x Mem real_lopen_interval (c * b) (c * a)

theorem nat_power_interval_pos_closed
  fixes a :: real, b :: real, n :: nat, x :: real
  prop a >= 0 --> x Mem real_closed_interval a b --> x ^ n Mem real_closed_interval (a ^ n) (b ^ n)

theorem nat_power_interval_pos_open
  fixes a :: real, b :: real, n :: nat, x :: real
  prop a >= 0 --> x Mem real_open_interval a b --> x ^ n Mem real_open_interval (a ^ n) (b ^ n)

theorem nat_power_interval_pos_lopen
  fixes a :: real, b :: real, n :: nat, x :: real
  prop a >= 0 --> x Mem real_lopen_interval a b --> x ^ n Mem real_lopen_interval (a ^ n) (b ^ n)

theorem nat_power_interval_pos_ropen
  fixes a :: real, b :: real, n :: nat, x :: real
  prop a >= 0 --> x Mem real_ropen_interval a b --> x ^ n Mem real_ropen_interval (a ^ n) (b ^ n)

theorem nat_power_interval_neg_even_closed
  fixes a :: real, b :: real, n :: nat, x :: real
  prop b <= 0 --> even n --> x Mem real_closed_interval a b --> x ^ n Mem real_closed_interval (b ^ n) (a ^ n)

theorem nat_power_interval_neg_odd_closed
  fixes a :: real, b :: real, n :: nat, x :: real
  prop b <= 0 --> odd n --> x Mem real_closed_interval a b --> x ^ n Mem real_closed_interval (a ^ n) (b ^ n)

theorem nat_power_interval_neg_even_open
  fixes a :: real, b :: real, n :: nat, x :: real
  prop b <= 0 --> even n --> x Mem real_open_interval a b --> x ^ n Mem real_open_interval (b ^ n) (a ^ n)

theorem nat_power_interval_neg_odd_open
  fixes a :: real, b :: real, n :: nat, x :: real
  prop b <= 0 --> odd n --> x Mem real_open_interval a b --> x ^ n Mem real_open_interval (a ^ n) (b ^ n)

theorem real_power_interval_pos_closed
  fixes a :: real, b :: real, p :: real, x :: real
  prop p >= 0 --> a >= 0 --> x Mem real_closed_interval a b --> x ^ p Mem real_closed_interval (a ^ p) (b ^ p)

theorem real_power_interval_pos_open
  fixes a :: real, b :: real, p :: real, x :: real
  prop p >= 0 --> a >= 0 --> x Mem real_open_interval a b --> x ^ p Mem real_open_interval (a ^ p) (b ^ p)

theorem real_power_interval_neg_closed
  fixes a :: real, b :: real, p :: real, x :: real
  prop p < 0 --> a > 0 --> x Mem real_closed_interval a b --> x ^ p Mem real_closed_interval (b ^ p) (a ^ p)

theorem real_power_interval_neg_open
  fixes a :: real, b :: real, p :: real, x :: real
  prop p < 0 --> a >= 0 --> x Mem real_open_interval a b --> x ^ p Mem real_open_interval (b ^ p) (a ^ p)

theorem real_power_interval_neg_lopen
  fixes a :: real, b :: real, p :: real, x :: real
  prop p < 0 --> a >= 0 --> x Mem real_lopen_interval a b --> x ^ p Mem real_ropen_interval (b ^ p) (a ^ p)

theorem log_interval_closed
  fixes a :: real, b :: real, x :: real
  prop a > 0 --> x Mem real_closed_interval a b --> log x Mem real_closed_interval (log a) (log b)

theorem log_interval_open
  fixes a :: real, b :: real, x :: real
  prop a >= 0 --> x Mem real_open_interval a b --> log x Mem real_open_interval (log a) (log b)

theorem exp_interval_closed
  fixes a :: real, b :: real, x :: real
  prop x Mem real_closed_interval a b --> exp x Mem real_closed_interval (exp a) (exp b)
  [hint_backward]

theorem exp_interval_open
  fixes a :: real, b :: real, x :: real
  prop x Mem real_open_interval a b --> exp x Mem real_open_interval (exp a) (exp b)

theorem sin_interval_main_closed
  fixes a :: real, b :: real, x :: real
  prop a >= -pi / 2 --> b <= pi / 2 --> x Mem real_closed_interval a b --> sin x Mem real_closed_interval (sin a) (sin b)

theorem sin_interval_main_open
  fixes a :: real, b :: real, x :: real
  prop a >= -pi / 2 --> b <= pi / 2 --> x Mem real_open_interval a b --> sin x Mem real_open_interval (sin a) (sin b)

theorem sin_interval_pos_closed
  fixes a :: real, b :: real, x :: real
  prop a >= 0 --> b <= pi --> x Mem real_closed_interval a b --> sin x Mem real_closed_interval 0 1

theorem sin_interval_pos_open
  fixes a :: real, b :: real, x :: real
  prop a >= 0 --> b <= pi --> x Mem real_open_interval a b --> sin x Mem real_closed_interval 0 1

theorem cos_interval_main_closed
  fixes a :: real, b :: real, x :: real
  prop a >= 0 --> b <= pi --> x Mem real_closed_interval a b --> cos x Mem real_closed_interval (cos b) (cos a)

theorem cos_interval_main_open
  fixes a :: real, b :: real, x :: real
  prop a >= 0 --> b <= pi --> x Mem real_open_interval a b --> cos x Mem real_open_interval (cos b) (cos a)

theorem cos_interval_pos_closed
  fixes a :: real, b :: real, x :: real
  prop a >= -pi / 2 --> b <= pi / 2 --> x Mem real_closed_interval a b --> cos x Mem real_closed_interval 0 1

theorem cos_interval_pos_open
  fixes a :: real, b :: real, x :: real
  prop a >= -pi / 2 --> b <= pi / 2 --> x Mem real_open_interval a b --> cos x Mem real_lopen_interval 0 1

theorem atn_interval_closed
  fixes a :: real, b :: real, x :: real
  prop x Mem real_closed_interval a b --> atn x Mem real_closed_interval (atn a) (atn b)

theorem atn_interval_open
  fixes a :: real, b :: real, x :: real
  prop x Mem real_open_interval a b --> atn x Mem real_open_interval (atn a) (atn b)

theorem split_interval_closed
  fixes I1 :: real set, I2 :: real set, a :: real, b :: real, c :: real, f :: real => real, x :: real
  prop a <= c --> c <= b --> (x Mem real_closed_interval a c --> f x Mem I1) --> (x Mem real_closed_interval c b --> f x Mem I2) --> x Mem real_closed_interval a b --> f x Mem I1 Un I2

theorem split_interval_open
  fixes I1 :: real set, I2 :: real set, a :: real, b :: real, c :: real, f :: real => real, x :: real
  prop a <= c --> c <= b --> (x Mem real_open_interval a c --> f x Mem I1) --> (x Mem real_ropen_interval c b --> f x Mem I2) --> x Mem real_open_interval a b --> f x Mem I1 Un I2

theorem closed_interval_union
  fixes a :: real, b :: real, c :: real, d :: real
  prop real_closed_interval a b Un real_closed_interval c d Sub real_closed_interval (min a c) (max b d)

theorem open_ropen_interval_union1
  fixes a :: real, b :: real, c :: real, d :: real
  prop c <= a --> real_open_interval a b Un real_ropen_interval c d Sub real_ropen_interval c (max b d)

theorem open_ropen_interval_union2
  fixes a :: real, b :: real, c :: real, d :: real
  prop a < c --> real_open_interval a b Un real_ropen_interval c d Sub real_open_interval a (max b d)

