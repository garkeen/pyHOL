  → apply_forward_step all_conj_distrib goal=8 facts=[14]
    #[15] (∀x. 0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative f (f1 x) (atreal x)) ∧ (∀x. (0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative g (g1 x) (atreal x)) ∧ (0 < abs (x - c) ⟶ abs (x - c) < d ⟶ ¬(g1 x = 0)))
  → apply_forward_step conjD1 goal=8 facts=[15]
    #[16] ∀x. 0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative f (f1 x) (atreal x)
  → apply_forward_step conjD2 goal=8 facts=[15]
    #[17] ∀x. (0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative g (g1 x) (atreal x)) ∧ (0 < abs (x - c) ⟶ abs (x - c) < d ⟶ ¬(g1 x = 0))
  → apply_forward_step all_conj_distrib goal=8 facts=[17]
    #[18] (∀x. 0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative g (g1 x) (atreal x)) ∧ (∀x. 0 < abs (x - c) ⟶ abs (x - c) < d ⟶ ¬(g1 x = 0))
  → apply_forward_step conjD1 goal=8 facts=[18]
