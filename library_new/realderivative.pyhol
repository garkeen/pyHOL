  → rewrite_fact_with_prev goal=8 facts=[10,2]
    #[11] ∀x. 0 < abs (x - c) ⟶ (abs (x - c) < d ⟶ has_real_derivative f (f1 x) (atreal x)) ∧ (abs (x - c) < d ⟶ has_real_derivative g (g1 x) (atreal x) ∧ ¬(g1 x = 0))
  → rewrite_fact_with_prev goal=8 facts=[10,11]
    #[12] ∀x. (0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative f (f1 x) (atreal x)) ∧ (0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative g (g1 x) (atreal x) ∧ ¬(g1 x = 0))
  → rewrite_fact_with_prev goal=8 facts=[10,12]
    #[13] ∀x. (0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative f (f1 x) (atreal x)) ∧ (0 < abs (x - c) ⟶ (abs (x - c) < d ⟶ has_real_derivative g (g1 x) (atreal x)) ∧ (abs (x - c) < d ⟶ ¬(g1 x = 0)))
  → rewrite_fact_with_prev goal=8 facts=[10,13]
