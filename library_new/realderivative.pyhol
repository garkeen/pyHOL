theorem lhospital
  fixes c :: real, d :: real, f :: real => real, f1 :: real => real, g :: real => real, g1 :: real => real, l :: real
  prop 0 < d --> (!x. 0 < abs (x - c) --> abs (x - c) < d --> has_real_derivative f (f1 x) (atreal x) & has_real_derivative g (g1 x) (atreal x) & ~(g1 x = 0)) --> tendsto_real f 0 (atreal c) --> tendsto_real g 0 (atreal c) --> tendsto_real (%x. f1 x / g1 x) l (atreal c) --> tendsto_real (%x. f x / g x) l (atreal c)
  [hint_backward,hint_backward1]

theorem real_derivative_ivt_increasing
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real
  prop a <= b --> (!x. x Mem real_closed_interval a b --> has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) --> (!t. f1 a <= t --> t <= f1 b --> (?x. x Mem real_closed_interval a b & f1 x = t))
  [hint_backward,hint_backward1]

theorem real_derivative_ivt_decreasing
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real
  prop a <= b --> (!x. x Mem real_closed_interval a b --> has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) --> (!t. f1 b <= t --> t <= f1 a --> (?x. x Mem real_closed_interval a b & f1 x = t))
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] a ≤ b
    #[2] ∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))
    #[3] ∀t. f1 b ≤ t ⟶ t ≤ f1 a ⟶ (∃x. x ∈ real_closed_interval a b ∧ f1 x = t)
  → apply_forward_step real_derivative_ivt_increasing param_f="(%x. -f x)" param_f1="(%x. -f1 x)" goal=3 facts=[1]
    #[4] (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative (λx1. -(f x1)) (-(f1 x)) (within (atreal x) (real_closed_interval a b))) ⟶ (∀t. -(f1 a) ≤ t ⟶ t ≤ -(f1 b) ⟶ (∃x. x ∈ real_closed_interval a b ∧ -(f1 x) = t))
  cut "(∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative (λx1. -(f x1)) (-(f1 x)) (within (atreal x) (real_closed_interval a b)))" goal=3
    #[5] ∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative (λx1. -(f x1)) (-(f1 x)) (within (atreal x) (real_closed_interval a b))
  ← introduction x goal=5
    #[6] _VAR x
    #[7] x ∈ real_closed_interval a b
    #[8] has_real_derivative (λx1. -(f x1)) (-(f1 x)) (within (atreal x) (real_closed_interval a b))
  ← apply_backward_step has_real_derivative_neg goal=8
    #[9] has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))
  ← apply_prev goal=9 facts=[2]
  → apply_fact goal=3 facts=[4,5]
    #[10] ∀t. -(f1 a) ≤ t ⟶ t ≤ -(f1 b) ⟶ (∃x. x ∈ real_closed_interval a b ∧ -(f1 x) = t)
  ← introduction t goal=3
    #[11] _VAR t
    #[12] f1 b ≤ t
    #[13] t ≤ f1 a
    #[14] ∃x. x ∈ real_closed_interval a b ∧ f1 x = t
  → forall_elim -t goal=14 facts=[10]
    #[15] -(f1 a) ≤ -t ⟶ -t ≤ -(f1 b) ⟶ (∃x. x ∈ real_closed_interval a b ∧ -(f1 x) = -t)
  → rewrite_fact real_eq_neg2 sym=false goal=14 facts=[15]
    #[16] -(f1 a) ≤ -t ⟶ -t ≤ -(f1 b) ⟶ (∃x. x ∈ real_closed_interval a b ∧ f1 x = t)
  → rewrite_fact real_le_lneg2 sym=false goal=14 facts=[16]
    #[17] t ≤ f1 a ⟶ f1 b ≤ t ⟶ (∃x. x ∈ real_closed_interval a b ∧ f1 x = t)
  ← apply_prev goal=14 facts=[17]
qed

theorem has_real_derivative_inverse_basic
  fixes f :: real => real, f1 :: real, g :: real => real, t :: real set, y :: real
  prop has_real_derivative f f1 (atreal (g y)) --> ~(f1 = 0) --> real_continuous g (atreal y) --> real_open t --> y Mem t --> (!z. z Mem t --> f (g z) = z) --> has_real_derivative g (real_inverse f1) (atreal y)
  [hint_backward,hint_backward1]

theorem has_real_derivative_inverse_strong
  fixes f :: real => real, f1 :: real, g :: real => real, s :: real set, x :: real
  prop real_open s --> x Mem s --> real_continuous_on f s --> (!x1. x1 Mem s --> g (f x1) = x1) --> has_real_derivative f f1 (atreal x) --> ~(f1 = 0) --> has_real_derivative g (real_inverse f1) (atreal (f x))
  [hint_backward,hint_backward1]

theorem has_real_derivative_inverse_strong_x
  fixes f :: real => real, f1 :: real, g :: real => real, s :: real set, y :: real
  prop real_open s --> g y Mem s --> real_continuous_on f s --> (!x. x Mem s --> g (f x) = x) --> has_real_derivative f f1 (atreal (g y)) --> ~(f1 = 0) --> f (g y) = y --> has_real_derivative g (real_inverse f1) (atreal y)
  [hint_backward,hint_backward1]

