  → rewrite_fact real_differentiable_on_differentiable sym=false goal=4 facts=[1]
    #[5] ∀x. x ∈ t ⟶ real_differentiable f (within (atreal x) t)
  → rewrite_fact real_differentiable_on_differentiable sym=false goal=4 facts=[2]
    #[6] ∀x. x ∈ t ⟶ real_differentiable g (within (atreal x) t)
  ← introduction x goal=4
    #[7] _VAR x
    #[8] x ∈ t
    #[9] real_differentiable (λx1. f x1 + g x1) (within (atreal x) t)
  ← apply_backward_step real_differentiable_add goal=9
    #[10] real_differentiable f (within (atreal x) t)
    #[11] real_differentiable g (within (atreal x) t)
  ← apply_prev goal=10 facts=[5]
  ← apply_prev goal=11 facts=[6]
qed

