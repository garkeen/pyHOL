theorem reallim_x_times_log
  prop tendsto_real (%x. x * log x) 0 (within (atreal 0) ({x. 0 <= x}))
  [hint_backward]

theorem reallim_root_refl
  prop tendsto_real (%n. root n (of_nat n)) 1 sequentially
  [hint_backward]
proof
  ← apply_backward_step reallim_transform_eventually param_f="(%n. exp (log (of_nat n) / of_nat n))" goal=0
    #[1] eventually (λx. exp (log (of_nat x) / of_nat x) = root x (of_nat x)) sequentially
    #[2] tendsto_real (λn. exp (log (of_nat n) / of_nat n)) 1 sequentially
  ← rewrite_goal eventually_sequentially sym=false goal=1
    #[3] ∃N. ∀n. N ≤ n ⟶ exp (log (of_nat n) / of_nat n) = root n (of_nat n)
  ← inst_exists_goal "(1::nat)" goal=3
    #[4] ∀n. 1 ≤ n ⟶ exp (log (of_nat n) / of_nat n) = root n (of_nat n)
  ← introduction n goal=4
    #[5] _VAR n
    #[6] 1 ≤ n
    #[7] exp (log (of_nat n) / of_nat n) = root n (of_nat n)
  ← rewrite_goal root_def sym=false goal=7
    #[8] exp (log (of_nat n) / of_nat n) = real_sgn (of_nat n) * exp (log (abs (of_nat n)) / of_nat n)
  ← rewrite_goal real_sgn_def sym=false goal=8
    #[9] exp (log (of_nat n) / of_nat n) = (if (0::real) < of_nat n then 1 else if of_nat n < (0::real) then -1 else 0) * exp (log (abs (of_nat n)) / of_nat n)
  cut "(0::real) < of_nat n" goal=9
    #[10] (0::real) < of_nat n
  ← rewrite_goal real_less_def sym=false goal=10
    #[11] ¬(of_nat n ≤ (0::real))
  ← rewrite_goal real_zero_def sym=false goal=11
    #[12] ¬((of_nat::nat ⇒ real) n ≤ of_nat 0)
  ← rewrite_goal real_of_nat_le sym=false goal=12
    #[13] ¬(n ≤ 0)
  ← rewrite_goal nat_less_eq_def_1 sym=false goal=13
    #[14] ¬(n = 0)
  ← z3 goal=14 facts=[6]
  ← rewrite_goal if_P sym=false goal=9 facts=[10]
    #[15] exp (log (of_nat n) / of_nat n) = 1 * exp (log (abs (of_nat n)) / of_nat n)
  ← rewrite_goal real_abs_nat sym=false goal=15
    #[16] exp (log (of_nat n) / of_nat n) = 1 * exp (log (of_nat n) / of_nat n)
  ← rewrite_goal real_mul_lid sym=false goal=16
    #[17] exp (log (of_nat n) / of_nat n) = 1 * exp (log (of_nat n) / of_nat n)
  ← rewrite_goal real_exp_0 sym=true goal=2
    #[18] tendsto_real (λn. exp (log (of_nat n) / of_nat n)) (exp 0) sequentially
  ← apply_backward_step reallim_real_continuous_function goal=18
    #[19] real_continuous exp (atreal 0)
    #[20] tendsto_real (λx. log (of_nat x) / of_nat x) 0 sequentially
  ← apply_backward_step real_continuous_at_exp goal=19
  ← apply_backward_step reallim_log_over_n goal=20
qed

