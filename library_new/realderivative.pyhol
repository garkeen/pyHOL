  → rewrite_fact real_differentiable_def sym=false goal=5 facts=[3]
    #[6] ∃f1. has_real_derivative f f1 (atreal x)
  exists_elim f1 goal=5 facts=[6]
    #[7] _VAR f1
    #[8] has_real_derivative f f1 (atreal x)
    #[9] ∃f1. has_real_derivative g f1 (atreal x)
    #[10] real_differentiable g (atreal x)
  ← inst_exists_goal f1 goal=9
    #[11] has_real_derivative g f1 (atreal x)
  ← apply_backward_step has_real_derivative_transform_atreal goal=11 facts=[1,2]
qed

