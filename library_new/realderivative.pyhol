  ← apply_backward_step conjI goal=61
    #[62] g c = g x
    #[63] ¬(real_continuous_on g (real_closed_interval c x) ⟶ (∀x1. x1 ∈ real_open_interval c x ⟶ has_real_derivative g (g1 x1) (atreal x1)) ⟶ (∃x1. x1 ∈ real_open_interval c x ∧ g1 x1 = 0))
