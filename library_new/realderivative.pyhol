theorem real_derivative_rpow_right
  fixes a :: real, f :: real => real, x :: real
  prop real_differentiable f (atreal a) --> 0 < f a --> real_derivative (%x1. a ^ f x1) x = log a * a ^ f x * real_derivative f x

theorem real_differentiable_at_rpow
  fixes x :: real, y :: real
  prop 0 < x --> real_differentiable (%x1. x1 ^ y) (atreal x)
  [hint_backward]

theorem real_differentiable_at_rpow_right
  fixes a :: real, x :: real
  prop 0 < a --> real_differentiable (%x1. a ^ x1) (atreal x)

theorem real_continuous_at_rpow
  fixes x :: real, y :: real
  prop (x = 0 --> 0 <= y) --> real_continuous (%x1. x1 ^ y) (atreal x)
  [hint_backward]

theorem real_continuous_within_rpow
  fixes s :: real set, x :: real, y :: real
  prop (x = 0 --> 0 <= y) --> real_continuous (%x1. x1 ^ y) (within (atreal x) s)
  [hint_backward]

theorem real_continuous_on_rpow
  fixes s :: real set, y :: real
  prop (0 Mem s --> 0 <= y) --> real_continuous_on (%x. x ^ y) s
  [hint_backward]

theorem real_continuous_at_rpow_right
  fixes a :: real, x :: real
  prop 0 < a --> real_continuous (%x1. a ^ x1) (atreal x)
  [hint_backward]

theorem reallim_rpow
  fixes f :: 'a => real, l :: real, n :: real, net :: 'a net
  prop tendsto_real f l net --> (l = 0 --> 0 <= n) --> tendsto_real (%x. f x ^ n) (l ^ n) net
  [hint_backward,hint_backward1]

theorem reallim_null_pow_eq
  fixes f :: 'a => real, n :: nat, net :: 'a net
  prop ~(n = 0) --> tendsto_real (%x. f x ^ n) 0 net <--> tendsto_real f 0 net
  [hint_backward,hint_backward1]

theorem has_real_derivative_frac
  fixes x :: real
  prop ~(integer x) --> has_real_derivative frac 1 (atreal x)
  [hint_backward]

theorem real_differentiable_frac
  fixes x :: real
  prop ~(integer x) --> real_differentiable frac (atreal x)
  [hint_backward]

theorem real_differentiable_polynomial_function_atreal
  fixes p :: real => real, x :: real
  prop polynomial_function p --> real_differentiable p (atreal x)
  [hint_backward]

theorem real_differentiable_polynomial_function_within
  fixes p :: real => real, s :: real set, x :: real
  prop polynomial_function p --> real_differentiable p (within (atreal x) s)

theorem real_differentiable_on_polynomial_function
  fixes p :: real => real, s :: real set
  prop polynomial_function p --> real_differentiable_on p s

theorem real_continuous_polynomial_function_atreal
  fixes p :: real => real, x :: real
  prop polynomial_function p --> real_continuous p (atreal x)

theorem real_continuous_polynomial_function_within
  fixes p :: real => real, s :: real set, x :: real
  prop polynomial_function p --> real_continuous p (within (atreal x) s)

theorem real_continuous_on_polynomial_function
  fixes p :: real => real, s :: real set
  prop polynomial_function p --> real_continuous_on p s

theorem real_ivt_increasing
  fixes a :: real, b :: real, f :: real => real, y :: real
  prop a <= b --> real_continuous_on f (real_closed_interval a b) --> f a <= y --> y <= f b --> (?x. x Mem real_closed_interval a b & f x = y)
  [hint_backward,hint_backward1]

theorem real_ivt_decreasing
  fixes a :: real, b :: real, f :: real => real, y :: real
  prop a <= b --> real_continuous_on f (real_closed_interval a b) --> f b <= y --> y <= f a --> (?x. x Mem real_closed_interval a b & f x = y)
  [hint_backward,hint_backward1]

theorem is_realinterval_continuous_image
  fixes f :: real => real, s :: real set
  prop real_continuous_on f s --> is_realinterval s --> is_realinterval (image f s)
  [hint_backward,hint_backward1]

theorem real_derivative_pos_left_minimum
  fixes a :: real, b :: real, e :: real, f :: real => real, f1 :: real
  prop a < b --> 0 < e --> has_real_derivative f f1 (within (atreal a) (real_closed_interval a b)) --> (!x. x Mem real_closed_interval a b & abs (x - a) < e --> f a <= f x) --> 0 <= f1
  [hint_backward,hint_backward1]

theorem real_derivative_neg_left_maximum
  fixes a :: real, b :: real, e :: real, f :: real => real, f1 :: real
  prop a < b --> 0 < e --> has_real_derivative f f1 (within (atreal a) (real_closed_interval a b)) --> (!x. x Mem real_closed_interval a b & abs (x - a) < e --> f x <= f a) --> f1 <= 0
  [hint_backward,hint_backward1]

theorem real_derivative_pos_right_maximum
  fixes a :: real, b :: real, e :: real, f :: real => real, f1 :: real
  prop a < b --> 0 < e --> has_real_derivative f f1 (within (atreal b) (real_closed_interval a b)) --> (!x. x Mem real_closed_interval a b & abs (x - b) < e --> f x <= f b) --> 0 <= f1
  [hint_backward,hint_backward1]

theorem real_derivative_neg_right_minimum
  fixes a :: real, b :: real, e :: real, f :: real => real, f1 :: real
  prop a < b --> 0 < e --> has_real_derivative f f1 (within (atreal b) (real_closed_interval a b)) --> (!x. x Mem real_closed_interval a b & abs (x - b) < e --> f b <= f x) --> f1 <= 0
  [hint_backward,hint_backward1]

theorem real_derivative_zero_maxmin
  fixes f :: real => real, f1 :: real, s :: real set, x :: real
  prop x Mem s --> real_open s --> has_real_derivative f f1 (atreal x) --> (!y. y Mem s --> f y <= f x) | (!y. y Mem s --> f x <= f y) --> f1 = 0
  [hint_backward,hint_backward1]

theorem real_rolle
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real
  prop a < b --> f a = f b --> real_continuous_on f (real_closed_interval a b) --> (!x. x Mem real_open_interval a b --> has_real_derivative f (f1 x) (atreal x)) --> (?x. x Mem real_open_interval a b & f1 x = 0)
  [hint_backward,hint_backward1]

theorem real_mvt
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real
  prop a < b --> real_continuous_on f (real_closed_interval a b) --> (!x. x Mem real_open_interval a b --> has_real_derivative f (f1 x) (atreal x)) --> (?x. x Mem real_open_interval a b & f b - f a = f1 x * (b - a))
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] a < b
    #[2] real_continuous_on f (real_closed_interval a b)
    #[3] ∀x. x ∈ real_open_interval a b ⟶ has_real_derivative f (f1 x) (atreal x)
    #[4] ∃x. x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a)
  → apply_forward_step real_rolle param_a=a param_b=b param_f="(%x. f x - (f b - f a) / (b - a) * x)" param_f1="(%x. f1 x - (f b - f a) / (b - a))" goal=4
    #[5] a < b ⟶ f a - (f b - f a) / (b - a) * a = f b - (f b - f a) / (b - a) * b ⟶ real_continuous_on (λx. f x - (f b - f a) / (b - a) * x) (real_closed_interval a b) ⟶ (∀x. x ∈ real_open_interval a b ⟶ has_real_derivative (λx1. f x1 - (f b - f a) / (b - a) * x1) (f1 x - (f b - f a) / (b - a)) (atreal x)) ⟶ (∃x. x ∈ real_open_interval a b ∧ f1 x - (f b - f a) / (b - a) = 0)
  → apply_fact goal=4 facts=[5,1]
    #[6] f a - (f b - f a) / (b - a) * a = f b - (f b - f a) / (b - a) * b ⟶ real_continuous_on (λx. f x - (f b - f a) / (b - a) * x) (real_closed_interval a b) ⟶ (∀x. x ∈ real_open_interval a b ⟶ has_real_derivative (λx1. f x1 - (f b - f a) / (b - a) * x1) (f1 x - (f b - f a) / (b - a)) (atreal x)) ⟶ (∃x. x ∈ real_open_interval a b ∧ f1 x - (f b - f a) / (b - a) = 0)
  cut "!fx. a < b --> fx - (f b - f a) / (b - a) = 0 <--> (f b - f a) = fx * (b - a)" goal=4 facts=[6]
    #[7] ∀fx. a < b ⟶ fx - (f b - f a) / (b - a) = 0 ⟷ f b - f a = fx * (b - a)
  ← z3 goal=7
    #[8] ∀fx. a < b ⟶ fx - (f b - f a) / (b - a) = 0 ⟷ f b - f a = fx * (b - a)
  → apply_fact goal=4 facts=[8,1]
    #[9] ∀fx. fx - (f b - f a) / (b - a) = 0 ⟷ f b - f a = fx * (b - a)
  → rewrite_fact_with_prev goal=4 facts=[9,6]
    #[10] f a - (f b - f a) / (b - a) * a = f b - (f b - f a) / (b - a) * b ⟶ real_continuous_on (λx. f x - (f b - f a) / (b - a) * x) (real_closed_interval a b) ⟶ (∀x. x ∈ real_open_interval a b ⟶ has_real_derivative (λx1. f x1 - (f b - f a) / (b - a) * x1) (f1 x - (f b - f a) / (b - a)) (atreal x)) ⟶ (∃x. x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a))
  ← apply_prev goal=4 facts=[10]
    #[11] f a - (f b - f a) / (b - a) * a = f b - (f b - f a) / (b - a) * b
    #[12] real_continuous_on (λx. f x - (f b - f a) / (b - a) * x) (real_closed_interval a b)
    #[13] ∀x. x ∈ real_open_interval a b ⟶ has_real_derivative (λx1. f x1 - (f b - f a) / (b - a) * x1) (f1 x - (f b - f a) / (b - a)) (atreal x)
  ← z3 goal=11
    #[14] f a - (f b - f a) / (b - a) * a = f b - (f b - f a) / (b - a) * b
  ← apply_backward_step real_continuous_on_sub goal=12
    #[15] real_continuous_on (λx. (f b - f a) / (b - a) * x) (real_closed_interval a b)
  ← apply_backward_step real_continuous_on_lmul goal=15
    #[16] real_continuous_on (λx. x) (real_closed_interval a b)
  ← apply_backward_step real_continuous_on_id goal=16
    #[17] real_continuous_on (λx. x) (real_closed_interval a b)
  ← introduction x goal=13
    #[18] _VAR x
    #[19] x ∈ real_open_interval a b
    #[20] has_real_derivative (λx1. f x1 - (f b - f a) / (b - a) * x1) (f1 x - (f b - f a) / (b - a)) (atreal x)
  ← apply_backward_step has_real_derivative_sub goal=20
    #[21] has_real_derivative f (f1 x) (atreal x)
    #[22] has_real_derivative (λx1. (f b - f a) / (b - a) * x1) ((f b - f a) / (b - a)) (atreal x)
  ← apply_prev goal=21 facts=[3]
  cut "has_real_derivative (λx1. (f b - f a) / (b - a) * x1) ((f b - f a) / (b - a) * 1) (atreal x)" goal=22
    #[23] has_real_derivative (λx1. (f b - f a) / (b - a) * x1) ((f b - f a) / (b - a) * 1) (atreal x)
  ← apply_backward_step has_real_derivative_lmul_atreal goal=23
    #[24] has_real_derivative (λx1. x1) 1 (atreal x)
  ← apply_backward_step has_real_derivative_id goal=24
    #[25] has_real_derivative (λx1. x1) 1 (atreal x)
  → rewrite_fact real_mul_rid sym=false goal=22 facts=[23]
qed

theorem real_mvt_simple
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real
  prop a < b --> (!x. x Mem real_closed_interval a b --> has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) --> (?x. x Mem real_open_interval a b & f b - f a = f1 x * (b - a))
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] a < b
    #[2] ∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))
    #[3] ∃x. x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a)
  ← apply_backward_step real_mvt goal=3
    #[4] real_continuous_on f (real_closed_interval a b)
    #[5] ∀x. x ∈ real_open_interval a b ⟶ has_real_derivative f (f1 x) (atreal x)
  ← apply_backward_step real_differentiable_on_imp_real_continuous_on goal=4
    #[6] real_differentiable_on f (real_closed_interval a b)
  ← rewrite_goal real_differentiable_on_def sym=false goal=6
    #[7] ∀x. x ∈ real_closed_interval a b ⟶ (∃f1. has_real_derivative f f1 (within (atreal x) (real_closed_interval a b)))
  ← introduction x goal=7
    #[8] _VAR x
    #[9] x ∈ real_closed_interval a b
    #[10] ∃f1. has_real_derivative f f1 (within (atreal x) (real_closed_interval a b))
  → apply_fact goal=10 facts=[2,9]
    #[11] has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))
  ← apply_backward_step exI goal=10 facts=[11]
    #[12] ∃f1. has_real_derivative f f1 (within (atreal x) (real_closed_interval a b))
  ← introduction x goal=5
    #[13] x ∈ real_open_interval a b
    #[14] has_real_derivative f (f1 x) (atreal x)
  cut "real_open (real_open_interval a b)" goal=14
    #[15] real_open (real_open_interval a b)
  ← apply_backward_step real_open_real_interval goal=15
    #[16] real_open (real_open_interval a b)
  → apply_forward_step has_real_derivative_within_real_open param_f=f param_f1="f1 x" goal=14 facts=[13,16]
    #[17] has_real_derivative f (f1 x) (within (atreal x) (real_open_interval a b)) ⟷ has_real_derivative f (f1 x) (atreal x)
  → rewrite_fact eq_sym_eq sym=false goal=14 facts=[17]
    #[18] has_real_derivative f (f1 x) (atreal x) ⟷ has_real_derivative f (f1 x) (within (atreal x) (real_open_interval a b))
  ← rewrite_goal_with_prev goal=14 facts=[18]
    #[19] has_real_derivative f (f1 x) (within (atreal x) (real_open_interval a b))
  ← apply_backward_step has_real_derivative_within_subset param_s="(real_closed_interval a b)" goal=19
    #[20] has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))
    #[21] real_open_interval a b ⊆ real_closed_interval a b
  ← apply_prev goal=20 facts=[2]
    #[22] x ∈ real_closed_interval a b
  cut "real_open_interval a b ⊆ real_closed_interval a b" goal=22
  ← apply_backward_step real_interval_open_subset_closed goal=21
    #[23] real_open_interval a b ⊆ real_closed_interval a b
  ← apply_backward_step subsetE goal=22 facts=[23]
  ← apply_backward_step real_interval_open_subset_closed goal=21
qed

theorem real_mvt_very_simple
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real
  prop a <= b --> (!x. x Mem real_closed_interval a b --> has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) --> (?x. x Mem real_closed_interval a b & f b - f a = f1 x * (b - a))
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] a ≤ b
    #[2] ∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))
    #[3] ∃x. x ∈ real_closed_interval a b ∧ f b - f a = f1 x * (b - a)
  → rewrite_fact real_le_lt sym=false goal=3 facts=[1]
    #[4] a < b ∨ a = b
  ← apply_backward_step disjE goal=3 facts=[4]
    #[5] a < b ⟶ (∃x. x ∈ real_closed_interval a b ∧ f b - f a = f1 x * (b - a))
    #[6] a = b ⟶ (∃x. x ∈ real_closed_interval a b ∧ f b - f a = f1 x * (b - a))
  ← introduction goal=5
    #[7] a < b
    #[8] ∃x. x ∈ real_closed_interval a b ∧ f b - f a = f1 x * (b - a)
  → apply_forward_step real_mvt_simple param_f=f param_f1=f1 goal=8 facts=[7]
    #[9] (∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) ⟶ (∃x. x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a))
  → apply_fact goal=8 facts=[9,2]
    #[10] ∃x. x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a)
  exists_elim x goal=8 facts=[10]
    #[11] _VAR x
    #[12] x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a)
    #[13] ∃x. x ∈ real_closed_interval a b ∧ f b - f a = f1 x * (b - a)
  ← inst_exists_goal x goal=13
    #[14] x ∈ real_closed_interval a b ∧ f b - f a = f1 x * (b - a)
  ← apply_backward_step conjI goal=14
    #[15] x ∈ real_closed_interval a b
    #[16] f b - f a = f1 x * (b - a)
  → apply_forward_step conjD1 goal=15 facts=[12]
    #[17] x ∈ real_open_interval a b
  ← apply_backward_step subsetE param_A="real_open_interval a b" goal=15
    #[18] real_open_interval a b ⊆ real_closed_interval a b
  ← apply_backward_step real_interval_open_subset_closed goal=18
    #[19] real_open_interval a b ⊆ real_closed_interval a b
  ← apply_backward_step conjD2 goal=16 facts=[12]
    #[20] f b - f a = f1 x * (b - a)
  ← introduction goal=6
    #[21] a = b
    #[22] ∃x. x ∈ real_closed_interval a b ∧ f b - f a = f1 x * (b - a)
  ← rewrite_goal_with_prev goal=22 facts=[21]
    #[23] ∃x. x ∈ real_closed_interval b b ∧ f b - f b = f1 x * (b - b)
  ← inst_exists_goal b goal=23
    #[24] b ∈ real_closed_interval b b ∧ f b - f b = f1 b * (b - b)
  ← apply_backward_step conjI goal=24
    #[25] b ∈ real_closed_interval b b
    #[26] f b - f b = f1 b * (b - b)
  ← rewrite_goal real_closed_interval_def sym=false goal=25
    #[27] b ∈ {p. b ≤ p ∧ p ≤ b}
  ← rewrite_goal member_collect sym=false goal=27
    #[28] b ≤ b ∧ b ≤ b
  ← rewrite_goal real_le_antisym sym=false goal=28
    #[29] b ≤ b ∧ b ≤ b
  real_norm goal=26
    #[30] f b - f b = f1 b * (b - b)
qed

theorem real_rolle_simple
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real
  prop a < b --> f a = f b --> (!x. x Mem real_closed_interval a b --> has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))) --> (?x. x Mem real_open_interval a b & f1 x = 0)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] a < b
    #[2] f a = f b
    #[3] ∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b))
    #[4] ∃x. x ∈ real_open_interval a b ∧ f1 x = 0
  → apply_forward_step real_mvt_simple goal=4 facts=[1,3]
    #[5] ∃x. x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a)
  exists_elim x goal=4 facts=[5]
    #[6] _VAR x
    #[7] x ∈ real_open_interval a b ∧ f b - f a = f1 x * (b - a)
    #[8] ∃x. x ∈ real_open_interval a b ∧ f1 x = 0
  ← inst_exists_goal x goal=8
    #[9] x ∈ real_open_interval a b ∧ f1 x = 0
  ← apply_backward_step conjI goal=9
    #[10] x ∈ real_open_interval a b
    #[11] f1 x = 0
  ← apply_backward_step conjD1 goal=10 facts=[7]
    #[12] x ∈ real_open_interval a b
  → apply_forward_step conjD2 goal=11 facts=[7]
    #[13] f b - f a = f1 x * (b - a)
  → rewrite_fact_with_prev goal=11 facts=[2,13]
    #[14] f b - f b = f1 x * (b - a)
  cut "f b - f b = f1 x * (b - a) <--> f1 x = 0 | b = a" goal=11 facts=[14]
    #[15] f b - f b = f1 x * (b - a) ⟷ f1 x = 0 ∨ b = a
  ← z3 goal=15
    #[16] f b - f b = f1 x * (b - a) ⟷ f1 x = 0 ∨ b = a
  → rewrite_fact_with_prev goal=11 facts=[16,14]
    #[17] f1 x = 0 ∨ b = a
  ← apply_backward_step disjE goal=11 facts=[17]
    #[18] f1 x = 0 ⟶ f1 x = 0
    #[19] b = a ⟶ f1 x = 0
  ← introduction goal=19
    #[20] b = a
    #[21] f1 x = 0
  ← z3 goal=21 facts=[1,20]
    #[22] f1 x = 0
qed

theorem real_mvt_cauchy
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real, g :: real => real, g1 :: real => real
  prop a < b --> real_continuous_on f (real_closed_interval a b) --> real_continuous_on g (real_closed_interval a b) --> (!x. x Mem real_open_interval a b --> has_real_derivative f (f1 x) (atreal x) & has_real_derivative g (g1 x) (atreal x)) --> (?x. x Mem real_open_interval a b & (f b - f a) * g1 x = (g b - g a) * f1 x)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] a < b
    #[2] real_continuous_on f (real_closed_interval a b)
    #[3] real_continuous_on g (real_closed_interval a b)
    #[4] ∀x. x ∈ real_open_interval a b ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)
    #[5] ∃x. x ∈ real_open_interval a b ∧ (f b - f a) * g1 x = (g b - g a) * f1 x
  → apply_forward_step real_mvt param_f="(%x. f x * (g b - g a) - g x * (f b - f a))" param_f1="(%x. f1 x * (g b - g a) - g1 x * (f b - f a))" goal=5 facts=[1]
    #[6] real_continuous_on (λx. f x * (g b - g a) - g x * (f b - f a)) (real_closed_interval a b) ⟶ (∀x. x ∈ real_open_interval a b ⟶ has_real_derivative (λx1. f x1 * (g b - g a) - g x1 * (f b - f a)) (f1 x * (g b - g a) - g1 x * (f b - f a)) (atreal x)) ⟶ (∃x. x ∈ real_open_interval a b ∧ f b * (g b - g a) - g b * (f b - f a) - (f a * (g b - g a) - g a * (f b - f a)) = (f1 x * (g b - g a) - g1 x * (f b - f a)) * (b - a))
  cut "real_continuous_on (λx. f x * (g b - g a) - g x * (f b - f a)) (real_closed_interval a b)" goal=5
    #[7] real_continuous_on (λx. f x * (g b - g a) - g x * (f b - f a)) (real_closed_interval a b)
  ← apply_backward_step real_continuous_on_sub goal=7
    #[8] real_continuous_on (λx. f x * (g b - g a)) (real_closed_interval a b)
    #[9] real_continuous_on (λx. g x * (f b - f a)) (real_closed_interval a b)
