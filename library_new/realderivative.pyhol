    #[8] ∃f1. has_real_derivative (λx1. real_inverse (f x1)) f1 (within (atreal x) s)
    #[9] real_differentiable (λx1. real_inverse (f x1)) (within (atreal x) s)
  ← inst_exists_goal "(-f1 / f x ^ (2::nat))" goal=8
    #[10] has_real_derivative (λx1. real_inverse (f x1)) (-f1 / f x ^ (2::nat)) (within (atreal x) s)
  ← apply_backward_step has_real_derivative_inv_within goal=10
qed

theorem real_differentiable_inv_atreal
  fixes f :: real => real, x :: real
  prop real_differentiable f (atreal x) --> ~(f x = 0) --> real_differentiable (%x1. real_inverse (f x1)) (atreal x)
