theory realderivative
imports realanalysis, transcendentals, misc
description "Some analytic concepts for real."

def has_real_derivative :: (real ⇒ real) ⇒ real ⇒ real net ⇒ bool = has_real_derivative f f1 net ⟷ tendsto_real (λx. real_inverse (x - netlimit net) * (f x - (f (netlimit net) + f1 * (x - netlimit net)))) 0 net [hint_rewrite]

def real_differentiable :: (real ⇒ real) ⇒ real net ⇒ bool = real_differentiable f net ⟷ (∃f1. has_real_derivative f f1 net) [hint_rewrite]

def real_derivative :: (real ⇒ real) ⇒ real ⇒ real = real_derivative f x = (THE f1. has_real_derivative f f1 (atreal x)) [hint_rewrite]

fun higher_real_derivative :: nat ⇒ (real ⇒ real) ⇒ real ⇒ real
  | higher_real_derivative 0 f = f
  | higher_real_derivative (Suc n) f = real_derivative (higher_real_derivative n f)

def real_differentiable_on :: (real ⇒ real) ⇒ real set ⇒ bool = real_differentiable_on f s ⟷ (∀x. x ∈ s ⟶ (∃f1. has_real_derivative f f1 (within (atreal x) s))) [hint_rewrite]

theorem has_real_derivative_withinreal
  fixes a :: real, f :: real => real, f1 :: real, s :: real set
  prop has_real_derivative f f1 (within (atreal a) s) <--> tendsto_real (%x. (f x - f a) / (x - a)) f1 (within (atreal a) s)
  [hint_rewrite]

theorem has_real_derivative_atreal
  fixes a :: real, f :: real => real, f1 :: real
  prop has_real_derivative f f1 (atreal a) <--> tendsto_real (%x. (f x - f a) / (x - a)) f1 (atreal a)
  [hint_rewrite]

theorem real_differentiable_on_differentiable
  fixes f :: real => real, s :: real set
  prop real_differentiable_on f s <--> (!x. x Mem s --> real_differentiable f (within (atreal x) s))
  [hint_rewrite]

theorem real_differentiable_on_real_open
  fixes f :: real => real, s :: real set
  prop real_open s --> real_differentiable_on f s <--> (!x. x Mem s --> (?f1. has_real_derivative f f1 (atreal x)))

theorem real_differentiable_on_imp_differentiable_within
  fixes f :: real => real, s :: real set, x :: real
  prop real_differentiable_on f s --> x Mem s --> real_differentiable f (within (atreal x) s)

theorem real_differentiable_on_imp_differentiable_atreal
  fixes f :: real => real, s :: real set, x :: real
  prop real_differentiable_on f s --> real_open s --> x Mem s --> real_differentiable f (atreal x)

theorem has_real_derivative_caratheodory_atreal
  fixes a :: real, f :: real => real, f1 :: real
  prop has_real_derivative f f1 (atreal a) <--> (?g. (!b. f b - f a = g b * (b - a)) & real_continuous g (atreal a) & g a = f1)

theorem has_real_derivative_caratheodory_withinreal
  fixes a :: real, f :: real => real, f1 :: real, s :: real set
  prop has_real_derivative f f1 (within (atreal a) s) <--> (?g. (!b. f b - f a = g b * (b - a)) & real_continuous g (within (atreal a) s) & g a = f1)

theorem real_differentiable_caratheodory_atreal
  fixes a :: real, f :: real => real
  prop real_differentiable f (atreal a) <--> (?g. (!b. f b - f a = g b * (b - a)) & real_continuous g (atreal a))

theorem real_differentiable_caratheodory_withinreal
  fixes a :: real, f :: real => real, s :: real set
  prop real_differentiable f (within (atreal a) s) <--> (?g. (!b. f b - f a = g b * (b - a)) & real_continuous g (within (atreal a) s))

theorem trivial_limit_within_realinterval
  fixes s :: real set, x :: real
  prop is_realinterval s --> x Mem s --> trivial_limit (within (atreal x) s) <--> s = {x}

theorem is_real_interval_cases
  fixes s :: real set
  prop is_realinterval s <--> s = {} | s = univ | (?a. s = {x. a < x}) | (?a. s = {x. a <= x}) | (?b. s = {x. x < b}) | (?b. s = {x. x <= b}) | (?a. ?b. s = {x. a < x & x < b}) | (?a. ?b. s = {x. a < x & x <= b}) | (?a. ?b. s = {x. a <= x & x < b}) | (?a. ?b. s = {x. a <= x & x <= b})

theorem is_realinterval_clauses_1
  fixes a :: real
  prop is_realinterval ({x. a < x})
  [hint_backward]

theorem is_realinterval_clauses_2
  fixes a :: real
  prop is_realinterval ({x. a <= x})
  [hint_backward]

theorem is_realinterval_clauses_3
  fixes a :: real
  prop is_realinterval ({x. x < a})
  [hint_backward]

theorem is_realinterval_clauses_4
  fixes a :: real
  prop is_realinterval ({x. x <= a})
  [hint_backward]

theorem is_realinterval_clauses_5
  fixes a :: real, b :: real
  prop is_realinterval ({x. a < x & x < b})
  [hint_backward]

theorem is_realinterval_clauses_6
  fixes a :: real, b :: real
  prop is_realinterval ({x. a < x & x <= b})
  [hint_backward]

theorem is_realinterval_clauses_7
  fixes a :: real, b :: real
  prop is_realinterval ({x. a <= x & x < b})
  [hint_backward]

theorem is_realinterval_clauses_8
  fixes a :: real, b :: real
  prop is_realinterval ({x. a <= x & x <= b})
  [hint_backward]

theorem real_convex
  fixes s :: real set
  prop is_realinterval s <--> (!x. !y. !u. !v. x Mem s --> y Mem s --> 0 <= u --> 0 <= v --> u + v = 1 --> u * x + v * y Mem s)
  [hint_rewrite]

theorem real_convex_alt
  fixes s :: real set
  prop is_realinterval s <--> (!x. !y. !u. x Mem s --> y Mem s --> 0 <= u --> u <= 1 --> (1 - u) * x + u * y Mem s)
  [hint_rewrite]

theorem real_midpoint_in_convex
  fixes s :: real set, x :: real, y :: real
  prop is_realinterval s --> x Mem s --> y Mem s --> (x + y) / 2 Mem s
  [hint_backward,hint_backward1,hint_forward]

theorem image_affinity_real_interval
  fixes a :: real, b :: real, c :: real, m :: real
  prop image (%x. m * x + c) (real_closed_interval a b) = (if real_closed_interval a b = {} then {} else if 0 <= m then real_closed_interval (m * a + c) (m * b + c) else real_closed_interval (m * b + c) (m * a + c))

theorem image_stretch_real_interval
  fixes a :: real, b :: real, m :: real
  prop image (%x. m * x) (real_closed_interval a b) = (if real_closed_interval a b = {} then {} else if 0 <= m then real_closed_interval (m * a) (m * b) else real_closed_interval (m * b) (m * a))
  [hint_rewrite]

theorem real_closed_interval_translation
  fixes a :: real, b :: real, c :: real
  prop real_closed_interval (c + a) (c + b) = image (%x. c + x) (real_closed_interval a b)
  [hint_rewrite]

theorem real_open_interval_translation
  fixes a :: real, b :: real, c :: real
  prop real_open_interval (c + a) (c + b) = image (%x. c + x) (real_open_interval a b)
  [hint_rewrite]

theorem real_differentiable_imp_continuous_withinreal
  fixes f :: real => real, s :: real set, x :: real
  prop real_differentiable f (within (atreal x) s) --> real_continuous f (within (atreal x) s)
  [hint_backward,hint_forward]

theorem real_differentiable_imp_continuous_atreal
  fixes f :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_continuous f (atreal x)
  [hint_backward,hint_forward]

theorem has_real_derivative_imp_continuous_withinreal
  fixes f :: real => real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> real_continuous f (within (atreal x) s)
  [hint_backward,hint_forward]

theorem has_real_derivative_imp_continuous_atreal
  fixes f :: real => real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> real_continuous f (atreal x)
  [hint_backward,hint_forward]

theorem real_differentiable_on_imp_real_continuous_on
  fixes f :: real => real, s :: real set
  prop real_differentiable_on f s --> real_continuous_on f s
  [hint_backward,hint_forward]

theorem real_continuous_transform_withinreal_set_imp
  fixes a :: real, f :: real => real, s :: real set, t :: real set
  prop eventually (%x. x Mem t --> x Mem s) (atreal a) --> real_continuous f (within (atreal a) s) --> real_continuous f (within (atreal a) t)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_derivative_within_subset
  fixes f :: real => real, f1 :: real, s :: real set, t :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> t Sub s --> has_real_derivative f f1 (within (atreal x) t)
  [hint_backward,hint_forward,hint_backward1]

theorem real_differentiable_on_subset
  fixes f :: real => real, s :: real set, t :: real set
  prop real_differentiable_on f s --> t Sub s --> real_differentiable_on f t
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable_on f s
    #[2] t ⊆ s
    #[3] real_differentiable_on f t
  ← rewrite_goal real_differentiable_on_def sym=false goal=3
    #[4] ∀x. x ∈ t ⟶ (∃f1. has_real_derivative f f1 (within (atreal x) t))
  → rewrite_fact real_differentiable_on_def sym=false goal=4 facts=[1]
    #[5] ∀x. x ∈ s ⟶ (∃f1. has_real_derivative f f1 (within (atreal x) s))
  ← introduction x goal=4
    #[6] _VAR x
    #[7] x ∈ t
    #[8] ∃f1. has_real_derivative f f1 (within (atreal x) t)
  → forall_elim x goal=8 facts=[5]
    #[9] x ∈ s ⟶ (∃f1. has_real_derivative f f1 (within (atreal x) s))
  → apply_forward_step subsetE goal=8 facts=[2,7]
    #[10] x ∈ s
  → apply_fact goal=8 facts=[9,10]
    #[11] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  exists_elim f1 goal=8 facts=[11]
    #[12] _VAR f1
    #[13] has_real_derivative f f1 (within (atreal x) s)
    #[14] ∃f1. has_real_derivative f f1 (within (atreal x) t)
  ← inst_exists_goal f1 goal=14
    #[15] has_real_derivative f f1 (within (atreal x) t)
  ← apply_backward_step has_real_derivative_within_subset goal=15 facts=[13,2]
    #[16] has_real_derivative f f1 (within (atreal x) t)
qed

theorem real_differentiable_within_subset
  fixes f :: real => real, s :: real set, t :: real set, x :: real
  prop real_differentiable f (within (atreal x) s) --> t Sub s --> real_differentiable f (within (atreal x) t)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f (within (atreal x) s)
    #[2] t ⊆ s
    #[3] real_differentiable f (within (atreal x) t)
  ← rewrite_goal real_differentiable_def sym=false goal=3
    #[4] ∃f1. has_real_derivative f f1 (within (atreal x) t)
  → rewrite_fact real_differentiable_def sym=false goal=4 facts=[1]
    #[5] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  exists_elim f1 goal=4 facts=[5]
    #[6] _VAR f1
    #[7] has_real_derivative f f1 (within (atreal x) s)
    #[8] ∃f1. has_real_derivative f f1 (within (atreal x) t)
    #[9] real_differentiable f (within (atreal x) t)
  ← inst_exists_goal f1 goal=8
    #[10] has_real_derivative f f1 (within (atreal x) t)
  ← apply_backward_step has_real_derivative_within_subset goal=10 facts=[7,2]
    #[11] has_real_derivative f f1 (within (atreal x) t)
qed

theorem has_real_derivative_atreal_within
  fixes f :: real => real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative f f1 (within (atreal x) s)
  [hint_backward,hint_forward]

theorem has_real_derivative_within_real_open
  fixes a :: real, f :: real => real, f1 :: real, s :: real set
  prop a Mem s --> real_open s --> has_real_derivative f f1 (within (atreal a) s) <--> has_real_derivative f f1 (atreal a)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] a ∈ s
    #[2] real_open s
    #[3] has_real_derivative f f1 (within (atreal a) s) ⟷ has_real_derivative f f1 (atreal a)
  ← rewrite_goal has_real_derivative_atreal sym=false goal=3
    #[4] has_real_derivative f f1 (within (atreal a) s) ⟷ tendsto_real (λx. (f x - f a) / (x - a)) f1 (atreal a)
  ← rewrite_goal has_real_derivative_withinreal sym=false goal=4
    #[5] tendsto_real (λx. (f x - f a) / (x - a)) f1 (within (atreal a) s) ⟷ tendsto_real (λx. (f x - f a) / (x - a)) f1 (atreal a)
  ← apply_backward_step reallim_within_real_open goal=5
qed

theorem real_differentiable_atreal_within
  fixes f :: real => real, s :: real set, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable f (within (atreal x) s)
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f (atreal x)
    #[2] real_differentiable f (within (atreal x) s)
  ← rewrite_goal real_differentiable_def sym=false goal=2
    #[3] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=3 facts=[1]
    #[4] ∃f1. has_real_derivative f f1 (atreal x)
  exists_elim f1 goal=3 facts=[4]
    #[5] _VAR f1
    #[6] has_real_derivative f f1 (atreal x)
    #[7] ∃f1. has_real_derivative f f1 (within (atreal x) s)
    #[8] real_differentiable f (within (atreal x) s)
  ← inst_exists_goal f1 goal=7
    #[9] has_real_derivative f f1 (within (atreal x) s)
  ← apply_backward_step has_real_derivative_atreal_within goal=9
qed

theorem has_real_derivative_transform_within
  fixes d :: real, f :: real => real, f1 :: real, g :: real => real, s :: real set, x :: real
  prop 0 < d --> x Mem s --> (!x1. x1 Mem s --> abs (x1 - x) < d --> f x1 = g x1) --> has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative g f1 (within (atreal x) s)
  [hint_backward,hint_backward1]

theorem has_real_derivative_transform_atreal
  fixes d :: real, f :: real => real, f1 :: real, g :: real => real, s :: real set, x :: real
  prop 0 < d --> (!x1. abs (x1 - x) < d --> f x1 = g x1) --> has_real_derivative f f1 (atreal x) --> has_real_derivative g f1 (atreal x)
  [hint_backward,hint_backward1]

theorem has_real_derivative_zero_constant
  fixes f :: real => real, s :: real set
  prop is_realinterval s --> (!x. x Mem s --> has_real_derivative f 0 (within (atreal x) s)) --> (?c. !x. x Mem s --> f x = c)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_derivative_zero_unique
  fixes a :: real, c :: real, f :: real => real, s :: real set
  prop is_realinterval s --> a Mem s --> f a = c --> (!x. x Mem s --> has_real_derivative f 0 (within (atreal x) s)) --> (!x. x Mem s --> f x = c)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] is_realinterval s
    #[2] a ∈ s
    #[3] f a = c
    #[4] ∀x. x ∈ s ⟶ has_real_derivative f 0 (within (atreal x) s)
    #[5] ∀x. x ∈ s ⟶ f x = c
  → apply_forward_step has_real_derivative_zero_constant goal=5 facts=[1,4]
    #[6] ∃c. ∀x. x ∈ s ⟶ f x = c
  ← z3 goal=5 facts=[6,2,3]
qed

theorem real_diff_chain_within
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative g g1 (within (atreal (f x)) (image f s)) --> has_real_derivative (%x1. g (f x1)) (g1 * f1) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]

theorem real_diff_chain_atreal
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative g g1 (atreal (f x)) --> has_real_derivative (%x1. g (f x1)) (g1 * f1) (atreal x)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] has_real_derivative g g1 (atreal (f x))
    #[3] has_real_derivative (λx1. g (f x1)) (g1 * f1) (atreal x)
  ← rewrite_goal withinreal_univ sym=true goal=3
    #[4] has_real_derivative (λx1. g (f x1)) (g1 * f1) (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=4 facts=[2]
    #[5] has_real_derivative g g1 (within (atreal (f x)) univ)
  → rewrite_fact withinreal_univ sym=true goal=4 facts=[1]
    #[6] has_real_derivative f f1 (within (atreal x) univ)
  ← apply_backward_step real_diff_chain_within goal=4
    #[7] has_real_derivative g g1 (within (atreal (f x)) (image f univ))
  ← apply_backward_step has_real_derivative_within_subset param_s="(univ::real set)" goal=7
    #[8] image f univ ⊆ univ
  ← apply_backward_step subset_univ goal=8
    #[9] image f univ ⊆ univ
qed

theorem has_real_derivative_chain
  fixes P :: real => bool, f :: real => real, f1 :: real, g :: real => real, g1 :: real => real
  prop (!x. P x --> has_real_derivative g (g1 x) (atreal x)) --> (!x. !s. has_real_derivative f f1 (within (atreal x) s) --> P (f x) --> has_real_derivative (%x1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)) & (!x. has_real_derivative f f1 (atreal x) --> P (f x) --> has_real_derivative (%x1. g (f x1)) (f1 * g1 (f x)) (atreal x))
  [hint_backward,hint_forward]

theorem has_real_derivative_chain_univ
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real => real
  prop (!x. has_real_derivative g (g1 x) (atreal x)) --> (!x. !s. has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative (%x1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)) & (!x. has_real_derivative f f1 (atreal x) --> has_real_derivative (%x1. g (f x1)) (f1 * g1 (f x)) (atreal x))
proof
  ← introduction goal=0
    #[1] ∀x. has_real_derivative g (g1 x) (atreal x)
    #[2] (∀x. ∀s. has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)) ∧ (∀x. has_real_derivative f f1 (atreal x) ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x))
  → apply_forward_step has_real_derivative_chain param_P="(%x::real. true)" param_f=f param_f1=f1 param_g=g param_g1=g1 goal=2
    #[3] (∀x. true ⟶ has_real_derivative g (g1 x) (atreal x)) ⟶ (∀x. ∀s. has_real_derivative f f1 (within (atreal x) s) ⟶ true ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)) ∧ (∀x. has_real_derivative f f1 (atreal x) ⟶ true ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x))
  cut "(∀x. has_real_derivative g (g1 x) (atreal x)) <--> (∀x. true ⟶ has_real_derivative g (g1 x) (atreal x))" goal=2 facts=[1]
    #[4] (∀x. has_real_derivative g (g1 x) (atreal x)) ⟷ (∀x. true ⟶ has_real_derivative g (g1 x) (atreal x))
  ← apply_backward_step iffI goal=4
    #[5] (∀x. has_real_derivative g (g1 x) (atreal x)) ⟶ (∀x. true ⟶ has_real_derivative g (g1 x) (atreal x))
    #[6] (∀x. true ⟶ has_real_derivative g (g1 x) (atreal x)) ⟶ (∀x. has_real_derivative g (g1 x) (atreal x))
  ← introduction goal=5
    #[7] ∀x. true ⟶ has_real_derivative g (g1 x) (atreal x)
  ← introduction x goal=7
    #[8] _VAR x
    #[9] true
    #[10] has_real_derivative g (g1 x) (atreal x)
  ← apply_prev goal=10 facts=[1]
    #[11] has_real_derivative g (g1 x) (atreal x)
  ← introduction goal=6
    #[12] ∀x. true ⟶ has_real_derivative g (g1 x) (atreal x)
  → rewrite_fact eq_sym_eq sym=false goal=2 facts=[4]
    #[13] (∀x. true ⟶ has_real_derivative g (g1 x) (atreal x)) ⟷ (∀x. has_real_derivative g (g1 x) (atreal x))
  → rewrite_fact_with_prev goal=2 facts=[13,3]
    #[14] (∀x. has_real_derivative g (g1 x) (atreal x)) ⟶ (∀x. ∀s. has_real_derivative f f1 (within (atreal x) s) ⟶ true ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)) ∧ (∀x. has_real_derivative f f1 (atreal x) ⟶ true ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x))
  → apply_fact goal=2 facts=[14,1]
    #[15] (∀x. ∀s. has_real_derivative f f1 (within (atreal x) s) ⟶ true ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)) ∧ (∀x. has_real_derivative f f1 (atreal x) ⟶ true ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x))
  ← apply_backward_step conjI goal=2
    #[16] ∀x. ∀s. has_real_derivative f f1 (within (atreal x) s) ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)
    #[17] ∀x. has_real_derivative f f1 (atreal x) ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x)
  → apply_forward_step conjD1 goal=16 facts=[15]
    #[18] ∀x. ∀s. has_real_derivative f f1 (within (atreal x) s) ⟶ true ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)
  → apply_forward_step conjD2 goal=16 facts=[15]
    #[19] ∀x. has_real_derivative f f1 (atreal x) ⟶ true ⟶ has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x)
  ← introduction x,s goal=16
    #[20] _VAR s
    #[21] has_real_derivative f f1 (within (atreal x) s)
    #[22] has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (within (atreal x) s)
  ← apply_prev goal=22 facts=[18]
    #[23] true
  ← apply_backward_step trueI goal=23
    #[24] true
  ← introduction x goal=17
    #[25] has_real_derivative f f1 (atreal x)
    #[26] has_real_derivative (λx1. g (f x1)) (f1 * g1 (f x)) (atreal x)
  ← apply_prev goal=26 facts=[19]
    #[27] true
  ← apply_backward_step trueI goal=27
qed

theorem real_derivative_unique_atreal
  fixes f :: real => real, f1 :: real, f2 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative f f2 (atreal x) --> f1 = f2
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_derivative_derivative
  fixes f :: real => real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> real_derivative f x = f1
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] real_derivative f x = f1
  ← rewrite_goal real_derivative_def sym=false goal=2
    #[3] (THE f11. has_real_derivative f f11 (atreal x)) = f1
  → apply_forward_step theI param_P="(%f11. has_real_derivative f f11 (atreal x))" param_a=f1 goal=3
    #[4] has_real_derivative f f1 (atreal x) ⟶ (∀x1. has_real_derivative f x1 (atreal x) ⟶ x1 = f1) ⟶ has_real_derivative f (THE x1. has_real_derivative f x1 (atreal x)) (atreal x)
  → apply_fact goal=3 facts=[4,1]
    #[5] (∀x1. has_real_derivative f x1 (atreal x) ⟶ x1 = f1) ⟶ has_real_derivative f (THE x1. has_real_derivative f x1 (atreal x)) (atreal x)
  cut "(∀x1. has_real_derivative f x1 (atreal x) ⟶ x1 = f1)" goal=3
    #[6] ∀x1. has_real_derivative f x1 (atreal x) ⟶ x1 = f1
  ← introduction g goal=6
    #[7] _VAR g
    #[8] has_real_derivative f g (atreal x)
    #[9] g = f1
  ← apply_backward_step real_derivative_unique_atreal goal=9 facts=[8,1]
  ← apply_prev goal=3 facts=[6]
    #[10] has_real_derivative f (THE f1. has_real_derivative f f1 (atreal x)) (atreal x)
  ← apply_prev goal=10 facts=[5]
qed

theorem has_real_derivative_differentiable
  fixes f :: real => real, x :: real
  prop has_real_derivative f (real_derivative f x) (atreal x) <--> real_differentiable f (atreal x)
proof
  ← apply_backward_step iffI goal=0
    #[1] has_real_derivative f (real_derivative f x) (atreal x) ⟶ real_differentiable f (atreal x)
    #[2] real_differentiable f (atreal x) ⟶ has_real_derivative f (real_derivative f x) (atreal x)
  ← introduction goal=1
    #[3] has_real_derivative f (real_derivative f x) (atreal x)
    #[4] real_differentiable f (atreal x)
  ← rewrite_goal real_differentiable_def sym=false goal=4
    #[5] ∃f1. has_real_derivative f f1 (atreal x)
  ← apply_backward_step exI goal=5 facts=[3]
  ← introduction goal=2
    #[6] real_differentiable f (atreal x)
    #[7] has_real_derivative f (real_derivative f x) (atreal x)
  → rewrite_fact real_differentiable_def sym=false goal=7 facts=[6]
    #[8] ∃f1. has_real_derivative f f1 (atreal x)
  exists_elim f1 goal=7 facts=[8]
    #[9] _VAR f1
    #[10] has_real_derivative f f1 (atreal x)
    #[11] has_real_derivative f (real_derivative f x) (atreal x)
  → apply_forward_step has_real_derivative_derivative goal=11 facts=[10]
    #[12] real_derivative f x = f1
  ← rewrite_goal_with_prev goal=11 facts=[12]
qed

theorem has_real_derivative_lmul_within
  fixes c :: real, f :: real => real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative (%x1. c * f x1) (c * f1) (within (atreal x) s)
  [hint_backward]

theorem has_real_derivative_rmul_within
  fixes c :: real, f :: real => real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative (%x1. f x1 * c) (f1 * c) (within (atreal x) s)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (within (atreal x) s)
    #[2] has_real_derivative (λx1. f x1 * c) (f1 * c) (within (atreal x) s)
  ← rewrite_goal real_mult_comm sym=false goal=2
    #[3] has_real_derivative (λx1. c * f x1) (c * f1) (within (atreal x) s)
  ← apply_backward_step has_real_derivative_lmul_within goal=3
qed

theorem has_real_derivative_lmul_atreal
  fixes c :: real, f :: real => real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative (%x1. c * f x1) (c * f1) (atreal x)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] has_real_derivative (λx1. c * f x1) (c * f1) (atreal x)
  ← rewrite_goal withinreal_univ sym=true goal=2
    #[3] has_real_derivative (λx1. c * f x1) (c * f1) (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=3 facts=[1]
    #[4] has_real_derivative f f1 (within (atreal x) univ)
  ← apply_backward_step has_real_derivative_lmul_within goal=3
qed

theorem has_real_derivative_rmul_atreal
  fixes c :: real, f :: real => real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative (%x1. f x1 * c) (f1 * c) (atreal x)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] has_real_derivative (λx1. f x1 * c) (f1 * c) (atreal x)
  ← rewrite_goal real_mult_comm sym=false goal=2
    #[3] has_real_derivative (λx1. c * f x1) (c * f1) (atreal x)
  ← apply_backward_step has_real_derivative_lmul_atreal goal=3
qed

theorem has_real_derivative_cdiv_within
  fixes c :: real, f :: real => real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative (%x1. f x1 / c) (f1 / c) (within (atreal x) s)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (within (atreal x) s)
    #[2] has_real_derivative (λx1. f x1 / c) (f1 / c) (within (atreal x) s)
  ← rewrite_goal real_divide_def sym=false goal=2
    #[3] has_real_derivative (λx1. f x1 * real_inverse c) (f1 * real_inverse c) (within (atreal x) s)
  ← apply_backward_step has_real_derivative_rmul_within goal=3
qed

theorem has_real_derivative_cdiv_atreal
  fixes c :: real, f :: real => real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative (%x1. f x1 / c) (f1 / c) (atreal x)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] has_real_derivative (λx1. f x1 / c) (f1 / c) (atreal x)
  ← rewrite_goal real_divide_def sym=false goal=2
    #[3] has_real_derivative (λx1. f x1 * real_inverse c) (f1 * real_inverse c) (atreal x)
  ← apply_backward_step has_real_derivative_rmul_atreal goal=3
qed

theorem has_real_derivative_id
  fixes net :: real net
  prop has_real_derivative (%x. x) 1 net
  [hint_backward]
proof
  ← rewrite_goal has_real_derivative_def sym=false goal=0
    #[1] tendsto_real (λx. real_inverse (x - netlimit net) * (x - (netlimit net + 1 * (x - netlimit net)))) 0 net
  ← rewrite_goal real_mul_lid sym=false goal=1
    #[2] tendsto_real (λx. real_inverse (x - netlimit net) * (x - (netlimit net + (x - netlimit net)))) 0 net
  cut "!x::real. !a. x-(a+(x-a))=0" goal=2
    #[3] ∀x::real. ∀a. x - (a + (x - a)) = 0
  ← z3 goal=3
  ← rewrite_goal_with_prev goal=2 facts=[3]
    #[4] tendsto_real (λx. real_inverse (x - netlimit net) * 0) 0 net
  ← rewrite_goal real_mul_rzero sym=false goal=4
    #[5] tendsto_real (λx. 0) 0 net
  ← apply_backward_step reallim_const goal=5
qed

theorem real_derivative_id
  fixes x :: real
  prop real_derivative (%x1. x1) x = 1
  [hint_rewrite]
proof
  ← apply_backward_step has_real_derivative_derivative goal=0
    #[1] has_real_derivative (λx1. x1) 1 (atreal x)
  ← apply_backward_step has_real_derivative_id goal=1
qed

theorem has_real_derivative_const
  fixes c :: real, net :: real net
  prop has_real_derivative (%x. c) 0 net
  [hint_backward]
proof
  ← rewrite_goal has_real_derivative_def sym=false goal=0
    #[1] tendsto_real (λx. real_inverse (x - netlimit net) * (c - (c + 0 * (x - netlimit net)))) 0 net
  ← rewrite_goal real_mul_lzero sym=false goal=1
    #[2] tendsto_real (λx. real_inverse (x - netlimit net) * (c - (c + 0))) 0 net
  ← rewrite_goal real_add_rid sym=false goal=2
    #[3] tendsto_real (λx. real_inverse (x - netlimit net) * (c - c)) 0 net
  ← rewrite_goal real_minus_def sym=false goal=3
    #[4] tendsto_real (λx. real_inverse (x + -(netlimit net)) * (c + -c)) 0 net
  ← rewrite_goal real_add_rinv sym=false goal=4
    #[5] tendsto_real (λx. real_inverse (x + -(netlimit net)) * 0) 0 net
  ← rewrite_goal real_mul_rzero sym=false goal=5
    #[6] tendsto_real (λx. 0) 0 net
  ← apply_backward_step reallim_const goal=6
qed

theorem real_derivative_const
  fixes c :: real, x :: real
  prop real_derivative (%x1. c) x = 0
  [hint_rewrite]
proof
  ← apply_backward_step has_real_derivative_derivative goal=0
    #[1] has_real_derivative (λx1. c) 0 (atreal x)
  ← apply_backward_step has_real_derivative_const goal=1
qed

theorem has_real_derivative_neg
  fixes f :: real => real, f1 :: real, net :: real net
  prop has_real_derivative f f1 net --> has_real_derivative (%x. -(f x)) (-f1) net
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 net
    #[2] has_real_derivative (λx. -(f x)) (-f1) net
  ← rewrite_goal has_real_derivative_def sym=false goal=2
    #[3] tendsto_real (λx. real_inverse (x - netlimit net) * (-(f x) - (-(f (netlimit net)) + -f1 * (x - netlimit net)))) 0 net
  → rewrite_fact has_real_derivative_def sym=false goal=3 facts=[1]
    #[4] tendsto_real (λx. real_inverse (x - netlimit net) * (f x - (f (netlimit net) + f1 * (x - netlimit net)))) 0 net
  → rewrite_fact reallim_neg_eq sym=true goal=3 facts=[4]
    #[5] tendsto_real (λx. -(real_inverse (x - netlimit net) * (f x - (f (netlimit net) + f1 * (x - netlimit net))))) (-0) net
  cut "!a::real. !b. !c. !d. !e. a * (-b - (-c + -d * e)) = -(a * (b - (c + d * e)))" goal=3
    #[6] ∀a::real. ∀b. ∀c. ∀d. ∀e. a * (-b - (-c + -d * e)) = -(a * (b - (c + d * e)))
  ← z3 goal=6
    #[7] ∀a::real. ∀b. ∀c. ∀d. ∀e. a * (-b - (-c + -d * e)) = -(a * (b - (c + d * e)))
  ← rewrite_goal_with_prev goal=3 facts=[7]
    #[8] tendsto_real (λx. -(real_inverse (x - netlimit net) * (f x - (f (netlimit net) + f1 * (x - netlimit net))))) 0 net
  → rewrite_fact real_neg_0 sym=false goal=8 facts=[5]
qed

theorem real_derivative_neg
  fixes f :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_derivative (%x1. -(f x1)) x = -(real_derivative f x)

theorem real_derivative_uminus
  fixes x :: real
  prop real_derivative uminus x = -1

theorem has_real_derivative_add
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real, net :: real net
  prop has_real_derivative f f1 net --> has_real_derivative g g1 net --> has_real_derivative (%x. f x + g x) (f1 + g1) net
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 net
    #[2] has_real_derivative g g1 net
    #[3] has_real_derivative (λx. f x + g x) (f1 + g1) net
  ← rewrite_goal has_real_derivative_def sym=false goal=3
    #[4] tendsto_real (λx. real_inverse (x - netlimit net) * (f x + g x - (f (netlimit net) + g (netlimit net) + (f1 + g1) * (x - netlimit net)))) 0 net
  → rewrite_fact has_real_derivative_def sym=false goal=4 facts=[1]
    #[5] tendsto_real (λx. real_inverse (x - netlimit net) * (f x - (f (netlimit net) + f1 * (x - netlimit net)))) 0 net
  → rewrite_fact has_real_derivative_def sym=false goal=4 facts=[2]
    #[6] tendsto_real (λx. real_inverse (x - netlimit net) * (g x - (g (netlimit net) + g1 * (x - netlimit net)))) 0 net
  → apply_forward_step reallim_add goal=4 facts=[5,6]
    #[7] tendsto_real (λx. real_inverse (x - netlimit net) * (f x - (f (netlimit net) + f1 * (x - netlimit net))) + real_inverse (x - netlimit net) * (g x - (g (netlimit net) + g1 * (x - netlimit net)))) (0 + 0) net
  cut "!a::real. !b. !c. !d. !e. !f. !g. !h. (a-(b+c*(d-e)))+(f-(g+h*(d-e)))=(a+f)-((b+g)+(c +h) *(d-e))" goal=4
    #[8] ∀a::real. ∀b. ∀c. ∀d. ∀e. ∀f. ∀g. ∀h. a - (b + c * (d - e)) + (f - (g + h * (d - e))) = a + f - (b + g + (c + h) * (d - e))
  ← z3 goal=8
    #[9] ∀a::real. ∀b. ∀c. ∀d. ∀e. ∀f. ∀g. ∀h. a - (b + c * (d - e)) + (f - (g + h * (d - e))) = a + f - (b + g + (c + h) * (d - e))
  → rewrite_fact real_add_ldistrib sym=true goal=4 facts=[7]
    #[10] tendsto_real (λx. real_inverse (x - netlimit net) * (f x - (f (netlimit net) + f1 * (x - netlimit net)) + (g x - (g (netlimit net) + g1 * (x - netlimit net))))) (0 + 0) net
  → rewrite_fact_with_prev goal=4 facts=[9,10]
    #[11] tendsto_real (λx. real_inverse (x - netlimit net) * (f x + g x - (f (netlimit net) + g (netlimit net) + (f1 + g1) * (x - netlimit net)))) (0 + 0) net
  → rewrite_fact real_add_lid sym=false goal=4 facts=[11]
qed

theorem real_derivative_add
  fixes f :: real => real, g :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable g (atreal x) --> real_derivative (%x1. f x1 + g x1) x = real_derivative f x + real_derivative g x

theorem has_real_derivative_sub
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real, net :: real net
  prop has_real_derivative f f1 net --> has_real_derivative g g1 net --> has_real_derivative (%x. f x - g x) (f1 - g1) net
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 net
    #[2] has_real_derivative g g1 net
    #[3] has_real_derivative (λx. f x - g x) (f1 - g1) net
  ← rewrite_goal real_minus_def sym=false goal=3
    #[4] has_real_derivative (λx. f x + -(g x)) (f1 + -g1) net
  ← apply_backward_step has_real_derivative_add goal=4
    #[5] has_real_derivative (λx. -(g x)) (-g1) net
  ← apply_backward_step has_real_derivative_neg goal=5
qed

theorem real_derivative_sub
  fixes f :: real => real, g :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable g (atreal x) --> real_derivative (%x1. f x1 - g x1) x = real_derivative f x - real_derivative g x

theorem has_real_derivative_mul_within
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative g g1 (within (atreal x) s) --> has_real_derivative (%x1. f x1 * g x1) (f x * g1 + f1 * g x) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_derivative_mul_atreal
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative g g1 (atreal x) --> has_real_derivative (%x1. f x1 * g x1) (f x * g1 + f1 * g x) (atreal x)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] has_real_derivative g g1 (atreal x)
    #[3] has_real_derivative (λx1. f x1 * g x1) (f x * g1 + f1 * g x) (atreal x)
  ← rewrite_goal withinreal_univ sym=true goal=3
    #[4] has_real_derivative (λx1. f x1 * g x1) (f x * g1 + f1 * g x) (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=4 facts=[1]
    #[5] has_real_derivative f f1 (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=4 facts=[2]
    #[6] has_real_derivative g g1 (within (atreal x) univ)
  ← apply_backward_step has_real_derivative_mul_within goal=4 facts=[5,6]
qed

theorem real_derivative_mul
  fixes f :: real => real, g :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable g (atreal x) --> real_derivative (%x1. f x1 * g x1) x = f x * real_derivative g x + real_derivative f x * g x

theorem has_real_derivative_pow_within
  fixes f :: real => real, f1 :: real, n :: nat, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative (%x1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (within (atreal x) s)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (within (atreal x) s)
    #[2] has_real_derivative (λx1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (within (atreal x) s)
  ← induction n nat_induct goal=2
    #[3] has_real_derivative (λx1. f x1 ^ (0::nat)) (of_nat 0 * f x ^ ((0::nat) - 1) * f1) (within (atreal x) s)
    #[4] ∀n. has_real_derivative (λx1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (within (atreal x) s) ⟶ has_real_derivative (λx1. f x1 ^ Suc n) (of_nat (Suc n) * f x ^ (Suc n - 1) * f1) (within (atreal x) s)
  ← rewrite_goal real_zero_def sym=true goal=3
    #[5] has_real_derivative (λx1. f x1 ^ (0::nat)) (0 * f x ^ ((0::nat) - 1) * f1) (within (atreal x) s)
  ← rewrite_goal real_mul_lzero sym=false goal=5
    #[6] has_real_derivative (λx1. f x1 ^ (0::nat)) (0 * f1) (within (atreal x) s)
  ← rewrite_goal real_mul_lzero sym=false goal=6
    #[7] has_real_derivative (λx1. f x1 ^ (0::nat)) 0 (within (atreal x) s)
  ← rewrite_goal real_nat_power_def_1 sym=false goal=7
    #[8] has_real_derivative (λx1. 1) 0 (within (atreal x) s)
  ← apply_backward_step has_real_derivative_const goal=8
    #[9] has_real_derivative (λx1. 1) 0 (within (atreal x) s)
  ← introduction n goal=4
    #[10] _VAR n
    #[11] has_real_derivative (λx1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (within (atreal x) s)
    #[12] has_real_derivative (λx1. f x1 ^ Suc n) (of_nat (Suc n) * f x ^ (Suc n - 1) * f1) (within (atreal x) s)
  ← rewrite_goal real_nat_power_def_2 sym=false goal=12
    #[13] has_real_derivative (λx1. f x1 * f x1 ^ n) (of_nat (Suc n) * f x ^ (Suc n - 1) * f1) (within (atreal x) s)
  → apply_forward_step has_real_derivative_mul_within goal=13 facts=[1,11]
    #[14] has_real_derivative (λx1. f x1 * f x1 ^ n) (f x * (of_nat n * f x ^ (n - 1) * f1) + f1 * f x ^ n) (within (atreal x) s)
  ← rewrite_goal suc_sub1 sym=false goal=13
    #[15] has_real_derivative (λx1. f x1 * f x1 ^ n) (of_nat (Suc n) * f x ^ n * f1) (within (atreal x) s)
  cut "!a::real. !b. !c. !d. a * (b * c *d) = b * (a * c) * d" goal=15
    #[16] ∀a::real. ∀b. ∀c. ∀d. a * (b * c * d) = b * (a * c) * d
  ← z3 goal=16
    #[17] ∀a::real. ∀b. ∀c. ∀d. a * (b * c * d) = b * (a * c) * d
  → rewrite_fact_with_prev goal=15 facts=[17,14]
    #[18] has_real_derivative (λx1. f x1 * f x1 ^ n) (of_nat n * (f x * f x ^ (n - 1)) * f1 + f1 * f x ^ n) (within (atreal x) s)
  → rewrite_fact real_nat_power_def_2 sym=true goal=15 facts=[18]
    #[19] has_real_derivative (λx1. f x1 ^ Suc n) (of_nat n * f x ^ Suc (n - 1) * f1 + f1 * f x ^ n) (within (atreal x) s)
  ← cases "n=0" goal=15
    #[20] n = 0 ⟶ has_real_derivative (λx1. f x1 * f x1 ^ n) (of_nat (Suc n) * f x ^ n * f1) (within (atreal x) s)
    #[21] ¬(n = 0) ⟶ has_real_derivative (λx1. f x1 * f x1 ^ n) (of_nat (Suc n) * f x ^ n * f1) (within (atreal x) s)
  ← introduction goal=20
    #[22] n = 0
    #[23] has_real_derivative (λx1. f x1 * f x1 ^ n) (of_nat (Suc n) * f x ^ n * f1) (within (atreal x) s)
  ← rewrite_goal_with_prev goal=23 facts=[22]
    #[24] has_real_derivative (λx1. f x1 * f x1 ^ (0::nat)) (of_nat (Suc 0) * f x ^ (0::nat) * f1) (within (atreal x) s)
  ← rewrite_goal real_nat_power_def_1 sym=false goal=24
    #[25] has_real_derivative (λx1. f x1 * 1) (of_nat (Suc 0) * 1 * f1) (within (atreal x) s)
  ← rewrite_goal nat_one_def sym=true goal=25
    #[26] has_real_derivative (λx1. f x1 * 1) (of_nat 1 * 1 * f1) (within (atreal x) s)
  ← rewrite_goal real_one_def sym=true goal=26
    #[27] has_real_derivative (λx1. f x1 * 1) (1 * 1 * f1) (within (atreal x) s)
  ← rewrite_goal real_mul_lid sym=false goal=27
    #[28] has_real_derivative (λx1. f x1 * 1) (1 * f1) (within (atreal x) s)
  ← rewrite_goal real_mul_lid sym=false goal=28
    #[29] has_real_derivative (λx1. f x1 * 1) f1 (within (atreal x) s)
  ← rewrite_goal real_mult_comm sym=false goal=29
    #[30] has_real_derivative (λx1. 1 * f x1) f1 (within (atreal x) s)
  ← rewrite_goal real_mul_lid sym=false goal=30
    #[31] has_real_derivative (λx1. f x1) f1 (within (atreal x) s)
  ← rewrite_goal eta_conversion sym=false goal=31
  ← introduction goal=21
    #[32] ¬(n = 0)
    #[33] has_real_derivative (λx1. f x1 * f x1 ^ n) (of_nat (Suc n) * f x ^ n * f1) (within (atreal x) s)
  cut "Suc (n-1) = n" goal=33
    #[34] Suc (n - 1) = n
  ← rewrite_goal add_1_right sym=true goal=34
    #[35] n - 1 + 1 = n
  ← apply_backward_step sub_add goal=35
    #[36] 1 ≤ n
  ← apply_backward_step le_1_2 goal=36
  → rewrite_fact_with_prev goal=33 facts=[34,19]
    #[37] has_real_derivative (λx1. f x1 ^ Suc n) (of_nat n * f x ^ n * f1 + f1 * f x ^ n) (within (atreal x) s)
  cut "!a::real. !b. !c. a * b * c + c * b = (a +1) * b * c" goal=33
    #[38] ∀a::real. ∀b. ∀c. a * b * c + c * b = (a + 1) * b * c
  ← z3 goal=38
    #[39] ∀a::real. ∀b. ∀c. a * b * c + c * b = (a + 1) * b * c
  → rewrite_fact_with_prev goal=33 facts=[39,37]
    #[40] has_real_derivative (λx1. f x1 ^ Suc n) ((of_nat n + 1) * f x ^ n * f1) (within (atreal x) s)
  → rewrite_fact real_one_def sym=false goal=33 facts=[40]
    #[41] has_real_derivative (λx1. f x1 ^ Suc n) ((of_nat n + of_nat 1) * f x ^ n * f1) (within (atreal x) s)
  ← rewrite_goal add_1_right sym=true goal=33
    #[42] has_real_derivative (λx1. f x1 * f x1 ^ n) (of_nat (n + 1) * f x ^ n * f1) (within (atreal x) s)
  → rewrite_fact real_of_nat_add sym=false goal=42 facts=[41]
    #[43] has_real_derivative (λx1. f x1 ^ Suc n) (of_nat (n + 1) * f x ^ n * f1) (within (atreal x) s)
  → rewrite_fact real_nat_power_def_2 sym=false goal=42 facts=[43]
qed

theorem has_real_derivative_pow_atreal
  fixes f :: real => real, f1 :: real, n :: nat, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative (%x1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (atreal x)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] has_real_derivative (λx1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (atreal x)
  ← rewrite_goal withinreal_univ sym=true goal=2
    #[3] has_real_derivative (λx1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=3 facts=[1]
    #[4] has_real_derivative f f1 (within (atreal x) univ)
  ← apply_backward_step has_real_derivative_pow_within goal=3
qed

theorem real_derivative_pow
  fixes f :: real => real, n :: nat, x :: real
  prop real_differentiable f (atreal x) --> real_derivative (%x1. f x1 ^ n) x = of_nat n * f x ^ (n - 1) * real_derivative f x

theorem has_real_derivative_inv_basic
  fixes x :: real
  prop ~(x = 0) --> has_real_derivative real_inverse (-(real_inverse (x ^ (2::nat)))) (atreal x)
  [hint_backward]

theorem has_real_derivative_inv_within
  fixes f :: real => real, f1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> ~(f x = 0) --> has_real_derivative (%x1. real_inverse (f x1)) (-f1 / f x ^ (2::nat)) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (within (atreal x) s)
    #[2] ¬(f x = 0)
    #[3] has_real_derivative (λx1. real_inverse (f x1)) (-f1 / f x ^ (2::nat)) (within (atreal x) s)
  ← rewrite_goal real_divide_def sym=false goal=3
    #[4] has_real_derivative (λx1. real_inverse (f x1)) (-f1 * real_inverse (f x ^ (2::nat))) (within (atreal x) s)
  ← rewrite_goal real_mult_comm sym=false goal=4
    #[5] has_real_derivative (λx1. real_inverse (f x1)) (real_inverse (f x ^ (2::nat)) * -f1) (within (atreal x) s)
  ← rewrite_goal real_mul_rneg sym=false goal=5
    #[6] has_real_derivative (λx1. real_inverse (f x1)) (-(real_inverse (f x ^ (2::nat)) * f1)) (within (atreal x) s)
  ← rewrite_goal real_mul_lneg sym=true goal=6
    #[7] has_real_derivative (λx1. real_inverse (f x1)) (-(real_inverse (f x ^ (2::nat))) * f1) (within (atreal x) s)
  ← apply_backward_step real_diff_chain_within goal=7
    #[8] has_real_derivative real_inverse (-(real_inverse (f x ^ (2::nat)))) (within (atreal (f x)) (image f s))
  ← apply_backward_step has_real_derivative_atreal_within goal=8
    #[9] has_real_derivative real_inverse (-(real_inverse (f x ^ (2::nat)))) (atreal (f x))
  ← apply_backward_step has_real_derivative_inv_basic goal=9
qed

theorem has_real_derivative_inv_atreal
  fixes f :: real => real, f1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> ~(f x = 0) --> has_real_derivative (%x1. real_inverse (f x1)) (-f1 / f x ^ (2::nat)) (atreal x)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] ¬(f x = 0)
    #[3] has_real_derivative (λx1. real_inverse (f x1)) (-f1 / f x ^ (2::nat)) (atreal x)
  ← rewrite_goal withinreal_univ sym=true goal=3
    #[4] has_real_derivative (λx1. real_inverse (f x1)) (-f1 / f x ^ (2::nat)) (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=4 facts=[1]
    #[5] has_real_derivative f f1 (within (atreal x) univ)
  ← apply_backward_step has_real_derivative_inv_within goal=4
qed

theorem has_real_derivative_div_within
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real, s :: real set, x :: real
  prop has_real_derivative f f1 (within (atreal x) s) --> has_real_derivative g g1 (within (atreal x) s) --> ~(g x = 0) --> has_real_derivative (%x1. f x1 / g x1) ((f1 * g x - f x * g1) / g x ^ (2::nat)) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (within (atreal x) s)
    #[2] has_real_derivative g g1 (within (atreal x) s)
    #[3] ¬(g x = 0)
    #[4] has_real_derivative (λx1. f x1 / g x1) ((f1 * g x - f x * g1) / g x ^ (2::nat)) (within (atreal x) s)
  → apply_forward_step has_real_derivative_inv_within goal=4 facts=[2,3]
    #[5] has_real_derivative (λx1. real_inverse (g x1)) (-g1 / g x ^ (2::nat)) (within (atreal x) s)
  → apply_forward_step has_real_derivative_mul_within goal=4 facts=[1,5]
    #[6] has_real_derivative (λx1. f x1 * real_inverse (g x1)) (f x * (-g1 / g x ^ (2::nat)) + f1 * real_inverse (g x)) (within (atreal x) s)
  ← rewrite_goal real_divide_def sym=false goal=4
    #[7] has_real_derivative (λx1. f x1 * real_inverse (g x1)) ((f1 * g x - f x * g1) * real_inverse (g x ^ (2::nat))) (within (atreal x) s)
  → rewrite_fact real_divide_def sym=false goal=7 facts=[6]
    #[8] has_real_derivative (λx1. f x1 * real_inverse (g x1)) (f x * (-g1 * real_inverse (g x ^ (2::nat))) + f1 * real_inverse (g x)) (within (atreal x) s)
  ← rewrite_goal real_pow_2 sym=false goal=7
    #[9] has_real_derivative (λx1. f x1 * real_inverse (g x1)) ((f1 * g x - f x * g1) * real_inverse (g x * g x)) (within (atreal x) s)
  → rewrite_fact real_pow_2 sym=false goal=9 facts=[8]
    #[10] has_real_derivative (λx1. f x1 * real_inverse (g x1)) (f x * (-g1 * real_inverse (g x * g x)) + f1 * real_inverse (g x)) (within (atreal x) s)
  cut "(f x * (-g1 * real_inverse (g x * g x)) + f1 * real_inverse (g x)) = ((f1 * g x - f x * g1) * real_inverse (g x * g x))" goal=9 facts=[10]
    #[11] f x * (-g1 * real_inverse (g x * g x)) + f1 * real_inverse (g x) = (f1 * g x - f x * g1) * real_inverse (g x * g x)
  ← z3 goal=11 facts=[3]
    #[12] f x * (-g1 * real_inverse (g x * g x)) + f1 * real_inverse (g x) = (f1 * g x - f x * g1) * real_inverse (g x * g x)
  → rewrite_fact_with_prev goal=9 facts=[12,10]
qed

theorem has_real_derivative_div_atreal
  fixes f :: real => real, f1 :: real, g :: real => real, g1 :: real, x :: real
  prop has_real_derivative f f1 (atreal x) --> has_real_derivative g g1 (atreal x) --> ~(g x = 0) --> has_real_derivative (%x1. f x1 / g x1) ((f1 * g x - f x * g1) / g x ^ (2::nat)) (atreal x)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_derivative f f1 (atreal x)
    #[2] has_real_derivative g g1 (atreal x)
    #[3] ¬(g x = 0)
    #[4] has_real_derivative (λx1. f x1 / g x1) ((f1 * g x - f x * g1) / g x ^ (2::nat)) (atreal x)
  ← rewrite_goal withinreal_univ sym=true goal=4
    #[5] has_real_derivative (λx1. f x1 / g x1) ((f1 * g x - f x * g1) / g x ^ (2::nat)) (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=5 facts=[1]
    #[6] has_real_derivative f f1 (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=5 facts=[2]
    #[7] has_real_derivative g g1 (within (atreal x) univ)
  ← apply_backward_step has_real_derivative_div_within goal=5
qed

theorem real_derivative_div_atreal
  fixes f :: real => real, g :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable g (atreal x) --> ~(g x = 0) --> real_derivative (%x1. f x1 / g x1) x = (real_derivative f x * g x - f x * real_derivative g x) / g x ^ (2::nat)

theorem has_real_derivative_sum
  fixes f :: 'a => real => real, f1 :: 'a => real, net :: real net, s :: 'a set
  prop finite s --> (!a. a Mem s --> has_real_derivative (f a) (f1 a) net) --> has_real_derivative (%x. sum s (%a. f a x)) (sum s f1) net
  [hint_backward,hint_backward1,hint_forward]

theorem real_differentiable_const
  fixes c :: real, net :: real net
  prop real_differentiable (%x. c) net
  [hint_backward]
proof
  ← rewrite_goal real_differentiable_def sym=false goal=0
    #[1] ∃f1. has_real_derivative (λx. c) f1 net
  ← inst_exists_goal "(0::real)" goal=1
    #[2] has_real_derivative (λx. c) 0 net
  ← apply_backward_step has_real_derivative_const goal=2
qed

theorem real_differentiable_id
  fixes net :: real net
  prop real_differentiable (%x. x) net
  [hint_backward]
proof
  ← rewrite_goal real_differentiable_def sym=false goal=0
    #[1] ∃f1. has_real_derivative (λx. x) f1 net
  ← inst_exists_goal "(1::real)" goal=1
    #[2] has_real_derivative (λx. x) 1 net
  ← apply_backward_step has_real_derivative_id goal=2
qed

theorem real_differentiable_uminus
  fixes net :: real net
  prop real_differentiable uminus net

theorem real_differentiable_neg
  fixes f :: real => real, net :: real net
  prop real_differentiable f net --> real_differentiable (%x. -(f x)) net
  [hint_backward]
proof
  ← introduction goal=0
    #[1] real_differentiable f net
    #[2] real_differentiable (λx. -(f x)) net
  ← rewrite_goal real_differentiable_def sym=false goal=2
    #[3] ∃f1. has_real_derivative (λx. -(f x)) f1 net
  → rewrite_fact real_differentiable_def sym=false goal=3 facts=[1]
    #[4] ∃f1. has_real_derivative f f1 net
  exists_elim f1 goal=3 facts=[4]
    #[5] _VAR f1
    #[6] has_real_derivative f f1 net
    #[7] ∃f1. has_real_derivative (λx. -(f x)) f1 net
    #[8] real_differentiable (λx. -(f x)) net
  ← inst_exists_goal -f1 goal=7
    #[9] has_real_derivative (λx. -(f x)) (-f1) net
  ← apply_backward_step has_real_derivative_neg goal=9
qed

theorem real_differentiable_add
  fixes f :: real => real, g :: real => real, net :: real net
  prop real_differentiable f net --> real_differentiable g net --> real_differentiable (%x. f x + g x) net
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f net
    #[2] real_differentiable g net
    #[3] real_differentiable (λx. f x + g x) net
  ← rewrite_goal real_differentiable_def sym=false goal=3
    #[4] ∃f1. has_real_derivative (λx. f x + g x) f1 net
  → rewrite_fact real_differentiable_def sym=false goal=4 facts=[1]
    #[5] ∃f1. has_real_derivative f f1 net
  → rewrite_fact real_differentiable_def sym=false goal=4 facts=[2]
    #[6] ∃f1. has_real_derivative g f1 net
  exists_elim f1 goal=4 facts=[5]
    #[7] _VAR f1
    #[8] has_real_derivative f f1 net
    #[9] ∃f1. has_real_derivative (λx. f x + g x) f1 net
    #[10] real_differentiable (λx. f x + g x) net
  exists_elim g1 goal=9 facts=[6]
    #[11] _VAR g1
    #[12] has_real_derivative g g1 net
    #[13] ∃f1. has_real_derivative (λx. f x + g x) f1 net
    #[14] real_differentiable (λx. f x + g x) net
  ← apply_backward_step exI param_a=f1+g1 goal=13
    #[15] has_real_derivative (λx. f x + g x) (f1 + g1) net
  ← apply_backward_step has_real_derivative_add goal=15
qed

theorem real_differentiable_sub
  fixes f :: real => real, g :: real => real, net :: real net
  prop real_differentiable f net --> real_differentiable g net --> real_differentiable (%x. f x - g x) net
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f net
    #[2] real_differentiable g net
    #[3] real_differentiable (λx. f x - g x) net
  ← rewrite_goal real_minus_def sym=false goal=3
    #[4] real_differentiable (λx. f x + -(g x)) net
  ← apply_backward_step real_differentiable_add goal=4
    #[5] real_differentiable (λx. -(g x)) net
  ← apply_backward_step real_differentiable_neg goal=5
qed

theorem real_differentiable_mul_within
  fixes f :: real => real, g :: real => real, s :: real set, x :: real
  prop real_differentiable f (within (atreal x) s) --> real_differentiable g (within (atreal x) s) --> real_differentiable (%x1. f x1 * g x1) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f (within (atreal x) s)
    #[2] real_differentiable g (within (atreal x) s)
    #[3] real_differentiable (λx1. f x1 * g x1) (within (atreal x) s)
  ← rewrite_goal real_differentiable_def sym=false goal=3
    #[4] ∃f1. has_real_derivative (λx1. f x1 * g x1) f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=4 facts=[1]
    #[5] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=4 facts=[2]
    #[6] ∃f1. has_real_derivative g f1 (within (atreal x) s)
  exists_elim f1 goal=4 facts=[5]
    #[7] _VAR f1
    #[8] has_real_derivative f f1 (within (atreal x) s)
    #[9] ∃f1. has_real_derivative (λx1. f x1 * g x1) f1 (within (atreal x) s)
    #[10] real_differentiable (λx1. f x1 * g x1) (within (atreal x) s)
  exists_elim g1 goal=9 facts=[6]
    #[11] _VAR g1
    #[12] has_real_derivative g g1 (within (atreal x) s)
    #[13] ∃f1. has_real_derivative (λx1. f x1 * g x1) f1 (within (atreal x) s)
    #[14] real_differentiable (λx1. f x1 * g x1) (within (atreal x) s)
  ← inst_exists_goal "f x * g1 + f1 * g x" goal=13
    #[15] has_real_derivative (λx1. f x1 * g x1) (f x * g1 + f1 * g x) (within (atreal x) s)
  ← apply_backward_step has_real_derivative_mul_within goal=15
qed

theorem real_differentiable_mul_atreal
  fixes f :: real => real, g :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable g (atreal x) --> real_differentiable (%x1. f x1 * g x1) (atreal x)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f (atreal x)
    #[2] real_differentiable g (atreal x)
    #[3] real_differentiable (λx1. f x1 * g x1) (atreal x)
  ← rewrite_goal real_differentiable_def sym=false goal=3
    #[4] ∃f1. has_real_derivative (λx1. f x1 * g x1) f1 (atreal x)
  → rewrite_fact real_differentiable_def sym=false goal=4 facts=[2]
    #[5] ∃f1. has_real_derivative g f1 (atreal x)
  → rewrite_fact real_differentiable_def sym=false goal=4 facts=[1]
    #[6] ∃f1. has_real_derivative f f1 (atreal x)
  exists_elim g1 goal=4 facts=[5]
    #[7] _VAR g1
    #[8] has_real_derivative g g1 (atreal x)
    #[9] ∃f1. has_real_derivative (λx1. f x1 * g x1) f1 (atreal x)
    #[10] real_differentiable (λx1. f x1 * g x1) (atreal x)
  exists_elim f1 goal=9 facts=[6]
    #[11] _VAR f1
    #[12] has_real_derivative f f1 (atreal x)
    #[13] ∃f1. has_real_derivative (λx1. f x1 * g x1) f1 (atreal x)
    #[14] real_differentiable (λx1. f x1 * g x1) (atreal x)
  ← inst_exists_goal "f x * g1 + f1 * g x" goal=13
    #[15] has_real_derivative (λx1. f x1 * g x1) (f x * g1 + f1 * g x) (atreal x)
  ← apply_backward_step has_real_derivative_mul_atreal goal=15
qed

theorem real_differentiable_pow_within
  fixes f :: real => real, n :: nat, s :: real set, x :: real
  prop real_differentiable f (within (atreal x) s) --> real_differentiable (%x1. f x1 ^ n) (within (atreal x) s)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] real_differentiable f (within (atreal x) s)
    #[2] real_differentiable (λx1. f x1 ^ n) (within (atreal x) s)
  ← rewrite_goal real_differentiable_def sym=false goal=2
    #[3] ∃f1. has_real_derivative (λx1. f x1 ^ n) f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=3 facts=[1]
    #[4] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  exists_elim f1 goal=3 facts=[4]
    #[5] _VAR f1
    #[6] has_real_derivative f f1 (within (atreal x) s)
    #[7] ∃f1. has_real_derivative (λx1. f x1 ^ n) f1 (within (atreal x) s)
    #[8] real_differentiable (λx1. f x1 ^ n) (within (atreal x) s)
  ← inst_exists_goal "(of_nat n * f x ^ (n - 1) * f1)" goal=7
    #[9] has_real_derivative (λx1. f x1 ^ n) (of_nat n * f x ^ (n - 1) * f1) (within (atreal x) s)
  ← apply_backward_step has_real_derivative_pow_within goal=9
qed

theorem real_differentiable_pow_atreal
  fixes f :: real => real, n :: nat, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable (%x1. f x1 ^ n) (atreal x)
proof
  ← introduction goal=0
    #[1] real_differentiable f (atreal x)
    #[2] real_differentiable (λx1. f x1 ^ n) (atreal x)
  ← rewrite_goal withinreal_univ sym=true goal=2
    #[3] real_differentiable (λx1. f x1 ^ n) (within (atreal x) univ)
  → rewrite_fact withinreal_univ sym=true goal=3 facts=[1]
    #[4] real_differentiable f (within (atreal x) univ)
  ← apply_backward_step real_differentiable_pow_within goal=3
qed

theorem real_differentiable_real_pow_atreal
  fixes f :: real => real, p :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable p (atreal x) --> f x > 0 --> real_differentiable (%x1. f x1 ^ p x1) (atreal x)

