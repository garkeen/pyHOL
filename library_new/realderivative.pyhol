  ← z3 goal=50 facts=[33]
    #[51] c < x ∨ x < c
  ← apply_backward_step disjE goal=49 facts=[51]
    #[52] c < x ⟶ ¬(g x = 0)
    #[53] x < c ⟶ ¬(g x = 0)
  ← introduction goal=52
    #[54] c < x
    #[55] ¬(g x = 0)
  → apply_forward_step real_rolle param_f=g param_f1=g1 goal=55 facts=[54]
    #[56] g c = g x ⟶ real_continuous_on g (real_closed_interval c x) ⟶ (∀x1. x1 ∈ real_open_interval c x ⟶ has_real_derivative g (g1 x1) (atreal x1)) ⟶ (∃x1. x1 ∈ real_open_interval c x ∧ g1 x1 = 0)
  ← apply_backward_step contrapositive goal=55 facts=[56]
    #[57] ¬¬(g x = 0) ⟶ ¬(g c = g x ⟶ real_continuous_on g (real_closed_interval c x) ⟶ (∀x1. x1 ∈ real_open_interval c x ⟶ has_real_derivative g (g1 x1) (atreal x1)) ⟶ (∃x1. x1 ∈ real_open_interval c x ∧ g1 x1 = 0))
  ← introduction goal=57
    #[58] ¬¬(g x = 0)
    #[59] ¬(g c = g x ⟶ real_continuous_on g (real_closed_interval c x) ⟶ (∀x1. x1 ∈ real_open_interval c x ⟶ has_real_derivative g (g1 x1) (atreal x1)) ⟶ (∃x1. x1 ∈ real_open_interval c x ∧ g1 x1 = 0))
  → rewrite_fact double_neg sym=false goal=59 facts=[58]
