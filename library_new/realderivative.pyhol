  fixes f :: real => real, p :: real => real, s :: real set
  prop real_differentiable_on f s --> real_differentiable_on p s --> (!x. x Mem s --> f x > 0) --> real_differentiable_on (%x. f x ^ p x) s

theorem real_differentiable_transform_within
  fixes d :: real, f :: real => real, g :: real => real, s :: real set, x :: real
  prop 0 < d --> x Mem s --> (!x1. x1 Mem s --> abs (x1 - x) < d --> f x1 = g x1) --> real_differentiable f (within (atreal x) s) --> real_differentiable g (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] 0 < d
    #[2] x ∈ s
    #[3] ∀x1. x1 ∈ s ⟶ abs (x1 - x) < d ⟶ f x1 = g x1
    #[4] real_differentiable f (within (atreal x) s)
    #[5] real_differentiable g (within (atreal x) s)
  ← rewrite_goal real_differentiable_def sym=false goal=5
    #[6] ∃f1. has_real_derivative g f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=6 facts=[4]
    #[7] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  exists_elim f1 goal=6 facts=[7]
    #[8] _VAR f1
    #[9] has_real_derivative f f1 (within (atreal x) s)
    #[10] ∃f1. has_real_derivative g f1 (within (atreal x) s)
    #[11] real_differentiable g (within (atreal x) s)
  ← inst_exists_goal f1 goal=10
    #[12] has_real_derivative g f1 (within (atreal x) s)
  ← apply_backward_step has_real_derivative_transform_within goal=12 facts=[1,2,3]
qed

theorem real_differentiable_inv_within
  fixes f :: real => real, s :: real set, x :: real
  prop real_differentiable f (within (atreal x) s) --> ~(f x = 0) --> real_differentiable (%x1. real_inverse (f x1)) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f (within (atreal x) s)
    #[2] ¬(f x = 0)
