theorem real_differentiable_div_within
  fixes f :: real => real, g :: real => real, s :: real set, x :: real
  prop real_differentiable f (within (atreal x) s) --> real_differentiable g (within (atreal x) s) --> ~(g x = 0) --> real_differentiable (%x1. f x1 / g x1) (within (atreal x) s)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f (within (atreal x) s)
    #[2] real_differentiable g (within (atreal x) s)
    #[3] ¬(g x = 0)
    #[4] real_differentiable (λx1. f x1 / g x1) (within (atreal x) s)
  ← rewrite_goal real_differentiable_def sym=false goal=4
    #[5] ∃f1. has_real_derivative (λx1. f x1 / g x1) f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=5 facts=[1]
    #[6] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=5 facts=[2]
    #[7] ∃f1. has_real_derivative g f1 (within (atreal x) s)
  exists_elim f2 goal=5 facts=[6]
    #[8] _VAR f2
    #[9] has_real_derivative f f2 (within (atreal x) s)
    #[10] ∃f1. has_real_derivative (λx1. f x1 / g x1) f1 (within (atreal x) s)
    #[11] real_differentiable (λx1. f x1 / g x1) (within (atreal x) s)
  exists_elim g2 goal=10 facts=[7]
    #[12] _VAR g2
    #[13] has_real_derivative g g2 (within (atreal x) s)
    #[14] ∃f1. has_real_derivative (λx1. f x1 / g x1) f1 (within (atreal x) s)
    #[15] real_differentiable (λx1. f x1 / g x1) (within (atreal x) s)
  ← inst_exists_goal "((f2 * g x - f x * g2) / g x ^ (2::nat))" goal=14
    #[16] has_real_derivative (λx1. f x1 / g x1) ((f2 * g x - f x * g2) / g x ^ (2::nat)) (within (atreal x) s)
  ← apply_backward_step has_real_derivative_div_within goal=16
qed

theorem real_differentiable_div_atreal
  fixes f :: real => real, g :: real => real, x :: real
  prop real_differentiable f (atreal x) --> real_differentiable g (atreal x) --> ~(g x = 0) --> real_differentiable (%x1. f x1 / g x1) (atreal x)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable f (atreal x)
    #[2] real_differentiable g (atreal x)
    #[3] ¬(g x = 0)
    #[4] real_differentiable (λx1. f x1 / g x1) (atreal x)
  ← rewrite_goal real_differentiable_def sym=false goal=4
    #[5] ∃f1. has_real_derivative (λx1. f x1 / g x1) f1 (atreal x)
  → rewrite_fact real_differentiable_def sym=false goal=5 facts=[1]
    #[6] ∃f1. has_real_derivative f f1 (atreal x)
  → rewrite_fact real_differentiable_def sym=false goal=5 facts=[2]
    #[7] ∃f1. has_real_derivative g f1 (atreal x)
  exists_elim f1 goal=5 facts=[6]
    #[8] _VAR f1
    #[9] has_real_derivative f f1 (atreal x)
    #[10] ∃f1. has_real_derivative (λx1. f x1 / g x1) f1 (atreal x)
    #[11] real_differentiable (λx1. f x1 / g x1) (atreal x)
  exists_elim g1 goal=10 facts=[7]
    #[12] _VAR g1
    #[13] has_real_derivative g g1 (atreal x)
    #[14] ∃f1. has_real_derivative (λx1. f x1 / g x1) f1 (atreal x)
    #[15] real_differentiable (λx1. f x1 / g x1) (atreal x)
  ← inst_exists_goal "((f1 * g x - f x * g1) / g x ^ (2::nat))" goal=14
    #[16] has_real_derivative (λx1. f x1 / g x1) ((f1 * g x - f x * g1) / g x ^ (2::nat)) (atreal x)
  ← apply_backward_step has_real_derivative_div_atreal goal=16
qed

theorem real_differentiable_transform
  fixes f :: real => real, g :: real => real, s :: real set
  prop (!x. x Mem s --> f x = g x) --> real_differentiable_on f s --> real_differentiable_on g s
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] ∀x. x ∈ s ⟶ f x = g x
    #[2] real_differentiable_on f s
    #[3] real_differentiable_on g s
  ← rewrite_goal real_differentiable_on_def sym=false goal=3
    #[4] ∀x. x ∈ s ⟶ (∃f1. has_real_derivative g f1 (within (atreal x) s))
  ← introduction x goal=4
    #[5] _VAR x
    #[6] x ∈ s
    #[7] ∃f1. has_real_derivative g f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_on_differentiable sym=false goal=7 facts=[2]
    #[8] ∀x. x ∈ s ⟶ real_differentiable f (within (atreal x) s)
  → apply_fact goal=7 facts=[8,6]
    #[9] real_differentiable f (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=7 facts=[9]
    #[10] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  exists_elim f1 goal=7 facts=[10]
    #[11] _VAR f1
    #[12] has_real_derivative f f1 (within (atreal x) s)
    #[13] ∃f1. has_real_derivative g f1 (within (atreal x) s)
  ← inst_exists_goal f1 goal=13
    #[14] has_real_derivative g f1 (within (atreal x) s)
  ← apply_backward_step has_real_derivative_transform_within param_d="(1::real)" param_f=f goal=14
    #[15] (0::real) < 1
    #[16] ∀x1. x1 ∈ s ⟶ abs (x1 - x) < 1 ⟶ f x1 = g x1
  ← z3 goal=15
    #[17] (0::real) < 1
  ← introduction x1 goal=16
    #[18] _VAR x1
    #[19] x1 ∈ s
    #[20] abs (x1 - x) < 1
    #[21] f x1 = g x1
  ← apply_prev goal=21 facts=[1]
qed

theorem real_differentiable_eq
  fixes f :: real => real, g :: real => real, s :: real set
  prop (!x. x Mem s --> f x = g x) --> real_differentiable_on f s <--> real_differentiable_on g s
proof
  ← introduction goal=0
    #[1] ∀x. x ∈ s ⟶ f x = g x
    #[2] real_differentiable_on f s ⟷ real_differentiable_on g s
  ← apply_backward_step iffI goal=2
    #[3] real_differentiable_on f s ⟶ real_differentiable_on g s
    #[4] real_differentiable_on g s ⟶ real_differentiable_on f s
  ← introduction goal=3
    #[5] real_differentiable_on f s
    #[6] real_differentiable_on g s
  ← apply_backward_step real_differentiable_transform goal=6 facts=[1,5]
  ← introduction goal=4
    #[7] real_differentiable_on g s
    #[8] real_differentiable_on f s
  → rewrite_fact eq_sym_eq sym=false goal=8 facts=[1]
    #[9] ∀x. x ∈ s ⟶ g x = f x
  ← apply_backward_step real_differentiable_transform goal=8 facts=[9,7]
qed

theorem real_differentiable_transform_atreal
  fixes d :: real, f :: real => real, g :: real => real, x :: real
  prop 0 < d --> (!x1. abs (x1 - x) < d --> f x1 = g x1) --> real_differentiable f (atreal x) --> real_differentiable g (atreal x)
