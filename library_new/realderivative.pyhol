theorem real_differentiable_on_inv
  fixes f :: real => real, s :: real set
  prop real_differentiable_on f s --> (!x. x Mem s --> ~(f x = 0)) --> real_differentiable_on (%x. real_inverse (f x)) s
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable_on f s
    #[2] ∀x. x ∈ s ⟶ ¬(f x = 0)
    #[3] real_differentiable_on (λx. real_inverse (f x)) s
  ← rewrite_goal real_differentiable_on_differentiable sym=false goal=3
    #[4] ∀x. x ∈ s ⟶ real_differentiable (λx1. real_inverse (f x1)) (within (atreal x) s)
  → rewrite_fact real_differentiable_on_differentiable sym=false goal=4 facts=[1]
    #[5] ∀x. x ∈ s ⟶ real_differentiable f (within (atreal x) s)
  ← introduction x goal=4
    #[6] _VAR x
    #[7] x ∈ s
    #[8] real_differentiable (λx1. real_inverse (f x1)) (within (atreal x) s)
  ← apply_backward_step real_differentiable_inv_within goal=8
    #[9] real_differentiable f (within (atreal x) s)
    #[10] ¬(f x = 0)
  ← apply_prev goal=9 facts=[5]
  ← apply_prev goal=10 facts=[2]
qed

theorem real_differentiable_on_div
  fixes f :: real => real, g :: real => real, s :: real set, x :: real
  prop real_differentiable_on f s --> real_differentiable_on g s --> (!x. x Mem s --> ~(g x = 0)) --> real_differentiable_on (%x. f x / g x) s
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_differentiable_on f s
    #[2] real_differentiable_on g s
    #[3] ∀x. x ∈ s ⟶ ¬(g x = 0)
    #[4] real_differentiable_on (λx. f x / g x) s
  ← rewrite_goal real_differentiable_on_differentiable sym=false goal=4
    #[5] ∀x. x ∈ s ⟶ real_differentiable (λx1. f x1 / g x1) (within (atreal x) s)
  → rewrite_fact real_differentiable_on_differentiable sym=false goal=5 facts=[1]
    #[6] ∀x. x ∈ s ⟶ real_differentiable f (within (atreal x) s)
  → rewrite_fact real_differentiable_on_differentiable sym=false goal=5 facts=[2]
    #[7] ∀x. x ∈ s ⟶ real_differentiable g (within (atreal x) s)
  ← introduction x goal=5
    #[8] _VAR x
    #[9] x ∈ s
    #[10] real_differentiable (λx1. f x1 / g x1) (within (atreal x) s)
  ← apply_backward_step real_differentiable_div_within goal=10
    #[11] real_differentiable f (within (atreal x) s)
    #[12] real_differentiable g (within (atreal x) s)
    #[13] ¬(g x = 0)
  ← apply_prev goal=11 facts=[6]
  ← apply_prev goal=12 facts=[7]
  ← apply_prev goal=13 facts=[3]
qed

