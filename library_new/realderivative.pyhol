    #[4] ∃f1. has_real_derivative (λx1. real_inverse (f x1)) f1 (within (atreal x) s)
  → rewrite_fact real_differentiable_def sym=false goal=4 facts=[1]
    #[5] ∃f1. has_real_derivative f f1 (within (atreal x) s)
  exists_elim f1 goal=4 facts=[5]
    #[6] _VAR f1
