theorem real_derivative_cos
  fixes x :: real
  prop real_derivative cos x = -(sin x)
proof
  ← rewrite_goal real_derivative_def sym=false goal=0
    #[1] (THE f1. has_real_derivative cos f1 (atreal x)) = -(sin x)
  → apply_forward_step has_real_derivative_cos param_x=x goal=1
    #[2] has_real_derivative cos (-(sin x)) (atreal x)
  → apply_forward_step theI param_P="(%f1. has_real_derivative cos f1 (atreal x))" param_a="-sin x" goal=1
    #[3] has_real_derivative cos (-(sin x)) (atreal x) ⟶ (∀x1. has_real_derivative cos x1 (atreal x) ⟶ x1 = -(sin x)) ⟶ has_real_derivative cos (THE x1. has_real_derivative cos x1 (atreal x)) (atreal x)
  → apply_fact goal=1 facts=[3,2]
    #[4] (∀x1. has_real_derivative cos x1 (atreal x) ⟶ x1 = -(sin x)) ⟶ has_real_derivative cos (THE x1. has_real_derivative cos x1 (atreal x)) (atreal x)
  cut "(∀x1. has_real_derivative cos x1 (atreal x) ⟶ x1 = -(sin x))" goal=1
    #[5] ∀x1. has_real_derivative cos x1 (atreal x) ⟶ x1 = -(sin x)
  ← introduction y goal=5
    #[6] _VAR y
    #[7] has_real_derivative cos y (atreal x)
    #[8] y = -(sin x)
  ← apply_backward_step real_derivative_unique_atreal goal=8 facts=[7,2]
  → apply_fact goal=1 facts=[4,5]
    #[9] has_real_derivative cos (THE x1. has_real_derivative cos x1 (atreal x)) (atreal x)
  ← apply_prev goal=1 facts=[5]
qed

