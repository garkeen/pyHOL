theorem lhospital_lemma
  fixes c :: real, d :: real, f :: real => real, f1 :: real => real, g :: real => real, g1 :: real => real, l :: real
  prop 0 < d --> (!x. 0 < abs (x - c) --> abs (x - c) < d --> has_real_derivative f (f1 x) (atreal x) & has_real_derivative g (g1 x) (atreal x) & ~(g1 x = 0)) --> f c = 0 --> g c = 0 --> tendsto_real f 0 (atreal c) --> tendsto_real g 0 (atreal c) --> tendsto_real (%x. f1 x / g1 x) l (atreal c) --> tendsto_real (%x. f x / g x) l (atreal c)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] 0 < d
    #[2] ∀x. 0 < abs (x - c) ⟶ abs (x - c) < d ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x) ∧ ¬(g1 x = 0)
    #[3] f c = 0
    #[4] g c = 0
    #[5] tendsto_real f 0 (atreal c)
    #[6] tendsto_real g 0 (atreal c)
    #[7] tendsto_real (λx. f1 x / g1 x) l (atreal c)
    #[8] tendsto_real (λx. f x / g x) l (atreal c)
  cut "!p. !q. !r. (p--> q & r) <--> (p-->q) & (p-->r)" goal=8
    #[9] ∀p. ∀q. ∀r. (p ⟶ q ∧ r) ⟷ (p ⟶ q) ∧ (p ⟶ r)
