  ← apply_backward_step real_differentiable_mul_within goal=9
    #[10] real_differentiable f (within (atreal x) s)
    #[11] real_differentiable g (within (atreal x) s)
  ← apply_prev goal=10 facts=[5]
  ← apply_prev goal=11 facts=[6]
