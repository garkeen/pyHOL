    #[44] real_continuous g (atreal c)
  ← rewrite_goal real_continuous_atreal sym=false goal=44
    #[45] tendsto_real g (g c) (atreal c)
  ← rewrite_goal_with_prev goal=45 facts=[4]
  ← introduction goal=42
    #[46] real_continuous g (atreal x)
  → apply_fact goal=46 facts=[19,33,23]
    #[47] has_real_derivative g (g1 x) (atreal x)
  ← apply_backward_step has_real_derivative_imp_continuous_atreal param_f1="g1 x" goal=46
  cut "!x. 0 < abs (x - c) ⟶  abs (x - c) < d ⟶ ¬(g x = 0)" goal=8
    #[48] ∀x. 0 < abs (x - c) ⟶ abs (x - c) < d ⟶ ¬(g x = 0)
  ← introduction x goal=48
    #[49] ¬(g x = 0)
  cut "c < x | x < c" goal=49
