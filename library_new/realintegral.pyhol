theorem real_measurable_inter
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_measurable t --> real_measurable (s Int t)
  [hint_backward,hint_forward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measurable t
    #[3] real_measurable (s ∩ t)
  ← rewrite_goal real_measurable_real_integrable sym=false goal=3
    #[4] real_integrable_on (λx. if x ∈ s ∩ t then 1 else 0) univ
  ← apply_backward_step absolutely_real_integrable_imp_integrable goal=4
    #[5] absolutely_real_integrable_on (λx. if x ∈ s ∩ t then 1 else 0) univ
  cut "(λx. if x ∈ s ∩ t then (1::real) else 0) = (λx. min (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0))" goal=5
    #[6] (λx. if x ∈ s ∩ t then (1::real) else 0) = (λx. min (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0))
  ← apply_backward_step extension goal=6
    #[7] ∀x. (if x ∈ s ∩ t then (1::real) else 0) = min (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0)
  ← z3 goal=7
    #[8] ∀x. (if x ∈ s ∩ t then (1::real) else 0) = min (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0)
  ← rewrite_goal_with_prev goal=5 facts=[6]
    #[9] absolutely_real_integrable_on (λx. min (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0)) univ
  ← apply_backward_step absolutely_real_integrable_min goal=9
    #[10] absolutely_real_integrable_on (λx. if x ∈ s then 1 else 0) univ
    #[11] absolutely_real_integrable_on (λx. if x ∈ t then 1 else 0) univ
  ← apply_backward_step monnegative_absolutely_real_integrable goal=10
    #[12] ∀x. x ∈ univ ⟶ (0::real) ≤ (if x ∈ s then 1 else 0)
    #[13] real_integrable_on (λx. if x ∈ s then 1 else 0) univ
  ← z3 goal=12
    #[14] ∀x. x ∈ univ ⟶ (0::real) ≤ (if x ∈ s then 1 else 0)
  -> rewrite_fact real_measurable_real_integrable sym=false goal=13 facts=[1]
    #[15] real_integrable_on (λx. if x ∈ s then 1 else 0) univ
  ← apply_backward_step monnegative_absolutely_real_integrable goal=11
    #[16] ∀x. x ∈ univ ⟶ (0::real) ≤ (if x ∈ t then 1 else 0)
    #[17] real_integrable_on (λx. if x ∈ t then 1 else 0) univ
  ← z3 goal=16
    #[18] ∀x. x ∈ univ ⟶ (0::real) ≤ (if x ∈ t then 1 else 0)
  -> rewrite_fact real_measurable_real_integrable sym=false goal=17 facts=[2]
    #[19] real_integrable_on (λx. if x ∈ t then 1 else 0) univ
qed

theorem real_measurable_union
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_measurable t --> real_measurable (s Un t)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measurable t
    #[3] real_measurable (s ∪ t)
  ← rewrite_goal real_measurable_real_integrable sym=false goal=3
    #[4] real_integrable_on (λx. if x ∈ s ∪ t then 1 else 0) univ
  ← apply_backward_step absolutely_real_integrable_imp_integrable goal=4
    #[5] absolutely_real_integrable_on (λx. if x ∈ s ∪ t then 1 else 0) univ
  cut "(λx. if x ∈ s ∪ t then (1::real) else 0) = (λx. max (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0))" goal=5
    #[6] (λx. if x ∈ s ∪ t then (1::real) else 0) = (λx. max (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0))
  ← apply_backward_step extension goal=6
    #[7] ∀x. (if x ∈ s ∪ t then (1::real) else 0) = max (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0)
  ← z3 goal=7
    #[8] ∀x. (if x ∈ s ∪ t then (1::real) else 0) = max (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0)
  ← rewrite_goal_with_prev goal=5 facts=[6]
    #[9] absolutely_real_integrable_on (λx. max (if x ∈ s then 1 else 0) (if x ∈ t then 1 else 0)) univ
  ← apply_backward_step absolutely_real_integrable_max goal=9
    #[10] absolutely_real_integrable_on (λx. if x ∈ s then 1 else 0) univ
    #[11] absolutely_real_integrable_on (λx. if x ∈ t then 1 else 0) univ
  ← apply_backward_step monnegative_absolutely_real_integrable goal=10
    #[12] ∀x. x ∈ univ ⟶ (0::real) ≤ (if x ∈ s then 1 else 0)
    #[13] real_integrable_on (λx. if x ∈ s then 1 else 0) univ
  ← z3 goal=12
    #[14] ∀x. x ∈ univ ⟶ (0::real) ≤ (if x ∈ s then 1 else 0)
  -> rewrite_fact real_measurable_real_integrable sym=false goal=13 facts=[1]
    #[15] real_integrable_on (λx. if x ∈ s then 1 else 0) univ
  ← apply_backward_step monnegative_absolutely_real_integrable goal=11
    #[16] ∀x. x ∈ univ ⟶ (0::real) ≤ (if x ∈ t then 1 else 0)
    #[17] real_integrable_on (λx. if x ∈ t then 1 else 0) univ
  ← z3 goal=16
    #[18] ∀x. x ∈ univ ⟶ (0::real) ≤ (if x ∈ t then 1 else 0)
  -> rewrite_fact real_measurable_real_integrable sym=false goal=17 facts=[2]
    #[19] real_integrable_on (λx. if x ∈ t then 1 else 0) univ
qed

theorem has_real_measure_disjoint_union
  fixes m1 :: real, m2 :: real, s1 :: real set, s2 :: real set
  prop has_real_measure s1 m1 --> has_real_measure s2 m2 --> disjoint s1 s2 --> has_real_measure (s1 Un s2) (m1 + m2)
  [hint_backward,hint_forward,hint_backward1]

theorem real_measure_disjoint_union
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_measurable t --> disjoint s t --> real_measure (s Un t) = real_measure s + real_measure t
  [hint_backward,hint_forward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measurable t
    #[3] disjoint s t
    #[4] real_measure (s ∪ t) = real_measure s + real_measure t
  ← apply_backward_step real_measure_unique goal=4
    #[5] has_real_measure (s ∪ t) (real_measure s + real_measure t)
  ← apply_backward_step has_real_measure_disjoint_union goal=5
    #[6] has_real_measure s (real_measure s)
    #[7] has_real_measure t (real_measure t)
  ← rewrite_goal has_real_measure_real_measurable_real_measure sym=false goal=6
    #[8] real_measurable s ∧ real_measure s = real_measure s
  ← apply_backward_step conjI goal=8
    #[9] real_measure s = real_measure s
  ← apply_backward_step eq_refl goal=9
    #[10] real_measure s = real_measure s
  ← rewrite_goal has_real_measure_real_measurable_real_measure sym=false goal=7
    #[11] real_measurable t ∧ real_measure t = real_measure t
  ← apply_backward_step conjI goal=11 facts=[2]
    #[12] real_measure t = real_measure t
  ← apply_backward_step eq_refl goal=12
    #[13] real_measure t = real_measure t
qed

theorem has_real_measure_pos_le
  fixes m :: real, s :: real set
  prop has_real_measure s m --> 0 <= m
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_measure s m
    #[2] 0 ≤ m
  -> rewrite_fact has_real_measure_def goal=2 facts=[1]
    #[3] has_real_integral (λx. 1) m s
  ← apply_backward_step has_real_integral_pos param_f="(%x::real. (1::real))" param_s=s goal=2
    #[4] ∀x. x ∈ s ⟶ (0::real) ≤ 1
  ← introduction x goal=4
    #[5] _VAR x
    #[6] x ∈ s
    #[7] (0::real) ≤ 1
  ← z3 goal=7
    #[8] (0::real) ≤ 1
qed

theorem real_measure_pos_le
  fixes s :: real set
  prop real_measurable s --> 0 <= real_measure s
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] 0 ≤ real_measure s
  ← apply_backward_step has_real_measure_pos_le param_s=s goal=2
    #[3] has_real_measure s (real_measure s)
  -> rewrite_fact has_real_measure_mesure goal=3 facts=[1]
qed

theorem has_real_measure_subset
  fixes m1 :: real, m2 :: real, s1 :: real set, s2 :: real set
  prop has_real_measure s1 m1 --> has_real_measure s2 m2 --> s1 Sub s2 --> m1 <= m2
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_measure s1 m1
    #[2] has_real_measure s2 m2
    #[3] s1 ⊆ s2
    #[4] m1 ≤ m2
  -> rewrite_fact has_real_measure_def sym=false goal=4 facts=[1]
    #[5] has_real_integral (λx. 1) m1 s1
  -> rewrite_fact has_real_measure_def sym=false goal=4 facts=[2]
    #[6] has_real_integral (λx. 1) m2 s2
  ← apply_backward_step has_real_integral_subset_le goal=4 facts=[3,5,6]
    #[7] ∀x. x ∈ s2 ⟶ (0::real) ≤ 1
  ← z3 goal=7
    #[8] ∀x. x ∈ s2 ⟶ (0::real) ≤ 1
qed

theorem real_measure_subset
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_measurable t --> s Sub t --> real_measure s <= real_measure t
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measurable t
    #[3] s ⊆ t
    #[4] real_measure s ≤ real_measure t
  ← apply_backward_step has_real_measure_subset param_s1=s param_s2=t goal=4
    #[5] has_real_measure s (real_measure s)
    #[6] has_real_measure t (real_measure t)
  ← rewrite_goal has_real_measure_real_measurable_real_measure sym=false goal=5
    #[7] real_measurable s ∧ real_measure s = real_measure s
  ← apply_backward_step conjI goal=7
    #[8] real_measure s = real_measure s
  ← apply_backward_step eq_refl goal=8
    #[9] real_measure s = real_measure s
  ← rewrite_goal has_real_measure_real_measurable_real_measure sym=false goal=6
    #[10] real_measurable t ∧ real_measure t = real_measure t
  ← apply_backward_step conjI goal=10
    #[11] real_measure t = real_measure t
  ← apply_backward_step eq_refl goal=11
    #[12] real_measure t = real_measure t
qed

theorem has_real_measure_0
  fixes s :: real set
  prop has_real_measure s 0 <--> real_negligible s
  [hint_rewrite,hint_rewrite_sym]

theorem real_measure_eq_0
  fixes s :: real set
  prop real_negligible s --> real_measure s = 0
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] real_negligible s
    #[2] real_measure s = 0
  ← apply_backward_step real_measure_unique goal=2
    #[3] has_real_measure s 0
  ← rewrite_goal has_real_measure_0 goal=3
qed

theorem has_real_measure_empty
