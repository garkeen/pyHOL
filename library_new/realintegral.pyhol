  fixes f :: 'a => real set, s :: 'a set
  prop finite ({x. x Mem s & ~(f x = {})}) --> (!x. x Mem s --> real_measurable (f x)) --> (!x. !y. x Mem s --> y Mem s --> ~(x = y) --> real_negligible (f x Int f y)) --> has_real_measure (UN (image f s)) (sum s (%x. real_measure (f x)))
