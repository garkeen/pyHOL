  [hint_backward,hint_backward1,hint_forward]

theorem real_measure_diff_subset
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_measurable t --> t Sub s --> real_measure (diff s t) = real_measure s - real_measure t
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measurable t
    #[3] t ⊆ s
    #[4] real_measure (diff s t) = real_measure s - real_measure t
  ← apply_backward_step real_measure_unique goal=4
    #[5] has_real_measure (diff s t) (real_measure s - real_measure t)
  ← apply_backward_step has_real_measure_diff_subset goal=5
    #[6] has_real_measure s (real_measure s)
    #[7] has_real_measure t (real_measure t)
  -> rewrite_fact has_real_measure_mesure sym=false goal=6 facts=[1]
    #[8] has_real_measure s (real_measure s)
  -> rewrite_fact has_real_measure_mesure sym=false goal=7 facts=[2]
    #[9] has_real_measure t (real_measure t)
