theorem real_measure_union
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_measurable t --> real_measure (s Un t) = real_measure s + real_measure t - real_measure (s Int t)
  [hint_backward,hint_backward1,hint_forward]

theorem real_measure_union_le
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_measurable t --> real_measure (s Un t) <= real_measure s + real_measure t
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measurable t
    #[3] real_measure (s ∪ t) ≤ real_measure s + real_measure t
  -> apply_forward_step real_measure_union goal=3 facts=[1,2]
    #[4] real_measure (s ∪ t) = real_measure s + real_measure t - real_measure (s ∩ t)
  ← rewrite_goal_with_prev goal=3 facts=[4]
    #[5] real_measure s + real_measure t - real_measure (s ∩ t) ≤ real_measure s + real_measure t
  cut "∀a::real. ∀b. a - b ≤ a ⟷ 0 ≤ b" goal=5
    #[6] ∀a::real. ∀b. a - b ≤ a ⟷ 0 ≤ b
  ← z3 goal=6
    #[7] ∀a::real. ∀b. a - b ≤ a ⟷ 0 ≤ b
  ← rewrite_goal_with_prev goal=5 facts=[7]
    #[8] 0 ≤ real_measure (s ∩ t)
  ← apply_backward_step real_measure_pos_le goal=8
    #[9] real_measurable (s ∩ t)
  ← apply_backward_step real_measurable_inter goal=9 facts=[1,2]
qed

theorem real_measure_unions_le
  fixes f :: real set set
  prop finite f --> (!s. s Mem f --> real_measurable s) --> real_measure (UN f) = sum f (%s. real_measure s)
  [hint_backward,hint_backward1,hint_forward]

theorem real_measure_unions_le_image
  fixes f :: 'a set, s :: 'a => real set
  prop finite f --> (!a. a Mem f --> real_measurable (s a)) --> real_measure (UN (image s f)) = sum f (%a. real_measure (s a))
  [hint_backward,hint_backward1,hint_forward]

theorem real_negligible_outer
  fixes s :: real set
  prop real_negligible s <--> (!e. 0 < e --> (?t. s Sub t & real_measurable t & real_measure t < e))
  [hint_rewrite]

theorem real_negligible_outer_le
  fixes s :: real set
  prop real_negligible s <--> (!e. 0 < e --> (?t. s Sub t & real_measurable t & real_measure t <= e))
  [hint_rewrite]

theorem real_measurable_inner_outer
  fixes s :: real set
  prop real_measurable s <--> (!e. 0 < e --> (?t. ?u. t Sub s & s Sub u & real_measurable t & real_measurable u & abs (real_measure t - real_measure u) < e))
  [hint_rewrite]

theorem has_real_measure_inner_outer
  fixes m :: real, s :: real set
  prop has_real_measure s m <--> (!e. 0 < e --> (?t. t Sub s & real_measurable t & m - e < real_measure t)) & (!e. 0 < e --> (?u. s Sub u & real_measurable u & real_measure u < m + e))
  [hint_rewrite]

theorem has_real_measure_inner_outer_le
  fixes m :: real, s :: real set
  prop has_real_measure s m <--> (!e. 0 < e --> (?t. t Sub s & real_measurable t & m - e <= real_measure t)) & (!e. 0 < e --> (?u. s Sub u & real_measurable u & real_measure u <= m + e))
  [hint_rewrite]

theorem has_real_measure_affinity
  fixes c :: real, m :: real, s :: real set, y :: real
  prop has_real_measure s y --> has_real_measure (image (%x. m * x + c) s) (abs m * y)
  [hint_forward,hint_backward]

theorem has_real_measure_scaling
  fixes m :: real, s :: real set, y :: real
  prop has_real_measure s y --> has_real_measure (image (%x. m * x) s) (abs m * y)
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_measure s y
    #[2] has_real_measure (image (λx. m * x) s) (abs m * y)
  -> apply_forward_step has_real_measure_affinity param_c="(0::real)" param_m=m goal=2 facts=[1]
    #[3] has_real_measure (image (λx. m * x + 0) s) (abs m * y)
  -> rewrite_fact real_add_rid goal=2 facts=[3]
qed

theorem has_real_measure_translation
  fixes a :: real, m :: real, s :: real set
  prop has_real_measure s m --> has_real_measure (image (%x. x + a) s) m
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_measure s m
    #[2] has_real_measure (image (λx. x + a) s) m
  -> apply_forward_step has_real_measure_affinity param_c=a param_m="(1::real)" goal=2 facts=[1]
    #[3] has_real_measure (image (λx. 1 * x + a) s) (abs 1 * m)
  -> rewrite_fact real_mul_lid goal=2 facts=[3]
    #[4] has_real_measure (image (λx. x + a) s) (abs 1 * m)
  cut "abs 1 * m = m" goal=2
    #[5] abs 1 * m = m
  ← z3 goal=5
    #[6] abs 1 * m = m
  -> rewrite_fact_with_prev goal=2 facts=[6,4]
qed

theorem real_negligible_translation
  fixes a :: real, s :: real set
  prop real_negligible s --> real_negligible (image (%x. x + a) s)
  [hint_backward,hint_forward]

theorem has_real_measure_translation_eq
  fixes a :: real, m :: real, s :: real set
  prop has_real_measure (image (%x. x + a) s) m <--> has_real_measure s m
  [hint_rewrite]

theorem real_negligible_translation_rev
  fixes a :: real, s :: real set
  prop real_negligible (image (%x. x + a) s) --> real_negligible s
  [hint_backward,hint_forward]

theorem real_negligible_translation_eq
  fixes a :: real, s :: real set
  prop real_negligible (image (%x. x + a) s) <--> real_negligible s
  [hint_rewrite]
proof
  ← apply_backward_step iffI goal=0
    #[1] real_negligible (image (λx. x + a) s) ⟶ real_negligible s
    #[2] real_negligible s ⟶ real_negligible (image (λx. x + a) s)
  ← introduction goal=1
    #[3] real_negligible (image (λx. x + a) s)
    #[4] real_negligible s
  ← apply_backward_step real_negligible_translation_rev param_a=a goal=4
  ← introduction goal=2
    #[5] real_negligible s
    #[6] real_negligible (image (λx. x + a) s)
  ← apply_backward_step real_negligible_translation goal=6
qed

theorem real_measurable_translation
  fixes a :: real, s :: real set
  prop real_measurable (image (%x. x + a) s) <--> real_measurable s
  [hint_rewrite]
proof
  ← rewrite_goal real_measurable_def goal=0
    #[1] (∃m. has_real_measure (image (λx. x + a) s) m) ⟷ (∃m. has_real_measure s m)
  ← rewrite_goal has_real_measure_translation_eq goal=1
qed

theorem real_measure_translation
  fixes a :: real, s :: real set
  prop real_measurable s --> real_measure (image (%x. x + a) s) = real_measure s
  [hint_forward,hint_backward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measure (image (λx. x + a) s) = real_measure s
  -> rewrite_fact has_real_measure_mesure goal=2 facts=[1]
    #[3] has_real_measure s (real_measure s)
  ← apply_backward_step real_measure_unique goal=2
    #[4] has_real_measure (image (λx. x + a) s) (real_measure s)
  ← rewrite_goal has_real_measure_translation_eq goal=4
qed

theorem has_real_measure_scaling_eq
  fixes c :: real, m :: real, s :: real set
  prop ~(c = 0) --> has_real_measure (image (%x. c * x) s) (abs c * m) <--> has_real_measure s m
  [hint_backward,hint_forward]

theorem real_measurable_scaling
  fixes c :: real, s :: real set
  prop real_measurable s --> real_measurable (image (%x. c * x) s)
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measurable (image (λx. c * x) s)
  ← rewrite_goal real_measurable_def goal=2
    #[3] ∃m. has_real_measure (image (λx. c * x) s) m
  -> rewrite_fact real_measurable_def goal=3 facts=[1]
    #[4] ∃m. has_real_measure s m
  exists_elim m goal=3 facts=[4]
    #[5] _VAR m
    #[6] has_real_measure s m
    #[7] ∃m. has_real_measure (image (λx. c * x) s) m
    #[8] real_measurable (image (λx. c * x) s)
  -> apply_forward_step has_real_measure_scaling param_m=c goal=7 facts=[6]
    #[9] has_real_measure (image (λx. c * x) s) (abs c * m)
  ← apply_backward_step exI goal=7 facts=[9]
    #[10] ∃m. has_real_measure (image (λx. c * x) s) m
qed

theorem real_measurable_scaling_eq
  fixes c :: real, s :: real set
  prop ~(c = 0) --> real_measurable (image (%x. c * x) s) <--> real_measurable s
  [hint_backward,hint_forward]

theorem real_measure_scaling
  fixes c :: real, s :: real set
  prop real_measurable s --> real_measure (image (%x. c * x) s) = abs c * real_measure s
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measure (image (λx. c * x) s) = abs c * real_measure s
  -> rewrite_fact has_real_measure_mesure goal=2 facts=[1]
    #[3] has_real_measure s (real_measure s)
  ← apply_backward_step real_measure_unique goal=2
    #[4] has_real_measure (image (λx. c * x) s) (abs c * real_measure s)
  ← apply_backward_step has_real_measure_scaling goal=4 facts=[3]
qed

theorem has_real_measure_nested_unions
  fixes B :: real, s :: nat => real set
  prop (!n. real_measurable (s n)) --> (!n. real_measure (s n) <= B) --> (!n. s n Sub s (Suc n)) --> real_measurable (UN ({y. ?n. y = s n})) & tendsto_real (%n. real_measure (s n)) (real_measure (UN ({y. ?n. y = s n}))) sequentially
  [hint_backward,hint_backward1,hint_forward]

theorem real_measurable_nested_unions
  fixes B :: real, s :: nat => real set
  prop (!n. real_measurable (s n)) --> (!n. real_measure (s n) <= B) --> (!n. s n Sub s (Suc n)) --> real_measurable (UN ({y. ?n. y = s n}))
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] ∀n. real_measurable (s n)
    #[2] ∀n. real_measure (s n) ≤ B
    #[3] ∀n. s n ⊆ s (Suc n)
    #[4] real_measurable (⋃({y. ∃n. y = s n}))
  -> apply_forward_step has_real_measure_nested_unions goal=4 facts=[1,2,3]
    #[5] real_measurable (⋃({y. ∃n. y = s n})) ∧ tendsto_real (λn. real_measure (s n)) (real_measure (⋃({y. ∃n. y = s n}))) sequentially
  ← apply_backward_step conjD1 goal=4 facts=[5]
qed

theorem has_real_measure_countable_real_negligible_unions
  fixes B :: real, s :: nat => real set
  prop (!n. real_measurable (s n)) --> (!m. !n. ~(m = n) --> real_negligible (s m Int s n)) --> (!n. sum ({0..n}) (%k. real_measure (s k)) <= B) --> real_measurable (UN ({y. ?n. y = s n})) & real_sums (%n. real_measure (s n)) (real_measure (UN ({y. ?n. y = s n}))) (from 0)
  [hint_backward,hint_forward,hint_backward1]

theorem real_negligible_countable_unions
  fixes s :: nat => real set
  prop (!n. real_negligible (s n)) --> real_negligible (UN ({y. ?n. y = s n}))
  [hint_backward,hint_forward]

theorem real_measurable_countable_unions_strong
  fixes B :: real, s :: nat => real set
  prop (!n. real_measurable (s n)) --> (!n. real_measure (UN ({y. ?k. y = s k & k <= n})) <= B) --> real_measurable (UN ({y. ?n. y = s n}))
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_measure_countable_real_negligible_unions_bounded
  fixes s :: nat => real set
  prop (!n. real_measurable (s n)) --> (!m. !n. ~(m = n) --> real_negligible (s m Int s n)) --> real_bounded (UN ({y. ?n. y = s n})) --> real_measurable (UN ({y. ?n. y = s n})) & real_sums (%n. real_measure (s n)) (real_measure (UN ({y. ?n. y = s n}))) (from 0)
  [hint_backward,hint_backward1,hint_forward]

theorem real_measurable_countable_unions
  fixes B :: real, s :: nat => real set
  prop (!n. real_measurable (s n)) --> (!n. sum ({0..n}) (%k. real_measure (s k)) <= B) --> real_measurable (UN ({y. ?n. y = s n}))
  [hint_backward,hint_backward1,hint_forward]

theorem real_measurable_countable_unions_bounded
  fixes s :: nat => real set
  prop (!n. real_measurable (s n)) --> real_bounded (UN ({y. ?n. y = s n})) --> real_measurable (UN ({y. ?n. y = s n}))
  [hint_backward,hint_backward1,hint_forward]

theorem real_measurable_countable_inters
  fixes s :: nat => real set
  prop (!n. real_measurable (s n)) --> real_measurable (INT ({y. ?n. y = s n}))
  [hint_backward,hint_forward]

theorem real_negligible_countable
  fixes s :: real set
  prop countable s --> real_negligible s
  [hint_backward,hint_forward]

theorem real_measurable_compact
  fixes s :: real set
  prop real_compact s --> real_measurable s
  [hint_backward,hint_forward]

theorem real_measurable_open
  fixes s :: real set
  prop real_bounded s --> real_open s --> real_measurable s
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_integral_negligible_eq
  fixes f :: real => real, s :: real set
  prop (!x. x Mem s --> 0 <= f x) --> has_real_integral f 0 s <--> real_negligible ({x. x Mem s & ~(f x = 0)})
  [hint_backward,hint_forward]

theorem real_integration_by_parts
  fixes a :: real, b :: real, c :: real set, f :: real => real, f1 :: real => real, g :: real => real, g1 :: real => real, y :: real
  prop a <= b --> countable c --> real_continuous_on (%x. f x * g x) (real_closed_interval a b) --> (!x. x Mem diff (real_open_interval a b) c --> has_real_derivative f (f1 x) (atreal x) & has_real_derivative g (g1 x) (atreal x)) --> has_real_integral (%x. f x * g1 x) (f b * g b - f a * g a - y) (real_closed_interval a b) --> has_real_integral (%x. f1 x * g x) y (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] a ≤ b
    #[2] countable c
    #[3] real_continuous_on (λx. f x * g x) (real_closed_interval a b)
    #[4] ∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)
    #[5] has_real_integral (λx. f x * g1 x) (f b * g b - f a * g a - y) (real_closed_interval a b)
    #[6] has_real_integral (λx. f1 x * g x) y (real_closed_interval a b)
  -> apply_forward_step real_fundamental_theorem_of_calculus_interior_strong param_f1="(λx. f x * g1 x + f1 x * g x) " goal=6 facts=[2,1,3]
    #[7] (∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative (λx1. f x1 * g x1) (f x * g1 x + f1 x * g x) (atreal x)) ⟶ has_real_integral (λx. f x * g1 x + f1 x * g x) (f b * g b - f a * g a) (real_closed_interval a b)
  cut "has_real_integral (λx. f x * g1 x + f1 x * g x) (f b * g b - f a * g a) (real_closed_interval a b)" goal=6
    #[8] has_real_integral (λx. f x * g1 x + f1 x * g x) (f b * g b - f a * g a) (real_closed_interval a b)
  ← apply_prev goal=8 facts=[7]
    #[9] ∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative (λx1. f x1 * g x1) (f x * g1 x + f1 x * g x) (atreal x)
  ← introduction x goal=9
    #[10] _VAR x
    #[11] x ∈ diff (real_open_interval a b) c
    #[12] has_real_derivative (λx1. f x1 * g x1) (f x * g1 x + f1 x * g x) (atreal x)
  ← apply_backward_step has_real_derivative_mul_atreal goal=12
    #[13] has_real_derivative f (f1 x) (atreal x)
    #[14] has_real_derivative g (g1 x) (atreal x)
  -> apply_fact goal=13 facts=[4,11]
    #[15] has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)
  ← apply_backward_step conjD1 goal=13 facts=[15]
    #[16] has_real_derivative f (f1 x) (atreal x)
  ← apply_backward_step conjD2 goal=14 facts=[15]
    #[17] has_real_derivative g (g1 x) (atreal x)
  -> apply_forward_step has_real_integral_sub goal=6 facts=[8,5]
    #[18] has_real_integral (λx. f x * g1 x + f1 x * g x - f x * g1 x) (f b * g b - f a * g a - (f b * g b - f a * g a - y)) (real_closed_interval a b)
  cut "(λx. f x * g1 x + f1 x * g x - f x * g1 x) = (λx. f1 x * g x)" goal=6 facts=[18]
    #[19] (λx. f x * g1 x + f1 x * g x - f x * g1 x) = (λx. f1 x * g x)
  ← apply_backward_step extension goal=19
    #[20] ∀x. f x * g1 x + f1 x * g x - f x * g1 x = f1 x * g x
  ← z3 goal=20
    #[21] ∀x. f x * g1 x + f1 x * g x - f x * g1 x = f1 x * g x
  cut "f b * g b - f a * g a - (f b * g b - f a * g a - y) = y" goal=6
    #[22] f b * g b - f a * g a - (f b * g b - f a * g a - y) = y
  real_norm goal=22
    #[23] f b * g b - f a * g a - (f b * g b - f a * g a - y) = y
  -> rewrite_fact_with_prev goal=6 facts=[19,18]
    #[24] has_real_integral (λx. f1 x * g x) (f b * g b - f a * g a - (f b * g b - f a * g a - y)) (real_closed_interval a b)
  -> rewrite_fact_with_prev goal=6 facts=[23,24]
qed

theorem real_integration_by_parts_simple
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real, g :: real => real, g1 :: real => real, y :: real
  prop a <= b --> (!x. x Mem real_closed_interval a b --> has_real_derivative f (f1 x) (within (atreal x) (real_closed_interval a b)) & has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b))) --> has_real_integral (%x. f x * g1 x) (f b * g b - f a * g a - y) (real_closed_interval a b) --> has_real_integral (%x. f1 x * g x) y (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]

theorem real_integration_by_parts_simple_evalat
  fixes a :: real, b :: real, u :: real => real, v :: real => real
  prop a <= b --> (!x. x Mem real_open_interval a b --> real_differentiable u (atreal x) & real_differentiable v (atreal x)) --> real_integral (real_closed_interval a b) (%x. u x * real_derivative v x) = evalat (%x. u x * v x) a b - real_integral (real_closed_interval a b) (%x. real_derivative u x * v x)

theorem real_integrable_by_parts
  fixes a :: real, b :: real, c :: real set, f :: real => real, f1 :: real => real, g :: real => real, g1 :: real => real
  prop countable c --> real_continuous_on (%x. f x * g x) (real_closed_interval a b) --> (!x. x Mem diff (real_open_interval a b) c --> has_real_derivative f (f1 x) (atreal x) & has_real_derivative g (g1 x) (atreal x)) --> real_integrable_on (%x. f x * g1 x) (real_closed_interval a b) --> real_integrable_on (%x. f1 x * g x) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] countable c
    #[2] real_continuous_on (λx. f x * g x) (real_closed_interval a b)
    #[3] ∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)
    #[4] real_integrable_on (λx. f x * g1 x) (real_closed_interval a b)
    #[5] real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  cut "a <= b | b <= a" goal=5
    #[6] a ≤ b ∨ b ≤ a
  ← apply_backward_step real_le_total goal=6
    #[7] a ≤ b ∨ b ≤ a
  ← apply_backward_step disjE goal=5 facts=[7]
    #[8] a ≤ b ⟶ real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
    #[9] b ≤ a ⟶ real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  ← introduction goal=8
    #[10] a ≤ b
    #[11] real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  ← rewrite_goal real_integrable_on_def sym=false goal=11
    #[12] ∃y. has_real_integral (λx. f1 x * g x) y (real_closed_interval a b)
  -> rewrite_fact real_integrable_on_def sym=false goal=12 facts=[4]
    #[13] ∃y. has_real_integral (λx. f x * g1 x) y (real_closed_interval a b)
  exists_elim y goal=12 facts=[13]
    #[14] _VAR y
    #[15] has_real_integral (λx. f x * g1 x) y (real_closed_interval a b)
    #[16] ∃y. has_real_integral (λx. f1 x * g x) y (real_closed_interval a b)
    #[17] real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  ← inst_exists_goal "(f b * g b - f a * g a - y)" goal=16
    #[18] has_real_integral (λx. f1 x * g x) (f b * g b - f a * g a - y) (real_closed_interval a b)
  ← apply_backward_step real_integration_by_parts goal=18 facts=[10,1,2,3]
    #[19] has_real_integral (λx. f x * g1 x) (f b * g b - f a * g a - (f b * g b - f a * g a - y)) (real_closed_interval a b)
  cut "f b * g b - f a * g a - (f b * g b - f a * g a - y) = y" goal=19
    #[20] f b * g b - f a * g a - (f b * g b - f a * g a - y) = y
  real_norm goal=20
    #[21] f b * g b - f a * g a - (f b * g b - f a * g a - y) = y
  ← rewrite_goal_with_prev goal=19 facts=[21]
  ← introduction goal=9
    #[22] b ≤ a
    #[23] real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  ← apply_backward_step real_integrable_on_null goal=23
qed

theorem real_integrable_by_parts_eq
  fixes a :: real, b :: real, c :: real set, f :: real => real, f1 :: real => real, g :: real => real, g1 :: real => real
  prop countable c --> real_continuous_on (%x. f x * g x) (real_closed_interval a b) --> (!x. x Mem diff (real_open_interval a b) c --> has_real_derivative f (f1 x) (atreal x) & has_real_derivative g (g1 x) (atreal x)) --> real_integrable_on (%x. f x * g1 x) (real_closed_interval a b) <--> real_integrable_on (%x. f1 x * g x) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] countable c
    #[2] real_continuous_on (λx. f x * g x) (real_closed_interval a b)
    #[3] ∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative f (f1 x) (atreal x) ∧ has_real_derivative g (g1 x) (atreal x)
    #[4] real_integrable_on (λx. f x * g1 x) (real_closed_interval a b) ⟷ real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  ← apply_backward_step iffI goal=4
    #[5] real_integrable_on (λx. f x * g1 x) (real_closed_interval a b) ⟶ real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
    #[6] real_integrable_on (λx. f1 x * g x) (real_closed_interval a b) ⟶ real_integrable_on (λx. f x * g1 x) (real_closed_interval a b)
  ← introduction goal=5
    #[7] real_integrable_on (λx. f x * g1 x) (real_closed_interval a b)
    #[8] real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
  ← apply_backward_step real_integrable_by_parts goal=8 facts=[1,2,3,7]
  ← introduction goal=6
    #[9] real_integrable_on (λx. f1 x * g x) (real_closed_interval a b)
    #[10] real_integrable_on (λx. f x * g1 x) (real_closed_interval a b)
  ← rewrite_goal real_mult_comm sym=false goal=10
    #[11] real_integrable_on (λx. g1 x * f x) (real_closed_interval a b)
  -> rewrite_fact real_mult_comm sym=false goal=11 facts=[2]
    #[12] real_continuous_on (λx. g x * f x) (real_closed_interval a b)
  -> rewrite_fact real_mult_comm sym=false goal=11 facts=[9]
    #[13] real_integrable_on (λx. g x * f1 x) (real_closed_interval a b)
  -> rewrite_fact conj_comm sym=false goal=11 facts=[3]
    #[14] ∀x. x ∈ diff (real_open_interval a b) c ⟶ has_real_derivative g (g1 x) (atreal x) ∧ has_real_derivative f (f1 x) (atreal x)
  ← apply_backward_step real_integrable_by_parts goal=11 facts=[1,12,14,13]
qed

theorem absolute_real_integration_by_parts
  fixes a :: real, b :: real, f :: real => real, f1 :: real => real, g :: real => real, g1 :: real => real
  prop a <= b --> absolutely_real_integrable_on f1 (real_closed_interval a b) --> absolutely_real_integrable_on g1 (real_closed_interval a b) --> (!x. x Mem real_closed_interval a b --> has_real_integral f1 (f x) (real_closed_interval a x)) --> (!x. x Mem real_closed_interval a b --> has_real_integral g1 (g x) (real_closed_interval a x)) --> absolutely_real_integrable_on (%x. f x * g1 x) (real_closed_interval a b) & absolutely_real_integrable_on (%x. f1 x * g x) (real_closed_interval a b) & real_integral (real_closed_interval a b) (%x. f x * g1 x) + real_integral (real_closed_interval a b) (%x. f1 x * g x) = f b * g b - f a * g a
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_integral_substitution_strong
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, g :: real => real, g1 :: real => real, k :: real set
  prop countable k --> real_integrable_on f (real_closed_interval c d) --> real_continuous_on g (real_closed_interval a b) --> image g (real_closed_interval a b) Sub real_closed_interval c d --> (!x. x Mem diff (real_closed_interval a b) k --> has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b)) & real_continuous f (within (atreal (g x)) (real_closed_interval c d))) --> a <= b --> c <= d --> g a <= g b --> has_real_integral (%x. f (g x) * g1 x) (real_integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_integral_substitution
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, g :: real => real, g1 :: real => real, k :: real set
  prop countable k --> real_continuous_on f (real_closed_interval c d) --> real_continuous_on g (real_closed_interval a b) --> image g (real_closed_interval a b) Sub real_closed_interval c d --> (!x. x Mem diff (real_closed_interval a b) k --> has_real_derivative g (g1 x) (atreal x)) --> a <= b --> c <= d --> g a <= g b --> has_real_integral (%x. f (g x) * g1 x) (real_integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]

theorem real_integral_substitution
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, g :: real => real, g1 :: real => real, k :: real set
  prop countable k --> real_continuous_on f (real_closed_interval c d) --> real_continuous_on g (real_closed_interval a b) --> image g (real_closed_interval a b) Sub real_closed_interval c d --> (!x. x Mem diff (real_closed_interval a b) k --> has_real_derivative g (g1 x) (atreal x)) --> a <= b --> c <= d --> g a <= g b --> real_integral (real_closed_interval a b) (%x. f (g x) * g1 x) = real_integral (real_closed_interval (g a) (g b)) f
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] countable k
    #[2] real_continuous_on f (real_closed_interval c d)
    #[3] real_continuous_on g (real_closed_interval a b)
    #[4] image g (real_closed_interval a b) ⊆ real_closed_interval c d
    #[5] ∀x. x ∈ diff (real_closed_interval a b) k ⟶ has_real_derivative g (g1 x) (atreal x)
    #[6] a ≤ b
    #[7] c ≤ d
    #[8] g a ≤ g b
    #[9] real_integral (real_closed_interval a b) (λx. f (g x) * g1 x) = real_integral (real_closed_interval (g a) (g b)) f
  ← apply_backward_step real_integral_unique goal=9
    #[10] has_real_integral (λx. f (g x) * g1 x) (real_integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)
  ← apply_backward_step has_real_integral_substitution goal=10 facts=[1,2,3]
qed

theorem has_real_integral_substitution_simple
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, g :: real => real, g1 :: real => real
  prop real_continuous_on f (real_closed_interval c d) --> (!x. x Mem real_closed_interval a b --> has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b))) --> image g (real_closed_interval a b) Sub real_closed_interval c d --> a <= b --> c <= d --> g a <= g b --> has_real_integral (%x. f (g x) * g1 x) (real_integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)
  [hint_backward,hint_backward1,hint_forward]

theorem real_integral_substitution_simple
  fixes a :: real, b :: real, c :: real, d :: real, f :: real => real, g :: real => real, g1 :: real => real
  prop real_continuous_on f (real_closed_interval c d) --> (!x. x Mem real_closed_interval a b --> has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b))) --> image g (real_closed_interval a b) Sub real_closed_interval c d --> a <= b --> c <= d --> g a <= g b --> real_integral (real_closed_interval a b) (%x. f (g x) * g1 x) = real_integral (real_closed_interval (g a) (g b)) f
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_continuous_on f (real_closed_interval c d)
    #[2] ∀x. x ∈ real_closed_interval a b ⟶ has_real_derivative g (g1 x) (within (atreal x) (real_closed_interval a b))
    #[3] image g (real_closed_interval a b) ⊆ real_closed_interval c d
    #[4] a ≤ b
    #[5] c ≤ d
    #[6] g a ≤ g b
    #[7] real_integral (real_closed_interval a b) (λx. f (g x) * g1 x) = real_integral (real_closed_interval (g a) (g b)) f
  ← apply_backward_step real_integral_unique goal=7
    #[8] has_real_integral (λx. f (g x) * g1 x) (real_integral (real_closed_interval (g a) (g b)) f) (real_closed_interval a b)
  ← apply_backward_step has_real_integral_substitution_simple goal=8 facts=[1,2]
qed

theorem real_integral_substitution_simple_incr
  fixes a :: real, b :: real, f :: real => real, g :: real => real
  prop real_continuous_on f (real_closed_interval (g a) (g b)) --> (!x. x Mem real_open_interval a b --> real_differentiable g (atreal x) & real_derivative g x >= 0) --> a <= b --> real_integral (real_closed_interval a b) (%x. f (g x) * real_derivative g x) = real_integral (real_closed_interval (g a) (g b)) f

theorem real_integral_substitution_simple_decr
  fixes a :: real, b :: real, f :: real => real, g :: real => real
  prop real_continuous_on f (real_closed_interval (g a) (g b)) --> (!x. x Mem real_open_interval a b --> real_differentiable g (atreal x) & real_derivative g x <= 0) --> a <= b --> real_integral (real_closed_interval a b) (%x. f (g x) * real_derivative g x) = real_integral (real_closed_interval (g b) (g a)) (%x. -(f x))

theorem real_monotone_convergence_increasing_ae
  fixes f :: nat => real => real, g :: real => real, s :: real set
  prop (!k. real_integrable_on (f k) s) --> (!k. !x. x Mem s --> f k x <= f (Suc k) x) --> (?t. real_negligible t & (!x. x Mem diff s t --> tendsto_real (%k. f k x) (g x) sequentially)) --> real_bounded ({y. ?k. y = real_integral s (f k)}) --> real_integrable_on g s & tendsto_real (%k. real_integral s (f k)) (real_integral s g) sequentially
  [hint_backward,hint_backward1]

theorem real_open_set_rational
  fixes s :: real set
  prop real_open s --> ~(s = {}) --> (?x. rational x & x Mem s)
  [hint_backward,hint_backward1]

theorem real_open_rational
  fixes P :: real => bool
  prop real_open ({x. P x}) --> (?x. P x) --> (?x. rational x & P x)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] real_open ({x. P x})
    #[2] ∃x. P x
    #[3] ∃x. rational x ∧ P x
  -> apply_forward_step real_open_set_rational goal=3 facts=[1]
    #[4] ¬({x. P x} = ∅) ⟶ (∃x. rational x ∧ x ∈ {x1. P x1})
  -> rewrite_fact member_collect sym=false goal=3 facts=[4]
    #[5] ¬({x. P x} = ∅) ⟶ (∃x. rational x ∧ P x)
  ← apply_prev goal=3 facts=[5]
    #[6] ¬({x. P x} = ∅)
  ← z3 goal=6 facts=[2]
    #[7] ¬({x. P x} = ∅)
qed

theorem real_open_set_exists_rational
  fixes s :: real set
  prop real_open s --> (?x. rational x & x Mem s) <--> (?x. x Mem s)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] real_open s
    #[2] (∃x. rational x ∧ x ∈ s) ⟷ (∃x. x ∈ s)
  ← apply_backward_step iffI goal=2
    #[3] (∃x. rational x ∧ x ∈ s) ⟶ (∃x. x ∈ s)
    #[4] (∃x. x ∈ s) ⟶ (∃x. rational x ∧ x ∈ s)
  ← introduction goal=3
    #[5] ∃x. rational x ∧ x ∈ s
    #[6] ∃x. x ∈ s
  exists_elim x goal=6 facts=[5]
    #[7] _VAR x
    #[8] rational x ∧ x ∈ s
    #[9] ∃x. x ∈ s
  -> apply_forward_step conjD2 goal=9 facts=[8]
    #[10] x ∈ s
  ← apply_backward_step exI goal=9 facts=[10]
    #[11] ∃x. x ∈ s
  ← introduction goal=4
    #[12] ∃x. x ∈ s
    #[13] ∃x. rational x ∧ x ∈ s
  ← apply_backward_step real_open_set_rational goal=13
    #[14] ¬(s = ∅)
  ← z3 goal=14 facts=[12]
    #[15] ¬(s = ∅)
qed

theorem real_open_exists_rational
  fixes P :: real => bool
  prop real_open ({x. P x}) --> (?x. rational x & P x) <--> (?x. P x)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] real_open ({x. P x})
    #[2] (∃x. rational x ∧ P x) ⟷ (∃x. P x)
  -> apply_forward_step real_open_set_exists_rational goal=2 facts=[1]
    #[3] (∃x. rational x ∧ x ∈ {x1. P x1}) ⟷ (∃x. x ∈ {x1. P x1})
  -> rewrite_fact member_collect sym=false goal=2 facts=[3]
qed

theorem real_continuous_on_const_dyadic_rationals
  fixes a :: real, f :: real => real
  prop real_continuous_on f univ --> (!x. integer x --> f x = a) --> (!x. f x = a --> f (x / 2) = a) --> (!x. f x = a)
  [hint_backward,hint_backward1]

theorem real_continuous_additive_imp_linear
  fixes f :: real => real
  prop real_continuous_on f univ --> (!x. !y. f (x + y) = f x + f y) --> (!a. !x. f (a * x) = a * f x)
  [hint_backward,hint_backward1]

theorem real_continuous_floor
  fixes x :: real
  prop ~(integer x) --> real_continuous floor (atreal x)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ¬(integer x)
    #[2] real_continuous floor (atreal x)
  ← rewrite_goal real_continuous_atreal1 sym=false goal=2
    #[3] ∀e. 0 < e ⟶ (∃d. 0 < d ∧ (∀x1. abs (x1 - x) < d ⟶ abs (floor x1 - floor x) < e))
  ← introduction e goal=3
    #[4] _VAR e
    #[5] 0 < e
    #[6] ∃d. 0 < d ∧ (∀x1. abs (x1 - x) < d ⟶ abs (floor x1 - floor x) < e)
  ← inst_exists_goal "min (x - floor x) ((floor x + 1) - x)" goal=6
    #[7] 0 < min (x - floor x) (floor x + 1 - x) ∧ (∀x1. abs (x1 - x) < min (x - floor x) (floor x + 1 - x) ⟶ abs (floor x1 - floor x) < e)
  ← apply_backward_step conjI goal=7
    #[8] 0 < min (x - floor x) (floor x + 1 - x)
    #[9] ∀x1. abs (x1 - x) < min (x - floor x) (floor x + 1 - x) ⟶ abs (floor x1 - floor x) < e
  ← rewrite_goal real_lt_min sym=false goal=8
    #[10] 0 < x - floor x ∧ 0 < floor x + 1 - x
  ← apply_backward_step conjI goal=10
    #[11] 0 < x - floor x
    #[12] 0 < floor x + 1 - x
  ← rewrite_goal real_sub_lt sym=false goal=11
    #[13] floor x < x
  ← rewrite_goal real_floor_lt_refl sym=false goal=13
  -> apply_forward_step floor param_x=x goal=12
    #[14] integer (floor x) ∧ floor x ≤ x ∧ x < floor x + 1
  ← rewrite_goal real_sub_lt sym=false goal=12
    #[15] x < floor x + 1
  -> apply_forward_step conjD2 goal=15 facts=[14]
    #[16] floor x ≤ x ∧ x < floor x + 1
  ← apply_backward_step conjD2 goal=15 facts=[16]
    #[17] x < floor x + 1
  ← introduction x1 goal=9
    #[18] _VAR x1
    #[19] abs (x1 - x) < min (x - floor x) (floor x + 1 - x)
    #[20] abs (floor x1 - floor x) < e
  cut "!x. !y. x = y --> abs (x-y) < e" goal=20
    #[21] ∀x. ∀y. x = y ⟶ abs (x - y) < e
  ← z3 goal=21 facts=[5]
    #[22] ∀x. ∀y. x = y ⟶ abs (x - y) < e
  ← apply_prev goal=20 facts=[22]
    #[23] floor x1 = floor x
  ← rewrite_goal floor_unique sym=true goal=23
    #[24] integer (floor x) ∧ floor x ≤ x1 ∧ x1 < floor x + 1
  ← apply_backward_step conjI goal=24
    #[25] integer (floor x)
    #[26] floor x ≤ x1 ∧ x1 < floor x + 1
  ← apply_backward_step conjD1 goal=25 facts=[14]
    #[27] integer (floor x)
  ← apply_backward_step conjI goal=26
    #[28] floor x ≤ x1
    #[29] x1 < floor x + 1
  -> rewrite_fact real_lt_min sym=false goal=28 facts=[19]
    #[30] abs (x1 - x) < x - floor x ∧ abs (x1 - x) < floor x + 1 - x
  -> apply_forward_step conjD1 goal=28 facts=[30]
    #[31] abs (x1 - x) < x - floor x
  cut "!y. abs(x1 -x) < x - y --> y <= x1" goal=28
    #[32] ∀y. abs (x1 - x) < x - y ⟶ y ≤ x1
  ← z3 goal=32
    #[33] ∀y. abs (x1 - x) < x - y ⟶ y ≤ x1
  ← apply_prev goal=28 facts=[33]
  -> apply_forward_step conjD2 goal=29 facts=[30]
    #[34] abs (x1 - x) < floor x + 1 - x
  cut "∀y. abs (x1 - x) < y+1 - x ⟶ x1 < y + 1" goal=29
    #[35] ∀y. abs (x1 - x) < y + 1 - x ⟶ x1 < y + 1
  ← z3 goal=35
    #[36] ∀y. abs (x1 - x) < y + 1 - x ⟶ x1 < y + 1
  ← apply_prev goal=29 facts=[36]
qed

