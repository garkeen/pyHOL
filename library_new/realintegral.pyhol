theorem has_real_measure_diff_real_negligible_eq
  fixes m :: real, s :: real set, t :: real set
  prop real_negligible t --> has_real_measure (diff s t) m <--> has_real_measure s m
  [hint_backward,hint_forward]

theorem has_real_measure_almost
  fixes m :: real, s :: real set, s1 :: real set, t :: real set
  prop has_real_measure s m --> real_negligible t --> s Un t = s1 Un t --> has_real_measure s1 m
  [hint_backward,hint_backward1,hint_forward]

theorem has_real_measure_almost_eq
  fixes m :: real, s :: real set, s1 :: real set, t :: real set
  prop real_negligible t --> s Un t = s1 Un t --> has_real_measure s m <--> has_real_measure s1 m
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_negligible t
    #[2] s ∪ t = s1 ∪ t
    #[3] has_real_measure s m ⟷ has_real_measure s1 m
  ← apply_backward_step iffI goal=3
    #[4] has_real_measure s m ⟶ has_real_measure s1 m
    #[5] has_real_measure s1 m ⟶ has_real_measure s m
  ← introduction goal=4
    #[6] has_real_measure s m
    #[7] has_real_measure s1 m
  ← apply_backward_step has_real_measure_almost param_s=s param_t=t goal=7
  ← introduction goal=5
    #[8] has_real_measure s1 m
    #[9] has_real_measure s m
  ← apply_backward_step has_real_measure_almost param_s=s1 param_t=t goal=9
    #[10] s1 ∪ t = s ∪ t
  ← rewrite_goal_with_prev goal=10 facts=[2]
    #[11] s1 ∪ t = s ∪ t
qed

theorem real_measurable_almost
  fixes s :: real set, s1 :: real set, t :: real set
  prop real_measurable s --> real_negligible t --> s Un t = s1 Un t --> real_measurable s1
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_negligible t
    #[3] s ∪ t = s1 ∪ t
    #[4] real_measurable s1
  ← rewrite_goal real_measurable_def sym=false goal=4
    #[5] ∃m. has_real_measure s1 m
  -> rewrite_fact real_measurable_def sym=false goal=5 facts=[1]
    #[6] ∃m. has_real_measure s m
  exists_elim m goal=5 facts=[6]
    #[7] _VAR m
    #[8] has_real_measure s m
    #[9] ∃m. has_real_measure s1 m
    #[10] real_measurable s1
  ← inst_exists_goal m goal=9
    #[11] has_real_measure s1 m
  ← apply_backward_step has_real_measure_almost param_s=s param_t=t goal=11
qed

theorem has_real_measure_real_negligible_union
  fixes m1 :: real, m2 :: real, s1 :: real set, s2 :: real set
  prop has_real_measure s1 m1 --> has_real_measure s2 m2 --> real_negligible (s1 Int s2) --> has_real_measure (s1 Un s2) (m1 + m2)
  [hint_backward,hint_backward1,hint_forward]

theorem real_measure_real_negligible_union
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_measurable t --> real_negligible (s Int t) --> real_measure (s Un t) = real_measure s + real_measure t
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measurable t
    #[3] real_negligible (s ∩ t)
    #[4] real_measure (s ∪ t) = real_measure s + real_measure t
  ← apply_backward_step real_measure_unique goal=4
    #[5] has_real_measure (s ∪ t) (real_measure s + real_measure t)
  ← apply_backward_step has_real_measure_real_negligible_union goal=5
    #[6] has_real_measure s (real_measure s)
    #[7] has_real_measure t (real_measure t)
  -> rewrite_fact has_real_measure_mesure sym=false goal=6 facts=[1]
    #[8] has_real_measure s (real_measure s)
  -> rewrite_fact has_real_measure_mesure sym=false goal=7 facts=[2]
    #[9] has_real_measure t (real_measure t)
qed

theorem has_real_measure_real_negligible_symdiff
  fixes m :: real, s :: real set, t :: real set
  prop has_real_measure s m --> real_negligible (diff s t Un diff t s) --> has_real_measure t m
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] has_real_measure s m
    #[2] real_negligible (diff s t ∪ diff t s)
    #[3] has_real_measure t m
  ← apply_backward_step has_real_measure_almost goal=3 facts=[1,2]
    #[4] s ∪ (diff s t ∪ diff t s) = t ∪ (diff s t ∪ diff t s)
  ← z3 goal=4
    #[5] s ∪ (diff s t ∪ diff t s) = t ∪ (diff s t ∪ diff t s)
qed

theorem real_measurable_real_negligible_symdiff
  fixes s :: real set, t :: real set
  prop real_measurable s --> real_negligible (diff s t Un diff t s) --> real_measurable t
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_negligible (diff s t ∪ diff t s)
    #[3] real_measurable t
  ← rewrite_goal real_measurable_def sym=false goal=3
    #[4] ∃m. has_real_measure t m
  -> rewrite_fact real_measurable_def sym=false goal=4 facts=[1]
    #[5] ∃m. has_real_measure s m
  exists_elim m goal=4 facts=[5]
    #[6] _VAR m
    #[7] has_real_measure s m
    #[8] ∃m. has_real_measure t m
    #[9] real_measurable t
  ← inst_exists_goal m goal=8
    #[10] has_real_measure t m
  ← apply_backward_step has_real_measure_real_negligible_symdiff goal=10 facts=[7,2]
    #[11] has_real_measure t m
qed

theorem real_measure_real_negligible_symdiff
  fixes s :: real set, t :: real set
  prop real_measurable s | real_measurable t --> real_negligible (diff s t Un diff t s) --> real_measure s = real_measure t
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s ∨ real_measurable t
    #[2] real_negligible (diff s t ∪ diff t s)
    #[3] real_measure s = real_measure t
  ← apply_backward_step disjE goal=3 facts=[1]
    #[4] real_measurable s ⟶ real_measure s = real_measure t
    #[5] real_measurable t ⟶ real_measure s = real_measure t
  ← introduction goal=4
    #[6] real_measurable s
    #[7] real_measure s = real_measure t
  ← apply_backward_step real_measure_unique goal=7
    #[8] has_real_measure s (real_measure t)
  ← apply_backward_step has_real_measure_real_negligible_symdiff param_s=t goal=8
    #[9] has_real_measure t (real_measure t)
    #[10] real_negligible (diff t s ∪ diff s t)
  -> apply_forward_step real_measurable_real_negligible_symdiff goal=9 facts=[6,2]
    #[11] real_measurable t
  -> rewrite_fact has_real_measure_mesure sym=false goal=9 facts=[11]
    #[12] has_real_measure t (real_measure t)
  ← rewrite_goal union_comm sym=false goal=10
  ← introduction goal=5
    #[13] real_measurable t
    #[14] real_measure s = real_measure t
  ← apply_backward_step real_measure_unique goal=14
    #[15] has_real_measure s (real_measure t)
  ← apply_backward_step has_real_measure_real_negligible_symdiff param_s=t goal=15
    #[16] has_real_measure t (real_measure t)
    #[17] real_negligible (diff t s ∪ diff s t)
  -> rewrite_fact has_real_measure_mesure sym=false goal=16 facts=[13]
    #[18] has_real_measure t (real_measure t)
  ← rewrite_goal union_comm sym=false goal=17
qed

theorem has_real_measure_real_negligible_unions
  fixes f :: real set set, m :: real set => real
  prop finite f --> (!s. s Mem f --> has_real_measure s (m s)) --> (!s. !t. s Mem f --> t Mem f --> ~(s = t) --> real_negligible (s Int t)) --> has_real_measure (UN f) (sum f m)
  [hint_backward,hint_backward1,hint_forward]

theorem real_measure_real_negligible_unions
  fixes f :: real set set, m :: real set => real
  prop finite f --> (!s. s Mem f --> has_real_measure s (m s)) --> (!s. !t. s Mem f --> t Mem f --> ~(s = t) --> real_negligible (s Int t)) --> real_measure (UN f) = sum f m
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] finite f
    #[2] ∀s. s ∈ f ⟶ has_real_measure s (m s)
    #[3] ∀s. ∀t. s ∈ f ⟶ t ∈ f ⟶ ¬(s = t) ⟶ real_negligible (s ∩ t)
    #[4] real_measure (⋃f) = sum f m
  ← apply_backward_step real_measure_unique goal=4
    #[5] has_real_measure (⋃f) (sum f m)
  ← apply_backward_step has_real_measure_real_negligible_unions goal=5 facts=[1,2,3]
qed

theorem has_real_measure_disjoint_unions
  fixes f :: real set set, m :: real set => real
  prop finite f --> (!s. s Mem f --> has_real_measure s (m s)) --> (!s. !t. s Mem f --> t Mem f --> ~(s = t) --> disjoint s t) --> has_real_measure (UN f) (sum f m)
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] finite f
    #[2] ∀s. s ∈ f ⟶ has_real_measure s (m s)
    #[3] ∀s. ∀t. s ∈ f ⟶ t ∈ f ⟶ ¬(s = t) ⟶ disjoint s t
    #[4] has_real_measure (⋃f) (sum f m)
  -> rewrite_fact disjoint_def sym=false goal=4 facts=[3]
    #[5] ∀s. ∀t. s ∈ f ⟶ t ∈ f ⟶ ¬(s = t) ⟶ s ∩ t = ∅
  ← apply_backward_step has_real_measure_real_negligible_unions goal=4 facts=[1,2]
    #[6] ∀s. ∀t. s ∈ f ⟶ t ∈ f ⟶ ¬(s = t) ⟶ real_negligible (s ∩ t)
  ← introduction s,t goal=6
    #[7] _VAR s
    #[8] _VAR t
    #[9] s ∈ f
    #[10] t ∈ f
    #[11] ¬(s = t)
    #[12] real_negligible (s ∩ t)
  -> apply_fact goal=12 facts=[5,9,10,11]
    #[13] s ∩ t = ∅
  ← rewrite_goal_with_prev goal=12 facts=[13]
    #[14] real_negligible ∅
  ← apply_backward_step real_negligible_empty goal=14
    #[15] real_negligible ∅
qed

theorem real_measure_disjoint_unions
  fixes f :: real set set, m :: real set => real
  prop finite f --> (!s. s Mem f --> has_real_measure s (m s)) --> (!s. !t. s Mem f --> t Mem f --> ~(s = t) --> disjoint s t) --> real_measure (UN f) = sum f m
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] finite f
    #[2] ∀s. s ∈ f ⟶ has_real_measure s (m s)
    #[3] ∀s. ∀t. s ∈ f ⟶ t ∈ f ⟶ ¬(s = t) ⟶ disjoint s t
    #[4] real_measure (⋃f) = sum f m
  ← apply_backward_step real_measure_unique goal=4
    #[5] has_real_measure (⋃f) (sum f m)
  ← apply_backward_step has_real_measure_disjoint_unions goal=5 facts=[1,2,3]
qed

theorem has_real_measure_real_negligible_unions_image
  fixes f :: 'a => real set, s :: 'a set
  prop finite s --> (!x. x Mem s --> real_measurable (f x)) --> (!x. !y. x Mem s --> y Mem s --> ~(x = y) --> real_negligible (f x Int f y)) --> has_real_measure (UN (image f s)) (sum s (%x. real_measure (f x)))
  [hint_backward,hint_backward1,hint_forward]

theorem real_measure_real_negligible_unions_image
  fixes f :: 'a => real set, s :: 'a set
  prop finite s --> (!x. x Mem s --> real_measurable (f x)) --> (!x. !y. x Mem s --> y Mem s --> ~(x = y) --> real_negligible (f x Int f y)) --> real_measure (UN (image f s)) = sum s (%x. real_measure (f x))
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] finite s
    #[2] ∀x. x ∈ s ⟶ real_measurable (f x)
    #[3] ∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ real_negligible (f x ∩ f y)
    #[4] real_measure (⋃(image f s)) = sum s (λx. real_measure (f x))
  ← apply_backward_step real_measure_unique goal=4
    #[5] has_real_measure (⋃(image f s)) (sum s (λx. real_measure (f x)))
  ← apply_backward_step has_real_measure_real_negligible_unions_image goal=5 facts=[1,2,3]
qed

theorem has_real_measure_disjoint_unions_image
  fixes f :: 'a => real set, s :: 'a set
  prop finite s --> (!x. x Mem s --> real_measurable (f x)) --> (!x. !y. x Mem s --> y Mem s --> ~(x = y) --> disjoint (f x) (f y)) --> has_real_measure (UN (image f s)) (sum s (%x. real_measure (f x)))
  [hint_backward,hint_backward1,hint_forward]
proof
  ← introduction goal=0
    #[1] finite s
    #[2] ∀x. x ∈ s ⟶ real_measurable (f x)
    #[3] ∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ disjoint (f x) (f y)
    #[4] has_real_measure (⋃(image f s)) (sum s (λx. real_measure (f x)))
  ← apply_backward_step has_real_measure_real_negligible_unions_image goal=4 facts=[1,2]
    #[5] ∀x. ∀y. x ∈ s ⟶ y ∈ s ⟶ ¬(x = y) ⟶ real_negligible (f x ∩ f y)
  ← introduction x,y goal=5
    #[6] _VAR x
    #[7] _VAR y
    #[8] x ∈ s
    #[9] y ∈ s
    #[10] ¬(x = y)
    #[11] real_negligible (f x ∩ f y)
  -> apply_fact goal=11 facts=[3,8,9,10]
    #[12] disjoint (f x) (f y)
  -> rewrite_fact disjoint_def sym=false goal=11 facts=[12]
    #[13] f x ∩ f y = ∅
  ← rewrite_goal_with_prev goal=11 facts=[13]
    #[14] real_negligible ∅
  ← apply_backward_step real_negligible_empty goal=14
    #[15] real_negligible ∅
qed

theorem real_measure_disjoint_unions_image
  fixes f :: 'a => real set, s :: 'a set
  prop finite s --> (!x. x Mem s --> real_measurable (f x)) --> (!x. !y. x Mem s --> y Mem s --> ~(x = y) --> disjoint (f x) (f y)) --> real_measure (UN (image f s)) = sum s (%x. real_measure (f x))
