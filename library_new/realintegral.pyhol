  [hint_backward]
proof
  ← rewrite_goal real_measurable_def goal=0
    #[1] ∃m. has_real_measure ∅ m
  ← inst_exists_goal "(0::real)" goal=1
    #[2] has_real_measure ∅ 0
  ← apply_backward_step has_real_measure_empty goal=2
qed

theorem real_measurable_real_measure_eq_0
  fixes s :: real set
  prop real_measurable s --> real_measure s = 0 <--> real_negligible s
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] real_measure s = 0 ⟷ real_negligible s
  cut "real_negligible s <--> has_real_measure s 0" goal=2
    #[3] real_negligible s ⟷ has_real_measure s 0
  ← rewrite_goal has_real_measure_0 goal=3
    #[4] real_negligible s ⟷ has_real_measure s 0
  ← rewrite_goal_with_prev goal=2 facts=[4]
    #[5] real_measure s = 0 ⟷ has_real_measure s 0
  ← apply_backward_step iffI goal=5
    #[6] real_measure s = 0 ⟶ has_real_measure s 0
    #[7] has_real_measure s 0 ⟶ real_measure s = 0
  ← introduction goal=6
    #[8] real_measure s = 0
    #[9] has_real_measure s 0
  -> rewrite_fact has_real_measure_mesure goal=9 facts=[1]
    #[10] has_real_measure s (real_measure s)
  -> rewrite_fact_with_prev goal=9 facts=[8,10]
  ← introduction goal=7
    #[11] has_real_measure s 0
    #[12] real_measure s = 0
  ← apply_backward_step real_measure_unique goal=12
qed

theorem real_measurable_real_measure_pos_lt
  fixes s :: real set
  prop real_measurable s --> 0 < real_measure s <--> ~(real_negligible s)
  [hint_backward,hint_forward]
proof
  ← introduction goal=0
    #[1] real_measurable s
    #[2] 0 < real_measure s ⟷ ¬(real_negligible s)
  ← rewrite_goal real_lt_le goal=2
    #[3] 0 ≤ real_measure s ∧ ¬(0 = real_measure s) ⟷ ¬(real_negligible s)
  -> apply_forward_step real_measure_pos_le goal=3 facts=[1]
    #[4] 0 ≤ real_measure s
  ← apply_backward_step iffI goal=3
    #[5] 0 ≤ real_measure s ∧ ¬(0 = real_measure s) ⟶ ¬(real_negligible s)
    #[6] ¬(real_negligible s) ⟶ 0 ≤ real_measure s ∧ ¬(0 = real_measure s)
  ← introduction goal=5
    #[7] 0 ≤ real_measure s ∧ ¬(0 = real_measure s)
    #[8] ¬(real_negligible s)
  -> apply_forward_step real_measurable_real_measure_eq_0 goal=8 facts=[1]
    #[9] real_measure s = 0 ⟷ real_negligible s
  -> apply_forward_step conjD2 goal=8 facts=[7]
    #[10] ¬(0 = real_measure s)
  ← apply_backward_step negI goal=8
    #[11] real_negligible s ⟶ false
  ← introduction goal=11
    #[12] real_negligible s
    #[13] false
  ← apply_backward_step negE param_A="real_measure s = 0" goal=13
    #[14] ¬(real_measure s = 0)
    #[15] real_measure s = 0
  ← apply_backward_step ineq_sym goal=14
  ← rewrite_goal_with_prev goal=15 facts=[9]
  ← introduction goal=6
    #[16] ¬(real_negligible s)
    #[17] 0 ≤ real_measure s ∧ ¬(0 = real_measure s)
  ← apply_backward_step conjI goal=17
    #[18] ¬(0 = real_measure s)
  ← apply_backward_step ineq_sym goal=18
    #[19] ¬(real_measure s = 0)
  ← apply_backward_step contrapositive goal=19 facts=[16]
    #[20] ¬¬(real_measure s = 0) ⟶ ¬¬(real_negligible s)
  ← introduction goal=20
    #[21] ¬¬(real_measure s = 0)
    #[22] ¬¬(real_negligible s)
  ← rewrite_goal double_neg sym=false goal=22
    #[23] real_negligible s
  -> rewrite_fact double_neg sym=false goal=23 facts=[21]
    #[24] real_measure s = 0
  ← rewrite_goal has_real_measure_0 sym=true goal=23
    #[25] has_real_measure s 0
  ← rewrite_goal has_real_measure_real_measurable_real_measure sym=false goal=25
    #[26] real_measurable s ∧ real_measure s = 0
  ← apply_backward_step conjI goal=26
qed

