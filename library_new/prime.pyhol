  -> apply_fact goal=79 facts=[83,81]
    #[84] ∃k::nat. divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n))
  exists_elim a goal=79 facts=[84]
    #[85] _VAR a
    #[86] divides (p ^ a) n ∧ (∀l. a < l ⟶ ¬(divides (p ^ l) n))
