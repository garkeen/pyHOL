  exists_elim k goal=9 facts=[17]
    #[18] _VAR k
    #[19] divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n))
    #[20] ∃k::nat. ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
    #[21] ∃p. ∃k::nat. ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
  ← inst_exists_goal k goal=20
    #[22] ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
