    #[43] k = 0 ⟶ divides (p ^ k * p) n
  ← introduction goal=43
    #[44] k = 0
    #[45] divides (p ^ k * p) n
  ← rewrite_goal_with_prev goal=45 facts=[44]
    #[46] divides (p ^ (0::nat) * p) n
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=46
    #[47] divides (1 * p) n
  ← rewrite_goal mult_1_left sym=false goal=47
  ← apply_backward_step conjI goal=34
    #[48] coprime p m
