  ← rewrite_goal_with_prev goal=5 facts=[4]
    #[6] k ≤ index p 0 ⟷ ((0::nat) = 0 ∨ p = 1 ⟶ k = 0) ∧ ((0::nat) = 0 ∨ p = 1 ∨ k ≤ index p 0)
  ← rewrite_goal index_0 sym=false goal=6
    #[7] k ≤ 0 ⟷ ((0::nat) = 0 ∨ p = 1 ⟶ k = 0) ∧ ((0::nat) = 0 ∨ p = 1 ∨ k ≤ 0)
  ← apply_backward_step iffI goal=7
    #[8] k ≤ 0 ⟶ ((0::nat) = 0 ∨ p = 1 ⟶ k = 0) ∧ ((0::nat) = 0 ∨ p = 1 ∨ k ≤ 0)
