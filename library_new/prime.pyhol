  ← cases "n=0" goal=1
    #[2] n = 0 ⟶ k ≤ index p n ⟷ (n = 0 ∨ p = 1 ⟶ k = 0) ∧ (n = 0 ∨ p = 1 ∨ k ≤ index p n)
