theorem index_gcd
  fixes m :: nat, n :: nat, p :: nat
  prop prime p --> index p (gcd m n) = (if m = 0 then index p n else if n = 0 then index p m else min (index p m) (index p n))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] index p (gcd m n) = (if m = 0 then index p n else if n = 0 then index p m else min (index p m) (index p n))
  ← cases "m=0" goal=2
    #[3] m = 0 ⟶ index p (gcd m n) = (if m = 0 then index p n else if n = 0 then index p m else min (index p m) (index p n))
    #[4] ¬(m = 0) ⟶ index p (gcd m n) = (if m = 0 then index p n else if n = 0 then index p m else min (index p m) (index p n))
  ← introduction goal=3
    #[5] m = 0
    #[6] index p (gcd m n) = (if m = 0 then index p n else if n = 0 then index p m else min (index p m) (index p n))
  ← rewrite_goal if_P sym=false goal=6 facts=[5]
    #[7] index p (gcd m n) = index p n
  ← rewrite_goal_with_prev goal=7 facts=[5]
    #[8] index p (gcd 0 n) = index p n
  ← rewrite_goal gcd_zero_left sym=false goal=8
    #[9] index p (gcd 0 n) = index p n
  ← introduction goal=4
    #[10] ¬(m = 0)
    #[11] index p (gcd m n) = (if m = 0 then index p n else if n = 0 then index p m else min (index p m) (index p n))
  ← rewrite_goal if_not_P sym=false goal=11 facts=[10]
    #[12] index p (gcd m n) = (if n = 0 then index p m else min (index p m) (index p n))
  ← cases "n=0" goal=12
    #[13] n = 0 ⟶ index p (gcd m n) = (if n = 0 then index p m else min (index p m) (index p n))
    #[14] ¬(n = 0) ⟶ index p (gcd m n) = (if n = 0 then index p m else min (index p m) (index p n))
  ← introduction goal=13
    #[15] n = 0
    #[16] index p (gcd m n) = (if n = 0 then index p m else min (index p m) (index p n))
  ← rewrite_goal if_P sym=false goal=16 facts=[15]
    #[17] index p (gcd m n) = index p m
  ← rewrite_goal_with_prev goal=17 facts=[15]
    #[18] index p (gcd m 0) = index p m
  ← rewrite_goal gcd_zero_right sym=false goal=18
    #[19] index p (gcd m 0) = index p m
  ← introduction goal=14
    #[20] ¬(n = 0)
    #[21] index p (gcd m n) = (if n = 0 then index p m else min (index p m) (index p n))
  ← rewrite_goal if_not_P sym=false goal=21 facts=[20]
    #[22] index p (gcd m n) = min (index p m) (index p n)
  cut "∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n" goal=22
    #[23] ∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n
  ← z3 goal=23
    #[24] ∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n
  ← apply_prev goal=22 facts=[24]
    #[25] ∀k. k ≤ index p (gcd m n) ⟷ k ≤ min (index p m) (index p n)
  ← introduction k goal=25
    #[26] _VAR k
    #[27] k ≤ index p (gcd m n) ⟷ k ≤ min (index p m) (index p n)
  -> apply_forward_step divides_gcd param_a=m param_b=n param_d="p ^ k" goal=27
    #[28] divides (p ^ k) (gcd m n) ⟷ divides (p ^ k) m ∧ divides (p ^ k) n
  -> rewrite_fact primepow_divides_index sym=false goal=27 facts=[28]
    #[29] gcd m n = 0 ∨ p = 1 ∨ k ≤ index p (gcd m n) ⟷ (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∧ (n = 0 ∨ p = 1 ∨ k ≤ index p n)
  -> rewrite_fact prime_def sym=false goal=27 facts=[1]
    #[30] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD1 goal=27 facts=[30]
    #[31] ¬(p = 1)
  ← apply_backward_step iffI goal=27
    #[32] k ≤ index p (gcd m n) ⟶ k ≤ min (index p m) (index p n)
    #[33] k ≤ min (index p m) (index p n) ⟶ k ≤ index p (gcd m n)
