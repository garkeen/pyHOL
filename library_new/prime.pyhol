    #[29] ∃k::nat. ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
    #[30] ∃p. ∃k::nat. ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
  ← inst_exists_goal m goal=28
    #[31] prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
  ← apply_backward_step conjI goal=31
    #[32] 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
  ← apply_backward_step conjI goal=32
    #[33] 1 ≤ k
    #[34] coprime p m ∧ n = p ^ k * m
