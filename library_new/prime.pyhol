    #[73] (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∧ (n = 0 ∨ p = 1 ∨ k ≤ index p n)
  -> rewrite_fact min_def sym=false goal=73 facts=[70]
    #[74] k ≤ (if index p m ≤ index p n then index p m else index p n)
  ← cases "index p m ≤ index p n" goal=73
    #[75] index p m ≤ index p n ⟶ (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∧ (n = 0 ∨ p = 1 ∨ k ≤ index p n)
    #[76] ¬(index p m ≤ index p n) ⟶ (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∧ (n = 0 ∨ p = 1 ∨ k ≤ index p n)
