    #[62] k ≤ min (index p m) (index p n)
  ← rewrite_goal min_def sym=false goal=62
    #[63] k ≤ (if index p m ≤ index p n then index p m else index p n)
  ← cases "index p m ≤ index p n" goal=63
    #[64] index p m ≤ index p n ⟶ k ≤ (if index p m ≤ index p n then index p m else index p n)
    #[65] ¬(index p m ≤ index p n) ⟶ k ≤ (if index p m ≤ index p n then index p m else index p n)
