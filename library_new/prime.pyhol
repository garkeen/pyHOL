  ← apply_backward_step divides_1 goal=37
    #[38] divides 1 n
  ← introduction goal=24
    #[39] ¬(k = 0)
    #[40] divides (if k = 0 then 1 else 0) n ⟷ n = 0 ∨ (0::nat) = 1 ∨ k ≤ index 0 n
