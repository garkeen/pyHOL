    #[66] ¬(p = 1) ⟶ divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← introduction goal=65
    #[67] p = 1
    #[68] divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
