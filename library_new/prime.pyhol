theorem primepow_divisors_eq
  fixes m :: nat, n :: nat
  prop m = n <--> (!p. !k::nat. prime p --> divides (p ^ k) m <--> divides (p ^ k) n)
  [hint_rewrite]
proof
  ← apply_backward_step iffI goal=0
    #[1] m = n ⟶ (∀p. ∀k::nat. prime p ⟶ divides (p ^ k) m ⟷ divides (p ^ k) n)
    #[2] (∀p. ∀k::nat. prime p ⟶ divides (p ^ k) m ⟷ divides (p ^ k) n) ⟶ m = n
  ← introduction goal=1
    #[3] m = n
    #[4] ∀p. ∀k::nat. prime p ⟶ divides (p ^ k) m ⟷ divides (p ^ k) n
  ← rewrite_goal_with_prev goal=4 facts=[3]
    #[5] ∀p. ∀k::nat. prime p ⟶ divides (p ^ k) n ⟷ divides (p ^ k) n
  ← introduction p,k goal=5
    #[6] _VAR p
    #[7] _VAR k
    #[8] prime p
    #[9] divides (p ^ k) n ⟷ divides (p ^ k) n
  ← apply_backward_step eq_refl goal=9
    #[10] divides (p ^ k) n ⟷ divides (p ^ k) n
  ← introduction goal=2
    #[11] ∀p. ∀k::nat. prime p ⟶ divides (p ^ k) m ⟷ divides (p ^ k) n
    #[12] m = n
  ← apply_backward_step divides_antisym goal=12
    #[13] divides m n
    #[14] divides n m
  ← rewrite_goal primepow_divisors_divides sym=false goal=13
    #[15] ∀p. ∀k::nat. prime p ⟶ divides (p ^ k) m ⟶ divides (p ^ k) n
  ← introduction p,k goal=15
    #[16] divides (p ^ k) m
    #[17] divides (p ^ k) n
  -> apply_fact goal=17 facts=[11,8]
    #[18] ∀k::nat. divides (p ^ k) m ⟷ divides (p ^ k) n
  -> rewrite_fact_with_prev goal=17 facts=[18,16]
  ← rewrite_goal primepow_divisors_divides sym=false goal=14
    #[19] ∀p. ∀k::nat. prime p ⟶ divides (p ^ k) n ⟶ divides (p ^ k) m
  ← introduction p,k goal=19
    #[20] divides (p ^ k) n
    #[21] divides (p ^ k) m
  -> apply_fact goal=21 facts=[11,8]
  ← rewrite_goal_with_prev goal=21 facts=[18]
qed

theorem finite_exp_le
  fixes P :: nat => bool, n :: nat, p :: nat
  prop 2 <= p --> finite ({j. P j & p ^ j <= n})
  [hint_backward]

theorem finite_indices
  fixes P :: nat => bool, n :: nat, p :: nat
  prop 2 <= p --> ~(n = 0) --> finite ({j. P j & divides (p ^ j) n})
  [hint_backward,hint_backward1]

def index :: nat ⇒ nat ⇒ nat = index p n = (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) [hint_rewrite]

theorem index_0
  fixes p :: nat
  prop index p 0 = 0
  [hint_rewrite]
proof
  ← rewrite_goal index_def sym=false goal=0
    #[1] (if p ≤ 1 ∨ (0::nat) = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) 0})) = 0
  cut "p ≤ 1 ∨ (0::nat) = 0" goal=1
    #[2] p ≤ 1 ∨ (0::nat) = 0
  ← apply_backward_step disjI2 goal=2
    #[3] (0::nat) = 0
  ← apply_backward_step eq_refl goal=3
  ← rewrite_goal if_P sym=false goal=1 facts=[2]
qed

theorem primepow_divides_index
  fixes k :: nat, n :: nat, p :: nat
  prop divides (p ^ k) n <--> n = 0 | p = 1 | k <= index p n
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
    #[2] ¬(n = 0) ⟶ divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← introduction goal=1
    #[3] n = 0
    #[4] divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← rewrite_goal_with_prev goal=4 facts=[3]
    #[5] divides (p ^ k) 0 ⟷ (0::nat) = 0 ∨ p = 1 ∨ k ≤ index p 0
  ← apply_backward_step iffI goal=5
    #[6] divides (p ^ k) 0 ⟶ (0::nat) = 0 ∨ p = 1 ∨ k ≤ index p 0
    #[7] (0::nat) = 0 ∨ p = 1 ∨ k ≤ index p 0 ⟶ divides (p ^ k) 0
  ← introduction goal=6
    #[8] divides (p ^ k) 0
    #[9] (0::nat) = 0 ∨ p = 1 ∨ k ≤ index p 0
  ← apply_backward_step disjI1 goal=9
    #[10] (0::nat) = 0
  ← apply_backward_step eq_refl goal=10
    #[11] (0::nat) = 0
  ← introduction goal=7
    #[12] (0::nat) = 0 ∨ p = 1 ∨ k ≤ index p 0
    #[13] divides (p ^ k) 0
  ← apply_backward_step divides_zero goal=13
    #[14] divides (p ^ k) 0
  ← introduction goal=2
    #[15] ¬(n = 0)
    #[16] divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← cases "p=0" goal=16
    #[17] p = 0 ⟶ divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
    #[18] ¬(p = 0) ⟶ divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← introduction goal=17
    #[19] p = 0
    #[20] divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← rewrite_goal_with_prev goal=20 facts=[19]
    #[21] divides (0 ^ k) n ⟷ n = 0 ∨ (0::nat) = 1 ∨ k ≤ index 0 n
  ← rewrite_goal exp_zero sym=false goal=21
    #[22] divides (if k = 0 then 1 else 0) n ⟷ n = 0 ∨ (0::nat) = 1 ∨ k ≤ index 0 n
  ← cases "k = 0" goal=22
    #[23] k = 0 ⟶ divides (if k = 0 then 1 else 0) n ⟷ n = 0 ∨ (0::nat) = 1 ∨ k ≤ index 0 n
    #[24] ¬(k = 0) ⟶ divides (if k = 0 then 1 else 0) n ⟷ n = 0 ∨ (0::nat) = 1 ∨ k ≤ index 0 n
  ← introduction goal=23
    #[25] k = 0
    #[26] divides (if k = 0 then 1 else 0) n ⟷ n = 0 ∨ (0::nat) = 1 ∨ k ≤ index 0 n
  ← rewrite_goal if_P sym=false goal=26 facts=[25]
    #[27] divides 1 n ⟷ n = 0 ∨ (0::nat) = 1 ∨ k ≤ index 0 n
  ← rewrite_goal_with_prev goal=27 facts=[25]
    #[28] divides 1 n ⟷ n = 0 ∨ (0::nat) = 1 ∨ 0 ≤ index 0 n
  ← apply_backward_step iffI goal=28
    #[29] divides 1 n ⟶ n = 0 ∨ (0::nat) = 1 ∨ 0 ≤ index 0 n
    #[30] n = 0 ∨ (0::nat) = 1 ∨ 0 ≤ index 0 n ⟶ divides 1 n
  ← introduction goal=29
    #[31] divides 1 n
    #[32] n = 0 ∨ (0::nat) = 1 ∨ 0 ≤ index 0 n
  ← apply_backward_step disjI2 goal=32
    #[33] (0::nat) = 1 ∨ 0 ≤ index 0 n
  ← apply_backward_step disjI2 goal=33
    #[34] 0 ≤ index 0 n
  ← apply_backward_step le_0 goal=34
    #[35] 0 ≤ index 0 n
  ← introduction goal=30
    #[36] n = 0 ∨ (0::nat) = 1 ∨ 0 ≤ index 0 n
