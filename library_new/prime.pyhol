    #[53] k ≤ min (index p m) (index p n)
  ← apply_backward_step disjE goal=53 facts=[40]
    #[54] n = 0 ⟶ k ≤ min (index p m) (index p n)
    #[55] p = 1 ∨ k ≤ index p n ⟶ k ≤ min (index p m) (index p n)
  ← introduction goal=54
    #[56] k ≤ min (index p m) (index p n)
  ← apply_backward_step negE_gen goal=56 facts=[20,15]
    #[57] k ≤ min (index p m) (index p n)
  ← introduction goal=55
    #[58] p = 1 ∨ k ≤ index p n
