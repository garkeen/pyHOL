  ← apply_backward_step disjI2 goal=72
    #[73] p = 1 ∨ k ≤ index p n
  ← apply_backward_step disjI1 goal=73
  ← introduction goal=70
    #[74] n = 0 ∨ p = 1 ∨ k ≤ index p n
