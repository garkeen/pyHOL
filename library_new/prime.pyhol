theorem le_index
  fixes k :: nat, n :: nat, p :: nat
  prop k <= index p n <--> (n = 0 | p = 1 --> k = 0) & divides (p ^ k) n
  [hint_rewrite]
proof
  ← rewrite_goal primepow_divides_index sym=false goal=0
