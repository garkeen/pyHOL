    #[62] 0 < k
  ← apply_backward_step le_1_1 goal=62
  ← apply_backward_step negE_gen goal=49 facts=[50,48]
  ← introduction goal=18
    #[63] ¬(p = 0)
    #[64] divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← cases "p = 1" goal=64
