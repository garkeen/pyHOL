theorem prime_factorization
  fixes n :: nat
  prop ~(n = 0) --> nproduct ({p. prime p & divides p n}) (%p. p ^ index p n) = n
  [hint_backward]

theorem induct_coprime
  fixes P :: nat => bool
  prop (!a. !b. 1 < a --> 1 < b --> coprime a b --> P a --> P b --> P (a * b)) --> (!p. !k::nat. prime p --> P (p ^ k)) --> (!n. 1 < n --> P n)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀a. ∀b. 1 < a ⟶ 1 < b ⟶ coprime a b ⟶ P a ⟶ P b ⟶ P (a * b)
    #[2] ∀p. ∀k::nat. prime p ⟶ P (p ^ k)
    #[3] ∀n. 1 < n ⟶ P n
  ← apply_backward_step nat_WF goal=3
    #[4] ∀n. (∀m. m < n ⟶ 1 < m ⟶ P m) ⟶ 1 < n ⟶ P n
  ← introduction n goal=4
    #[5] _VAR n
    #[6] ∀m. m < n ⟶ 1 < m ⟶ P m
    #[7] 1 < n
    #[8] P n
  cut "~(n=1)" goal=8
    #[9] ¬(n = 1)
  ← z3 goal=9 facts=[7]
    #[10] ¬(n = 1)
  -> apply_forward_step prime_factor goal=8 facts=[10]
    #[11] ∃p. prime p ∧ divides p n
  exists_elim p goal=8 facts=[11]
    #[12] _VAR p
    #[13] prime p ∧ divides p n
    #[14] P n
  -> apply_forward_step conjD1 goal=14 facts=[13]
    #[15] prime p
  -> apply_forward_step conjD2 goal=14 facts=[13]
    #[16] divides p n
  cut "~(n=0)" goal=14
    #[17] ¬(n = 0)
  ← z3 goal=17 facts=[7]
    #[18] ¬(n = 0)
  -> apply_forward_step prime_ge_2 goal=14 facts=[15]
    #[19] 2 ≤ p
  -> apply_forward_step factorization_index goal=14 facts=[18,19]
    #[20] ∃k::nat. divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n))
  exists_elim k goal=14 facts=[20]
    #[21] _VAR k
    #[22] divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n))
    #[23] P n
  -> apply_forward_step conjD1 goal=23 facts=[22]
    #[24] divides (p ^ k) n
  -> apply_forward_step conjD2 goal=23 facts=[22]
    #[25] ∀l. k < l ⟶ ¬(divides (p ^ l) n)
  -> rewrite_fact divides_def sym=false goal=23 facts=[24]
    #[26] ∃k1. n = p ^ k * k1
  exists_elim m goal=23 facts=[26]
    #[27] _VAR m
    #[28] n = p ^ k * m
    #[29] P n
  ← cases "m=1" goal=29
    #[30] m = 1 ⟶ P n
    #[31] ¬(m = 1) ⟶ P n
  ← introduction goal=30
    #[32] m = 1
    #[33] P n
  -> rewrite_fact_with_prev goal=33 facts=[32,28]
    #[34] n = p ^ k * 1
  -> rewrite_fact mult_1_right sym=false goal=33 facts=[34]
    #[35] n = p ^ k
  ← rewrite_goal_with_prev goal=33 facts=[35]
    #[36] P (p ^ k)
  ← apply_prev goal=36 facts=[2]
  ← introduction goal=31
    #[37] ¬(m = 1)
    #[38] P n
  ← rewrite_goal_with_prev goal=38 facts=[28]
    #[39] P (p ^ k * m)
  ← apply_prev goal=39 facts=[1]
    #[40] 1 < p ^ k
    #[41] 1 < m
    #[42] coprime (p ^ k) m
    #[43] P (p ^ k)
    #[44] P m
  cut "~(k=0)" goal=40
    #[45] ¬(k = 0)
  ← apply_backward_step negI goal=45
    #[46] k = 0 ⟶ false
  ← introduction goal=46
    #[47] k = 0
    #[48] false
  -> rewrite_fact_with_prev goal=48 facts=[47,25]
    #[49] ∀l::nat. 0 < l ⟶ ¬(divides (p ^ l) n)
  -> forall_elim "(1::nat)" goal=48 facts=[49]
    #[50] (0::nat) < 1 ⟶ ¬(divides (p ^ (1::nat)) n)
  -> rewrite_fact exp_1 sym=false goal=48 facts=[50]
    #[51] (0::nat) < 1 ⟶ ¬(divides p n)
  ← apply_backward_step contrapositive goal=48 facts=[16]
    #[52] ¬false ⟶ ¬(divides p n)
  ← introduction goal=52
    #[53] ¬false
    #[54] ¬(divides p n)
  ← apply_prev goal=54 facts=[51]
    #[55] (0::nat) < 1
  ← z3 goal=55
    #[56] (0::nat) < 1
  -> rewrite_fact_with_prev goal=40 facts=[28,7]
    #[57] 1 < p ^ k * m
  cut "!x::nat. 1 < x <--> ~(x = 0) & ~(x = 1)" goal=40
    #[58] ∀x::nat. 1 < x ⟷ ¬(x = 0) ∧ ¬(x = 1)
  ← z3 goal=58
    #[59] ∀x::nat. 1 < x ⟷ ¬(x = 0) ∧ ¬(x = 1)
  -> rewrite_fact_with_prev goal=40 facts=[59,57]
    #[60] ¬(p ^ k * m = 0) ∧ ¬(p ^ k * m = 1)
  -> apply_forward_step conjD1 goal=40 facts=[60]
    #[61] ¬(p ^ k * m = 0)
  -> rewrite_fact mult_eq_0 sym=false goal=40 facts=[61]
    #[62] ¬(p ^ k = 0 ∨ m = 0)
  -> rewrite_fact de_morgan_thm2 sym=false goal=40 facts=[62]
    #[63] ¬(p ^ k = 0) ∧ ¬(m = 0)
  -> apply_forward_step conjD1 goal=40 facts=[63]
    #[64] ¬(p ^ k = 0)
  -> apply_forward_step conjD2 goal=40 facts=[63]
    #[65] ¬(m = 0)
  ← rewrite_goal_with_prev goal=40 facts=[59]
    #[66] ¬(p ^ k = 0) ∧ ¬(p ^ k = 1)
  ← apply_backward_step conjI goal=66
    #[67] ¬(p ^ k = 1)
  ← rewrite_goal exp_eq_1 sym=false goal=67
    #[68] ¬(p = 1 ∨ k = 0)
  ← rewrite_goal de_morgan_thm2 sym=false goal=68
    #[69] ¬(p = 1) ∧ ¬(k = 0)
  ← apply_backward_step conjI goal=69
    #[70] ¬(p = 1)
  ← z3 goal=70 facts=[19]
    #[71] ¬(p = 1)
  ← rewrite_goal_with_prev goal=41 facts=[59]
    #[72] ¬(m = 0) ∧ ¬(m = 1)
  ← apply_backward_step conjI goal=72
  ← rewrite_goal coprime_sym sym=false goal=42
    #[73] coprime m (p ^ k)
  ← apply_backward_step coprime_exp goal=73
    #[74] coprime m p
  -> apply_forward_step prime_coprime param_n=m goal=74 facts=[15]
    #[75] m = 1 ∨ divides p m ∨ coprime p m
  ← rewrite_goal coprime_sym sym=false goal=74
    #[76] coprime p m
  ← apply_backward_step disjE goal=76 facts=[75]
    #[77] m = 1 ⟶ coprime p m
    #[78] divides p m ∨ coprime p m ⟶ coprime p m
  ← introduction goal=77
    #[79] coprime p m
  ← apply_backward_step negE_gen goal=79 facts=[37,32]
    #[80] coprime p m
  ← introduction goal=78
    #[81] divides p m ∨ coprime p m
    #[82] coprime p m
  ← apply_backward_step disjE goal=82 facts=[81]
    #[83] divides p m ⟶ coprime p m
    #[84] coprime p m ⟶ coprime p m
  ← introduction goal=83
    #[85] divides p m
    #[86] coprime p m
  -> forall_elim k+1 goal=86 facts=[25]
    #[87] k < k + 1 ⟶ ¬(divides (p ^ (k + 1)) n)
  cut "k < k + 1" goal=86
    #[88] k < k + 1
  ← z3 goal=88
    #[89] k < k + 1
  -> apply_fact goal=86 facts=[87,89]
    #[90] ¬(divides (p ^ (k + 1)) n)
  -> rewrite_fact nat_power_add sym=false goal=86 facts=[90]
    #[91] ¬(divides (p ^ k * p ^ (1::nat)) n)
  -> rewrite_fact exp_1 sym=false goal=86 facts=[91]
    #[92] ¬(divides (p ^ k * p) n)
  ← apply_backward_step negE_gen goal=86 facts=[92]
    #[93] divides (p ^ k * p) n
  ← rewrite_goal_with_prev goal=93 facts=[28]
    #[94] divides (p ^ k * p) (p ^ k * m)
  ← apply_backward_step divides_mult_left goal=94 facts=[85]
    #[95] divides (p ^ k * p) (p ^ k * m)
  ← apply_prev goal=43 facts=[2]
  ← apply_prev goal=44 facts=[6]
    #[96] m < n
  ← rewrite_goal_with_prev goal=96 facts=[28]
    #[97] m < p ^ k * m
  ← apply_backward_step let_trans param_m="1 * m" goal=97
    #[98] m ≤ 1 * m
    #[99] 1 * m < p ^ k * m
  ← rewrite_goal mult_1_left sym=false goal=98
    #[100] m ≤ m
  ← apply_backward_step less_eq_refl goal=100
    #[101] m ≤ m
  ← rewrite_goal lt_mult_rcancel sym=false goal=99
    #[102] 1 < p ^ k ∧ ¬(m = 0)
  ← apply_backward_step conjI goal=102
qed

theorem induct_coprime_strong
  fixes P :: nat => bool
  prop (!a. !b. 1 < a --> 1 < b --> coprime a b --> P a --> P b --> P (a * b)) --> (!p. !k::nat. prime p --> ~(k = 0) --> P (p ^ k)) --> (!n. 1 < n --> P n)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ∀a. ∀b. 1 < a ⟶ 1 < b ⟶ coprime a b ⟶ P a ⟶ P b ⟶ P (a * b)
    #[2] ∀p. ∀k::nat. prime p ⟶ ¬(k = 0) ⟶ P (p ^ k)
    #[3] ∀n. 1 < n ⟶ P n
  cut "∀n. 1 < n ⟶ 1 < n ⟶ P n" goal=3
    #[4] ∀n. 1 < n ⟶ 1 < n ⟶ P n
  ← apply_backward_step induct_coprime goal=4
    #[5] ∀a. ∀b. 1 < a ⟶ 1 < b ⟶ coprime a b ⟶ (1 < a ⟶ P a) ⟶ (1 < b ⟶ P b) ⟶ 1 < a * b ⟶ P (a * b)
    #[6] ∀p. ∀k::nat. prime p ⟶ 1 < p ^ k ⟶ P (p ^ k)
  ← introduction a,b goal=5
    #[7] _VAR a
    #[8] _VAR b
    #[9] 1 < a
    #[10] 1 < b
    #[11] coprime a b
    #[12] 1 < a ⟶ P a
    #[13] 1 < b ⟶ P b
    #[14] 1 < a * b
    #[15] P (a * b)
  ← apply_prev goal=15 facts=[1]
    #[16] P a
    #[17] P b
  ← apply_prev goal=16 facts=[12]
  ← apply_prev goal=17 facts=[13]
  ← introduction p,k goal=6
    #[18] _VAR p
    #[19] _VAR k
    #[20] prime p
    #[21] 1 < p ^ k
    #[22] P (p ^ k)
  ← apply_prev goal=22 facts=[2]
    #[23] ¬(k = 0)
  ← apply_backward_step contrapositive goal=23 facts=[21]
    #[24] ¬¬(k = 0) ⟶ ¬(1 < p ^ k)
  ← rewrite_goal double_neg sym=false goal=24
    #[25] k = 0 ⟶ ¬(1 < p ^ k)
  ← introduction goal=25
    #[26] k = 0
    #[27] ¬(1 < p ^ k)
  ← rewrite_goal_with_prev goal=27 facts=[26]
    #[28] ¬(1 < p ^ (0::nat))
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=28
    #[29] ¬((1::nat) < 1)
  ← rewrite_goal not_lt sym=false goal=29
    #[30] (1::nat) ≤ 1
  ← apply_backward_step less_eq_refl goal=30
    #[31] (1::nat) ≤ 1
  ← introduction n goal=3
    #[32] _VAR n
    #[33] 1 < n
    #[34] P n
  ← apply_prev goal=34 facts=[4]
qed

theorem induct_coprime_alt
  fixes P :: nat => bool
  prop P 0 --> (!a. !b. 1 < a --> 1 < b --> coprime a b --> P a --> P b --> P (a * b)) --> (!p. !k::nat. prime p --> P (p ^ k)) --> (!n. P n)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] P 0
    #[2] ∀a. ∀b. 1 < a ⟶ 1 < b ⟶ coprime a b ⟶ P a ⟶ P b ⟶ P (a * b)
    #[3] ∀p. ∀k::nat. prime p ⟶ P (p ^ k)
    #[4] ∀n. P n
  cut "(∀n. 1 < n ⟶ P n)" goal=4
    #[5] ∀n. 1 < n ⟶ P n
  ← apply_backward_step induct_coprime goal=5
  cut "∀n. ~(1 < n) ⟶ P n" goal=4
    #[6] ∀n. ¬(1 < n) ⟶ P n
  ← introduction n goal=6
    #[7] _VAR n
    #[8] ¬(1 < n)
    #[9] P n
  cut "n = 0 | n=1" goal=9
    #[10] n = 0 ∨ n = 1
  ← z3 goal=10 facts=[8]
    #[11] n = 0 ∨ n = 1
  ← apply_backward_step disjE goal=9 facts=[11]
    #[12] n = 0 ⟶ P n
    #[13] n = 1 ⟶ P n
  ← introduction goal=12
    #[14] n = 0
    #[15] P n
  ← rewrite_goal_with_prev goal=15 facts=[14]
  ← introduction goal=13
    #[16] n = 1
    #[17] P n
  ← rewrite_goal_with_prev goal=17 facts=[16]
    #[18] P 1
  -> forall_elim "(2::nat)" goal=18 facts=[3]
    #[19] ∀k::nat. prime 2 ⟶ P (2 ^ k)
  -> forall_elim "(0::nat)" goal=18 facts=[19]
    #[20] prime 2 ⟶ P (2 ^ (0::nat))
  -> rewrite_fact nat_nat_power_def_1 sym=false goal=18 facts=[20]
    #[21] prime 2 ⟶ P 1
  ← apply_prev goal=18 facts=[21]
    #[22] prime 2
  ← apply_backward_step prime_2 goal=22
    #[23] prime 2
  ← z3 goal=4 facts=[5,6]
qed

