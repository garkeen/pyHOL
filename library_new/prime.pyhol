theorem index_fact_prime_mult
  fixes n :: nat, p :: nat
  prop prime p --> index p (fact (p * n)) = n + index p (fact n)
  [hint_backward]

theorem prime_factorization_index
  fixes k :: nat => nat
  prop finite ({p. prime p & ~(k p = 0)}) --> (?n. ~(n = 0) & (!p. prime p --> index p n = k p))
  [hint_backward]

theorem prime_power_exists
  fixes n :: nat, q :: nat
  prop prime q --> (?i::nat. n = q ^ i) <--> (!p. prime p --> divides p n --> p = q)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime q
    #[2] (∃i::nat. n = q ^ i) ⟷ (∀p. prime p ⟶ divides p n ⟶ p = q)
  ← apply_backward_step iffI goal=2
    #[3] (∃i::nat. n = q ^ i) ⟶ (∀p. prime p ⟶ divides p n ⟶ p = q)
    #[4] (∀p. prime p ⟶ divides p n ⟶ p = q) ⟶ (∃i::nat. n = q ^ i)
  ← introduction goal=3
    #[5] ∃i::nat. n = q ^ i
    #[6] ∀p. prime p ⟶ divides p n ⟶ p = q
  exists_elim i goal=6 facts=[5]
    #[7] _VAR i
    #[8] n = q ^ i
    #[9] ∀p. prime p ⟶ divides p n ⟶ p = q
  -> rewrite_fact primepow_divisors_eq sym=false goal=9 facts=[8]
    #[10] ∀p. ∀k::nat. prime p ⟶ divides (p ^ k) n ⟷ divides (p ^ k) (q ^ i)
  ← introduction p goal=9
    #[11] _VAR p
    #[12] prime p
    #[13] divides p n
    #[14] p = q
  -> apply_forward_step divides_prime_exp_le param_m="" param_n=i goal=14 facts=[12,1]
    #[15] ∀m. divides (p ^ m) (q ^ i) ⟷ m = 0 ∨ p = q ∧ m ≤ i
  -> apply_fact goal=14 facts=[10,12]
    #[16] ∀k::nat. divides (p ^ k) n ⟷ divides (p ^ k) (q ^ i)
  -> rewrite_fact_with_prev goal=14 facts=[15,16]
    #[17] ∀k. divides (p ^ k) n ⟷ k = 0 ∨ p = q ∧ k ≤ i
  -> forall_elim "(1::nat)" goal=14 facts=[17]
    #[18] divides (p ^ (1::nat)) n ⟷ (1::nat) = 0 ∨ p = q ∧ 1 ≤ i
  -> rewrite_fact exp_1 sym=false goal=14 facts=[18]
    #[19] divides p n ⟷ (1::nat) = 0 ∨ p = q ∧ 1 ≤ i
  -> rewrite_fact_with_prev goal=14 facts=[19,13]
    #[20] (1::nat) = 0 ∨ p = q ∧ 1 ≤ i
  ← apply_backward_step disjE goal=14 facts=[20]
    #[21] (1::nat) = 0 ⟶ p = q
