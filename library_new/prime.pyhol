  ← apply_backward_step conjD1 goal=27 facts=[26]
    #[28] p = q
  ← introduction goal=4
    #[29] ∀p. prime p ⟶ divides p n ⟶ p = q
    #[30] ∃i::nat. n = q ^ i
  ← rewrite_goal primepow_divisors_eq sym=false goal=30
