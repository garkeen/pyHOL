theorem prime_factorization_alt
  fixes n :: nat
  prop ~(n = 0) --> nproduct ({p. prime p}) (%p. p ^ index p n) = n
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ¬(n = 0)
    #[2] nproduct ({p. prime p}) (λp. p ^ index p n) = n
  cut "!n. ¬(n = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p n) = n" goal=2
    #[3] ∀n. ¬(n = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p n) = n
  ← apply_backward_step complete_factor_induct goal=3
    #[4] ¬((0::nat) = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p 0) = 0
    #[5] ¬((1::nat) = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p 1) = 1
    #[6] ∀p. prime p ⟶ ¬(p = 0) ⟶ nproduct ({p1. prime p1}) (λp1. p1 ^ index p1 p) = p
    #[7] ∀m. ∀n. (¬(m = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p m) = m) ⟶ (¬(n = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p n) = n) ⟶ ¬(m * n = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p (m * n)) = m * n
  ← introduction goal=4
    #[8] ¬((0::nat) = 0)
    #[9] nproduct ({p. prime p}) (λp. p ^ index p 0) = 0
  ← apply_backward_step negE_gen goal=9 facts=[8]
    #[10] (0::nat) = 0
  ← apply_backward_step eq_refl goal=10
    #[11] (0::nat) = 0
  ← introduction goal=5
    #[12] ¬((1::nat) = 0)
    #[13] nproduct ({p. prime p}) (λp. p ^ index p 1) = 1
  ← rewrite_goal index_1 sym=false goal=13
    #[14] nproduct ({p. prime p}) (λp. p ^ (0::nat)) = 1
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=14
    #[15] nproduct ({p. prime p}) (λp. 1) = 1
  ← rewrite_goal nproduct_one sym=false goal=15
    #[16] nproduct ({p. prime p}) (λp. 1) = 1
  ← introduction p goal=6
    #[17] _VAR p
    #[18] prime p
    #[19] ¬(p = 0)
    #[20] nproduct ({p1. prime p1}) (λp1. p1 ^ index p1 p) = p
  -> apply_forward_step index_prime param_a="" goal=20 facts=[18]
    #[21] ∀a. index a p = (if p = a then 1 else 0)
  ← rewrite_goal_with_prev goal=20 facts=[21]
    #[22] nproduct ({p1. prime p1}) (λp1. p1 ^ (if p = p1 then (1::nat) else 0)) = p
  cut "∀p1. p1 ^ (if p = p1 then (1::nat) else 0) = (if p1 = p then p else 1)" goal=22
    #[23] ∀p1. p1 ^ (if p = p1 then (1::nat) else 0) = (if p1 = p then p else 1)
  ← introduction x goal=23
    #[24] _VAR x
    #[25] x ^ (if p = x then (1::nat) else 0) = (if x = p then p else 1)
  ← cases "p = x" goal=25
    #[26] p = x ⟶ x ^ (if p = x then (1::nat) else 0) = (if x = p then p else 1)
    #[27] ¬(p = x) ⟶ x ^ (if p = x then (1::nat) else 0) = (if x = p then p else 1)
  ← introduction goal=26
    #[28] p = x
    #[29] x ^ (if p = x then (1::nat) else 0) = (if x = p then p else 1)
  ← rewrite_goal if_P sym=false goal=29 facts=[28]
    #[30] x ^ (1::nat) = (if x = p then p else 1)
  -> rewrite_fact eq_sym_eq sym=false goal=30 facts=[28]
    #[31] x = p
  ← rewrite_goal if_P sym=false goal=30 facts=[31]
    #[32] x ^ (1::nat) = p
  ← rewrite_goal exp_1 sym=false goal=32
  ← introduction goal=27
    #[33] ¬(p = x)
    #[34] x ^ (if p = x then (1::nat) else 0) = (if x = p then p else 1)
  ← rewrite_goal if_not_P sym=false goal=34 facts=[33]
    #[35] x ^ (0::nat) = (if x = p then p else 1)
  -> rewrite_fact eq_sym_eq sym=false goal=35 facts=[33]
    #[36] ¬(x = p)
  ← rewrite_goal if_not_P sym=false goal=35 facts=[36]
    #[37] x ^ (0::nat) = 1
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=37
    #[38] x ^ (0::nat) = 1
  ← rewrite_goal_with_prev goal=22 facts=[23]
    #[39] nproduct ({p1. prime p1}) (λp1. if p1 = p then p else 1) = p
  ← rewrite_goal nproduct_delta sym=false goal=39
    #[40] (if p ∈ {p1. prime p1} then p else 1) = p
  ← rewrite_goal member_collect sym=false goal=40
    #[41] (if prime p then p else 1) = p
  ← rewrite_goal if_P sym=false goal=41 facts=[18]
    #[42] (if prime p then p else 1) = p
  ← introduction a,b goal=7
    #[43] _VAR a
    #[44] _VAR b
    #[45] ¬(a = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p a) = a
    #[46] ¬(b = 0) ⟶ nproduct ({p. prime p}) (λp. p ^ index p b) = b
    #[47] ¬(a * b = 0)
    #[48] nproduct ({p. prime p}) (λp. p ^ index p (a * b)) = a * b
  -> rewrite_fact mult_eq_0 sym=false goal=48 facts=[47]
    #[49] ¬(a = 0 ∨ b = 0)
  -> rewrite_fact de_morgan_thm2 sym=false goal=48 facts=[49]
    #[50] ¬(a = 0) ∧ ¬(b = 0)
  -> apply_forward_step conjD1 goal=48 facts=[50]
    #[51] ¬(a = 0)
  -> apply_forward_step conjD2 goal=48 facts=[50]
    #[52] ¬(b = 0)
  -> apply_fact goal=48 facts=[45,51]
    #[53] nproduct ({p. prime p}) (λp. p ^ index p a) = a
  -> apply_fact goal=48 facts=[46,52]
    #[54] nproduct ({p. prime p}) (λp. p ^ index p b) = b
  cut "nproduct ({p. prime p}) (λp. p ^ (index p a + index p b)) = nproduct ({p. prime p}) (λp. p ^ index p a) * nproduct ({p. prime p}) (λp. p ^ index p b)" goal=48
    #[55] nproduct ({p. prime p}) (λp. p ^ (index p a + index p b)) = nproduct ({p. prime p}) (λp. p ^ index p a) * nproduct ({p. prime p}) (λp. p ^ index p b)
  ← rewrite_goal nat_power_add sym=false goal=55
    #[56] nproduct ({p. prime p}) (λp. p ^ index p a * p ^ index p b) = nproduct ({p. prime p}) (λp. p ^ index p a) * nproduct ({p. prime p}) (λp. p ^ index p b)
  ← apply_backward_step nproduct_mul_gen goal=56
    #[57] finite ({p. p ∈ {p1. prime p1} ∧ ¬(p ^ index p a = 1)})
    #[58] finite ({p. p ∈ {p1. prime p1} ∧ ¬(p ^ index p b = 1)})
  ← rewrite_goal member_collect sym=false goal=57
    #[59] finite ({p. prime p ∧ ¬(p ^ index p a = 1)})
  ← rewrite_goal exp_eq_1 sym=false goal=59
    #[60] finite ({p. prime p ∧ ¬(p = 1 ∨ index p a = 0)})
  ← rewrite_goal index_eq_0 sym=false goal=60
    #[61] finite ({p. prime p ∧ ¬(p = 1 ∨ a = 0 ∨ p = 1 ∨ ¬(divides p a))})
  ← rewrite_goal de_morgan_thm2 sym=false goal=61
    #[62] finite ({p. prime p ∧ ¬(p = 1) ∧ ¬(a = 0 ∨ p = 1 ∨ ¬(divides p a))})
  ← rewrite_goal de_morgan_thm2 sym=false goal=62
    #[63] finite ({p. prime p ∧ ¬(p = 1) ∧ ¬(a = 0) ∧ ¬(p = 1 ∨ ¬(divides p a))})
  ← rewrite_goal de_morgan_thm2 sym=false goal=63
    #[64] finite ({p. prime p ∧ ¬(p = 1) ∧ ¬(a = 0) ∧ ¬(p = 1) ∧ ¬¬(divides p a)})
  ← rewrite_goal double_neg sym=false goal=64
    #[65] finite ({p. prime p ∧ ¬(p = 1) ∧ ¬(a = 0) ∧ ¬(p = 1) ∧ divides p a})
  ← rewrite_goal conj_assoc sym=false goal=65
    #[66] finite ({p. (prime p ∧ ¬(p = 1)) ∧ ¬(a = 0) ∧ ¬(p = 1) ∧ divides p a})
  ← rewrite_goal conj_assoc sym=false goal=66
    #[67] finite ({p. ((prime p ∧ ¬(p = 1)) ∧ ¬(a = 0)) ∧ ¬(p = 1) ∧ divides p a})
  ← rewrite_goal conj_assoc sym=false goal=67
    #[68] finite ({p. (((prime p ∧ ¬(p = 1)) ∧ ¬(a = 0)) ∧ ¬(p = 1)) ∧ divides p a})
  ← apply_backward_step finite_special_divisors goal=68
  ← rewrite_goal exp_eq_1 sym=false goal=58
    #[69] finite ({p. p ∈ {p1. prime p1} ∧ ¬(p = 1 ∨ index p b = 0)})
  ← rewrite_goal index_eq_0 sym=false goal=69
    #[70] finite ({p. p ∈ {p1. prime p1} ∧ ¬(p = 1 ∨ b = 0 ∨ p = 1 ∨ ¬(divides p b))})
  ← rewrite_goal de_morgan_thm2 sym=false goal=70
    #[71] finite ({p. p ∈ {p1. prime p1} ∧ ¬(p = 1) ∧ ¬(b = 0 ∨ p = 1 ∨ ¬(divides p b))})
  ← rewrite_goal de_morgan_thm2 sym=false goal=71
    #[72] finite ({p. p ∈ {p1. prime p1} ∧ ¬(p = 1) ∧ ¬(b = 0) ∧ ¬(p = 1 ∨ ¬(divides p b))})
  ← rewrite_goal de_morgan_thm2 sym=false goal=72
    #[73] finite ({p. p ∈ {p1. prime p1} ∧ ¬(p = 1) ∧ ¬(b = 0) ∧ ¬(p = 1) ∧ ¬¬(divides p b)})
  ← rewrite_goal double_neg sym=false goal=73
    #[74] finite ({p. p ∈ {p1. prime p1} ∧ ¬(p = 1) ∧ ¬(b = 0) ∧ ¬(p = 1) ∧ divides p b})
  ← rewrite_goal conj_assoc sym=false goal=74
    #[75] finite ({p. (p ∈ {p1. prime p1} ∧ ¬(p = 1)) ∧ ¬(b = 0) ∧ ¬(p = 1) ∧ divides p b})
  ← rewrite_goal conj_assoc sym=false goal=75
    #[76] finite ({p. ((p ∈ {p1. prime p1} ∧ ¬(p = 1)) ∧ ¬(b = 0)) ∧ ¬(p = 1) ∧ divides p b})
  ← rewrite_goal conj_assoc sym=false goal=76
    #[77] finite ({p. (((p ∈ {p1. prime p1} ∧ ¬(p = 1)) ∧ ¬(b = 0)) ∧ ¬(p = 1)) ∧ divides p b})
  ← apply_backward_step finite_special_divisors goal=77
  cut "nproduct ({p. prime p}) (λp. p ^ index p (a * b)) = nproduct ({p. prime p}) (λp. p ^ (index p a + index p b))" goal=48
    #[78] nproduct ({p. prime p}) (λp. p ^ index p (a * b)) = nproduct ({p. prime p}) (λp. p ^ (index p a + index p b))
  ← apply_backward_step nproduct_eq goal=78
    #[79] ∀x. x ∈ {p. prime p} ⟶ x ^ index x (a * b) = x ^ (index x a + index x b)
  ← introduction p goal=79
    #[80] p ∈ {p1. prime p1}
    #[81] p ^ index p (a * b) = p ^ (index p a + index p b)
  -> rewrite_fact member_collect sym=false goal=81 facts=[80]
    #[82] prime p
  cut "index p (a * b) = (index p a + index p b)" goal=81
    #[83] index p (a * b) = index p a + index p b
  ← apply_backward_step index_mul goal=83
  ← rewrite_goal_with_prev goal=81 facts=[83]
  ← rewrite_goal_with_prev goal=48 facts=[78]
    #[84] nproduct ({p. prime p}) (λp. p ^ (index p a + index p b)) = a * b
  ← rewrite_goal_with_prev goal=84 facts=[55]
    #[85] nproduct ({p. prime p}) (λp. p ^ index p a) * nproduct ({p. prime p}) (λp. p ^ index p b) = a * b
  ← rewrite_goal_with_prev goal=85 facts=[53]
    #[86] a * nproduct ({p. prime p}) (λp. p ^ index p b) = a * b
