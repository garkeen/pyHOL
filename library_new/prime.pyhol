theory prime
imports gcd
description "Basic theory of divisibility, gcd, coprimality and primality (over N)."

def coprime :: nat ⇒ nat ⇒ bool = coprime a b ⟷ (∀d. divides d a ∧ divides d b ⟷ d = 1) [hint_rewrite]

theorem coprime_gcd
  fixes a :: nat, b :: nat
  prop coprime a b <--> gcd a b = 1
  [hint_rewrite]
proof
  ← rewrite_goal coprime_def sym=false goal=0
    #[1] (∀d. divides d a ∧ divides d b ⟷ d = 1) ⟷ gcd a b = 1
  ← apply_backward_step iffI goal=1
    #[2] (∀d. divides d a ∧ divides d b ⟷ d = 1) ⟶ gcd a b = 1
    #[3] gcd a b = 1 ⟶ (∀d. divides d a ∧ divides d b ⟷ d = 1)
  ← introduction goal=2
    #[4] ∀d. divides d a ∧ divides d b ⟷ d = 1
    #[5] gcd a b = 1
  ← apply_backward_step gcd_equals goal=5
    #[6] divides 1 a
    #[7] divides 1 b
    #[8] ∀b1. divides b1 a ⟶ divides b1 b ⟶ divides b1 1
  ← apply_backward_step divides_1 goal=6
    #[9] divides 1 a
  ← apply_backward_step divides_1 goal=7
    #[10] divides 1 b
  ← introduction d goal=8
    #[11] _VAR d
    #[12] divides d a
    #[13] divides d b
    #[14] divides d 1
  -> apply_forward_step conjI goal=14 facts=[12,13]
    #[15] divides d a ∧ divides d b
  -> rewrite_fact_with_prev goal=14 facts=[4,15]
    #[16] d = 1
  ← rewrite_goal_with_prev goal=14 facts=[16]
    #[17] divides 1 1
  ← rewrite_goal divides_one sym=false goal=17
    #[18] divides 1 1
  ← introduction goal=3
    #[19] gcd a b = 1
    #[20] ∀d. divides d a ∧ divides d b ⟷ d = 1
  ← introduction d goal=20
    #[21] divides d a ∧ divides d b ⟷ d = 1
  ← apply_backward_step iffI goal=21
    #[22] divides d a ∧ divides d b ⟶ d = 1
    #[23] d = 1 ⟶ divides d a ∧ divides d b
  ← introduction goal=22
    #[24] divides d a ∧ divides d b
    #[25] d = 1
  -> apply_forward_step conjD1 goal=25 facts=[24]
    #[26] divides d a
  -> apply_forward_step conjD2 goal=25 facts=[24]
    #[27] divides d b
  -> apply_forward_step gcd_is_max goal=25 facts=[26,27]
    #[28] divides d (gcd a b)
  -> rewrite_fact_with_prev goal=25 facts=[19,28]
    #[29] divides d 1
  -> rewrite_fact divides_one sym=false goal=25 facts=[29]
  ← introduction goal=23
    #[30] d = 1
    #[31] divides d a ∧ divides d b
  ← rewrite_goal_with_prev goal=31 facts=[30]
    #[32] divides 1 a ∧ divides 1 b
  ← apply_backward_step conjI goal=32
    #[33] divides 1 a
    #[34] divides 1 b
  ← apply_backward_step divides_1 goal=33
  ← apply_backward_step divides_1 goal=34
qed

theorem coprime_sym
  fixes a :: nat, b :: nat
  prop coprime a b <--> coprime b a
  [hint_rewrite,hint_backward]
proof
  ← rewrite_goal coprime_gcd sym=false goal=0
    #[1] gcd a b = 1 ⟷ gcd b a = 1
  ← apply_backward_step iffI goal=1
    #[2] gcd a b = 1 ⟶ gcd b a = 1
    #[3] gcd b a = 1 ⟶ gcd a b = 1
  ← introduction goal=2
    #[4] gcd a b = 1
    #[5] gcd b a = 1
  ← rewrite_goal gcd_comm sym=false goal=5
  ← introduction goal=3
    #[6] gcd b a = 1
    #[7] gcd a b = 1
  ← rewrite_goal gcd_comm sym=false goal=7
qed

theorem coprime_bezout
  fixes a :: nat, b :: nat
  prop coprime a b <--> (?x. ?y. a * x - b * y = 1 | b * x - a * y = 1)
  [hint_rewrite]
proof
  ← rewrite_goal coprime_gcd sym=false goal=0
    #[1] gcd a b = 1 ⟷ (∃x. ∃y. a * x - b * y = 1 ∨ b * x - a * y = 1)
  ← rewrite_goal gcd_bezout sym=false goal=1
    #[2] gcd a b = 1 ⟷ divides (gcd a b) 1
  ← rewrite_goal divides_one sym=false goal=2
qed

theorem coprime_divprod
  fixes a :: nat, b :: nat, d :: nat
  prop divides d (a * b) --> coprime d a --> divides d b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] divides d (a * b)
    #[2] coprime d a
    #[3] divides d b
  -> rewrite_fact divides_lmul_gcd sym=true goal=3 facts=[1]
    #[4] divides d (gcd d a * b)
  -> rewrite_fact coprime_gcd sym=false goal=3 facts=[2]
    #[5] gcd d a = 1
  -> rewrite_fact_with_prev goal=3 facts=[5,4]
    #[6] divides d (1 * b)
  -> rewrite_fact mult_1_left sym=false goal=3 facts=[6]
qed

theorem coprime_rmod
  fixes a :: nat, n :: nat
  prop coprime n (a MOD n) <--> coprime n a
  [hint_rewrite]
proof
  ← rewrite_goal coprime_gcd sym=false goal=0
    #[1] gcd n (a MOD n) = 1 ⟷ gcd n a = 1
  -> apply_forward_step division_simp1 param_m=a param_n=n goal=1
    #[2] a DIV n * n + a MOD n = a
  -> rewrite_fact eq_sym_eq sym=false goal=1 facts=[2]
    #[3] a = a DIV n * n + a MOD n
  ← rewrite_goal_with_prev goal=1 facts=[3]
    #[4] gcd n ((a DIV n * n + a MOD n) MOD n) = 1 ⟷ gcd n (a DIV n * n + a MOD n) = 1
  cut "(a DIV n * n + a MOD n) MOD n = a MOD n" goal=4
    #[5] (a DIV n * n + a MOD n) MOD n = a MOD n
  ← rewrite_goal division_simp1 sym=false goal=5
  ← rewrite_goal_with_prev goal=4 facts=[5]
    #[6] gcd n (a MOD n) = 1 ⟷ gcd n (a DIV n * n + a MOD n) = 1
  ← rewrite_goal gcd_mod sym=false goal=6
qed

theorem coprime_lmod
  fixes a :: nat, n :: nat
  prop coprime (a MOD n) n <--> coprime a n
  [hint_rewrite]
proof
  ← rewrite_goal coprime_sym sym=false goal=0
    #[1] coprime n (a MOD n) ⟷ coprime n a
  ← rewrite_goal coprime_rmod sym=false goal=1
qed

theorem gcd_mul_coprime_1
  fixes a :: nat, b :: nat, c :: nat
  prop coprime a b --> gcd a (b * c) = gcd a c
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime a b
    #[2] gcd a (b * c) = gcd a c
  ← apply_backward_step gcd_eq goal=2
    #[3] ∀d. divides d a ∧ divides d (b * c) ⟷ divides d a ∧ divides d c
  ← introduction d goal=3
    #[4] _VAR d
    #[5] divides d a ∧ divides d (b * c) ⟷ divides d a ∧ divides d c
  ← apply_backward_step iffI goal=5
    #[6] divides d a ∧ divides d (b * c) ⟶ divides d a ∧ divides d c
    #[7] divides d a ∧ divides d c ⟶ divides d a ∧ divides d (b * c)
  ← introduction goal=6
    #[8] divides d a ∧ divides d (b * c)
    #[9] divides d a ∧ divides d c
  ← apply_backward_step conjI goal=9
    #[10] divides d a
    #[11] divides d c
  ← apply_backward_step conjD1 goal=10 facts=[8]
    #[12] divides d a
  -> apply_forward_step conjD2 goal=11 facts=[8]
    #[13] divides d (b * c)
  ← apply_backward_step coprime_divprod goal=11 facts=[13]
    #[14] coprime d b
  -> rewrite_fact coprime_gcd sym=false goal=14 facts=[1]
    #[15] gcd a b = 1
  ← rewrite_goal coprime_gcd sym=false goal=14
    #[16] gcd d b = 1
  -> rewrite_fact divides_gcd_right sym=false goal=16 facts=[12]
    #[17] gcd a d = d
  -> rewrite_fact eq_sym_eq sym=false goal=16 facts=[17]
    #[18] d = gcd a d
  ← rewrite_goal_with_prev goal=16 facts=[18]
    #[19] gcd (gcd a d) b = 1
  ← rewrite_goal gcd_comm sym=false goal=19
    #[20] gcd b (gcd a d) = 1
  ← rewrite_goal gcd_assoc sym=true goal=20
    #[21] gcd (gcd b a) d = 1
  -> rewrite_fact gcd_comm sym=false goal=21 facts=[15]
    #[22] gcd b a = 1
  ← rewrite_goal_with_prev goal=21 facts=[22]
    #[23] gcd 1 d = 1
  ← rewrite_goal gcd_1_left sym=false goal=23
    #[24] gcd 1 d = 1
  ← introduction goal=7
    #[25] divides d a ∧ divides d c
    #[26] divides d a ∧ divides d (b * c)
  ← apply_backward_step conjI goal=26
    #[27] divides d a
    #[28] divides d (b * c)
  ← apply_backward_step conjD1 goal=27 facts=[25]
    #[29] divides d a
  ← apply_backward_step divides_lmul goal=28
    #[30] divides d c
  ← apply_backward_step conjD2 goal=30 facts=[25]
    #[31] divides d c
qed

theorem gcd_mul_coprime_2
  fixes a :: nat, b :: nat, c :: nat
  prop coprime a c --> gcd a (b * c) = gcd a b
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime a c
    #[2] gcd a (b * c) = gcd a b
  ← rewrite_goal mult_comm sym=false goal=2
    #[3] gcd a (c * b) = gcd a b
  ← apply_backward_step gcd_mul_coprime_1 goal=3 facts=[1]
qed

theorem coprime_1
  fixes a :: nat
  prop coprime a 1
  [hint_backward]
proof
  ← rewrite_goal coprime_gcd sym=false goal=0
    #[1] gcd a 1 = 1
  ← rewrite_goal gcd_1_right sym=false goal=1
qed

theorem gcd_coprime
  fixes a :: nat, b :: nat, c :: nat, d :: nat
  prop ~(gcd a b = 0) --> a = c * gcd a b --> b = d * gcd a b --> coprime c d
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ¬(gcd a b = 0)
    #[2] a = c * gcd a b
    #[3] b = d * gcd a b
    #[4] coprime c d
  ← rewrite_goal coprime_gcd sym=false goal=4
    #[5] gcd c d = 1
  -> apply_forward_step gcd_mult_right param_k="gcd a b" param_m=c param_n=d goal=5
    #[6] gcd (c * gcd a b) (d * gcd a b) = gcd a b * gcd c d
  -> rewrite_fact eq_sym_eq sym=false goal=5 facts=[2]
    #[7] c * gcd a b = a
  -> rewrite_fact eq_sym_eq sym=false goal=5 facts=[3]
    #[8] d * gcd a b = b
  -> rewrite_fact_with_prev goal=5 facts=[7,6]
    #[9] gcd a (d * gcd a b) = gcd a b * gcd c d
  -> rewrite_fact_with_prev goal=5 facts=[8,9]
    #[10] gcd a b = gcd a b * gcd c d
  cut "gcd a b = gcd a b * 1" goal=5 facts=[10]
    #[11] gcd a b = gcd a b * 1
  ← rewrite_goal mult_1_right sym=false goal=11
    #[12] gcd a b = gcd a b * 1
  -> rewrite_fact_with_prev goal=5 facts=[12,10]
    #[13] gcd a b * 1 = gcd a b * 1 * gcd c d
  -> rewrite_fact mult_assoc sym=false goal=5 facts=[13]
    #[14] gcd a b * 1 = gcd a b * (1 * gcd c d)
  -> rewrite_fact mult_1_left sym=false goal=5 facts=[14]
    #[15] gcd a b * 1 = gcd a b * gcd c d
  -> rewrite_fact eq_mult_lcancel sym=false goal=5 facts=[15]
    #[16] gcd a b = 0 ∨ 1 = gcd c d
  ← apply_backward_step disjE goal=5 facts=[16]
    #[17] gcd a b = 0 ⟶ gcd c d = 1
    #[18] 1 = gcd c d ⟶ gcd c d = 1
  ← introduction goal=17
    #[19] gcd a b = 0
    #[20] gcd c d = 1
  ← apply_backward_step negE_gen goal=20 facts=[1,19]
    #[21] gcd c d = 1
  ← introduction goal=18
    #[22] 1 = gcd c d
    #[23] gcd c d = 1
  ← rewrite_goal eq_sym_eq sym=false goal=23
qed

theorem gcd_coprime_exists
  fixes a :: nat, b :: nat
  prop ?c. ?d. a = c * gcd a b & b = d * gcd a b & coprime c d
  [hint_backward]
proof
  ← cases "gcd a b = 0" goal=0
    #[1] gcd a b = 0 ⟶ (∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d)
    #[2] ¬(gcd a b = 0) ⟶ (∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d)
  ← introduction goal=1
    #[3] gcd a b = 0
    #[4] ∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d
  -> rewrite_fact gcd_zero sym=false goal=4 facts=[3]
    #[5] a = 0 ∧ b = 0
  -> apply_forward_step conjD1 goal=4 facts=[5]
    #[6] a = 0
  -> apply_forward_step conjD2 goal=4 facts=[5]
    #[7] b = 0
  ← inst_exists_goal "(0::nat)" goal=4
    #[8] ∃d. a = 0 * gcd a b ∧ b = d * gcd a b ∧ coprime 0 d
  ← apply_backward_step exI param_a="(1::nat)" goal=8
    #[9] a = 0 * gcd a b ∧ b = 1 * gcd a b ∧ coprime 0 1
  ← rewrite_goal_with_prev goal=9 facts=[6]
    #[10] 0 = 0 * gcd 0 b ∧ b = 1 * gcd 0 b ∧ coprime 0 1
  ← rewrite_goal_with_prev goal=10 facts=[7]
    #[11] 0 = 0 * gcd 0 0 ∧ 0 = 1 * gcd 0 0 ∧ coprime 0 1
  ← apply_backward_step conjI goal=11
    #[12] 0 = 0 * gcd 0 0
    #[13] 0 = 1 * gcd 0 0 ∧ coprime 0 1
  ← rewrite_goal nat_times_def_1 sym=false goal=12
    #[14] 0 = 0 * gcd 0 0
  ← apply_backward_step conjI goal=13
    #[15] 0 = 1 * gcd 0 0
    #[16] coprime 0 1
  ← rewrite_goal gcd_refl sym=false goal=15
    #[17] (0::nat) = 1 * 0
  ← rewrite_goal mult_0_right sym=false goal=17
    #[18] (0::nat) = 1 * 0
  ← apply_backward_step coprime_1 goal=16
    #[19] coprime 0 1
  ← introduction goal=2
    #[20] ¬(gcd a b = 0)
    #[21] ∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d
  -> apply_forward_step gcd_divide1 param_m=a param_n=b goal=21
    #[22] divides (gcd a b) a
  -> apply_forward_step gcd_divides2 param_m=a param_n=b goal=21
    #[23] divides (gcd a b) b
  -> rewrite_fact divides_def sym=false goal=21 facts=[22]
    #[24] ∃k. a = gcd a b * k
  -> rewrite_fact divides_def sym=false goal=21 facts=[23]
    #[25] ∃k. b = gcd a b * k
  exists_elim k1 goal=21 facts=[24]
    #[26] _VAR k1
    #[27] a = gcd a b * k1
    #[28] ∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d
  exists_elim k2 goal=28 facts=[25]
    #[29] _VAR k2
    #[30] b = gcd a b * k2
    #[31] ∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d
  ← inst_exists_goal k1 goal=31
    #[32] ∃d. a = k1 * gcd a b ∧ b = d * gcd a b ∧ coprime k1 d
  ← inst_exists_goal k2 goal=32
    #[33] a = k1 * gcd a b ∧ b = k2 * gcd a b ∧ coprime k1 k2
  ← apply_backward_step conjI goal=33
    #[34] a = k1 * gcd a b
    #[35] b = k2 * gcd a b ∧ coprime k1 k2
  ← rewrite_goal mult_comm sym=false goal=34
  ← apply_backward_step conjI goal=35
    #[36] b = k2 * gcd a b
    #[37] coprime k1 k2
  ← rewrite_goal mult_comm sym=false goal=36
  ← apply_backward_step gcd_coprime param_a=a param_b=b goal=37
qed

theorem coprime_0
  fixes d :: nat
  prop coprime d 0 <--> d = 1
  [hint_rewrite]
proof
  ← rewrite_goal coprime_gcd sym=false goal=0
    #[1] gcd d 0 = 1 ⟷ d = 1
  ← rewrite_goal gcd_zero_right sym=false goal=1
qed

theorem coprime_mul
  fixes a :: nat, b :: nat, d :: nat
  prop coprime d a --> coprime d b --> coprime d (a * b)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] coprime d a
    #[2] coprime d b
    #[3] coprime d (a * b)
  ← rewrite_goal coprime_gcd sym=false goal=3
    #[4] gcd d (a * b) = 1
  -> rewrite_fact coprime_gcd sym=false goal=4 facts=[1]
    #[5] gcd d a = 1
  -> rewrite_fact coprime_gcd sym=false goal=4 facts=[2]
    #[6] gcd d b = 1
  -> apply_forward_step gcd_mul_coprime_1 param_c=b goal=4 facts=[1]
    #[7] gcd d (a * b) = gcd d b
  -> rewrite_fact_with_prev goal=4 facts=[6,7]
qed

theorem coprime_lmul2
  fixes a :: nat, b :: nat, d :: nat
  prop coprime d (a * b) --> coprime d b
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime d (a * b)
    #[2] coprime d b
  -> rewrite_fact coprime_gcd sym=false goal=2 facts=[1]
    #[3] gcd d (a * b) = 1
  ← rewrite_goal coprime_gcd sym=false goal=2
    #[4] gcd d b = 1
  -> rewrite_fact eq_sym_eq sym=false goal=4 facts=[3]
    #[5] 1 = gcd d (a * b)
  ← apply_backward_step divides_antisym goal=4
    #[6] divides (gcd d b) 1
    #[7] divides 1 (gcd d b)
  ← rewrite_goal_with_prev goal=6 facts=[5]
    #[8] divides (gcd d b) (gcd d (a * b))
  ← apply_backward_step gcd_is_max goal=8
    #[9] divides (gcd d b) d
    #[10] divides (gcd d b) (a * b)
  ← apply_backward_step gcd_divide1 goal=9
    #[11] divides (gcd d b) d
  ← apply_backward_step divides_lmul goal=10
    #[12] divides (gcd d b) b
  ← apply_backward_step gcd_divides2 goal=12
    #[13] divides (gcd d b) b
  ← apply_backward_step divides_1 goal=7
    #[14] divides 1 (gcd d b)
qed

theorem coprime_rmul2
  fixes a :: nat, b :: nat, d :: nat
  prop coprime d (a * b) --> coprime d a
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime d (a * b)
    #[2] coprime d a
  -> rewrite_fact mult_comm sym=false goal=2 facts=[1]
    #[3] coprime d (b * a)
  ← apply_backward_step coprime_lmul2 goal=2 facts=[3]
qed

theorem coprime_rmul
  fixes a :: nat, b :: nat, d :: nat
  prop coprime d (a * b) <--> coprime d a & coprime d b
  [hint_rewrite]
proof
  ← apply_backward_step iffI goal=0
    #[1] coprime d (a * b) ⟶ coprime d a ∧ coprime d b
    #[2] coprime d a ∧ coprime d b ⟶ coprime d (a * b)
  ← introduction goal=1
    #[3] coprime d (a * b)
    #[4] coprime d a ∧ coprime d b
  ← apply_backward_step conjI goal=4
    #[5] coprime d a
    #[6] coprime d b
  ← apply_backward_step coprime_rmul2 goal=5 facts=[3]
  ← apply_backward_step coprime_lmul2 goal=6 facts=[3]
  ← introduction goal=2
    #[7] coprime d a ∧ coprime d b
    #[8] coprime d (a * b)
  -> apply_forward_step conjD1 goal=8 facts=[7]
    #[9] coprime d a
  -> apply_forward_step conjD2 goal=8 facts=[7]
    #[10] coprime d b
  ← apply_backward_step coprime_mul goal=8
qed

theorem coprime_lmul
  fixes a :: nat, b :: nat, d :: nat
  prop coprime (a * b) d <--> coprime a d & coprime b d
  [hint_rewrite]
proof
  ← rewrite_goal coprime_sym sym=false goal=0
    #[1] coprime d (a * b) ⟷ coprime d a ∧ coprime d b
  ← rewrite_goal coprime_rmul sym=false goal=1
qed

theorem coprime_exp
  fixes a :: nat, d :: nat, n :: nat
  prop coprime d a --> coprime d (a ^ n)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime d a
    #[2] coprime d (a ^ n)
  ← induction n nat_induct goal=2
    #[3] coprime d (a ^ (0::nat))
    #[4] ∀n. coprime d (a ^ n) ⟶ coprime d (a ^ Suc n)
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=3
    #[5] coprime d 1
  ← apply_backward_step coprime_1 goal=5
    #[6] coprime d 1
  ← introduction n goal=4
    #[7] _VAR n
    #[8] coprime d (a ^ n)
    #[9] coprime d (a ^ Suc n)
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=9
    #[10] coprime d (a * a ^ n)
  ← apply_backward_step coprime_mul goal=10
qed

theorem coprime_exp_imp
  fixes a :: nat, b :: nat, n :: nat
  prop coprime a b --> coprime (a ^ n) (b ^ n)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime a b
    #[2] coprime (a ^ n) (b ^ n)
  ← apply_backward_step coprime_exp goal=2
    #[3] coprime (a ^ n) b
  ← rewrite_goal coprime_sym sym=false goal=3
    #[4] coprime b (a ^ n)
  ← apply_backward_step coprime_exp goal=4
    #[5] coprime b a
  ← rewrite_goal coprime_sym sym=false goal=5
qed

theorem coprime_rexp
  fixes k :: nat, m :: nat, n :: nat
  prop coprime m (n ^ k) <--> coprime m n | k = 0
  [hint_rewrite]
proof
  ← induction k nat_induct goal=0
    #[1] coprime m (n ^ (0::nat)) ⟷ coprime m n ∨ (0::nat) = 0
    #[2] ∀n1. coprime m (n ^ n1) ⟷ coprime m n ∨ n1 = 0 ⟶ coprime m (n ^ Suc n1) ⟷ coprime m n ∨ Suc n1 = 0
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=1
    #[3] coprime m 1 ⟷ coprime m n ∨ (0::nat) = 0
  ← apply_backward_step iffI goal=3
    #[4] coprime m 1 ⟶ coprime m n ∨ (0::nat) = 0
    #[5] coprime m n ∨ (0::nat) = 0 ⟶ coprime m 1
  ← introduction goal=4
    #[6] coprime m 1
    #[7] coprime m n ∨ (0::nat) = 0
  ← apply_backward_step disjI2 goal=7
    #[8] (0::nat) = 0
  ← apply_backward_step eq_refl goal=8
    #[9] (0::nat) = 0
  ← introduction goal=5
    #[10] coprime m n ∨ (0::nat) = 0
    #[11] coprime m 1
  ← apply_backward_step coprime_1 goal=11
    #[12] coprime m 1
  ← introduction n goal=2
    #[13] _VAR n
    #[14] coprime m (n ^ n) ⟷ coprime m n ∨ n = 0
    #[15] coprime m (n ^ Suc n) ⟷ coprime m n ∨ Suc n = 0
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=15
    #[16] coprime m (n * n ^ n) ⟷ coprime m n ∨ Suc n = 0
  ← rewrite_goal coprime_rmul sym=false goal=16
    #[17] coprime m n ∧ coprime m (n ^ n) ⟷ coprime m n ∨ Suc n = 0
  ← rewrite_goal_with_prev goal=17 facts=[14]
    #[18] coprime m n ∧ (coprime m n ∨ n = 0) ⟷ coprime m n ∨ Suc n = 0
  ← apply_backward_step iffI goal=18
    #[19] coprime m n ∧ (coprime m n ∨ n = 0) ⟶ coprime m n ∨ Suc n = 0
    #[20] coprime m n ∨ Suc n = 0 ⟶ coprime m n ∧ (coprime m n ∨ n = 0)
  ← introduction goal=19
    #[21] coprime m n ∧ (coprime m n ∨ n = 0)
    #[22] coprime m n ∨ Suc n = 0
  ← apply_backward_step disjI1 goal=22
    #[23] coprime m n
  ← apply_backward_step conjD1 goal=23 facts=[21]
    #[24] coprime m n
  ← introduction goal=20
    #[25] coprime m n ∨ Suc n = 0
    #[26] coprime m n ∧ (coprime m n ∨ n = 0)
  ← apply_backward_step disjE goal=26 facts=[25]
    #[27] coprime m n ⟶ coprime m n ∧ (coprime m n ∨ n = 0)
    #[28] Suc n = 0 ⟶ coprime m n ∧ (coprime m n ∨ n = 0)
  ← introduction goal=27
    #[29] coprime m n
    #[30] coprime m n ∧ (coprime m n ∨ n = 0)
  ← apply_backward_step conjI goal=30
    #[31] coprime m n ∨ n = 0
  ← apply_backward_step disjI1 goal=31
  ← introduction goal=28
    #[32] Suc n = 0
    #[33] coprime m n ∧ (coprime m n ∨ n = 0)
  ← apply_backward_step contrapositive goal=33 facts=[32]
    #[34] ¬(coprime m n ∧ (coprime m n ∨ n = 0)) ⟶ ¬(Suc n = 0)
  ← introduction goal=34
    #[35] ¬(coprime m n ∧ (coprime m n ∨ n = 0))
    #[36] ¬(Suc n = 0)
  ← apply_backward_step ineq_sym goal=36
    #[37] ¬(0 = Suc n)
  ← apply_backward_step nat_zero_Suc_neq goal=37
    #[38] ¬(0 = Suc n)
qed

theorem coprime_lexp
  fixes k :: nat, m :: nat, n :: nat
  prop coprime (m ^ k) n <--> coprime m n | k = 0
  [hint_rewrite]
proof
  ← rewrite_goal coprime_sym sym=false goal=0
    #[1] coprime n (m ^ k) ⟷ coprime n m ∨ k = 0
  ← rewrite_goal coprime_rexp sym=false goal=1
qed

theorem coprime_exp2
  fixes k :: nat, m :: nat, n :: nat
  prop coprime (m ^ k) (n ^ k) <--> coprime m n | k = 0
  [hint_rewrite]
proof
  ← rewrite_goal coprime_lexp sym=false goal=0
    #[1] coprime m (n ^ k) ∨ k = 0 ⟷ coprime m n ∨ k = 0
  ← rewrite_goal coprime_rexp sym=false goal=1
    #[2] (coprime m n ∨ k = 0) ∨ k = 0 ⟷ coprime m n ∨ k = 0
  ← apply_backward_step iffI goal=2
    #[3] (coprime m n ∨ k = 0) ∨ k = 0 ⟶ coprime m n ∨ k = 0
    #[4] coprime m n ∨ k = 0 ⟶ (coprime m n ∨ k = 0) ∨ k = 0
  ← introduction goal=3
    #[5] (coprime m n ∨ k = 0) ∨ k = 0
    #[6] coprime m n ∨ k = 0
  ← apply_backward_step disjE goal=6 facts=[5]
    #[7] coprime m n ∨ k = 0 ⟶ coprime m n ∨ k = 0
    #[8] k = 0 ⟶ coprime m n ∨ k = 0
  ← introduction goal=8
    #[9] k = 0
    #[10] coprime m n ∨ k = 0
  ← apply_backward_step disjI2 goal=10
  ← introduction goal=4
    #[11] coprime m n ∨ k = 0
    #[12] (coprime m n ∨ k = 0) ∨ k = 0
  ← apply_backward_step disjI1 goal=12
qed

theorem coprime_exp2_suc
  fixes k :: nat, m :: nat, n :: nat
  prop coprime (m ^ Suc k) (n ^ Suc k) <--> coprime m n
  [hint_rewrite]
proof
  ← rewrite_goal coprime_exp2 sym=false goal=0
    #[1] coprime m n ∨ Suc k = 0 ⟷ coprime m n
  ← apply_backward_step iffI goal=1
    #[2] coprime m n ∨ Suc k = 0 ⟶ coprime m n
    #[3] coprime m n ⟶ coprime m n ∨ Suc k = 0
  ← introduction goal=2
    #[4] coprime m n ∨ Suc k = 0
    #[5] coprime m n
  ← apply_backward_step disjE goal=5 facts=[4]
    #[6] coprime m n ⟶ coprime m n
    #[7] Suc k = 0 ⟶ coprime m n
  ← introduction goal=7
    #[8] Suc k = 0
    #[9] coprime m n
  ← apply_backward_step contrapositive goal=9 facts=[8]
    #[10] ¬(coprime m n) ⟶ ¬(Suc k = 0)
  ← introduction goal=10
    #[11] ¬(coprime m n)
    #[12] ¬(Suc k = 0)
  ← apply_backward_step ineq_sym goal=12
    #[13] ¬(0 = Suc k)
  ← apply_backward_step nat_zero_Suc_neq goal=13
    #[14] ¬(0 = Suc k)
  ← introduction goal=3
    #[15] coprime m n
    #[16] coprime m n ∨ Suc k = 0
  ← apply_backward_step disjI1 goal=16
qed

theorem coprime_refl
  fixes n :: nat
  prop coprime n n <--> n = 1
  [hint_rewrite]
proof
  ← rewrite_goal coprime_gcd sym=false goal=0
    #[1] gcd n n = 1 ⟷ n = 1
  ← rewrite_goal gcd_refl sym=false goal=1
qed

theorem coprime_plus1
  fixes n :: nat
  prop coprime (n + 1) n
  [hint_backward]
proof
  ← rewrite_goal coprime_gcd sym=false goal=0
    #[1] gcd (n + 1) n = 1
  ← rewrite_goal gcd_add_right sym=false goal=1
    #[2] gcd n 1 = 1
  ← rewrite_goal gcd_1_right sym=false goal=2
qed

theorem coprime_minus1
  fixes n :: nat
  prop ~(n = 0) --> coprime (n - 1) n
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ¬(n = 0)
    #[2] coprime (n - 1) n
  ← rewrite_goal coprime_sym sym=false goal=2
    #[3] coprime n (n - 1)
  cut "coprime ((n - 1) + 1) (n - 1)" goal=3
    #[4] coprime (n - 1 + 1) (n - 1)
  ← apply_backward_step coprime_plus1 goal=4
    #[5] coprime (n - 1 + 1) (n - 1)
  cut "n - 1 + 1 = n" goal=3
    #[6] n - 1 + 1 = n
  ← apply_backward_step sub_add goal=6
    #[7] 1 ≤ n
  ← apply_backward_step le_1_2 goal=7
  -> rewrite_fact_with_prev goal=3 facts=[6,5]
qed

theorem gcd_exp
  fixes k :: nat, m :: nat, n :: nat
  prop gcd (m ^ k) (n ^ k) = gcd m n ^ k
  [hint_rewrite]
proof
  -> apply_forward_step gcd_coprime_exists param_a=m param_b=n goal=0
    #[1] ∃c. ∃d. m = c * gcd m n ∧ n = d * gcd m n ∧ coprime c d
  exists_elim c,d goal=0 facts=[1]
    #[2] _VAR c
    #[3] _VAR d
    #[4] m = c * gcd m n ∧ n = d * gcd m n ∧ coprime c d
    #[5] gcd (m ^ k) (n ^ k) = gcd m n ^ k
  -> apply_forward_step conjD1 goal=5 facts=[4]
    #[6] m = c * gcd m n
  -> apply_forward_step conjD2 goal=5 facts=[4]
    #[7] n = d * gcd m n ∧ coprime c d
  -> apply_forward_step conjD1 goal=5 facts=[7]
    #[8] n = d * gcd m n
  -> apply_forward_step conjD2 goal=5 facts=[7]
    #[9] coprime c d
  ← rewrite_goal_with_prev goal=5 facts=[6]
    #[10] gcd ((c * gcd m n) ^ k) (n ^ k) = gcd (c * gcd m n) n ^ k
  cut "gcd ((c * gcd m n) ^ k) ((d * gcd m n) ^ k) = gcd (c * gcd m n) (d * gcd m n) ^ k" goal=10
    #[11] gcd ((c * gcd m n) ^ k) ((d * gcd m n) ^ k) = gcd (c * gcd m n) (d * gcd m n) ^ k
  ← rewrite_goal mult_exp sym=false goal=11
    #[12] gcd (c ^ k * gcd m n ^ k) (d ^ k * gcd m n ^ k) = gcd (c * gcd m n) (d * gcd m n) ^ k
  ← rewrite_goal gcd_mult_right sym=false goal=12
    #[13] gcd m n ^ k * gcd (c ^ k) (d ^ k) = (gcd m n * gcd c d) ^ k
  -> rewrite_fact coprime_gcd sym=false goal=13 facts=[9]
    #[14] gcd c d = 1
  ← rewrite_goal_with_prev goal=13 facts=[14]
    #[15] gcd m n ^ k * gcd (c ^ k) (d ^ k) = (gcd m n * 1) ^ k
  ← rewrite_goal mult_1_right sym=false goal=15
    #[16] gcd m n ^ k * gcd (c ^ k) (d ^ k) = gcd m n ^ k
  cut "gcd m n ^ k = gcd m n ^ k * 1" goal=16
    #[17] gcd m n ^ k = gcd m n ^ k * 1
  ← rewrite_goal mult_1_right sym=false goal=17
    #[18] gcd m n ^ k = gcd m n ^ k * 1
  ← rewrite_goal_with_prev goal=16 facts=[18]
    #[19] gcd m n ^ k * 1 * gcd (c ^ k) (d ^ k) = gcd m n ^ k * 1
  ← rewrite_goal mult_assoc sym=false goal=19
    #[20] gcd m n ^ k * (1 * gcd (c ^ k) (d ^ k)) = gcd m n ^ k * 1
  ← rewrite_goal mult_1_left sym=false goal=20
    #[21] gcd m n ^ k * gcd (c ^ k) (d ^ k) = gcd m n ^ k * 1
  ← rewrite_goal eq_mult_lcancel sym=false goal=21
    #[22] gcd m n ^ k = 0 ∨ gcd (c ^ k) (d ^ k) = 1
  ← apply_backward_step disjI2 goal=22
    #[23] gcd (c ^ k) (d ^ k) = 1
  ← rewrite_goal coprime_gcd sym=true goal=23
    #[24] coprime (c ^ k) (d ^ k)
  ← rewrite_goal coprime_exp2 sym=false goal=24
    #[25] coprime c d ∨ k = 0
  ← apply_backward_step disjI1 goal=25
  -> rewrite_fact eq_sym_eq sym=false goal=10 facts=[8]
    #[26] d * gcd m n = n
  -> rewrite_fact_with_prev goal=10 facts=[26,11]
qed

theorem division_decomp
  fixes a :: nat, b :: nat, c :: nat
  prop divides a (b * c) --> (?b1. ?c1. a = b1 * c1 & divides b1 b & divides c1 c)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] divides a (b * c)
    #[2] ∃b1. ∃c1. a = b1 * c1 ∧ divides b1 b ∧ divides c1 c
  ← inst_exists_goal "gcd a b" goal=2
    #[3] ∃c1. a = gcd a b * c1 ∧ divides (gcd a b) b ∧ divides c1 c
  ← cases "gcd a b =0" goal=3
    #[4] gcd a b = 0 ⟶ (∃c1. a = gcd a b * c1 ∧ divides (gcd a b) b ∧ divides c1 c)
    #[5] ¬(gcd a b = 0) ⟶ (∃c1. a = gcd a b * c1 ∧ divides (gcd a b) b ∧ divides c1 c)
  ← introduction goal=4
    #[6] gcd a b = 0
    #[7] ∃c1. a = gcd a b * c1 ∧ divides (gcd a b) b ∧ divides c1 c
  ← inst_exists_goal "(1::nat)" goal=7
    #[8] a = gcd a b * 1 ∧ divides (gcd a b) b ∧ divides 1 c
  ← apply_backward_step conjI goal=8
    #[9] a = gcd a b * 1
    #[10] divides (gcd a b) b ∧ divides 1 c
  ← rewrite_goal_with_prev goal=9 facts=[6]
    #[11] a = 0 * 1
  -> rewrite_fact gcd_zero sym=false goal=11 facts=[6]
    #[12] a = 0 ∧ b = 0
  -> apply_forward_step conjD1 goal=11 facts=[12]
    #[13] a = 0
  ← rewrite_goal_with_prev goal=11 facts=[13]
    #[14] (0::nat) = 0 * 1
  ← rewrite_goal mult_1_right sym=false goal=14
    #[15] (0::nat) = 0 * 1
  ← apply_backward_step conjI goal=10
    #[16] divides (gcd a b) b
    #[17] divides 1 c
  ← apply_backward_step gcd_divides2 goal=16
    #[18] divides (gcd a b) b
  ← apply_backward_step divides_1 goal=17
    #[19] divides 1 c
  ← introduction goal=5
    #[20] ¬(gcd a b = 0)
    #[21] ∃c1. a = gcd a b * c1 ∧ divides (gcd a b) b ∧ divides c1 c
  -> apply_forward_step gcd_coprime_exists param_a=a param_b=b goal=21
    #[22] ∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d
  exists_elim e,f goal=21 facts=[22]
    #[23] _VAR e
    #[24] _VAR f
    #[25] a = e * gcd a b ∧ b = f * gcd a b ∧ coprime e f
    #[26] ∃c1. a = gcd a b * c1 ∧ divides (gcd a b) b ∧ divides c1 c
  ← inst_exists_goal e goal=26
    #[27] a = gcd a b * e ∧ divides (gcd a b) b ∧ divides e c
  -> apply_forward_step conjD1 goal=27 facts=[25]
    #[28] a = e * gcd a b
  ← apply_backward_step conjI goal=27
    #[29] a = gcd a b * e
    #[30] divides (gcd a b) b ∧ divides e c
  -> rewrite_fact mult_comm sym=false goal=29 facts=[28]
    #[31] a = gcd a b * e
  ← apply_backward_step conjI goal=30
    #[32] divides (gcd a b) b
    #[33] divides e c
  ← apply_backward_step gcd_divides2 goal=32
  -> apply_forward_step conjD2 goal=33 facts=[25]
    #[34] b = f * gcd a b ∧ coprime e f
  -> apply_forward_step conjD1 goal=33 facts=[34]
    #[35] b = f * gcd a b
  -> apply_forward_step conjD2 goal=33 facts=[34]
    #[36] coprime e f
  ← apply_backward_step coprime_divprod param_a=f goal=33
    #[37] divides e (f * c)
  ← apply_backward_step divides_cmul2 param_c="gcd a b" goal=37
    #[38] divides (gcd a b * e) (gcd a b * (f * c))
  -> rewrite_fact eq_sym_eq sym=false goal=38 facts=[31]
    #[39] gcd a b * e = a
  -> rewrite_fact mult_comm sym=false goal=38 facts=[35]
    #[40] b = gcd a b * f
  -> rewrite_fact eq_sym_eq sym=false goal=38 facts=[40]
    #[41] gcd a b * f = b
  ← rewrite_goal mult_assoc sym=true goal=38
    #[42] divides (gcd a b * e) (gcd a b * f * c)
  ← rewrite_goal_with_prev goal=42 facts=[39]
    #[43] divides a (gcd a b * f * c)
  ← rewrite_goal_with_prev goal=43 facts=[41]
qed

theorem divides_exp2_rev
  fixes a :: nat, b :: nat, n :: nat
  prop divides (a ^ n) (b ^ n) --> ~(n = 0) --> divides a b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] divides (a ^ n) (b ^ n)
    #[2] ¬(n = 0)
    #[3] divides a b
  ← cases "gcd a b = 0" goal=3
    #[4] gcd a b = 0 ⟶ divides a b
    #[5] ¬(gcd a b = 0) ⟶ divides a b
  ← introduction goal=4
    #[6] gcd a b = 0
    #[7] divides a b
  -> rewrite_fact gcd_zero sym=false goal=7 facts=[6]
    #[8] a = 0 ∧ b = 0
  -> apply_forward_step conjD1 goal=7 facts=[8]
    #[9] a = 0
  -> apply_forward_step conjD2 goal=7 facts=[8]
    #[10] b = 0
  ← rewrite_goal_with_prev goal=7 facts=[10]
    #[11] divides a 0
  ← apply_backward_step divides_zero goal=11
    #[12] divides a 0
  ← introduction goal=5
    #[13] ¬(gcd a b = 0)
    #[14] divides a b
  -> apply_forward_step gcd_coprime_exists param_a=a param_b=b goal=14
    #[15] ∃c. ∃d. a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d
  exists_elim c,d goal=14 facts=[15]
    #[16] _VAR c
    #[17] _VAR d
    #[18] a = c * gcd a b ∧ b = d * gcd a b ∧ coprime c d
    #[19] divides a b
  -> apply_forward_step conjD1 goal=19 facts=[18]
    #[20] a = c * gcd a b
  -> apply_forward_step conjD2 goal=19 facts=[18]
    #[21] b = d * gcd a b ∧ coprime c d
  -> apply_forward_step conjD2 goal=19 facts=[21]
    #[22] coprime c d
  -> apply_forward_step conjD1 goal=19 facts=[21]
    #[23] b = d * gcd a b
  -> rewrite_fact_with_prev goal=19 facts=[20,1]
    #[24] divides ((c * gcd a b) ^ n) (b ^ n)
  cut "divides ((c * gcd a b) ^ n) ((d * gcd a b) ^ n)" goal=19 facts=[24]
    #[25] divides ((c * gcd a b) ^ n) ((d * gcd a b) ^ n)
  -> rewrite_fact eq_sym_eq sym=false goal=25 facts=[23]
    #[26] d * gcd a b = b
  ← rewrite_goal_with_prev goal=25 facts=[26]
  -> rewrite_fact mult_exp sym=false goal=19 facts=[25]
    #[27] divides (c ^ n * gcd a b ^ n) (d ^ n * gcd a b ^ n)
  -> rewrite_fact mult_comm sym=false goal=19 facts=[27]
    #[28] divides (gcd a b ^ n * c ^ n) (gcd a b ^ n * d ^ n)
  -> apply_forward_step divides_cmul2 goal=19 facts=[28]
    #[29] ¬(gcd a b ^ n = 0) ⟶ divides (c ^ n) (d ^ n)
  cut "¬(gcd a b ^ n = 0)" goal=19
    #[30] ¬(gcd a b ^ n = 0)
  ← rewrite_goal exp_eq_0 sym=false goal=30
    #[31] ¬(gcd a b = 0 ∧ ¬(n = 0))
  ← rewrite_goal de_morgan_thm1 sym=false goal=31
    #[32] ¬(gcd a b = 0) ∨ ¬¬(n = 0)
  ← apply_backward_step disjI1 goal=32
  -> apply_fact goal=19 facts=[29,30]
    #[33] divides (c ^ n) (d ^ n)
  ← rewrite_goal_with_prev goal=19 facts=[20]
    #[34] divides (c * gcd a b) b
  cut "divides (c * gcd a b) (d * gcd a b)" goal=34
    #[35] divides (c * gcd a b) (d * gcd a b)
  ← apply_backward_step divides_mult_right goal=35
    #[36] divides c d
  -> rewrite_fact divides_gcd_left sym=false goal=36 facts=[33]
    #[37] gcd (c ^ n) (d ^ n) = c ^ n
  -> rewrite_fact gcd_exp sym=false goal=36 facts=[37]
    #[38] gcd c d ^ n = c ^ n
  -> rewrite_fact coprime_gcd sym=false goal=36 facts=[22]
    #[39] gcd c d = 1
  -> rewrite_fact_with_prev goal=36 facts=[39,38]
    #[40] 1 ^ n = c ^ n
  -> rewrite_fact exp_mono_eq sym=false goal=36 facts=[40]
    #[41] 1 = c ∨ n = 0
  ← apply_backward_step disjE goal=36 facts=[41]
    #[42] 1 = c ⟶ divides c d
    #[43] n = 0 ⟶ divides c d
  ← introduction goal=42
    #[44] 1 = c
    #[45] divides c d
  -> rewrite_fact eq_sym_eq sym=false goal=45 facts=[44]
    #[46] c = 1
  ← rewrite_goal_with_prev goal=45 facts=[46]
    #[47] divides 1 d
  ← apply_backward_step divides_1 goal=47
    #[48] divides 1 d
  ← introduction goal=43
    #[49] n = 0
    #[50] divides c d
  ← apply_backward_step negE_gen goal=50 facts=[2,49]
    #[51] divides c d
  -> rewrite_fact_with_prev goal=34 facts=[26,35]
qed

theorem divides_exp2_eq
  fixes a :: nat, b :: nat, n :: nat
  prop ~(n = 0) --> divides (a ^ n) (b ^ n) <--> divides a b
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ¬(n = 0)
    #[2] divides (a ^ n) (b ^ n) ⟷ divides a b
  ← apply_backward_step iffI goal=2
    #[3] divides (a ^ n) (b ^ n) ⟶ divides a b
    #[4] divides a b ⟶ divides (a ^ n) (b ^ n)
  ← introduction goal=3
    #[5] divides (a ^ n) (b ^ n)
    #[6] divides a b
  ← apply_backward_step divides_exp2_rev goal=6 facts=[5,1]
  ← introduction goal=4
    #[7] divides a b
    #[8] divides (a ^ n) (b ^ n)
  ← apply_backward_step divides_exp goal=8 facts=[7]
    #[9] divides (a ^ n) (b ^ n)
qed

theorem divides_mul
  fixes m :: nat, n :: nat, r :: nat
  prop divides m r --> divides n r --> coprime m n --> divides (m * n) r
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] divides m r
    #[2] divides n r
    #[3] coprime m n
    #[4] divides (m * n) r
  -> rewrite_fact divides_def sym=false goal=4 facts=[1]
    #[5] ∃k. r = m * k
  -> rewrite_fact divides_def sym=false goal=4 facts=[2]
    #[6] ∃k. r = n * k
  exists_elim k1 goal=4 facts=[5]
    #[7] _VAR k1
    #[8] r = m * k1
    #[9] divides (m * n) r
  exists_elim k2 goal=9 facts=[6]
    #[10] _VAR k2
    #[11] r = n * k2
    #[12] divides (m * n) r
  ← rewrite_goal_with_prev goal=12 facts=[8]
    #[13] divides (m * n) (m * k1)
  ← apply_backward_step divides_mult_left goal=13
    #[14] divides n k1
  ← apply_backward_step coprime_divprod param_a=m goal=14
    #[15] divides n (m * k1)
    #[16] coprime n m
  -> rewrite_fact eq_sym_eq sym=false goal=15 facts=[8]
    #[17] m * k1 = r
  ← rewrite_goal_with_prev goal=15 facts=[17]
  ← rewrite_goal coprime_sym sym=false goal=16
qed

theorem gcd_coprime_lmul
  fixes a :: nat, b :: nat, c :: nat
  prop coprime a b --> gcd (a * b) c = gcd a c * gcd b c
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime a b
    #[2] gcd (a * b) c = gcd a c * gcd b c
  -> apply_forward_step gcd_divide1 param_m=a param_n=c goal=2
    #[3] divides (gcd a c) a
  -> apply_forward_step gcd_divides2 param_m=a param_n=c goal=2
    #[4] divides (gcd a c) c
  -> rewrite_fact divides_def sym=false goal=2 facts=[3]
    #[5] ∃k. a = gcd a c * k
  -> rewrite_fact divides_def sym=false goal=2 facts=[4]
    #[6] ∃k. c = gcd a c * k
  exists_elim k1 goal=2 facts=[5]
    #[7] _VAR k1
    #[8] a = gcd a c * k1
    #[9] gcd (a * b) c = gcd a c * gcd b c
  exists_elim k2 goal=9 facts=[6]
    #[10] _VAR k2
    #[11] c = gcd a c * k2
    #[12] gcd (a * b) c = gcd a c * gcd b c
  cut "gcd (a * b) c = gcd (gcd a c * k1 * b) (gcd a c * k2) " goal=12
    #[13] gcd (a * b) c = gcd (gcd a c * k1 * b) (gcd a c * k2)
  -> rewrite_fact eq_sym_eq sym=false goal=13 facts=[8]
    #[14] gcd a c * k1 = a
  -> rewrite_fact eq_sym_eq sym=false goal=13 facts=[11]
    #[15] gcd a c * k2 = c
  ← rewrite_goal_with_prev goal=13 facts=[14]
    #[16] gcd (a * b) c = gcd (a * b) (gcd a c * k2)
  ← rewrite_goal_with_prev goal=16 facts=[15]
    #[17] gcd (a * b) c = gcd (a * b) (gcd a c * k2)
  -> rewrite_fact mult_assoc sym=false goal=12 facts=[13]
    #[18] gcd (a * b) c = gcd (gcd a c * (k1 * b)) (gcd a c * k2)
  -> rewrite_fact gcd_mult_left sym=false goal=12 facts=[18]
    #[19] gcd (a * b) c = gcd a c * gcd (k1 * b) k2
  ← rewrite_goal_with_prev goal=12 facts=[19]
    #[20] gcd a c * gcd (k1 * b) k2 = gcd a c * gcd b c
  ← rewrite_goal eq_mult_lcancel sym=false goal=20
    #[21] gcd a c = 0 ∨ gcd (k1 * b) k2 = gcd b c
  ← cases "gcd a c = 0" goal=21
    #[22] gcd a c = 0 ⟶ gcd a c = 0 ∨ gcd (k1 * b) k2 = gcd b c
    #[23] ¬(gcd a c = 0) ⟶ gcd a c = 0 ∨ gcd (k1 * b) k2 = gcd b c
  ← introduction goal=22
    #[24] gcd a c = 0
    #[25] gcd a c = 0 ∨ gcd (k1 * b) k2 = gcd b c
  ← apply_backward_step disjI1 goal=25
  ← introduction goal=23
    #[26] ¬(gcd a c = 0)
    #[27] gcd a c = 0 ∨ gcd (k1 * b) k2 = gcd b c
  ← apply_backward_step disjI2 goal=27
    #[28] gcd (k1 * b) k2 = gcd b c
  ← apply_backward_step divides_antisym goal=28
    #[29] divides (gcd (k1 * b) k2) (gcd b c)
    #[30] divides (gcd b c) (gcd (k1 * b) k2)
  ← apply_backward_step gcd_is_max goal=29
    #[31] divides (gcd (k1 * b) k2) b
    #[32] divides (gcd (k1 * b) k2) c
  ← apply_backward_step coprime_divprod param_a=k1 goal=31
    #[33] divides (gcd (k1 * b) k2) (k1 * b)
    #[34] coprime (gcd (k1 * b) k2) k1
  ← apply_backward_step gcd_divide1 goal=33
    #[35] divides (gcd (k1 * b) k2) (k1 * b)
  ← rewrite_goal coprime_gcd sym=false goal=34
    #[36] gcd (gcd (k1 * b) k2) k1 = 1
  cut "gcd (k1 * b) k2 = gcd k2 (k1 * b)" goal=36
    #[37] gcd (k1 * b) k2 = gcd k2 (k1 * b)
  ← apply_backward_step gcd_comm goal=37
    #[38] gcd (k1 * b) k2 = gcd k2 (k1 * b)
  ← rewrite_goal_with_prev goal=36 facts=[38]
    #[39] gcd (gcd k2 (k1 * b)) k1 = 1
  ← rewrite_goal gcd_assoc sym=false goal=39
    #[40] gcd k2 (gcd (k1 * b) k1) = 1
  cut "divides k1 (k1 * b)" goal=40
    #[41] divides k1 (k1 * b)
  ← apply_backward_step divides_rmul goal=41
    #[42] divides k1 k1
  ← apply_backward_step divides_self goal=42
    #[43] divides k1 k1
  -> rewrite_fact divides_gcd_right sym=false goal=40 facts=[41]
    #[44] gcd (k1 * b) k1 = k1
  ← rewrite_goal_with_prev goal=40 facts=[44]
    #[45] gcd k2 k1 = 1
  ← rewrite_goal coprime_gcd sym=true goal=45
    #[46] coprime k2 k1
  ← rewrite_goal coprime_sym sym=false goal=46
    #[47] coprime k1 k2
  ← apply_backward_step gcd_coprime goal=47 facts=[26]
    #[48] a = k1 * gcd a c
    #[49] c = k2 * gcd a c
  ← rewrite_goal mult_comm sym=false goal=48
  ← rewrite_goal mult_comm sym=false goal=49
  ← apply_backward_step divides_trans param_m=k2 goal=32
    #[50] divides (gcd (k1 * b) k2) k2
    #[51] divides k2 c
  ← apply_backward_step gcd_divides2 goal=50
    #[52] divides (gcd (k1 * b) k2) k2
  ← rewrite_goal_with_prev goal=51 facts=[11]
    #[53] divides k2 (gcd a c * k2)
  ← apply_backward_step divides_lmul goal=53
    #[54] divides k2 k2
  ← apply_backward_step divides_self goal=54
    #[55] divides k2 k2
  ← apply_backward_step gcd_is_max goal=30
    #[56] divides (gcd b c) (k1 * b)
    #[57] divides (gcd b c) k2
  ← apply_backward_step divides_lmul goal=56
    #[58] divides (gcd b c) b
  ← apply_backward_step gcd_divide1 goal=58
    #[59] divides (gcd b c) b
  ← apply_backward_step divides_cmul2 param_c="gcd a c" goal=57
    #[60] divides (gcd a c * gcd b c) (gcd a c * k2)
  ← rewrite_goal_with_prev goal=60 facts=[15]
    #[61] divides (gcd a c * gcd b c) c
  ← apply_backward_step divides_mul goal=61
    #[62] divides (gcd b c) c
    #[63] coprime (gcd a c) (gcd b c)
  ← apply_backward_step gcd_divides2 goal=62
    #[64] divides (gcd b c) c
  ← rewrite_goal coprime_gcd sym=false goal=63
    #[65] gcd (gcd a c) (gcd b c) = 1
  ← rewrite_goal gcd_assoc sym=false goal=65
    #[66] gcd a (gcd c (gcd b c)) = 1
  ← rewrite_goal gcd_comm sym=false goal=66
    #[67] gcd (gcd c (gcd b c)) a = 1
  cut "(gcd b c) = (gcd c b)" goal=67
    #[68] gcd b c = gcd c b
  ← apply_backward_step gcd_comm goal=68
    #[69] gcd b c = gcd c b
  ← rewrite_goal_with_prev goal=67 facts=[69]
    #[70] gcd (gcd c (gcd c b)) a = 1
  ← rewrite_goal gcd_assoc sym=true goal=70
    #[71] gcd (gcd (gcd c c) b) a = 1
  ← rewrite_goal gcd_refl sym=false goal=71
    #[72] gcd (gcd c b) a = 1
  ← rewrite_goal gcd_assoc sym=false goal=72
    #[73] gcd c (gcd b a) = 1
  -> rewrite_fact coprime_gcd sym=false goal=73 facts=[1]
    #[74] gcd a b = 1
  -> rewrite_fact gcd_comm sym=false goal=73 facts=[74]
    #[75] gcd b a = 1
  ← rewrite_goal_with_prev goal=73 facts=[75]
    #[76] gcd c 1 = 1
  ← rewrite_goal gcd_1_right sym=false goal=76
    #[77] gcd c 1 = 1
qed

theorem gcd_coprime_rmul
  fixes a :: nat, b :: nat, c :: nat
  prop coprime a b --> gcd c (a * b) = gcd c a * gcd c b
proof
  ← introduction goal=0
    #[1] coprime a b
    #[2] gcd c (a * b) = gcd c a * gcd c b
  ← rewrite_goal gcd_comm sym=false goal=2
    #[3] gcd (a * b) c = gcd a c * gcd b c
  ← apply_backward_step gcd_coprime_lmul goal=3 facts=[1]
qed

theorem chinese_reminder
  fixes a :: nat, b :: nat, u :: nat, v :: nat
  prop coprime a b --> ~(a = 0) --> ~(b = 0) --> (?x. ?q1. ?q2. x = u + q1 * a & x = v + q2 * b)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] coprime a b
    #[2] ¬(a = 0)
    #[3] ¬(b = 0)
    #[4] ∃x. ∃q1. ∃q2. x = u + q1 * a ∧ x = v + q2 * b
  cut "!P::nat⇒nat⇒nat⇒bool. (?d. ?x. ?y. (d = 1) & P x y d) <--> (?x. ?y. P x y 1)" goal=4
    #[5] ∀P. (∃d::nat. ∃x::nat. ∃y::nat. d = 1 ∧ P x y d) ⟷ (∃x. ∃y. P x y 1)
  ← introduction P goal=5
    #[6] _VAR P
    #[7] (∃d. ∃x. ∃y. d = 1 ∧ P x y d) ⟷ (∃x. ∃y. P x y 1)
  ← apply_backward_step iffI goal=7
    #[8] (∃d. ∃x. ∃y. d = 1 ∧ P x y d) ⟶ (∃x. ∃y. P x y 1)
    #[9] (∃x. ∃y. P x y 1) ⟶ (∃d. ∃x. ∃y. d = 1 ∧ P x y d)
  ← introduction goal=8
    #[10] ∃d. ∃x. ∃y. d = 1 ∧ P x y d
    #[11] ∃x. ∃y. P x y 1
  exists_elim d,x,y goal=11 facts=[10]
    #[12] _VAR d
    #[13] _VAR x
    #[14] _VAR y
    #[15] d = 1 ∧ P x y d
    #[16] ∃x. ∃y. P x y 1
  -> apply_forward_step conjD1 goal=16 facts=[15]
    #[17] d = 1
  -> apply_forward_step conjD2 goal=16 facts=[15]
    #[18] P x y d
  -> rewrite_fact_with_prev goal=16 facts=[17,18]
    #[19] P x y 1
  ← inst_exists_goal x goal=16
    #[20] ∃y. P x y 1
  ← inst_exists_goal y goal=20
  ← introduction goal=9
    #[21] ∃x. ∃y. P x y 1
    #[22] ∃d. ∃x. ∃y. d = 1 ∧ P x y d
  exists_elim x,y goal=22 facts=[21]
    #[23] P x y 1
    #[24] ∃d. ∃x. ∃y. d = 1 ∧ P x y d
  ← inst_exists_goal "(1::nat)" goal=24
    #[25] ∃x. ∃y. (1::nat) = 1 ∧ P x y 1
  ← inst_exists_goal x goal=25
    #[26] ∃y. (1::nat) = 1 ∧ P x y 1
  ← inst_exists_goal y goal=26
    #[27] (1::nat) = 1 ∧ P x y 1
  ← apply_backward_step conjI goal=27
    #[28] (1::nat) = 1
  ← apply_backward_step eq_refl goal=28
    #[29] (1::nat) = 1
  -> apply_forward_step bezout_add_strong param_a=b param_b=a goal=4
    #[30] ¬(b = 0) ⟶ (∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ b * x = a * y + d)
  -> apply_forward_step bezout_add_strong param_a=a param_b=b goal=4
    #[31] ¬(a = 0) ⟶ (∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d)
  -> rewrite_fact coprime_def sym=false goal=4 facts=[1]
    #[32] ∀d. divides d a ∧ divides d b ⟷ d = 1
  -> apply_fact goal=4 facts=[31,2]
    #[33] ∃d. ∃x. ∃y. (divides d a ∧ divides d b) ∧ a * x = b * y + d
  -> apply_fact goal=4 facts=[30,3]
    #[34] ∃d. ∃x. ∃y. (divides d b ∧ divides d a) ∧ b * x = a * y + d
  -> rewrite_fact_with_prev goal=4 facts=[32,33]
    #[35] ∃d. ∃x. ∃y. d = 1 ∧ a * x = b * y + d
  -> rewrite_fact conj_comm sym=false goal=4 facts=[32]
    #[36] ∀d. divides d b ∧ divides d a ⟷ d = 1
  -> rewrite_fact_with_prev goal=4 facts=[36,34]
    #[37] ∃d. ∃x. ∃y. d = 1 ∧ b * x = a * y + d
  -> rewrite_fact_with_prev goal=4 facts=[5,35]
    #[38] ∃x. ∃y. a * x = b * y + 1
  -> rewrite_fact_with_prev goal=4 facts=[5,37]
    #[39] ∃x. ∃y. b * x = a * y + 1
  exists_elim x1,y1 goal=4 facts=[38]
    #[40] _VAR x1
    #[41] _VAR y1
    #[42] a * x1 = b * y1 + 1
    #[43] ∃x. ∃q1. ∃q2. x = u + q1 * a ∧ x = v + q2 * b
  exists_elim x2,y2 goal=43 facts=[39]
    #[44] _VAR x2
    #[45] _VAR y2
    #[46] b * x2 = a * y2 + 1
    #[47] ∃x. ∃q1. ∃q2. x = u + q1 * a ∧ x = v + q2 * b
  ← inst_exists_goal "v * a * x1 + u * b * x2" goal=47
    #[48] ∃q1. ∃q2. v * a * x1 + u * b * x2 = u + q1 * a ∧ v * a * x1 + u * b * x2 = v + q2 * b
  ← inst_exists_goal "v * x1 + u * y2" goal=48
    #[49] ∃q2. v * a * x1 + u * b * x2 = u + (v * x1 + u * y2) * a ∧ v * a * x1 + u * b * x2 = v + q2 * b
  ← inst_exists_goal "v * y1 + u * x2" goal=49
    #[50] v * a * x1 + u * b * x2 = u + (v * x1 + u * y2) * a ∧ v * a * x1 + u * b * x2 = v + (v * y1 + u * x2) * b
  ← apply_backward_step conjI goal=50
    #[51] v * a * x1 + u * b * x2 = u + (v * x1 + u * y2) * a
    #[52] v * a * x1 + u * b * x2 = v + (v * y1 + u * x2) * b
  ← rewrite_goal mult_assoc sym=false goal=51
    #[53] v * (a * x1) + u * (b * x2) = u + (v * x1 + u * y2) * a
  ← rewrite_goal_with_prev goal=53 facts=[46]
    #[54] v * (a * x1) + u * (a * y2 + 1) = u + (v * x1 + u * y2) * a
  nat_norm goal=54
    #[55] v * (a * x1) + u * (a * y2 + 1) = u + (v * x1 + u * y2) * a
  ← rewrite_goal mult_assoc sym=false goal=52
    #[56] v * (a * x1) + u * (b * x2) = v + (v * y1 + u * x2) * b
  ← rewrite_goal_with_prev goal=56 facts=[42]
    #[57] v * (b * y1 + 1) + u * (b * x2) = v + (v * y1 + u * x2) * b
  nat_norm goal=57
    #[58] v * (b * y1 + 1) + u * (b * x2) = v + (v * y1 + u * x2) * b
qed

def prime :: nat ⇒ bool = prime p ⟷ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p) [hint_rewrite]

theorem one_or_prime
  fixes p :: nat
  prop p = 1 | prime p <--> (!n. divides n p --> n = 1 | n = p)
  [hint_rewrite]
proof
  ← rewrite_goal prime_def sym=false goal=0
    #[1] p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p) ⟷ (∀n. divides n p ⟶ n = 1 ∨ n = p)
  ← apply_backward_step iffI goal=1
    #[2] p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p) ⟶ (∀n. divides n p ⟶ n = 1 ∨ n = p)
    #[3] (∀n. divides n p ⟶ n = 1 ∨ n = p) ⟶ p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← introduction goal=2
    #[4] p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
    #[5] ∀n. divides n p ⟶ n = 1 ∨ n = p
  ← apply_backward_step disjE goal=5 facts=[4]
    #[6] p = 1 ⟶ (∀n. divides n p ⟶ n = 1 ∨ n = p)
    #[7] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p) ⟶ (∀n. divides n p ⟶ n = 1 ∨ n = p)
  ← introduction goal=6
    #[8] p = 1
    #[9] ∀n. divides n p ⟶ n = 1 ∨ n = p
  ← introduction n goal=9
    #[10] _VAR n
    #[11] divides n p
    #[12] n = 1 ∨ n = p
  -> rewrite_fact_with_prev goal=12 facts=[8,11]
    #[13] divides n 1
  -> rewrite_fact_with_prev goal=12 facts=[8,11]
  -> rewrite_fact divides_one sym=false goal=12 facts=[13]
    #[14] n = 1
  ← apply_backward_step disjI1 goal=12
  ← introduction goal=7
    #[15] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
    #[16] ∀n. divides n p ⟶ n = 1 ∨ n = p
  ← apply_backward_step conjD2 goal=16 facts=[15]
    #[17] ∀x. divides x p ⟶ x = 1 ∨ x = p
  ← introduction goal=3
    #[18] ∀n. divides n p ⟶ n = 1 ∨ n = p
    #[19] p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← cases "p = 1" goal=19
    #[20] p = 1 ⟶ p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
    #[21] ¬(p = 1) ⟶ p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← introduction goal=20
    #[22] p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← apply_backward_step disjI1 goal=22
  ← introduction goal=21
    #[23] ¬(p = 1)
    #[24] p = 1 ∨ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← apply_backward_step disjI2 goal=24
    #[25] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← apply_backward_step conjI goal=25
qed

theorem one_or_prime_divides_or_coprime
  fixes p :: nat
  prop p = 1 | prime p <--> (!n. divides p n | coprime p n)
  [hint_rewrite]
proof
  ← apply_backward_step iffI goal=0
    #[1] p = 1 ∨ prime p ⟶ (∀n. divides p n ∨ coprime p n)
    #[2] (∀n. divides p n ∨ coprime p n) ⟶ p = 1 ∨ prime p
  ← introduction goal=1
    #[3] p = 1 ∨ prime p
    #[4] ∀n. divides p n ∨ coprime p n
  ← apply_backward_step disjE goal=4 facts=[3]
    #[5] p = 1 ⟶ (∀n. divides p n ∨ coprime p n)
    #[6] prime p ⟶ (∀n. divides p n ∨ coprime p n)
  ← introduction goal=5
    #[7] p = 1
    #[8] ∀n. divides p n ∨ coprime p n
  ← rewrite_goal_with_prev goal=8 facts=[7]
    #[9] ∀n. divides 1 n ∨ coprime 1 n
  ← introduction n goal=9
    #[10] _VAR n
    #[11] divides 1 n ∨ coprime 1 n
  ← apply_backward_step disjI1 goal=11
    #[12] divides 1 n
  ← apply_backward_step divides_1 goal=12
    #[13] divides 1 n
  ← introduction goal=6
    #[14] prime p
    #[15] ∀n. divides p n ∨ coprime p n
  -> rewrite_fact prime_def sym=false goal=15 facts=[14]
    #[16] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD2 goal=15 facts=[16]
    #[17] ∀x. divides x p ⟶ x = 1 ∨ x = p
  ← introduction n goal=15
    #[18] divides p n ∨ coprime p n
  ← rewrite_goal coprime_def sym=false goal=18
    #[19] divides p n ∨ (∀d. divides d p ∧ divides d n ⟷ d = 1)
  ← cases "divides p n" goal=19
    #[20] divides p n ⟶ divides p n ∨ (∀d. divides d p ∧ divides d n ⟷ d = 1)
    #[21] ¬(divides p n) ⟶ divides p n ∨ (∀d. divides d p ∧ divides d n ⟷ d = 1)
  ← introduction goal=20
    #[22] divides p n
    #[23] divides p n ∨ (∀d. divides d p ∧ divides d n ⟷ d = 1)
  ← apply_backward_step disjI1 goal=23
  ← introduction goal=21
    #[24] ¬(divides p n)
    #[25] divides p n ∨ (∀d. divides d p ∧ divides d n ⟷ d = 1)
  ← apply_backward_step disjI2 goal=25
    #[26] ∀d. divides d p ∧ divides d n ⟷ d = 1
  ← introduction d goal=26
    #[27] _VAR d
    #[28] divides d p ∧ divides d n ⟷ d = 1
  ← apply_backward_step iffI goal=28
    #[29] divides d p ∧ divides d n ⟶ d = 1
    #[30] d = 1 ⟶ divides d p ∧ divides d n
  ← introduction goal=29
    #[31] divides d p ∧ divides d n
    #[32] d = 1
  -> apply_forward_step conjD1 goal=32 facts=[31]
    #[33] divides d p
  -> apply_fact goal=32 facts=[17,33]
    #[34] d = 1 ∨ d = p
  ← apply_backward_step disjE goal=32 facts=[34]
    #[35] d = 1 ⟶ d = 1
    #[36] d = p ⟶ d = 1
  ← introduction goal=36
    #[37] d = p
    #[38] d = 1
  -> apply_forward_step conjD2 goal=38 facts=[31]
    #[39] divides d n
  -> rewrite_fact_with_prev goal=38 facts=[37,39]
    #[40] divides p n
  ← apply_backward_step negE_gen goal=38 facts=[24,40]
    #[41] d = 1
  ← introduction goal=30
    #[42] d = 1
    #[43] divides d p ∧ divides d n
  ← rewrite_goal_with_prev goal=43 facts=[42]
    #[44] divides 1 p ∧ divides 1 n
  ← apply_backward_step conjI goal=44
    #[45] divides 1 p
    #[46] divides 1 n
  ← apply_backward_step divides_1 goal=45
    #[47] divides 1 p
  ← apply_backward_step divides_1 goal=46
  ← introduction goal=2
    #[48] ∀n. divides p n ∨ coprime p n
    #[49] p = 1 ∨ prime p
  ← rewrite_goal one_or_prime sym=false goal=49
    #[50] ∀n. divides n p ⟶ n = 1 ∨ n = p
  ← introduction n goal=50
    #[51] divides n p
    #[52] n = 1 ∨ n = p
  -> forall_elim n goal=52 facts=[48]
    #[53] divides p n ∨ coprime p n
  ← apply_backward_step disjE goal=52 facts=[53]
    #[54] divides p n ⟶ n = 1 ∨ n = p
    #[55] coprime p n ⟶ n = 1 ∨ n = p
  ← introduction goal=54
    #[56] n = 1 ∨ n = p
  ← apply_backward_step disjI2 goal=56
    #[57] n = p
  ← apply_backward_step divides_antisym goal=57
  ← introduction goal=55
    #[58] coprime p n
    #[59] n = 1 ∨ n = p
  -> rewrite_fact coprime_def sym=false goal=59 facts=[58]
    #[60] ∀d. divides d p ∧ divides d n ⟷ d = 1
  -> forall_elim n goal=59 facts=[60]
    #[61] divides n p ∧ divides n n ⟷ n = 1
  ← apply_backward_step disjI1 goal=59
    #[62] n = 1
  -> rewrite_fact eq_sym_eq sym=false goal=62 facts=[61]
    #[63] n = 1 ⟷ divides n p ∧ divides n n
  ← rewrite_goal_with_prev goal=62 facts=[63]
    #[64] divides n p ∧ divides n n
  ← apply_backward_step conjI goal=64
    #[65] divides n n
  ← apply_backward_step divides_self goal=65
    #[66] divides n n
qed

theorem prime_coprime_eq_nondivisiable
  fixes p :: nat
  prop prime p <--> (!n. coprime p n <--> ~(divides p n))
  [hint_rewrite]
proof
  ← cases "p=1" goal=0
    #[1] p = 1 ⟶ prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
    #[2] ¬(p = 1) ⟶ prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
  ← introduction goal=1
    #[3] p = 1
    #[4] prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
  ← rewrite_goal_with_prev goal=4 facts=[3]
    #[5] prime 1 ⟷ (∀n. coprime 1 n ⟷ ¬(divides 1 n))
  ← apply_backward_step iffI goal=5
    #[6] prime 1 ⟶ (∀n. coprime 1 n ⟷ ¬(divides 1 n))
    #[7] (∀n. coprime 1 n ⟷ ¬(divides 1 n)) ⟶ prime 1
  ← introduction goal=6
    #[8] prime 1
    #[9] ∀n. coprime 1 n ⟷ ¬(divides 1 n)
  -> rewrite_fact prime_def sym=false goal=9 facts=[8]
    #[10] ¬((1::nat) = 1) ∧ (∀x. divides x 1 ⟶ x = 1 ∨ x = 1)
  -> apply_forward_step conjD1 goal=9 facts=[10]
    #[11] ¬((1::nat) = 1)
  ← apply_backward_step negE_gen goal=9 facts=[11]
    #[12] (1::nat) = 1
  ← apply_backward_step eq_refl goal=12
    #[13] (1::nat) = 1
  ← introduction goal=7
    #[14] ∀n. coprime 1 n ⟷ ¬(divides 1 n)
    #[15] prime 1
  -> forall_elim "(1::nat)" goal=15 facts=[14]
    #[16] coprime 1 1 ⟷ ¬(divides 1 1)
  -> rewrite_fact divides_one sym=false goal=15 facts=[16]
    #[17] coprime 1 1 ⟷ ¬((1::nat) = 1)
  -> rewrite_fact coprime_gcd sym=false goal=15 facts=[17]
    #[18] gcd 1 1 = 1 ⟷ ¬((1::nat) = 1)
  -> rewrite_fact gcd_1_right sym=false goal=15 facts=[18]
    #[19] (1::nat) = 1 ⟷ ¬((1::nat) = 1)
  ← z3 goal=15 facts=[19]
    #[20] prime 1
  ← introduction goal=2
    #[21] ¬(p = 1)
    #[22] prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
  -> apply_forward_step one_or_prime_divides_or_coprime param_p=p goal=22
    #[23] p = 1 ∨ prime p ⟷ (∀n. divides p n ∨ coprime p n)
  ← cases "p = 1 ∨ prime p" goal=22
    #[24] p = 1 ∨ prime p ⟶ prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
    #[25] ¬(p = 1 ∨ prime p) ⟶ prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
  ← introduction goal=24
    #[26] p = 1 ∨ prime p
    #[27] prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
  ← apply_backward_step disjE goal=27 facts=[26]
    #[28] prime p ⟶ prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
  ← introduction goal=28
    #[29] prime p
    #[30] prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
  ← apply_backward_step iffI goal=30
    #[31] prime p ⟶ (∀n. coprime p n ⟷ ¬(divides p n))
    #[32] (∀n. coprime p n ⟷ ¬(divides p n)) ⟶ prime p
  ← introduction goal=31
    #[33] ∀n. coprime p n ⟷ ¬(divides p n)
  -> rewrite_fact_with_prev goal=33 facts=[23,26]
    #[34] ∀n. divides p n ∨ coprime p n
  ← introduction n goal=33
    #[35] _VAR n
    #[36] coprime p n ⟷ ¬(divides p n)
  -> forall_elim n goal=36 facts=[34]
    #[37] divides p n ∨ coprime p n
  ← apply_backward_step disjE goal=36 facts=[37]
    #[38] divides p n ⟶ coprime p n ⟷ ¬(divides p n)
    #[39] coprime p n ⟶ coprime p n ⟷ ¬(divides p n)
  ← introduction goal=38
    #[40] divides p n
    #[41] coprime p n ⟷ ¬(divides p n)
  ← apply_backward_step iffI goal=41
    #[42] coprime p n ⟶ ¬(divides p n)
    #[43] ¬(divides p n) ⟶ coprime p n
  ← introduction goal=42
    #[44] coprime p n
    #[45] ¬(divides p n)
  -> rewrite_fact coprime_def sym=false goal=45 facts=[44]
    #[46] ∀d. divides d p ∧ divides d n ⟷ d = 1
  -> forall_elim p goal=45 facts=[46]
    #[47] divides p p ∧ divides p n ⟷ p = 1
  ← apply_backward_step contrapositive goal=45 facts=[21]
    #[48] ¬¬(divides p n) ⟶ ¬¬(p = 1)
  ← rewrite_goal double_neg sym=false goal=48
    #[49] divides p n ⟶ p = 1
  ← introduction goal=49
    #[50] p = 1
  -> rewrite_fact eq_sym_eq sym=false goal=50 facts=[47]
    #[51] p = 1 ⟷ divides p p ∧ divides p n
  ← rewrite_goal_with_prev goal=50 facts=[51]
    #[52] divides p p ∧ divides p n
  ← apply_backward_step conjI goal=52
    #[53] divides p p
  ← apply_backward_step divides_self goal=53
    #[54] divides p p
  ← introduction goal=43
    #[55] ¬(divides p n)
    #[56] coprime p n
  ← apply_backward_step negE_gen goal=56 facts=[55,40]
    #[57] coprime p n
  ← introduction goal=39
    #[58] coprime p n ⟷ ¬(divides p n)
  ← apply_backward_step iffI goal=58
    #[59] coprime p n ⟶ ¬(divides p n)
    #[60] ¬(divides p n) ⟶ coprime p n
  ← introduction goal=59
    #[61] ¬(divides p n)
  -> rewrite_fact coprime_def sym=false goal=61 facts=[44]
  -> forall_elim p goal=61 facts=[46]
  ← apply_backward_step contrapositive goal=61 facts=[21]
    #[62] ¬¬(divides p n) ⟶ ¬¬(p = 1)
  ← rewrite_goal double_neg sym=false goal=62
    #[63] divides p n ⟶ p = 1
  ← introduction goal=63
  -> rewrite_fact eq_sym_eq sym=false goal=50 facts=[47]
  ← rewrite_goal_with_prev goal=50 facts=[51]
  ← apply_backward_step conjI goal=52
  ← apply_backward_step divides_self goal=53
  ← introduction goal=60
  ← introduction goal=32
    #[64] ∀n. coprime p n ⟷ ¬(divides p n)
  ← introduction goal=25
    #[65] ¬(p = 1 ∨ prime p)
    #[66] prime p ⟷ (∀n. coprime p n ⟷ ¬(divides p n))
  -> rewrite_fact_with_prev goal=66 facts=[23,65]
    #[67] ¬(∀n. divides p n ∨ coprime p n)
  -> rewrite_fact de_morgan_thm2 sym=false goal=66 facts=[65]
    #[68] ¬(p = 1) ∧ ¬(prime p)
  -> apply_forward_step conjD2 goal=66 facts=[68]
    #[69] ¬(prime p)
  ← apply_backward_step iffI goal=66
    #[70] prime p ⟶ (∀n. coprime p n ⟷ ¬(divides p n))
    #[71] (∀n. coprime p n ⟷ ¬(divides p n)) ⟶ prime p
  ← introduction goal=70
    #[72] ∀n. coprime p n ⟷ ¬(divides p n)
  ← apply_backward_step negE_gen goal=72 facts=[69,29]
    #[73] ∀n. coprime p n ⟷ ¬(divides p n)
  ← introduction goal=71
    #[74] prime p
  ← apply_backward_step negE_gen goal=74 facts=[67]
    #[75] ∀n. divides p n ∨ coprime p n
  ← introduction n goal=75
    #[76] divides p n ∨ coprime p n
  -> forall_elim n goal=76 facts=[64]
    #[77] coprime p n ⟷ ¬(divides p n)
  ← rewrite_goal_with_prev goal=76 facts=[77]
    #[78] divides p n ∨ ¬(divides p n)
  ← apply_backward_step classical goal=78
    #[79] divides p n ∨ ¬(divides p n)
qed

theorem zero_one_or_prime_divprod
  fixes a :: nat, b :: nat, p :: nat
  prop p = 0 | p = 1 | prime p --> divides p (a * b) <--> divides p a | divides p b
  [hint_backward]
proof
  ← introduction goal=0
    #[1] p = 0 ∨ p = 1 ∨ prime p
    #[2] divides p (a * b) ⟷ divides p a ∨ divides p b
  ← apply_backward_step disjE goal=2 facts=[1]
    #[3] p = 0 ⟶ divides p (a * b) ⟷ divides p a ∨ divides p b
    #[4] p = 1 ∨ prime p ⟶ divides p (a * b) ⟷ divides p a ∨ divides p b
  ← introduction goal=3
    #[5] p = 0
    #[6] divides p (a * b) ⟷ divides p a ∨ divides p b
  ← rewrite_goal_with_prev goal=6 facts=[5]
    #[7] divides 0 (a * b) ⟷ divides 0 a ∨ divides 0 b
  ← rewrite_goal divides_0 sym=false goal=7
    #[8] a * b = 0 ⟷ a = 0 ∨ b = 0
  ← rewrite_goal mult_eq_0 sym=false goal=8
    #[9] a * b = 0 ⟷ a = 0 ∨ b = 0
  ← introduction goal=4
    #[10] p = 1 ∨ prime p
    #[11] divides p (a * b) ⟷ divides p a ∨ divides p b
  ← apply_backward_step disjE goal=11 facts=[10]
    #[12] p = 1 ⟶ divides p (a * b) ⟷ divides p a ∨ divides p b
    #[13] prime p ⟶ divides p (a * b) ⟷ divides p a ∨ divides p b
  ← introduction goal=12
    #[14] p = 1
    #[15] divides p (a * b) ⟷ divides p a ∨ divides p b
  ← rewrite_goal_with_prev goal=15 facts=[14]
    #[16] divides 1 (a * b) ⟷ divides 1 a ∨ divides 1 b
  ← apply_backward_step iffI goal=16
    #[17] divides 1 (a * b) ⟶ divides 1 a ∨ divides 1 b
    #[18] divides 1 a ∨ divides 1 b ⟶ divides 1 (a * b)
  ← introduction goal=17
    #[19] divides 1 (a * b)
    #[20] divides 1 a ∨ divides 1 b
  ← apply_backward_step disjI1 goal=20
    #[21] divides 1 a
  ← apply_backward_step divides_1 goal=21
    #[22] divides 1 a
  ← introduction goal=18
    #[23] divides 1 a ∨ divides 1 b
    #[24] divides 1 (a * b)
  ← apply_backward_step divides_1 goal=24
    #[25] divides 1 (a * b)
  ← introduction goal=13
    #[26] prime p
    #[27] divides p (a * b) ⟷ divides p a ∨ divides p b
  ← apply_backward_step iffI goal=27
    #[28] divides p (a * b) ⟶ divides p a ∨ divides p b
    #[29] divides p a ∨ divides p b ⟶ divides p (a * b)
  ← introduction goal=28
    #[30] divides p (a * b)
    #[31] divides p a ∨ divides p b
  ← cases "divides p a" goal=31
    #[32] divides p a ⟶ divides p a ∨ divides p b
    #[33] ¬(divides p a) ⟶ divides p a ∨ divides p b
  ← introduction goal=32
    #[34] divides p a
    #[35] divides p a ∨ divides p b
  ← apply_backward_step disjI1 goal=35
  ← introduction goal=33
    #[36] ¬(divides p a)
    #[37] divides p a ∨ divides p b
  ← apply_backward_step disjI2 goal=37
    #[38] divides p b
  ← apply_backward_step coprime_divprod goal=38 facts=[30]
    #[39] coprime p a
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=39 facts=[26]
    #[40] ∀n. coprime p n ⟷ ¬(divides p n)
  ← rewrite_goal_with_prev goal=39 facts=[40]
  ← introduction goal=29
    #[41] divides p a ∨ divides p b
    #[42] divides p (a * b)
  ← apply_backward_step disjE goal=42 facts=[41]
    #[43] divides p a ⟶ divides p (a * b)
    #[44] divides p b ⟶ divides p (a * b)
  ← introduction goal=43
    #[45] divides p (a * b)
  ← apply_backward_step divides_rmul goal=45
  ← introduction goal=44
    #[46] divides p b
    #[47] divides p (a * b)
  ← apply_backward_step divides_lmul goal=47
qed

theorem zero_one_or_prime
  fixes p :: nat
  prop p = 0 | p = 1 | prime p <--> (!a. !b. divides p (a * b) --> divides p a | divides p b)
  [hint_rewrite]
proof
  ← apply_backward_step iffI goal=0
    #[1] p = 0 ∨ p = 1 ∨ prime p ⟶ (∀a. ∀b. divides p (a * b) ⟶ divides p a ∨ divides p b)
    #[2] (∀a. ∀b. divides p (a * b) ⟶ divides p a ∨ divides p b) ⟶ p = 0 ∨ p = 1 ∨ prime p
  ← introduction goal=1
    #[3] p = 0 ∨ p = 1 ∨ prime p
    #[4] ∀a. ∀b. divides p (a * b) ⟶ divides p a ∨ divides p b
  ← introduction a,b goal=4
    #[5] _VAR a
    #[6] _VAR b
    #[7] divides p (a * b)
    #[8] divides p a ∨ divides p b
  -> apply_forward_step zero_one_or_prime_divprod param_a=a param_b=b goal=8 facts=[3]
    #[9] divides p (a * b) ⟷ divides p a ∨ divides p b
  -> rewrite_fact_with_prev goal=8 facts=[9,7]
  ← introduction goal=2
    #[10] ∀a. ∀b. divides p (a * b) ⟶ divides p a ∨ divides p b
    #[11] p = 0 ∨ p = 1 ∨ prime p
  ← cases "p = 0" goal=11
    #[12] p = 0 ⟶ p = 0 ∨ p = 1 ∨ prime p
    #[13] ¬(p = 0) ⟶ p = 0 ∨ p = 1 ∨ prime p
  ← introduction goal=12
    #[14] p = 0
    #[15] p = 0 ∨ p = 1 ∨ prime p
  ← apply_backward_step disjI1 goal=15
  ← introduction goal=13
    #[16] ¬(p = 0)
    #[17] p = 0 ∨ p = 1 ∨ prime p
  ← cases "p=1" goal=17
    #[18] p = 1 ⟶ p = 0 ∨ p = 1 ∨ prime p
    #[19] ¬(p = 1) ⟶ p = 0 ∨ p = 1 ∨ prime p
  ← introduction goal=18
    #[20] p = 1
    #[21] p = 0 ∨ p = 1 ∨ prime p
  ← apply_backward_step disjI2 goal=21
    #[22] p = 1 ∨ prime p
  ← apply_backward_step disjI1 goal=22
  ← introduction goal=19
    #[23] ¬(p = 1)
    #[24] p = 0 ∨ p = 1 ∨ prime p
  ← apply_backward_step disjI2 goal=24
    #[25] p = 1 ∨ prime p
  ← apply_backward_step disjI2 goal=25
    #[26] prime p
  ← rewrite_goal prime_def sym=false goal=26
    #[27] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← apply_backward_step conjI goal=27
    #[28] ∀x. divides x p ⟶ x = 1 ∨ x = p
  ← introduction x goal=28
    #[29] _VAR x
    #[30] divides x p
    #[31] x = 1 ∨ x = p
  -> rewrite_fact divides_def sym=false goal=31 facts=[30]
    #[32] ∃k. p = x * k
  exists_elim k goal=31 facts=[32]
    #[33] _VAR k
    #[34] p = x * k
    #[35] x = 1 ∨ x = p
  -> forall_elim x goal=35 facts=[10]
    #[36] ∀b. divides p (x * b) ⟶ divides p x ∨ divides p b
  -> forall_elim k goal=35 facts=[36]
    #[37] divides p (x * k) ⟶ divides p x ∨ divides p k
  -> rewrite_fact_with_prev goal=35 facts=[34,37]
    #[38] divides (x * k) (x * k) ⟶ divides (x * k) x ∨ divides (x * k) k
  cut "divides (x * k) (x * k)" goal=35 facts=[38]
    #[39] divides (x * k) (x * k)
  ← apply_backward_step divides_self goal=39
    #[40] divides (x * k) (x * k)
  -> apply_fact goal=35 facts=[38,40]
    #[41] divides (x * k) x ∨ divides (x * k) k
  ← apply_backward_step disjE goal=35 facts=[41]
    #[42] divides (x * k) x ⟶ x = 1 ∨ x = p
    #[43] divides (x * k) k ⟶ x = 1 ∨ x = p
  ← introduction goal=42
    #[44] divides (x * k) x
    #[45] x = 1 ∨ x = p
  -> rewrite_fact eq_sym_eq sym=false goal=45 facts=[34]
    #[46] x * k = p
  -> rewrite_fact_with_prev goal=45 facts=[46,44]
    #[47] divides p x
  ← apply_backward_step disjI2 goal=45
    #[48] x = p
  ← apply_backward_step divides_antisym goal=48
  ← introduction goal=43
    #[49] divides (x * k) k
    #[50] x = 1 ∨ x = p
  cut "divides k (x * k)" goal=50 facts=[49]
    #[51] divides k (x * k)
  ← apply_backward_step divides_lmul goal=51
    #[52] divides k k
  ← apply_backward_step divides_self goal=52
    #[53] divides k k
  -> apply_forward_step divides_antisym goal=50 facts=[49,51]
    #[54] x * k = k
  cut "k = 1 * k" goal=50
    #[55] k = 1 * k
  ← rewrite_goal mult_1_left sym=false goal=55
    #[56] k = 1 * k
  -> rewrite_fact_with_prev goal=50 facts=[56,54]
    #[57] x * (1 * k) = 1 * k
  -> rewrite_fact mult_assoc sym=true goal=50 facts=[57]
    #[58] x * 1 * k = 1 * k
  -> rewrite_fact mult_1_right sym=false goal=50 facts=[58]
    #[59] x * k = 1 * k
  -> rewrite_fact eq_mult_rcancel sym=false goal=50 facts=[59]
    #[60] k = 0 ∨ x = 1
  ← apply_backward_step disjE goal=50 facts=[60]
    #[61] k = 0 ⟶ x = 1 ∨ x = p
    #[62] x = 1 ⟶ x = 1 ∨ x = p
  ← introduction goal=61
    #[63] k = 0
    #[64] x = 1 ∨ x = p
  ← apply_backward_step disjI2 goal=64
    #[65] x = p
  -> rewrite_fact_with_prev goal=65 facts=[63,34]
    #[66] p = x * 0
  -> rewrite_fact mult_0_right sym=false goal=65 facts=[66]
    #[67] p = 0
  ← apply_backward_step negE_gen goal=65 facts=[16,67]
    #[68] x = p
  ← introduction goal=62
    #[69] x = 1
    #[70] x = 1 ∨ x = p
  ← apply_backward_step disjI1 goal=70
qed

theorem prime_0
  prop ~(prime 0)
  [hint_backward]
proof
  ← rewrite_goal prime_def sym=false goal=0
    #[1] ¬(¬((0::nat) = 1) ∧ (∀x. divides x 0 ⟶ x = 1 ∨ x = 0))
  ← rewrite_goal de_morgan_thm1 sym=false goal=1
    #[2] ¬¬((0::nat) = 1) ∨ ¬(∀x. divides x 0 ⟶ x = 1 ∨ x = 0)
  ← apply_backward_step disjI2 goal=2
    #[3] ¬(∀x. divides x 0 ⟶ x = 1 ∨ x = 0)
  ← rewrite_goal not_all sym=false goal=3
    #[4] ∃x. ¬(divides x 0 ⟶ x = 1 ∨ x = 0)
  ← inst_exists_goal "(2::nat)" goal=4
    #[5] ¬(divides 2 0 ⟶ (2::nat) = 1 ∨ (2::nat) = 0)
  ← rewrite_goal not_imp sym=false goal=5
    #[6] divides 2 0 ∧ ¬((2::nat) = 1 ∨ (2::nat) = 0)
  ← apply_backward_step conjI goal=6
    #[7] divides 2 0
    #[8] ¬((2::nat) = 1 ∨ (2::nat) = 0)
  ← apply_backward_step divides_zero goal=7
  ← rewrite_goal de_morgan_thm2 sym=false goal=8
    #[9] ¬((2::nat) = 1) ∧ ¬((2::nat) = 0)
  ← apply_backward_step conjI goal=9
    #[10] ¬((2::nat) = 1)
    #[11] ¬((2::nat) = 0)
  nat_const_ineq goal=10
  nat_const_ineq goal=11
qed

theorem prime_1
  prop ~(prime 1)
  [hint_backward]
proof
  ← rewrite_goal prime_def sym=false goal=0
    #[1] ¬(¬((1::nat) = 1) ∧ (∀x. divides x 1 ⟶ x = 1 ∨ x = 1))
  ← rewrite_goal de_morgan_thm1 sym=false goal=1
    #[2] ¬¬((1::nat) = 1) ∨ ¬(∀x. divides x 1 ⟶ x = 1 ∨ x = 1)
  ← apply_backward_step disjI1 goal=2
    #[3] ¬¬((1::nat) = 1)
  ← rewrite_goal double_neg sym=false goal=3
qed

theorem prime_2
  prop prime 2
  [hint_backward]
proof
  ← rewrite_goal prime_def sym=false goal=0
    #[1] ¬((2::nat) = 1) ∧ (∀x. divides x 2 ⟶ x = 1 ∨ x = 2)
  ← apply_backward_step conjI goal=1
    #[2] ¬((2::nat) = 1)
    #[3] ∀x. divides x 2 ⟶ x = 1 ∨ x = 2
  nat_const_ineq goal=2
  ← introduction x goal=3
    #[4] _VAR x
    #[5] divides x 2
    #[6] x = 1 ∨ x = 2
  -> apply_forward_step divides_le goal=6 facts=[5]
    #[7] x ≤ 2 ∨ (2::nat) = 0
  ← apply_backward_step disjE goal=6 facts=[7]
    #[8] x ≤ 2 ⟶ x = 1 ∨ x = 2
    #[9] (2::nat) = 0 ⟶ x = 1 ∨ x = 2
  ← introduction goal=8
    #[10] x ≤ 2
    #[11] x = 1 ∨ x = 2
  cut "~(x = 0)" goal=11
    #[12] ¬(x = 0)
  ← apply_backward_step contrapositive goal=12 facts=[5]
    #[13] ¬¬(x = 0) ⟶ ¬(divides x 2)
  ← rewrite_goal double_neg sym=false goal=13
    #[14] x = 0 ⟶ ¬(divides x 2)
  ← introduction goal=14
    #[15] x = 0
    #[16] ¬(divides x 2)
  ← rewrite_goal_with_prev goal=16 facts=[15]
    #[17] ¬(divides 0 2)
  ← rewrite_goal divides_0 sym=false goal=17
    #[18] ¬((2::nat) = 0)
  nat_const_ineq goal=18
    #[19] ¬((2::nat) = 0)
  ← z3 goal=11 facts=[10,12]
  ← introduction goal=9
    #[20] (2::nat) = 0
    #[21] x = 1 ∨ x = 2
  ← apply_backward_step contrapositive goal=21 facts=[20]
    #[22] ¬(x = 1 ∨ x = 2) ⟶ ¬((2::nat) = 0)
  ← introduction goal=22
    #[23] ¬(x = 1 ∨ x = 2)
    #[24] ¬((2::nat) = 0)
  nat_const_ineq goal=24
qed

theorem prime_alt
  fixes p :: nat
  prop prime p <--> ~(p = 0) & ~(p = 1) & (!n. 1 < n --> n < p --> ~(divides n p))
  [hint_rewrite]
proof
  ← cases "p=0" goal=0
    #[1] p = 0 ⟶ prime p ⟷ ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
    #[2] ¬(p = 0) ⟶ prime p ⟷ ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
  ← introduction goal=1
    #[3] p = 0
    #[4] prime p ⟷ ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
  ← apply_backward_step iffI goal=4
    #[5] prime p ⟶ ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
    #[6] ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p)) ⟶ prime p
  ← introduction goal=5
    #[7] prime p
    #[8] ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
  -> rewrite_fact_with_prev goal=8 facts=[3,7]
    #[9] prime 0
  -> apply_forward_step prime_0 goal=8
    #[10] ¬(prime 0)
  ← apply_backward_step negE_gen goal=8 facts=[10,9]
  ← introduction goal=6
    #[11] ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
    #[12] prime p
  -> apply_forward_step conjD1 goal=12 facts=[11]
    #[13] ¬(p = 0)
  ← apply_backward_step negE_gen goal=12 facts=[13,3]
  ← introduction goal=2
    #[14] ¬(p = 0)
    #[15] prime p ⟷ ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
  ← rewrite_goal prime_def sym=false goal=15
    #[16] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p) ⟷ ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
  ← apply_backward_step iffI goal=16
    #[17] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p) ⟶ ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
    #[18] ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p)) ⟶ ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← introduction goal=17
    #[19] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
    #[20] ¬(p = 0) ∧ ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
  -> apply_forward_step conjD1 goal=20 facts=[19]
    #[21] ¬(p = 1)
  -> apply_forward_step conjD2 goal=20 facts=[19]
    #[22] ∀x. divides x p ⟶ x = 1 ∨ x = p
  ← apply_backward_step conjI goal=20
    #[23] ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
  ← apply_backward_step conjI goal=23
    #[24] ∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p)
  ← introduction n goal=24
    #[25] _VAR n
    #[26] 1 < n
    #[27] n < p
    #[28] ¬(divides n p)
  ← apply_backward_step negI goal=28
    #[29] divides n p ⟶ false
  ← introduction goal=29
    #[30] divides n p
    #[31] false
  -> apply_fact goal=31 facts=[22,30]
    #[32] n = 1 ∨ n = p
  ← z3 goal=31 facts=[32,27,26]
    #[33] false
  ← introduction goal=18
    #[34] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD1 goal=34 facts=[11]
  -> apply_forward_step conjD2 goal=34 facts=[11]
    #[35] ¬(p = 1) ∧ (∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p))
  -> apply_forward_step conjD2 goal=34 facts=[35]
    #[36] ∀n. 1 < n ⟶ n < p ⟶ ¬(divides n p)
  -> apply_forward_step conjD1 goal=34 facts=[35]
    #[37] ¬(p = 1)
  ← apply_backward_step conjI goal=34
    #[38] ∀x. divides x p ⟶ x = 1 ∨ x = p
  ← introduction n goal=38
    #[39] n = 1 ∨ n = p
  -> apply_forward_step divides_le_strong goal=39 facts=[30]
    #[40] 1 ≤ n ∧ n ≤ p ∨ p = 0
  ← apply_backward_step disjE goal=39 facts=[40]
    #[41] 1 ≤ n ∧ n ≤ p ⟶ n = 1 ∨ n = p
    #[42] p = 0 ⟶ n = 1 ∨ n = p
  ← introduction goal=41
    #[43] 1 ≤ n ∧ n ≤ p
    #[44] n = 1 ∨ n = p
  ← apply_backward_step contrapositive goal=44 facts=[30]
    #[45] ¬(n = 1 ∨ n = p) ⟶ ¬(divides n p)
  ← introduction goal=45
    #[46] ¬(n = 1 ∨ n = p)
    #[47] ¬(divides n p)
  ← apply_prev goal=47 facts=[36]
    #[48] 1 < n
    #[49] n < p
  ← z3 goal=48 facts=[46,43]
    #[50] 1 < n
  ← z3 goal=49 facts=[46,43]
    #[51] n < p
  ← introduction goal=42
    #[52] n = 1 ∨ n = p
  ← apply_backward_step negE_gen goal=52 facts=[13,3]
    #[53] n = 1 ∨ n = p
qed

theorem prime_ge_2
  fixes p :: nat
  prop prime p --> 2 <= p
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] 2 ≤ p
  ← apply_backward_step contrapositive goal=2 facts=[1]
    #[3] ¬(2 ≤ p) ⟶ ¬(prime p)
  ← rewrite_goal not_le sym=false goal=3
    #[4] p < 2 ⟶ ¬(prime p)
  ← introduction goal=4
    #[5] p < 2
    #[6] ¬(prime p)
  cut "p = 0 | p = 1" goal=6
    #[7] p = 0 ∨ p = 1
  ← z3 goal=7 facts=[5]
    #[8] p = 0 ∨ p = 1
  ← apply_backward_step disjE goal=6 facts=[8]
    #[9] p = 0 ⟶ ¬(prime p)
    #[10] p = 1 ⟶ ¬(prime p)
  ← introduction goal=9
    #[11] p = 0
    #[12] ¬(prime p)
  ← rewrite_goal_with_prev goal=12 facts=[11]
    #[13] ¬(prime 0)
  ← apply_backward_step prime_0 goal=13
    #[14] ¬(prime 0)
  ← introduction goal=10
    #[15] p = 1
    #[16] ¬(prime p)
  ← rewrite_goal_with_prev goal=16 facts=[15]
    #[17] ¬(prime 1)
  ← apply_backward_step prime_1 goal=17
    #[18] ¬(prime 1)
qed

theorem prime_factor
  fixes n :: nat
  prop ~(n = 1) --> (?p. prime p & divides p n)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ¬(n = 1)
    #[2] ∃p. prime p ∧ divides p n
  cut "!n. ¬(n = 1) ⟶ (∃p. prime p ∧ divides p n)" goal=2
    #[3] ∀n. ¬(n = 1) ⟶ (∃p. prime p ∧ divides p n)
  ← apply_backward_step nat_WF goal=3
    #[4] ∀n. (∀m. m < n ⟶ ¬(m = 1) ⟶ (∃p. prime p ∧ divides p m)) ⟶ ¬(n = 1) ⟶ (∃p. prime p ∧ divides p n)
  ← introduction n1 goal=4
    #[5] _VAR n1
    #[6] ∀m. m < n1 ⟶ ¬(m = 1) ⟶ (∃p. prime p ∧ divides p m)
    #[7] ¬(n1 = 1)
    #[8] ∃p. prime p ∧ divides p n1
  ← cases "prime (n1)" goal=8
    #[9] prime n1 ⟶ (∃p. prime p ∧ divides p n1)
    #[10] ¬(prime n1) ⟶ (∃p. prime p ∧ divides p n1)
  ← introduction goal=9
    #[11] prime n1
    #[12] ∃p. prime p ∧ divides p n1
  ← inst_exists_goal n1 goal=12
    #[13] prime n1 ∧ divides n1 n1
  ← apply_backward_step conjI goal=13
    #[14] divides n1 n1
  ← apply_backward_step divides_self goal=14
    #[15] divides n1 n1
  ← introduction goal=10
    #[16] ¬(prime n1)
    #[17] ∃p. prime p ∧ divides p n1
  -> rewrite_fact prime_def sym=false goal=17 facts=[16]
    #[18] ¬(¬(n1 = 1) ∧ (∀x. divides x n1 ⟶ x = 1 ∨ x = n1))
  -> rewrite_fact de_morgan_thm1 sym=false goal=17 facts=[18]
    #[19] ¬¬(n1 = 1) ∨ ¬(∀x. divides x n1 ⟶ x = 1 ∨ x = n1)
  -> rewrite_fact double_neg sym=false goal=17 facts=[19]
    #[20] n1 = 1 ∨ ¬(∀x. divides x n1 ⟶ x = 1 ∨ x = n1)
  ← apply_backward_step disjE goal=17 facts=[20]
    #[21] n1 = 1 ⟶ (∃p. prime p ∧ divides p n1)
    #[22] ¬(∀x. divides x n1 ⟶ x = 1 ∨ x = n1) ⟶ (∃p. prime p ∧ divides p n1)
  ← introduction goal=21
    #[23] n1 = 1
    #[24] ∃p. prime p ∧ divides p n1
  ← apply_backward_step negE_gen goal=24 facts=[7,23]
    #[25] ∃p. prime p ∧ divides p n1
  ← introduction goal=22
    #[26] ¬(∀x. divides x n1 ⟶ x = 1 ∨ x = n1)
    #[27] ∃p. prime p ∧ divides p n1
  -> rewrite_fact not_all sym=false goal=27 facts=[26]
    #[28] ∃x. ¬(divides x n1 ⟶ x = 1 ∨ x = n1)
  exists_elim m goal=27 facts=[28]
    #[29] _VAR m
    #[30] ¬(divides m n1 ⟶ m = 1 ∨ m = n1)
    #[31] ∃p. prime p ∧ divides p n1
  -> rewrite_fact not_imp sym=false goal=31 facts=[30]
    #[32] divides m n1 ∧ ¬(m = 1 ∨ m = n1)
  -> rewrite_fact de_morgan_thm2 sym=false goal=31 facts=[32]
    #[33] divides m n1 ∧ ¬(m = 1) ∧ ¬(m = n1)
  -> apply_forward_step conjD1 goal=31 facts=[33]
    #[34] divides m n1
  -> apply_forward_step conjD2 goal=31 facts=[33]
    #[35] ¬(m = 1) ∧ ¬(m = n1)
  -> apply_forward_step conjD1 goal=31 facts=[35]
    #[36] ¬(m = 1)
  -> apply_forward_step conjD2 goal=31 facts=[35]
    #[37] ¬(m = n1)
  -> apply_forward_step divides_le goal=31 facts=[34]
    #[38] m ≤ n1 ∨ n1 = 0
  ← apply_backward_step disjE goal=31 facts=[38]
    #[39] m ≤ n1 ⟶ (∃p. prime p ∧ divides p n1)
    #[40] n1 = 0 ⟶ (∃p. prime p ∧ divides p n1)
  ← introduction goal=39
    #[41] m ≤ n1
    #[42] ∃p. prime p ∧ divides p n1
  cut "m < n1" goal=42
    #[43] m < n1
  ← z3 goal=43 facts=[41,37]
    #[44] m < n1
  -> apply_fact goal=42 facts=[6,44]
    #[45] ¬(m = 1) ⟶ (∃p. prime p ∧ divides p m)
  -> apply_fact goal=42 facts=[45,36]
    #[46] ∃p. prime p ∧ divides p m
  exists_elim p goal=42 facts=[46]
    #[47] _VAR p
    #[48] prime p ∧ divides p m
    #[49] ∃p. prime p ∧ divides p n1
  ← inst_exists_goal p goal=49
    #[50] prime p ∧ divides p n1
  -> apply_forward_step conjD1 goal=50 facts=[48]
    #[51] prime p
  -> apply_forward_step conjD2 goal=50 facts=[48]
    #[52] divides p m
  ← apply_backward_step conjI goal=50
    #[53] divides p n1
  ← apply_backward_step divides_trans goal=53 facts=[52,34]
    #[54] divides p n1
  ← introduction goal=40
    #[55] n1 = 0
    #[56] ∃p. prime p ∧ divides p n1
  ← inst_exists_goal "(2::nat)" goal=56
    #[57] prime 2 ∧ divides 2 n1
  ← apply_backward_step conjI goal=57
    #[58] prime 2
    #[59] divides 2 n1
  ← apply_backward_step prime_2 goal=58
    #[60] prime 2
  ← rewrite_goal_with_prev goal=59 facts=[55]
    #[61] divides 2 0
  ← apply_backward_step divides_zero goal=61
    #[62] divides 2 0
  ← apply_prev goal=2 facts=[3]
qed

theorem prime_factor_lt
  fixes m :: nat, n :: nat, p :: nat
  prop prime p --> ~(n = 0) --> n = p * m --> m < n
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ¬(n = 0)
    #[3] n = p * m
    #[4] m < n
  -> apply_forward_step prime_ge_2 goal=4 facts=[1]
    #[5] 2 ≤ p
  -> rewrite_fact less_eq_exist sym=false goal=4 facts=[5]
    #[6] ∃p1. p = 2 + p1
  exists_elim q goal=4 facts=[6]
    #[7] _VAR q
    #[8] p = 2 + q
    #[9] m < n
  -> rewrite_fact_with_prev goal=9 facts=[8,3]
    #[10] n = (2 + q) * m
  ← rewrite_goal_with_prev goal=9 facts=[10]
    #[11] m < (2 + q) * m
  ← rewrite_goal distrib_r sym=false goal=11
    #[12] m < 2 * m + q * m
  ← rewrite_goal mult_2 sym=false goal=12
    #[13] m < m + m + q * m
  ← rewrite_goal add_assoc sym=false goal=13
    #[14] m < m + (m + q * m)
  ← rewrite_goal lt_add sym=false goal=14
    #[15] 0 < m + q * m
  ← apply_backward_step le_1_1 goal=15
    #[16] ¬(m + q * m = 0)
  cut "m + q * m = (1+ q) * m" goal=16
    #[17] m + q * m = (1 + q) * m
  nat_norm goal=17
    #[18] m + q * m = (1 + q) * m
  ← rewrite_goal_with_prev goal=16 facts=[18]
    #[19] ¬((1 + q) * m = 0)
  ← rewrite_goal add_1_left sym=false goal=19
    #[20] ¬(Suc q * m = 0)
  ← apply_backward_step negI goal=20
    #[21] Suc q * m = 0 ⟶ false
  ← introduction goal=21
    #[22] Suc q * m = 0
    #[23] false
  -> apply_forward_step mult_nonzero goal=23 facts=[22]
    #[24] Suc q = 0 ∨ m = 0
  ← apply_backward_step disjE goal=23 facts=[24]
    #[25] Suc q = 0 ⟶ false
    #[26] m = 0 ⟶ false
  ← introduction goal=25
    #[27] Suc q = 0
    #[28] false
  ← apply_backward_step contrapositive goal=28 facts=[27]
    #[29] ¬false ⟶ ¬(Suc q = 0)
  ← introduction goal=29
    #[30] ¬false
    #[31] ¬(Suc q = 0)
  ← apply_backward_step ineq_sym goal=31
    #[32] ¬(0 = Suc q)
  ← apply_backward_step nat_zero_Suc_neq goal=32
    #[33] ¬(0 = Suc q)
  ← introduction goal=26
    #[34] m = 0
    #[35] false
  ← apply_backward_step contrapositive goal=35 facts=[2]
    #[36] ¬false ⟶ ¬¬(n = 0)
  ← introduction goal=36
    #[37] ¬¬(n = 0)
  ← rewrite_goal double_neg sym=false goal=37
    #[38] n = 0
  -> rewrite_fact_with_prev goal=38 facts=[34,3]
    #[39] n = p * 0
  -> rewrite_fact mult_0_right sym=false goal=38 facts=[39]
    #[40] n = 0
qed

theorem prime_factor_induct
  fixes P :: nat => bool
  prop P 0 --> P 1 --> (!p. !n. prime p --> ~(n = 0) --> P n --> P (p * n)) --> (!n. P n)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] P 0
    #[2] P 1
    #[3] ∀p. ∀n. prime p ⟶ ¬(n = 0) ⟶ P n ⟶ P (p * n)
    #[4] ∀n. P n
  ← apply_backward_step nat_WF goal=4
    #[5] ∀n. (∀m. m < n ⟶ P m) ⟶ P n
  ← introduction n goal=5
    #[6] _VAR n
    #[7] ∀m. m < n ⟶ P m
    #[8] P n
  ← cases "n=0" goal=8
    #[9] n = 0 ⟶ P n
    #[10] ¬(n = 0) ⟶ P n
  ← introduction goal=9
    #[11] n = 0
    #[12] P n
  ← rewrite_goal_with_prev goal=12 facts=[11]
  ← introduction goal=10
    #[13] ¬(n = 0)
    #[14] P n
  ← cases "n=1" goal=14
    #[15] n = 1 ⟶ P n
    #[16] ¬(n = 1) ⟶ P n
  ← introduction goal=15
    #[17] n = 1
    #[18] P n
  ← rewrite_goal_with_prev goal=18 facts=[17]
  ← introduction goal=16
    #[19] ¬(n = 1)
    #[20] P n
  -> apply_forward_step prime_factor goal=20 facts=[19]
    #[21] ∃p. prime p ∧ divides p n
  exists_elim p goal=20 facts=[21]
    #[22] _VAR p
    #[23] prime p ∧ divides p n
    #[24] P n
  -> forall_elim p goal=24 facts=[3]
    #[25] ∀n. prime p ⟶ ¬(n = 0) ⟶ P n ⟶ P (p * n)
  -> apply_forward_step conjD1 goal=24 facts=[23]
    #[26] prime p
  -> apply_fact goal=24 facts=[25,26]
    #[27] ∀n. ¬(n = 0) ⟶ P n ⟶ P (p * n)
  -> apply_forward_step conjD2 goal=24 facts=[23]
    #[28] divides p n
  -> rewrite_fact divides_def sym=false goal=24 facts=[28]
    #[29] ∃k. n = p * k
  exists_elim d goal=24 facts=[29]
    #[30] _VAR d
    #[31] n = p * d
    #[32] P n
  -> forall_elim d goal=32 facts=[27]
    #[33] ¬(d = 0) ⟶ P d ⟶ P (p * d)
  ← rewrite_goal_with_prev goal=32 facts=[31]
    #[34] P (p * d)
  ← apply_prev goal=34 facts=[33]
    #[35] ¬(d = 0)
    #[36] P d
  -> rewrite_fact_with_prev goal=35 facts=[31,13]
    #[37] ¬(p * d = 0)
  ← apply_backward_step contrapositive goal=35 facts=[37]
    #[38] ¬¬(d = 0) ⟶ ¬¬(p * d = 0)
  ← rewrite_goal double_neg sym=false goal=38
    #[39] d = 0 ⟶ p * d = 0
  ← introduction goal=39
    #[40] d = 0
    #[41] p * d = 0
  ← rewrite_goal_with_prev goal=41 facts=[40]
    #[42] p * 0 = 0
  ← rewrite_goal mult_0_right sym=false goal=42
    #[43] p * 0 = 0
  ← apply_prev goal=36 facts=[7]
    #[44] d < n
  ← apply_backward_step prime_factor_lt param_p=p goal=44
qed

theorem complete_factor_induct
  fixes P :: nat => bool
  prop P 0 --> P 1 --> (!p. prime p --> P p) --> (!m. !n. P m --> P n --> P (m * n)) --> (!n. P n)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] P 0
    #[2] P 1
    #[3] ∀p. prime p ⟶ P p
    #[4] ∀m. ∀n. P m ⟶ P n ⟶ P (m * n)
    #[5] ∀n. P n
  ← apply_backward_step prime_factor_induct goal=5
    #[6] ∀p. ∀n. prime p ⟶ ¬(n = 0) ⟶ P n ⟶ P (p * n)
  ← introduction p,n goal=6
    #[7] _VAR p
    #[8] _VAR n
    #[9] prime p
    #[10] ¬(n = 0)
    #[11] P n
    #[12] P (p * n)
  -> apply_fact goal=12 facts=[3,9]
    #[13] P p
  ← apply_prev goal=12 facts=[4,13,11]
    #[14] P (p * n)
qed

theorem euclid_bound
  fixes n :: nat
  prop ?p. prime p & n < p & p <= Suc (fact n)
  [hint_backward]
proof
  -> apply_forward_step prime_factor param_n="fact n + 1" goal=0
    #[1] ¬(fact n + 1 = 1) ⟶ (∃p. prime p ∧ divides p (fact n + 1))
  cut "¬(fact n + 1 = 1)" goal=0 facts=[1]
    #[2] ¬(fact n + 1 = 1)
  cut "!n::nat. 0 < n --> ~(n + 1 = 1)" goal=2
    #[3] ∀n::nat. 0 < n ⟶ ¬(n + 1 = 1)
  ← z3 goal=3
  ← apply_prev goal=2 facts=[3]
    #[4] 0 < fact n
  ← apply_backward_step fact_lt goal=4
  -> apply_fact goal=0 facts=[1,2]
    #[5] ∃p. prime p ∧ divides p (fact n + 1)
  exists_elim p goal=0 facts=[5]
    #[6] _VAR p
    #[7] prime p ∧ divides p (fact n + 1)
    #[8] ∃p. prime p ∧ n < p ∧ p ≤ Suc (fact n)
  ← inst_exists_goal p goal=8
    #[9] prime p ∧ n < p ∧ p ≤ Suc (fact n)
  -> apply_forward_step conjD1 goal=9 facts=[7]
    #[10] prime p
  -> apply_forward_step conjD2 goal=9 facts=[7]
    #[11] divides p (fact n + 1)
  ← apply_backward_step conjI goal=9
    #[12] n < p ∧ p ≤ Suc (fact n)
  ← apply_backward_step conjI goal=12
    #[13] n < p
    #[14] p ≤ Suc (fact n)
  -> apply_forward_step divides_sum2 goal=13 facts=[11]
    #[15] divides p (fact n) ⟶ divides p 1
  -> rewrite_fact divides_one sym=false goal=13 facts=[15]
    #[16] divides p (fact n) ⟶ p = 1
  ← apply_backward_step contrapositive goal=13 facts=[16]
    #[17] ¬(n < p) ⟶ ¬(divides p (fact n) ⟶ p = 1)
  ← rewrite_goal not_lt sym=false goal=17
    #[18] p ≤ n ⟶ ¬(divides p (fact n) ⟶ p = 1)
  ← introduction goal=18
    #[19] p ≤ n
    #[20] ¬(divides p (fact n) ⟶ p = 1)
  ← rewrite_goal not_imp sym=false goal=20
    #[21] divides p (fact n) ∧ ¬(p = 1)
  ← apply_backward_step conjI goal=21
    #[22] divides p (fact n)
    #[23] ¬(p = 1)
  ← apply_backward_step divides_fact goal=22
    #[24] 1 ≤ p
  ← apply_backward_step contrapositive goal=24 facts=[10]
    #[25] ¬(1 ≤ p) ⟶ ¬(prime p)
  ← introduction goal=25
    #[26] ¬(1 ≤ p)
    #[27] ¬(prime p)
  -> rewrite_fact not_le sym=false goal=27 facts=[26]
    #[28] p < 1
  -> rewrite_fact nat_one_def sym=false goal=27 facts=[28]
    #[29] p < Suc 0
  -> rewrite_fact less_Suc_lesseq sym=false goal=27 facts=[29]
    #[30] p ≤ 0
  -> rewrite_fact nat_less_eq_def_1 sym=false goal=27 facts=[30]
    #[31] p = 0
  ← rewrite_goal_with_prev goal=27 facts=[31]
    #[32] ¬(prime 0)
  ← apply_backward_step prime_0 goal=32
    #[33] ¬(prime 0)
  ← apply_backward_step contrapositive goal=23 facts=[10]
    #[34] ¬¬(p = 1) ⟶ ¬(prime p)
  ← introduction goal=34
    #[35] ¬¬(p = 1)
    #[36] ¬(prime p)
  -> rewrite_fact double_neg sym=false goal=36 facts=[35]
    #[37] p = 1
  ← rewrite_goal_with_prev goal=36 facts=[37]
    #[38] ¬(prime 1)
  ← apply_backward_step prime_1 goal=38
    #[39] ¬(prime 1)
  -> apply_forward_step divides_le goal=14 facts=[11]
    #[40] p ≤ fact n + 1 ∨ fact n + 1 = 0
  ← apply_backward_step disjE goal=14 facts=[40]
    #[41] p ≤ fact n + 1 ⟶ p ≤ Suc (fact n)
    #[42] fact n + 1 = 0 ⟶ p ≤ Suc (fact n)
  ← introduction goal=41
    #[43] p ≤ fact n + 1
    #[44] p ≤ Suc (fact n)
  ← rewrite_goal add_1_right sym=true goal=44
  ← introduction goal=42
    #[45] fact n + 1 = 0
    #[46] p ≤ Suc (fact n)
  -> apply_forward_step add_is_zero goal=46 facts=[45]
    #[47] fact n = 0 ∧ (1::nat) = 0
  -> apply_forward_step conjD2 goal=46 facts=[47]
    #[48] (1::nat) = 0
  ← apply_backward_step contrapositive goal=46 facts=[48]
    #[49] ¬(p ≤ Suc (fact n)) ⟶ ¬((1::nat) = 0)
  ← introduction goal=49
    #[50] ¬(p ≤ Suc (fact n))
    #[51] ¬((1::nat) = 0)
  nat_const_ineq goal=51
    #[52] ¬((1::nat) = 0)
qed

theorem euclid
  fixes n :: nat
  prop ?p. prime p & p > n
  [hint_backward]
proof
  ← rewrite_goal greater_def sym=false goal=0
    #[1] ∃p. prime p ∧ n < p
  -> apply_forward_step euclid_bound param_n=n goal=1
    #[2] ∃p. prime p ∧ n < p ∧ p ≤ Suc (fact n)
  exists_elim p goal=1 facts=[2]
    #[3] _VAR p
    #[4] prime p ∧ n < p ∧ p ≤ Suc (fact n)
    #[5] ∃p. prime p ∧ n < p
    #[6] ∃p. prime p ∧ p > n
  ← inst_exists_goal p goal=5
    #[7] prime p ∧ n < p
  ← apply_backward_step conjI goal=7
    #[8] prime p
    #[9] n < p
  ← apply_backward_step conjD1 goal=8 facts=[4]
  -> apply_forward_step conjD2 goal=9 facts=[4]
    #[10] n < p ∧ p ≤ Suc (fact n)
  ← apply_backward_step conjD1 goal=9 facts=[10]
qed

theorem prime_infinite
  prop infinite ({p. prime p})
  [hint_backward]

theorem coprime_prime
  fixes a :: nat, b :: nat, p :: nat
  prop coprime a b --> ~(prime p & divides p a & divides p b)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime a b
    #[2] ¬(prime p ∧ divides p a ∧ divides p b)
  ← rewrite_goal de_morgan_thm1 sym=false goal=2
    #[3] ¬(prime p) ∨ ¬(divides p a ∧ divides p b)
  ← cases "(prime p)" goal=3
    #[4] prime p ⟶ ¬(prime p) ∨ ¬(divides p a ∧ divides p b)
    #[5] ¬(prime p) ⟶ ¬(prime p) ∨ ¬(divides p a ∧ divides p b)
  ← introduction goal=4
    #[6] prime p
    #[7] ¬(prime p) ∨ ¬(divides p a ∧ divides p b)
  ← apply_backward_step disjI2 goal=7
    #[8] ¬(divides p a ∧ divides p b)
  ← rewrite_goal de_morgan_thm1 sym=false goal=8
    #[9] ¬(divides p a) ∨ ¬(divides p b)
  ← cases "divides p a" goal=9
    #[10] divides p a ⟶ ¬(divides p a) ∨ ¬(divides p b)
    #[11] ¬(divides p a) ⟶ ¬(divides p a) ∨ ¬(divides p b)
  ← introduction goal=10
    #[12] divides p a
    #[13] ¬(divides p a) ∨ ¬(divides p b)
  ← apply_backward_step disjI2 goal=13
    #[14] ¬(divides p b)
  -> rewrite_fact coprime_def sym=false goal=14 facts=[1]
    #[15] ∀d. divides d a ∧ divides d b ⟷ d = 1
  ← apply_backward_step contrapositive goal=14 facts=[6]
    #[16] ¬¬(divides p b) ⟶ ¬(prime p)
  ← rewrite_goal double_neg sym=false goal=16
    #[17] divides p b ⟶ ¬(prime p)
  ← introduction goal=17
    #[18] divides p b
    #[19] ¬(prime p)
  -> apply_forward_step conjI goal=19 facts=[12,18]
    #[20] divides p a ∧ divides p b
  -> rewrite_fact_with_prev goal=19 facts=[15,20]
    #[21] p = 1
  ← rewrite_goal_with_prev goal=19 facts=[21]
    #[22] ¬(prime 1)
  ← apply_backward_step prime_1 goal=22
    #[23] ¬(prime 1)
  ← introduction goal=11
    #[24] ¬(divides p a)
    #[25] ¬(divides p a) ∨ ¬(divides p b)
  ← apply_backward_step disjI1 goal=25
  ← introduction goal=5
    #[26] ¬(prime p)
    #[27] ¬(prime p) ∨ ¬(divides p a ∧ divides p b)
  ← apply_backward_step disjI1 goal=27
qed

theorem coprime_prime_eq
  fixes a :: nat, b :: nat
  prop coprime a b <--> (!p. ~(prime p & divides p a & divides p b))
  [hint_rewrite]
proof
  ← apply_backward_step iffI goal=0
    #[1] coprime a b ⟶ (∀p. ¬(prime p ∧ divides p a ∧ divides p b))
    #[2] (∀p. ¬(prime p ∧ divides p a ∧ divides p b)) ⟶ coprime a b
  ← introduction goal=1
    #[3] coprime a b
    #[4] ∀p. ¬(prime p ∧ divides p a ∧ divides p b)
  ← introduction p goal=4
    #[5] _VAR p
    #[6] ¬(prime p ∧ divides p a ∧ divides p b)
  ← apply_backward_step coprime_prime goal=6
  ← introduction goal=2
    #[7] ∀p. ¬(prime p ∧ divides p a ∧ divides p b)
    #[8] coprime a b
  ← apply_backward_step contrapositive goal=8 facts=[7]
    #[9] ¬(coprime a b) ⟶ ¬(∀p. ¬(prime p ∧ divides p a ∧ divides p b))
  ← introduction goal=9
    #[10] ¬(coprime a b)
    #[11] ¬(∀p. ¬(prime p ∧ divides p a ∧ divides p b))
  -> rewrite_fact coprime_def sym=false goal=11 facts=[10]
    #[12] ¬(∀d. divides d a ∧ divides d b ⟷ d = 1)
  -> rewrite_fact not_all sym=false goal=11 facts=[12]
    #[13] ∃d. ¬(divides d a ∧ divides d b ⟷ d = 1)
  ← rewrite_goal not_all sym=false goal=11
    #[14] ∃p. ¬¬(prime p ∧ divides p a ∧ divides p b)
  ← rewrite_goal double_neg sym=false goal=14
    #[15] ∃p. prime p ∧ divides p a ∧ divides p b
  exists_elim x goal=15 facts=[13]
    #[16] _VAR x
    #[17] ¬(divides x a ∧ divides x b ⟷ x = 1)
    #[18] ∃p. prime p ∧ divides p a ∧ divides p b
    #[19] ∃p. ¬¬(prime p ∧ divides p a ∧ divides p b)
    #[20] ¬(∀p. ¬(prime p ∧ divides p a ∧ divides p b))
  -> apply_forward_step prime_factor param_n=x goal=18
    #[21] ¬(x = 1) ⟶ (∃p. prime p ∧ divides p x)
  ← cases "x=1" goal=18
    #[22] x = 1 ⟶ (∃p. prime p ∧ divides p a ∧ divides p b)
    #[23] ¬(x = 1) ⟶ (∃p. prime p ∧ divides p a ∧ divides p b)
  ← introduction goal=22
    #[24] x = 1
    #[25] ∃p. prime p ∧ divides p a ∧ divides p b
  ← apply_backward_step negE_gen goal=25 facts=[17]
    #[26] divides x a ∧ divides x b ⟷ x = 1
  ← rewrite_goal eq_sym_eq sym=false goal=26
    #[27] x = 1 ⟷ divides x a ∧ divides x b
  ← rewrite_goal_with_prev goal=27 facts=[24]
    #[28] (1::nat) = 1 ⟷ divides 1 a ∧ divides 1 b
  ← apply_backward_step iffI goal=28
    #[29] (1::nat) = 1 ⟶ divides 1 a ∧ divides 1 b
    #[30] divides 1 a ∧ divides 1 b ⟶ (1::nat) = 1
  ← introduction goal=29
    #[31] (1::nat) = 1
    #[32] divides 1 a ∧ divides 1 b
  ← apply_backward_step conjI goal=32
    #[33] divides 1 a
    #[34] divides 1 b
  ← apply_backward_step divides_1 goal=33
    #[35] divides 1 a
  ← apply_backward_step divides_1 goal=34
    #[36] divides 1 b
  ← introduction goal=30
    #[37] divides 1 a ∧ divides 1 b
    #[38] (1::nat) = 1
  ← apply_backward_step eq_refl goal=38
    #[39] (1::nat) = 1
  ← introduction goal=23
    #[40] ¬(x = 1)
    #[41] ∃p. prime p ∧ divides p a ∧ divides p b
  -> apply_fact goal=41 facts=[21,40]
    #[42] ∃p. prime p ∧ divides p x
  exists_elim p goal=41 facts=[42]
    #[43] prime p ∧ divides p x
    #[44] ∃p. prime p ∧ divides p a ∧ divides p b
  ← inst_exists_goal p goal=44
    #[45] prime p ∧ divides p a ∧ divides p b
  -> apply_forward_step conjD1 goal=45 facts=[43]
    #[46] prime p
  -> apply_forward_step conjD2 goal=45 facts=[43]
    #[47] divides p x
  ← apply_backward_step conjI goal=45
    #[48] divides p a ∧ divides p b
  ← apply_backward_step conjI goal=48
    #[49] divides p a
    #[50] divides p b
  cut "!p. !q. ~(p<-->q) <--> (p <--> ~q)" goal=49
    #[51] ∀p. ∀q. ¬(p ⟷ q) ⟷ p ⟷ ¬q
  ← z3 goal=51
    #[52] ∀p. ∀q. ¬(p ⟷ q) ⟷ p ⟷ ¬q
  -> rewrite_fact_with_prev goal=49 facts=[52,17]
    #[53] divides x a ∧ divides x b ⟷ ¬(x = 1)
  -> rewrite_fact eq_sym_eq sym=false goal=49 facts=[53]
    #[54] ¬(x = 1) ⟷ divides x a ∧ divides x b
  -> rewrite_fact_with_prev goal=49 facts=[54,40]
    #[55] divides x a ∧ divides x b
  -> apply_forward_step conjD1 goal=49 facts=[55]
    #[56] divides x a
  -> apply_forward_step conjD2 goal=49 facts=[55]
    #[57] divides x b
  ← apply_backward_step divides_trans goal=49 facts=[47,56]
    #[58] divides p a
  ← apply_backward_step divides_trans goal=50 facts=[47,57]
    #[59] divides p b
qed

theorem prime_coprime_strong
  fixes n :: nat, p :: nat
  prop prime p --> divides p n | coprime p n
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides p n ∨ coprime p n
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=2 facts=[1]
    #[3] ∀n. coprime p n ⟷ ¬(divides p n)
  ← cases "divides p n" goal=2
    #[4] divides p n ⟶ divides p n ∨ coprime p n
    #[5] ¬(divides p n) ⟶ divides p n ∨ coprime p n
  ← introduction goal=4
    #[6] divides p n
    #[7] divides p n ∨ coprime p n
  ← apply_backward_step disjI1 goal=7
  ← introduction goal=5
    #[8] ¬(divides p n)
    #[9] divides p n ∨ coprime p n
  ← apply_backward_step disjI2 goal=9
    #[10] coprime p n
  ← rewrite_goal_with_prev goal=10 facts=[3]
qed

theorem prime_coprime
  fixes n :: nat, p :: nat
  prop prime p --> n = 1 | divides p n | coprime p n
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] n = 1 ∨ divides p n ∨ coprime p n
  ← apply_backward_step disjI2 goal=2
    #[3] divides p n ∨ coprime p n
  ← apply_backward_step prime_coprime_strong goal=3
qed

theorem gcd_prime_cases
  fixes n :: nat, p :: nat
  prop prime p --> gcd p n = (if divides p n then p else 1)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] gcd p n = (if divides p n then p else 1)
  ← cases "divides p n" goal=2
    #[3] divides p n ⟶ gcd p n = (if divides p n then p else 1)
    #[4] ¬(divides p n) ⟶ gcd p n = (if divides p n then p else 1)
  ← introduction goal=3
    #[5] divides p n
    #[6] gcd p n = (if divides p n then p else 1)
  ← rewrite_goal if_P sym=false goal=6 facts=[5]
    #[7] gcd p n = p
  ← apply_backward_step gcd_equal_left goal=7 facts=[5]
    #[8] gcd p n = p
  ← introduction goal=4
    #[9] ¬(divides p n)
    #[10] gcd p n = (if divides p n then p else 1)
  ← rewrite_goal if_not_P sym=false goal=10 facts=[9]
    #[11] gcd p n = 1
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=11 facts=[1]
    #[12] ∀n. coprime p n ⟷ ¬(divides p n)
  -> rewrite_fact eq_sym_eq sym=false goal=11 facts=[12]
    #[13] ∀n. ¬(divides p n) ⟷ coprime p n
  -> rewrite_fact_with_prev goal=11 facts=[13,9]
    #[14] coprime p n
  -> rewrite_fact coprime_gcd sym=false goal=11 facts=[14]
qed

theorem gcd_2_cases
  fixes n :: nat
  prop gcd 2 n = (if even n then 2 else 1)
  [hint_rewrite]
proof
  ← rewrite_goal divides_2 sym=true goal=0
    #[1] gcd 2 n = (if divides 2 n then 2 else 1)
  ← apply_backward_step gcd_prime_cases goal=1
    #[2] prime 2
  ← apply_backward_step prime_2 goal=2
qed

theorem coprime_primepow
  fixes k :: nat, m :: nat, p :: nat
  prop prime p --> ~(k = 0) --> coprime m (p ^ k) <--> ~(divides p m)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ¬(k = 0)
    #[3] coprime m (p ^ k) ⟷ ¬(divides p m)
  ← rewrite_goal coprime_rexp sym=false goal=3
    #[4] coprime m p ∨ k = 0 ⟷ ¬(divides p m)
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=4 facts=[1]
    #[5] ∀n. coprime p n ⟷ ¬(divides p n)
  ← apply_backward_step iffI goal=4
    #[6] coprime m p ∨ k = 0 ⟶ ¬(divides p m)
    #[7] ¬(divides p m) ⟶ coprime m p ∨ k = 0
  ← introduction goal=6
    #[8] coprime m p ∨ k = 0
    #[9] ¬(divides p m)
  ← apply_backward_step disjE goal=9 facts=[8]
    #[10] coprime m p ⟶ ¬(divides p m)
    #[11] k = 0 ⟶ ¬(divides p m)
  ← introduction goal=10
    #[12] coprime m p
    #[13] ¬(divides p m)
  -> rewrite_fact coprime_sym sym=false goal=13 facts=[12]
    #[14] coprime p m
  -> rewrite_fact_with_prev goal=13 facts=[5,14]
    #[15] ¬(divides p m)
  ← introduction goal=11
    #[16] k = 0
    #[17] ¬(divides p m)
  ← apply_backward_step negE_gen goal=17 facts=[2,16]
    #[18] ¬(divides p m)
  ← introduction goal=7
    #[19] ¬(divides p m)
    #[20] coprime m p ∨ k = 0
  ← apply_backward_step disjI1 goal=20
    #[21] coprime m p
  ← rewrite_goal coprime_sym sym=false goal=21
    #[22] coprime p m
  ← rewrite_goal_with_prev goal=22 facts=[5]
qed

theorem coprime_bezout_strong
  fixes a :: nat, b :: nat
  prop coprime a b --> ~(b = 1) --> (?x. ?y. a * x = b * y + 1)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] coprime a b
    #[2] ¬(b = 1)
    #[3] ∃x. ∃y. a * x = b * y + 1
  -> rewrite_fact coprime_gcd sym=false goal=3 facts=[1]
    #[4] gcd a b = 1
  -> rewrite_fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] 1 = gcd a b
  ← rewrite_goal_with_prev goal=3 facts=[5]
    #[6] ∃x. ∃y. a * x = b * y + gcd a b
  ← apply_backward_step bezout_gcd_strong goal=6
    #[7] ¬(a = 0)
  ← apply_backward_step contrapositive goal=7 facts=[2]
    #[8] ¬¬(a = 0) ⟶ ¬¬(b = 1)
  ← rewrite_goal double_neg sym=false goal=8
    #[9] a = 0 ⟶ b = 1
  ← introduction goal=9
    #[10] a = 0
    #[11] b = 1
  -> rewrite_fact_with_prev goal=11 facts=[10,1]
    #[12] coprime 0 b
  -> rewrite_fact coprime_sym sym=false goal=11 facts=[12]
    #[13] coprime b 0
  -> rewrite_fact coprime_0 sym=false goal=11 facts=[13]
    #[14] b = 1
qed

theorem coprime_bezout_alt
  fixes a :: nat, b :: nat
  prop coprime a b --> ~(a = 0) --> (?x. ?y. a * x = b * y + 1)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] coprime a b
    #[2] ¬(a = 0)
    #[3] ∃x. ∃y. a * x = b * y + 1
  -> rewrite_fact coprime_gcd sym=false goal=3 facts=[1]
    #[4] gcd a b = 1
  -> rewrite_fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] 1 = gcd a b
  ← rewrite_goal_with_prev goal=3 facts=[5]
    #[6] ∃x. ∃y. a * x = b * y + gcd a b
  ← apply_backward_step bezout_gcd_strong goal=6
qed

theorem bezout_prime
  fixes a :: nat, p :: nat
  prop prime p --> ~(divides p a) --> (?x. ?y. a * x = p * y + 1)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ¬(divides p a)
    #[3] ∃x. ∃y. a * x = p * y + 1
  ← apply_backward_step coprime_bezout_strong goal=3
    #[4] coprime a p
    #[5] ¬(p = 1)
  -> apply_forward_step prime_coprime_strong param_n=a goal=4 facts=[1]
    #[6] divides p a ∨ coprime p a
  ← apply_backward_step disjE goal=4 facts=[6]
    #[7] divides p a ⟶ coprime a p
    #[8] coprime p a ⟶ coprime a p
  ← introduction goal=7
    #[9] divides p a
    #[10] coprime a p
  ← apply_backward_step negE_gen goal=10 facts=[2,9]
    #[11] coprime a p
  ← introduction goal=8
    #[12] coprime p a
    #[13] coprime a p
  ← rewrite_goal coprime_sym sym=false goal=13
  ← apply_backward_step contrapositive goal=5 facts=[1]
    #[14] ¬¬(p = 1) ⟶ ¬(prime p)
  ← introduction goal=14
    #[15] ¬¬(p = 1)
    #[16] ¬(prime p)
  -> rewrite_fact double_neg sym=false goal=16 facts=[15]
    #[17] p = 1
  ← rewrite_goal_with_prev goal=16 facts=[17]
    #[18] ¬(prime 1)
  ← apply_backward_step prime_1 goal=18
    #[19] ¬(prime 1)
qed

theorem prime_divprod
  fixes a :: nat, b :: nat, p :: nat
  prop prime p --> divides p (a * b) --> divides p a | divides p b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides p (a * b)
    #[3] divides p a ∨ divides p b
  -> apply_forward_step prime_coprime_strong param_n=b goal=3 facts=[1]
    #[4] divides p b ∨ coprime p b
  ← apply_backward_step disjE goal=3 facts=[4]
    #[5] divides p b ⟶ divides p a ∨ divides p b
    #[6] coprime p b ⟶ divides p a ∨ divides p b
  ← introduction goal=5
    #[7] divides p b
    #[8] divides p a ∨ divides p b
  ← apply_backward_step disjI2 goal=8
  ← introduction goal=6
    #[9] coprime p b
    #[10] divides p a ∨ divides p b
  ← apply_backward_step disjI1 goal=10
    #[11] divides p a
  ← apply_backward_step coprime_divprod param_a=b goal=11
    #[12] divides p (b * a)
  ← rewrite_goal mult_comm sym=false goal=12
qed

theorem prime_divprod_eq
  fixes a :: nat, b :: nat, p :: nat
  prop prime p --> divides p (a * b) <--> divides p a | divides p b
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides p (a * b) ⟷ divides p a ∨ divides p b
  ← apply_backward_step zero_one_or_prime_divprod goal=2
    #[3] p = 0 ∨ p = 1 ∨ prime p
  ← apply_backward_step disjI2 goal=3
    #[4] p = 1 ∨ prime p
  ← apply_backward_step disjI2 goal=4
qed

theorem prime_divexp
  fixes a :: nat, n :: nat, p :: nat
  prop prime p --> divides p (a ^ n) --> divides p a
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides p (a ^ n)
    #[3] divides p a
  revert_intro goal=3 facts=[2]
    #[4] divides p (a ^ n) ⟶ divides p a
  ← induction n nat_induct goal=4
    #[5] divides p (a ^ (0::nat)) ⟶ divides p a
    #[6] ∀n. (divides p (a ^ n) ⟶ divides p a) ⟶ divides p (a ^ Suc n) ⟶ divides p a
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=5
    #[7] divides p 1 ⟶ divides p a
  ← introduction goal=7
    #[8] divides p 1
    #[9] divides p a
  -> rewrite_fact divides_one sym=false goal=9 facts=[8]
    #[10] p = 1
  ← rewrite_goal_with_prev goal=9 facts=[10]
    #[11] divides 1 a
  ← apply_backward_step divides_1 goal=11
    #[12] divides 1 a
  ← introduction n goal=6
    #[13] _VAR n
    #[14] divides p (a ^ n) ⟶ divides p a
    #[15] divides p (a ^ Suc n)
    #[16] divides p a
  -> rewrite_fact nat_nat_power_def_2 sym=false goal=16 facts=[15]
    #[17] divides p (a * a ^ n)
  -> apply_forward_step prime_divprod goal=16 facts=[1,17]
    #[18] divides p a ∨ divides p (a ^ n)
  ← apply_backward_step disjE goal=16 facts=[18]
    #[19] divides p a ⟶ divides p a
qed

theorem prime_divexp_n
  fixes a :: nat, n :: nat, p :: nat
  prop prime p --> divides p (a ^ n) --> divides (p ^ n) (a ^ n)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides p (a ^ n)
    #[3] divides (p ^ n) (a ^ n)
  ← apply_backward_step divides_exp goal=3
    #[4] divides p a
  ← apply_backward_step prime_divexp goal=4 facts=[1,2]
qed

theorem prime_divexp_eq
  fixes a :: nat, n :: nat, p :: nat
  prop prime p --> divides p (a ^ n) <--> divides p a & ~(n = 0)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides p (a ^ n) ⟷ divides p a ∧ ¬(n = 0)
  ← cases "n = 0" goal=2
    #[3] n = 0 ⟶ divides p (a ^ n) ⟷ divides p a ∧ ¬(n = 0)
    #[4] ¬(n = 0) ⟶ divides p (a ^ n) ⟷ divides p a ∧ ¬(n = 0)
  ← introduction goal=3
    #[5] n = 0
    #[6] divides p (a ^ n) ⟷ divides p a ∧ ¬(n = 0)
  ← rewrite_goal_with_prev goal=6 facts=[5]
    #[7] divides p (a ^ (0::nat)) ⟷ divides p a ∧ ¬((0::nat) = 0)
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=7
    #[8] divides p 1 ⟷ divides p a ∧ ¬((0::nat) = 0)
  ← rewrite_goal divides_one sym=false goal=8
    #[9] p = 1 ⟷ divides p a ∧ ¬((0::nat) = 0)
  ← apply_backward_step iffI goal=9
    #[10] p = 1 ⟶ divides p a ∧ ¬((0::nat) = 0)
    #[11] divides p a ∧ ¬((0::nat) = 0) ⟶ p = 1
  ← introduction goal=10
    #[12] p = 1
    #[13] divides p a ∧ ¬((0::nat) = 0)
  -> rewrite_fact_with_prev goal=13 facts=[12,1]
    #[14] prime 1
  ← apply_backward_step contrapositive goal=13 facts=[14]
    #[15] ¬(divides p a ∧ ¬((0::nat) = 0)) ⟶ ¬(prime 1)
  ← introduction goal=15
    #[16] ¬(divides p a ∧ ¬((0::nat) = 0))
    #[17] ¬(prime 1)
  ← apply_backward_step prime_1 goal=17
    #[18] ¬(prime 1)
  ← introduction goal=11
    #[19] divides p a ∧ ¬((0::nat) = 0)
    #[20] p = 1
  -> apply_forward_step conjD2 goal=20 facts=[19]
    #[21] ¬((0::nat) = 0)
  ← apply_backward_step negE_gen goal=20 facts=[21]
    #[22] (0::nat) = 0
  ← apply_backward_step eq_refl goal=22
    #[23] (0::nat) = 0
  ← introduction goal=4
    #[24] ¬(n = 0)
    #[25] divides p (a ^ n) ⟷ divides p a ∧ ¬(n = 0)
  ← apply_backward_step iffI goal=25
    #[26] divides p (a ^ n) ⟶ divides p a ∧ ¬(n = 0)
    #[27] divides p a ∧ ¬(n = 0) ⟶ divides p (a ^ n)
  ← introduction goal=26
    #[28] divides p (a ^ n)
    #[29] divides p a ∧ ¬(n = 0)
  ← apply_backward_step conjI goal=29
    #[30] divides p a
  ← apply_backward_step prime_divexp goal=30 facts=[1,28]
    #[31] divides p a
  ← introduction goal=27
    #[32] divides p a ∧ ¬(n = 0)
    #[33] divides p (a ^ n)
  -> apply_forward_step conjD1 goal=33 facts=[32]
    #[34] divides p a
  ← apply_backward_step divides_rexp goal=33
qed

theorem parity_exp
  fixes a :: nat, n :: nat
  prop even (a ^ Suc n) <--> even a
  [hint_rewrite]
proof
  ← rewrite_goal divides_2 sym=true goal=0
    #[1] divides 2 (a ^ Suc n) ⟷ divides 2 a
  ← apply_backward_step iffI goal=1
    #[2] divides 2 (a ^ Suc n) ⟶ divides 2 a
    #[3] divides 2 a ⟶ divides 2 (a ^ Suc n)
  ← introduction goal=2
    #[4] divides 2 (a ^ Suc n)
    #[5] divides 2 a
  ← apply_backward_step prime_divexp param_n="Suc n" goal=5
    #[6] prime 2
  ← apply_backward_step prime_2 goal=6
    #[7] prime 2
  ← introduction goal=3
    #[8] divides 2 a
    #[9] divides 2 (a ^ Suc n)
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=9
    #[10] divides 2 (a * a ^ n)
  ← apply_backward_step divides_rmul goal=10 facts=[8]
qed

theorem coprime_sos
  fixes x :: nat, y :: nat
  prop coprime x y --> coprime (x * y) (x ^ (2::nat) + y ^ (2::nat))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] coprime x y
    #[2] coprime (x * y) (x ^ (2::nat) + y ^ (2::nat))
  ← rewrite_goal exp_2 sym=false goal=2
    #[3] coprime (x * y) (x * x + y * y)
  ← rewrite_goal coprime_lmul sym=false goal=3
    #[4] coprime x (x * x + y * y) ∧ coprime y (x * x + y * y)
  ← apply_backward_step conjI goal=4
    #[5] coprime x (x * x + y * y)
    #[6] coprime y (x * x + y * y)
  ← rewrite_goal coprime_gcd sym=false goal=5
    #[7] gcd x (x * x + y * y) = 1
  ← rewrite_goal gcd_mod sym=false goal=7
    #[8] gcd x (y * y) = 1
  ← rewrite_goal exp_2 sym=true goal=8
    #[9] gcd x (y ^ (2::nat)) = 1
  ← rewrite_goal coprime_gcd sym=true goal=9
    #[10] coprime x (y ^ (2::nat))
  ← apply_backward_step coprime_exp goal=10
  ← rewrite_goal coprime_gcd sym=false goal=6
    #[11] gcd y (x * x + y * y) = 1
  ← rewrite_goal add_comm sym=false goal=11
    #[12] gcd y (y * y + x * x) = 1
  ← rewrite_goal gcd_mod sym=false goal=12
    #[13] gcd y (x * x) = 1
  ← rewrite_goal exp_2 sym=true goal=13
    #[14] gcd y (x ^ (2::nat)) = 1
  ← rewrite_goal coprime_gcd sym=true goal=14
    #[15] coprime y (x ^ (2::nat))
  ← apply_backward_step coprime_exp goal=15
    #[16] coprime y x
  ← rewrite_goal coprime_sym sym=false goal=16
qed

theorem prime_imp_nz
  fixes p :: nat
  prop prime p --> ~(p = 0)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ¬(p = 0)
  ← apply_backward_step contrapositive goal=2 facts=[1]
    #[3] ¬¬(p = 0) ⟶ ¬(prime p)
  ← introduction goal=3
    #[4] ¬¬(p = 0)
    #[5] ¬(prime p)
  -> rewrite_fact double_neg sym=false goal=5 facts=[4]
    #[6] p = 0
  ← rewrite_goal_with_prev goal=5 facts=[6]
    #[7] ¬(prime 0)
  ← apply_backward_step prime_0 goal=7
    #[8] ¬(prime 0)
qed

theorem distinct_prime_coprime
  fixes p :: nat, q :: nat
  prop prime p --> prime q --> ~(p = q) --> coprime p q
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] prime q
    #[3] ¬(p = q)
    #[4] coprime p q
  -> rewrite_fact prime_def sym=false goal=4 facts=[1]
    #[5] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> rewrite_fact prime_def sym=false goal=4 facts=[2]
    #[6] ¬(q = 1) ∧ (∀x. divides x q ⟶ x = 1 ∨ x = q)
  ← rewrite_goal coprime_def sym=false goal=4
    #[7] ∀d. divides d p ∧ divides d q ⟷ d = 1
  ← introduction d goal=7
    #[8] _VAR d
    #[9] divides d p ∧ divides d q ⟷ d = 1
  ← apply_backward_step iffI goal=9
    #[10] divides d p ∧ divides d q ⟶ d = 1
    #[11] d = 1 ⟶ divides d p ∧ divides d q
  ← introduction goal=10
    #[12] divides d p ∧ divides d q
    #[13] d = 1
  -> apply_forward_step conjD1 goal=13 facts=[12]
    #[14] divides d p
  -> apply_forward_step conjD2 goal=13 facts=[12]
    #[15] divides d q
  -> apply_forward_step conjD2 goal=13 facts=[5]
    #[16] ∀x. divides x p ⟶ x = 1 ∨ x = p
  -> apply_fact goal=13 facts=[16,14]
    #[17] d = 1 ∨ d = p
  ← apply_backward_step disjE goal=13 facts=[17]
    #[18] d = 1 ⟶ d = 1
    #[19] d = p ⟶ d = 1
  ← introduction goal=19
    #[20] d = p
    #[21] d = 1
  -> apply_forward_step conjD2 goal=21 facts=[6]
    #[22] ∀x. divides x q ⟶ x = 1 ∨ x = q
  -> apply_fact goal=21 facts=[22,15]
    #[23] d = 1 ∨ d = q
  ← apply_backward_step disjE goal=21 facts=[23]
  ← introduction goal=11
    #[24] d = 1
    #[25] divides d p ∧ divides d q
  ← rewrite_goal_with_prev goal=25 facts=[24]
    #[26] divides 1 p ∧ divides 1 q
  ← apply_backward_step conjI goal=26
    #[27] divides 1 p
    #[28] divides 1 q
  ← apply_backward_step divides_1 goal=27
    #[29] divides 1 p
  ← apply_backward_step divides_1 goal=28
    #[30] divides 1 q
qed

theorem prime_coprime_lt
  fixes p :: nat, x :: nat
  prop prime p --> 0 < x --> x < p --> coprime x p
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] 0 < x
    #[3] x < p
    #[4] coprime x p
  -> rewrite_fact prime_def sym=false goal=4 facts=[1]
    #[5] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← rewrite_goal coprime_def sym=false goal=4
    #[6] ∀d. divides d x ∧ divides d p ⟷ d = 1
  ← introduction d goal=6
    #[7] _VAR d
    #[8] divides d x ∧ divides d p ⟷ d = 1
  ← apply_backward_step iffI goal=8
    #[9] divides d x ∧ divides d p ⟶ d = 1
    #[10] d = 1 ⟶ divides d x ∧ divides d p
  ← introduction goal=9
    #[11] divides d x ∧ divides d p
    #[12] d = 1
  -> apply_forward_step conjD2 goal=12 facts=[11]
    #[13] divides d p
  -> apply_forward_step conjD2 goal=12 facts=[5]
    #[14] ∀x. divides x p ⟶ x = 1 ∨ x = p
  -> apply_fact goal=12 facts=[14,13]
    #[15] d = 1 ∨ d = p
  ← apply_backward_step disjE goal=12 facts=[15]
    #[16] d = 1 ⟶ d = 1
    #[17] d = p ⟶ d = 1
  ← introduction goal=17
    #[18] d = p
    #[19] d = 1
  -> apply_forward_step conjD1 goal=19 facts=[11]
    #[20] divides d x
  -> apply_forward_step divides_le goal=19 facts=[20]
    #[21] d ≤ x ∨ x = 0
  ← apply_backward_step disjE goal=19 facts=[21]
    #[22] d ≤ x ⟶ d = 1
    #[23] x = 0 ⟶ d = 1
  ← introduction goal=22
    #[24] d ≤ x
    #[25] d = 1
  -> rewrite_fact_with_prev goal=25 facts=[18,24]
    #[26] p ≤ x
  ← apply_backward_step contrapositive goal=25 facts=[26]
    #[27] ¬(d = 1) ⟶ ¬(p ≤ x)
  ← rewrite_goal not_le sym=false goal=27
    #[28] ¬(d = 1) ⟶ x < p
  ← introduction goal=28
    #[29] ¬(d = 1)
  ← introduction goal=23
    #[30] x = 0
    #[31] d = 1
  -> rewrite_fact_with_prev goal=31 facts=[30,2]
    #[32] (0::nat) < 0
  -> rewrite_fact nat_less_def_1 sym=false goal=31 facts=[32]
    #[33] false
  ← apply_resolve_step not_false_res goal=31 facts=[33]
    #[34] d = 1
  ← introduction goal=10
    #[35] d = 1
    #[36] divides d x ∧ divides d p
  ← rewrite_goal_with_prev goal=36 facts=[35]
    #[37] divides 1 x ∧ divides 1 p
  ← apply_backward_step conjI goal=37
    #[38] divides 1 x
    #[39] divides 1 p
  ← apply_backward_step divides_1 goal=38
    #[40] divides 1 x
  ← apply_backward_step divides_1 goal=39
    #[41] divides 1 p
qed

theorem divides_prime_prime
  fixes p :: nat, q :: nat
  prop prime p --> prime q --> divides p q <--> p = q
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] prime q
    #[3] divides p q ⟷ p = q
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=3 facts=[1]
    #[4] ∀n. coprime p n ⟷ ¬(divides p n)
  -> rewrite_fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] ∀n. ¬(divides p n) ⟷ coprime p n
  ← apply_backward_step iffI goal=3
    #[6] divides p q ⟶ p = q
    #[7] p = q ⟶ divides p q
  ← introduction goal=6
    #[8] divides p q
    #[9] p = q
  -> rewrite_fact double_neg sym=true goal=9 facts=[8]
    #[10] ¬¬(divides p q)
  -> rewrite_fact_with_prev goal=9 facts=[5,10]
    #[11] ¬(coprime p q)
  ← apply_backward_step contrapositive goal=9 facts=[11]
    #[12] ¬(p = q) ⟶ ¬¬(coprime p q)
  ← introduction goal=12
    #[13] ¬(p = q)
    #[14] ¬¬(coprime p q)
  ← rewrite_goal double_neg sym=false goal=14
    #[15] coprime p q
  ← apply_backward_step distinct_prime_coprime goal=15
  ← introduction goal=7
    #[16] p = q
    #[17] divides p q
  ← rewrite_goal_with_prev goal=17 facts=[16]
    #[18] divides q q
  ← apply_backward_step divides_self goal=18
    #[19] divides q q
qed

theorem coprime_prime_prime
  fixes p :: nat, q :: nat
  prop prime p --> prime q --> coprime p q <--> ~(p = q)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] prime q
    #[3] coprime p q ⟷ ¬(p = q)
  -> apply_forward_step divides_prime_prime goal=3 facts=[1,2]
    #[4] divides p q ⟷ p = q
  -> rewrite_fact eq_sym_eq sym=false goal=3 facts=[4]
    #[5] p = q ⟷ divides p q
  ← rewrite_goal_with_prev goal=3 facts=[5]
    #[6] coprime p q ⟷ ¬(divides p q)
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=6 facts=[1]
    #[7] ∀n. coprime p n ⟷ ¬(divides p n)
  ← apply_prev goal=6 facts=[7]
    #[8] coprime p q ⟷ ¬(divides p q)
qed

theorem divides_prime_exp_le
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop prime p --> prime q --> divides (p ^ m) (q ^ n) <--> m = 0 | p = q & m <= n
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] prime q
    #[3] divides (p ^ m) (q ^ n) ⟷ m = 0 ∨ p = q ∧ m ≤ n
  ← induction m nat_induct goal=3
    #[4] divides (p ^ (0::nat)) (q ^ n) ⟷ (0::nat) = 0 ∨ p = q ∧ 0 ≤ n
    #[5] ∀n1. divides (p ^ n1) (q ^ n) ⟷ n1 = 0 ∨ p = q ∧ n1 ≤ n ⟶ divides (p ^ Suc n1) (q ^ n) ⟷ Suc n1 = 0 ∨ p = q ∧ Suc n1 ≤ n
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=4
    #[6] divides 1 (q ^ n) ⟷ (0::nat) = 0 ∨ p = q ∧ 0 ≤ n
  ← apply_backward_step iffI goal=6
    #[7] divides 1 (q ^ n) ⟶ (0::nat) = 0 ∨ p = q ∧ 0 ≤ n
    #[8] (0::nat) = 0 ∨ p = q ∧ 0 ≤ n ⟶ divides 1 (q ^ n)
  ← introduction goal=7
    #[9] divides 1 (q ^ n)
    #[10] (0::nat) = 0 ∨ p = q ∧ 0 ≤ n
  ← apply_backward_step disjI1 goal=10
    #[11] (0::nat) = 0
  ← apply_backward_step eq_refl goal=11
    #[12] (0::nat) = 0
  ← introduction goal=8
    #[13] (0::nat) = 0 ∨ p = q ∧ 0 ≤ n
    #[14] divides 1 (q ^ n)
  ← apply_backward_step divides_1 goal=14
    #[15] divides 1 (q ^ n)
  ← introduction m goal=5
    #[16] _VAR m
    #[17] divides (p ^ m) (q ^ n) ⟷ m = 0 ∨ p = q ∧ m ≤ n
    #[18] divides (p ^ Suc m) (q ^ n) ⟷ Suc m = 0 ∨ p = q ∧ Suc m ≤ n
  ← apply_backward_step iffI goal=18
    #[19] divides (p ^ Suc m) (q ^ n) ⟶ Suc m = 0 ∨ p = q ∧ Suc m ≤ n
    #[20] Suc m = 0 ∨ p = q ∧ Suc m ≤ n ⟶ divides (p ^ Suc m) (q ^ n)
  ← introduction goal=19
    #[21] divides (p ^ Suc m) (q ^ n)
    #[22] Suc m = 0 ∨ p = q ∧ Suc m ≤ n
  ← apply_backward_step disjI2 goal=22
    #[23] p = q ∧ Suc m ≤ n
  -> rewrite_fact nat_nat_power_def_2 sym=false goal=23 facts=[21]
    #[24] divides (p * p ^ m) (q ^ n)
  -> apply_forward_step divides_rmul2 goal=23 facts=[24]
    #[25] divides p (q ^ n)
  ← apply_backward_step conjI goal=23
    #[26] p = q
    #[27] Suc m ≤ n
  -> apply_forward_step divides_prime_prime goal=26 facts=[1,2]
    #[28] divides p q ⟷ p = q
  -> rewrite_fact eq_sym_eq sym=false goal=26 facts=[28]
    #[29] p = q ⟷ divides p q
  ← rewrite_goal_with_prev goal=26 facts=[29]
    #[30] divides p q
  ← apply_backward_step prime_divexp goal=30 facts=[1,25]
    #[31] divides p q
  -> rewrite_fact_with_prev goal=27 facts=[26,21]
    #[32] divides (q ^ Suc m) (q ^ n)
  -> apply_forward_step prime_ge_2 goal=27 facts=[2]
    #[33] 2 ≤ q
  -> apply_forward_step divides_exp_le param_m="Suc m" param_n=n goal=27 facts=[33]
    #[34] divides (q ^ Suc m) (q ^ n) ⟷ Suc m ≤ n
  -> rewrite_fact_with_prev goal=27 facts=[34,32]
  ← introduction goal=20
    #[35] Suc m = 0 ∨ p = q ∧ Suc m ≤ n
    #[36] divides (p ^ Suc m) (q ^ n)
  ← apply_backward_step disjE goal=36 facts=[35]
    #[37] Suc m = 0 ⟶ divides (p ^ Suc m) (q ^ n)
    #[38] p = q ∧ Suc m ≤ n ⟶ divides (p ^ Suc m) (q ^ n)
  ← introduction goal=37
    #[39] Suc m = 0
    #[40] divides (p ^ Suc m) (q ^ n)
  ← apply_backward_step contrapositive goal=40 facts=[39]
    #[41] ¬(divides (p ^ Suc m) (q ^ n)) ⟶ ¬(Suc m = 0)
  ← introduction goal=41
    #[42] ¬(divides (p ^ Suc m) (q ^ n))
    #[43] ¬(Suc m = 0)
  ← apply_backward_step ineq_sym goal=43
    #[44] ¬(0 = Suc m)
  ← apply_backward_step nat_zero_Suc_neq goal=44
    #[45] ¬(0 = Suc m)
  ← introduction goal=38
    #[46] p = q ∧ Suc m ≤ n
    #[47] divides (p ^ Suc m) (q ^ n)
  -> apply_forward_step conjD1 goal=47 facts=[46]
    #[48] p = q
  -> apply_forward_step conjD2 goal=47 facts=[46]
    #[49] Suc m ≤ n
  ← rewrite_goal_with_prev goal=47 facts=[48]
    #[50] divides (q ^ Suc m) (q ^ n)
  ← apply_backward_step divides_exp_le_imp goal=50 facts=[49]
    #[51] divides (q ^ Suc m) (q ^ n)
qed

theorem eq_prime_exp
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop prime p --> prime q --> p ^ m = q ^ n <--> m = 0 & n = 0 | p = q & m = n
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] prime q
    #[3] p ^ m = q ^ n ⟷ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← apply_backward_step iffI goal=3
    #[4] p ^ m = q ^ n ⟶ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
    #[5] m = 0 ∧ n = 0 ∨ p = q ∧ m = n ⟶ p ^ m = q ^ n
  ← introduction goal=4
    #[6] p ^ m = q ^ n
    #[7] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  -> apply_forward_step divides_prime_exp_le param_m=m param_n=n goal=7 facts=[1,2]
    #[8] divides (p ^ m) (q ^ n) ⟷ m = 0 ∨ p = q ∧ m ≤ n
  -> rewrite_fact_with_prev goal=7 facts=[6,8]
    #[9] divides (q ^ n) (q ^ n) ⟷ m = 0 ∨ p = q ∧ m ≤ n
  cut "divides (q ^ n) (q ^ n)" goal=7
    #[10] divides (q ^ n) (q ^ n)
  ← apply_backward_step divides_self goal=10
    #[11] divides (q ^ n) (q ^ n)
  -> rewrite_fact_with_prev goal=7 facts=[9,11]
    #[12] m = 0 ∨ p = q ∧ m ≤ n
  -> rewrite_fact eq_sym_eq sym=false goal=7 facts=[6]
    #[13] q ^ n = p ^ m
  -> apply_forward_step divides_prime_exp_le param_m=n param_n=m goal=7 facts=[2,1]
    #[14] divides (q ^ n) (p ^ m) ⟷ n = 0 ∨ q = p ∧ n ≤ m
  -> rewrite_fact_with_prev goal=7 facts=[13,14]
    #[15] divides (p ^ m) (p ^ m) ⟷ n = 0 ∨ q = p ∧ n ≤ m
  cut "divides (p ^ m) (p ^ m)" goal=7
    #[16] divides (p ^ m) (p ^ m)
  ← apply_backward_step divides_self goal=16
    #[17] divides (p ^ m) (p ^ m)
  -> rewrite_fact_with_prev goal=7 facts=[15,17]
    #[18] n = 0 ∨ q = p ∧ n ≤ m
  ← apply_backward_step disjE goal=7 facts=[12]
    #[19] m = 0 ⟶ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
    #[20] p = q ∧ m ≤ n ⟶ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← introduction goal=19
    #[21] m = 0
    #[22] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← cases "n=0" goal=22
    #[23] n = 0 ⟶ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
    #[24] ¬(n = 0) ⟶ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← introduction goal=23
    #[25] n = 0
    #[26] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← apply_backward_step disjI1 goal=26
    #[27] m = 0 ∧ n = 0
  ← apply_backward_step conjI goal=27
  ← introduction goal=24
    #[28] ¬(n = 0)
    #[29] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← apply_backward_step disjE goal=29 facts=[18]
    #[30] q = p ∧ n ≤ m ⟶ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← introduction goal=30
    #[31] q = p ∧ n ≤ m
    #[32] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  -> apply_forward_step conjD2 goal=32 facts=[31]
    #[33] n ≤ m
  -> rewrite_fact_with_prev goal=32 facts=[21,33]
    #[34] n ≤ 0
  -> rewrite_fact nat_less_eq_def_1 sym=false goal=32 facts=[34]
    #[35] n = 0
  ← apply_backward_step negE_gen goal=32 facts=[28,35]
    #[36] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← introduction goal=20
    #[37] p = q ∧ m ≤ n
    #[38] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← apply_backward_step disjE goal=38 facts=[18]
    #[39] n = 0 ⟶ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
    #[40] q = p ∧ n ≤ m ⟶ m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← introduction goal=39
    #[41] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← apply_backward_step disjI1 goal=41
    #[42] m = 0 ∧ n = 0
  ← apply_backward_step conjI goal=42
    #[43] m = 0
  -> apply_forward_step conjD2 goal=43 facts=[37]
    #[44] m ≤ n
  -> rewrite_fact_with_prev goal=43 facts=[25,44]
    #[45] m ≤ 0
  -> rewrite_fact nat_less_eq_def_1 sym=false goal=43 facts=[45]
    #[46] m = 0
  ← introduction goal=40
    #[47] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
  ← apply_backward_step disjI2 goal=47
    #[48] p = q ∧ m = n
  ← apply_backward_step conjI goal=48
    #[49] p = q
    #[50] m = n
  ← apply_backward_step conjD1 goal=49 facts=[37]
    #[51] p = q
  -> apply_forward_step conjD2 goal=50 facts=[37]
  -> apply_forward_step conjD2 goal=50 facts=[31]
  -> apply_forward_step conjI goal=50 facts=[44,33]
    #[52] m ≤ n ∧ n ≤ m
  -> rewrite_fact le_antisym sym=false goal=50 facts=[52]
    #[53] m = n
  ← introduction goal=5
    #[54] m = 0 ∧ n = 0 ∨ p = q ∧ m = n
    #[55] p ^ m = q ^ n
  ← apply_backward_step disjE goal=55 facts=[54]
    #[56] m = 0 ∧ n = 0 ⟶ p ^ m = q ^ n
    #[57] p = q ∧ m = n ⟶ p ^ m = q ^ n
  ← introduction goal=56
    #[58] m = 0 ∧ n = 0
    #[59] p ^ m = q ^ n
  -> apply_forward_step conjD1 goal=59 facts=[58]
    #[60] m = 0
  -> apply_forward_step conjD2 goal=59 facts=[58]
    #[61] n = 0
  ← rewrite_goal_with_prev goal=59 facts=[60]
    #[62] p ^ (0::nat) = q ^ n
  ← rewrite_goal_with_prev goal=62 facts=[61]
    #[63] p ^ (0::nat) = q ^ (0::nat)
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=63
    #[64] p ^ (0::nat) = q ^ (0::nat)
  ← introduction goal=57
    #[65] p = q ∧ m = n
    #[66] p ^ m = q ^ n
  -> apply_forward_step conjD1 goal=66 facts=[65]
    #[67] p = q
  -> apply_forward_step conjD2 goal=66 facts=[65]
    #[68] m = n
  ← rewrite_goal_with_prev goal=66 facts=[67]
    #[69] q ^ m = q ^ n
  ← rewrite_goal_with_prev goal=69 facts=[68]
    #[70] q ^ m = q ^ n
qed

theorem prime_odd
  fixes p :: nat
  prop prime p --> p = 2 | odd p
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] p = 2 ∨ odd p
  -> rewrite_fact prime_def sym=false goal=2 facts=[1]
    #[3] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD2 goal=2 facts=[3]
    #[4] ∀x. divides x p ⟶ x = 1 ∨ x = p
  ← rewrite_goal not_even sym=true goal=2
    #[5] p = 2 ∨ ¬(even p)
  -> forall_elim "(2::nat)" goal=5 facts=[4]
    #[6] divides 2 p ⟶ (2::nat) = 1 ∨ 2 = p
  ← cases "even p" goal=5
    #[7] even p ⟶ p = 2 ∨ ¬(even p)
    #[8] ¬(even p) ⟶ p = 2 ∨ ¬(even p)
  ← introduction goal=7
    #[9] even p
    #[10] p = 2 ∨ ¬(even p)
  -> rewrite_fact divides_2 sym=true goal=10 facts=[9]
    #[11] divides 2 p
  -> apply_fact goal=10 facts=[6,11]
    #[12] (2::nat) = 1 ∨ 2 = p
  ← apply_backward_step disjI1 goal=10
    #[13] p = 2
  ← apply_backward_step disjE goal=13 facts=[12]
    #[14] (2::nat) = 1 ⟶ p = 2
    #[15] 2 = p ⟶ p = 2
  ← introduction goal=14
    #[16] (2::nat) = 1
    #[17] p = 2
  ← z3 goal=17 facts=[16]
    #[18] p = 2
  ← introduction goal=15
    #[19] 2 = p
    #[20] p = 2
  ← rewrite_goal eq_sym_eq sym=false goal=20
  ← introduction goal=8
    #[21] ¬(even p)
    #[22] p = 2 ∨ ¬(even p)
  ← apply_backward_step disjI2 goal=22
qed

theorem odd_prime
  fixes p :: nat
  prop prime p --> odd p <--> 3 <= p
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] odd p ⟷ 3 ≤ p
  ← cases "p=0" goal=2
    #[3] p = 0 ⟶ odd p ⟷ 3 ≤ p
    #[4] ¬(p = 0) ⟶ odd p ⟷ 3 ≤ p
  ← introduction goal=3
    #[5] p = 0
    #[6] odd p ⟷ 3 ≤ p
  -> rewrite_fact_with_prev goal=6 facts=[5,1]
    #[7] prime 0
  ← apply_backward_step contrapositive goal=6 facts=[7]
    #[8] ¬(odd p ⟷ 3 ≤ p) ⟶ ¬(prime 0)
  ← introduction goal=8
    #[9] ¬(odd p ⟷ 3 ≤ p)
    #[10] ¬(prime 0)
  ← apply_backward_step prime_0 goal=10
    #[11] ¬(prime 0)
  ← introduction goal=4
    #[12] ¬(p = 0)
    #[13] odd p ⟷ 3 ≤ p
  -> apply_forward_step le_1_2 goal=13 facts=[12]
    #[14] 1 ≤ p
  -> rewrite_fact le_lt sym=false goal=13 facts=[14]
    #[15] 1 < p ∨ 1 = p
  ← apply_backward_step disjE goal=13 facts=[15]
    #[16] 1 < p ⟶ odd p ⟷ 3 ≤ p
    #[17] 1 = p ⟶ odd p ⟷ 3 ≤ p
  ← introduction goal=16
    #[18] 1 < p
    #[19] odd p ⟷ 3 ≤ p
  ← cases "p=2" goal=19
    #[20] p = 2 ⟶ odd p ⟷ 3 ≤ p
    #[21] ¬(p = 2) ⟶ odd p ⟷ 3 ≤ p
  ← introduction goal=20
    #[22] p = 2
    #[23] odd p ⟷ 3 ≤ p
  ← rewrite_goal_with_prev goal=23 facts=[22]
    #[24] odd 2 ⟷ (3::nat) ≤ 2
  ← apply_backward_step iffI goal=24
    #[25] odd 2 ⟶ (3::nat) ≤ 2
    #[26] (3::nat) ≤ 2 ⟶ odd 2
  ← introduction goal=25
    #[27] odd 2
    #[28] (3::nat) ≤ 2
  -> rewrite_fact not_even sym=true goal=28 facts=[27]
    #[29] ¬(even 2)
  ← apply_backward_step negE_gen goal=28 facts=[29]
    #[30] even 2
  ← rewrite_goal even_exists sym=false goal=30
    #[31] ∃m::nat. 2 = 2 * m
  ← inst_exists_goal "(1::nat)" goal=31
    #[32] (2::nat) = 2 * 1
  ← rewrite_goal mult_1_right sym=false goal=32
    #[33] (2::nat) = 2 * 1
  ← introduction goal=26
    #[34] (3::nat) ≤ 2
    #[35] odd 2
  ← z3 goal=35 facts=[34]
    #[36] odd 2
  ← introduction goal=21
    #[37] ¬(p = 2)
    #[38] odd p ⟷ 3 ≤ p
  -> apply_forward_step prime_odd goal=38 facts=[1]
    #[39] p = 2 ∨ odd p
  ← apply_backward_step disjE goal=38 facts=[39]
    #[40] odd p ⟶ odd p ⟷ 3 ≤ p
  ← introduction goal=40
    #[41] odd p
    #[42] odd p ⟷ 3 ≤ p
  ← apply_backward_step iffI goal=42
    #[43] odd p ⟶ 3 ≤ p
    #[44] 3 ≤ p ⟶ odd p
  ← introduction goal=43
    #[45] 3 ≤ p
  ← z3 goal=45 facts=[37,18]
    #[46] 3 ≤ p
  ← introduction goal=44
    #[47] 3 ≤ p
  ← introduction goal=17
    #[48] 1 = p
    #[49] odd p ⟷ 3 ≤ p
  -> rewrite_fact eq_sym_eq sym=false goal=49 facts=[48]
    #[50] p = 1
  -> rewrite_fact_with_prev goal=49 facts=[50,1]
    #[51] prime 1
  ← apply_backward_step contrapositive goal=49 facts=[51]
    #[52] ¬(odd p ⟷ 3 ≤ p) ⟶ ¬(prime 1)
  ← introduction goal=52
    #[53] ¬(prime 1)
  ← apply_backward_step prime_1 goal=53
    #[54] ¬(prime 1)
qed

theorem divides_fact_prime
  fixes p :: nat
  prop prime p --> (!n. divides p (fact n) <--> p <= n)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ∀n. divides p (fact n) ⟷ p ≤ n
  ← introduction n goal=2
    #[3] _VAR n
    #[4] divides p (fact n) ⟷ p ≤ n
  ← induction n nat_induct goal=4
    #[5] divides p (fact 0) ⟷ p ≤ 0
    #[6] ∀n. divides p (fact n) ⟷ p ≤ n ⟶ divides p (fact (Suc n)) ⟷ p ≤ Suc n
  ← rewrite_goal nat_less_eq_def_1 sym=false goal=5
    #[7] divides p (fact 0) ⟷ p = 0
  ← rewrite_goal fact_def_1 sym=false goal=7
    #[8] divides p 1 ⟷ p = 0
  ← apply_backward_step iffI goal=8
    #[9] divides p 1 ⟶ p = 0
    #[10] p = 0 ⟶ divides p 1
  ← introduction goal=9
    #[11] divides p 1
    #[12] p = 0
  -> rewrite_fact divides_one sym=false goal=12 facts=[11]
    #[13] p = 1
  -> rewrite_fact_with_prev goal=12 facts=[13,1]
    #[14] prime 1
  ← apply_backward_step contrapositive goal=12 facts=[14]
    #[15] ¬(p = 0) ⟶ ¬(prime 1)
  ← introduction goal=15
    #[16] ¬(p = 0)
    #[17] ¬(prime 1)
  ← apply_backward_step prime_1 goal=17
    #[18] ¬(prime 1)
  ← introduction goal=10
    #[19] p = 0
    #[20] divides p 1
  -> rewrite_fact_with_prev goal=20 facts=[19,1]
    #[21] prime 0
  ← apply_backward_step contrapositive goal=20 facts=[21]
    #[22] ¬(divides p 1) ⟶ ¬(prime 0)
  ← introduction goal=22
    #[23] ¬(divides p 1)
    #[24] ¬(prime 0)
  ← apply_backward_step prime_0 goal=24
    #[25] ¬(prime 0)
  ← introduction n goal=6
    #[26] divides p (fact n) ⟷ p ≤ n
    #[27] divides p (fact (Suc n)) ⟷ p ≤ Suc n
  ← rewrite_goal fact_def_2 sym=false goal=27
    #[28] divides p (Suc n * fact n) ⟷ p ≤ Suc n
  ← apply_backward_step iffI goal=28
    #[29] divides p (Suc n * fact n) ⟶ p ≤ Suc n
    #[30] p ≤ Suc n ⟶ divides p (Suc n * fact n)
  ← introduction goal=29
    #[31] divides p (Suc n * fact n)
    #[32] p ≤ Suc n
  -> apply_forward_step prime_divprod_eq param_a="Suc n" param_b="fact n" goal=32 facts=[1]
    #[33] divides p (Suc n * fact n) ⟷ divides p (Suc n) ∨ divides p (fact n)
  -> rewrite_fact_with_prev goal=32 facts=[33,31]
    #[34] divides p (Suc n) ∨ divides p (fact n)
  ← apply_backward_step disjE goal=32 facts=[34]
    #[35] divides p (Suc n) ⟶ p ≤ Suc n
    #[36] divides p (fact n) ⟶ p ≤ Suc n
  ← introduction goal=35
    #[37] divides p (Suc n)
    #[38] p ≤ Suc n
  -> apply_forward_step divides_le goal=38 facts=[37]
    #[39] p ≤ Suc n ∨ Suc n = 0
  ← apply_backward_step disjE goal=38 facts=[39]
    #[40] p ≤ Suc n ⟶ p ≤ Suc n
    #[41] Suc n = 0 ⟶ p ≤ Suc n
  ← introduction goal=41
    #[42] Suc n = 0
    #[43] p ≤ Suc n
  ← apply_backward_step contrapositive goal=43 facts=[42]
    #[44] ¬(p ≤ Suc n) ⟶ ¬(Suc n = 0)
  ← introduction goal=44
    #[45] ¬(p ≤ Suc n)
    #[46] ¬(Suc n = 0)
  ← apply_backward_step ineq_sym goal=46
    #[47] ¬(0 = Suc n)
  ← apply_backward_step nat_zero_Suc_neq goal=47
    #[48] ¬(0 = Suc n)
  ← introduction goal=36
    #[49] divides p (fact n)
    #[50] p ≤ Suc n
  -> rewrite_fact_with_prev goal=50 facts=[26,49]
    #[51] p ≤ n
  ← rewrite_goal nat_less_eq_def_2 sym=false goal=50
    #[52] p = Suc n ∨ p ≤ n
  ← apply_backward_step disjI2 goal=52
  ← introduction goal=30
    #[53] p ≤ Suc n
    #[54] divides p (Suc n * fact n)
  -> rewrite_fact nat_less_eq_def_2 sym=false goal=54 facts=[53]
    #[55] p = Suc n ∨ p ≤ n
  ← apply_backward_step disjE goal=54 facts=[55]
    #[56] p = Suc n ⟶ divides p (Suc n * fact n)
    #[57] p ≤ n ⟶ divides p (Suc n * fact n)
  ← introduction goal=56
    #[58] p = Suc n
    #[59] divides p (Suc n * fact n)
  ← rewrite_goal_with_prev goal=59 facts=[58]
    #[60] divides (Suc n) (Suc n * fact n)
  ← apply_backward_step divides_rmul goal=60
    #[61] divides (Suc n) (Suc n)
  ← apply_backward_step divides_self goal=61
    #[62] divides (Suc n) (Suc n)
  ← introduction goal=57
    #[63] p ≤ n
    #[64] divides p (Suc n * fact n)
  -> rewrite_fact eq_sym_eq sym=false goal=64 facts=[26]
    #[65] p ≤ n ⟷ divides p (fact n)
  -> rewrite_fact_with_prev goal=64 facts=[65,63]
    #[66] divides p (fact n)
  ← apply_backward_step divides_lmul goal=64
qed

theorem eq_prime_pow
  fixes m :: nat, n :: nat, p :: nat
  prop prime p --> p ^ m = p ^ n <--> m = n
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] p ^ m = p ^ n ⟷ m = n
  ← rewrite_goal le_antisym sym=true goal=2
    #[3] p ^ m ≤ p ^ n ∧ p ^ n ≤ p ^ m ⟷ m ≤ n ∧ n ≤ m
  ← rewrite_goal le_exp sym=false goal=3
    #[4] (if p = 0 then m = 0 ⟶ n = 0 else p = 1 ∨ m ≤ n) ∧ (if p = 0 then n = 0 ⟶ m = 0 else p = 1 ∨ n ≤ m) ⟷ m ≤ n ∧ n ≤ m
  ← cases "p=0" goal=4
    #[5] p = 0 ⟶ (if p = 0 then m = 0 ⟶ n = 0 else p = 1 ∨ m ≤ n) ∧ (if p = 0 then n = 0 ⟶ m = 0 else p = 1 ∨ n ≤ m) ⟷ m ≤ n ∧ n ≤ m
    #[6] ¬(p = 0) ⟶ (if p = 0 then m = 0 ⟶ n = 0 else p = 1 ∨ m ≤ n) ∧ (if p = 0 then n = 0 ⟶ m = 0 else p = 1 ∨ n ≤ m) ⟷ m ≤ n ∧ n ≤ m
  ← introduction goal=5
    #[7] p = 0
    #[8] (if p = 0 then m = 0 ⟶ n = 0 else p = 1 ∨ m ≤ n) ∧ (if p = 0 then n = 0 ⟶ m = 0 else p = 1 ∨ n ≤ m) ⟷ m ≤ n ∧ n ≤ m
  -> rewrite_fact_with_prev goal=8 facts=[7,1]
    #[9] prime 0
  ← apply_backward_step contrapositive goal=8 facts=[9]
    #[10] ¬((if p = 0 then m = 0 ⟶ n = 0 else p = 1 ∨ m ≤ n) ∧ (if p = 0 then n = 0 ⟶ m = 0 else p = 1 ∨ n ≤ m) ⟷ m ≤ n ∧ n ≤ m) ⟶ ¬(prime 0)
  ← introduction goal=10
    #[11] ¬((if p = 0 then m = 0 ⟶ n = 0 else p = 1 ∨ m ≤ n) ∧ (if p = 0 then n = 0 ⟶ m = 0 else p = 1 ∨ n ≤ m) ⟷ m ≤ n ∧ n ≤ m)
    #[12] ¬(prime 0)
  ← apply_backward_step prime_0 goal=12
    #[13] ¬(prime 0)
  ← introduction goal=6
    #[14] ¬(p = 0)
    #[15] (if p = 0 then m = 0 ⟶ n = 0 else p = 1 ∨ m ≤ n) ∧ (if p = 0 then n = 0 ⟶ m = 0 else p = 1 ∨ n ≤ m) ⟷ m ≤ n ∧ n ≤ m
  ← rewrite_goal if_not_P sym=false goal=15 facts=[14]
    #[16] (p = 1 ∨ m ≤ n) ∧ (p = 1 ∨ n ≤ m) ⟷ m ≤ n ∧ n ≤ m
  ← apply_backward_step iffI goal=16
    #[17] (p = 1 ∨ m ≤ n) ∧ (p = 1 ∨ n ≤ m) ⟶ m ≤ n ∧ n ≤ m
    #[18] m ≤ n ∧ n ≤ m ⟶ (p = 1 ∨ m ≤ n) ∧ (p = 1 ∨ n ≤ m)
  ← introduction goal=17
    #[19] (p = 1 ∨ m ≤ n) ∧ (p = 1 ∨ n ≤ m)
    #[20] m ≤ n ∧ n ≤ m
  -> apply_forward_step conjD1 goal=20 facts=[19]
    #[21] p = 1 ∨ m ≤ n
  -> apply_forward_step conjD2 goal=20 facts=[19]
    #[22] p = 1 ∨ n ≤ m
  ← apply_backward_step disjE goal=20 facts=[21]
    #[23] p = 1 ⟶ m ≤ n ∧ n ≤ m
    #[24] m ≤ n ⟶ m ≤ n ∧ n ≤ m
  ← introduction goal=23
    #[25] p = 1
    #[26] m ≤ n ∧ n ≤ m
  -> rewrite_fact_with_prev goal=26 facts=[25,1]
    #[27] prime 1
  ← apply_backward_step contrapositive goal=26 facts=[27]
    #[28] ¬(m ≤ n ∧ n ≤ m) ⟶ ¬(prime 1)
  ← introduction goal=28
    #[29] ¬(m ≤ n ∧ n ≤ m)
    #[30] ¬(prime 1)
  ← apply_backward_step prime_1 goal=30
    #[31] ¬(prime 1)
  ← introduction goal=24
    #[32] m ≤ n
    #[33] m ≤ n ∧ n ≤ m
  ← apply_backward_step disjE goal=33 facts=[22]
    #[34] n ≤ m ⟶ m ≤ n ∧ n ≤ m
  ← introduction goal=34
    #[35] n ≤ m
    #[36] m ≤ n ∧ n ≤ m
  ← apply_backward_step conjI goal=36
  ← introduction goal=18
    #[37] m ≤ n ∧ n ≤ m
    #[38] (p = 1 ∨ m ≤ n) ∧ (p = 1 ∨ n ≤ m)
  -> apply_forward_step conjD1 goal=38 facts=[37]
    #[39] m ≤ n
  -> apply_forward_step conjD2 goal=38 facts=[37]
    #[40] n ≤ m
  ← apply_backward_step conjI goal=38
    #[41] p = 1 ∨ m ≤ n
    #[42] p = 1 ∨ n ≤ m
  ← apply_backward_step disjI2 goal=41
  ← apply_backward_step disjI2 goal=42
qed

theorem coprime_2
  fixes n :: nat
  prop coprime 2 n <--> odd n
  [hint_rewrite]
proof
  -> apply_forward_step prime_2 goal=0
    #[1] prime 2
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=0 facts=[1]
    #[2] ∀n. coprime 2 n ⟷ ¬(divides 2 n)
  ← rewrite_goal_with_prev goal=0 facts=[2]
    #[3] ¬(divides 2 n) ⟷ odd n
  ← rewrite_goal not_even sym=true goal=3
    #[4] ¬(divides 2 n) ⟷ ¬(even n)
  ← rewrite_goal divides_2 sym=false goal=4
qed

theorem divides_exp_plus1
  fixes k :: nat, n :: nat
  prop odd k --> divides (n + 1) (n ^ k + 1)
proof
  ← introduction goal=0
    #[1] odd k
    #[2] divides (n + 1) (n ^ k + 1)
  -> rewrite_fact odd_exists sym=false goal=2 facts=[1]
    #[3] ∃m. k = Suc (2 * m)
  exists_elim m goal=2 facts=[3]
    #[4] _VAR m
    #[5] k = Suc (2 * m)
    #[6] divides (n + 1) (n ^ k + 1)
  ← rewrite_goal_with_prev goal=6 facts=[5]
    #[7] divides (n + 1) (n ^ Suc (2 * m) + 1)
  ← induction m nat_induct goal=7
    #[8] divides (n + 1) (n ^ Suc (2 * 0) + 1)
    #[9] ∀n1. divides (n + 1) (n ^ Suc (2 * n1) + 1) ⟶ divides (n + 1) (n ^ Suc (2 * Suc n1) + 1)
  ← rewrite_goal mult_0_right sym=false goal=8
    #[10] divides (n + 1) (n ^ Suc 0 + 1)
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=10
    #[11] divides (n + 1) (n * n ^ (0::nat) + 1)
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=11
    #[12] divides (n + 1) (n * 1 + 1)
  ← rewrite_goal mult_1_right sym=false goal=12
    #[13] divides (n + 1) (n + 1)
  ← apply_backward_step divides_self goal=13
    #[14] divides (n + 1) (n + 1)
  ← introduction m1 goal=9
    #[15] _VAR m1
    #[16] divides (n + 1) (n ^ Suc (2 * m1) + 1)
    #[17] divides (n + 1) (n ^ Suc (2 * Suc m1) + 1)
  cut "Suc (2 * Suc m1) = Suc (2 * m1) + 2" goal=17
    #[18] Suc (2 * Suc m1) = Suc (2 * m1) + 2
  nat_norm goal=18
    #[19] Suc (2 * Suc m1) = Suc (2 * m1) + 2
  ← rewrite_goal_with_prev goal=17 facts=[19]
    #[20] divides (n + 1) (n ^ (Suc (2 * m1) + 2) + 1)
  ← rewrite_goal nat_power_add sym=false goal=20
    #[21] divides (n + 1) (n ^ Suc (2 * m1) * n ^ (2::nat) + 1)
  ← rewrite_goal exp_2 sym=false goal=21
    #[22] divides (n + 1) (n ^ Suc (2 * m1) * (n * n) + 1)
  -> rewrite_fact divides_def sym=false goal=22 facts=[16]
    #[23] ∃k. n ^ Suc (2 * m1) + 1 = (n + 1) * k
  exists_elim d goal=22 facts=[23]
    #[24] _VAR d
    #[25] n ^ Suc (2 * m1) + 1 = (n + 1) * d
    #[26] divides (n + 1) (n ^ Suc (2 * m1) * (n * n) + 1)
    #[27] divides (n + 1) (n ^ Suc (2 * m1) * n ^ (2::nat) + 1)
    #[28] divides (n + 1) (n ^ (Suc (2 * m1) + 2) + 1)
    #[29] divides (n + 1) (n ^ Suc (2 * Suc m1) + 1)
  cut "1 <= n ^ Suc (2 * m1) + 1" goal=26 facts=[25]
    #[30] 1 ≤ n ^ Suc (2 * m1) + 1
  ← rewrite_goal add_comm sym=false goal=30
    #[31] 1 ≤ 1 + n ^ Suc (2 * m1)
  ← apply_backward_step le_add goal=31
    #[32] 1 ≤ 1 + n ^ Suc (2 * m1)
  cut "n ^ Suc (2 * m1) = (n + 1) * d - 1" goal=26
    #[33] n ^ Suc (2 * m1) = (n + 1) * d - 1
  -> rewrite_fact eq_sym_eq sym=false goal=33 facts=[25]
    #[34] (n + 1) * d = n ^ Suc (2 * m1) + 1
  ← rewrite_goal_with_prev goal=33 facts=[34]
    #[35] n ^ Suc (2 * m1) = n ^ Suc (2 * m1) + 1 - 1
  ← rewrite_goal eq_sym_eq sym=false goal=35
    #[36] n ^ Suc (2 * m1) + 1 - 1 = n ^ Suc (2 * m1)
  ← apply_backward_step nat_plus_minus goal=36
    #[37] n ^ Suc (2 * m1) + 1 - 1 = n ^ Suc (2 * m1)
  ← rewrite_goal_with_prev goal=26 facts=[33]
    #[38] divides (n + 1) (((n + 1) * d - 1) * (n * n) + 1)
  ← rewrite_goal mult_comm sym=false goal=38
    #[39] divides (n + 1) (n * n * ((n + 1) * d - 1) + 1)
  ← rewrite_goal left_sub_distrib sym=false goal=39
    #[40] divides (n + 1) (n * n * ((n + 1) * d) - n * n * 1 + 1)
  cut "∀x::nat. ∀y. ∀z. z ≤ y --> y <= x ⟶ x - y + z = x - (y - z)" goal=40
    #[41] ∀x::nat. ∀y. ∀z. z ≤ y ⟶ y ≤ x ⟶ x - y + z = x - (y - z)
  ← z3 goal=41
    #[42] ∀x::nat. ∀y. ∀z. z ≤ y ⟶ y ≤ x ⟶ x - y + z = x - (y - z)
  ← rewrite_goal mult_1_right sym=false goal=40
    #[43] divides (n + 1) (n * n * ((n + 1) * d) - n * n + 1)
  ← cases "n=0" goal=43
    #[44] n = 0 ⟶ divides (n + 1) (n * n * ((n + 1) * d) - n * n + 1)
    #[45] ¬(n = 0) ⟶ divides (n + 1) (n * n * ((n + 1) * d) - n * n + 1)
  ← introduction goal=44
    #[46] n = 0
    #[47] divides (n + 1) (n * n * ((n + 1) * d) - n * n + 1)
  ← rewrite_goal_with_prev goal=47 facts=[46]
    #[48] divides (0 + 1) (0 * 0 * ((0 + 1) * d) - 0 * 0 + 1)
  ← rewrite_goal nat_plus_def_1 sym=false goal=48
    #[49] divides 1 (0 * 0 * (1 * d) - 0 * 0 + 1)
  ← apply_backward_step divides_1 goal=49
    #[50] divides 1 (0 * 0 * (1 * d) - 0 * 0 + 1)
  ← introduction goal=45
    #[51] ¬(n = 0)
    #[52] divides (n + 1) (n * n * ((n + 1) * d) - n * n + 1)
  cut "1 <= n*n" goal=52
    #[53] 1 ≤ n * n
  ← z3 goal=53 facts=[51]
    #[54] 1 ≤ n * n
  cut "n * n <= n * n * ((n + 1) * d)" goal=52
    #[55] n * n ≤ n * n * ((n + 1) * d)
  cut "n * n = n * n * 1" goal=55
    #[56] n * n = n * n * 1
  ← rewrite_goal mult_1_right sym=false goal=56
    #[57] n * n = n * n * 1
  ← rewrite_goal_with_prev goal=55 facts=[57]
    #[58] n * n * 1 ≤ n * n * 1 * ((n + 1) * d)
  ← rewrite_goal mult_assoc sym=false goal=58
    #[59] n * (n * 1) ≤ n * n * (1 * ((n + 1) * d))
  ← rewrite_goal mult_1_left sym=false goal=59
    #[60] n * (n * 1) ≤ n * n * ((n + 1) * d)
  cut "n * (n * 1) = n * n * 1" goal=60
    #[61] n * (n * 1) = n * n * 1
  ← rewrite_goal mult_assoc sym=false goal=61
    #[62] n * (n * 1) = n * n * 1
  ← rewrite_goal_with_prev goal=60 facts=[62]
    #[63] n * n * 1 ≤ n * n * ((n + 1) * d)
  ← apply_backward_step le_mult2 goal=63
    #[64] n * n ≤ n * n
    #[65] 1 ≤ (n + 1) * d
  ← apply_backward_step less_eq_refl goal=64
    #[66] n * n ≤ n * n
  -> rewrite_fact_with_prev goal=65 facts=[25,30]
    #[67] 1 ≤ (n + 1) * d
  -> apply_fact goal=52 facts=[42,54,55]
    #[68] n * n * ((n + 1) * d) - n * n + 1 = n * n * ((n + 1) * d) - (n * n - 1)
  ← rewrite_goal_with_prev goal=52 facts=[68]
    #[69] divides (n + 1) (n * n * ((n + 1) * d) - (n * n - 1))
  ← apply_backward_step divides_sub goal=69
    #[70] divides (n + 1) (n * n * ((n + 1) * d))
    #[71] divides (n + 1) (n * n - 1)
  ← apply_backward_step divides_lmul goal=70
    #[72] divides (n + 1) ((n + 1) * d)
  ← apply_backward_step divides_rmul goal=72
  cut "(n * n - 1) = (n+1)*(n-1)" goal=71
    #[73] n * n - 1 = (n + 1) * (n - 1)
  ← z3 goal=73 facts=[51]
    #[74] n * n - 1 = (n + 1) * (n - 1)
  ← rewrite_goal_with_prev goal=71 facts=[74]
    #[75] divides (n + 1) ((n + 1) * (n - 1))
  ← apply_backward_step divides_rmul goal=75
qed

theorem divides_exp_minus1
  fixes k :: nat, n :: nat
  prop divides (n - 1) (n ^ k - 1)
  [hint_backward]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ divides (n - 1) (n ^ k - 1)
    #[2] ¬(n = 0) ⟶ divides (n - 1) (n ^ k - 1)
  ← introduction goal=1
    #[3] n = 0
    #[4] divides (n - 1) (n ^ k - 1)
  ← rewrite_goal_with_prev goal=4 facts=[3]
    #[5] divides (0 - 1) (0 ^ k - 1)
  ← rewrite_goal exp_zero sym=false goal=5
    #[6] divides (0 - 1) ((if k = 0 then 1 else 0) - 1)
  ← cases "k = 0" goal=6
    #[7] k = 0 ⟶ divides (0 - 1) ((if k = 0 then 1 else 0) - 1)
    #[8] ¬(k = 0) ⟶ divides (0 - 1) ((if k = 0 then 1 else 0) - 1)
  ← introduction goal=7
    #[9] k = 0
    #[10] divides (0 - 1) ((if k = 0 then 1 else 0) - 1)
  ← rewrite_goal if_P sym=false goal=10 facts=[9]
    #[11] divides (0 - 1) (1 - 1)
  ← rewrite_goal nat_minus_l0 sym=false goal=11
    #[12] divides 0 (1 - 1)
  ← rewrite_goal divides_0 sym=false goal=12
    #[13] (1::nat) - 1 = 0
  ← rewrite_goal sub_eq_0 sym=false goal=13
    #[14] (1::nat) ≤ 1
  ← apply_backward_step less_eq_refl goal=14
    #[15] (1::nat) ≤ 1
  ← introduction goal=8
    #[16] ¬(k = 0)
    #[17] divides (0 - 1) ((if k = 0 then 1 else 0) - 1)
  ← rewrite_goal if_not_P sym=false goal=17 facts=[16]
    #[18] divides (0 - 1) (0 - 1)
  ← apply_backward_step divides_self goal=18
    #[19] divides (0 - 1) (0 - 1)
  ← introduction goal=2
    #[20] ¬(n = 0)
    #[21] divides (n - 1) (n ^ k - 1)
  ← induction k nat_induct goal=21
    #[22] divides (n - 1) (n ^ (0::nat) - 1)
    #[23] ∀n1. divides (n - 1) (n ^ n1 - 1) ⟶ divides (n - 1) (n ^ Suc n1 - 1)
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=22
    #[24] divides (n - 1) (1 - 1)
  ← rewrite_goal nat_minus_refl sym=false goal=24
    #[25] divides (n - 1) 0
  ← apply_backward_step divides_zero goal=25
    #[26] divides (n - 1) 0
  ← introduction k goal=23
    #[27] _VAR k
    #[28] divides (n - 1) (n ^ k - 1)
    #[29] divides (n - 1) (n ^ Suc k - 1)
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=29
    #[30] divides (n - 1) (n * n ^ k - 1)
  cut "n * n ^ k = n * n ^ k - n + n" goal=30
    #[31] n * n ^ k = n * n ^ k - n + n
  ← rewrite_goal eq_sym_eq sym=false goal=31
    #[32] n * n ^ k - n + n = n * n ^ k
  ← apply_backward_step sub_add goal=32
    #[33] n ≤ n * n ^ k
  cut "n = n * 1" goal=33
    #[34] n = n * 1
  ← rewrite_goal mult_1_right sym=false goal=34
    #[35] n = n * 1
  ← rewrite_goal_with_prev goal=33 facts=[35]
    #[36] n * 1 ≤ n * 1 * (n * 1) ^ k
  ← rewrite_goal mult_assoc sym=false goal=36
    #[37] n * 1 ≤ n * (1 * (n * 1) ^ k)
  ← rewrite_goal mult_1_left sym=false goal=37
    #[38] n * 1 ≤ n * (n * 1) ^ k
  ← apply_backward_step le_mult2 goal=38
    #[39] n ≤ n
    #[40] 1 ≤ (n * 1) ^ k
  ← apply_backward_step less_eq_refl goal=39
    #[41] n ≤ n
  ← rewrite_goal mult_1_right sym=false goal=40
    #[42] 1 ≤ n ^ k
  ← apply_backward_step le_1_2 goal=42
    #[43] ¬(n ^ k = 0)
  ← rewrite_goal exp_eq_0 sym=false goal=43
    #[44] ¬(n = 0 ∧ ¬(k = 0))
  ← rewrite_goal de_morgan_thm1 sym=false goal=44
    #[45] ¬(n = 0) ∨ ¬¬(k = 0)
  ← apply_backward_step disjI1 goal=45
  ← rewrite_goal_with_prev goal=30 facts=[31]
    #[46] divides (n - 1) (n * n ^ k - n + n - 1)
  cut "n * n ^ k - n = n * (n ^ k - 1)" goal=46
    #[47] n * n ^ k - n = n * (n ^ k - 1)
  ← rewrite_goal left_sub_distrib sym=false goal=47
    #[48] n * n ^ k - n = n * n ^ k - n * 1
  ← rewrite_goal mult_1_right sym=false goal=48
    #[49] n * n ^ k - n = n * n ^ k - n * 1
  ← rewrite_goal_with_prev goal=46 facts=[47]
    #[50] divides (n - 1) (n * (n ^ k - 1) + n - 1)
  cut "(n * (n ^ k - 1) + n - 1) = n * (n ^ k - 1) + (n - 1)" goal=50
    #[51] n * (n ^ k - 1) + n - 1 = n * (n ^ k - 1) + (n - 1)
  cut "!x. x + n - 1 = x + (n - 1)  " goal=51
    #[52] ∀x. x + n - 1 = x + (n - 1)
  ← introduction x goal=52
    #[53] _VAR x
    #[54] x + n - 1 = x + (n - 1)
  ← z3 goal=54 facts=[20]
    #[55] x + n - 1 = x + (n - 1)
  ← apply_prev goal=51 facts=[52]
  ← rewrite_goal_with_prev goal=50 facts=[51]
    #[56] divides (n - 1) (n * (n ^ k - 1) + (n - 1))
  ← apply_backward_step divides_sum goal=56
    #[57] divides (n - 1) (n * (n ^ k - 1))
    #[58] divides (n - 1) (n - 1)
  ← apply_backward_step divides_lmul goal=57
  ← apply_backward_step divides_self goal=58
    #[59] divides (n - 1) (n - 1)
qed

theorem prime_irreducible
  fixes p :: nat
  prop prime p <--> p > 1 & (!a. !b. divides p (a * b) --> divides p a | divides p b)
  [hint_rewrite]
proof
  ← rewrite_goal zero_one_or_prime sym=true goal=0
    #[1] prime p ⟷ p > 1 ∧ (p = 0 ∨ p = 1 ∨ prime p)
  cut "p > 1 <--> ~(p=0) & ~(p=1)" goal=1
    #[2] p > 1 ⟷ ¬(p = 0) ∧ ¬(p = 1)
  ← z3 goal=2
  ← rewrite_goal_with_prev goal=1 facts=[2]
    #[3] prime p ⟷ (¬(p = 0) ∧ ¬(p = 1)) ∧ (p = 0 ∨ p = 1 ∨ prime p)
  ← apply_backward_step iffI goal=3
    #[4] prime p ⟶ (¬(p = 0) ∧ ¬(p = 1)) ∧ (p = 0 ∨ p = 1 ∨ prime p)
    #[5] (¬(p = 0) ∧ ¬(p = 1)) ∧ (p = 0 ∨ p = 1 ∨ prime p) ⟶ prime p
  ← introduction goal=4
    #[6] prime p
    #[7] (¬(p = 0) ∧ ¬(p = 1)) ∧ (p = 0 ∨ p = 1 ∨ prime p)
  ← apply_backward_step conjI goal=7
    #[8] ¬(p = 0) ∧ ¬(p = 1)
    #[9] p = 0 ∨ p = 1 ∨ prime p
  ← apply_backward_step conjI goal=8
    #[10] ¬(p = 0)
    #[11] ¬(p = 1)
  ← apply_backward_step prime_imp_nz goal=10 facts=[6]
  -> rewrite_fact prime_def sym=false goal=11 facts=[6]
    #[12] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  ← apply_backward_step conjD1 goal=11 facts=[12]
  ← apply_backward_step disjI2 goal=9
    #[13] p = 1 ∨ prime p
  ← apply_backward_step disjI2 goal=13
  ← introduction goal=5
    #[14] (¬(p = 0) ∧ ¬(p = 1)) ∧ (p = 0 ∨ p = 1 ∨ prime p)
    #[15] prime p
  -> apply_forward_step conjD1 goal=15 facts=[14]
    #[16] ¬(p = 0) ∧ ¬(p = 1)
  -> apply_forward_step conjD1 goal=15 facts=[16]
    #[17] ¬(p = 0)
  -> apply_forward_step conjD2 goal=15 facts=[16]
    #[18] ¬(p = 1)
  -> apply_forward_step conjD2 goal=15 facts=[14]
    #[19] p = 0 ∨ p = 1 ∨ prime p
  ← apply_backward_step disjE goal=15 facts=[19]
    #[20] p = 0 ⟶ prime p
    #[21] p = 1 ∨ prime p ⟶ prime p
  ← introduction goal=20
    #[22] p = 0
    #[23] prime p
  ← apply_backward_step negE_gen goal=23 facts=[17,22]
  ← introduction goal=21
    #[24] p = 1 ∨ prime p
    #[25] prime p
  ← apply_backward_step disjE goal=25 facts=[24]
    #[26] p = 1 ⟶ prime p
    #[27] prime p ⟶ prime p
  ← introduction goal=26
    #[28] p = 1
    #[29] prime p
  ← apply_backward_step negE_gen goal=29 facts=[18,28]
    #[30] prime p
qed

theorem coprime_exp_divprod
  fixes a :: nat, b :: nat, d :: nat, n :: nat
  prop divides (d ^ n) (a * b) --> coprime d a --> divides (d ^ n) b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] divides (d ^ n) (a * b)
    #[2] coprime d a
    #[3] divides (d ^ n) b
  ← apply_backward_step coprime_divprod goal=3 facts=[1]
    #[4] coprime (d ^ n) a
  ← rewrite_goal coprime_lexp sym=false goal=4
    #[5] coprime d a ∨ n = 0
  ← apply_backward_step disjI1 goal=5
qed

theorem prime_coprime_cases
  fixes a :: nat, b :: nat, p :: nat
  prop prime p --> coprime a b --> coprime p a | coprime p b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] coprime a b
    #[3] coprime p a ∨ coprime p b
  -> apply_forward_step coprime_prime param_p=p goal=3 facts=[2]
    #[4] ¬(prime p ∧ divides p a ∧ divides p b)
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=3 facts=[1]
    #[5] ∀n. coprime p n ⟷ ¬(divides p n)
  ← rewrite_goal_with_prev goal=3 facts=[5]
    #[6] ¬(divides p a) ∨ ¬(divides p b)
  -> rewrite_fact de_morgan_thm1 sym=false goal=6 facts=[4]
    #[7] ¬(prime p) ∨ ¬(divides p a ∧ divides p b)
  ← apply_backward_step disjE goal=6 facts=[7]
    #[8] ¬(prime p) ⟶ ¬(divides p a) ∨ ¬(divides p b)
    #[9] ¬(divides p a ∧ divides p b) ⟶ ¬(divides p a) ∨ ¬(divides p b)
  ← introduction goal=8
    #[10] ¬(prime p)
    #[11] ¬(divides p a) ∨ ¬(divides p b)
  ← apply_backward_step negE_gen goal=11 facts=[10,1]
    #[12] ¬(divides p a) ∨ ¬(divides p b)
  ← introduction goal=9
    #[13] ¬(divides p a ∧ divides p b)
    #[14] ¬(divides p a) ∨ ¬(divides p b)
  -> rewrite_fact de_morgan_thm1 sym=false goal=14 facts=[13]
    #[15] ¬(divides p a) ∨ ¬(divides p b)
qed

theorem prime_divprod_pow_gen
  fixes a :: nat, b :: nat, n :: nat, p :: nat
  prop prime p --> ~(divides p (gcd a b)) --> divides (p ^ n) (a * b) --> divides (p ^ n) a | divides (p ^ n) b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ¬(divides p (gcd a b))
    #[3] divides (p ^ n) (a * b)
    #[4] divides (p ^ n) a ∨ divides (p ^ n) b
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=4 facts=[1]
    #[5] ∀n. coprime p n ⟷ ¬(divides p n)
  -> rewrite_fact divides_gcd sym=false goal=4 facts=[2]
    #[6] ¬(divides p a ∧ divides p b)
  -> rewrite_fact eq_sym_eq sym=false goal=4 facts=[5]
    #[7] ∀n. ¬(divides p n) ⟷ coprime p n
  -> rewrite_fact de_morgan_thm1 sym=false goal=4 facts=[6]
    #[8] ¬(divides p a) ∨ ¬(divides p b)
  -> rewrite_fact_with_prev goal=4 facts=[7,8]
    #[9] coprime p a ∨ coprime p b
  ← apply_backward_step disjE goal=4 facts=[9]
    #[10] coprime p a ⟶ divides (p ^ n) a ∨ divides (p ^ n) b
    #[11] coprime p b ⟶ divides (p ^ n) a ∨ divides (p ^ n) b
  ← introduction goal=10
    #[12] coprime p a
    #[13] divides (p ^ n) a ∨ divides (p ^ n) b
  ← apply_backward_step disjI2 goal=13
    #[14] divides (p ^ n) b
  ← apply_backward_step coprime_divprod param_a=a goal=14
    #[15] coprime (p ^ n) a
  ← rewrite_goal coprime_lexp sym=false goal=15
    #[16] coprime p a ∨ n = 0
  ← apply_backward_step disjI1 goal=16
  ← introduction goal=11
    #[17] coprime p b
    #[18] divides (p ^ n) a ∨ divides (p ^ n) b
  ← apply_backward_step disjI1 goal=18
    #[19] divides (p ^ n) a
  ← apply_backward_step coprime_divprod param_a=b goal=19
    #[20] divides (p ^ n) (b * a)
    #[21] coprime (p ^ n) b
  ← rewrite_goal mult_comm sym=false goal=20
  ← rewrite_goal coprime_lexp sym=false goal=21
    #[22] coprime p b ∨ n = 0
  ← apply_backward_step disjI1 goal=22
qed

theorem prime_divprod_pow_gen_eq
  fixes a :: nat, b :: nat, n :: nat, p :: nat
  prop prime p --> ~(divides p (gcd a b)) --> divides (p ^ n) (a * b) <--> divides (p ^ n) a | divides (p ^ n) b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ¬(divides p (gcd a b))
    #[3] divides (p ^ n) (a * b) ⟷ divides (p ^ n) a ∨ divides (p ^ n) b
  ← apply_backward_step iffI goal=3
    #[4] divides (p ^ n) (a * b) ⟶ divides (p ^ n) a ∨ divides (p ^ n) b
    #[5] divides (p ^ n) a ∨ divides (p ^ n) b ⟶ divides (p ^ n) (a * b)
  ← introduction goal=4
    #[6] divides (p ^ n) (a * b)
    #[7] divides (p ^ n) a ∨ divides (p ^ n) b
  ← apply_backward_step prime_divprod_pow_gen goal=7
  ← introduction goal=5
    #[8] divides (p ^ n) a ∨ divides (p ^ n) b
    #[9] divides (p ^ n) (a * b)
  ← apply_backward_step disjE goal=9 facts=[8]
    #[10] divides (p ^ n) a ⟶ divides (p ^ n) (a * b)
    #[11] divides (p ^ n) b ⟶ divides (p ^ n) (a * b)
  ← introduction goal=10
    #[12] divides (p ^ n) a
    #[13] divides (p ^ n) (a * b)
  ← apply_backward_step divides_rmul goal=13
  ← introduction goal=11
    #[14] divides (p ^ n) b
    #[15] divides (p ^ n) (a * b)
  ← apply_backward_step divides_lmul goal=15
qed

theorem prime_divprod_pow
  fixes a :: nat, b :: nat, n :: nat, p :: nat
  prop prime p --> coprime a b --> divides (p ^ n) (a * b) --> divides (p ^ n) a | divides (p ^ n) b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] coprime a b
    #[3] divides (p ^ n) (a * b)
    #[4] divides (p ^ n) a ∨ divides (p ^ n) b
  -> apply_forward_step prime_coprime_cases goal=4 facts=[1,2]
    #[5] coprime p a ∨ coprime p b
  ← apply_backward_step disjE goal=4 facts=[5]
    #[6] coprime p a ⟶ divides (p ^ n) a ∨ divides (p ^ n) b
    #[7] coprime p b ⟶ divides (p ^ n) a ∨ divides (p ^ n) b
  ← introduction goal=6
    #[8] coprime p a
    #[9] divides (p ^ n) a ∨ divides (p ^ n) b
  ← apply_backward_step disjI2 goal=9
    #[10] divides (p ^ n) b
  ← apply_backward_step coprime_exp_divprod goal=10 facts=[3,8]
    #[11] divides (p ^ n) b
  ← introduction goal=7
    #[12] coprime p b
    #[13] divides (p ^ n) a ∨ divides (p ^ n) b
  ← apply_backward_step disjI1 goal=13
    #[14] divides (p ^ n) a
  -> rewrite_fact mult_comm sym=false goal=14 facts=[3]
    #[15] divides (p ^ n) (b * a)
  ← apply_backward_step coprime_exp_divprod goal=14 facts=[15,12]
    #[16] divides (p ^ n) a
qed

theorem prime_divprod_pow_eq
  fixes a :: nat, b :: nat, n :: nat, p :: nat
  prop prime p --> coprime a b --> divides (p ^ n) (a * b) <--> divides (p ^ n) a | divides (p ^ n) b
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] coprime a b
    #[3] divides (p ^ n) (a * b) ⟷ divides (p ^ n) a ∨ divides (p ^ n) b
  ← apply_backward_step iffI goal=3
    #[4] divides (p ^ n) (a * b) ⟶ divides (p ^ n) a ∨ divides (p ^ n) b
    #[5] divides (p ^ n) a ∨ divides (p ^ n) b ⟶ divides (p ^ n) (a * b)
  ← introduction goal=4
    #[6] divides (p ^ n) (a * b)
    #[7] divides (p ^ n) a ∨ divides (p ^ n) b
  ← apply_backward_step prime_divprod_pow goal=7 facts=[1,2,6]
  ← introduction goal=5
    #[8] divides (p ^ n) a ∨ divides (p ^ n) b
    #[9] divides (p ^ n) (a * b)
  ← apply_backward_step disjE goal=9 facts=[8]
    #[10] divides (p ^ n) a ⟶ divides (p ^ n) (a * b)
    #[11] divides (p ^ n) b ⟶ divides (p ^ n) (a * b)
  ← introduction goal=10
    #[12] divides (p ^ n) a
    #[13] divides (p ^ n) (a * b)
  ← apply_backward_step divides_rmul goal=13
  ← introduction goal=11
    #[14] divides (p ^ n) b
    #[15] divides (p ^ n) (a * b)
  ← apply_backward_step divides_lmul goal=15
qed

theorem prime_factor_partition
  fixes Q :: nat => bool, n :: nat
  prop ~(n = 0) --> (?n1. ?n2. n1 * n2 = n & (!p. prime p --> divides p n1 --> Q p) & (!p. prime p --> divides p n2 --> ~(Q p)))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ¬(n = 0)
    #[2] ∃n1. ∃n2. n1 * n2 = n ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p))
  cut "!n. ¬(n = 0) \n⟶ (∃n1. ∃n2. n1 * n2 = n ∧ \n        (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p)))" goal=2
    #[3] ∀n. ¬(n = 0) ⟶ (∃n1. ∃n2. n1 * n2 = n ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p)))
  ← apply_backward_step prime_factor_induct goal=3
    #[4] ¬((0::nat) = 0) ⟶ (∃n1. ∃n2. n1 * n2 = 0 ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p)))
    #[5] ¬((1::nat) = 0) ⟶ (∃n1. ∃n2. n1 * n2 = 1 ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p)))
    #[6] ∀p. ∀n. prime p ⟶ ¬(n = 0) ⟶ (¬(n = 0) ⟶ (∃n1. ∃n2. n1 * n2 = n ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1)))) ⟶ ¬(p * n = 0) ⟶ (∃n1. ∃n2. n1 * n2 = p * n ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1)))
  ← introduction goal=4
    #[7] ¬((0::nat) = 0)
    #[8] ∃n1. ∃n2. n1 * n2 = 0 ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p))
  ← apply_backward_step negE_gen goal=8 facts=[7]
    #[9] (0::nat) = 0
  ← apply_backward_step eq_refl goal=9
    #[10] (0::nat) = 0
  ← introduction goal=5
    #[11] ¬((1::nat) = 0)
    #[12] ∃n1. ∃n2. n1 * n2 = 1 ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p))
  ← inst_exists_goal "(1::nat)" goal=12
    #[13] ∃n2. 1 * n2 = 1 ∧ (∀p. prime p ⟶ divides p 1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p))
  ← inst_exists_goal "(1::nat)" goal=13
    #[14] (1::nat) * 1 = 1 ∧ (∀p. prime p ⟶ divides p 1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p 1 ⟶ ¬(Q p))
  ← apply_backward_step conjI goal=14
    #[15] (1::nat) * 1 = 1
    #[16] (∀p. prime p ⟶ divides p 1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p 1 ⟶ ¬(Q p))
  ← rewrite_goal mult_1_left sym=false goal=15
    #[17] (1::nat) * 1 = 1
  ← apply_backward_step conjI goal=16
    #[18] ∀p. prime p ⟶ divides p 1 ⟶ Q p
    #[19] ∀p. prime p ⟶ divides p 1 ⟶ ¬(Q p)
  ← introduction p goal=18
    #[20] _VAR p
    #[21] prime p
    #[22] divides p 1
    #[23] Q p
  -> rewrite_fact divides_one sym=false goal=23 facts=[22]
    #[24] p = 1
  -> rewrite_fact_with_prev goal=23 facts=[24,21]
    #[25] prime 1
  ← apply_backward_step contrapositive goal=23 facts=[25]
    #[26] ¬(Q p) ⟶ ¬(prime 1)
  ← introduction goal=26
    #[27] ¬(Q p)
    #[28] ¬(prime 1)
  ← apply_backward_step prime_1 goal=28
    #[29] ¬(prime 1)
  ← introduction p goal=19
    #[30] ¬(Q p)
  -> rewrite_fact divides_one sym=false goal=30 facts=[22]
  -> rewrite_fact_with_prev goal=30 facts=[24,21]
  ← apply_backward_step contrapositive goal=30 facts=[25]
    #[31] ¬¬(Q p) ⟶ ¬(prime 1)
  ← introduction goal=31
    #[32] ¬¬(Q p)
    #[33] ¬(prime 1)
  ← apply_backward_step prime_1 goal=33
  ← introduction p,m goal=6
    #[34] _VAR m
    #[35] ¬(m = 0)
    #[36] ¬(m = 0) ⟶ (∃n1. ∃n2. n1 * n2 = m ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p)))
    #[37] ¬(p * m = 0)
    #[38] ∃n1. ∃n2. n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1))
  -> apply_fact goal=38 facts=[36,35]
    #[39] ∃n1. ∃n2. n1 * n2 = m ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p))
  exists_elim n1,n2 goal=38 facts=[39]
    #[40] _VAR n1
    #[41] _VAR n2
    #[42] n1 * n2 = m ∧ (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p))
    #[43] ∃n1. ∃n2. n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1))
  -> apply_forward_step conjD1 goal=43 facts=[42]
    #[44] n1 * n2 = m
  -> apply_forward_step conjD2 goal=43 facts=[42]
    #[45] (∀p. prime p ⟶ divides p n1 ⟶ Q p) ∧ (∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p))
  -> apply_forward_step conjD1 goal=43 facts=[45]
    #[46] ∀p. prime p ⟶ divides p n1 ⟶ Q p
  -> apply_forward_step conjD2 goal=43 facts=[45]
    #[47] ∀p. prime p ⟶ divides p n2 ⟶ ¬(Q p)
  ← cases "Q p" goal=43
    #[48] Q p ⟶ (∃n1. ∃n2. n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1)))
    #[49] ¬(Q p) ⟶ (∃n1. ∃n2. n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1)))
  ← introduction goal=48
    #[50] Q p
    #[51] ∃n1. ∃n2. n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1))
  ← inst_exists_goal "p * n1" goal=51
    #[52] ∃n2. p * n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 (p * n1) ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1))
  ← inst_exists_goal n2 goal=52
    #[53] p * n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 (p * n1) ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1))
  ← apply_backward_step conjI goal=53
    #[54] p * n1 * n2 = p * m
    #[55] (∀p1. prime p1 ⟶ divides p1 (p * n1) ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1))
  ← rewrite_goal mult_assoc sym=false goal=54
    #[56] p * (n1 * n2) = p * m
  ← rewrite_goal_with_prev goal=56 facts=[44]
    #[57] p * (n1 * n2) = p * m
  ← apply_backward_step conjI goal=55
    #[58] ∀p1. prime p1 ⟶ divides p1 (p * n1) ⟶ Q p1
  ← introduction p1 goal=58
    #[59] _VAR p1
    #[60] prime p1
    #[61] divides p1 (p * n1)
    #[62] Q p1
  -> apply_forward_step prime_divprod_eq param_a=p param_b=n1 goal=62 facts=[60]
    #[63] divides p1 (p * n1) ⟷ divides p1 p ∨ divides p1 n1
  -> rewrite_fact_with_prev goal=62 facts=[63,61]
    #[64] divides p1 p ∨ divides p1 n1
  ← apply_backward_step disjE goal=62 facts=[64]
    #[65] divides p1 p ⟶ Q p1
    #[66] divides p1 n1 ⟶ Q p1
  ← introduction goal=65
    #[67] divides p1 p
    #[68] Q p1
  -> apply_forward_step divides_prime_prime goal=68 facts=[60,21]
    #[69] divides p1 p ⟷ p1 = p
  -> rewrite_fact_with_prev goal=68 facts=[69,67]
    #[70] p1 = p
  ← rewrite_goal_with_prev goal=68 facts=[70]
  ← introduction goal=66
    #[71] divides p1 n1
    #[72] Q p1
  ← apply_prev goal=72 facts=[46]
  ← introduction goal=49
    #[73] ∃n1. ∃n2. n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1))
  ← inst_exists_goal n1 goal=73
    #[74] ∃n2. n1 * n2 = p * m ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 n2 ⟶ ¬(Q p1))
  ← inst_exists_goal p*n2 goal=74
    #[75] n1 * (p * n2) = p * m ∧ (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 (p * n2) ⟶ ¬(Q p1))
  ← apply_backward_step conjI goal=75
    #[76] n1 * (p * n2) = p * m
    #[77] (∀p1. prime p1 ⟶ divides p1 n1 ⟶ Q p1) ∧ (∀p1. prime p1 ⟶ divides p1 (p * n2) ⟶ ¬(Q p1))
  -> rewrite_fact eq_sym_eq sym=false goal=76 facts=[44]
    #[78] m = n1 * n2
  ← rewrite_goal_with_prev goal=76 facts=[78]
    #[79] n1 * (p * n2) = p * (n1 * n2)
  nat_norm goal=79
    #[80] n1 * (p * n2) = p * (n1 * n2)
  ← apply_backward_step conjI goal=77
    #[81] ∀p1. prime p1 ⟶ divides p1 (p * n2) ⟶ ¬(Q p1)
  ← introduction p1 goal=81
    #[82] divides p1 (p * n2)
    #[83] ¬(Q p1)
  -> apply_forward_step prime_divprod_eq param_a=p param_b=n2 goal=83 facts=[60]
    #[84] divides p1 (p * n2) ⟷ divides p1 p ∨ divides p1 n2
  -> rewrite_fact_with_prev goal=83 facts=[84,82]
    #[85] divides p1 p ∨ divides p1 n2
  ← apply_backward_step disjE goal=83 facts=[85]
    #[86] divides p1 p ⟶ ¬(Q p1)
    #[87] divides p1 n2 ⟶ ¬(Q p1)
  ← introduction goal=86
    #[88] ¬(Q p1)
  -> apply_forward_step divides_prime_prime goal=88 facts=[60,21]
  -> rewrite_fact_with_prev goal=88 facts=[69,67]
  ← rewrite_goal_with_prev goal=88 facts=[70]
  ← introduction goal=87
    #[89] divides p1 n2
    #[90] ¬(Q p1)
  ← apply_prev goal=90 facts=[47]
  ← apply_prev goal=2 facts=[3]
qed

theorem coprime_pair_decomp
  fixes m :: nat, n1 :: nat, n2 :: nat
  prop coprime n1 n2 --> ~(m = 0) --> (?m1. ?m2. coprime m1 n1 & coprime m2 n2 & coprime m1 m2 & m1 * m2 = m)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] coprime n1 n2
    #[2] ¬(m = 0)
    #[3] ∃m1. ∃m2. coprime m1 n1 ∧ coprime m2 n2 ∧ coprime m1 m2 ∧ m1 * m2 = m
  -> apply_forward_step prime_factor_partition param_Q="(%p. divides p n2)" param_n=m goal=3
    #[4] ¬(m = 0) ⟶ (∃n1. ∃n21. n1 * n21 = m ∧ (∀p. prime p ⟶ divides p n1 ⟶ divides p n2) ∧ (∀p. prime p ⟶ divides p n21 ⟶ ¬(divides p n2)))
  -> apply_fact goal=3 facts=[4,2]
    #[5] ∃n1. ∃n21. n1 * n21 = m ∧ (∀p. prime p ⟶ divides p n1 ⟶ divides p n2) ∧ (∀p. prime p ⟶ divides p n21 ⟶ ¬(divides p n2))
  exists_elim m1,m2 goal=3 facts=[5]
    #[6] _VAR m1
    #[7] _VAR m2
    #[8] m1 * m2 = m ∧ (∀p. prime p ⟶ divides p m1 ⟶ divides p n2) ∧ (∀p. prime p ⟶ divides p m2 ⟶ ¬(divides p n2))
    #[9] ∃m1. ∃m2. coprime m1 n1 ∧ coprime m2 n2 ∧ coprime m1 m2 ∧ m1 * m2 = m
  ← inst_exists_goal m1 goal=9
    #[10] ∃m2. coprime m1 n1 ∧ coprime m2 n2 ∧ coprime m1 m2 ∧ m1 * m2 = m
  ← inst_exists_goal m2 goal=10
    #[11] coprime m1 n1 ∧ coprime m2 n2 ∧ coprime m1 m2 ∧ m1 * m2 = m
  -> apply_forward_step conjD1 goal=11 facts=[8]
    #[12] m1 * m2 = m
  -> apply_forward_step conjD2 goal=11 facts=[8]
    #[13] (∀p. prime p ⟶ divides p m1 ⟶ divides p n2) ∧ (∀p. prime p ⟶ divides p m2 ⟶ ¬(divides p n2))
  -> apply_forward_step conjD1 goal=11 facts=[13]
    #[14] ∀p. prime p ⟶ divides p m1 ⟶ divides p n2
  -> apply_forward_step conjD2 goal=11 facts=[13]
    #[15] ∀p. prime p ⟶ divides p m2 ⟶ ¬(divides p n2)
  -> rewrite_fact coprime_prime_eq sym=false goal=11 facts=[1]
    #[16] ∀p. ¬(prime p ∧ divides p n1 ∧ divides p n2)
  ← rewrite_goal coprime_prime_eq sym=false goal=11
    #[17] (∀p. ¬(prime p ∧ divides p m1 ∧ divides p n1)) ∧ (∀p. ¬(prime p ∧ divides p m2 ∧ divides p n2)) ∧ (∀p. ¬(prime p ∧ divides p m1 ∧ divides p m2)) ∧ m1 * m2 = m
  ← apply_backward_step conjI goal=17
    #[18] ∀p. ¬(prime p ∧ divides p m1 ∧ divides p n1)
    #[19] (∀p. ¬(prime p ∧ divides p m2 ∧ divides p n2)) ∧ (∀p. ¬(prime p ∧ divides p m1 ∧ divides p m2)) ∧ m1 * m2 = m
  ← introduction p goal=18
    #[20] _VAR p
    #[21] ¬(prime p ∧ divides p m1 ∧ divides p n1)
  -> forall_elim p goal=21 facts=[16]
    #[22] ¬(prime p ∧ divides p n1 ∧ divides p n2)
  ← apply_backward_step contrapositive goal=21 facts=[22]
    #[23] ¬¬(prime p ∧ divides p m1 ∧ divides p n1) ⟶ ¬¬(prime p ∧ divides p n1 ∧ divides p n2)
  ← rewrite_goal double_neg sym=false goal=23
    #[24] prime p ∧ divides p m1 ∧ divides p n1 ⟶ prime p ∧ divides p n1 ∧ divides p n2
  ← introduction goal=24
    #[25] prime p ∧ divides p m1 ∧ divides p n1
    #[26] prime p ∧ divides p n1 ∧ divides p n2
  -> apply_forward_step conjD1 goal=26 facts=[25]
    #[27] prime p
  -> apply_forward_step conjD2 goal=26 facts=[25]
    #[28] divides p m1 ∧ divides p n1
  -> apply_forward_step conjD1 goal=26 facts=[28]
    #[29] divides p m1
  -> apply_forward_step conjD2 goal=26 facts=[28]
    #[30] divides p n1
  ← apply_backward_step conjI goal=26
    #[31] divides p n1 ∧ divides p n2
  ← apply_backward_step conjI goal=31
    #[32] divides p n2
  ← apply_prev goal=32 facts=[14]
  ← apply_backward_step conjI goal=19
    #[33] ∀p. ¬(prime p ∧ divides p m2 ∧ divides p n2)
    #[34] (∀p. ¬(prime p ∧ divides p m1 ∧ divides p m2)) ∧ m1 * m2 = m
  ← introduction p goal=33
    #[35] ¬(prime p ∧ divides p m2 ∧ divides p n2)
  -> forall_elim p goal=35 facts=[18]
  ← apply_backward_step contrapositive goal=35 facts=[21]
    #[36] ¬¬(prime p ∧ divides p m2 ∧ divides p n2) ⟶ ¬¬(prime p ∧ divides p m1 ∧ divides p n1)
  ← rewrite_goal double_neg sym=false goal=36
    #[37] prime p ∧ divides p m2 ∧ divides p n2 ⟶ prime p ∧ divides p m1 ∧ divides p n1
  ← introduction goal=37
    #[38] prime p ∧ divides p m2 ∧ divides p n2
    #[39] prime p ∧ divides p m1 ∧ divides p n1
  -> apply_forward_step conjD1 goal=39 facts=[38]
    #[40] prime p
  -> apply_forward_step conjD2 goal=39 facts=[38]
    #[41] divides p m2 ∧ divides p n2
  -> apply_forward_step conjD1 goal=39 facts=[41]
    #[42] divides p m2
  -> apply_forward_step conjD2 goal=39 facts=[41]
    #[43] divides p n2
  -> apply_fact goal=39 facts=[15,40,42]
    #[44] ¬(divides p n2)
  ← apply_backward_step negE_gen goal=39 facts=[44,43]
    #[45] prime p ∧ divides p m1 ∧ divides p n1
  ← apply_backward_step conjI goal=34
    #[46] ∀p. ¬(prime p ∧ divides p m1 ∧ divides p m2)
  ← introduction p goal=46
    #[47] ¬(prime p ∧ divides p m1 ∧ divides p m2)
  -> forall_elim p goal=47 facts=[16]
  ← apply_backward_step contrapositive goal=47 facts=[22]
    #[48] ¬¬(prime p ∧ divides p m1 ∧ divides p m2) ⟶ ¬¬(prime p ∧ divides p n1 ∧ divides p n2)
  ← rewrite_goal double_neg sym=false goal=48
    #[49] prime p ∧ divides p m1 ∧ divides p m2 ⟶ prime p ∧ divides p n1 ∧ divides p n2
  ← introduction goal=49
    #[50] prime p ∧ divides p m1 ∧ divides p m2
    #[51] prime p ∧ divides p n1 ∧ divides p n2
  -> apply_forward_step conjD1 goal=51 facts=[50]
    #[52] prime p
  -> apply_forward_step conjD2 goal=51 facts=[50]
    #[53] divides p m1 ∧ divides p m2
  -> apply_forward_step conjD1 goal=51 facts=[53]
    #[54] divides p m1
  -> apply_forward_step conjD2 goal=51 facts=[53]
    #[55] divides p m2
  -> apply_fact goal=51 facts=[14,52,54]
    #[56] divides p n2
  -> apply_fact goal=51 facts=[15,52,55]
    #[57] ¬(divides p n2)
  ← apply_backward_step negE_gen goal=51 facts=[57,56]
    #[58] prime p ∧ divides p n1 ∧ divides p n2
qed

theorem exp_mult_exists
  fixes k :: nat, m :: nat, n :: nat, p :: nat
  prop ~(m = 0) --> m ^ k * n = p ^ k --> (?q. n = q ^ k)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] ¬(m = 0)
    #[2] m ^ k * n = p ^ k
    #[3] ∃q. n = q ^ k
  ← cases "k=0" goal=3
    #[4] k = 0 ⟶ (∃q. n = q ^ k)
    #[5] ¬(k = 0) ⟶ (∃q. n = q ^ k)
  ← introduction goal=4
    #[6] k = 0
    #[7] ∃q. n = q ^ k
  ← rewrite_goal_with_prev goal=7 facts=[6]
    #[8] ∃q. n = q ^ (0::nat)
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=8
    #[9] ∃q::nat. n = 1
  -> rewrite_fact_with_prev goal=9 facts=[6,2]
    #[10] m ^ (0::nat) * n = p ^ (0::nat)
  -> rewrite_fact nat_nat_power_def_1 sym=false goal=9 facts=[10]
    #[11] 1 * n = 1
  -> rewrite_fact mult_1_left sym=false goal=9 facts=[11]
    #[12] n = 1
  ← inst_exists_goal k goal=9
  ← introduction goal=5
    #[13] ¬(k = 0)
    #[14] ∃q. n = q ^ k
  -> apply_forward_step divides_exp2_rev param_a=m param_b=p param_n=k goal=14
    #[15] divides (m ^ k) (p ^ k) ⟶ ¬(k = 0) ⟶ divides m p
  cut "divides (m ^ k) (p ^ k)" goal=14 facts=[15]
    #[16] divides (m ^ k) (p ^ k)
  -> rewrite_fact eq_sym_eq sym=false goal=16 facts=[2]
    #[17] p ^ k = m ^ k * n
  ← rewrite_goal_with_prev goal=16 facts=[17]
    #[18] divides (m ^ k) (m ^ k * n)
  ← apply_backward_step divides_rmul goal=18
    #[19] divides (m ^ k) (m ^ k)
  ← apply_backward_step divides_self goal=19
    #[20] divides (m ^ k) (m ^ k)
  -> apply_fact goal=14 facts=[15,16,13]
    #[21] divides m p
  -> rewrite_fact divides_def sym=false goal=14 facts=[21]
    #[22] ∃k. p = m * k
  exists_elim d goal=14 facts=[22]
    #[23] _VAR d
    #[24] p = m * d
    #[25] ∃q. n = q ^ k
  -> rewrite_fact_with_prev goal=25 facts=[24,2]
    #[26] m ^ k * n = (m * d) ^ k
  -> rewrite_fact mult_exp sym=false goal=25 facts=[26]
    #[27] m ^ k * n = m ^ k * d ^ k
  -> rewrite_fact eq_mult_lcancel sym=false goal=25 facts=[27]
    #[28] m ^ k = 0 ∨ n = d ^ k
  ← apply_backward_step disjE goal=25 facts=[28]
    #[29] m ^ k = 0 ⟶ (∃q. n = q ^ k)
    #[30] n = d ^ k ⟶ (∃q. n = q ^ k)
  ← introduction goal=29
    #[31] m ^ k = 0
    #[32] ∃q. n = q ^ k
  -> rewrite_fact exp_eq_0 sym=false goal=32 facts=[31]
    #[33] m = 0 ∧ ¬(k = 0)
  -> apply_forward_step conjD1 goal=32 facts=[33]
    #[34] m = 0
  ← apply_backward_step negE_gen goal=32 facts=[1,34]
    #[35] ∃q. n = q ^ k
  ← introduction goal=30
    #[36] n = d ^ k
    #[37] ∃q. n = q ^ k
  ← apply_backward_step exI goal=37 facts=[36]
    #[38] ∃q. n = q ^ k
qed

theorem coprime_pow
  fixes a :: nat, b :: nat, c :: nat, n :: nat
  prop coprime a b --> a * b = c ^ n --> (?r. ?s. a = r ^ n & b = s ^ n)
  [hint_backward,hint_backward1]

theorem prime_exp
  fixes n :: nat, p :: nat
  prop prime (p ^ n) <--> prime p & n = 1
  [hint_rewrite]
proof
  ← induction n nat_induct goal=0
    #[1] prime (p ^ (0::nat)) ⟷ prime p ∧ (0::nat) = 1
    #[2] ∀n. prime (p ^ n) ⟷ prime p ∧ n = 1 ⟶ prime (p ^ Suc n) ⟷ prime p ∧ Suc n = 1
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=1
    #[3] prime 1 ⟷ prime p ∧ (0::nat) = 1
  ← apply_backward_step iffI goal=3
    #[4] prime 1 ⟶ prime p ∧ (0::nat) = 1
    #[5] prime p ∧ (0::nat) = 1 ⟶ prime 1
  ← introduction goal=4
    #[6] prime 1
    #[7] prime p ∧ (0::nat) = 1
  ← apply_backward_step contrapositive goal=7 facts=[6]
    #[8] ¬(prime p ∧ (0::nat) = 1) ⟶ ¬(prime 1)
  ← introduction goal=8
    #[9] ¬(prime p ∧ (0::nat) = 1)
    #[10] ¬(prime 1)
  ← apply_backward_step prime_1 goal=10
    #[11] ¬(prime 1)
  ← introduction goal=5
    #[12] prime p ∧ (0::nat) = 1
    #[13] prime 1
  -> apply_forward_step conjD2 goal=13 facts=[12]
    #[14] (0::nat) = 1
  ← apply_backward_step contrapositive goal=13 facts=[14]
    #[15] ¬(prime 1) ⟶ ¬((0::nat) = 1)
  ← introduction goal=15
    #[16] ¬(prime 1)
    #[17] ¬((0::nat) = 1)
  nat_const_ineq goal=17
    #[18] ¬((0::nat) = 1)
  ← introduction n goal=2
    #[19] _VAR n
    #[20] prime (p ^ n) ⟷ prime p ∧ n = 1
    #[21] prime (p ^ Suc n) ⟷ prime p ∧ Suc n = 1
  ← cases "p=0" goal=21
    #[22] p = 0 ⟶ prime (p ^ Suc n) ⟷ prime p ∧ Suc n = 1
    #[23] ¬(p = 0) ⟶ prime (p ^ Suc n) ⟷ prime p ∧ Suc n = 1
  ← introduction goal=22
    #[24] p = 0
    #[25] prime (p ^ Suc n) ⟷ prime p ∧ Suc n = 1
  ← rewrite_goal_with_prev goal=25 facts=[24]
    #[26] prime (0 ^ Suc n) ⟷ prime 0 ∧ Suc n = 1
  ← rewrite_goal exp_zero sym=false goal=26
    #[27] prime (if Suc n = 0 then 1 else 0) ⟷ prime 0 ∧ Suc n = 1
  cut "~(Suc n = 0)" goal=27
    #[28] ¬(Suc n = 0)
  ← apply_backward_step ineq_sym goal=28
    #[29] ¬(0 = Suc n)
  ← apply_backward_step nat_zero_Suc_neq goal=29
    #[30] ¬(0 = Suc n)
  ← rewrite_goal if_not_P sym=false goal=27 facts=[28]
    #[31] prime 0 ⟷ prime 0 ∧ Suc n = 1
  ← apply_backward_step iffI goal=31
    #[32] prime 0 ⟶ prime 0 ∧ Suc n = 1
    #[33] prime 0 ∧ Suc n = 1 ⟶ prime 0
  ← introduction goal=32
    #[34] prime 0
    #[35] prime 0 ∧ Suc n = 1
  ← apply_backward_step contrapositive goal=35 facts=[34]
    #[36] ¬(prime 0 ∧ Suc n = 1) ⟶ ¬(prime 0)
  ← introduction goal=36
    #[37] ¬(prime 0 ∧ Suc n = 1)
    #[38] ¬(prime 0)
  ← apply_backward_step prime_0 goal=38
    #[39] ¬(prime 0)
  ← introduction goal=33
    #[40] prime 0 ∧ Suc n = 1
    #[41] prime 0
  ← apply_backward_step conjD1 goal=41 facts=[40]
    #[42] prime 0
  ← introduction goal=23
    #[43] ¬(p = 0)
    #[44] prime (p ^ Suc n) ⟷ prime p ∧ Suc n = 1
  ← induction n nat_induct goal=44
    #[45] prime (p ^ Suc 0) ⟷ prime p ∧ Suc 0 = 1
    #[46] ∀n. prime (p ^ Suc n) ⟷ prime p ∧ Suc n = 1 ⟶ prime (p ^ Suc (Suc n)) ⟷ prime p ∧ Suc (Suc n) = 1
  ← rewrite_goal add_1_right sym=true goal=45
    #[47] prime (p ^ ((0::nat) + 1)) ⟷ prime p ∧ (0::nat) + 1 = 1
  ← rewrite_goal nat_plus_def_1 sym=false goal=47
    #[48] prime (p ^ (1::nat)) ⟷ prime p ∧ (1::nat) = 1
  ← rewrite_goal exp_1 sym=false goal=48
    #[49] prime p ⟷ prime p ∧ (1::nat) = 1
  ← apply_backward_step iffI goal=49
    #[50] prime p ⟶ prime p ∧ (1::nat) = 1
    #[51] prime p ∧ (1::nat) = 1 ⟶ prime p
  ← introduction goal=50
    #[52] prime p
    #[53] prime p ∧ (1::nat) = 1
  ← apply_backward_step conjI goal=53
    #[54] (1::nat) = 1
  ← apply_backward_step eq_refl goal=54
    #[55] (1::nat) = 1
  ← introduction goal=51
    #[56] prime p ∧ (1::nat) = 1
    #[57] prime p
  ← apply_backward_step conjD1 goal=57 facts=[56]
    #[58] prime p
  ← introduction m goal=46
    #[59] _VAR m
    #[60] prime (p ^ Suc m) ⟷ prime p ∧ Suc m = 1
    #[61] prime (p ^ Suc (Suc m)) ⟷ prime p ∧ Suc (Suc m) = 1
  ← cases "p=1" goal=61
    #[62] p = 1 ⟶ prime (p ^ Suc (Suc m)) ⟷ prime p ∧ Suc (Suc m) = 1
    #[63] ¬(p = 1) ⟶ prime (p ^ Suc (Suc m)) ⟷ prime p ∧ Suc (Suc m) = 1
  ← introduction goal=62
    #[64] p = 1
    #[65] prime (p ^ Suc (Suc m)) ⟷ prime p ∧ Suc (Suc m) = 1
  ← rewrite_goal_with_prev goal=65 facts=[64]
    #[66] prime (1 ^ Suc (Suc m)) ⟷ prime 1 ∧ Suc (Suc m) = 1
  ← rewrite_goal exp_one sym=false goal=66
    #[67] prime 1 ⟷ prime 1 ∧ Suc (Suc m) = 1
  ← apply_backward_step iffI goal=67
    #[68] prime 1 ⟶ prime 1 ∧ Suc (Suc m) = 1
    #[69] prime 1 ∧ Suc (Suc m) = 1 ⟶ prime 1
  ← introduction goal=68
    #[70] prime 1 ∧ Suc (Suc m) = 1
  ← apply_backward_step contrapositive goal=70 facts=[6]
    #[71] ¬(prime 1 ∧ Suc (Suc m) = 1) ⟶ ¬(prime 1)
  ← introduction goal=71
    #[72] ¬(prime 1 ∧ Suc (Suc m) = 1)
    #[73] ¬(prime 1)
  ← apply_backward_step prime_1 goal=73
  ← introduction goal=69
    #[74] prime 1 ∧ Suc (Suc m) = 1
    #[75] prime 1
  ← apply_backward_step conjD1 goal=75 facts=[74]
    #[76] prime 1
  ← introduction goal=63
    #[77] ¬(p = 1)
    #[78] prime (p ^ Suc (Suc m)) ⟷ prime p ∧ Suc (Suc m) = 1
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=78
    #[79] prime (p * p ^ Suc m) ⟷ prime p ∧ Suc (Suc m) = 1
  ← apply_backward_step iffI goal=79
    #[80] prime (p * p ^ Suc m) ⟶ prime p ∧ Suc (Suc m) = 1
    #[81] prime p ∧ Suc (Suc m) = 1 ⟶ prime (p * p ^ Suc m)
  ← introduction goal=80
    #[82] prime (p * p ^ Suc m)
    #[83] prime p ∧ Suc (Suc m) = 1
  ← apply_backward_step contrapositive goal=83 facts=[82]
    #[84] ¬(prime p ∧ Suc (Suc m) = 1) ⟶ ¬(prime (p * p ^ Suc m))
  ← introduction goal=84
    #[85] ¬(prime p ∧ Suc (Suc m) = 1)
    #[86] ¬(prime (p * p ^ Suc m))
  ← rewrite_goal prime_def sym=false goal=86
    #[87] ¬(¬(p * p ^ Suc m = 1) ∧ (∀x. divides x (p * p ^ Suc m) ⟶ x = 1 ∨ x = p * p ^ Suc m))
  ← rewrite_goal de_morgan_thm1 sym=false goal=87
    #[88] ¬¬(p * p ^ Suc m = 1) ∨ ¬(∀x. divides x (p * p ^ Suc m) ⟶ x = 1 ∨ x = p * p ^ Suc m)
  ← apply_backward_step disjI2 goal=88
    #[89] ¬(∀x. divides x (p * p ^ Suc m) ⟶ x = 1 ∨ x = p * p ^ Suc m)
  ← rewrite_goal not_all sym=false goal=89
    #[90] ∃x. ¬(divides x (p * p ^ Suc m) ⟶ x = 1 ∨ x = p * p ^ Suc m)
  ← rewrite_goal not_imp sym=false goal=90
    #[91] ∃x. divides x (p * p ^ Suc m) ∧ ¬(x = 1 ∨ x = p * p ^ Suc m)
  ← rewrite_goal de_morgan_thm2 sym=false goal=91
    #[92] ∃x. divides x (p * p ^ Suc m) ∧ ¬(x = 1) ∧ ¬(x = p * p ^ Suc m)
  ← inst_exists_goal p goal=92
    #[93] divides p (p * p ^ Suc m) ∧ ¬(p = 1) ∧ ¬(p = p * p ^ Suc m)
  ← apply_backward_step conjI goal=93
    #[94] divides p (p * p ^ Suc m)
    #[95] ¬(p = 1) ∧ ¬(p = p * p ^ Suc m)
  ← apply_backward_step divides_rmul goal=94
    #[96] divides p p
  ← apply_backward_step divides_self goal=96
    #[97] divides p p
  ← apply_backward_step conjI goal=95
    #[98] ¬(p = p * p ^ Suc m)
  ← apply_backward_step negI goal=98
    #[99] p = p * p ^ Suc m ⟶ false
  ← introduction goal=99
    #[100] p = p * p ^ Suc m
    #[101] false
  cut "p = p * 1" goal=101 facts=[100]
    #[102] p = p * 1
  ← rewrite_goal mult_1_right sym=false goal=102
    #[103] p = p * 1
  -> rewrite_fact_with_prev goal=101 facts=[103,100]
    #[104] p * 1 = p * 1 * (p * 1) ^ Suc m
  -> rewrite_fact mult_assoc sym=false goal=101 facts=[104]
    #[105] p * 1 = p * (1 * (p * 1) ^ Suc m)
  -> rewrite_fact mult_1_left sym=false goal=101 facts=[105]
    #[106] p * 1 = p * (p * 1) ^ Suc m
  -> rewrite_fact eq_mult_lcancel sym=false goal=101 facts=[106]
    #[107] p = 0 ∨ 1 = (p * 1) ^ Suc m
  -> rewrite_fact mult_1_right sym=false goal=101 facts=[107]
    #[108] p = 0 ∨ 1 = p ^ Suc m
  ← apply_backward_step disjE goal=101 facts=[108]
    #[109] p = 0 ⟶ false
    #[110] 1 = p ^ Suc m ⟶ false
  ← introduction goal=109
    #[111] false
  ← apply_backward_step contrapositive goal=111 facts=[24]
    #[112] ¬false ⟶ ¬(p = 0)
  ← introduction goal=112
    #[113] ¬false
  ← introduction goal=110
    #[114] 1 = p ^ Suc m
    #[115] false
  -> rewrite_fact eq_sym_eq sym=false goal=115 facts=[114]
    #[116] p ^ Suc m = 1
  -> rewrite_fact exp_eq_1 sym=false goal=115 facts=[116]
    #[117] p = 1 ∨ Suc m = 0
  ← apply_backward_step disjE goal=115 facts=[117]
    #[118] p = 1 ⟶ false
    #[119] Suc m = 0 ⟶ false
  ← introduction goal=118
    #[120] false
  ← apply_backward_step negE_gen goal=120 facts=[77,64]
    #[121] false
  ← introduction goal=119
    #[122] Suc m = 0
    #[123] false
  ← apply_backward_step contrapositive goal=123 facts=[122]
    #[124] ¬false ⟶ ¬(Suc m = 0)
  ← introduction goal=124
    #[125] ¬(Suc m = 0)
  ← rewrite_goal eq_sym_eq sym=false goal=125
    #[126] ¬(0 = Suc m)
  ← apply_backward_step nat_zero_Suc_neq goal=126
    #[127] ¬(0 = Suc m)
  ← introduction goal=81
    #[128] prime p ∧ Suc (Suc m) = 1
    #[129] prime (p * p ^ Suc m)
  -> apply_forward_step conjD2 goal=129 facts=[128]
    #[130] Suc (Suc m) = 1
  -> rewrite_fact nat_one_def sym=false goal=129 facts=[130]
    #[131] Suc (Suc m) = Suc 0
  -> apply_forward_step nat_Suc_inject goal=129 facts=[131]
    #[132] Suc m = 0
  ← apply_backward_step contrapositive goal=129 facts=[132]
    #[133] ¬(prime (p * p ^ Suc m)) ⟶ ¬(Suc m = 0)
  ← introduction goal=133
    #[134] ¬(prime (p * p ^ Suc m))
    #[135] ¬(Suc m = 0)
  ← apply_backward_step ineq_sym goal=135
    #[136] ¬(0 = Suc m)
  ← apply_backward_step nat_zero_Suc_neq goal=136
qed

theorem prime_power_mult
  fixes k :: nat, p :: nat, x :: nat, y :: nat
  prop prime p --> x * y = p ^ k --> (?i::nat. ?j::nat. x = p ^ i & y = p ^ j)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] x * y = p ^ k
    #[3] ∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j
  cut "!x. !y. x * y = p ^ k ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j)" goal=3
    #[4] ∀x. ∀y. x * y = p ^ k ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j)
  ← induction k nat_induct goal=4
    #[5] ∀x. ∀y. x * y = p ^ (0::nat) ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j)
    #[6] ∀n. (∀x. ∀y. x * y = p ^ n ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j)) ⟶ (∀x. ∀y. x * y = p ^ Suc n ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j))
  ← introduction x1,y1 goal=5
    #[7] _VAR x1
    #[8] _VAR y1
    #[9] x1 * y1 = p ^ (0::nat)
    #[10] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  -> rewrite_fact nat_nat_power_def_1 sym=false goal=10 facts=[9]
    #[11] x1 * y1 = 1
  -> rewrite_fact mult_eq_1 sym=false goal=10 facts=[11]
    #[12] x1 = 1 ∧ y1 = 1
  ← inst_exists_goal "(0::nat)" goal=10
    #[13] ∃j::nat. x1 = p ^ (0::nat) ∧ y1 = p ^ j
  ← inst_exists_goal "(0::nat)" goal=13
    #[14] x1 = p ^ (0::nat) ∧ y1 = p ^ (0::nat)
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=14
  ← introduction k1 goal=6
    #[15] _VAR k1
    #[16] ∀x. ∀y. x * y = p ^ k1 ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j)
    #[17] ∀x. ∀y. x * y = p ^ Suc k1 ⟶ (∃i::nat. ∃j::nat. x = p ^ i ∧ y = p ^ j)
  ← introduction x1,y1 goal=17
    #[18] x1 * y1 = p ^ Suc k1
    #[19] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  -> rewrite_fact nat_nat_power_def_2 sym=false goal=19 facts=[18]
    #[20] x1 * y1 = p * p ^ k1
  cut "divides p x1 | divides p y1" goal=19
    #[21] divides p x1 ∨ divides p y1
  ← apply_backward_step prime_divprod goal=21 facts=[1]
    #[22] divides p (x1 * y1)
  ← rewrite_goal_with_prev goal=22 facts=[20]
    #[23] divides p (p * p ^ k1)
  ← apply_backward_step divides_rmul goal=23
    #[24] divides p p
  ← apply_backward_step divides_self goal=24
    #[25] divides p p
  -> rewrite_fact divides_def sym=false goal=19 facts=[21]
    #[26] (∃k. x1 = p * k) ∨ (∃k. y1 = p * k)
  cut "~(p=0)" goal=19
    #[27] ¬(p = 0)
  ← apply_backward_step prime_imp_nz goal=27
  ← apply_backward_step disjE goal=19 facts=[26]
    #[28] (∃k. x1 = p * k) ⟶ (∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j)
    #[29] (∃k. y1 = p * k) ⟶ (∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j)
  ← introduction goal=28
    #[30] ∃k. x1 = p * k
    #[31] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  exists_elim d goal=31 facts=[30]
    #[32] _VAR d
    #[33] x1 = p * d
    #[34] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  -> rewrite_fact_with_prev goal=34 facts=[33,20]
    #[35] p * d * y1 = p * p ^ k1
  -> rewrite_fact mult_assoc sym=false goal=34 facts=[35]
    #[36] p * (d * y1) = p * p ^ k1
  -> rewrite_fact eq_mult_lcancel sym=false goal=34 facts=[36]
    #[37] p = 0 ∨ d * y1 = p ^ k1
  ← apply_backward_step disjE goal=34 facts=[37]
    #[38] p = 0 ⟶ (∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j)
    #[39] d * y1 = p ^ k1 ⟶ (∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j)
  ← introduction goal=38
    #[40] p = 0
    #[41] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  ← apply_backward_step negE_gen goal=41 facts=[27,40]
    #[42] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  ← introduction goal=39
    #[43] d * y1 = p ^ k1
    #[44] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  -> forall_elim d goal=44 facts=[16]
    #[45] ∀y. d * y = p ^ k1 ⟶ (∃i::nat. ∃j::nat. d = p ^ i ∧ y = p ^ j)
  -> forall_elim y1 goal=44 facts=[45]
    #[46] d * y1 = p ^ k1 ⟶ (∃i::nat. ∃j::nat. d = p ^ i ∧ y1 = p ^ j)
  -> apply_fact goal=44 facts=[46,43]
    #[47] ∃i::nat. ∃j::nat. d = p ^ i ∧ y1 = p ^ j
  exists_elim i,j goal=44 facts=[47]
    #[48] _VAR i
    #[49] _VAR j
    #[50] d = p ^ i ∧ y1 = p ^ j
    #[51] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  -> apply_forward_step conjD1 goal=51 facts=[50]
    #[52] d = p ^ i
  -> apply_forward_step conjD2 goal=51 facts=[50]
    #[53] y1 = p ^ j
  ← rewrite_goal_with_prev goal=51 facts=[33]
    #[54] ∃i::nat. ∃j::nat. p * d = p ^ i ∧ y1 = p ^ j
  ← inst_exists_goal "Suc i" goal=54
    #[55] ∃j::nat. p * d = p ^ Suc i ∧ y1 = p ^ j
  ← inst_exists_goal j goal=55
    #[56] p * d = p ^ Suc i ∧ y1 = p ^ j
  ← apply_backward_step conjI goal=56
    #[57] p * d = p ^ Suc i
  ← rewrite_goal_with_prev goal=57 facts=[52]
    #[58] p * p ^ i = p ^ Suc i
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=58
    #[59] p * p ^ i = p ^ Suc i
  ← introduction goal=29
    #[60] ∃k. y1 = p * k
    #[61] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  exists_elim d goal=61 facts=[60]
    #[62] y1 = p * d
    #[63] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  -> rewrite_fact_with_prev goal=63 facts=[62,20]
    #[64] x1 * (p * d) = p * p ^ k1
  cut "x1 * (p * d) = p * (x1 * d)" goal=63
    #[65] x1 * (p * d) = p * (x1 * d)
  nat_norm goal=65
    #[66] x1 * (p * d) = p * (x1 * d)
  -> rewrite_fact_with_prev goal=63 facts=[66,64]
    #[67] p * (x1 * d) = p * p ^ k1
  -> rewrite_fact eq_mult_lcancel sym=false goal=63 facts=[67]
    #[68] p = 0 ∨ x1 * d = p ^ k1
  ← apply_backward_step disjE goal=63 facts=[68]
    #[69] p = 0 ⟶ (∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j)
    #[70] x1 * d = p ^ k1 ⟶ (∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j)
  ← introduction goal=69
    #[71] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  ← apply_backward_step negE_gen goal=71 facts=[27,40]
  ← introduction goal=70
    #[72] x1 * d = p ^ k1
    #[73] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  -> apply_fact goal=73 facts=[16,72]
    #[74] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ d = p ^ j
  exists_elim i,j goal=73 facts=[74]
    #[75] x1 = p ^ i ∧ d = p ^ j
    #[76] ∃i::nat. ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  -> apply_forward_step conjD1 goal=76 facts=[75]
    #[77] x1 = p ^ i
  -> apply_forward_step conjD2 goal=76 facts=[75]
    #[78] d = p ^ j
  ← inst_exists_goal i goal=76
    #[79] ∃j::nat. x1 = p ^ i ∧ y1 = p ^ j
  ← inst_exists_goal "Suc j" goal=79
    #[80] x1 = p ^ i ∧ y1 = p ^ Suc j
  ← apply_backward_step conjI goal=80
    #[81] y1 = p ^ Suc j
  ← rewrite_goal_with_prev goal=81 facts=[62]
    #[82] p * d = p ^ Suc j
  ← rewrite_goal_with_prev goal=82 facts=[78]
    #[83] p * p ^ j = p ^ Suc j
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=83
    #[84] p * p ^ j = p ^ Suc j
  ← apply_prev goal=3 facts=[4]
qed

theorem prime_power_exp
  fixes k :: nat, n :: nat, p :: nat, x :: nat
  prop prime p --> ~(n = 0) --> x ^ n = p ^ k --> (?i::nat. x = p ^ i)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ¬(n = 0)
    #[3] x ^ n = p ^ k
    #[4] ∃i::nat. x = p ^ i
  revert_intro goal=4 facts=[3]
    #[5] x ^ n = p ^ k ⟶ (∃i::nat. x = p ^ i)
  revert_intro goal=5 facts=[2]
    #[6] ¬(n = 0) ⟶ x ^ n = p ^ k ⟶ (∃i::nat. x = p ^ i)
  ← induction n nat_induct goal=6
    #[7] ¬((0::nat) = 0) ⟶ x ^ (0::nat) = p ^ k ⟶ (∃i::nat. x = p ^ i)
    #[8] ∀n. (¬(n = 0) ⟶ x ^ n = p ^ k ⟶ (∃i::nat. x = p ^ i)) ⟶ ¬(Suc n = 0) ⟶ x ^ Suc n = p ^ k ⟶ (∃i::nat. x = p ^ i)
  ← introduction goal=7
    #[9] ¬((0::nat) = 0)
    #[10] x ^ (0::nat) = p ^ k
    #[11] ∃i::nat. x = p ^ i
  ← apply_backward_step negE_gen goal=11 facts=[9]
    #[12] (0::nat) = 0
  ← apply_backward_step eq_refl goal=12
    #[13] (0::nat) = 0
  ← introduction n goal=8
    #[14] _VAR n
    #[15] ¬(n = 0) ⟶ x ^ n = p ^ k ⟶ (∃i::nat. x = p ^ i)
    #[16] ¬(Suc n = 0)
    #[17] x ^ Suc n = p ^ k
    #[18] ∃i::nat. x = p ^ i
  -> rewrite_fact nat_nat_power_def_2 sym=false goal=18 facts=[17]
    #[19] x * x ^ n = p ^ k
  -> apply_forward_step prime_power_mult goal=18 facts=[1,19]
    #[20] ∃i::nat. ∃j::nat. x = p ^ i ∧ x ^ n = p ^ j
  exists_elim i,j goal=18 facts=[20]
    #[21] _VAR i
    #[22] _VAR j
    #[23] x = p ^ i ∧ x ^ n = p ^ j
    #[24] ∃i::nat. x = p ^ i
  -> apply_forward_step conjD1 goal=24 facts=[23]
    #[25] x = p ^ i
  ← inst_exists_goal i goal=24
qed

theorem divides_primepow
  fixes k :: nat, p :: nat
  prop prime p --> (!d. divides d (p ^ k) <--> (?i. i <= k & d = p ^ i))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ∀d. divides d (p ^ k) ⟷ (∃i. i ≤ k ∧ d = p ^ i)
  ← introduction d goal=2
    #[3] _VAR d
    #[4] divides d (p ^ k) ⟷ (∃i. i ≤ k ∧ d = p ^ i)
  ← apply_backward_step iffI goal=4
    #[5] divides d (p ^ k) ⟶ (∃i. i ≤ k ∧ d = p ^ i)
    #[6] (∃i. i ≤ k ∧ d = p ^ i) ⟶ divides d (p ^ k)
  ← introduction goal=5
    #[7] divides d (p ^ k)
    #[8] ∃i. i ≤ k ∧ d = p ^ i
  -> rewrite_fact divides_def sym=false goal=8 facts=[7]
    #[9] ∃k1. p ^ k = d * k1
  exists_elim e goal=8 facts=[9]
    #[10] _VAR e
    #[11] p ^ k = d * e
    #[12] ∃i. i ≤ k ∧ d = p ^ i
  -> rewrite_fact eq_sym_eq sym=false goal=12 facts=[11]
    #[13] d * e = p ^ k
  -> apply_forward_step prime_power_mult goal=12 facts=[1,13]
    #[14] ∃i::nat. ∃j::nat. d = p ^ i ∧ e = p ^ j
  exists_elim i,j goal=12 facts=[14]
    #[15] _VAR i
    #[16] _VAR j
    #[17] d = p ^ i ∧ e = p ^ j
    #[18] ∃i. i ≤ k ∧ d = p ^ i
  ← inst_exists_goal i goal=18
    #[19] i ≤ k ∧ d = p ^ i
  -> apply_forward_step conjD1 goal=19 facts=[17]
    #[20] d = p ^ i
  -> apply_forward_step conjD2 goal=19 facts=[17]
    #[21] e = p ^ j
  ← apply_backward_step conjI goal=19
    #[22] i ≤ k
  ← cases "p=0" goal=22
    #[23] p = 0 ⟶ i ≤ k
    #[24] ¬(p = 0) ⟶ i ≤ k
  ← introduction goal=23
    #[25] p = 0
    #[26] i ≤ k
  -> rewrite_fact_with_prev goal=26 facts=[25,1]
    #[27] prime 0
  ← apply_backward_step contrapositive goal=26 facts=[27]
    #[28] ¬(i ≤ k) ⟶ ¬(prime 0)
  ← introduction goal=28
    #[29] ¬(i ≤ k)
    #[30] ¬(prime 0)
  ← apply_backward_step prime_0 goal=30
    #[31] ¬(prime 0)
  ← introduction goal=24
    #[32] ¬(p = 0)
    #[33] i ≤ k
  ← cases "p=1" goal=33
    #[34] p = 1 ⟶ i ≤ k
    #[35] ¬(p = 1) ⟶ i ≤ k
  ← introduction goal=34
    #[36] p = 1
    #[37] i ≤ k
  -> rewrite_fact_with_prev goal=37 facts=[36,1]
    #[38] prime 1
  ← apply_backward_step contrapositive goal=37 facts=[38]
    #[39] ¬(i ≤ k) ⟶ ¬(prime 1)
  ← introduction goal=39
    #[40] ¬(prime 1)
  ← apply_backward_step prime_1 goal=40
    #[41] ¬(prime 1)
  ← introduction goal=35
    #[42] ¬(p = 1)
    #[43] i ≤ k
  cut "d * 1 <= d * e" goal=43
    #[44] d * 1 ≤ d * e
  ← apply_backward_step le_mult2 goal=44
    #[45] d ≤ d
    #[46] 1 ≤ e
  ← apply_backward_step less_eq_refl goal=45
    #[47] d ≤ d
  ← rewrite_goal_with_prev goal=46 facts=[21]
    #[48] 1 ≤ p ^ j
  ← apply_backward_step le_1_2 goal=48
    #[49] ¬(p ^ j = 0)
  ← rewrite_goal exp_eq_0 sym=false goal=49
    #[50] ¬(p = 0 ∧ ¬(j = 0))
  ← rewrite_goal de_morgan_thm1 sym=false goal=50
    #[51] ¬(p = 0) ∨ ¬¬(j = 0)
  ← apply_backward_step disjI1 goal=51
  -> rewrite_fact mult_1_right sym=false goal=43 facts=[44]
    #[52] d ≤ d * e
  -> rewrite_fact_with_prev goal=43 facts=[13,52]
    #[53] d ≤ p ^ k
  -> rewrite_fact_with_prev goal=43 facts=[20,53]
    #[54] p ^ i ≤ p ^ k
  -> rewrite_fact le_exp sym=false goal=43 facts=[54]
    #[55] if p = 0 then i = 0 ⟶ k = 0 else p = 1 ∨ i ≤ k
  -> rewrite_fact if_not_P sym=false goal=43 facts=[55,32]
    #[56] p = 1 ∨ i ≤ k
  ← apply_backward_step disjE goal=43 facts=[56]
    #[57] i ≤ k ⟶ i ≤ k
  ← introduction goal=6
    #[58] ∃i. i ≤ k ∧ d = p ^ i
    #[59] divides d (p ^ k)
  exists_elim i goal=59 facts=[58]
    #[60] i ≤ k ∧ d = p ^ i
    #[61] divides d (p ^ k)
  -> apply_forward_step conjD1 goal=61 facts=[60]
    #[62] i ≤ k
  -> apply_forward_step conjD2 goal=61 facts=[60]
    #[63] d = p ^ i
  -> rewrite_fact less_eq_exist sym=false goal=61 facts=[62]
    #[64] ∃p. k = i + p
  exists_elim e goal=61 facts=[64]
    #[65] k = i + e
    #[66] divides d (p ^ k)
  ← rewrite_goal_with_prev goal=66 facts=[65]
    #[67] divides d (p ^ (i + e))
  ← rewrite_goal nat_power_add sym=false goal=67
    #[68] divides d (p ^ i * p ^ e)
  ← rewrite_goal_with_prev goal=68 facts=[63]
    #[69] divides (p ^ i) (p ^ i * p ^ e)
  ← apply_backward_step divides_rmul goal=69
    #[70] divides (p ^ i) (p ^ i)
  ← apply_backward_step divides_self goal=70
    #[71] divides (p ^ i) (p ^ i)
qed

theorem primepow_divides_prod
  fixes k :: nat, m :: nat, n :: nat, p :: nat
  prop prime p --> divides (p ^ k) (m * n) --> (?i. ?j. divides (p ^ i) m & divides (p ^ j) n & k = i + j)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides (p ^ k) (m * n)
    #[3] ∃i. ∃j. divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j
  -> apply_forward_step division_decomp goal=3 facts=[2]
    #[4] ∃b1. ∃c1. p ^ k = b1 * c1 ∧ divides b1 m ∧ divides c1 n
  exists_elim b,c goal=3 facts=[4]
    #[5] _VAR b
    #[6] _VAR c
    #[7] p ^ k = b * c ∧ divides b m ∧ divides c n
    #[8] ∃i. ∃j. divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j
  -> apply_forward_step divides_primepow param_k=k goal=8 facts=[1]
    #[9] ∀d. divides d (p ^ k) ⟷ (∃i. i ≤ k ∧ d = p ^ i)
  -> apply_forward_step conjD1 goal=8 facts=[7]
    #[10] p ^ k = b * c
  -> forall_elim b goal=8 facts=[9]
    #[11] divides b (p ^ k) ⟷ (∃i. i ≤ k ∧ b = p ^ i)
  cut "divides b (p ^ k)" goal=8
    #[12] divides b (p ^ k)
  ← rewrite_goal_with_prev goal=12 facts=[10]
    #[13] divides b (b * c)
  ← apply_backward_step divides_rmul goal=13
    #[14] divides b b
  ← apply_backward_step divides_self goal=14
    #[15] divides b b
  -> rewrite_fact_with_prev goal=8 facts=[11,12]
    #[16] ∃i. i ≤ k ∧ b = p ^ i
  -> forall_elim c goal=8 facts=[9]
    #[17] divides c (p ^ k) ⟷ (∃i. i ≤ k ∧ c = p ^ i)
  cut "divides c (p ^ k)" goal=8 facts=[17]
    #[18] divides c (p ^ k)
  ← rewrite_goal_with_prev goal=18 facts=[10]
    #[19] divides c (b * c)
  ← apply_backward_step divides_lmul goal=19
    #[20] divides c c
  ← apply_backward_step divides_self goal=20
    #[21] divides c c
  -> rewrite_fact_with_prev goal=8 facts=[17,18]
    #[22] ∃i. i ≤ k ∧ c = p ^ i
  exists_elim i goal=8 facts=[16]
    #[23] _VAR i
    #[24] i ≤ k ∧ b = p ^ i
    #[25] ∃i. ∃j. divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j
  exists_elim j goal=25 facts=[22]
    #[26] _VAR j
    #[27] j ≤ k ∧ c = p ^ j
    #[28] ∃i. ∃j. divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j
  ← inst_exists_goal i goal=28
    #[29] ∃j. divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j
  ← inst_exists_goal j goal=29
    #[30] divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j
  ← apply_backward_step conjI goal=30
    #[31] divides (p ^ i) m
    #[32] divides (p ^ j) n ∧ k = i + j
  -> apply_forward_step conjD2 goal=31 facts=[24]
    #[33] b = p ^ i
  -> rewrite_fact eq_sym_eq sym=false goal=31 facts=[33]
    #[34] p ^ i = b
  ← rewrite_goal_with_prev goal=31 facts=[34]
    #[35] divides b m
  -> apply_forward_step conjD2 goal=35 facts=[7]
    #[36] divides b m ∧ divides c n
  ← apply_backward_step conjD1 goal=35 facts=[36]
    #[37] divides b m
  ← apply_backward_step conjI goal=32
    #[38] divides (p ^ j) n
    #[39] k = i + j
  -> apply_forward_step conjD2 goal=38 facts=[27]
    #[40] c = p ^ j
  -> rewrite_fact eq_sym_eq sym=false goal=38 facts=[40]
    #[41] p ^ j = c
  ← rewrite_goal_with_prev goal=38 facts=[41]
    #[42] divides c n
  ← apply_backward_step conjD2 goal=42 facts=[36]
    #[43] divides c n
  -> rewrite_fact_with_prev goal=39 facts=[33,10]
    #[44] p ^ k = p ^ i * c
  -> rewrite_fact_with_prev goal=39 facts=[40,44]
    #[45] p ^ k = p ^ i * p ^ j
  -> apply_forward_step eq_prime_pow param_m=k param_n=i+j goal=39 facts=[1]
    #[46] p ^ k = p ^ (i + j) ⟷ k = i + j
  -> rewrite_fact eq_sym_eq sym=false goal=39 facts=[46]
    #[47] k = i + j ⟷ p ^ k = p ^ (i + j)
  ← rewrite_goal_with_prev goal=39 facts=[47]
    #[48] p ^ k = p ^ (i + j)
  ← rewrite_goal nat_power_add sym=false goal=48
qed

theorem primepow_factor
  fixes n :: nat
  prop 2 <= n --> (?p. ?k::nat. ?m. prime p & 1 <= k & coprime p m & n = p ^ k * m)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] 2 ≤ n
    #[2] ∃p. ∃k::nat. ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
  -> apply_forward_step prime_factor param_n=n goal=2
    #[3] ¬(n = 1) ⟶ (∃p. prime p ∧ divides p n)
  cut "¬(n = 1)" goal=2
    #[4] ¬(n = 1)
  ← z3 goal=4 facts=[1]
  -> apply_fact goal=2 facts=[3,4]
    #[5] ∃p. prime p ∧ divides p n
  exists_elim p goal=2 facts=[5]
    #[6] _VAR p
    #[7] prime p ∧ divides p n
    #[8] ∃p. ∃k::nat. ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
  ← inst_exists_goal p goal=8
    #[9] ∃k::nat. ∃m. prime p ∧ 1 ≤ k ∧ coprime p m ∧ n = p ^ k * m
  -> apply_forward_step factorization_index param_n=n param_p=p goal=9
    #[10] ¬(n = 0) ⟶ 2 ≤ p ⟶ (∃k::nat. divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n)))
  cut "¬(n = 0)" goal=9
    #[11] ¬(n = 0)
  ← z3 goal=11 facts=[1]
    #[12] ¬(n = 0)
  -> apply_fact goal=9 facts=[10,12]
    #[13] 2 ≤ p ⟶ (∃k::nat. divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n)))
  -> apply_forward_step conjD1 goal=9 facts=[7]
