  ← apply_backward_step disjE goal=68 facts=[71]
    #[72] n = 0 ∨ p = 1 ⟶ k ≤ index p n
    #[73] k ≤ index p n ⟶ k ≤ index p n
  ← introduction goal=72
    #[74] k ≤ index p n
  -> apply_fact goal=74 facts=[69,45]
    #[75] k = 0
  ← rewrite_goal_with_prev goal=74 facts=[75]
    #[76] 0 ≤ index p n
  ← apply_backward_step le_0 goal=76
    #[77] 0 ≤ index p n
qed

theorem exp_index_divides
  fixes n :: nat, p :: nat
  prop divides (p ^ index p n) n
  [hint_backward]
proof
  -> apply_forward_step le_index param_k="index p n" param_n=n param_p=p goal=0
    #[1] index p n ≤ index p n ⟷ (n = 0 ∨ p = 1 ⟶ index p n = 0) ∧ divides (p ^ index p n) n
  cut "index p n ≤ index p n" goal=0
    #[2] index p n ≤ index p n
  ← apply_backward_step less_eq_refl goal=2
  -> rewrite_fact_with_prev goal=0 facts=[1,2]
    #[3] (n = 0 ∨ p = 1 ⟶ index p n = 0) ∧ divides (p ^ index p n) n
  ← apply_backward_step conjD2 goal=0 facts=[3]
qed

theorem index_1
  fixes p :: nat
  prop index p 1 = 0
  [hint_rewrite]

theorem index_mul
  fixes m :: nat, n :: nat, p :: nat
  prop prime p --> ~(m = 0) --> ~(n = 0) --> index p (m * n) = index p m + index p n
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ¬(m = 0)
    #[3] ¬(n = 0)
    #[4] index p (m * n) = index p m + index p n
  ← rewrite_goal le_antisym sym=true goal=4
    #[5] index p (m * n) ≤ index p m + index p n ∧ index p m + index p n ≤ index p (m * n)
  -> rewrite_fact prime_def sym=false goal=5 facts=[1]
    #[6] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD1 goal=5 facts=[6]
    #[7] ¬(p = 1)
  ← apply_backward_step conjI goal=5
    #[8] index p (m * n) ≤ index p m + index p n
    #[9] index p m + index p n ≤ index p (m * n)
  cut "!m. !n. (∀k::nat. k ≤ m ⟶ k ≤ n) ⟶ m ≤ n" goal=8
    #[10] ∀m::nat. ∀n. (∀k. k ≤ m ⟶ k ≤ n) ⟶ m ≤ n
  ← z3 goal=10
    #[11] ∀m::nat. ∀n. (∀k. k ≤ m ⟶ k ≤ n) ⟶ m ≤ n
  ← apply_prev goal=8 facts=[11]
    #[12] ∀k. k ≤ index p (m * n) ⟶ k ≤ index p m + index p n
  ← introduction k goal=12
    #[13] _VAR k
    #[14] k ≤ index p (m * n)
    #[15] k ≤ index p m + index p n
  -> apply_forward_step primepow_divides_prod param_k=k param_m=m param_n=n goal=15 facts=[1]
    #[16] divides (p ^ k) (m * n) ⟶ (∃i. ∃j. divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j)
  -> rewrite_fact le_index sym=false goal=15 facts=[14]
    #[17] (m * n = 0 ∨ p = 1 ⟶ k = 0) ∧ divides (p ^ k) (m * n)
  -> apply_forward_step conjD2 goal=15 facts=[17]
    #[18] divides (p ^ k) (m * n)
  -> apply_fact goal=15 facts=[16,18]
    #[19] ∃i. ∃j. divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j
  exists_elim i,j goal=15 facts=[19]
    #[20] _VAR i
    #[21] _VAR j
    #[22] divides (p ^ i) m ∧ divides (p ^ j) n ∧ k = i + j
    #[23] k ≤ index p m + index p n
  -> apply_forward_step conjD1 goal=23 facts=[22]
    #[24] divides (p ^ i) m
  -> apply_forward_step conjD2 goal=23 facts=[22]
    #[25] divides (p ^ j) n ∧ k = i + j
  -> apply_forward_step conjD1 goal=23 facts=[25]
    #[26] divides (p ^ j) n
  -> apply_forward_step conjD2 goal=23 facts=[25]
    #[27] k = i + j
  ← rewrite_goal_with_prev goal=23 facts=[27]
    #[28] i + j ≤ index p m + index p n
  ← apply_backward_step le_add2 goal=28
    #[29] i ≤ index p m
    #[30] j ≤ index p n
  ← rewrite_goal le_index sym=false goal=29
    #[31] (m = 0 ∨ p = 1 ⟶ i = 0) ∧ divides (p ^ i) m
  ← apply_backward_step conjI goal=31
    #[32] m = 0 ∨ p = 1 ⟶ i = 0
  ← introduction goal=32
    #[33] m = 0 ∨ p = 1
    #[34] i = 0
  ← apply_backward_step contrapositive goal=34 facts=[33]
    #[35] ¬(i = 0) ⟶ ¬(m = 0 ∨ p = 1)
  ← introduction goal=35
    #[36] ¬(i = 0)
    #[37] ¬(m = 0 ∨ p = 1)
  ← rewrite_goal de_morgan_thm2 sym=false goal=37
    #[38] ¬(m = 0) ∧ ¬(p = 1)
  ← apply_backward_step conjI goal=38
  ← rewrite_goal le_index sym=false goal=30
    #[39] (n = 0 ∨ p = 1 ⟶ j = 0) ∧ divides (p ^ j) n
  ← apply_backward_step conjI goal=39
    #[40] n = 0 ∨ p = 1 ⟶ j = 0
  ← introduction goal=40
    #[41] n = 0 ∨ p = 1
    #[42] j = 0
  ← apply_backward_step contrapositive goal=42 facts=[41]
    #[43] ¬(j = 0) ⟶ ¬(n = 0 ∨ p = 1)
  ← introduction goal=43
    #[44] ¬(j = 0)
    #[45] ¬(n = 0 ∨ p = 1)
  ← rewrite_goal de_morgan_thm2 sym=false goal=45
    #[46] ¬(n = 0) ∧ ¬(p = 1)
  ← apply_backward_step conjI goal=46
  ← rewrite_goal le_index sym=false goal=9
    #[47] (m * n = 0 ∨ p = 1 ⟶ index p m + index p n = 0) ∧ divides (p ^ (index p m + index p n)) (m * n)
  ← apply_backward_step conjI goal=47
    #[48] m * n = 0 ∨ p = 1 ⟶ index p m + index p n = 0
    #[49] divides (p ^ (index p m + index p n)) (m * n)
  ← introduction goal=48
    #[50] m * n = 0 ∨ p = 1
    #[51] index p m + index p n = 0
  -> rewrite_fact mult_eq_0 sym=false goal=51 facts=[50]
    #[52] (m = 0 ∨ n = 0) ∨ p = 1
  ← apply_backward_step contrapositive goal=51 facts=[52]
    #[53] ¬(index p m + index p n = 0) ⟶ ¬((m = 0 ∨ n = 0) ∨ p = 1)
  ← introduction goal=53
    #[54] ¬(index p m + index p n = 0)
    #[55] ¬((m = 0 ∨ n = 0) ∨ p = 1)
  ← rewrite_goal de_morgan_thm2 sym=false goal=55
    #[56] ¬(m = 0 ∨ n = 0) ∧ ¬(p = 1)
  ← rewrite_goal de_morgan_thm2 sym=false goal=56
    #[57] (¬(m = 0) ∧ ¬(n = 0)) ∧ ¬(p = 1)
  ← apply_backward_step conjI goal=57
    #[58] ¬(m = 0) ∧ ¬(n = 0)
  ← apply_backward_step conjI goal=58
  ← rewrite_goal nat_power_add sym=false goal=49
    #[59] divides (p ^ index p m * p ^ index p n) (m * n)
  ← apply_backward_step divides_mul2 goal=59
    #[60] divides (p ^ index p m) m
    #[61] divides (p ^ index p n) n
  ← apply_backward_step exp_index_divides goal=60
    #[62] divides (p ^ index p m) m
  ← apply_backward_step exp_index_divides goal=61
    #[63] divides (p ^ index p n) n
qed

theorem index_exp
  fixes k :: nat, n :: nat, p :: nat
  prop prime p --> index p (n ^ k) = k * index p n
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] index p (n ^ k) = k * index p n
  ← cases "n=0" goal=2
    #[3] n = 0 ⟶ index p (n ^ k) = k * index p n
    #[4] ¬(n = 0) ⟶ index p (n ^ k) = k * index p n
  ← introduction goal=3
    #[5] n = 0
    #[6] index p (n ^ k) = k * index p n
  ← rewrite_goal_with_prev goal=6 facts=[5]
    #[7] index p (0 ^ k) = k * index p 0
  ← rewrite_goal exp_zero sym=false goal=7
    #[8] index p (if k = 0 then 1 else 0) = k * index p 0
  ← cases "k = 0" goal=8
    #[9] k = 0 ⟶ index p (if k = 0 then 1 else 0) = k * index p 0
    #[10] ¬(k = 0) ⟶ index p (if k = 0 then 1 else 0) = k * index p 0
  ← introduction goal=9
    #[11] k = 0
    #[12] index p (if k = 0 then 1 else 0) = k * index p 0
  ← rewrite_goal if_P sym=false goal=12 facts=[11]
    #[13] index p 1 = k * index p 0
  ← rewrite_goal index_1 sym=false goal=13
    #[14] 0 = k * index p 0
  ← rewrite_goal index_0 sym=false goal=14
    #[15] 0 = k * 0
  ← rewrite_goal mult_0_right sym=false goal=15
    #[16] 0 = k * 0
  ← introduction goal=10
    #[17] ¬(k = 0)
    #[18] index p (if k = 0 then 1 else 0) = k * index p 0
  ← rewrite_goal if_not_P sym=false goal=18 facts=[17]
    #[19] index p 0 = k * index p 0
  ← rewrite_goal index_0 sym=false goal=19
    #[20] 0 = k * 0
  ← rewrite_goal mult_0_right sym=false goal=20
  ← introduction goal=4
    #[21] ¬(n = 0)
    #[22] index p (n ^ k) = k * index p n
  ← induction k nat_induct goal=22
    #[23] index p (n ^ (0::nat)) = 0 * index p n
    #[24] ∀n1. index p (n ^ n1) = n1 * index p n ⟶ index p (n ^ Suc n1) = Suc n1 * index p n
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=23
    #[25] index p 1 = 0 * index p n
  ← rewrite_goal nat_times_def_1 sym=false goal=25
    #[26] index p 1 = 0
  ← rewrite_goal index_1 sym=false goal=26
    #[27] index p 1 = 0
  ← introduction k goal=24
    #[28] _VAR k
    #[29] index p (n ^ k) = k * index p n
    #[30] index p (n ^ Suc k) = Suc k * index p n
  ← rewrite_goal nat_nat_power_def_2 sym=false goal=30
    #[31] index p (n * n ^ k) = Suc k * index p n
  ← rewrite_goal add_1_right sym=true goal=31
    #[32] index p (n * n ^ k) = (k + 1) * index p n
  ← rewrite_goal distrib_r sym=false goal=32
    #[33] index p (n * n ^ k) = k * index p n + 1 * index p n
  ← rewrite_goal mult_1_left sym=false goal=33
    #[34] index p (n * n ^ k) = k * index p n + index p n
  -> rewrite_fact eq_sym_eq sym=false goal=34 facts=[29]
    #[35] k * index p n = index p (n ^ k)
  ← rewrite_goal_with_prev goal=34 facts=[35]
    #[36] index p (n * n ^ k) = index p (n ^ k) + index p n
  ← rewrite_goal mult_comm sym=false goal=36
    #[37] index p (n ^ k * n) = index p (n ^ k) + index p n
  ← apply_backward_step index_mul goal=37
    #[38] ¬(n ^ k = 0)
  ← rewrite_goal exp_eq_0 sym=false goal=38
    #[39] ¬(n = 0 ∧ ¬(k = 0))
  ← rewrite_goal de_morgan_thm1 sym=false goal=39
    #[40] ¬(n = 0) ∨ ¬¬(k = 0)
  ← apply_backward_step disjI1 goal=40
qed

theorem index_fact
  fixes n :: nat, p :: nat
  prop prime p --> index p (fact n) = nsum ({1..n}) (%m. index p m)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] index p (fact n) = nsum ({1..n}) (λm. index p m)
  ← induction n nat_induct goal=2
    #[3] index p (fact 0) = nsum ({1..0}) (λm. index p m)
    #[4] ∀n. index p (fact n) = nsum ({1..n}) (λm. index p m) ⟶ index p (fact (Suc n)) = nsum ({1..Suc n}) (λm. index p m)
  ← rewrite_goal fact_def_1 sym=false goal=3
    #[5] index p 1 = nsum ({1..0}) (λm. index p m)
  ← rewrite_goal index_1 sym=false goal=5
    #[6] 0 = nsum ({1..0}) (λm. index p m)
  ← rewrite_goal eq_sym_eq sym=false goal=6
    #[7] nsum ({1..0}) (λm. index p m) = 0
  ← rewrite_goal nsum_eq_0_iff_natseg sym=false goal=7
    #[8] ∀i. 1 ≤ i ⟶ i ≤ 0 ⟶ index p i = 0
  ← z3 goal=8
    #[9] ∀i. 1 ≤ i ⟶ i ≤ 0 ⟶ index p i = 0
  ← introduction n goal=4
    #[10] _VAR n
    #[11] index p (fact n) = nsum ({1..n}) (λm. index p m)
    #[12] index p (fact (Suc n)) = nsum ({1..Suc n}) (λm. index p m)
  ← rewrite_goal fact_def_2 sym=false goal=12
    #[13] index p (Suc n * fact n) = nsum ({1..Suc n}) (λm. index p m)
  ← rewrite_goal nsum_Suc_natseg sym=false goal=13
    #[14] index p (Suc n * fact n) = (if 1 ≤ Suc n then nsum ({1..n}) (λm. index p m) + index p (Suc n) else nsum ({1..n}) (λm. index p m))
  cut "1 ≤ Suc n" goal=14
    #[15] 1 ≤ Suc n
  ← apply_backward_step le_1_2 goal=15
    #[16] ¬(Suc n = 0)
  ← apply_backward_step ineq_sym goal=16
    #[17] ¬(0 = Suc n)
  ← apply_backward_step nat_zero_Suc_neq goal=17
    #[18] ¬(0 = Suc n)
  ← rewrite_goal if_P sym=false goal=14 facts=[15]
    #[19] index p (Suc n * fact n) = nsum ({1..n}) (λm. index p m) + index p (Suc n)
  -> rewrite_fact eq_sym_eq sym=false goal=19 facts=[11]
    #[20] nsum ({1..n}) (λm. index p m) = index p (fact n)
  ← rewrite_goal_with_prev goal=19 facts=[20]
    #[21] index p (Suc n * fact n) = index p (fact n) + index p (Suc n)
  ← rewrite_goal add_comm sym=false goal=21
    #[22] index p (Suc n * fact n) = index p (Suc n) + index p (fact n)
  ← apply_backward_step index_mul goal=22
    #[23] ¬(fact n = 0)
  ← apply_backward_step fact_nz goal=23
    #[24] ¬(fact n = 0)
qed

theorem index_fact_alt
  fixes n :: nat, p :: nat
  prop prime p --> index p (fact n) = nsum ({j::nat. 1 <= j & p ^ j <= n}) (%j. n DIV p ^ j)
  [hint_backward,hint_backward1]

theorem index_fact_unbounded
  fixes n :: nat, p :: nat
  prop prime p --> index p (fact n) = nsum ({j::nat. 1 <= j}) (%j. n DIV p ^ j)
  [hint_backward]

theorem primepow_divides_fact
  fixes k :: nat, n :: nat, p :: nat
  prop prime p --> divides (p ^ k) (fact n) <--> k <= nsum ({j::nat. 1 <= j & p ^ j <= n}) (%j. n DIV p ^ j)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides (p ^ k) (fact n) ⟷ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← rewrite_goal primepow_divides_index sym=false goal=2
    #[3] fact n = 0 ∨ p = 1 ∨ k ≤ index p (fact n) ⟷ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  -> apply_forward_step index_fact_alt param_n=n goal=3 facts=[1]
    #[4] index p (fact n) = nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← rewrite_goal_with_prev goal=3 facts=[4]
    #[5] fact n = 0 ∨ p = 1 ∨ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j) ⟷ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← apply_backward_step iffI goal=5
    #[6] fact n = 0 ∨ p = 1 ∨ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j) ⟶ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
    #[7] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j) ⟶ fact n = 0 ∨ p = 1 ∨ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← introduction goal=6
    #[8] fact n = 0 ∨ p = 1 ∨ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
    #[9] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← apply_backward_step disjE goal=9 facts=[8]
    #[10] fact n = 0 ⟶ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
    #[11] p = 1 ∨ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j) ⟶ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← introduction goal=10
    #[12] fact n = 0
    #[13] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  -> apply_forward_step fact_nz param_n=n goal=13
    #[14] ¬(fact n = 0)
  ← apply_backward_step negE_gen goal=13 facts=[14,12]
    #[15] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← introduction goal=11
    #[16] p = 1 ∨ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
    #[17] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← apply_backward_step disjE goal=17 facts=[16]
    #[18] p = 1 ⟶ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
    #[19] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j) ⟶ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← introduction goal=18
    #[20] p = 1
    #[21] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  -> rewrite_fact prime_def sym=false goal=21 facts=[1]
    #[22] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD1 goal=21 facts=[22]
    #[23] ¬(p = 1)
  ← apply_backward_step negE_gen goal=21 facts=[23,20]
    #[24] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← introduction goal=7
    #[25] k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
    #[26] fact n = 0 ∨ p = 1 ∨ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← apply_backward_step disjI2 goal=26
    #[27] p = 1 ∨ k ≤ nsum ({j::nat. 1 ≤ j ∧ p ^ j ≤ n}) (λj. n DIV p ^ j)
  ← apply_backward_step disjI2 goal=27
qed

theorem index_refl
  fixes n :: nat
  prop index n n = (if n <= 1 then 0 else 1)
  [hint_rewrite]
proof
  ← rewrite_goal index_def sym=false goal=0
    #[1] (if n ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (n ^ j) n})) = (if n ≤ 1 then 0 else 1)
  ← cases "n ≤ 1 ∨ n = 0" goal=1
    #[2] n ≤ 1 ∨ n = 0 ⟶ (if n ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (n ^ j) n})) = (if n ≤ 1 then 0 else 1)
    #[3] ¬(n ≤ 1 ∨ n = 0) ⟶ (if n ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (n ^ j) n})) = (if n ≤ 1 then 0 else 1)
  ← introduction goal=2
    #[4] n ≤ 1 ∨ n = 0
    #[5] (if n ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (n ^ j) n})) = (if n ≤ 1 then 0 else 1)
  ← rewrite_goal if_P sym=false goal=5 facts=[4]
    #[6] (0::nat) = (if n ≤ 1 then 0 else 1)
  ← apply_backward_step disjE goal=6 facts=[4]
    #[7] n ≤ 1 ⟶ (0::nat) = (if n ≤ 1 then 0 else 1)
    #[8] n = 0 ⟶ (0::nat) = (if n ≤ 1 then 0 else 1)
  ← introduction goal=7
    #[9] n ≤ 1
    #[10] (0::nat) = (if n ≤ 1 then 0 else 1)
  ← rewrite_goal if_P sym=false goal=10 facts=[9]
    #[11] (0::nat) = (if n ≤ 1 then 0 else 1)
  ← introduction goal=8
    #[12] n = 0
    #[13] (0::nat) = (if n ≤ 1 then 0 else 1)
  cut "n <= 1" goal=13
    #[14] n ≤ 1
  ← z3 goal=14 facts=[12]
    #[15] n ≤ 1
  ← rewrite_goal if_P sym=false goal=13 facts=[15]
    #[16] (0::nat) = (if n ≤ 1 then 0 else 1)
  ← introduction goal=3
    #[17] ¬(n ≤ 1 ∨ n = 0)
    #[18] (if n ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (n ^ j) n})) = (if n ≤ 1 then 0 else 1)
  ← rewrite_goal if_not_P sym=false goal=18 facts=[17]
    #[19] card ({j::nat. 1 ≤ j ∧ divides (n ^ j) n}) = (if n ≤ 1 then 0 else 1)
  -> rewrite_fact de_morgan_thm2 sym=false goal=19 facts=[17]
    #[20] ¬(n ≤ 1) ∧ ¬(n = 0)
  -> apply_forward_step conjD1 goal=19 facts=[20]
    #[21] ¬(n ≤ 1)
  ← rewrite_goal if_not_P sym=false goal=19 facts=[21]
    #[22] card ({j::nat. 1 ≤ j ∧ divides (n ^ j) n}) = 1
  cut "2 <= n" goal=22
    #[23] 2 ≤ n
  ← z3 goal=23 facts=[21]
  -> apply_forward_step divides_exp_le param_m="" param_n="(1::nat)" goal=22 facts=[23]
    #[24] ∀m::nat. divides (n ^ m) (n ^ (1::nat)) ⟷ m ≤ 1
  -> rewrite_fact exp_1 sym=false goal=22 facts=[24]
    #[25] ∀m::nat. divides (n ^ m) n ⟷ m ≤ 1
  ← rewrite_goal_with_prev goal=22 facts=[25]
    #[26] card ({j::nat. 1 ≤ j ∧ j ≤ 1}) = 1
  ← rewrite_goal nat_interval_def sym=true goal=26
    #[27] card ({1..1}) = 1
  ← rewrite_goal card_natseg_1 sym=false goal=27
    #[28] card ({1..1}) = 1
qed

theorem index_eq_0
  fixes n :: nat, p :: nat
  prop index p n = 0 <--> n = 0 | p = 1 | ~(divides p n)
  [hint_rewrite]
proof
  cut "∀n::nat. n = 0 ⟷ ¬(1 ≤ n)" goal=0
    #[1] ∀n::nat. n = 0 ⟷ ¬(1 ≤ n)
  ← z3 goal=1
  ← apply_backward_step iffI goal=0
    #[2] index p n = 0 ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p n)
    #[3] n = 0 ∨ p = 1 ∨ ¬(divides p n) ⟶ index p n = 0
  ← introduction goal=2
    #[4] index p n = 0
    #[5] n = 0 ∨ p = 1 ∨ ¬(divides p n)
  -> rewrite_fact_with_prev goal=5 facts=[1,4]
    #[6] ¬(1 ≤ index p n)
  -> rewrite_fact le_index sym=false goal=5 facts=[6]
    #[7] ¬((n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∧ divides (p ^ (1::nat)) n)
  -> rewrite_fact exp_1 sym=false goal=5 facts=[7]
    #[8] ¬((n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∧ divides p n)
  -> rewrite_fact de_morgan_thm1 sym=false goal=5 facts=[8]
    #[9] ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∨ ¬(divides p n)
  ← apply_backward_step disjE goal=5 facts=[9]
    #[10] ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p n)
    #[11] ¬(divides p n) ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← introduction goal=10
    #[12] ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0)
    #[13] n = 0 ∨ p = 1 ∨ ¬(divides p n)
  -> rewrite_fact not_imp sym=false goal=13 facts=[12]
    #[14] (n = 0 ∨ p = 1) ∧ ¬((1::nat) = 0)
  -> apply_forward_step conjD1 goal=13 facts=[14]
    #[15] n = 0 ∨ p = 1
  ← apply_backward_step disjE goal=13 facts=[15]
    #[16] n = 0 ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p n)
    #[17] p = 1 ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← introduction goal=16
    #[18] n = 0
    #[19] n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjI1 goal=19 facts=[18]
    #[20] n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← introduction goal=17
    #[21] p = 1
    #[22] n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjI2 goal=22
    #[23] p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjI1 goal=23
  ← introduction goal=11
    #[24] ¬(divides p n)
    #[25] n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjI2 goal=25
    #[26] p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjI2 goal=26
  ← introduction goal=3
    #[27] n = 0 ∨ p = 1 ∨ ¬(divides p n)
    #[28] index p n = 0
  ← rewrite_goal_with_prev goal=28 facts=[1]
    #[29] ¬(1 ≤ index p n)
  ← rewrite_goal le_index sym=false goal=29
    #[30] ¬((n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∧ divides (p ^ (1::nat)) n)
  ← rewrite_goal de_morgan_thm1 sym=false goal=30
    #[31] ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∨ ¬(divides (p ^ (1::nat)) n)
  -> apply_forward_step disj_assoc goal=31 facts=[27]
    #[32] (n = 0 ∨ p = 1) ∨ ¬(divides p n)
  ← apply_backward_step disjE goal=31 facts=[32]
    #[33] n = 0 ∨ p = 1 ⟶ ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∨ ¬(divides (p ^ (1::nat)) n)
    #[34] ¬(divides p n) ⟶ ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∨ ¬(divides (p ^ (1::nat)) n)
  ← introduction goal=33
    #[35] n = 0 ∨ p = 1
    #[36] ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∨ ¬(divides (p ^ (1::nat)) n)
  ← apply_backward_step disjI1 goal=36
    #[37] ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0)
  ← rewrite_goal not_imp sym=false goal=37
    #[38] (n = 0 ∨ p = 1) ∧ ¬((1::nat) = 0)
  ← apply_backward_step conjI goal=38
    #[39] ¬((1::nat) = 0)
  nat_const_ineq goal=39
    #[40] ¬((1::nat) = 0)
  ← introduction goal=34
    #[41] ¬(n = 0 ∨ p = 1 ⟶ (1::nat) = 0) ∨ ¬(divides (p ^ (1::nat)) n)
  ← apply_backward_step disjI2 goal=41
    #[42] ¬(divides (p ^ (1::nat)) n)
  ← rewrite_goal exp_1 sym=false goal=42
qed

theorem index_zero
  fixes n :: nat, p :: nat
  prop ~(divides p n) --> index p n = 0
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ¬(divides p n)
    #[2] index p n = 0
  ← rewrite_goal index_eq_0 sym=false goal=2
    #[3] n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjI2 goal=3
    #[4] p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjI2 goal=4
qed

theorem index_pow
  fixes k :: nat, n :: nat, p :: nat
  prop index (p ^ k) n = index p n DIV k
  [hint_rewrite]
proof
  ← cases "k=0" goal=0
    #[1] k = 0 ⟶ index (p ^ k) n = index p n DIV k
    #[2] ¬(k = 0) ⟶ index (p ^ k) n = index p n DIV k
  ← introduction goal=1
    #[3] k = 0
    #[4] index (p ^ k) n = index p n DIV k
  ← rewrite_goal_with_prev goal=4 facts=[3]
    #[5] index (p ^ (0::nat)) n = index p n DIV 0
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=5
    #[6] index 1 n = index p n DIV 0
  ← rewrite_goal div_zero sym=false goal=6
    #[7] index 1 n = 0
  ← rewrite_goal index_eq_0 sym=false goal=7
    #[8] n = 0 ∨ (1::nat) = 1 ∨ ¬(divides 1 n)
  ← apply_backward_step disjI2 goal=8
    #[9] (1::nat) = 1 ∨ ¬(divides 1 n)
  ← apply_backward_step disjI1 goal=9
    #[10] (1::nat) = 1
  ← apply_backward_step eq_refl goal=10
    #[11] (1::nat) = 1
  ← introduction goal=2
    #[12] ¬(k = 0)
    #[13] index (p ^ k) n = index p n DIV k
  cut "!m::nat. !n. (m = n) <--> !d. d <= m <--> d <= n" goal=13
    #[14] ∀m::nat. ∀n. m = n ⟷ (∀d. d ≤ m ⟷ d ≤ n)
  ← z3 goal=14
    #[15] ∀m::nat. ∀n. m = n ⟷ (∀d. d ≤ m ⟷ d ≤ n)
  ← rewrite_goal_with_prev goal=13 facts=[15]
    #[16] ∀d. d ≤ index (p ^ k) n ⟷ d ≤ index p n DIV k
  ← introduction d goal=16
    #[17] _VAR d
    #[18] d ≤ index (p ^ k) n ⟷ d ≤ index p n DIV k
  -> apply_forward_step le_rdiv_eq param_b="index p n" param_n=d goal=18 facts=[12]
    #[19] d ≤ index p n DIV k ⟷ k * d ≤ index p n
  ← rewrite_goal_with_prev goal=18 facts=[19]
    #[20] d ≤ index (p ^ k) n ⟷ k * d ≤ index p n
  ← rewrite_goal le_index sym=false goal=20
    #[21] (n = 0 ∨ p ^ k = 1 ⟶ d = 0) ∧ divides (p ^ k ^ d) n ⟷ (n = 0 ∨ p = 1 ⟶ k * d = 0) ∧ divides (p ^ (k * d)) n
  ← apply_backward_step iffI goal=21
    #[22] (n = 0 ∨ p ^ k = 1 ⟶ d = 0) ∧ divides (p ^ k ^ d) n ⟶ (n = 0 ∨ p = 1 ⟶ k * d = 0) ∧ divides (p ^ (k * d)) n
    #[23] (n = 0 ∨ p = 1 ⟶ k * d = 0) ∧ divides (p ^ (k * d)) n ⟶ (n = 0 ∨ p ^ k = 1 ⟶ d = 0) ∧ divides (p ^ k ^ d) n
  ← introduction goal=22
    #[24] (n = 0 ∨ p ^ k = 1 ⟶ d = 0) ∧ divides (p ^ k ^ d) n
    #[25] (n = 0 ∨ p = 1 ⟶ k * d = 0) ∧ divides (p ^ (k * d)) n
  -> apply_forward_step conjD1 goal=25 facts=[24]
    #[26] n = 0 ∨ p ^ k = 1 ⟶ d = 0
  -> apply_forward_step conjD2 goal=25 facts=[24]
    #[27] divides (p ^ k ^ d) n
  ← apply_backward_step conjI goal=25
    #[28] n = 0 ∨ p = 1 ⟶ k * d = 0
    #[29] divides (p ^ (k * d)) n
  ← introduction goal=28
    #[30] n = 0 ∨ p = 1
    #[31] k * d = 0
  ← rewrite_goal mult_eq_0 sym=false goal=31
    #[32] k = 0 ∨ d = 0
  ← apply_backward_step disjI2 goal=32
    #[33] d = 0
  ← apply_prev goal=33 facts=[26]
    #[34] n = 0 ∨ p ^ k = 1
  ← apply_backward_step disjE goal=34 facts=[30]
    #[35] n = 0 ⟶ n = 0 ∨ p ^ k = 1
    #[36] p = 1 ⟶ n = 0 ∨ p ^ k = 1
  ← introduction goal=35
    #[37] n = 0
    #[38] n = 0 ∨ p ^ k = 1
  ← apply_backward_step disjI1 goal=38
  ← introduction goal=36
    #[39] p = 1
    #[40] n = 0 ∨ p ^ k = 1
  ← apply_backward_step disjI2 goal=40
    #[41] p ^ k = 1
  ← rewrite_goal exp_eq_1 sym=false goal=41
    #[42] p = 1 ∨ k = 0
  ← apply_backward_step disjI1 goal=42
  ← rewrite_goal exp_mult sym=false goal=29
  ← introduction goal=23
    #[43] (n = 0 ∨ p = 1 ⟶ k * d = 0) ∧ divides (p ^ (k * d)) n
    #[44] (n = 0 ∨ p ^ k = 1 ⟶ d = 0) ∧ divides (p ^ k ^ d) n
  -> apply_forward_step conjD1 goal=44 facts=[43]
    #[45] n = 0 ∨ p = 1 ⟶ k * d = 0
  -> apply_forward_step conjD2 goal=44 facts=[43]
    #[46] divides (p ^ (k * d)) n
  -> rewrite_fact exp_mult sym=false goal=44 facts=[46]
    #[47] divides (p ^ k ^ d) n
  ← apply_backward_step conjI goal=44
    #[48] n = 0 ∨ p ^ k = 1 ⟶ d = 0
  ← introduction goal=48
    #[49] n = 0 ∨ p ^ k = 1
    #[50] d = 0
  -> rewrite_fact mult_eq_0 sym=false goal=50 facts=[45]
    #[51] n = 0 ∨ p = 1 ⟶ k = 0 ∨ d = 0
  cut "n = 0 ∨ p = 1" goal=50
    #[52] n = 0 ∨ p = 1
  ← apply_backward_step disjE goal=52 facts=[49]
    #[53] n = 0 ⟶ n = 0 ∨ p = 1
    #[54] p ^ k = 1 ⟶ n = 0 ∨ p = 1
  ← introduction goal=53
    #[55] n = 0 ∨ p = 1
  ← apply_backward_step disjI1 goal=55
  ← introduction goal=54
    #[56] p ^ k = 1
    #[57] n = 0 ∨ p = 1
  ← apply_backward_step disjI2 goal=57
    #[58] p = 1
  -> rewrite_fact exp_eq_1 sym=false goal=58 facts=[56]
    #[59] p = 1 ∨ k = 0
  ← apply_backward_step disjE goal=58 facts=[59]
    #[60] p = 1 ⟶ p = 1
    #[61] k = 0 ⟶ p = 1
  ← introduction goal=61
    #[62] p = 1
  ← apply_backward_step negE_gen goal=62 facts=[12,3]
    #[63] p = 1
  -> apply_fact goal=50 facts=[51,52]
    #[64] k = 0 ∨ d = 0
  ← apply_backward_step disjE goal=50 facts=[64]
    #[65] k = 0 ⟶ d = 0
    #[66] d = 0 ⟶ d = 0
  ← introduction goal=65
    #[67] d = 0
  ← apply_backward_step negE_gen goal=67 facts=[12,3]
    #[68] d = 0
qed

theorem index_prime
  fixes a :: nat, p :: nat
  prop prime p --> index a p = (if p = a then 1 else 0)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] index a p = (if p = a then 1 else 0)
  ← cases "p = a" goal=2
    #[3] p = a ⟶ index a p = (if p = a then 1 else 0)
    #[4] ¬(p = a) ⟶ index a p = (if p = a then 1 else 0)
  ← introduction goal=3
    #[5] p = a
    #[6] index a p = (if p = a then 1 else 0)
  ← rewrite_goal if_P sym=false goal=6 facts=[5]
    #[7] index a p = 1
  ← rewrite_goal_with_prev goal=7 facts=[5]
    #[8] index a a = 1
  ← rewrite_goal index_refl sym=false goal=8
    #[9] (if a ≤ 1 then (0::nat) else 1) = 1
  cut "~(a ≤ 1)" goal=9
    #[10] ¬(a ≤ 1)
  -> apply_forward_step prime_ge_2 goal=10 facts=[1]
    #[11] 2 ≤ p
  -> rewrite_fact_with_prev goal=10 facts=[5,11]
    #[12] 2 ≤ a
  ← z3 goal=10 facts=[12]
  ← rewrite_goal if_not_P sym=false goal=9 facts=[10]
  ← introduction goal=4
    #[13] ¬(p = a)
    #[14] index a p = (if p = a then 1 else 0)
  ← rewrite_goal if_not_P sym=false goal=14 facts=[13]
    #[15] index a p = 0
  ← rewrite_goal index_eq_0 sym=false goal=15
    #[16] p = 0 ∨ a = 1 ∨ ¬(divides a p)
  ← apply_backward_step disjI2 goal=16
    #[17] a = 1 ∨ ¬(divides a p)
  -> rewrite_fact prime_def sym=false goal=17 facts=[1]
    #[18] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD2 goal=17 facts=[18]
    #[19] ∀x. divides x p ⟶ x = 1 ∨ x = p
  ← cases "a=1" goal=17
    #[20] a = 1 ⟶ a = 1 ∨ ¬(divides a p)
    #[21] ¬(a = 1) ⟶ a = 1 ∨ ¬(divides a p)
  ← introduction goal=20
    #[22] a = 1
    #[23] a = 1 ∨ ¬(divides a p)
  ← apply_backward_step disjI1 goal=23
  ← introduction goal=21
    #[24] ¬(a = 1)
    #[25] a = 1 ∨ ¬(divides a p)
  ← apply_backward_step disjI2 goal=25
    #[26] ¬(divides a p)
  ← apply_backward_step contrapositive goal=26 facts=[24]
    #[27] ¬¬(divides a p) ⟶ ¬¬(a = 1)
  ← rewrite_goal double_neg sym=false goal=27
    #[28] divides a p ⟶ a = 1
  ← introduction goal=28
    #[29] divides a p
    #[30] a = 1
  -> apply_fact goal=30 facts=[19,29]
    #[31] a = 1 ∨ a = p
  ← apply_backward_step disjE goal=30 facts=[31]
    #[32] a = 1 ⟶ a = 1
    #[33] a = p ⟶ a = 1
  ← introduction goal=33
    #[34] a = p
    #[35] a = 1
  -> rewrite_fact eq_sym_eq sym=false goal=35 facts=[34]
    #[36] p = a
  ← apply_backward_step negE_gen goal=35 facts=[13,36]
    #[37] a = 1
qed

theorem index_trivial_bound
  fixes n :: nat, p :: nat
  prop index p n <= n
  [hint_backward]
proof
  -> apply_forward_step primepow_divides_index param_k=n param_n=n param_p=p goal=0
    #[1] divides (p ^ n) n ⟷ n = 0 ∨ p = 1 ∨ n ≤ index p n
  ← rewrite_goal index_def sym=false goal=0
    #[2] (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ n
  -> rewrite_fact index_def sym=false goal=2 facts=[1]
    #[3] divides (p ^ n) n ⟷ n = 0 ∨ p = 1 ∨ n ≤ (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n}))
  ← cases "p ≤ 1 ∨ n = 0" goal=2
    #[4] p ≤ 1 ∨ n = 0 ⟶ (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ n
    #[5] ¬(p ≤ 1 ∨ n = 0) ⟶ (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ n
  ← introduction goal=4
    #[6] p ≤ 1 ∨ n = 0
    #[7] (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ n
  ← rewrite_goal if_P sym=false goal=7 facts=[6]
    #[8] 0 ≤ n
  ← apply_backward_step le_0 goal=8
    #[9] 0 ≤ n
  ← introduction goal=5
    #[10] ¬(p ≤ 1 ∨ n = 0)
    #[11] (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ n
  ← rewrite_goal if_not_P sym=false goal=11 facts=[10]
    #[12] card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n}) ≤ n
  -> rewrite_fact if_not_P sym=false goal=12 facts=[3,10]
    #[13] divides (p ^ n) n ⟷ n = 0 ∨ p = 1 ∨ n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})
  -> rewrite_fact de_morgan_thm2 sym=false goal=12 facts=[10]
    #[14] ¬(p ≤ 1) ∧ ¬(n = 0)
  -> apply_forward_step conjD1 goal=12 facts=[14]
    #[15] ¬(p ≤ 1)
  -> apply_forward_step conjD2 goal=12 facts=[14]
    #[16] ¬(n = 0)
  -> rewrite_fact not_le sym=false goal=12 facts=[15]
    #[17] 1 < p
  -> rewrite_fact le_lt sym=false goal=12 facts=[15]
    #[18] ¬(p < 1 ∨ p = 1)
  -> rewrite_fact de_morgan_thm2 sym=false goal=12 facts=[18]
    #[19] ¬(p < 1) ∧ ¬(p = 1)
  -> apply_forward_step conjD2 goal=12 facts=[19]
    #[20] ¬(p = 1)
  ← apply_backward_step lt_imp_le goal=12
    #[21] card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n}) < n
  ← rewrite_goal not_le sym=true goal=21
    #[22] ¬(n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n}))
  cut "~(divides (p ^ n) n)" goal=22 facts=[13]
    #[23] ¬(divides (p ^ n) n)
  ← apply_backward_step contrapositive goal=23 facts=[16]
    #[24] ¬¬(divides (p ^ n) n) ⟶ ¬¬(n = 0)
  ← rewrite_goal double_neg sym=false goal=24
    #[25] divides (p ^ n) n ⟶ n = 0
  ← introduction goal=25
    #[26] divides (p ^ n) n
    #[27] n = 0
  -> apply_forward_step divides_le goal=27 facts=[26]
    #[28] p ^ n ≤ n ∨ n = 0
  ← apply_backward_step disjE goal=27 facts=[28]
    #[29] p ^ n ≤ n ⟶ n = 0
    #[30] n = 0 ⟶ n = 0
  ← introduction goal=29
    #[31] p ^ n ≤ n
    #[32] n = 0
  ← apply_backward_step contrapositive goal=32 facts=[31]
    #[33] ¬(n = 0) ⟶ ¬(p ^ n ≤ n)
  ← rewrite_goal not_le sym=false goal=33
    #[34] ¬(n = 0) ⟶ n < p ^ n
  ← introduction goal=34
    #[35] ¬(n = 0)
    #[36] n < p ^ n
  ← apply_backward_step lte_trans param_m="(2::nat) ^ n" goal=36
    #[37] n < 2 ^ n
    #[38] 2 ^ n ≤ p ^ n
  ← apply_backward_step lt_pow2_refl goal=37
    #[39] n < 2 ^ n
  ← rewrite_goal exp_mono_le sym=false goal=38
    #[40] 2 ≤ p ∨ n = 0
  ← apply_backward_step disjI1 goal=40
    #[41] 2 ≤ p
  ← z3 goal=41 facts=[17]
    #[42] 2 ≤ p
  -> rewrite_fact_with_prev goal=22 facts=[13,23]
    #[43] ¬(n = 0 ∨ p = 1 ∨ n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n}))
  ← apply_backward_step contrapositive goal=22 facts=[43]
    #[44] ¬¬(n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ⟶ ¬¬(n = 0 ∨ p = 1 ∨ n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n}))
  ← rewrite_goal double_neg sym=false goal=44
    #[45] n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n}) ⟶ n = 0 ∨ p = 1 ∨ n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})
  ← introduction goal=45
    #[46] n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})
    #[47] n = 0 ∨ p = 1 ∨ n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})
  ← apply_backward_step disjI2 goal=47
    #[48] p = 1 ∨ n ≤ card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})
  ← apply_backward_step disjI2 goal=48
qed

theorem index_decomposition
  fixes n :: nat, p :: nat
  prop ?m. p ^ index p n * m = n & (n = 0 | p = 1 | ~(divides p m))
  [hint_backward]
proof
  -> apply_forward_step le_index param_k="index p n" param_n=n param_p=p goal=0
    #[1] index p n ≤ index p n ⟷ (n = 0 ∨ p = 1 ⟶ index p n = 0) ∧ divides (p ^ index p n) n
  cut "index p n ≤ index p n" goal=0
    #[2] index p n ≤ index p n
  ← apply_backward_step less_eq_refl goal=2
  -> rewrite_fact_with_prev goal=0 facts=[1,2]
    #[3] (n = 0 ∨ p = 1 ⟶ index p n = 0) ∧ divides (p ^ index p n) n
  -> apply_forward_step conjD1 goal=0 facts=[3]
    #[4] n = 0 ∨ p = 1 ⟶ index p n = 0
  -> apply_forward_step conjD2 goal=0 facts=[3]
    #[5] divides (p ^ index p n) n
  -> rewrite_fact divides_def sym=false goal=0 facts=[5]
    #[6] ∃k. n = p ^ index p n * k
  exists_elim m goal=0 facts=[6]
    #[7] _VAR m
    #[8] n = p ^ index p n * m
    #[9] ∃m. p ^ index p n * m = n ∧ (n = 0 ∨ p = 1 ∨ ¬(divides p m))
  ← inst_exists_goal m goal=9
    #[10] p ^ index p n * m = n ∧ (n = 0 ∨ p = 1 ∨ ¬(divides p m))
  ← apply_backward_step conjI goal=10
    #[11] p ^ index p n * m = n
    #[12] n = 0 ∨ p = 1 ∨ ¬(divides p m)
  -> rewrite_fact eq_sym_eq sym=false goal=11 facts=[8]
  -> apply_forward_step le_index param_k="index p n +1" param_n=n param_p=p goal=12
    #[13] index p n + 1 ≤ index p n ⟷ (n = 0 ∨ p = 1 ⟶ index p n + 1 = 0) ∧ divides (p ^ (index p n + 1)) n
  cut "~(index p n + 1 ≤ index p n)" goal=12
    #[14] ¬(index p n + 1 ≤ index p n)
  ← rewrite_goal not_le sym=false goal=14
    #[15] index p n < index p n + 1
  ← rewrite_goal lt_add sym=false goal=15
    #[16] (0::nat) < 1
  ← z3 goal=16
    #[17] (0::nat) < 1
  -> rewrite_fact_with_prev goal=12 facts=[13,14]
    #[18] ¬((n = 0 ∨ p = 1 ⟶ index p n + 1 = 0) ∧ divides (p ^ (index p n + 1)) n)
  ← cases "n=0" goal=12
    #[19] n = 0 ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p m)
    #[20] ¬(n = 0) ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← introduction goal=19
    #[21] n = 0
    #[22] n = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← apply_backward_step disjI1 goal=22
  ← introduction goal=20
    #[23] ¬(n = 0)
    #[24] n = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← cases "p=1" goal=24
    #[25] p = 1 ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p m)
    #[26] ¬(p = 1) ⟶ n = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← introduction goal=25
    #[27] p = 1
    #[28] n = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← apply_backward_step disjI2 goal=28
    #[29] p = 1 ∨ ¬(divides p m)
  ← apply_backward_step disjI1 goal=29
  ← introduction goal=26
    #[30] ¬(p = 1)
    #[31] n = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← apply_backward_step disjI2 goal=31
    #[32] p = 1 ∨ ¬(divides p m)
  ← apply_backward_step disjI2 goal=32
    #[33] ¬(divides p m)
  ← apply_backward_step contrapositive goal=33 facts=[18]
    #[34] ¬¬(divides p m) ⟶ ¬¬((n = 0 ∨ p = 1 ⟶ index p n + 1 = 0) ∧ divides (p ^ (index p n + 1)) n)
  ← rewrite_goal double_neg sym=false goal=34
    #[35] divides p m ⟶ (n = 0 ∨ p = 1 ⟶ index p n + 1 = 0) ∧ divides (p ^ (index p n + 1)) n
  ← introduction goal=35
    #[36] divides p m
    #[37] (n = 0 ∨ p = 1 ⟶ index p n + 1 = 0) ∧ divides (p ^ (index p n + 1)) n
  ← apply_backward_step conjI goal=37
    #[38] n = 0 ∨ p = 1 ⟶ index p n + 1 = 0
    #[39] divides (p ^ (index p n + 1)) n
  ← introduction goal=38
    #[40] n = 0 ∨ p = 1
    #[41] index p n + 1 = 0
  ← z3 goal=41 facts=[40,30,23]
    #[42] index p n + 1 = 0
  ← rewrite_goal nat_power_add sym=false goal=39
    #[43] divides (p ^ index p n * p ^ (1::nat)) n
  ← rewrite_goal exp_1 sym=false goal=43
    #[44] divides (p ^ index p n * p) n
  cut "divides (p ^ index p n * p) (p ^ index p n * m)" goal=44
    #[45] divides (p ^ index p n * p) (p ^ index p n * m)
  ← apply_backward_step divides_mult_left goal=45
  -> rewrite_fact eq_sym_eq sym=false goal=44 facts=[8]
  -> rewrite_fact_with_prev goal=44 facts=[11,45]
qed

theorem index_decomposition_prime
  fixes n :: nat, p :: nat
  prop prime p --> (?m. p ^ index p n * m = n & (n = 0 | coprime p m))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] ∃m. p ^ index p n * m = n ∧ (n = 0 ∨ coprime p m)
  -> apply_forward_step index_decomposition param_n=n param_p=p goal=2
    #[3] ∃m. p ^ index p n * m = n ∧ (n = 0 ∨ p = 1 ∨ ¬(divides p m))
  exists_elim m goal=2 facts=[3]
    #[4] _VAR m
    #[5] p ^ index p n * m = n ∧ (n = 0 ∨ p = 1 ∨ ¬(divides p m))
    #[6] ∃m. p ^ index p n * m = n ∧ (n = 0 ∨ coprime p m)
  ← inst_exists_goal m goal=6
    #[7] p ^ index p n * m = n ∧ (n = 0 ∨ coprime p m)
  -> apply_forward_step conjD1 goal=7 facts=[5]
    #[8] p ^ index p n * m = n
  -> apply_forward_step conjD2 goal=7 facts=[5]
    #[9] n = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← apply_backward_step conjI goal=7
    #[10] n = 0 ∨ coprime p m
  ← apply_backward_step disjE goal=10 facts=[9]
    #[11] n = 0 ⟶ n = 0 ∨ coprime p m
    #[12] p = 1 ∨ ¬(divides p m) ⟶ n = 0 ∨ coprime p m
  ← introduction goal=11
    #[13] n = 0
    #[14] n = 0 ∨ coprime p m
  ← apply_backward_step disjI1 goal=14
  ← introduction goal=12
    #[15] p = 1 ∨ ¬(divides p m)
    #[16] n = 0 ∨ coprime p m
  ← apply_backward_step disjE goal=16 facts=[15]
    #[17] p = 1 ⟶ n = 0 ∨ coprime p m
    #[18] ¬(divides p m) ⟶ n = 0 ∨ coprime p m
  ← introduction goal=17
    #[19] p = 1
    #[20] n = 0 ∨ coprime p m
  -> rewrite_fact prime_def sym=false goal=20 facts=[1]
    #[21] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD1 goal=20 facts=[21]
    #[22] ¬(p = 1)
  ← apply_backward_step negE_gen goal=20 facts=[22,19]
    #[23] n = 0 ∨ coprime p m
  ← introduction goal=18
    #[24] ¬(divides p m)
    #[25] n = 0 ∨ coprime p m
  ← apply_backward_step disjI2 goal=25
    #[26] coprime p m
  -> apply_forward_step prime_coprime_strong param_n=m goal=26 facts=[1]
    #[27] divides p m ∨ coprime p m
  ← apply_backward_step disjE goal=26 facts=[27]
    #[28] divides p m ⟶ coprime p m
    #[29] coprime p m ⟶ coprime p m
  ← introduction goal=28
    #[30] divides p m
    #[31] coprime p m
  ← apply_backward_step negE_gen goal=31 facts=[24,30]
    #[32] coprime p m
qed

theorem index_decomposition_le
  fixes e1 :: nat, e2 :: nat, m1 :: nat, m2 :: nat, p :: nat
  prop p ^ e1 * m1 = p ^ e2 * m2 --> ~(p = 0) --> ~(divides p m2) --> e1 <= e2
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] p ^ e1 * m1 = p ^ e2 * m2
    #[2] ¬(p = 0)
    #[3] ¬(divides p m2)
    #[4] e1 ≤ e2
  ← apply_backward_step contrapositive goal=4 facts=[3]
    #[5] ¬(e1 ≤ e2) ⟶ ¬¬(divides p m2)
  ← rewrite_goal double_neg sym=false goal=5
    #[6] ¬(e1 ≤ e2) ⟶ divides p m2
  ← introduction goal=6
    #[7] ¬(e1 ≤ e2)
    #[8] divides p m2
  -> rewrite_fact not_le sym=false goal=8 facts=[7]
    #[9] e2 < e1
  -> rewrite_fact less_exist sym=false goal=8 facts=[9]
    #[10] ∃d. e1 = e2 + Suc d
  exists_elim d goal=8 facts=[10]
    #[11] _VAR d
    #[12] e1 = e2 + Suc d
    #[13] divides p m2
  -> rewrite_fact_with_prev goal=13 facts=[12,1]
    #[14] p ^ (e2 + Suc d) * m1 = p ^ e2 * m2
  -> rewrite_fact nat_power_add sym=false goal=13 facts=[14]
    #[15] p ^ e2 * p ^ Suc d * m1 = p ^ e2 * m2
  -> rewrite_fact mult_assoc sym=false goal=13 facts=[15]
    #[16] p ^ e2 * (p ^ Suc d * m1) = p ^ e2 * m2
  -> rewrite_fact eq_mult_lcancel sym=false goal=13 facts=[16]
    #[17] p ^ e2 = 0 ∨ p ^ Suc d * m1 = m2
  ← apply_backward_step disjE goal=13 facts=[17]
    #[18] p ^ e2 = 0 ⟶ divides p m2
    #[19] p ^ Suc d * m1 = m2 ⟶ divides p m2
  ← introduction goal=18
    #[20] p ^ e2 = 0
    #[21] divides p m2
  -> rewrite_fact exp_eq_0 sym=false goal=21 facts=[20]
    #[22] p = 0 ∧ ¬(e2 = 0)
  -> apply_forward_step conjD1 goal=21 facts=[22]
    #[23] p = 0
  ← apply_backward_step negE_gen goal=21 facts=[2,23]
    #[24] divides p m2
  ← introduction goal=19
    #[25] p ^ Suc d * m1 = m2
    #[26] divides p m2
  -> rewrite_fact nat_nat_power_def_2 sym=false goal=26 facts=[25]
    #[27] p * p ^ d * m1 = m2
  -> rewrite_fact eq_sym_eq sym=false goal=26 facts=[27]
    #[28] m2 = p * p ^ d * m1
  ← rewrite_goal_with_prev goal=26 facts=[28]
    #[29] divides p (p * p ^ d * m1)
  ← rewrite_goal mult_assoc sym=false goal=29
    #[30] divides p (p * (p ^ d * m1))
  ← apply_backward_step divides_rmul goal=30
    #[31] divides p p
  ← apply_backward_step divides_self goal=31
    #[32] divides p p
qed

theorem index_decomposition_unique
  fixes e1 :: nat, e2 :: nat, m1 :: nat, m2 :: nat, p :: nat
  prop p ^ e1 * m1 = p ^ e2 * m2 --> ~(p = 0) --> ~(divides p m1) --> ~(divides p m2) --> e1 = e2
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] p ^ e1 * m1 = p ^ e2 * m2
    #[2] ¬(p = 0)
    #[3] ¬(divides p m1)
    #[4] ¬(divides p m2)
    #[5] e1 = e2
  ← rewrite_goal le_antisym sym=true goal=5
    #[6] e1 ≤ e2 ∧ e2 ≤ e1
  ← apply_backward_step conjI goal=6
    #[7] e1 ≤ e2
    #[8] e2 ≤ e1
  ← apply_backward_step index_decomposition_le goal=7 facts=[1,2,4]
    #[9] e1 ≤ e2
  -> rewrite_fact eq_sym_eq sym=false goal=8 facts=[1]
    #[10] p ^ e2 * m2 = p ^ e1 * m1
  ← apply_backward_step index_decomposition_le goal=8 facts=[10,2,3]
    #[11] e2 ≤ e1
qed

theorem index_unique
  fixes e :: nat, m :: nat, n :: nat, p :: nat
  prop p ^ e * m = n --> (p = 0 --> e = 0) --> ~(divides p m) --> index p n = e
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] p ^ e * m = n
    #[2] p = 0 ⟶ e = 0
    #[3] ¬(divides p m)
    #[4] index p n = e
  cut "!i. i = e <--> e <= i & ~(e + 1 <= i)" goal=4
    #[5] ∀i. i = e ⟷ e ≤ i ∧ ¬(e + 1 ≤ i)
  ← z3 goal=5
    #[6] ∀i. i = e ⟷ e ≤ i ∧ ¬(e + 1 ≤ i)
  ← rewrite_goal_with_prev goal=4 facts=[6]
    #[7] e ≤ index p n ∧ ¬(e + 1 ≤ index p n)
  ← apply_backward_step conjI goal=7
    #[8] e ≤ index p n
    #[9] ¬(e + 1 ≤ index p n)
  ← rewrite_goal le_index sym=false goal=8
    #[10] (n = 0 ∨ p = 1 ⟶ e = 0) ∧ divides (p ^ e) n
  -> rewrite_fact eq_sym_eq sym=false goal=10 facts=[1]
    #[11] n = p ^ e * m
  ← rewrite_goal_with_prev goal=10 facts=[11]
    #[12] (p ^ e * m = 0 ∨ p = 1 ⟶ e = 0) ∧ divides (p ^ e) (p ^ e * m)
  ← apply_backward_step conjI goal=12
    #[13] p ^ e * m = 0 ∨ p = 1 ⟶ e = 0
    #[14] divides (p ^ e) (p ^ e * m)
  ← introduction goal=13
    #[15] p ^ e * m = 0 ∨ p = 1
    #[16] e = 0
  ← apply_backward_step disjE goal=16 facts=[15]
    #[17] p ^ e * m = 0 ⟶ e = 0
    #[18] p = 1 ⟶ e = 0
  ← introduction goal=17
    #[19] p ^ e * m = 0
    #[20] e = 0
  -> rewrite_fact mult_eq_0 sym=false goal=20 facts=[19]
    #[21] p ^ e = 0 ∨ m = 0
  ← apply_backward_step disjE goal=20 facts=[21]
    #[22] p ^ e = 0 ⟶ e = 0
    #[23] m = 0 ⟶ e = 0
  ← introduction goal=22
    #[24] p ^ e = 0
    #[25] e = 0
  -> rewrite_fact exp_eq_0 sym=false goal=25 facts=[24]
    #[26] p = 0 ∧ ¬(e = 0)
  ← apply_prev goal=25 facts=[2]
    #[27] p = 0
  ← apply_backward_step conjD1 goal=27 facts=[26]
    #[28] p = 0
  ← introduction goal=23
    #[29] m = 0
    #[30] e = 0
  -> rewrite_fact_with_prev goal=30 facts=[29,3]
    #[31] ¬(divides p 0)
  ← apply_backward_step negE_gen goal=30 facts=[31]
    #[32] divides p 0
  ← apply_backward_step divides_zero goal=32
    #[33] divides p 0
  ← introduction goal=18
    #[34] p = 1
    #[35] e = 0
  -> rewrite_fact_with_prev goal=35 facts=[34,3]
    #[36] ¬(divides 1 m)
  ← apply_backward_step negE_gen goal=35 facts=[36]
    #[37] divides 1 m
  ← apply_backward_step divides_1 goal=37
    #[38] divides 1 m
  ← apply_backward_step divides_rmul goal=14
    #[39] divides (p ^ e) (p ^ e)
  ← apply_backward_step divides_self goal=39
    #[40] divides (p ^ e) (p ^ e)
  ← rewrite_goal le_index sym=false goal=9
    #[41] ¬((n = 0 ∨ p = 1 ⟶ e + 1 = 0) ∧ divides (p ^ (e + 1)) n)
  ← rewrite_goal de_morgan_thm1 sym=false goal=41
    #[42] ¬(n = 0 ∨ p = 1 ⟶ e + 1 = 0) ∨ ¬(divides (p ^ (e + 1)) n)
  ← apply_backward_step disjI2 goal=42
    #[43] ¬(divides (p ^ (e + 1)) n)
  ← rewrite_goal nat_power_add sym=false goal=43
    #[44] ¬(divides (p ^ e * p ^ (1::nat)) n)
  ← rewrite_goal exp_1 sym=false goal=44
    #[45] ¬(divides (p ^ e * p) n)
  ← apply_backward_step contrapositive goal=45 facts=[3]
    #[46] ¬¬(divides (p ^ e * p) n) ⟶ ¬¬(divides p m)
  ← rewrite_goal double_neg sym=false goal=46
    #[47] divides (p ^ e * p) n ⟶ divides p m
  ← introduction goal=47
    #[48] divides (p ^ e * p) n
    #[49] divides p m
  -> rewrite_fact_with_prev goal=49 facts=[11,48]
    #[50] divides (p ^ e * p) (p ^ e * m)
  ← apply_backward_step divides_cmul2 goal=49 facts=[50]
    #[51] ¬(p ^ e = 0)
  ← rewrite_goal exp_eq_0 sym=false goal=51
    #[52] ¬(p = 0 ∧ ¬(e = 0))
  ← rewrite_goal de_morgan_thm1 sym=false goal=52
    #[53] ¬(p = 0) ∨ ¬¬(e = 0)
  ← cases "p=0" goal=53
    #[54] p = 0 ⟶ ¬(p = 0) ∨ ¬¬(e = 0)
    #[55] ¬(p = 0) ⟶ ¬(p = 0) ∨ ¬¬(e = 0)
  ← introduction goal=54
    #[56] p = 0
    #[57] ¬(p = 0) ∨ ¬¬(e = 0)
  ← apply_backward_step disjI2 goal=57
    #[58] ¬¬(e = 0)
  ← rewrite_goal double_neg sym=false goal=58
    #[59] e = 0
  ← apply_prev goal=59 facts=[2]
  ← introduction goal=55
    #[60] ¬(p = 0)
    #[61] ¬(p = 0) ∨ ¬¬(e = 0)
  ← apply_backward_step disjI1 goal=61
qed

theorem index_unique_eq
  fixes k :: nat, n :: nat, p :: nat
  prop index p n = k <--> (if p = 1 | n = 0 then k = 0 else !j. divides (p ^ j) n <--> j <= k)
  [hint_rewrite]
proof
  ← cases "p = 1 ∨ n = 0" goal=0
    #[1] p = 1 ∨ n = 0 ⟶ index p n = k ⟷ (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k)
    #[2] ¬(p = 1 ∨ n = 0) ⟶ index p n = k ⟷ (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k)
  ← introduction goal=1
    #[3] p = 1 ∨ n = 0
    #[4] index p n = k ⟷ (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k)
  ← rewrite_goal if_P sym=false goal=4 facts=[3]
    #[5] index p n = k ⟷ k = 0
  ← rewrite_goal index_def sym=false goal=5
    #[6] (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) = k ⟷ k = 0
  cut "p ≤ 1 ∨ n = 0" goal=6
    #[7] p ≤ 1 ∨ n = 0
  ← z3 goal=7 facts=[3]
  ← rewrite_goal if_P sym=false goal=6 facts=[7]
    #[8] 0 = k ⟷ k = 0
  ← z3 goal=8
    #[9] 0 = k ⟷ k = 0
  ← introduction goal=2
    #[10] ¬(p = 1 ∨ n = 0)
    #[11] index p n = k ⟷ (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k)
  ← rewrite_goal if_not_P sym=false goal=11 facts=[10]
    #[12] index p n = k ⟷ (∀j. divides (p ^ j) n ⟷ j ≤ k)
  ← rewrite_goal primepow_divides_index sym=false goal=12
    #[13] index p n = k ⟷ (∀j. n = 0 ∨ p = 1 ∨ j ≤ index p n ⟷ j ≤ k)
  -> rewrite_fact disj_comm sym=false goal=13 facts=[10]
    #[14] ¬(n = 0 ∨ p = 1)
  ← apply_backward_step iffI goal=13
    #[15] index p n = k ⟶ (∀j. n = 0 ∨ p = 1 ∨ j ≤ index p n ⟷ j ≤ k)
    #[16] (∀j. n = 0 ∨ p = 1 ∨ j ≤ index p n ⟷ j ≤ k) ⟶ index p n = k
  ← introduction goal=15
    #[17] index p n = k
    #[18] ∀j. n = 0 ∨ p = 1 ∨ j ≤ index p n ⟷ j ≤ k
  ← rewrite_goal_with_prev goal=18 facts=[17]
    #[19] ∀j. n = 0 ∨ p = 1 ∨ j ≤ k ⟷ j ≤ k
  ← introduction j goal=19
    #[20] _VAR j
    #[21] n = 0 ∨ p = 1 ∨ j ≤ k ⟷ j ≤ k
  ← apply_backward_step iffI goal=21
    #[22] n = 0 ∨ p = 1 ∨ j ≤ k ⟶ j ≤ k
    #[23] j ≤ k ⟶ n = 0 ∨ p = 1 ∨ j ≤ k
  ← introduction goal=22
    #[24] n = 0 ∨ p = 1 ∨ j ≤ k
    #[25] j ≤ k
  -> apply_forward_step disj_assoc goal=25 facts=[24]
    #[26] (n = 0 ∨ p = 1) ∨ j ≤ k
  ← apply_backward_step disjE goal=25 facts=[26]
    #[27] n = 0 ∨ p = 1 ⟶ j ≤ k
    #[28] j ≤ k ⟶ j ≤ k
  ← introduction goal=27
    #[29] n = 0 ∨ p = 1
    #[30] j ≤ k
  ← apply_backward_step negE_gen goal=30 facts=[14,29]
    #[31] j ≤ k
  ← introduction goal=23
    #[32] j ≤ k
    #[33] n = 0 ∨ p = 1 ∨ j ≤ k
  ← apply_backward_step disjI2 goal=33
    #[34] p = 1 ∨ j ≤ k
  ← apply_backward_step disjI2 goal=34
  ← introduction goal=16
    #[35] ∀j. n = 0 ∨ p = 1 ∨ j ≤ index p n ⟷ j ≤ k
    #[36] index p n = k
  ← rewrite_goal le_antisym sym=true goal=36
    #[37] index p n ≤ k ∧ k ≤ index p n
  -> rewrite_fact eq_sym_eq sym=false goal=37 facts=[35]
    #[38] ∀j. j ≤ k ⟷ n = 0 ∨ p = 1 ∨ j ≤ index p n
  ← apply_backward_step conjI goal=37
    #[39] index p n ≤ k
    #[40] k ≤ index p n
  ← rewrite_goal_with_prev goal=39 facts=[38]
    #[41] n = 0 ∨ p = 1 ∨ index p n ≤ index p n
  ← apply_backward_step disjI2 goal=41
    #[42] p = 1 ∨ index p n ≤ index p n
  ← apply_backward_step disjI2 goal=42
    #[43] index p n ≤ index p n
  ← apply_backward_step less_eq_refl goal=43
    #[44] index p n ≤ index p n
  cut "k <= k" goal=40
    #[45] k ≤ k
  ← apply_backward_step less_eq_refl goal=45
    #[46] k ≤ k
  -> rewrite_fact_with_prev goal=40 facts=[38,46]
    #[47] n = 0 ∨ p = 1 ∨ k ≤ index p n
  -> apply_forward_step disj_assoc goal=40 facts=[47]
    #[48] (n = 0 ∨ p = 1) ∨ k ≤ index p n
  ← apply_backward_step disjE goal=40 facts=[48]
    #[49] n = 0 ∨ p = 1 ⟶ k ≤ index p n
    #[50] k ≤ index p n ⟶ k ≤ index p n
  ← introduction goal=49
    #[51] k ≤ index p n
  ← apply_backward_step negE_gen goal=51 facts=[14,29]
    #[52] k ≤ index p n
qed

theorem index_unique_alt
  fixes k :: nat, n :: nat, p :: nat
  prop index p n = k <--> (if p = 1 | n = 0 then k = 0 else divides (p ^ k) n & ~(divides (p ^ (k + 1)) n))
  [hint_rewrite]
proof
  ← rewrite_goal index_unique_eq sym=false goal=0
    #[1] (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k) ⟷ (if p = 1 ∨ n = 0 then k = 0 else divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n))
  ← cases "p = 1 ∨ n = 0" goal=1
    #[2] p = 1 ∨ n = 0 ⟶ (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k) ⟷ (if p = 1 ∨ n = 0 then k = 0 else divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n))
    #[3] ¬(p = 1 ∨ n = 0) ⟶ (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k) ⟷ (if p = 1 ∨ n = 0 then k = 0 else divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n))
  ← introduction goal=2
    #[4] p = 1 ∨ n = 0
    #[5] (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k) ⟷ (if p = 1 ∨ n = 0 then k = 0 else divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n))
  ← rewrite_goal if_P sym=false goal=5 facts=[4]
  ← introduction goal=3
    #[6] ¬(p = 1 ∨ n = 0)
    #[7] (if p = 1 ∨ n = 0 then k = 0 else ∀j. divides (p ^ j) n ⟷ j ≤ k) ⟷ (if p = 1 ∨ n = 0 then k = 0 else divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n))
  ← rewrite_goal if_not_P sym=false goal=7 facts=[6]
    #[8] (∀j. divides (p ^ j) n ⟷ j ≤ k) ⟷ divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n)
  ← apply_backward_step iffI goal=8
    #[9] (∀j. divides (p ^ j) n ⟷ j ≤ k) ⟶ divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n)
    #[10] divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n) ⟶ (∀j. divides (p ^ j) n ⟷ j ≤ k)
  ← introduction goal=9
    #[11] ∀j. divides (p ^ j) n ⟷ j ≤ k
    #[12] divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n)
  ← apply_backward_step conjI goal=12
    #[13] divides (p ^ k) n
    #[14] ¬(divides (p ^ (k + 1)) n)
  ← rewrite_goal_with_prev goal=13 facts=[11]
    #[15] k ≤ k
  ← apply_backward_step less_eq_refl goal=15
    #[16] k ≤ k
  ← rewrite_goal_with_prev goal=14 facts=[11]
    #[17] ¬(k + 1 ≤ k)
  ← z3 goal=17
    #[18] ¬(k + 1 ≤ k)
  ← introduction goal=10
    #[19] divides (p ^ k) n ∧ ¬(divides (p ^ (k + 1)) n)
    #[20] ∀j. divides (p ^ j) n ⟷ j ≤ k
  -> apply_forward_step conjD1 goal=20 facts=[19]
    #[21] divides (p ^ k) n
  -> apply_forward_step conjD2 goal=20 facts=[19]
    #[22] ¬(divides (p ^ (k + 1)) n)
  ← introduction j goal=20
    #[23] _VAR j
    #[24] divides (p ^ j) n ⟷ j ≤ k
  ← apply_backward_step iffI goal=24
    #[25] divides (p ^ j) n ⟶ j ≤ k
    #[26] j ≤ k ⟶ divides (p ^ j) n
  ← introduction goal=25
    #[27] divides (p ^ j) n
    #[28] j ≤ k
  ← rewrite_goal not_lt sym=true goal=28
    #[29] ¬(k < j)
  ← apply_backward_step contrapositive goal=29 facts=[22]
    #[30] ¬¬(k < j) ⟶ ¬¬(divides (p ^ (k + 1)) n)
  ← rewrite_goal double_neg sym=false goal=30
    #[31] k < j ⟶ divides (p ^ (k + 1)) n
  ← introduction goal=31
    #[32] k < j
    #[33] divides (p ^ (k + 1)) n
  ← apply_backward_step divides_trans param_m="(p ^ j)" goal=33
    #[34] divides (p ^ (k + 1)) (p ^ j)
  ← apply_backward_step divides_exp_le_imp goal=34
    #[35] k + 1 ≤ j
  ← z3 goal=35 facts=[32]
    #[36] k + 1 ≤ j
  ← introduction goal=26
    #[37] j ≤ k
    #[38] divides (p ^ j) n
  ← apply_backward_step divides_trans param_m="(p ^ k)" goal=38
    #[39] divides (p ^ j) (p ^ k)
  ← apply_backward_step divides_exp_le_imp goal=39
qed

theorem index_add_min
  fixes m :: nat, n :: nat, p :: nat
  prop min (index p m) (index p n) <= index p (m + n)
  [hint_backward]
proof
  ← cases "p=1" goal=0
    #[1] p = 1 ⟶ min (index p m) (index p n) ≤ index p (m + n)
    #[2] ¬(p = 1) ⟶ min (index p m) (index p n) ≤ index p (m + n)
  ← introduction goal=1
    #[3] p = 1
    #[4] min (index p m) (index p n) ≤ index p (m + n)
  ← rewrite_goal index_def sym=false goal=4
    #[5] min (if p ≤ 1 ∨ m = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) m})) (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ (if p ≤ 1 ∨ m + n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) (m + n)}))
  cut "!m::nat. p ≤ 1 ∨ m = 0" goal=5
    #[6] ∀m::nat. p ≤ 1 ∨ m = 0
  ← introduction a goal=6
    #[7] _VAR a
    #[8] p ≤ 1 ∨ a = 0
  ← apply_backward_step disjI1 goal=8
    #[9] p ≤ 1
  ← rewrite_goal le_lt sym=false goal=9
    #[10] p < 1 ∨ p = 1
  ← apply_backward_step disjI2 goal=10
  -> forall_elim m goal=5 facts=[6]
    #[11] p ≤ 1 ∨ m = 0
  -> forall_elim n goal=5 facts=[6]
    #[12] p ≤ 1 ∨ n = 0
  -> forall_elim m+n goal=12 facts=[6]
    #[13] p ≤ 1 ∨ m + n = 0
  ← rewrite_goal if_P sym=false goal=5 facts=[11]
    #[14] min 0 (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ (if p ≤ 1 ∨ m + n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) (m + n)}))
  ← rewrite_goal if_P sym=false goal=14 facts=[13]
    #[15] min 0 (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ 0
  ← rewrite_goal if_P sym=false goal=15 facts=[12]
    #[16] min (0::nat) 0 ≤ 0
  ← rewrite_goal nat_less_eq_def_1 sym=false goal=16
    #[17] min (0::nat) 0 = 0
  ← rewrite_goal min_def sym=false goal=17
    #[18] (if (0::nat) ≤ 0 then (0::nat) else 0) = 0
  ← z3 goal=18
    #[19] (if (0::nat) ≤ 0 then (0::nat) else 0) = 0
  ← introduction goal=2
    #[20] ¬(p = 1)
    #[21] min (index p m) (index p n) ≤ index p (m + n)
  ← rewrite_goal le_index sym=false goal=21
    #[22] (m + n = 0 ∨ p = 1 ⟶ min (index p m) (index p n) = 0) ∧ divides (p ^ min (index p m) (index p n)) (m + n)
  ← apply_backward_step conjI goal=22
    #[23] m + n = 0 ∨ p = 1 ⟶ min (index p m) (index p n) = 0
    #[24] divides (p ^ min (index p m) (index p n)) (m + n)
  cut "!a::nat. !b. min a b = 0 <--> a = 0 | b = 0" goal=23
    #[25] ∀a::nat. ∀b. min a b = 0 ⟷ a = 0 ∨ b = 0
  ← z3 goal=25
    #[26] ∀a::nat. ∀b. min a b = 0 ⟷ a = 0 ∨ b = 0
  ← rewrite_goal_with_prev goal=23 facts=[26]
    #[27] m + n = 0 ∨ p = 1 ⟶ index p m = 0 ∨ index p n = 0
  ← rewrite_goal index_eq_0 sym=false goal=27
    #[28] m + n = 0 ∨ p = 1 ⟶ (m = 0 ∨ p = 1 ∨ ¬(divides p m)) ∨ n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← introduction goal=28
    #[29] m + n = 0 ∨ p = 1
    #[30] (m = 0 ∨ p = 1 ∨ ¬(divides p m)) ∨ n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjE goal=30 facts=[29]
    #[31] m + n = 0 ⟶ (m = 0 ∨ p = 1 ∨ ¬(divides p m)) ∨ n = 0 ∨ p = 1 ∨ ¬(divides p n)
    #[32] p = 1 ⟶ (m = 0 ∨ p = 1 ∨ ¬(divides p m)) ∨ n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← introduction goal=31
    #[33] m + n = 0
    #[34] (m = 0 ∨ p = 1 ∨ ¬(divides p m)) ∨ n = 0 ∨ p = 1 ∨ ¬(divides p n)
  -> apply_forward_step add_is_zero goal=34 facts=[33]
    #[35] m = 0 ∧ n = 0
  ← apply_backward_step disjI1 goal=34
    #[36] m = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← apply_backward_step disjI1 goal=36
    #[37] m = 0
  ← apply_backward_step conjD1 goal=37 facts=[35]
    #[38] m = 0
  ← introduction goal=32
    #[39] (m = 0 ∨ p = 1 ∨ ¬(divides p m)) ∨ n = 0 ∨ p = 1 ∨ ¬(divides p n)
  ← apply_backward_step disjI1 goal=39
    #[40] m = 0 ∨ p = 1 ∨ ¬(divides p m)
  ← apply_backward_step disjI2 goal=40
    #[41] p = 1 ∨ ¬(divides p m)
  ← apply_backward_step disjI1 goal=41
  ← apply_backward_step divides_sum goal=24
    #[42] divides (p ^ min (index p m) (index p n)) m
    #[43] divides (p ^ min (index p m) (index p n)) n
  ← apply_backward_step divides_trans param_m="p ^ (index p m)" goal=42
    #[44] divides (p ^ min (index p m) (index p n)) (p ^ index p m)
    #[45] divides (p ^ index p m) m
  ← apply_backward_step divides_exp_le_imp goal=44
    #[46] min (index p m) (index p n) ≤ index p m
  ← rewrite_goal min_def sym=false goal=46
    #[47] (if index p m ≤ index p n then index p m else index p n) ≤ index p m
  ← cases "index p m ≤ index p n" goal=47
    #[48] index p m ≤ index p n ⟶ (if index p m ≤ index p n then index p m else index p n) ≤ index p m
    #[49] ¬(index p m ≤ index p n) ⟶ (if index p m ≤ index p n then index p m else index p n) ≤ index p m
  ← introduction goal=48
    #[50] index p m ≤ index p n
    #[51] (if index p m ≤ index p n then index p m else index p n) ≤ index p m
  ← rewrite_goal if_P sym=false goal=51 facts=[50]
    #[52] index p m ≤ index p m
  ← apply_backward_step less_eq_refl goal=52
    #[53] index p m ≤ index p m
  ← introduction goal=49
    #[54] ¬(index p m ≤ index p n)
    #[55] (if index p m ≤ index p n then index p m else index p n) ≤ index p m
  ← rewrite_goal if_not_P sym=false goal=55 facts=[54]
    #[56] index p n ≤ index p m
  -> rewrite_fact not_le sym=false goal=56 facts=[54]
    #[57] index p n < index p m
  ← apply_backward_step lt_imp_le goal=56
  ← apply_backward_step exp_index_divides goal=45
    #[58] divides (p ^ index p m) m
  ← apply_backward_step divides_trans param_m="p ^ index p n" goal=43
    #[59] divides (p ^ min (index p m) (index p n)) (p ^ index p n)
    #[60] divides (p ^ index p n) n
  ← apply_backward_step divides_exp_le_imp goal=59
    #[61] min (index p m) (index p n) ≤ index p n
  ← rewrite_goal min_def sym=false goal=61
    #[62] (if index p m ≤ index p n then index p m else index p n) ≤ index p n
  ← cases "index p m ≤ index p n" goal=62
    #[63] index p m ≤ index p n ⟶ (if index p m ≤ index p n then index p m else index p n) ≤ index p n
    #[64] ¬(index p m ≤ index p n) ⟶ (if index p m ≤ index p n then index p m else index p n) ≤ index p n
  ← introduction goal=63
    #[65] (if index p m ≤ index p n then index p m else index p n) ≤ index p n
  ← rewrite_goal if_P sym=false goal=65 facts=[50]
  ← introduction goal=64
    #[66] (if index p m ≤ index p n then index p m else index p n) ≤ index p n
  ← rewrite_goal if_not_P sym=false goal=66 facts=[54]
    #[67] index p n ≤ index p n
  ← apply_backward_step less_eq_refl goal=67
    #[68] index p n ≤ index p n
  ← apply_backward_step exp_index_divides goal=60
    #[69] divides (p ^ index p n) n
qed

theorem index_sub_min
  fixes m :: nat, n :: nat, p :: nat
  prop n < m --> min (index p m) (index p n) <= index p (m - n)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] n < m
    #[2] min (index p m) (index p n) ≤ index p (m - n)
  ← cases "p = 1" goal=2
    #[3] p = 1 ⟶ min (index p m) (index p n) ≤ index p (m - n)
    #[4] ¬(p = 1) ⟶ min (index p m) (index p n) ≤ index p (m - n)
  ← introduction goal=3
    #[5] p = 1
    #[6] min (index p m) (index p n) ≤ index p (m - n)
  ← rewrite_goal index_def sym=false goal=6
    #[7] min (if p ≤ 1 ∨ m = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) m})) (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ (if p ≤ 1 ∨ m - n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) (m - n)}))
  cut "!a::nat. p <= 1 | a = 0" goal=7
    #[8] ∀a::nat. p ≤ 1 ∨ a = 0
  ← introduction a goal=8
    #[9] _VAR a
    #[10] p ≤ 1 ∨ a = 0
  ← apply_backward_step disjI1 goal=10
    #[11] p ≤ 1
  ← rewrite_goal le_lt sym=false goal=11
    #[12] p < 1 ∨ p = 1
  ← apply_backward_step disjI2 goal=12
  -> forall_elim m goal=7 facts=[8]
    #[13] p ≤ 1 ∨ m = 0
  -> forall_elim n goal=7 facts=[8]
    #[14] p ≤ 1 ∨ n = 0
  -> forall_elim m-n goal=7 facts=[8]
    #[15] p ≤ 1 ∨ m - n = 0
  ← rewrite_goal if_P sym=false goal=7 facts=[13]
    #[16] min 0 (if p ≤ 1 ∨ n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) n})) ≤ (if p ≤ 1 ∨ m - n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) (m - n)}))
  ← rewrite_goal if_P sym=false goal=16 facts=[14]
    #[17] min 0 0 ≤ (if p ≤ 1 ∨ m - n = 0 then 0 else card ({j::nat. 1 ≤ j ∧ divides (p ^ j) (m - n)}))
  ← rewrite_goal if_P sym=false goal=17 facts=[15]
    #[18] min (0::nat) 0 ≤ 0
  ← z3 goal=18
    #[19] min (0::nat) 0 ≤ 0
  ← introduction goal=4
    #[20] ¬(p = 1)
    #[21] min (index p m) (index p n) ≤ index p (m - n)
  ← rewrite_goal le_index sym=false goal=21
    #[22] (m - n = 0 ∨ p = 1 ⟶ min (index p m) (index p n) = 0) ∧ divides (p ^ min (index p m) (index p n)) (m - n)
  ← rewrite_goal sub_eq_0 sym=false goal=22
    #[23] (m ≤ n ∨ p = 1 ⟶ min (index p m) (index p n) = 0) ∧ divides (p ^ min (index p m) (index p n)) (m - n)
  ← apply_backward_step conjI goal=23
    #[24] m ≤ n ∨ p = 1 ⟶ min (index p m) (index p n) = 0
    #[25] divides (p ^ min (index p m) (index p n)) (m - n)
  ← introduction goal=24
    #[26] m ≤ n ∨ p = 1
    #[27] min (index p m) (index p n) = 0
  ← apply_backward_step disjE goal=27 facts=[26]
    #[28] m ≤ n ⟶ min (index p m) (index p n) = 0
    #[29] p = 1 ⟶ min (index p m) (index p n) = 0
  ← introduction goal=28
    #[30] m ≤ n
    #[31] min (index p m) (index p n) = 0
  -> rewrite_fact not_lt sym=true goal=31 facts=[30]
    #[32] ¬(n < m)
  ← apply_backward_step negE_gen goal=31 facts=[32,1]
    #[33] min (index p m) (index p n) = 0
  ← introduction goal=29
    #[34] min (index p m) (index p n) = 0
  ← apply_backward_step negE_gen goal=34 facts=[20,5]
    #[35] min (index p m) (index p n) = 0
  ← apply_backward_step divides_sub goal=25
    #[36] divides (p ^ min (index p m) (index p n)) m
    #[37] divides (p ^ min (index p m) (index p n)) n
  ← apply_backward_step divides_trans param_m="p ^ (index p m)" goal=36
    #[38] divides (p ^ min (index p m) (index p n)) (p ^ index p m)
    #[39] divides (p ^ index p m) m
  ← apply_backward_step divides_exp_le_imp goal=38
    #[40] min (index p m) (index p n) ≤ index p m
  ← rewrite_goal min_def sym=false goal=40
    #[41] (if index p m ≤ index p n then index p m else index p n) ≤ index p m
  ← cases "index p m ≤ index p n" goal=41
    #[42] index p m ≤ index p n ⟶ (if index p m ≤ index p n then index p m else index p n) ≤ index p m
    #[43] ¬(index p m ≤ index p n) ⟶ (if index p m ≤ index p n then index p m else index p n) ≤ index p m
  ← introduction goal=42
    #[44] index p m ≤ index p n
    #[45] (if index p m ≤ index p n then index p m else index p n) ≤ index p m
  ← rewrite_goal if_P sym=false goal=45 facts=[44]
    #[46] index p m ≤ index p m
  ← apply_backward_step less_eq_refl goal=46
    #[47] index p m ≤ index p m
  ← introduction goal=43
    #[48] ¬(index p m ≤ index p n)
    #[49] (if index p m ≤ index p n then index p m else index p n) ≤ index p m
  ← rewrite_goal if_not_P sym=false goal=49 facts=[48]
    #[50] index p n ≤ index p m
  -> rewrite_fact not_le sym=false goal=50 facts=[48]
    #[51] index p n < index p m
  ← apply_backward_step lt_imp_le goal=50
  ← apply_backward_step exp_index_divides goal=39
    #[52] divides (p ^ index p m) m
  ← apply_backward_step divides_trans param_m="p ^ (index p n)" goal=37
    #[53] divides (p ^ min (index p m) (index p n)) (p ^ index p n)
    #[54] divides (p ^ index p n) n
  ← apply_backward_step divides_exp_le_imp goal=53
    #[55] min (index p m) (index p n) ≤ index p n
  ← rewrite_goal min_def sym=false goal=55
    #[56] (if index p m ≤ index p n then index p m else index p n) ≤ index p n
  ← cases "index p m ≤ index p n" goal=56
    #[57] index p m ≤ index p n ⟶ (if index p m ≤ index p n then index p m else index p n) ≤ index p n
    #[58] ¬(index p m ≤ index p n) ⟶ (if index p m ≤ index p n then index p m else index p n) ≤ index p n
  ← introduction goal=57
    #[59] (if index p m ≤ index p n then index p m else index p n) ≤ index p n
  ← rewrite_goal if_P sym=false goal=59 facts=[44]
  ← introduction goal=58
    #[60] (if index p m ≤ index p n then index p m else index p n) ≤ index p n
  ← rewrite_goal if_not_P sym=false goal=60 facts=[48]
    #[61] index p n ≤ index p n
  ← apply_backward_step less_eq_refl goal=61
    #[62] index p n ≤ index p n
  ← apply_backward_step exp_index_divides goal=54
    #[63] divides (p ^ index p n) n
qed

theorem index_nsum_le
  fixes f :: 'a => nat, k :: 'a set, n :: nat, p :: nat
  prop finite k --> ~(k = {}) --> (!a. a Mem k --> n <= index p (f a)) --> n <= index p (nsum k f)
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] finite k
    #[2] ¬(k = ∅)
    #[3] ∀a. a ∈ k ⟶ n ≤ index p (f a)
    #[4] n ≤ index p (nsum k f)
  -> apply_forward_step nsum_closed_nonempty param_P="(%m. n <= index p m)" param_f=f goal=4 facts=[1,2]
    #[5] (∀x. ∀y. n ≤ index p x ⟶ n ≤ index p y ⟶ n ≤ index p (x + y)) ⟶ (∀a. a ∈ k ⟶ n ≤ index p (f a)) ⟶ n ≤ index p (nsum k f)
  ← apply_prev goal=4 facts=[5]
    #[6] ∀x. ∀y. n ≤ index p x ⟶ n ≤ index p y ⟶ n ≤ index p (x + y)
  ← introduction x,y goal=6
    #[7] _VAR x
    #[8] _VAR y
    #[9] n ≤ index p x
    #[10] n ≤ index p y
    #[11] n ≤ index p (x + y)
  ← apply_backward_step less_eq_trans param_m="min (index p x) (index p y)" goal=11
    #[12] n ≤ min (index p x) (index p y)
    #[13] min (index p x) (index p y) ≤ index p (x + y)
  ← rewrite_goal min_def sym=false goal=12
    #[14] n ≤ (if index p x ≤ index p y then index p x else index p y)
  ← cases "index p x ≤ index p y" goal=14
    #[15] index p x ≤ index p y ⟶ n ≤ (if index p x ≤ index p y then index p x else index p y)
    #[16] ¬(index p x ≤ index p y) ⟶ n ≤ (if index p x ≤ index p y then index p x else index p y)
  ← introduction goal=15
    #[17] index p x ≤ index p y
    #[18] n ≤ (if index p x ≤ index p y then index p x else index p y)
  ← rewrite_goal if_P sym=false goal=18 facts=[17]
  ← introduction goal=16
    #[19] ¬(index p x ≤ index p y)
    #[20] n ≤ (if index p x ≤ index p y then index p x else index p y)
  ← rewrite_goal if_not_P sym=false goal=20 facts=[19]
  ← apply_backward_step index_add_min goal=13
    #[21] min (index p x) (index p y) ≤ index p (x + y)
qed

theorem divides_index
  fixes m :: nat, n :: nat
  prop divides m n <--> n = 0 | ~(m = 0) & (!p. prime p --> index p m <= index p n)
  [hint_rewrite]
proof
  ← cases "n=0" goal=0
    #[1] n = 0 ⟶ divides m n ⟷ n = 0 ∨ ¬(m = 0) ∧ (∀p. prime p ⟶ index p m ≤ index p n)
    #[2] ¬(n = 0) ⟶ divides m n ⟷ n = 0 ∨ ¬(m = 0) ∧ (∀p. prime p ⟶ index p m ≤ index p n)
  ← introduction goal=1
    #[3] n = 0
    #[4] divides m n ⟷ n = 0 ∨ ¬(m = 0) ∧ (∀p. prime p ⟶ index p m ≤ index p n)
