    #[76] divides (1 ^ k) n
  ← rewrite_goal exp_one sym=false goal=76
    #[77] divides 1 n
  ← apply_backward_step divides_1 goal=77
  ← introduction goal=66
    #[78] ¬(p = 1)
    #[79] divides (p ^ k) n ⟷ n = 0 ∨ p = 1 ∨ k ≤ index p n
  cut "2 <= p" goal=79
    #[80] 2 ≤ p
  ← z3 goal=80 facts=[78,63]
    #[81] 2 ≤ p
  -> apply_forward_step factorization_index param_n=n param_p=p goal=79
    #[82] ¬(n = 0) ⟶ 2 ≤ p ⟶ (∃k::nat. divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n)))
  -> apply_fact goal=79 facts=[82,15]
