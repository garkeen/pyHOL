  ← apply_backward_step contrapositive goal=71 facts=[79]
    #[80] ¬¬(divides p q) ⟶ ¬¬(divides (p ^ a * p) (p ^ a * q))
  ← rewrite_goal double_neg sym=false goal=80
    #[81] divides p q ⟶ divides (p ^ a * p) (p ^ a * q)
  ← introduction goal=81
    #[82] divides p q
    #[83] divides (p ^ a * p) (p ^ a * q)
  ← apply_backward_step divides_mult_left goal=83 facts=[82]
    #[84] divides (p ^ a * p) (p ^ a * q)
  -> forall_elim b+1 goal=72 facts=[40]
    #[85] b < b + 1 ⟶ ¬(divides (p ^ (b + 1)) n)
  cut "b < b + 1" goal=72
    #[86] b < b + 1
  ← z3 goal=86
    #[87] b < b + 1
  -> apply_fact goal=72 facts=[85,87]
    #[88] ¬(divides (p ^ (b + 1)) n)
  -> rewrite_fact nat_power_add sym=false goal=72 facts=[88]
    #[89] ¬(divides (p ^ b * p ^ (1::nat)) n)
  -> rewrite_fact exp_1 sym=false goal=72 facts=[89]
    #[90] ¬(divides (p ^ b * p) n)
  ← apply_backward_step contrapositive goal=72 facts=[90]
    #[91] ¬¬(divides p r) ⟶ ¬¬(divides (p ^ b * p) n)
