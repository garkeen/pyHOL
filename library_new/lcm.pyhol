theory lcm
imports prime
description "Least common multiples."

def lcm :: nat ⇒ nat ⇒ nat = lcm m n = (if m * n = 0 then 0 else m * n DIV gcd m n) [hint_rewrite]

theorem lcm_divides
  fixes d :: nat, m :: nat, n :: nat
  prop divides (lcm m n) d <--> divides m d & divides n d
  [hint_rewrite]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] divides (if m * n = 0 then 0 else m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
  ← cases "m * n = 0" goal=1
    #[2] m * n = 0 ⟶ divides (if m * n = 0 then 0 else m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
    #[3] ¬(m * n = 0) ⟶ divides (if m * n = 0 then 0 else m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
  ← introduction goal=2
    #[4] m * n = 0
    #[5] divides (if m * n = 0 then 0 else m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
  ← rewrite_goal if_P sym=false goal=5 facts=[4]
    #[6] divides 0 d ⟷ divides m d ∧ divides n d
  ← apply_backward_step iffI goal=6
    #[7] divides 0 d ⟶ divides m d ∧ divides n d
    #[8] divides m d ∧ divides n d ⟶ divides 0 d
  ← introduction goal=7
    #[9] divides 0 d
    #[10] divides m d ∧ divides n d
  -> rewrite_fact divides_0 sym=false goal=10 facts=[9]
    #[11] d = 0
  ← rewrite_goal_with_prev goal=10 facts=[11]
    #[12] divides m 0 ∧ divides n 0
  ← apply_backward_step conjI goal=12
    #[13] divides m 0
    #[14] divides n 0
  ← apply_backward_step divides_zero goal=13
    #[15] divides m 0
  ← apply_backward_step divides_zero goal=14
    #[16] divides n 0
  ← introduction goal=8
    #[17] divides m d ∧ divides n d
    #[18] divides 0 d
  ← rewrite_goal divides_0 sym=false goal=18
    #[19] d = 0
  -> apply_forward_step conjD1 goal=19 facts=[17]
    #[20] divides m d
  -> apply_forward_step conjD2 goal=19 facts=[17]
    #[21] divides n d
  -> rewrite_fact mult_eq_0 sym=false goal=19 facts=[4]
    #[22] m = 0 ∨ n = 0
  ← apply_backward_step disjE goal=19 facts=[22]
    #[23] m = 0 ⟶ d = 0
    #[24] n = 0 ⟶ d = 0
  ← introduction goal=23
    #[25] m = 0
    #[26] d = 0
  -> rewrite_fact_with_prev goal=26 facts=[25,20]
    #[27] divides 0 d
  -> rewrite_fact divides_0 sym=false goal=26 facts=[27]
    #[28] d = 0
  ← introduction goal=24
    #[29] n = 0
    #[30] d = 0
  -> rewrite_fact_with_prev goal=30 facts=[29,21]
    #[31] divides 0 d
  -> rewrite_fact divides_0 sym=false goal=30 facts=[31]
    #[32] d = 0
  ← introduction goal=3
    #[33] ¬(m * n = 0)
    #[34] divides (if m * n = 0 then 0 else m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
  ← rewrite_goal if_not_P sym=false goal=34 facts=[33]
    #[35] divides (m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
  -> apply_forward_step gcd_divides2 param_m=m param_n=n goal=35
    #[36] divides (gcd m n) n
  -> rewrite_fact divides_def sym=false goal=35 facts=[36]
    #[37] ∃k. n = gcd m n * k
  exists_elim k1 goal=35 facts=[37]
    #[38] _VAR k1
    #[39] n = gcd m n * k1
    #[40] divides (m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
    #[41] divides (if m * n = 0 then 0 else m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
  cut "m * n DIV gcd m n = m * k1" goal=40
    #[42] m * n DIV gcd m n = m * k1
  ← apply_backward_step div_uniq param_r="(0::nat)" goal=42
    #[43] m * n = m * k1 * gcd m n + 0
    #[44] 0 < gcd m n
  ← rewrite_goal add_0_right sym=false goal=43
    #[45] m * n = m * k1 * gcd m n
  ← rewrite_goal mult_assoc sym=false goal=45
    #[46] m * n = m * (k1 * gcd m n)
  ← rewrite_goal eq_mult_lcancel sym=false goal=46
    #[47] m = 0 ∨ n = k1 * gcd m n
  ← apply_backward_step disjI2 goal=47
    #[48] n = k1 * gcd m n
  ← rewrite_goal mult_comm sym=false goal=48
  ← apply_backward_step le_1_1 goal=44
    #[49] ¬(gcd m n = 0)
  ← rewrite_goal gcd_zero sym=false goal=49
    #[50] ¬(m = 0 ∧ n = 0)
  ← apply_backward_step contrapositive goal=50 facts=[33]
    #[51] ¬¬(m = 0 ∧ n = 0) ⟶ ¬¬(m * n = 0)
  ← rewrite_goal double_neg sym=false goal=51
    #[52] m = 0 ∧ n = 0 ⟶ m * n = 0
  ← z3 goal=52
    #[53] m = 0 ∧ n = 0 ⟶ m * n = 0
  -> apply_forward_step gcd_divide1 param_m=m param_n=n goal=40
    #[54] divides (gcd m n) m
  -> rewrite_fact divides_def sym=false goal=40 facts=[54]
    #[55] ∃k. m = gcd m n * k
  exists_elim k2 goal=40 facts=[55]
    #[56] _VAR k2
    #[57] m = gcd m n * k2
    #[58] divides (m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
    #[59] divides (if m * n = 0 then 0 else m * n DIV gcd m n) d ⟷ divides m d ∧ divides n d
  cut "m * n DIV gcd m n = k2 * n" goal=58
    #[60] m * n DIV gcd m n = k2 * n
  ← rewrite_goal mult_comm sym=false goal=60
    #[61] n * m DIV gcd m n = n * k2
  ← apply_backward_step div_uniq param_r="(0::nat)" goal=61
    #[62] n * m = n * k2 * gcd m n + 0
  ← rewrite_goal add_0_right sym=false goal=62
    #[63] n * m = n * k2 * gcd m n
  ← rewrite_goal mult_assoc sym=false goal=63
    #[64] n * m = n * (k2 * gcd m n)
  ← rewrite_goal eq_mult_lcancel sym=false goal=64
    #[65] n = 0 ∨ m = k2 * gcd m n
  ← apply_backward_step disjI2 goal=65
    #[66] m = k2 * gcd m n
  ← rewrite_goal mult_comm sym=false goal=66
  ← apply_backward_step iffI goal=58
    #[67] divides (m * n DIV gcd m n) d ⟶ divides m d ∧ divides n d
    #[68] divides m d ∧ divides n d ⟶ divides (m * n DIV gcd m n) d
  ← introduction goal=67
    #[69] divides (m * n DIV gcd m n) d
    #[70] divides m d ∧ divides n d
  -> rewrite_fact divides_def sym=false goal=70 facts=[69]
    #[71] ∃k. d = m * n DIV gcd m n * k
  exists_elim k goal=70 facts=[71]
    #[72] _VAR k
    #[73] d = m * n DIV gcd m n * k
    #[74] divides m d ∧ divides n d
  ← rewrite_goal_with_prev goal=74 facts=[73]
    #[75] divides m (m * n DIV gcd m n * k) ∧ divides n (m * n DIV gcd m n * k)
  ← apply_backward_step conjI goal=75
    #[76] divides m (m * n DIV gcd m n * k)
    #[77] divides n (m * n DIV gcd m n * k)
  ← apply_backward_step divides_rmul goal=76
    #[78] divides m (m * n DIV gcd m n)
  ← rewrite_goal_with_prev goal=78 facts=[42]
    #[79] divides m (m * k1)
  ← apply_backward_step divides_rmul goal=79
    #[80] divides m m
  ← apply_backward_step divides_self goal=80
    #[81] divides m m
  ← apply_backward_step divides_rmul goal=77
    #[82] divides n (m * n DIV gcd m n)
  ← rewrite_goal_with_prev goal=82 facts=[60]
    #[83] divides n (k2 * n)
  ← apply_backward_step divides_lmul goal=83
    #[84] divides n n
  ← apply_backward_step divides_self goal=84
    #[85] divides n n
  ← introduction goal=68
    #[86] divides (m * n DIV gcd m n) d
  -> apply_forward_step conjD1 goal=86 facts=[17]
  -> apply_forward_step conjD2 goal=86 facts=[17]
  ← rewrite_goal_with_prev goal=86 facts=[42]
    #[87] divides (m * k1) d
  -> rewrite_fact divides_def sym=false goal=87 facts=[20]
    #[88] ∃k. d = m * k
  exists_elim k3 goal=87 facts=[88]
    #[89] _VAR k3
    #[90] d = m * k3
    #[91] divides (m * k1) d
    #[92] divides (m * n DIV gcd m n) d
  ← rewrite_goal_with_prev goal=91 facts=[90]
    #[93] divides (m * k1) (m * k3)
  ← rewrite_goal_with_prev goal=93 facts=[57]
    #[94] divides (gcd m n * k2 * k1) (gcd m n * k2 * k3)
  ← rewrite_goal mult_assoc sym=false goal=94
    #[95] divides (gcd m n * (k2 * k1)) (gcd m n * (k2 * k3))
  ← apply_backward_step divides_mult_left goal=95
    #[96] divides (k2 * k1) (k2 * k3)
  ← apply_backward_step divides_mul goal=96
    #[97] divides k2 (k2 * k3)
    #[98] divides k1 (k2 * k3)
    #[99] coprime k2 k1
  ← apply_backward_step divides_rmul goal=97
    #[100] divides k2 k2
  ← apply_backward_step divides_self goal=100
    #[101] divides k2 k2
  ← apply_backward_step divides_cmul2 param_c="gcd m n" goal=98
    #[102] divides (gcd m n * k1) (gcd m n * (k2 * k3))
  ← rewrite_goal mult_assoc sym=true goal=102
    #[103] divides (gcd m n * k1) (gcd m n * k2 * k3)
  -> rewrite_fact eq_sym_eq sym=false goal=103 facts=[57]
    #[104] gcd m n * k2 = m
  -> rewrite_fact eq_sym_eq sym=false goal=103 facts=[39]
    #[105] gcd m n * k1 = n
  ← rewrite_goal_with_prev goal=103 facts=[104]
    #[106] divides (gcd m n * k1) (m * k3)
  ← rewrite_goal_with_prev goal=106 facts=[105]
    #[107] divides n (m * k3)
  -> rewrite_fact_with_prev goal=107 facts=[90,21]
    #[108] divides n (m * k3)
  ← apply_backward_step gcd_coprime param_a=m param_b=n goal=99
qed

theorem lcm_sym
  fixes m :: nat, n :: nat
  prop lcm m n = lcm n m
  [hint_rewrite,hint_backward]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] (if m * n = 0 then 0 else m * n DIV gcd m n) = (if n * m = 0 then 0 else n * m DIV gcd n m)
  -> apply_forward_step mult_comm param_x=m param_y=n goal=1
    #[2] m * n = n * m
  -> apply_forward_step gcd_comm param_m=m param_n=n goal=1
    #[3] gcd m n = gcd n m
  ← rewrite_goal_with_prev goal=1 facts=[2]
    #[4] (if n * m = 0 then 0 else n * m DIV gcd m n) = (if n * m = 0 then 0 else n * m DIV gcd n m)
  ← rewrite_goal_with_prev goal=4 facts=[3]
qed

theorem lcm1
  fixes m :: nat, n :: nat
  prop divides m (lcm m n)
  [hint_backward]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] divides m (if m * n = 0 then 0 else m * n DIV gcd m n)
  ← cases "m * n = 0" goal=1
    #[2] m * n = 0 ⟶ divides m (if m * n = 0 then 0 else m * n DIV gcd m n)
    #[3] ¬(m * n = 0) ⟶ divides m (if m * n = 0 then 0 else m * n DIV gcd m n)
  ← introduction goal=2
    #[4] m * n = 0
    #[5] divides m (if m * n = 0 then 0 else m * n DIV gcd m n)
  ← rewrite_goal if_P sym=false goal=5 facts=[4]
    #[6] divides m 0
  ← apply_backward_step divides_zero goal=6
    #[7] divides m 0
  ← introduction goal=3
    #[8] ¬(m * n = 0)
    #[9] divides m (if m * n = 0 then 0 else m * n DIV gcd m n)
  ← rewrite_goal if_not_P sym=false goal=9 facts=[8]
    #[10] divides m (m * n DIV gcd m n)
  cut "divides (gcd m n) (m * n)" goal=10
    #[11] divides (gcd m n) (m * n)
  ← apply_backward_step divides_lmul goal=11
    #[12] divides (gcd m n) n
  ← apply_backward_step gcd_divides2 goal=12
    #[13] divides (gcd m n) n
  -> apply_forward_step divides_divides_div param_e=m goal=10 facts=[11]
    #[14] divides m (m * n DIV gcd m n) ⟷ divides (gcd m n * m) (m * n)
  ← rewrite_goal_with_prev goal=10 facts=[14]
    #[15] divides (gcd m n * m) (m * n)
  cut "gcd m n * m = m * gcd m n" goal=15
    #[16] gcd m n * m = m * gcd m n
  ← apply_backward_step mult_comm goal=16
    #[17] gcd m n * m = m * gcd m n
  ← rewrite_goal_with_prev goal=15 facts=[17]
    #[18] divides (m * gcd m n) (m * n)
  ← apply_backward_step divides_mult_left goal=18
qed

theorem lcm2
  fixes m :: nat, n :: nat
  prop divides n (lcm m n)
  [hint_backward]
proof
  ← rewrite_goal lcm_sym sym=false goal=0
    #[1] divides n (lcm n m)
  ← apply_backward_step lcm1 goal=1
qed

theorem lcm3
  fixes d :: nat, m :: nat, n :: nat
  prop divides m d --> divides n d --> divides (lcm m n) d
  [hint_backward,hint_backward1]
proof
  ← introduction goal=0
    #[1] divides m d
    #[2] divides n d
    #[3] divides (lcm m n) d
  ← rewrite_goal lcm_divides sym=false goal=3
    #[4] divides m d ∧ divides n d
  ← apply_backward_step conjI goal=4
qed

theorem lcm_divides_mul
  fixes m :: nat, n :: nat
  prop divides (lcm m n) (m * n)
  [hint_backward]
proof
  ← apply_backward_step lcm3 goal=0
    #[1] divides m (m * n)
    #[2] divides n (m * n)
  ← apply_backward_step divides_rmul goal=1
    #[3] divides m m
  ← apply_backward_step divides_self goal=3
  ← apply_backward_step divides_lmul goal=2
    #[4] divides n n
  ← apply_backward_step divides_self goal=4
qed

theorem divides_lcm
  fixes m :: nat, n :: nat, r :: nat
  prop divides r m | divides r n --> divides r (lcm m n)
  [hint_backward]
proof
  ← introduction goal=0
    #[1] divides r m ∨ divides r n
    #[2] divides r (lcm m n)
  ← apply_backward_step disjE goal=2 facts=[1]
    #[3] divides r m ⟶ divides r (lcm m n)
    #[4] divides r n ⟶ divides r (lcm m n)
  ← introduction goal=3
    #[5] divides r m
    #[6] divides r (lcm m n)
  ← apply_backward_step divides_trans param_m=m goal=6
    #[7] divides m (lcm m n)
  ← apply_backward_step lcm1 goal=7
    #[8] divides m (lcm m n)
  ← introduction goal=4
    #[9] divides r n
    #[10] divides r (lcm m n)
  ← apply_backward_step divides_trans param_m=n goal=10
    #[11] divides n (lcm m n)
  ← apply_backward_step lcm2 goal=11
    #[12] divides n (lcm m n)
qed

theorem lcm_0
  fixes n :: nat
  prop lcm 0 n = 0
  [hint_rewrite,hint_backward]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] (if 0 * n = 0 then 0 else 0 * n DIV gcd 0 n) = 0
  cut "0 * n = 0" goal=1
    #[2] 0 * n = 0
  ← rewrite_goal nat_times_def_1 sym=false goal=2
  ← rewrite_goal if_P sym=false goal=1 facts=[2]
qed

theorem lcm_1
  fixes n :: nat
  prop lcm 1 n = n
  [hint_backward,hint_rewrite]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] (if 1 * n = 0 then 0 else 1 * n DIV gcd 1 n) = n
  ← rewrite_goal gcd_1_left sym=false goal=1
    #[2] (if 1 * n = 0 then 0 else 1 * n DIV 1) = n
  ← rewrite_goal mult_1_left sym=false goal=2
    #[3] (if n = 0 then 0 else n DIV 1) = n
  ← rewrite_goal div_1 sym=false goal=3
    #[4] (if n = 0 then 0 else n) = n
  ← z3 goal=4
qed

theorem divides_lcm_gcd
  fixes d :: nat, m :: nat, n :: nat
  prop divides d (lcm m n) <--> divides (d * gcd m n) (m * n)
  [hint_rewrite]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] divides d (if m * n = 0 then 0 else m * n DIV gcd m n) ⟷ divides (d * gcd m n) (m * n)
  ← cases "m * n = 0" goal=1
    #[2] m * n = 0 ⟶ divides d (if m * n = 0 then 0 else m * n DIV gcd m n) ⟷ divides (d * gcd m n) (m * n)
    #[3] ¬(m * n = 0) ⟶ divides d (if m * n = 0 then 0 else m * n DIV gcd m n) ⟷ divides (d * gcd m n) (m * n)
  ← introduction goal=2
    #[4] m * n = 0
    #[5] divides d (if m * n = 0 then 0 else m * n DIV gcd m n) ⟷ divides (d * gcd m n) (m * n)
  ← rewrite_goal if_P sym=false goal=5 facts=[4]
    #[6] divides d 0 ⟷ divides (d * gcd m n) (m * n)
  ← rewrite_goal_with_prev goal=6 facts=[4]
    #[7] divides d 0 ⟷ divides (d * gcd m n) 0
  ← apply_backward_step iffI goal=7
    #[8] divides d 0 ⟶ divides (d * gcd m n) 0
    #[9] divides (d * gcd m n) 0 ⟶ divides d 0
  ← introduction goal=8
    #[10] divides d 0
    #[11] divides (d * gcd m n) 0
  ← apply_backward_step divides_zero goal=11
    #[12] divides (d * gcd m n) 0
  ← introduction goal=9
    #[13] divides (d * gcd m n) 0
    #[14] divides d 0
  ← apply_backward_step divides_zero goal=14
    #[15] divides d 0
  ← introduction goal=3
    #[16] ¬(m * n = 0)
    #[17] divides d (if m * n = 0 then 0 else m * n DIV gcd m n) ⟷ divides (d * gcd m n) (m * n)
  ← rewrite_goal if_not_P sym=false goal=17 facts=[16]
    #[18] divides d (m * n DIV gcd m n) ⟷ divides (d * gcd m n) (m * n)
  cut "d * gcd m n = gcd m n * d" goal=18
    #[19] d * gcd m n = gcd m n * d
  ← apply_backward_step mult_comm goal=19
    #[20] d * gcd m n = gcd m n * d
  ← rewrite_goal_with_prev goal=18 facts=[20]
    #[21] divides d (m * n DIV gcd m n) ⟷ divides (gcd m n * d) (m * n)
  ← apply_backward_step divides_divides_div goal=21
    #[22] divides (gcd m n) (m * n)
  ← apply_backward_step divides_lmul goal=22
    #[23] divides (gcd m n) n
  ← apply_backward_step gcd_divides2 goal=23
    #[24] divides (gcd m n) n
qed

theorem primepow_divides_lcm
  fixes k :: nat, m :: nat, n :: nat, p :: nat
  prop prime p --> divides (p ^ k) (lcm m n) <--> divides (p ^ k) m | divides (p ^ k) n
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] divides (p ^ k) (lcm m n) ⟷ divides (p ^ k) m ∨ divides (p ^ k) n
  ← apply_backward_step iffI goal=2
    #[3] divides (p ^ k) (lcm m n) ⟶ divides (p ^ k) m ∨ divides (p ^ k) n
    #[4] divides (p ^ k) m ∨ divides (p ^ k) n ⟶ divides (p ^ k) (lcm m n)
  ← introduction goal=3
    #[5] divides (p ^ k) (lcm m n)
    #[6] divides (p ^ k) m ∨ divides (p ^ k) n
  ← cases "m=0" goal=6
    #[7] m = 0 ⟶ divides (p ^ k) m ∨ divides (p ^ k) n
    #[8] ¬(m = 0) ⟶ divides (p ^ k) m ∨ divides (p ^ k) n
  ← introduction goal=7
    #[9] m = 0
    #[10] divides (p ^ k) m ∨ divides (p ^ k) n
  ← apply_backward_step disjI1 goal=10
    #[11] divides (p ^ k) m
  ← rewrite_goal_with_prev goal=11 facts=[9]
    #[12] divides (p ^ k) 0
  ← apply_backward_step divides_zero goal=12
    #[13] divides (p ^ k) 0
  ← introduction goal=8
    #[14] ¬(m = 0)
    #[15] divides (p ^ k) m ∨ divides (p ^ k) n
  ← cases "n=0" goal=15
    #[16] n = 0 ⟶ divides (p ^ k) m ∨ divides (p ^ k) n
    #[17] ¬(n = 0) ⟶ divides (p ^ k) m ∨ divides (p ^ k) n
  ← introduction goal=16
    #[18] n = 0
    #[19] divides (p ^ k) m ∨ divides (p ^ k) n
  ← apply_backward_step disjI2 goal=19
    #[20] divides (p ^ k) n
  ← rewrite_goal_with_prev goal=20 facts=[18]
    #[21] divides (p ^ k) 0
  ← apply_backward_step divides_zero goal=21
  ← introduction goal=17
    #[22] ¬(n = 0)
    #[23] divides (p ^ k) m ∨ divides (p ^ k) n
  -> apply_forward_step prime_ge_2 goal=23 facts=[1]
    #[24] 2 ≤ p
  -> apply_forward_step factorization_index goal=23 facts=[14,24]
    #[25] ∃k::nat. divides (p ^ k) m ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) m))
  -> apply_forward_step factorization_index goal=23 facts=[22,24]
    #[26] ∃k::nat. divides (p ^ k) n ∧ (∀l. k < l ⟶ ¬(divides (p ^ l) n))
  exists_elim a goal=23 facts=[25]
    #[27] _VAR a
    #[28] divides (p ^ a) m ∧ (∀l. a < l ⟶ ¬(divides (p ^ l) m))
    #[29] divides (p ^ k) m ∨ divides (p ^ k) n
  -> apply_forward_step conjD1 goal=29 facts=[28]
    #[30] divides (p ^ a) m
  -> apply_forward_step conjD2 goal=29 facts=[28]
    #[31] ∀l. a < l ⟶ ¬(divides (p ^ l) m)
  -> rewrite_fact divides_def sym=false goal=29 facts=[30]
    #[32] ∃k. m = p ^ a * k
  exists_elim q goal=29 facts=[32]
    #[33] _VAR q
    #[34] m = p ^ a * q
    #[35] divides (p ^ k) m ∨ divides (p ^ k) n
  exists_elim b goal=35 facts=[26]
    #[36] _VAR b
    #[37] divides (p ^ b) n ∧ (∀l. b < l ⟶ ¬(divides (p ^ l) n))
    #[38] divides (p ^ k) m ∨ divides (p ^ k) n
  -> apply_forward_step conjD1 goal=38 facts=[37]
    #[39] divides (p ^ b) n
  -> apply_forward_step conjD2 goal=38 facts=[37]
    #[40] ∀l. b < l ⟶ ¬(divides (p ^ l) n)
  -> rewrite_fact divides_def sym=false goal=38 facts=[39]
    #[41] ∃k. n = p ^ b * k
  exists_elim r goal=38 facts=[41]
    #[42] _VAR r
    #[43] n = p ^ b * r
    #[44] divides (p ^ k) m ∨ divides (p ^ k) n
  -> rewrite_fact divides_lcm_gcd sym=false goal=44 facts=[5]
    #[45] divides (p ^ k * gcd m n) (m * n)
  -> rewrite_fact_with_prev goal=44 facts=[34,45]
    #[46] divides (p ^ k * gcd (p ^ a * q) n) (p ^ a * q * n)
  -> rewrite_fact_with_prev goal=44 facts=[43,46]
    #[47] divides (p ^ k * gcd (p ^ a * q) (p ^ b * r)) (p ^ a * q * (p ^ b * r))
  cut "gcd (p ^ a * q) (p ^ b * r) =\n    p ^ (min a b) * (gcd (p ^ (a - min a b) * q) (p ^ (b - min a b) * r))" goal=44
    #[48] gcd (p ^ a * q) (p ^ b * r) = p ^ min a b * gcd (p ^ (a - min a b) * q) (p ^ (b - min a b) * r)
  ← rewrite_goal gcd_mult_left sym=true goal=48
    #[49] gcd (p ^ a * q) (p ^ b * r) = gcd (p ^ min a b * (p ^ (a - min a b) * q)) (p ^ min a b * (p ^ (b - min a b) * r))
  ← rewrite_goal mult_assoc sym=true goal=49
    #[50] gcd (p ^ a * q) (p ^ b * r) = gcd (p ^ min a b * p ^ (a - min a b) * q) (p ^ min a b * p ^ (b - min a b) * r)
  ← rewrite_goal nat_power_add sym=true goal=50
    #[51] gcd (p ^ a * q) (p ^ b * r) = gcd (p ^ (min a b + (a - min a b)) * q) (p ^ (min a b + (b - min a b)) * r)
  cut "min a b + (a - min a b) = a" goal=51
    #[52] min a b + (a - min a b) = a
  ← z3 goal=52
    #[53] min a b + (a - min a b) = a
  cut "min a b + (b - min a b) = b" goal=51
    #[54] min a b + (b - min a b) = b
  ← z3 goal=54
    #[55] min a b + (b - min a b) = b
  ← rewrite_goal_with_prev goal=51 facts=[53]
    #[56] gcd (p ^ a * q) (p ^ b * r) = gcd (p ^ a * q) (p ^ (min a b + (b - min a b)) * r)
  ← rewrite_goal_with_prev goal=56 facts=[55]
    #[57] gcd (p ^ a * q) (p ^ b * r) = gcd (p ^ a * q) (p ^ (min a b + (b - min a b)) * r)
  -> rewrite_fact_with_prev goal=44 facts=[48,47]
    #[58] divides (p ^ k * (p ^ min a b * gcd (p ^ (a - min a b) * q) (p ^ (b - min a b) * r))) (p ^ a * q * (p ^ b * r))
  -> rewrite_fact mult_assoc sym=true goal=44 facts=[58]
    #[59] divides (p ^ k * p ^ min a b * gcd (p ^ (a - min a b) * q) (p ^ (b - min a b) * r)) (p ^ a * q * p ^ b * r)
  -> rewrite_fact nat_power_add sym=true goal=44 facts=[59]
    #[60] divides (p ^ (k + min a b) * gcd (p ^ (a - min a b) * q) (p ^ (b - min a b) * r)) (p ^ a * q * p ^ b * r)
  -> apply_forward_step divides_rmul2 goal=44 facts=[60]
    #[61] divides (p ^ (k + min a b)) (p ^ a * q * p ^ b * r)
  cut "p ^ a * q * p ^ b * r = (q * r) * p ^ (a + b) " goal=44
    #[62] p ^ a * q * p ^ b * r = q * r * p ^ (a + b)
  ← rewrite_goal nat_power_add sym=false goal=62
    #[63] p ^ a * q * p ^ b * r = q * r * (p ^ a * p ^ b)
  nat_norm goal=63
    #[64] p ^ a * q * p ^ b * r = q * r * (p ^ a * p ^ b)
  -> rewrite_fact_with_prev goal=44 facts=[62,61]
    #[65] divides (p ^ (k + min a b)) (q * r * p ^ (a + b))
  -> apply_forward_step coprime_exp_divprod goal=44 facts=[65]
    #[66] coprime p (q * r) ⟶ divides (p ^ (k + min a b)) (p ^ (a + b))
  cut "coprime p (q * r)" goal=44
    #[67] coprime p (q * r)
  ← rewrite_goal coprime_rmul sym=false goal=67
    #[68] coprime p q ∧ coprime p r
  -> rewrite_fact prime_coprime_eq_nondivisiable sym=false goal=68 facts=[1]
    #[69] ∀n. coprime p n ⟷ ¬(divides p n)
  ← rewrite_goal_with_prev goal=68 facts=[69]
    #[70] ¬(divides p q) ∧ ¬(divides p r)
  ← apply_backward_step conjI goal=70
    #[71] ¬(divides p q)
    #[72] ¬(divides p r)
  -> forall_elim a+1 goal=71 facts=[31]
    #[73] a < a + 1 ⟶ ¬(divides (p ^ (a + 1)) m)
  cut "a < a + 1" goal=71
    #[74] a < a + 1
  ← z3 goal=74
    #[75] a < a + 1
  -> apply_fact goal=71 facts=[73,75]
    #[76] ¬(divides (p ^ (a + 1)) m)
  -> rewrite_fact nat_power_add sym=false goal=71 facts=[76]
    #[77] ¬(divides (p ^ a * p ^ (1::nat)) m)
  -> rewrite_fact exp_1 sym=false goal=71 facts=[77]
    #[78] ¬(divides (p ^ a * p) m)
  -> rewrite_fact_with_prev goal=71 facts=[34,78]
