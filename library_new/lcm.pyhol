theorem lcm_zero
  fixes m :: nat, n :: nat
  prop lcm m n = 0 <--> m = 0 | n = 0
  [hint_rewrite]
proof
  ← apply_backward_step iffI goal=0
    #[1] lcm m n = 0 ⟶ m = 0 ∨ n = 0
    #[2] m = 0 ∨ n = 0 ⟶ lcm m n = 0
  ← introduction goal=1
    #[3] lcm m n = 0
    #[4] m = 0 ∨ n = 0
  -> rewrite_fact multiples_eq sym="" goal=4 facts=[3]
    #[5] ∀d. divides (lcm m n) d ⟷ divides 0 d
  -> rewrite_fact lcm_divides sym=false goal=4 facts=[5]
    #[6] ∀d. divides m d ∧ divides n d ⟷ divides 0 d
  -> rewrite_fact divides_0 sym=false goal=4 facts=[6]
    #[7] ∀d. divides m d ∧ divides n d ⟷ d = 0
  -> rewrite_fact eq_sym_eq sym=false goal=4 facts=[7]
    #[8] ∀d. d = 0 ⟷ divides m d ∧ divides n d
  ← apply_backward_step mult_nonzero goal=4
    #[9] m * n = 0
  ← rewrite_goal_with_prev goal=9 facts=[8]
    #[10] divides m (m * n) ∧ divides n (m * n)
  ← apply_backward_step conjI goal=10
    #[11] divides m (m * n)
    #[12] divides n (m * n)
  ← apply_backward_step divides_rmul goal=11
    #[13] divides m m
  ← apply_backward_step divides_self goal=13
    #[14] divides m m
  ← apply_backward_step divides_lmul goal=12
    #[15] divides n n
  ← apply_backward_step divides_self goal=15
    #[16] divides n n
  ← introduction goal=2
    #[17] m = 0 ∨ n = 0
    #[18] lcm m n = 0
  ← apply_backward_step disjE goal=18 facts=[17]
    #[19] m = 0 ⟶ lcm m n = 0
    #[20] n = 0 ⟶ lcm m n = 0
  ← introduction goal=19
    #[21] m = 0
    #[22] lcm m n = 0
  ← rewrite_goal_with_prev goal=22 facts=[21]
    #[23] lcm 0 n = 0
  ← apply_backward_step lcm_0 goal=23
    #[24] lcm 0 n = 0
  ← introduction goal=20
    #[25] n = 0
    #[26] lcm m n = 0
  ← rewrite_goal_with_prev goal=26 facts=[25]
    #[27] lcm m 0 = 0
  ← rewrite_goal lcm_sym sym=false goal=27
    #[28] lcm 0 m = 0
  ← apply_backward_step lcm_0 goal=28
    #[29] lcm 0 m = 0
qed

theorem index_lcm
  fixes m :: nat, n :: nat, p :: nat
  prop prime p --> index p (lcm m n) = (if m = 0 | n = 0 then 0 else max (index p m) (index p n))
  [hint_backward]
proof
  ← introduction goal=0
    #[1] prime p
    #[2] index p (lcm m n) = (if m = 0 ∨ n = 0 then 0 else max (index p m) (index p n))
  ← cases "m = 0 ∨ n = 0" goal=2
    #[3] m = 0 ∨ n = 0 ⟶ index p (lcm m n) = (if m = 0 ∨ n = 0 then 0 else max (index p m) (index p n))
    #[4] ¬(m = 0 ∨ n = 0) ⟶ index p (lcm m n) = (if m = 0 ∨ n = 0 then 0 else max (index p m) (index p n))
  ← introduction goal=3
    #[5] m = 0 ∨ n = 0
    #[6] index p (lcm m n) = (if m = 0 ∨ n = 0 then 0 else max (index p m) (index p n))
  ← rewrite_goal if_P sym=false goal=6 facts=[5]
    #[7] index p (lcm m n) = 0
  ← rewrite_goal index_eq_0 sym=false goal=7
    #[8] lcm m n = 0 ∨ p = 1 ∨ ¬(divides p (lcm m n))
  ← apply_backward_step disjI1 goal=8
    #[9] lcm m n = 0
  ← rewrite_goal lcm_zero sym=false goal=9
  ← introduction goal=4
    #[10] ¬(m = 0 ∨ n = 0)
    #[11] index p (lcm m n) = (if m = 0 ∨ n = 0 then 0 else max (index p m) (index p n))
  ← rewrite_goal if_not_P sym=false goal=11 facts=[10]
    #[12] index p (lcm m n) = max (index p m) (index p n)
  -> apply_forward_step primepow_divides_lcm param_k="" param_m=m param_n=n goal=12 facts=[1]
    #[13] ∀k::nat. divides (p ^ k) (lcm m n) ⟷ divides (p ^ k) m ∨ divides (p ^ k) n
  -> rewrite_fact primepow_divides_index sym=false goal=12 facts=[13]
    #[14] ∀k. lcm m n = 0 ∨ p = 1 ∨ k ≤ index p (lcm m n) ⟷ (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∨ n = 0 ∨ p = 1 ∨ k ≤ index p n
  cut "!m. !n. (!k::nat. k <= m <--> k <= n) --> m = n " goal=12
    #[15] ∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n
  ← z3 goal=15
    #[16] ∀m::nat. ∀n. (∀k. k ≤ m ⟷ k ≤ n) ⟶ m = n
  ← apply_prev goal=12 facts=[16]
    #[17] ∀k. k ≤ index p (lcm m n) ⟷ k ≤ max (index p m) (index p n)
  ← introduction k goal=17
    #[18] _VAR k
    #[19] k ≤ index p (lcm m n) ⟷ k ≤ max (index p m) (index p n)
  cut "!m. !n. k <= max m n <--> k <= m | k <= n" goal=19
    #[20] ∀m. ∀n. k ≤ max m n ⟷ k ≤ m ∨ k ≤ n
  ← z3 goal=20
    #[21] ∀m. ∀n. k ≤ max m n ⟷ k ≤ m ∨ k ≤ n
  ← rewrite_goal_with_prev goal=19 facts=[21]
    #[22] k ≤ index p (lcm m n) ⟷ k ≤ index p m ∨ k ≤ index p n
  -> rewrite_fact de_morgan_thm2 sym=false goal=22 facts=[10]
    #[23] ¬(m = 0) ∧ ¬(n = 0)
  -> apply_forward_step conjD1 goal=22 facts=[23]
    #[24] ¬(m = 0)
  -> apply_forward_step conjD2 goal=22 facts=[23]
    #[25] ¬(n = 0)
  -> rewrite_fact prime_def sym=false goal=22 facts=[1]
    #[26] ¬(p = 1) ∧ (∀x. divides x p ⟶ x = 1 ∨ x = p)
  -> apply_forward_step conjD1 goal=22 facts=[26]
    #[27] ¬(p = 1)
  ← apply_backward_step iffI goal=22
    #[28] k ≤ index p (lcm m n) ⟶ k ≤ index p m ∨ k ≤ index p n
    #[29] k ≤ index p m ∨ k ≤ index p n ⟶ k ≤ index p (lcm m n)
  ← introduction goal=28
    #[30] k ≤ index p (lcm m n)
    #[31] k ≤ index p m ∨ k ≤ index p n
  cut "lcm m n = 0 ∨ p = 1 ∨ k ≤ index p (lcm m n)" goal=31
    #[32] lcm m n = 0 ∨ p = 1 ∨ k ≤ index p (lcm m n)
  ← apply_backward_step disjI2 goal=32
    #[33] p = 1 ∨ k ≤ index p (lcm m n)
  ← apply_backward_step disjI2 goal=33
  -> rewrite_fact_with_prev goal=31 facts=[14,32]
    #[34] (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∨ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← apply_backward_step disjE goal=31 facts=[34]
    #[35] m = 0 ∨ p = 1 ∨ k ≤ index p m ⟶ k ≤ index p m ∨ k ≤ index p n
    #[36] n = 0 ∨ p = 1 ∨ k ≤ index p n ⟶ k ≤ index p m ∨ k ≤ index p n
  ← introduction goal=35
    #[37] m = 0 ∨ p = 1 ∨ k ≤ index p m
    #[38] k ≤ index p m ∨ k ≤ index p n
  ← apply_backward_step disjI1 goal=38
    #[39] k ≤ index p m
  ← apply_backward_step disjE goal=39 facts=[37]
    #[40] m = 0 ⟶ k ≤ index p m
    #[41] p = 1 ∨ k ≤ index p m ⟶ k ≤ index p m
  ← introduction goal=40
    #[42] m = 0
    #[43] k ≤ index p m
  ← apply_backward_step negE_gen goal=43 facts=[24,42]
    #[44] k ≤ index p m
  ← introduction goal=41
    #[45] p = 1 ∨ k ≤ index p m
    #[46] k ≤ index p m
  ← apply_backward_step disjE goal=46 facts=[45]
    #[47] p = 1 ⟶ k ≤ index p m
    #[48] k ≤ index p m ⟶ k ≤ index p m
  ← introduction goal=47
    #[49] p = 1
    #[50] k ≤ index p m
  ← apply_backward_step negE_gen goal=50 facts=[27,49]
    #[51] k ≤ index p m
  ← introduction goal=36
    #[52] n = 0 ∨ p = 1 ∨ k ≤ index p n
    #[53] k ≤ index p m ∨ k ≤ index p n
  ← apply_backward_step disjI2 goal=53
    #[54] k ≤ index p n
  ← apply_backward_step disjE goal=54 facts=[52]
    #[55] n = 0 ⟶ k ≤ index p n
    #[56] p = 1 ∨ k ≤ index p n ⟶ k ≤ index p n
  ← introduction goal=55
    #[57] n = 0
    #[58] k ≤ index p n
  ← apply_backward_step negE_gen goal=58 facts=[25,57]
    #[59] k ≤ index p n
  ← introduction goal=56
    #[60] p = 1 ∨ k ≤ index p n
    #[61] k ≤ index p n
  ← apply_backward_step disjE goal=61 facts=[60]
    #[62] p = 1 ⟶ k ≤ index p n
    #[63] k ≤ index p n ⟶ k ≤ index p n
  ← introduction goal=62
    #[64] k ≤ index p n
  ← apply_backward_step negE_gen goal=64 facts=[27,49]
    #[65] k ≤ index p n
  ← introduction goal=29
    #[66] k ≤ index p m ∨ k ≤ index p n
    #[67] k ≤ index p (lcm m n)
  cut "lcm m n = 0 ∨ p = 1 ∨ k ≤ index p (lcm m n)" goal=67
    #[68] lcm m n = 0 ∨ p = 1 ∨ k ≤ index p (lcm m n)
  ← rewrite_goal_with_prev goal=68 facts=[14]
    #[69] (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∨ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← apply_backward_step disjE goal=69 facts=[66]
    #[70] k ≤ index p m ⟶ (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∨ n = 0 ∨ p = 1 ∨ k ≤ index p n
    #[71] k ≤ index p n ⟶ (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∨ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← introduction goal=70
    #[72] k ≤ index p m
    #[73] (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∨ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← apply_backward_step disjI1 goal=73
    #[74] m = 0 ∨ p = 1 ∨ k ≤ index p m
  ← apply_backward_step disjI2 goal=74
    #[75] p = 1 ∨ k ≤ index p m
  ← apply_backward_step disjI2 goal=75
  ← introduction goal=71
    #[76] k ≤ index p n
    #[77] (m = 0 ∨ p = 1 ∨ k ≤ index p m) ∨ n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← apply_backward_step disjI2 goal=77
    #[78] n = 0 ∨ p = 1 ∨ k ≤ index p n
  ← apply_backward_step disjI2 goal=78
    #[79] p = 1 ∨ k ≤ index p n
  ← apply_backward_step disjI2 goal=79
  ← apply_backward_step disjE goal=67 facts=[68]
    #[80] lcm m n = 0 ⟶ k ≤ index p (lcm m n)
    #[81] p = 1 ∨ k ≤ index p (lcm m n) ⟶ k ≤ index p (lcm m n)
  ← introduction goal=80
    #[82] lcm m n = 0
    #[83] k ≤ index p (lcm m n)
  -> rewrite_fact lcm_zero sym=false goal=83 facts=[82]
    #[84] m = 0 ∨ n = 0
  ← apply_backward_step negE_gen goal=83 facts=[10,84]
    #[85] k ≤ index p (lcm m n)
  ← introduction goal=81
    #[86] p = 1 ∨ k ≤ index p (lcm m n)
    #[87] k ≤ index p (lcm m n)
  ← apply_backward_step disjE goal=87 facts=[86]
    #[88] p = 1 ⟶ k ≤ index p (lcm m n)
    #[89] k ≤ index p (lcm m n) ⟶ k ≤ index p (lcm m n)
  ← introduction goal=88
    #[90] k ≤ index p (lcm m n)
  ← apply_backward_step negE_gen goal=90 facts=[27,49]
    #[91] k ≤ index p (lcm m n)
qed

theorem lcm_assoc
  fixes m :: nat, n :: nat, p :: nat
  prop lcm m (lcm n p) = lcm (lcm m n) p
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite_goal multiples_eq sym="" goal=0
    #[1] ∀d. divides (lcm m (lcm n p)) d ⟷ divides (lcm (lcm m n) p) d
  ← rewrite_goal lcm_divides sym=false goal=1
    #[2] ∀d. divides m d ∧ divides (lcm n p) d ⟷ divides (lcm m n) d ∧ divides p d
  ← rewrite_goal lcm_divides sym=false goal=2
    #[3] ∀d. divides m d ∧ divides n d ∧ divides p d ⟷ (divides m d ∧ divides n d) ∧ divides p d
  ← introduction q goal=3
    #[4] _VAR q
    #[5] divides m q ∧ divides n q ∧ divides p q ⟷ (divides m q ∧ divides n q) ∧ divides p q
  ← rewrite_goal conj_assoc sym=false goal=5
qed

theorem lcm_refl
  fixes n :: nat
  prop lcm n n = n
  [hint_rewrite]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] (if n * n = 0 then 0 else n * n DIV gcd n n) = n
  ← cases "n=0" goal=1
    #[2] n = 0 ⟶ (if n * n = 0 then 0 else n * n DIV gcd n n) = n
    #[3] ¬(n = 0) ⟶ (if n * n = 0 then 0 else n * n DIV gcd n n) = n
  ← introduction goal=2
    #[4] n = 0
    #[5] (if n * n = 0 then 0 else n * n DIV gcd n n) = n
  cut "n * n = 0" goal=5
    #[6] n * n = 0
  ← rewrite_goal_with_prev goal=6 facts=[4]
    #[7] (0::nat) * 0 = 0
  ← rewrite_goal mult_0_right sym=false goal=7
    #[8] (0::nat) * 0 = 0
  ← rewrite_goal if_P sym=false goal=5 facts=[6]
    #[9] 0 = n
  ← rewrite_goal eq_sym_eq sym=false goal=9
  ← introduction goal=3
    #[10] ¬(n = 0)
    #[11] (if n * n = 0 then 0 else n * n DIV gcd n n) = n
  cut "~(n * n = 0)" goal=11
    #[12] ¬(n * n = 0)
  ← rewrite_goal mult_eq_0 sym=false goal=12
    #[13] ¬(n = 0 ∨ n = 0)
  ← rewrite_goal de_morgan_thm2 sym=false goal=13
    #[14] ¬(n = 0) ∧ ¬(n = 0)
  ← apply_backward_step conjI goal=14
  ← rewrite_goal if_not_P sym=false goal=11 facts=[12]
    #[15] n * n DIV gcd n n = n
  ← rewrite_goal gcd_refl sym=false goal=15
    #[16] n * n DIV n = n
  ← apply_backward_step div_mult goal=16
qed

theorem lcm_multiple
  fixes m :: nat, n :: nat
  prop lcm n (m * n) = m * n
  [hint_rewrite]
proof
  ← rewrite_goal multiples_eq sym="" goal=0
    #[1] ∀d. divides (lcm n (m * n)) d ⟷ divides (m * n) d
  ← rewrite_goal lcm_divides sym=false goal=1
    #[2] ∀d. divides n d ∧ divides (m * n) d ⟷ divides (m * n) d
  ← introduction d goal=2
    #[3] _VAR d
    #[4] divides n d ∧ divides (m * n) d ⟷ divides (m * n) d
  ← apply_backward_step iffI goal=4
    #[5] divides n d ∧ divides (m * n) d ⟶ divides (m * n) d
    #[6] divides (m * n) d ⟶ divides n d ∧ divides (m * n) d
  ← introduction goal=5
    #[7] divides n d ∧ divides (m * n) d
    #[8] divides (m * n) d
  ← apply_backward_step conjD2 goal=8 facts=[7]
  ← introduction goal=6
    #[9] divides (m * n) d
    #[10] divides n d ∧ divides (m * n) d
  ← apply_backward_step conjI goal=10
    #[11] divides n d
  ← apply_backward_step divides_lmul2 goal=11 facts=[9]
qed

theorem lcm_gcd_distrib
  fixes m :: nat, n :: nat, p :: nat
  prop lcm m (gcd n p) = gcd (lcm m n) (lcm m p)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite_goal primepow_divisors_eq sym=false goal=0
    #[1] ∀p1. ∀k::nat. prime p1 ⟶ divides (p1 ^ k) (lcm m (gcd n p)) ⟷ divides (p1 ^ k) (gcd (lcm m n) (lcm m p))
  ← introduction q,k goal=1
    #[2] _VAR q
    #[3] _VAR k
    #[4] prime q
    #[5] divides (q ^ k) (lcm m (gcd n p)) ⟷ divides (q ^ k) (gcd (lcm m n) (lcm m p))
  -> apply_forward_step primepow_divides_lcm param_k=k param_m="" param_n="" goal=5 facts=[4]
    #[6] ∀m. ∀n. divides (q ^ k) (lcm m n) ⟷ divides (q ^ k) m ∨ divides (q ^ k) n
  ← rewrite_goal_with_prev goal=5 facts=[6]
    #[7] divides (q ^ k) m ∨ divides (q ^ k) (gcd n p) ⟷ divides (q ^ k) (gcd (lcm m n) (lcm m p))
  ← rewrite_goal divides_gcd sym=false goal=7
    #[8] divides (q ^ k) m ∨ divides (q ^ k) n ∧ divides (q ^ k) p ⟷ divides (q ^ k) (lcm m n) ∧ divides (q ^ k) (lcm m p)
  ← rewrite_goal_with_prev goal=8 facts=[6]
    #[9] divides (q ^ k) m ∨ divides (q ^ k) n ∧ divides (q ^ k) p ⟷ (divides (q ^ k) m ∨ divides (q ^ k) n) ∧ (divides (q ^ k) m ∨ divides (q ^ k) p)
  ← rewrite_goal disj_conj_distribL1 sym=false goal=9
    #[10] divides (q ^ k) m ∨ divides (q ^ k) n ∧ divides (q ^ k) p ⟷ (divides (q ^ k) m ∨ divides (q ^ k) n) ∧ (divides (q ^ k) m ∨ divides (q ^ k) p)
qed

theorem gcd_lcm_distrib
  fixes m :: nat, n :: nat, p :: nat
  prop gcd m (lcm n p) = lcm (gcd m n) (gcd m p)
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite_goal primepow_divisors_eq sym=false goal=0
    #[1] ∀p1. ∀k::nat. prime p1 ⟶ divides (p1 ^ k) (gcd m (lcm n p)) ⟷ divides (p1 ^ k) (lcm (gcd m n) (gcd m p))
  ← introduction q,k goal=1
    #[2] _VAR q
    #[3] _VAR k
    #[4] prime q
    #[5] divides (q ^ k) (gcd m (lcm n p)) ⟷ divides (q ^ k) (lcm (gcd m n) (gcd m p))
  -> apply_forward_step primepow_divides_lcm param_k=k param_m="" param_n="" goal=5 facts=[4]
    #[6] ∀m. ∀n. divides (q ^ k) (lcm m n) ⟷ divides (q ^ k) m ∨ divides (q ^ k) n
  ← rewrite_goal_with_prev goal=5 facts=[6]
    #[7] divides (q ^ k) (gcd m (lcm n p)) ⟷ divides (q ^ k) (gcd m n) ∨ divides (q ^ k) (gcd m p)
  ← rewrite_goal divides_gcd sym=false goal=7
    #[8] divides (q ^ k) m ∧ divides (q ^ k) (lcm n p) ⟷ divides (q ^ k) m ∧ divides (q ^ k) n ∨ divides (q ^ k) m ∧ divides (q ^ k) p
  ← rewrite_goal_with_prev goal=8 facts=[6]
    #[9] divides (q ^ k) m ∧ (divides (q ^ k) n ∨ divides (q ^ k) p) ⟷ divides (q ^ k) m ∧ divides (q ^ k) n ∨ divides (q ^ k) m ∧ divides (q ^ k) p
  ← rewrite_goal conj_disj_distribL1 sym=false goal=9
    #[10] divides (q ^ k) m ∧ (divides (q ^ k) n ∨ divides (q ^ k) p) ⟷ divides (q ^ k) m ∧ divides (q ^ k) n ∨ divides (q ^ k) m ∧ divides (q ^ k) p
qed

theorem lcm_unique
  fixes d :: nat, m :: nat, n :: nat
  prop divides m d & divides n d & (!e. divides m e --> divides n e --> divides d e) <--> d = lcm m n
  [hint_rewrite]
proof
  ← rewrite_goal multiples_eq sym="" goal=0
    #[1] divides m d ∧ divides n d ∧ (∀e. divides m e ⟶ divides n e ⟶ divides d e) ⟷ (∀d1. divides d d1 ⟷ divides (lcm m n) d1)
  ← rewrite_goal lcm_divides sym=false goal=1
    #[2] divides m d ∧ divides n d ∧ (∀e. divides m e ⟶ divides n e ⟶ divides d e) ⟷ (∀d1. divides d d1 ⟷ divides m d1 ∧ divides n d1)
  ← apply_backward_step iffI goal=2
    #[3] divides m d ∧ divides n d ∧ (∀e. divides m e ⟶ divides n e ⟶ divides d e) ⟶ (∀d1. divides d d1 ⟷ divides m d1 ∧ divides n d1)
    #[4] (∀d1. divides d d1 ⟷ divides m d1 ∧ divides n d1) ⟶ divides m d ∧ divides n d ∧ (∀e. divides m e ⟶ divides n e ⟶ divides d e)
  ← introduction goal=3
    #[5] divides m d ∧ divides n d ∧ (∀e. divides m e ⟶ divides n e ⟶ divides d e)
    #[6] ∀d1. divides d d1 ⟷ divides m d1 ∧ divides n d1
  -> apply_forward_step conjD1 goal=6 facts=[5]
    #[7] divides m d
  -> apply_forward_step conjD2 goal=6 facts=[5]
    #[8] divides n d ∧ (∀e. divides m e ⟶ divides n e ⟶ divides d e)
  -> apply_forward_step conjD1 goal=6 facts=[8]
    #[9] divides n d
  -> apply_forward_step conjD2 goal=6 facts=[8]
    #[10] ∀e. divides m e ⟶ divides n e ⟶ divides d e
  ← introduction a goal=6
    #[11] _VAR a
    #[12] divides d a ⟷ divides m a ∧ divides n a
  ← apply_backward_step iffI goal=12
    #[13] divides d a ⟶ divides m a ∧ divides n a
    #[14] divides m a ∧ divides n a ⟶ divides d a
  ← introduction goal=13
    #[15] divides d a
    #[16] divides m a ∧ divides n a
  ← apply_backward_step conjI goal=16
    #[17] divides m a
    #[18] divides n a
  ← apply_backward_step divides_trans param_m=d goal=17
  ← apply_backward_step divides_trans param_m=d goal=18
  ← introduction goal=14
    #[19] divides m a ∧ divides n a
    #[20] divides d a
  -> apply_forward_step conjD1 goal=20 facts=[19]
    #[21] divides m a
  -> apply_forward_step conjD2 goal=20 facts=[19]
    #[22] divides n a
  ← apply_prev goal=20 facts=[10]
  ← introduction goal=4
    #[23] ∀d1. divides d d1 ⟷ divides m d1 ∧ divides n d1
    #[24] divides m d ∧ divides n d ∧ (∀e. divides m e ⟶ divides n e ⟶ divides d e)
  ← rewrite_goal conj_assoc sym=false goal=24
    #[25] (divides m d ∧ divides n d) ∧ (∀e. divides m e ⟶ divides n e ⟶ divides d e)
  ← apply_backward_step conjI goal=25
    #[26] divides m d ∧ divides n d
    #[27] ∀e. divides m e ⟶ divides n e ⟶ divides d e
  -> rewrite_fact eq_sym_eq sym=false goal=26 facts=[23]
    #[28] ∀d1. divides m d1 ∧ divides n d1 ⟷ divides d d1
  ← rewrite_goal_with_prev goal=26 facts=[28]
    #[29] divides d d
  ← apply_backward_step divides_self goal=29
    #[30] divides d d
  ← introduction e goal=27
    #[31] _VAR e
    #[32] divides m e
    #[33] divides n e
    #[34] divides d e
  ← rewrite_goal_with_prev goal=34 facts=[23]
    #[35] divides m e ∧ divides n e
  ← apply_backward_step conjI goal=35
qed

theorem lcm_eq
  fixes m :: nat, n :: nat, p :: nat, q :: nat
  prop (!d. divides m d & divides n d <--> divides p d & divides q d) --> lcm m n = lcm p q
  [hint_backward]
proof
  ← introduction goal=0
    #[1] ∀d. divides m d ∧ divides n d ⟷ divides p d ∧ divides q d
    #[2] lcm m n = lcm p q
  ← rewrite_goal multiples_eq sym="" goal=2
    #[3] ∀d. divides (lcm m n) d ⟷ divides (lcm p q) d
  ← rewrite_goal lcm_divides sym=false goal=3
qed

theorem divides_lcm_left
  fixes m :: nat, n :: nat
  prop divides n m <--> lcm m n = m
  [hint_rewrite]
proof
  ← apply_backward_step iffI goal=0
    #[1] divides n m ⟶ lcm m n = m
    #[2] lcm m n = m ⟶ divides n m
  ← introduction goal=1
    #[3] divides n m
    #[4] lcm m n = m
  ← rewrite_goal eq_sym_eq sym=false goal=4
    #[5] m = lcm m n
  ← rewrite_goal lcm_unique sym=true goal=5
    #[6] divides m m ∧ divides n m ∧ (∀e. divides m e ⟶ divides n e ⟶ divides m e)
  ← apply_backward_step conjI goal=6
    #[7] divides m m
    #[8] divides n m ∧ (∀e. divides m e ⟶ divides n e ⟶ divides m e)
  ← apply_backward_step divides_self goal=7
    #[9] divides m m
  ← apply_backward_step conjI goal=8
    #[10] ∀e. divides m e ⟶ divides n e ⟶ divides m e
  ← introduction goal=2
    #[11] lcm m n = m
    #[12] divides n m
  -> rewrite_fact eq_sym_eq sym=false goal=12 facts=[11]
    #[13] m = lcm m n
  ← rewrite_goal_with_prev goal=12 facts=[13]
    #[14] divides n (lcm m n)
  ← apply_backward_step lcm2 goal=14
    #[15] divides n (lcm m n)
qed

theorem divides_lcm_right
  fixes m :: nat, n :: nat
  prop divides m n <--> lcm m n = n
  [hint_rewrite]
proof
  ← rewrite_goal lcm_sym sym=false goal=0
    #[1] divides m n ⟷ lcm n m = n
  ← rewrite_goal divides_lcm_left sym=false goal=1
qed

theorem mult_lcm_gcd
  fixes m :: nat, n :: nat
  prop lcm m n * gcd m n = m * n
  [hint_rewrite]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] (if m * n = 0 then 0 else m * n DIV gcd m n) * gcd m n = m * n
  ← cases "m * n = 0" goal=1
    #[2] m * n = 0 ⟶ (if m * n = 0 then 0 else m * n DIV gcd m n) * gcd m n = m * n
    #[3] ¬(m * n = 0) ⟶ (if m * n = 0 then 0 else m * n DIV gcd m n) * gcd m n = m * n
  ← introduction goal=2
    #[4] m * n = 0
    #[5] (if m * n = 0 then 0 else m * n DIV gcd m n) * gcd m n = m * n
  ← rewrite_goal if_P sym=false goal=5 facts=[4]
    #[6] 0 * gcd m n = m * n
  ← rewrite_goal_with_prev goal=6 facts=[4]
    #[7] 0 * gcd m n = 0
  ← rewrite_goal nat_times_def_1 sym=false goal=7
    #[8] 0 * gcd m n = 0
  ← introduction goal=3
    #[9] ¬(m * n = 0)
    #[10] (if m * n = 0 then 0 else m * n DIV gcd m n) * gcd m n = m * n
  ← rewrite_goal if_not_P sym=false goal=10 facts=[9]
    #[11] m * n DIV gcd m n * gcd m n = m * n
  ← rewrite_goal divides_div_mult sym=true goal=11
    #[12] divides (gcd m n) (m * n)
  ← apply_backward_step divides_lmul goal=12
    #[13] divides (gcd m n) n
  ← apply_backward_step gcd_divides2 goal=13
    #[14] divides (gcd m n) n
qed

theorem mult_gcd_lcm
  fixes m :: nat, n :: nat
  prop gcd m n * lcm m n = m * n
  [hint_rewrite]
proof
  -> apply_forward_step mult_lcm_gcd param_m=m param_n=n goal=0
    #[1] lcm m n * gcd m n = m * n
  -> rewrite_fact eq_sym_eq sym=false goal=0 facts=[1]
    #[2] m * n = lcm m n * gcd m n
  ← rewrite_goal_with_prev goal=0 facts=[2]
    #[3] gcd m n * lcm m n = lcm m n * gcd m n
  ← apply_backward_step mult_comm goal=3
qed

theorem lcm_lmul
  fixes m :: nat, n :: nat, p :: nat
  prop lcm (p * m) (p * n) = p * lcm m n
  [hint_rewrite]
proof
  ← cases "p=0" goal=0
    #[1] p = 0 ⟶ lcm (p * m) (p * n) = p * lcm m n
    #[2] ¬(p = 0) ⟶ lcm (p * m) (p * n) = p * lcm m n
  ← introduction goal=1
    #[3] p = 0
    #[4] lcm (p * m) (p * n) = p * lcm m n
  ← rewrite_goal_with_prev goal=4 facts=[3]
    #[5] lcm (0 * m) (0 * n) = 0 * lcm m n
  ← rewrite_goal nat_times_def_1 sym=false goal=5
    #[6] lcm 0 0 = 0
  ← rewrite_goal lcm_0 sym=false goal=6
    #[7] lcm 0 0 = 0
  ← introduction goal=2
    #[8] ¬(p = 0)
    #[9] lcm (p * m) (p * n) = p * lcm m n
  ← rewrite_goal lcm_def sym=false goal=9
    #[10] (if p * m * (p * n) = 0 then 0 else p * m * (p * n) DIV gcd (p * m) (p * n)) = p * (if m * n = 0 then 0 else m * n DIV gcd m n)
  ← cases "m * n = 0" goal=10
    #[11] m * n = 0 ⟶ (if p * m * (p * n) = 0 then 0 else p * m * (p * n) DIV gcd (p * m) (p * n)) = p * (if m * n = 0 then 0 else m * n DIV gcd m n)
    #[12] ¬(m * n = 0) ⟶ (if p * m * (p * n) = 0 then 0 else p * m * (p * n) DIV gcd (p * m) (p * n)) = p * (if m * n = 0 then 0 else m * n DIV gcd m n)
  ← introduction goal=11
    #[13] m * n = 0
    #[14] (if p * m * (p * n) = 0 then 0 else p * m * (p * n) DIV gcd (p * m) (p * n)) = p * (if m * n = 0 then 0 else m * n DIV gcd m n)
  ← rewrite_goal if_P sym=false goal=14 facts=[13]
    #[15] (if p * m * (p * n) = 0 then 0 else p * m * (p * n) DIV gcd (p * m) (p * n)) = p * 0
  cut "p * m * (p * n) = 0" goal=15
    #[16] p * m * (p * n) = 0
  ← z3 goal=16 facts=[13]
    #[17] p * m * (p * n) = 0
  ← rewrite_goal if_P sym=false goal=15 facts=[17]
    #[18] 0 = p * 0
  ← rewrite_goal mult_0_right sym=false goal=18
    #[19] 0 = p * 0
  ← introduction goal=12
    #[20] ¬(m * n = 0)
    #[21] (if p * m * (p * n) = 0 then 0 else p * m * (p * n) DIV gcd (p * m) (p * n)) = p * (if m * n = 0 then 0 else m * n DIV gcd m n)
  ← rewrite_goal if_not_P sym=false goal=21 facts=[20]
    #[22] (if p * m * (p * n) = 0 then 0 else p * m * (p * n) DIV gcd (p * m) (p * n)) = p * (m * n DIV gcd m n)
  cut "~(p * m * (p * n) = 0)" goal=22
    #[23] ¬(p * m * (p * n) = 0)
  ← z3 goal=23 facts=[20,8]
  ← rewrite_goal if_not_P sym=false goal=22 facts=[23]
    #[24] p * m * (p * n) DIV gcd (p * m) (p * n) = p * (m * n DIV gcd m n)
  ← rewrite_goal gcd_mult_left sym=false goal=24
    #[25] p * m * (p * n) DIV (p * gcd m n) = p * (m * n DIV gcd m n)
  ← rewrite_goal mult_assoc sym=false goal=25
    #[26] p * (m * (p * n)) DIV (p * gcd m n) = p * (m * n DIV gcd m n)
  -> apply_forward_step div_mult2 param_n="m * (p * n)" param_p="gcd m n" goal=26 facts=[8]
    #[27] p * (m * (p * n)) DIV (p * gcd m n) = m * (p * n) DIV gcd m n
  ← rewrite_goal_with_prev goal=26 facts=[27]
    #[28] m * (p * n) DIV gcd m n = p * (m * n DIV gcd m n)
  cut "m * (p * n) = p * (m * n)" goal=28
    #[29] m * (p * n) = p * (m * n)
  nat_norm goal=29
    #[30] m * (p * n) = p * (m * n)
  ← rewrite_goal_with_prev goal=28 facts=[30]
    #[31] p * (m * n) DIV gcd m n = p * (m * n DIV gcd m n)
  ← apply_backward_step div_uniq param_r="(0::nat)" goal=31
    #[32] p * (m * n) = p * (m * n DIV gcd m n) * gcd m n + 0
    #[33] 0 < gcd m n
  ← rewrite_goal add_0_right sym=false goal=32
    #[34] p * (m * n) = p * (m * n DIV gcd m n) * gcd m n
  ← rewrite_goal mult_assoc sym=false goal=34
    #[35] p * (m * n) = p * (m * n DIV gcd m n * gcd m n)
  ← rewrite_goal eq_mult_lcancel sym=false goal=35
    #[36] p = 0 ∨ m * n = m * n DIV gcd m n * gcd m n
  ← apply_backward_step disjI2 goal=36
    #[37] m * n = m * n DIV gcd m n * gcd m n
  ← rewrite_goal eq_sym_eq sym=false goal=37
    #[38] m * n DIV gcd m n * gcd m n = m * n
  ← rewrite_goal divides_div_mult sym=true goal=38
    #[39] divides (gcd m n) (m * n)
  ← apply_backward_step divides_lmul goal=39
    #[40] divides (gcd m n) n
  ← apply_backward_step gcd_divides2 goal=40
    #[41] divides (gcd m n) n
  ← apply_backward_step le_1_1 goal=33
    #[42] ¬(gcd m n = 0)
  ← rewrite_goal gcd_zero sym=false goal=42
    #[43] ¬(m = 0 ∧ n = 0)
  ← z3 goal=43 facts=[20]
    #[44] ¬(m = 0 ∧ n = 0)
qed

theorem lcm_rmul
  fixes m :: nat, n :: nat, p :: nat
  prop lcm (m * p) (n * p) = p * lcm m n
  [hint_rewrite]
proof
  ← rewrite_goal mult_comm sym=false goal=0
    #[1] lcm (p * m) (p * n) = lcm m n * p
  ← rewrite_goal lcm_lmul sym=false goal=1
    #[2] p * lcm m n = lcm m n * p
  ← apply_backward_step mult_comm goal=2
qed

theorem lcm_exp
  fixes a :: nat, b :: nat, n :: nat
  prop lcm (a ^ n) (b ^ n) = lcm a b ^ n
  [hint_rewrite,hint_rewrite_sym]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] (if a ^ n * b ^ n = 0 then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a * b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← rewrite_goal mult_eq_0 sym=false goal=1
    #[2] (if a ^ n = 0 ∨ b ^ n = 0 then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← rewrite_goal exp_eq_0 sym=false goal=2
    #[3] (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← cases "n=0" goal=3
    #[4] n = 0 ⟶ (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
    #[5] ¬(n = 0) ⟶ (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← introduction goal=4
    #[6] n = 0
    #[7] (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← rewrite_goal_with_prev goal=7 facts=[6]
    #[8] (if a = 0 ∧ ¬((0::nat) = 0) ∨ b = 0 ∧ ¬((0::nat) = 0) then 0 else a ^ (0::nat) * b ^ (0::nat) DIV gcd (a ^ (0::nat)) (b ^ (0::nat))) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ (0::nat)
  ← rewrite_goal nat_nat_power_def_1 sym=false goal=8
    #[9] (if a = 0 ∧ ¬((0::nat) = 0) ∨ b = 0 ∧ ¬((0::nat) = 0) then 0 else 1 * 1 DIV gcd 1 1) = 1
  cut "~(a = 0 ∧ ¬((0::nat) = 0) ∨ b = 0 ∧ ¬((0::nat) = 0))" goal=9
    #[10] ¬(a = 0 ∧ ¬((0::nat) = 0) ∨ b = 0 ∧ ¬((0::nat) = 0))
  ← z3 goal=10
    #[11] ¬(a = 0 ∧ ¬((0::nat) = 0) ∨ b = 0 ∧ ¬((0::nat) = 0))
  ← rewrite_goal if_not_P sym=false goal=9 facts=[11]
    #[12] 1 * 1 DIV gcd 1 1 = 1
  ← rewrite_goal mult_1_right sym=false goal=12
    #[13] 1 DIV gcd 1 1 = 1
  ← rewrite_goal gcd_refl sym=false goal=13
    #[14] 1 DIV 1 = 1
  ← rewrite_goal div_1 sym=false goal=14
    #[15] 1 DIV 1 = 1
  ← introduction goal=5
    #[16] ¬(n = 0)
    #[17] (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← cases " a = 0 ∨ b = 0" goal=17
    #[18] a = 0 ∨ b = 0 ⟶ (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
    #[19] ¬(a = 0 ∨ b = 0) ⟶ (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← introduction goal=18
    #[20] a = 0 ∨ b = 0
    #[21] (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← rewrite_goal if_P sym=false goal=21 facts=[20]
    #[22] (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = 0 ^ n
  cut "a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0)" goal=22
    #[23] a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0)
  ← z3 goal=23 facts=[20,16]
  ← rewrite_goal if_P sym=false goal=22 facts=[23]
    #[24] (0::nat) = 0 ^ n
  ← rewrite_goal exp_zero sym=false goal=24
    #[25] (0::nat) = (if n = 0 then 1 else 0)
  ← rewrite_goal if_not_P sym=false goal=25 facts=[16]
    #[26] (0::nat) = (if n = 0 then 1 else 0)
  ← introduction goal=19
    #[27] ¬(a = 0 ∨ b = 0)
    #[28] (if a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0) then 0 else a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n)) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  cut "~(a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0))" goal=28
    #[29] ¬(a = 0 ∧ ¬(n = 0) ∨ b = 0 ∧ ¬(n = 0))
  ← z3 goal=29 facts=[27,16]
  ← rewrite_goal if_not_P sym=false goal=28 facts=[29]
    #[30] a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n) = (if a = 0 ∨ b = 0 then 0 else a * b DIV gcd a b) ^ n
  ← rewrite_goal if_not_P sym=false goal=30 facts=[27]
    #[31] a ^ n * b ^ n DIV gcd (a ^ n) (b ^ n) = (a * b DIV gcd a b) ^ n
  ← rewrite_goal gcd_exp sym=false goal=31
    #[32] a ^ n * b ^ n DIV gcd a b ^ n = (a * b DIV gcd a b) ^ n
  ← apply_backward_step div_uniq param_r="(0::nat)" goal=32
    #[33] a ^ n * b ^ n = (a * b DIV gcd a b) ^ n * gcd a b ^ n + 0
    #[34] 0 < gcd a b ^ n
  ← rewrite_goal add_0_right sym=false goal=33
    #[35] a ^ n * b ^ n = (a * b DIV gcd a b) ^ n * gcd a b ^ n
  ← rewrite_goal mult_exp sym=true goal=35
    #[36] (a * b) ^ n = (a * b DIV gcd a b * gcd a b) ^ n
  cut "divides (gcd a b) (a * b)" goal=36
    #[37] divides (gcd a b) (a * b)
  ← apply_backward_step divides_lmul goal=37
    #[38] divides (gcd a b) b
  ← apply_backward_step gcd_divides2 goal=38
    #[39] divides (gcd a b) b
  -> rewrite_fact divides_div_mult sym=false goal=36 facts=[37]
    #[40] a * b DIV gcd a b * gcd a b = a * b
  ← rewrite_goal_with_prev goal=36 facts=[40]
  ← rewrite_goal exp_lt_0 sym=false goal=34
    #[41] ¬(gcd a b = 0) ∨ n = 0
  ← apply_backward_step disjI1 goal=41
    #[42] ¬(gcd a b = 0)
  ← rewrite_goal gcd_zero sym=false goal=42
    #[43] ¬(a = 0 ∧ b = 0)
  ← z3 goal=43 facts=[27]
    #[44] ¬(a = 0 ∧ b = 0)
qed

theorem lcm_coprime_decomp
  fixes m :: nat, n :: nat
  prop ?m1. ?n1. divides m1 m & divides n1 n & coprime m1 n1 & m1 * n1 = lcm m n
  [hint_backward]
proof
  ← cases "m=0" goal=0
    #[1] m = 0 ⟶ (∃m1. ∃n1. divides m1 m ∧ divides n1 n ∧ coprime m1 n1 ∧ m1 * n1 = lcm m n)
    #[2] ¬(m = 0) ⟶ (∃m1. ∃n1. divides m1 m ∧ divides n1 n ∧ coprime m1 n1 ∧ m1 * n1 = lcm m n)
  ← introduction goal=1
    #[3] m = 0
    #[4] ∃m1. ∃n1. divides m1 m ∧ divides n1 n ∧ coprime m1 n1 ∧ m1 * n1 = lcm m n
  ← rewrite_goal_with_prev goal=4 facts=[3]
    #[5] ∃m1. ∃n1. divides m1 0 ∧ divides n1 n ∧ coprime m1 n1 ∧ m1 * n1 = lcm 0 n
  ← inst_exists_goal "(0::nat)" goal=5
    #[6] ∃n1. divides 0 0 ∧ divides n1 n ∧ coprime 0 n1 ∧ 0 * n1 = lcm 0 n
  ← inst_exists_goal "(1::nat)" goal=6
    #[7] divides 0 0 ∧ divides 1 n ∧ coprime 0 1 ∧ 0 * 1 = lcm 0 n
  ← apply_backward_step conjI goal=7
    #[8] divides 0 0
    #[9] divides 1 n ∧ coprime 0 1 ∧ 0 * 1 = lcm 0 n
  ← rewrite_goal divides_0 sym=false goal=8
    #[10] divides 0 0
  ← apply_backward_step conjI goal=9
    #[11] divides 1 n
    #[12] coprime 0 1 ∧ 0 * 1 = lcm 0 n
  ← apply_backward_step divides_1 goal=11
    #[13] divides 1 n
  ← apply_backward_step conjI goal=12
    #[14] coprime 0 1
    #[15] 0 * 1 = lcm 0 n
  ← apply_backward_step coprime_1 goal=14
    #[16] coprime 0 1
  ← rewrite_goal lcm_0 sym=false goal=15
    #[17] (0::nat) * 1 = 0
  ← rewrite_goal nat_times_def_1 sym=false goal=17
    #[18] (0::nat) * 1 = 0
  ← introduction goal=2
    #[19] ¬(m = 0)
    #[20] ∃m1. ∃n1. divides m1 m ∧ divides n1 n ∧ coprime m1 n1 ∧ m1 * n1 = lcm m n
  -> apply_forward_step gcd_coprime_exists param_a=m param_b=n goal=20
    #[21] ∃c. ∃d. m = c * gcd m n ∧ n = d * gcd m n ∧ coprime c d
  exists_elim c,d goal=20 facts=[21]
    #[22] _VAR c
    #[23] _VAR d
    #[24] m = c * gcd m n ∧ n = d * gcd m n ∧ coprime c d
    #[25] ∃m1. ∃n1. divides m1 m ∧ divides n1 n ∧ coprime m1 n1 ∧ m1 * n1 = lcm m n
  -> apply_forward_step conjD1 goal=25 facts=[24]
    #[26] m = c * gcd m n
  -> apply_forward_step conjD2 goal=25 facts=[24]
    #[27] n = d * gcd m n ∧ coprime c d
  -> apply_forward_step conjD1 goal=25 facts=[27]
    #[28] n = d * gcd m n
  -> apply_forward_step conjD2 goal=25 facts=[27]
    #[29] coprime c d
  -> apply_forward_step coprime_pair_decomp param_m="gcd m n" goal=25 facts=[29]
    #[30] ¬(gcd m n = 0) ⟶ (∃m1. ∃m2. coprime m1 c ∧ coprime m2 d ∧ coprime m1 m2 ∧ m1 * m2 = gcd m n)
  -> rewrite_fact gcd_zero sym=false goal=25 facts=[30]
    #[31] ¬(m = 0 ∧ n = 0) ⟶ (∃m1. ∃m2. coprime m1 c ∧ coprime m2 d ∧ coprime m1 m2 ∧ m1 * m2 = gcd m n)
  cut "¬(m = 0 ∧ n = 0)" goal=25
    #[32] ¬(m = 0 ∧ n = 0)
  ← z3 goal=32 facts=[19]
    #[33] ¬(m = 0 ∧ n = 0)
  -> apply_fact goal=25 facts=[31,33]
    #[34] ∃m1. ∃m2. coprime m1 c ∧ coprime m2 d ∧ coprime m1 m2 ∧ m1 * m2 = gcd m n
  exists_elim n1,m1 goal=25 facts=[34]
    #[35] _VAR n1
    #[36] _VAR m1
    #[37] coprime n1 c ∧ coprime m1 d ∧ coprime n1 m1 ∧ n1 * m1 = gcd m n
    #[38] ∃m1. ∃n1. divides m1 m ∧ divides n1 n ∧ coprime m1 n1 ∧ m1 * n1 = lcm m n
  -> apply_forward_step conjD1 goal=38 facts=[37]
    #[39] coprime n1 c
  -> apply_forward_step conjD2 goal=38 facts=[37]
    #[40] coprime m1 d ∧ coprime n1 m1 ∧ n1 * m1 = gcd m n
  -> apply_forward_step conjD1 goal=38 facts=[40]
    #[41] coprime m1 d
  -> apply_forward_step conjD2 goal=38 facts=[40]
    #[42] coprime n1 m1 ∧ n1 * m1 = gcd m n
  -> apply_forward_step conjD1 goal=38 facts=[42]
    #[43] coprime n1 m1
  -> apply_forward_step conjD2 goal=38 facts=[42]
    #[44] n1 * m1 = gcd m n
  ← inst_exists_goal c*m1 goal=38
    #[45] ∃n1. divides (c * m1) m ∧ divides n1 n ∧ coprime (c * m1) n1 ∧ c * m1 * n1 = lcm m n
  ← inst_exists_goal d*n1 goal=45
    #[46] divides (c * m1) m ∧ divides (d * n1) n ∧ coprime (c * m1) (d * n1) ∧ c * m1 * (d * n1) = lcm m n
  ← rewrite_goal coprime_lmul sym=false goal=46
    #[47] divides (c * m1) m ∧ divides (d * n1) n ∧ (coprime c (d * n1) ∧ coprime m1 (d * n1)) ∧ c * m1 * (d * n1) = lcm m n
  ← rewrite_goal coprime_rmul sym=false goal=47
    #[48] divides (c * m1) m ∧ divides (d * n1) n ∧ ((coprime c d ∧ coprime c n1) ∧ coprime m1 d ∧ coprime m1 n1) ∧ c * m1 * (d * n1) = lcm m n
  ← apply_backward_step conjI goal=48
    #[49] divides (c * m1) m
    #[50] divides (d * n1) n ∧ ((coprime c d ∧ coprime c n1) ∧ coprime m1 d ∧ coprime m1 n1) ∧ c * m1 * (d * n1) = lcm m n
  ← rewrite_goal_with_prev goal=49 facts=[26]
    #[51] divides (c * m1) (c * gcd m n)
  ← apply_backward_step divides_mult_left goal=51
    #[52] divides m1 (gcd m n)
  -> rewrite_fact eq_sym_eq sym=false goal=52 facts=[44]
    #[53] gcd m n = n1 * m1
  ← rewrite_goal_with_prev goal=52 facts=[53]
    #[54] divides m1 (n1 * m1)
  ← apply_backward_step divides_lmul goal=54
    #[55] divides m1 m1
  ← apply_backward_step divides_self goal=55
    #[56] divides m1 m1
  ← apply_backward_step conjI goal=50
    #[57] divides (d * n1) n
    #[58] ((coprime c d ∧ coprime c n1) ∧ coprime m1 d ∧ coprime m1 n1) ∧ c * m1 * (d * n1) = lcm m n
  ← rewrite_goal_with_prev goal=57 facts=[28]
    #[59] divides (d * n1) (d * gcd m n)
  ← apply_backward_step divides_mult_left goal=59
    #[60] divides n1 (gcd m n)
  ← rewrite_goal_with_prev goal=60 facts=[53]
    #[61] divides n1 (n1 * m1)
  ← apply_backward_step divides_rmul goal=61
    #[62] divides n1 n1
  ← apply_backward_step divides_self goal=62
    #[63] divides n1 n1
  ← apply_backward_step conjI goal=58
    #[64] (coprime c d ∧ coprime c n1) ∧ coprime m1 d ∧ coprime m1 n1
    #[65] c * m1 * (d * n1) = lcm m n
  ← apply_backward_step conjI goal=64
    #[66] coprime c d ∧ coprime c n1
    #[67] coprime m1 d ∧ coprime m1 n1
  ← apply_backward_step conjI goal=66
    #[68] coprime c n1
  ← rewrite_goal coprime_sym sym=false goal=68
  ← apply_backward_step conjI goal=67
    #[69] coprime m1 n1
  ← rewrite_goal coprime_sym sym=false goal=69
  cut "!a. !b. !d::nat. ~(d = 0) --> a * d = b * d --> a = b" goal=65
    #[70] ∀a::nat. ∀b. ∀d. ¬(d = 0) ⟶ a * d = b * d ⟶ a = b
  ← z3 goal=70
    #[71] ∀a::nat. ∀b. ∀d. ¬(d = 0) ⟶ a * d = b * d ⟶ a = b
  ← apply_prev param_d="gcd m n" goal=65 facts=[71]
    #[72] ¬(gcd m n = 0)
    #[73] c * m1 * (d * n1) * gcd m n = lcm m n * gcd m n
  ← rewrite_goal gcd_zero sym=false goal=72
  ← rewrite_goal mult_lcm_gcd sym=false goal=73
    #[74] c * m1 * (d * n1) * gcd m n = m * n
  ← rewrite_goal_with_prev goal=74 facts=[53]
    #[75] c * m1 * (d * n1) * (n1 * m1) = m * n
  ← rewrite_goal_with_prev goal=75 facts=[26]
    #[76] c * m1 * (d * n1) * (n1 * m1) = c * gcd m n * n
  ← rewrite_goal_with_prev goal=76 facts=[53]
    #[77] c * m1 * (d * n1) * (n1 * m1) = c * (n1 * m1) * n
  ← rewrite_goal_with_prev goal=77 facts=[28]
    #[78] c * m1 * (d * n1) * (n1 * m1) = c * (n1 * m1) * (d * gcd m n)
  ← rewrite_goal_with_prev goal=78 facts=[53]
    #[79] c * m1 * (d * n1) * (n1 * m1) = c * (n1 * m1) * (d * (n1 * m1))
  nat_norm goal=79
    #[80] c * m1 * (d * n1) * (n1 * m1) = c * (n1 * m1) * (d * (n1 * m1))
qed

theorem le_lcm1
  fixes m :: nat, n :: nat
  prop m <= lcm m n <--> (n = 0 --> m = 0)
  [hint_rewrite]
proof
  ← cases "m=0" goal=0
    #[1] m = 0 ⟶ m ≤ lcm m n ⟷ (n = 0 ⟶ m = 0)
    #[2] ¬(m = 0) ⟶ m ≤ lcm m n ⟷ (n = 0 ⟶ m = 0)
  ← introduction goal=1
    #[3] m = 0
    #[4] m ≤ lcm m n ⟷ (n = 0 ⟶ m = 0)
  ← apply_backward_step iffI goal=4
    #[5] m ≤ lcm m n ⟶ n = 0 ⟶ m = 0
    #[6] (n = 0 ⟶ m = 0) ⟶ m ≤ lcm m n
  ← introduction goal=5
    #[7] m ≤ lcm m n
    #[8] n = 0
  ← introduction goal=6
    #[9] n = 0 ⟶ m = 0
    #[10] m ≤ lcm m n
  ← rewrite_goal_with_prev goal=10 facts=[3]
    #[11] 0 ≤ lcm 0 n
  ← apply_backward_step le_0 goal=11
    #[12] 0 ≤ lcm 0 n
  ← introduction goal=2
    #[13] ¬(m = 0)
    #[14] m ≤ lcm m n ⟷ (n = 0 ⟶ m = 0)
  ← cases "n=0" goal=14
    #[15] n = 0 ⟶ m ≤ lcm m n ⟷ (n = 0 ⟶ m = 0)
    #[16] ¬(n = 0) ⟶ m ≤ lcm m n ⟷ (n = 0 ⟶ m = 0)
  ← introduction goal=15
    #[17] m ≤ lcm m n ⟷ (n = 0 ⟶ m = 0)
  ← apply_backward_step iffI goal=17
    #[18] m ≤ lcm m n ⟶ n = 0 ⟶ m = 0
    #[19] (n = 0 ⟶ m = 0) ⟶ m ≤ lcm m n
  ← introduction goal=18
    #[20] m = 0
  -> rewrite_fact_with_prev goal=20 facts=[8,7]
    #[21] m ≤ lcm m 0
  -> rewrite_fact lcm_sym sym=false goal=20 facts=[21]
    #[22] m ≤ lcm 0 m
  -> rewrite_fact lcm_0 sym=false goal=20 facts=[22]
    #[23] m ≤ 0
  -> apply_forward_step nat_le_zero goal=20 facts=[23]
    #[24] m = 0
  ← introduction goal=19
    #[25] m ≤ lcm m n
  -> apply_fact goal=25 facts=[9,8]
    #[26] m = 0
  ← rewrite_goal_with_prev goal=25 facts=[26]
    #[27] 0 ≤ lcm 0 n
  ← apply_backward_step le_0 goal=27
  ← introduction goal=16
    #[28] ¬(n = 0)
    #[29] m ≤ lcm m n ⟷ (n = 0 ⟶ m = 0)
  ← apply_backward_step iffI goal=29
    #[30] m ≤ lcm m n ⟶ n = 0 ⟶ m = 0
    #[31] (n = 0 ⟶ m = 0) ⟶ m ≤ lcm m n
  ← introduction goal=30
    #[32] m = 0
  ← apply_backward_step negE_gen goal=32 facts=[28,8]
    #[33] m = 0
  ← introduction goal=31
    #[34] m ≤ lcm m n
  ← apply_backward_step divides_le_imp goal=34
    #[35] divides m (lcm m n)
    #[36] lcm m n = 0 ⟶ m = 0
  ← apply_backward_step lcm1 goal=35
    #[37] divides m (lcm m n)
  ← rewrite_goal lcm_zero sym=false goal=36
    #[38] m = 0 ∨ n = 0 ⟶ m = 0
  ← introduction goal=38
    #[39] m = 0 ∨ n = 0
    #[40] m = 0
  ← apply_backward_step disjE goal=40 facts=[39]
    #[41] m = 0 ⟶ m = 0
qed

theorem le_lcm2
  fixes m :: nat, n :: nat
  prop n <= lcm m n <--> (m = 0 --> n = 0)
  [hint_rewrite]
proof
  ← rewrite_goal lcm_sym sym=false goal=0
    #[1] n ≤ lcm n m ⟷ (m = 0 ⟶ n = 0)
  ← rewrite_goal le_lcm1 sym=false goal=1
qed

theorem lcm_le_mult
  fixes m :: nat, n :: nat
  prop lcm m n <= m * n
  [hint_backward]
proof
  ← rewrite_goal lcm_def sym=false goal=0
    #[1] (if m * n = 0 then 0 else m * n DIV gcd m n) ≤ m * n
  ← cases "m * n = 0" goal=1
    #[2] m * n = 0 ⟶ (if m * n = 0 then 0 else m * n DIV gcd m n) ≤ m * n
    #[3] ¬(m * n = 0) ⟶ (if m * n = 0 then 0 else m * n DIV gcd m n) ≤ m * n
  ← introduction goal=2
    #[4] m * n = 0
    #[5] (if m * n = 0 then 0 else m * n DIV gcd m n) ≤ m * n
  ← rewrite_goal if_P sym=false goal=5 facts=[4]
    #[6] 0 ≤ m * n
  ← apply_backward_step le_0 goal=6
    #[7] 0 ≤ m * n
  ← introduction goal=3
    #[8] ¬(m * n = 0)
    #[9] (if m * n = 0 then 0 else m * n DIV gcd m n) ≤ m * n
  ← rewrite_goal if_not_P sym=false goal=9 facts=[8]
    #[10] m * n DIV gcd m n ≤ m * n
  ← apply_backward_step div_le goal=10
    #[11] m * n DIV gcd m n ≤ m * n
qed

theorem lcm_eq_mult
  fixes m :: nat, n :: nat
  prop lcm m n = m * n <--> m = 0 | n = 0 | coprime m n
  [hint_rewrite]
proof
  ← cases "m=0" goal=0
    #[1] m = 0 ⟶ lcm m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
    #[2] ¬(m = 0) ⟶ lcm m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  ← introduction goal=1
    #[3] m = 0
    #[4] lcm m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  ← apply_backward_step iffI goal=4
    #[5] lcm m n = m * n ⟶ m = 0 ∨ n = 0 ∨ coprime m n
    #[6] m = 0 ∨ n = 0 ∨ coprime m n ⟶ lcm m n = m * n
  ← introduction goal=5
    #[7] lcm m n = m * n
    #[8] m = 0 ∨ n = 0 ∨ coprime m n
  ← apply_backward_step disjI1 goal=8
  ← introduction goal=6
    #[9] m = 0 ∨ n = 0 ∨ coprime m n
    #[10] lcm m n = m * n
  ← rewrite_goal_with_prev goal=10 facts=[3]
    #[11] lcm 0 n = 0 * n
  ← rewrite_goal lcm_0 sym=false goal=11
    #[12] 0 = 0 * n
  ← rewrite_goal nat_times_def_1 sym=false goal=12
    #[13] 0 = 0 * n
  ← introduction goal=2
    #[14] ¬(m = 0)
    #[15] lcm m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  ← cases "n=0" goal=15
    #[16] n = 0 ⟶ lcm m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
    #[17] ¬(n = 0) ⟶ lcm m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  ← introduction goal=16
    #[18] n = 0
    #[19] lcm m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  ← apply_backward_step iffI goal=19
    #[20] lcm m n = m * n ⟶ m = 0 ∨ n = 0 ∨ coprime m n
    #[21] m = 0 ∨ n = 0 ∨ coprime m n ⟶ lcm m n = m * n
  ← introduction goal=20
    #[22] m = 0 ∨ n = 0 ∨ coprime m n
  ← apply_backward_step disjI2 goal=22
    #[23] n = 0 ∨ coprime m n
  ← apply_backward_step disjI1 goal=23
  ← introduction goal=21
    #[24] lcm m n = m * n
  ← rewrite_goal_with_prev goal=24 facts=[18]
    #[25] lcm m 0 = m * 0
  ← rewrite_goal lcm_sym sym=false goal=25
    #[26] lcm 0 m = m * 0
  ← rewrite_goal lcm_0 sym=false goal=26
    #[27] 0 = m * 0
  ← rewrite_goal mult_0_right sym=false goal=27
    #[28] 0 = m * 0
  ← introduction goal=17
    #[29] ¬(n = 0)
    #[30] lcm m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  ← rewrite_goal lcm_def sym=false goal=30
    #[31] (if m * n = 0 then 0 else m * n DIV gcd m n) = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  cut "~(m * n = 0)" goal=31
    #[32] ¬(m * n = 0)
  ← rewrite_goal mult_eq_0 sym=false goal=32
    #[33] ¬(m = 0 ∨ n = 0)
  ← rewrite_goal de_morgan_thm2 sym=false goal=33
    #[34] ¬(m = 0) ∧ ¬(n = 0)
  ← apply_backward_step conjI goal=34
  ← rewrite_goal if_not_P sym=false goal=31 facts=[32]
    #[35] m * n DIV gcd m n = m * n ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  ← rewrite_goal div_eq_self sym=false goal=35
    #[36] m * n = 0 ∨ gcd m n = 1 ⟷ m = 0 ∨ n = 0 ∨ coprime m n
  ← rewrite_goal coprime_gcd sym=false goal=36
    #[37] m * n = 0 ∨ gcd m n = 1 ⟷ m = 0 ∨ n = 0 ∨ gcd m n = 1
  ← rewrite_goal mult_eq_0 sym=false goal=37
    #[38] (m = 0 ∨ n = 0) ∨ gcd m n = 1 ⟷ m = 0 ∨ n = 0 ∨ gcd m n = 1
  ← rewrite_goal disj_assoc_eq sym=false goal=38
    #[39] (m = 0 ∨ n = 0) ∨ gcd m n = 1 ⟷ m = 0 ∨ n = 0 ∨ gcd m n = 1
qed

theorem max_le_lcm_eq
  fixes m :: nat, n :: nat
  prop max m n <= lcm m n <--> m = 0 <--> n = 0
  [hint_rewrite]
proof
  ← rewrite_goal max_def sym=false goal=0
    #[1] (if m ≤ n then n else m) ≤ lcm m n ⟷ m = 0 ⟷ n = 0
  ← cases "m ≤ n" goal=1
    #[2] m ≤ n ⟶ (if m ≤ n then n else m) ≤ lcm m n ⟷ m = 0 ⟷ n = 0
    #[3] ¬(m ≤ n) ⟶ (if m ≤ n then n else m) ≤ lcm m n ⟷ m = 0 ⟷ n = 0
  ← introduction goal=2
    #[4] m ≤ n
    #[5] (if m ≤ n then n else m) ≤ lcm m n ⟷ m = 0 ⟷ n = 0
  ← rewrite_goal if_P sym=false goal=5 facts=[4]
    #[6] n ≤ lcm m n ⟷ m = 0 ⟷ n = 0
  ← rewrite_goal le_lcm2 sym=false goal=6
    #[7] (m = 0 ⟶ n = 0) ⟷ m = 0 ⟷ n = 0
  ← apply_backward_step iffI goal=7
    #[8] (m = 0 ⟶ n = 0) ⟶ m = 0 ⟷ n = 0
    #[9] m = 0 ⟷ n = 0 ⟶ m = 0 ⟶ n = 0
  ← introduction goal=8
    #[10] m = 0 ⟶ n = 0
    #[11] m = 0 ⟷ n = 0
  ← apply_backward_step iffI goal=11
    #[12] n = 0 ⟶ m = 0
  ← introduction goal=12
    #[13] n = 0
    #[14] m = 0
  -> rewrite_fact_with_prev goal=14 facts=[13,4]
    #[15] m ≤ 0
  -> apply_forward_step nat_le_zero goal=14 facts=[15]
    #[16] m = 0
  ← introduction goal=9
    #[17] m = 0 ⟷ n = 0
    #[18] m = 0
    #[19] n = 0
  -> rewrite_fact_with_prev goal=19 facts=[17,18]
    #[20] n = 0
  ← introduction goal=3
    #[21] ¬(m ≤ n)
    #[22] (if m ≤ n then n else m) ≤ lcm m n ⟷ m = 0 ⟷ n = 0
  ← rewrite_goal if_not_P sym=false goal=22 facts=[21]
    #[23] m ≤ lcm m n ⟷ m = 0 ⟷ n = 0
  ← rewrite_goal le_lcm1 sym=false goal=23
    #[24] (n = 0 ⟶ m = 0) ⟷ m = 0 ⟷ n = 0
  ← apply_backward_step iffI goal=24
    #[25] (n = 0 ⟶ m = 0) ⟶ m = 0 ⟷ n = 0
    #[26] m = 0 ⟷ n = 0 ⟶ n = 0 ⟶ m = 0
  ← introduction goal=25
    #[27] n = 0 ⟶ m = 0
    #[28] m = 0 ⟷ n = 0
  ← apply_backward_step iffI goal=28
    #[29] m = 0 ⟶ n = 0
  ← introduction goal=29
    #[30] n = 0
  -> rewrite_fact_with_prev goal=30 facts=[18,21]
    #[31] ¬(0 ≤ n)
  ← apply_backward_step negE_gen goal=30 facts=[31]
    #[32] 0 ≤ n
  ← apply_backward_step le_0 goal=32
    #[33] 0 ≤ n
  ← introduction goal=26
    #[34] m = 0
  ← rewrite_goal_with_prev goal=34 facts=[17]
qed

theorem max_le_lcm
  fixes m :: nat, n :: nat
  prop m = 0 <--> n = 0 --> max m n <= lcm m n
  [hint_backward]
proof
  ← introduction goal=0
    #[1] m = 0 ⟷ n = 0
    #[2] max m n ≤ lcm m n
  ← rewrite_goal max_le_lcm_eq sym=false goal=2
qed

